  const _GEN__w1 = (~bubbleValidReg) & io.bubbleValid & 1
  const bubblevalidNext__w1 = (~io.redirect#[0]) & (_GEN__w1 | bubbleValidReg) & 1 & 1
  mut _mux_1:U7 = if _GEN__w1 != 0 { io.bubbleReason#[0..<7] } else { bubbleReasonReg#[0..<7] }
  mut _mux_2:U7 = if io.redirect != 0 { 0 } else { _mux_1#[0..<7] }
