// RobExceptionInfo is kept packed in 131 bits, MSB first: robIdx[130:126] (flag, value), ftqPtr[125:122],
// ftqOffset[121:118], hasException[117], isEnqExcp[116], exceptionVec[115:97], isFetchMalAddr[96], flushPipe[95],
