  const merged:U131 = (cur#[118..<131] << 118) | (sel#[117] << 117) | (sel#[97..<116] << 97) | (cur#[96] << 96) | (fp << 95) | (cur#[94] << 94) | ((s1#[92..<94] | cur#[92..<94]) << 92) | (cur#[91] << 91) | (sel#[22..<91] << 22) | (cur#[15..<22] << 15) | sel#[0..<15]
