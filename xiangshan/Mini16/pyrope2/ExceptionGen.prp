  io_out.bits.isStrided = outBits#[12]
  io_out.bits.isIndexed = outBits#[11]
  io_out.bits.isWhole = outBits#[10]
  io_out.bits.nf = outBits#[7..<10]
  io_out.bits.vsew = outBits#[5..<7]
  io_out.bits.veew = outBits#[3..<5]
  io_out.bits.vlmul = outBits#[0..<3]
  io_state.valid = curValid
  io_state.bits.robIdx.flag = cur#[130]
  io_state.bits.robIdx.value = cur#[126..<130]
  io_state.bits.ftqPtr.flag = cur#[125]
  io_state.bits.ftqPtr.value = cur#[122..<125]
  io_state.bits.ftqOffset = cur#[118..<122]
  io_state.bits.hasException = cur#[117]
  io_state.bits.isEnqExcp = cur#[116]
  io_state.bits.exceptionVec.`_23` = cur#[115]
