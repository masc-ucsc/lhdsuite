  const enqCanWb:U1 = if enqBits#[87..<91] == 1 { 1 } else { 0 }
  const outValid = s1_out_valid | (enq_s1_valid & (enqBits#[117] | enqBits#[92] | enqCanWb))
  const outBits = if s1_out_valid != 0 { s1 } else { enqBits }

