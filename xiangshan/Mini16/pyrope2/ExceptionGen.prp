        current = s1NotEnq
      } elif cur#[126..<131] == s1#[126..<131] {
        current = merged
      }
    }
  } elif s1Take != 0 {
    currentValid = 1
    current = s1NotEnq
  } elif enq_s1_valid != 0 and rdValid == 0 and io_flush == 0 {
    currentValid = 1
    current = enqBits | (1 << 116)
