comb oldest(v0, b0, v1, b1) -> (v:U1, b:U131) {
  const r0 = b0#[126..<131]
  const r1 = b1#[126..<131]
  const lateUop:U1 = if r1 == r0 and b1#[15..<22] > b0#[15..<22] { 1 } else { 0 }
