  const wb8:U131 = (io_wb_8.bits.robIdx.flag << 130) | (io_wb_8.bits.robIdx.value << 126) | (io_wb_8.bits.ftqPtr.flag << 125) | (io_wb_8.bits.ftqPtr.value << 122) | (io_wb_8.bits.ftqOffset << 118) | (io_wb_8.bits.hasException << 117) | (io_wb_8.bits.isEnqExcp << 116) | (io_wb_8.bits.exceptionVec.`_23` << 115) | (io_wb_8.bits.exceptionVec.`_21` << 113) | (io_wb_8.bits.exceptionVec.`_19` << 111) | (io_wb_8.bits.exceptionVec.`_15` << 110) | (io_wb_8.bits.exceptionVec.`_13` << 109) | (io_wb_8.bits.exceptionVec.`_7` << 103) | (io_wb_8.bits.exceptionVec.`_6` << 102) | (io_wb_8.bits.exceptionVec.`_5` << 101) | (io_wb_8.bits.exceptionVec.`_4` << 100) | (io_wb_8.bits.exceptionVec.`_3` << 99) | (io_wb_8.bits.isFetchMalAddr << 96) | (io_wb_8.bits.flushPipe << 95) | (io_wb_8.bits.isVset << 94) | (io_wb_8.bits.replayInst << 93) | (io_wb_8.bits.singleStep << 92) | (io_wb_8.bits.crossPageIPFFix << 91) | (io_wb_8.bits.trigger << 87) | (io_wb_8.bits.vstartEn << 86) | (io_wb_8.bits.vstart << 22) | (io_wb_8.bits.vuopIdx << 15) | (io_wb_8.bits.isVecLoad << 14) | (io_wb_8.bits.isVlm << 13) | (io_wb_8.bits.isStrided << 12) | (io_wb_8.bits.isIndexed << 11) | (io_wb_8.bits.isWhole << 10) | (io_wb_8.bits.nf << 7) | (io_wb_8.bits.vsew << 5) | (io_wb_8.bits.veew << 3) | io_wb_8.bits.vlmul
  const wb9:U131 = (io_wb_9.bits.robIdx.flag << 130) | (io_wb_9.bits.robIdx.value << 126) | (io_wb_9.bits.ftqPtr.flag << 125) | (io_wb_9.bits.ftqPtr.value << 122) | (io_wb_9.bits.ftqOffset << 118) | (io_wb_9.bits.hasException << 117) | (io_wb_9.bits.isEnqExcp << 116) | (io_wb_9.bits.exceptionVec.`_23` << 115) | (io_wb_9.bits.exceptionVec.`_21` << 113) | (io_wb_9.bits.exceptionVec.`_19` << 111) | (io_wb_9.bits.exceptionVec.`_15` << 110) | (io_wb_9.bits.exceptionVec.`_13` << 109) | (io_wb_9.bits.exceptionVec.`_7` << 103) | (io_wb_9.bits.exceptionVec.`_6` << 102) | (io_wb_9.bits.exceptionVec.`_5` << 101) | (io_wb_9.bits.exceptionVec.`_4` << 100) | (io_wb_9.bits.exceptionVec.`_3` << 99) | (io_wb_9.bits.isFetchMalAddr << 96) | (io_wb_9.bits.flushPipe << 95) | (io_wb_9.bits.isVset << 94) | (io_wb_9.bits.replayInst << 93) | (io_wb_9.bits.singleStep << 92) | (io_wb_9.bits.crossPageIPFFix << 91) | (io_wb_9.bits.trigger << 87) | (io_wb_9.bits.vstartEn << 86) | (io_wb_9.bits.vstart << 22) | (io_wb_9.bits.vuopIdx << 15) | (io_wb_9.bits.isVecLoad << 14) | (io_wb_9.bits.isVlm << 13) | (io_wb_9.bits.isStrided << 12) | (io_wb_9.bits.isIndexed << 11) | (io_wb_9.bits.isWhole << 10) | (io_wb_9.bits.nf << 7) | (io_wb_9.bits.vsew << 5) | (io_wb_9.bits.veew << 3) | io_wb_9.bits.vlmul
  const wbB:[10]U131 = [wb0, wb1, wb2, wb3, wb4, wb5, wb6, wb7, wb8, wb9]
  mut inV:[10]U1 = 0
  mut live:[10]U1 = 0
  for i in 0..<10 {
    inV[i] = wbV[i] & hasExc(b=wbB[i]) & noLastFlush
    live[i] = inV[i] & ((~flushed(r=wbB[i]#[126..<131], rdValid, rdLevel, rdRob, flush=io_flush)) & 1)
  }

  // s0: the oldest exception of each group.
  const ld23 = oldest(v0=inV[2], b0=wbB[2], v1=inV[3], b1=wbB[3])
  const ld = oldest(v0=inV[1], b0=wbB[1], v1=ld23.v, b1=ld23.b)
  const st = oldest(v0=inV[4], b0=wbB[4], v1=inV[5], b1=wbB[5])
