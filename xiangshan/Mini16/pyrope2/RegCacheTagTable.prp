// LoadShouldCancel: a value that depends on a load (2-bit shift register per load pipe) is cancelled
// when that pipe cancels at the matching stage (ldCancel lane: bit 0 = ld1Cancel, bit 1 = ld2Cancel).
comb loadShouldCancel(dep:U6, ldCancel:U6) -> (c:Bool) {
  c = false
  for i in 0..<3 {
    c = c or (ldCancel#[(2*i)+1] == 1 and dep#[2*i] == 1) or (ldCancel#[2*i] == 1 and dep#[(2*i)+1] == 1)
  }
}

