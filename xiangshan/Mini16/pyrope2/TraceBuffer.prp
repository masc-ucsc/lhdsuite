pub mod TraceBuffer::[timecheck=false](`clock`:Clock, `reset`:U1, io_in_fromEncoder:(enable:U1, stall:U1), io_in_fromRob:(blocks:U176)) -> (io_out:(blockCommit:U1, groups:(blocks:U66))@[]) {
  // Trace compression: of the 8 ROB commit blocks of a cycle, only the ones that need a PC (a
  // non-None itype, or the last valid block) are queued; a dropped block folds its iretire and
  // its ftq position into the next one. The 8-entry ring hands out up to 3 blocks per cycle.
  // Block fields (22 bits): ilastsize[0] iretire[1..8] itype[9..12] ftqOffset[13..16]
  // ftqIdx {flag,value}[17..20] valid[21]. Pointers are {flag, value[2:0]}.
  reg traceEntries:[8]U22:[ordering="old"]
  reg blockCommit:U1:[initial=0, reset_pin=`reset`, async=true]
  reg enqPtr:U4:[initial=0, reset_pin=`reset`, async=true]
  reg deqPtr:U4:[initial=0, reset_pin=`reset`, async=true]
  reg deqPtrPre:U4

  const inBlocks = io_in_fromRob.blocks
  mut inValid:U8 = 0
  for i in 0..<8 {
    inValid#[i] = inBlocks#[(i*22)+21]
  }
  mut needPc:[8]U1 = [0, 0, 0, 0, 0, 0, 0, 0]
  mut blk:[8]U22 = [0, 0, 0, 0, 0, 0, 0, 0]
  for i in 0..<8 {
    const b:U22 = inBlocks#[(i*22)..<((i*22)+22)]
    const rightHasValid = U1((inValid >> (i+1)) != 0)
    needPc[i] = b#[21] & (U1(b#[9..<13] != 0) | (~rightHasValid & 1)) & (~blockCommit & 1)
    if i == 0 {
      blk[i] = b
    } elif needPc[(i-1) & 7] == 0 {
      const iretire:U8 = (blk[(i-1) & 7]#[1..<9] + b#[1..<9])#[0..<8]
      blk[i] = (b#[21] << 21) | (blk[(i-1) & 7]#[13..<21] << 13) | (b#[9..<13] << 9) | (iretire << 1) | b#[0]
    } else {
      blk[i] = b
    }
  }

  // enqueue: lane i goes to enqPtr + (number of earlier lanes that need a PC); a later lane wins
  mut numNeedPc:U4 = 0
  for i in 0..<8 {
    if needPc[i] != 0 {
      traceEntries[(enqPtr + numNeedPc)#[0..<3]] = blk[i]
    }
    numNeedPc = (numNeedPc + needPc[i])#[0..<4]
  }
  const enqNext:U4 = (enqPtr + numNeedPc)#[0..<4]
  const deqPlus:U4 = (deqPtr + 3)#[0..<4]
  const deqPastEnq = (deqPlus#[3] ^ enqNext#[3]) ^ U1(deqPlus#[0..<3] > enqNext#[0..<3])
  const deqNext:U4 = if deqPastEnq != 0 { enqNext } else { deqPlus }
  blockCommit = io_in_fromEncoder.enable & (U1(enqNext != deqNext) | io_in_fromEncoder.stall)
  enqPtr = enqNext
  deqPtr = deqNext
  deqPtrPre = deqPtr

  // dequeue: up to 3 entries from last cycle's deqPtr that are still before enqPtr
  mut outBlocks:U66 = 0
  for i in 0..<3 {
    const p:U4 = (deqPtrPre + i)#[0..<4]
    const before = (p#[3] ^ enqPtr#[3]) ^ U1(p#[0..<3] < enqPtr#[0..<3])
    if before != 0 {
      outBlocks#[(i*22)..<((i*22)+22)] = traceEntries[p#[0..<3]]
    }
  }
  io_out.blockCommit = blockCommit
  io_out.groups.blocks = outBlocks
}
