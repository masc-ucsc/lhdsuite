// RegNumNotAlign: a register group of EMUL 2/4/8 (encoded 5/6/7) must start on a multiple of its size.
comb notAlign(lo:U5, emul:U4) -> (r:Bool) {
  r = (emul == 5 and lo#[0] != 0) or (emul == 6 and lo#[0..<2] != 0) or (emul == 7 and lo#[0..<3] != 0)
}

// log2 of the register count of an EMUL (LmultoRegNum's shift): EMUL >= 1 is encoded 4..7.
comb regPow(emul:U4) -> (p:U2) {
  p = if emul#[2] != 0 { emul#[0..<2] } else { 0 }
}

// NFtoLmul: whole-register count field (0, 1, 3, 7) to the EMUL encoding (4..7); other values give 0.
comb nfToLmul(nf:U3) -> (l:U3) {
  l = if nf == 0 { 4 } elif nf == 1 { 5 } elif nf == 3 { 6 } elif nf == 7 { 7 } else { 0 }
}

pub comb VecExceptionGen::[timecheck=false](io_inst:U32, io_decodedInst:(foldpc:U10, exceptionVec:(`_22`:U1, `_20`:U1, `_19`:U1, `_12`:U1, `_3`:U1, `_2`:U1, `_1`:U1), isFetchMalAddr:U1, trigger:U4, isRVC:U1, fixedTaken:U1, predTaken:U1, crossPageIPFFix:U1, ftqPtr:(flag:U1, value:U3), ftqOffset:U4, isLastInFtqEntry:U1, instr:U32, commitType:U2, srcType:U16, vlRen:U1, lsrc:U24, ldest:U6, fuType:U36, fuOpType:U9, rfWen:U1, fpWen:U1, vecWen:U1, v0Wen:U1, vlWen:U1, waitForward:U1, blockBackward:U1, flushPipe:U1, canRobCompress:U1, selImm:U4, imm:U32, fpu:(wflags:U1, fmt:U2, rm:U3), vpu:(vill:U1, vma:U1, vta:U1, vsew:U2, vlmul:U3, specVill:U1, specVma:U1, specVta:U1, specVsew:U2, specVlmul:U3, vm:U1, vstart:U8, frm:U3, fpu:(isFpToVecInst:U1, isFP32Instr:U1, isFP64Instr:U1, isReduction:U1, isFoldTo1_2:U1, isFoldTo1_4:U1, isFoldTo1_8:U1), vxrm:U2, vuopIdx:U7, lastUop:U1, vmask:U128, vl:U8, nf:U3, veew:U2, isReverse:U1, isExt:U1, isNarrow:U1, isDstMask:U1, isOpMask:U1, isMove:U1, isDependOldVd:U1, isWritePartVd:U1, isVleff:U1, maskVecGen:U16, sew8:U1, sew16:U1, sew32:U1, sew64:U1), vlsInstr:U1, wfflags:U1, isMove:U1, uopIdx:U7, uopSplitType:U6, isVset:U1, firstUop:U1, lastUop:U1, numWB:U7, needFrm:(scalaNeedFrm:U1, vectorNeedFrm:U1)), io_vtype:(illegal:U1, vma:U1, vta:U1, vsew:U2, vlmul:U3), io_vstart:U8) -> (io_illegalInst:U1) {
  // Illegal-vector-instruction check (VecExceptionGen.scala): inst illegal, vill, EEW, EMUL,
  // register-number alignment, v0 overlap, source/destination overlap and vstart.
  const inst = io_inst
  const opc  = inst#[0..<7]
  const f3   = inst#[12..<15]
  const vd   = inst#[7..<12]
  const vs1  = inst#[15..<20]
  const vs2  = inst#[20..<25]
  const vm   = inst#[25]
  const nf   = inst#[29..<32]
  const w2   = inst#[12..<14]     // WIDTH(1, 0)
  const imm3 = inst#[15..<18]     // IMM5_OPIVI(2, 0): whole-register move count

  // Instruction keys: the fields each BitPat of the vector instruction lists depends on.
  const kUnit  = (inst#[26..<29] << 15) | (inst#[20..<25] << 10) | (f3 << 7) | opc   // mop + lumop
  const kMop   = (inst#[26..<29] << 10) | (f3 << 7) | opc                            // mop
  const kWhole = (inst#[20..<32] << 10) | (f3 << 7) | opc                            // nf/mop/lumop
  const kF6    = (inst#[26..<32] << 10) | (f3 << 7) | opc                            // funct6
  const kF6v1  = (inst#[26..<32] << 15) | (inst#[12..<20] << 7) | opc                // funct6 + vs1
  const kF7    = (inst#[25..<32] << 10) | (f3 << 7) | opc                            // funct6 + vm
  const kF7v1  = (inst#[25..<32] << 15) | (inst#[12..<20] << 7) | opc                // funct6 + vm + vs1

  mut lsStrideInst = false
  for k in (0x7, 0x287, 0x307, 0x387, 0x27, 0x2a7, 0x327, 0x3a7, 0x4007, 0x4287, 0x4307, 0x4387) { lsStrideInst = lsStrideInst or (kUnit == k) }
  for k in (0x807, 0xa87, 0xb07, 0xb87, 0x827, 0xaa7, 0xb27, 0xba7) { lsStrideInst = lsStrideInst or (kMop == k) }
  const lsMaskInst = kWhole == 0xac07 or kWhole == 0xac27
  mut lsIndexInst = false
  for k in (0x407, 0x687, 0x707, 0x787, 0xc07, 0xe87, 0xf07, 0xf87, 0x427, 0x6a7, 0x727, 0x7a7, 0xc27, 0xea7, 0xf27, 0xfa7) { lsIndexInst = lsIndexInst or (kMop == k) }
  mut lsWholeInst = false
  for k in (0xa007, 0xa287, 0xa307, 0xa387, 0x8a007, 0x8a287, 0x8a307, 0x8a387, 0x18a007, 0x18a287, 0x18a307, 0x18a387,
            0x38a007, 0x38a287, 0x38a307, 0x38a387, 0xa027, 0x8a027, 0x18a027, 0x38a027) { lsWholeInst = lsWholeInst or (kWhole == k) }
  mut vdWideningInst = false
  for k in (0xc557, 0xc757, 0xd557, 0xd757, 0xc157, 0xc357, 0xd157, 0xd357, 0xcd57, 0xcf57, 0xdd57, 0xdf57, 0xc957, 0xcb57,
            0xd957, 0xdb57, 0xe157, 0xe357, 0xeb57, 0xf557, 0xf757, 0xfd57, 0xff57, 0xf157, 0xf357, 0xfb57, 0xed57,
            0xef57, 0xe957, 0xc2d7, 0xc0d7, 0xd2d7, 0xd0d7, 0xcad7, 0xc8d7, 0xdad7, 0xd8d7, 0xe2d7, 0xe0d7, 0xf2d7, 0xf0d7,
            0xfad7, 0xf8d7, 0xf6d7, 0xf4d7, 0xfed7, 0xfcd7, 0xd457, 0xd657, 0xd5d7) { vdWideningInst = vdWideningInst or (kF6 == k) }
  for k in (0x930d7, 0x92cd7, 0x928d7, 0x93cd7, 0x938d7, 0x924d7, 0x920d7) { vdWideningInst = vdWideningInst or (kF6v1 == k) }
  mut vs2WideningInst = false
  for k in (0xd557, 0xd757, 0xd157, 0xd357, 0xdd57, 0xdf57, 0xd957, 0xdb57, 0xd2d7, 0xd0d7, 0xdad7, 0xd8d7) { vs2WideningInst = vs2WideningInst or (kF6 == k) }
  mut narrowingInst = false
  for k in (0xbdd7, 0xbc57, 0xbe57, 0xb9d7, 0xb857, 0xba57, 0xb5d7, 0xb457, 0xb657, 0xb1d7, 0xb057, 0xb257) { narrowingInst = narrowingInst or (kF6 == k) }
  for k in (0x940d7, 0x944d7, 0x950d7, 0x94cd7, 0x948d7, 0x954d7, 0x95cd7, 0x958d7) { narrowingInst = narrowingInst or (kF6v1 == k) }
  const intExt2 = kF6v1 == 0x91d57 or kF6v1 == 0x91957   // VSEXT_VF2, VZEXT_VF2
  const intExt4 = kF6v1 == 0x91557 or kF6v1 == 0x91157
  const intExt8 = kF6v1 == 0x90d57 or kF6v1 == 0x90957
  const intExtInst = intExt2 or intExt4 or intExt8
  mut acsbInst = false
  for k in (0x8dd7, 0x89d7, 0x8c57, 0x8857, 0x8e57, 0x8a57, 0x9c57, 0x9857, 0x9e57, 0x9a57) { acsbInst = acsbInst or (kF7 == k) }
  mut cmpInst = false
  for k in (0x61d7, 0x6057, 0x6257, 0x7dd7, 0x7e57, 0x79d7, 0x7a57, 0x75d7, 0x7457, 0x7657, 0x71d7, 0x7057, 0x7257, 0x6c57, 0x6e57,
            0x6857, 0x6a57, 0x65d7, 0x6457, 0x6657, 0x62d7, 0x60d7, 0x72d7, 0x70d7, 0x7ed7, 0x76d7, 0x66d7, 0x64d7, 0x6ed7, 0x6cd7) { cmpInst = cmpInst or (kF6 == k) }
  mut redInst = false
  for k in (0x557, 0x1d57, 0x1957, 0x1557, 0x1157, 0x957, 0x157, 0xd57, 0x1cd7, 0x14d7, 0xcd7, 0x4d7) { redInst = redInst or (kF6 == k) }
  const redWideningInst = kF6 == 0xc457 or kF6 == 0xc057 or kF6 == 0xccd7 or kF6 == 0xc4d7
  mut maskLogicalInst = false
  for k in (0xcd57, 0xed57, 0xc557, 0xdd57, 0xd557, 0xf557, 0xe557, 0xfd57) { maskLogicalInst = maskLogicalInst or (kF7 == k) }
  const msbxInst = kF6v1 == 0xa0557 or kF6v1 == 0xa0d57 or kF6v1 == 0xa0957   // VMSBF_M, VMSIF_M, VMSOF_M
  const viota = kF6v1 == 0xa4157
  const maskArithmeticInst = kF6v1 == 0x84157 or kF6v1 == 0x84557 or msbxInst or maskLogicalInst
  const maskIndexInst = viota or ((inst#[26..<32] << 20) | (inst#[12..<25] << 7) | opc) == 0x1404557   // VIOTA_M, VID_V
  const vmvSingleInst = kF7v1 == 0x108157 or kWhole == 0x108357 or kF7v1 == 0x1080d7 or kWhole == 0x1082d7
  const vmvWholeInst = kF7v1 == 0x2781d7 or kF7v1 == 0x2785d7 or kF7v1 == 0x278dd7 or kF7v1 == 0x279dd7
  const vsetInst = ((inst#[31] << 10) | (f3 << 7) | opc) == 0x3d7 or ((inst#[30..<32] << 10) | (f3 << 7) | opc) == 0xfd7 or kF7 == 0x103d7
  const vrgather16 = kF6 == 0x3857
  const vcompress = kF7 == 0xbd57
  const doubleFpInst = kF6v1 == 0x92cd7 or kF6v1 == 0x928d7 or kF6v1 == 0x95cd7 or kF6v1 == 0x958d7 or kF6v1 == 0x944d7 or kF6v1 == 0x940d7

  // FuType groups (FuType.isVArithMem / isVArith / isVall) and source types.
  const fuType = io_decodedInst.fuType
  const isVArithMem = (fuType & 0xf1df80000) != 0
  const isVArith = (fuType & 0x1df80000) != 0
  const isVall = (fuType & 0xffff80000) != 0
  const src0Vp = io_decodedInst.srcType#[2] == 1    // SrcType.isVp(srcType(0..2))
  const src1Vp = io_decodedInst.srcType#[6] == 1
  const src2Vp = io_decodedInst.srcType#[10] == 1
  const vecWen = io_decodedInst.vecWen == 1

  const SEW  = io_vtype.vsew
  const LMUL = (U1(io_vtype.vlmul#[2] == 0) << 2) | io_vtype.vlmul#[0..<2]
  const lsLike = lsStrideInst or lsIndexInst

  // 1-3. inst, vill and EEW
  const instIllegal = maskLogicalInst and vm == 0
  const villIllegal = io_vtype.illegal == 1 and isVall and not (vsetInst or lsWholeInst)
  const isFp = inst#[12..<14] == 1 and opc == 0x57
  const fpEewIllegal = isFp and SEW == 0 and not doubleFpInst
  const intExtEewIllegal = (intExt2 and SEW == 0) or (intExt4 and SEW <= 1) or (intExt8 and SEW <= 2)
  const wnEewIllegal = (vdWideningInst or narrowingInst or redWideningInst) and SEW == 3
  const eewIllegal = fpEewIllegal or intExtEewIllegal or wnEewIllegal

  // 4. EMUL
  const lsEmulIllegal = lsLike and ((LMUL + w2) < (SEW + 1) or (LMUL + w2) > (SEW + 7))
  const intExtEmulIllegal = (intExt2 and LMUL == 1) or (intExt4 and LMUL <= 2) or (intExt8 and LMUL <= 3)
  const wnEmulIllegal = (vdWideningInst or narrowingInst) and LMUL == 7
  const gather16EmulIllegal = vrgather16 and (LMUL < SEW or LMUL > (SEW + 6))
  const segEmul:U4 = if lsIndexInst { LMUL } else { (LMUL + w2 - SEW)#[0..<4] }
  const segRegNum:U7 = ((nf + 1) << regPow(emul=segEmul))#[0..<7]
  const segRegMax:U8 = vd + segRegNum
  const lsSegIllegal = lsLike and nf != 0 and (segRegNum > 8 or segRegMax > 32)
  const emulIllegal = lsEmulIllegal or intExtEmulIllegal or wnEmulIllegal or gather16EmulIllegal or lsSegIllegal

  // 5. register-number alignment
  const vs1IsMask = maskArithmeticInst or vcompress
  const vs1IsSingleElem = redInst or redWideningInst
  const vs1Eew:U2 = if vrgather16 { 1 } else { SEW }
  const vs1Emul:U4 = if vs1IsMask or vs1IsSingleElem { 4 } elif vrgather16 { ((LMUL + 1)#[0..<4] - SEW)#[0..<4] } else { LMUL }

  const vs2IsMask = maskArithmeticInst or maskIndexInst
  const vs2EewSel = (U1(lsIndexInst) << 4) | (U1(vs2WideningInst or narrowingInst or redWideningInst) << 3) | (U1(intExt2) << 2) | (U1(intExt4) << 1) | U1(intExt8)
  const vs2Eew:U2 = if vs2EewSel == 16 { w2 } elif vs2EewSel == 8 { (SEW + 1)#[0..<2] } elif vs2EewSel == 4 { (SEW - 1)#[0..<2] }
                    elif vs2EewSel == 2 { (SEW - 2)#[0..<2] } elif vs2EewSel == 1 { (SEW - 3)#[0..<2] } else { SEW }
  const vs2EmulSel = (U1(vs2IsMask or vmvSingleInst) << 3) | (U1(vs2WideningInst or narrowingInst) << 2) | (U1(vmvWholeInst) << 1) | U1(intExtInst or lsIndexInst)
  const vs2Emul:U4 = if vs2EmulSel == 8 { 4 } elif vs2EmulSel == 4 { (LMUL + 1)#[0..<3] } elif vs2EmulSel == 2 { nfToLmul(nf=imm3) }
                     elif vs2EmulSel == 1 { ((LMUL + vs2Eew)#[0..<4] - SEW)#[0..<4] } else { LMUL }

  const vdIsMask = lsMaskInst or acsbInst or cmpInst or maskArithmeticInst
  const vdIsSingleElem = vs1IsSingleElem or vmvSingleInst
  const vdEew:U2 = if lsStrideInst { w2 } elif vdWideningInst or redWideningInst { (SEW + 1)#[0..<2] } else { SEW }
  const vdEmulSel = (U1(vdIsMask or vdIsSingleElem) << 4) | (U1(vdWideningInst) << 3) | (U1(vmvWholeInst) << 2) | (U1(lsWholeInst) << 1) | U1(lsStrideInst)
  const vdEmul:U4 = if vdEmulSel == 16 { 4 } elif vdEmulSel == 8 { (LMUL + 1)#[0..<3] } elif vdEmulSel == 4 { nfToLmul(nf=imm3) }
                    elif vdEmulSel == 2 { nfToLmul(nf=nf) } elif vdEmulSel == 1 { ((LMUL + vdEew)#[0..<4] - SEW)#[0..<4] } else { LMUL }

  const regNumIllegal = isVArithMem and ((src0Vp and notAlign(lo=vs1, emul=vs1Emul)) or (src1Vp and notAlign(lo=vs2, emul=vs2Emul)) or ((src2Vp or vecWen) and notAlign(lo=vd, emul=vdEmul)))

  // 6. v0 overlap
  const v0AllowOverlap = (vdIsMask or vdIsSingleElem) and not msbxInst
  const v0Overlap = isVArithMem and vecWen and vm == 0 and vd == 0 and not v0AllowOverlap

  // 7. source/destination register overlap
  const vs1RegHi:U6 = vs1 + (1 << regPow(emul=vs1Emul)) - 1
  const vs2RegHi:U6 = vs2 + (1 << regPow(emul=vs2Emul)) - 1
  const vdRegHi:U8 = if lsLike { segRegMax - 1 } else { ((vd + (1 << regPow(emul=vdEmul)))#[0..<5] - 1)#[0..<5] }
  mut notAllowOverlapInst = (lsIndexInst and nf != 0) or msbxInst or viota or vrgather16 or vcompress
  for k in (0x3a57, 0x39d7, 0x3b57, 0x3ad7, 0x3057, 0x3257, 0x31d7) { notAllowOverlapInst = notAllowOverlapInst or (kF6 == k) }   // slideup, gather

  const vs1Constraint1 = (vs1IsMask and vdIsMask) or (not vs1IsMask and not vdIsMask and vs1Eew == vdEew)
  const vs1Constraint2 = ((vdIsMask and not vs1IsMask) or (not vs1IsMask and not vdIsMask and vs1Eew > vdEew)) and vd == vs1 and vdRegHi <= vs1RegHi
  const vs1Constraint3 = ((not vdIsMask and vs1IsMask) or (not vs1IsMask and not vdIsMask and vs1Eew < vdEew)) and vs1Emul >= 4 and vdRegHi == vs1RegHi and vd <= vs1
  const vs1AllowOverlap = (vs1Constraint1 or vs1Constraint2 or vs1Constraint3 or vdIsSingleElem) and not notAllowOverlapInst
  const vs1vdOverlap = src0Vp and vecWen and not (vs1RegHi < vd or vdRegHi < vs1) and not vs1AllowOverlap

  const vs2Constraint1 = (vs2IsMask and vdIsMask) or (not vs2IsMask and not vdIsMask and vs2Eew == vdEew)
  const vs2Constraint2 = ((vdIsMask and not vs2IsMask) or (not vs2IsMask and not vdIsMask and vs2Eew > vdEew)) and vd == vs2 and vdRegHi <= vs2RegHi
  const vs2Constraint3 = ((not vdIsMask and vs2IsMask) or (not vs2IsMask and not vdIsMask and vs2Eew < vdEew)) and vs2Emul >= 4 and vdRegHi == vs2RegHi and vd <= vs2
  const vs2AllowOverlap = (vs2Constraint1 or vs2Constraint2 or vs2Constraint3 or vdIsSingleElem) and not notAllowOverlapInst
  const vs2vdOverlap = src1Vp and vecWen and not (vs2RegHi < vd or vdRegHi < vs2) and not vs2AllowOverlap

  const regOverlapIllegal = v0Overlap or vs1vdOverlap or vs2vdOverlap

  // 8. vstart
  const vstartIllegal = isVArith and io_vstart != 0

  io_illegalInst = U1(instIllegal or villIllegal or eewIllegal or emulIllegal or regNumIllegal or regOverlapIllegal or vstartIllegal)
}

