pub comb CompressUnit::[timecheck=false](io_in:U3648, io_oddFtqVec:U8) -> (io_out:(needRobFlags:U8, instrSizes:U32, masks:U64, canCompressVec:U8)) {
  // Lane l (456 bits of io_in): it can be compressed when valid, last uop of its instruction, no exception, not a
  // debug-mode trigger and canRobCompress. The compress key interleaves canCompress and canCompress & !oddFtq.
  mut canCompress:U8 = 0
  mut pla:U16 = 0
  for l in 0..<8 {
    const lane = io_in#[(l*0x1c8)..<((l+1)*0x1c8)]
    const noExc = lane#[0x1b6..<0x1bd] == 0 and lane#[0x1b1..<0x1b5] != 1
    const can:U1 = if lane#[0x1c7] != 0 and lane#[9] != 0 and noExc and lane#[0x11d] != 0 { 1 } else { 0 }
    canCompress = canCompress | (can << l)
    pla = pla | (can << (2*l)) | ((can & (~io_oddFtqVec#[l]) & 1) << ((2*l)+1))
  }

  // CompressUnit.scala compressTable, which Chisel emitted as a 16-input PLA. Lane l has a = pla[2l] (its uop may sit
  // in a compressed group) and b = pla[2l+1] (it may join the next lane); a run of ones in pla is one ROB entry.
  // runLo/runHi[j]: length of the run of ones through bit j counted downward / upward (0 when bit j is 0).
  // A key with some lane at (a, b) = (0, 1) is not in the table and decodes to all zeros.
  mut runLo:[16]U5 = 0
  mut runHi:[16]U5 = 0
  for j in 0..<16 {
    const below:U5 = if j > 0 { runLo[(j + 15) % 16] } else { 0 }
    runLo[j] = if pla#[j] != 0 { (below + 1)#[0..<5] } else { 0 }
  }
  for jj in 0..<16 {
    const j = 15 - jj
    const above:U5 = if j < 15 { runHi[(j + 1) % 16] } else { 0 }
    runHi[j] = if pla#[j] != 0 { (above + 1)#[0..<5] } else { 0 }
  }
  mut keyOk:U1 = 1
  mut needRob:U8 = 0
  mut sizes:U32 = 0
  mut masks:U64 = 0
  for l in 0..<8 {
    const a = pla#[2*l]
    const b = pla#[(2*l)+1]
    const nxt:U1 = if l < 7 { pla#[(2*l)+2] } else { 0 }
    if a == 0 and b != 0 { keyOk = 0 }
    const one:U1 = if a != 0 and b != 0 and nxt != 0 { 0 } else { 1 }
    const lo = runLo[2*l]
    const hi = runHi[2*l]
    const size:U4 = if a != 0 { ((lo + hi) >> 1)#[0..<4] } else { 1 }
    const start:U3 = if a != 0 { ((l + 1) - ((lo + 1) >> 1))#[0..<3] } else { l }
    needRob = needRob | (one << l)
    sizes = sizes | (size << (4*l))
    masks = masks | (((((1 << size) - 1) << start))#[0..<8] << (8*l))
  }
  io_out.needRobFlags = if keyOk != 0 { needRob } else { 0 }
  io_out.instrSizes = if keyOk != 0 { sizes } else { 0 }
  io_out.masks = if keyOk != 0 { masks } else { 0 }
  io_out.canCompressVec = canCompress
}
