    const one:U1 = if a != 0 and b != 0 and nxt != 0 { 0 } else { 1 }
    const lo = runLo[2*l]
    const hi = runHi[2*l]
    const size:U4 = if a != 0 { ((lo + hi) >> 1)#[0..<4] } else { 1 }
    const start:U3 = if a != 0 { ((l + 1) - ((lo + 1) >> 1))#[0..<3] } else { l }
    needRob = needRob | (one << l)
    sizes = sizes | (size << (4*l))
    masks = masks | (((((1 << size) - 1) << start))#[0..<8] << (8*l))
  }
  mut `_GEN.needRobFlags` = if keyOk != 0 { needRob } else { 0 }
  mut `_GEN.instrSizes` = if keyOk != 0 { sizes } else { 0 }
  mut `_GEN.masks` = if keyOk != 0 { masks } else { 0 }
  mut `_GEN.canCompressVec` = ((canCompress_7 & 1) << 7) | ((canCompress_6 & 1) << 6) | ((canCompress_5 & 1) << 5) | ((canCompress_4 & 1) << 4) | ((canCompress_3 & 1) << 3) | ((canCompress_2 & 1) << 2) | ((canCompress_1 & 1) << 1) | (canCompress_0 & 1)
  io = (`_GEN.needRobFlags` << 0x68) | (`_GEN.instrSizes` << 0x48) | (`_GEN.masks` << 8) | `_GEN.canCompressVec` | (io_oddFtqVec << 0x70) | (io_in << 0x78)
  mut `io_out__bpo.needRobFlags` = io#[0..<0x70]#[0x68..<0x70]
  mut `io_out__bpo.instrSizes` = io#[0..<0x70]#[0x48..<0x68]
  mut `io_out__bpo.masks` = io#[0..<0x70]#[8..<0x48]
  mut `io_out__bpo.canCompressVec` = io#[0..<0x70]#[0..<8]
  const t32648 = `io_out__bpo.needRobFlags`
  `io_out__bpr.needRobFlags` = t32648
  io_out.needRobFlags = t32648
  const t32649 = `io_out__bpo.instrSizes`
  `io_out__bpr.instrSizes` = t32649
  io_out.instrSizes = t32649
  const t32650 = `io_out__bpo.masks`
  `io_out__bpr.masks` = t32650
  io_out.masks = t32650
  const t32651 = `io_out__bpo.canCompressVec`
  `io_out__bpr.canCompressVec` = t32651
  io_out.canCompressVec = t32651
}
