const TraceBuffer = import("TraceBuffer.TraceBuffer")

pub mod Trace::[timecheck=false](`clock`:Clock, `reset`:U1, io_in_fromEncoder:(enable:U1, stall:U1), io_in_fromRob:(blocks:U152)) -> (io_out:(toPcMem:(blocks:U66), toEncoder:(blocks:U66), blockRobCommit:U1)@[]) {
  // Commit trace pipeline: stage 1 registers the ROB's 8 trace blocks (valid held while the
  // buffer blocks commit, bits loaded when the block is valid), stage 2 compresses them in
  // TraceBuffer (to the PC memory), stage 3 registers the groups for the encoder.
  // ROB block (19 bits): ilastsize[0] iretire[1..5] itype[6..9] ftqOffset[10..13] ftqIdx[14..17] valid[18].
  reg s1_out_blocks_0_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_0_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_1_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_1_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_2_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_2_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_3_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_3_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_4_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_4_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_5_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_5_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_6_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_6_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_7_valid_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg s1_out_blocks_7_bits_r:U18:[initial=0, reset_pin=`reset`, async=true]
  reg s3_out_groups:U66
  const inBlocks = io_in_fromRob.blocks
  // TraceBuffer counts compressed iretire in 8 bits: widen the 5-bit field
  const s1Valid:[8]U1 = [s1_out_blocks_0_valid_r, s1_out_blocks_1_valid_r, s1_out_blocks_2_valid_r, s1_out_blocks_3_valid_r, s1_out_blocks_4_valid_r, s1_out_blocks_5_valid_r, s1_out_blocks_6_valid_r, s1_out_blocks_7_valid_r]
  const s1Bits:[8]U18 = [s1_out_blocks_0_bits_r, s1_out_blocks_1_bits_r, s1_out_blocks_2_bits_r, s1_out_blocks_3_bits_r, s1_out_blocks_4_bits_r, s1_out_blocks_5_bits_r, s1_out_blocks_6_bits_r, s1_out_blocks_7_bits_r]
  mut s2Blocks:U176 = 0
  for i in 0..<8 {
    const x = s1Bits[i]
    s2Blocks#[(i*22)..<((i*22)+22)] = (s1Valid[i] << 21) | (x#[6..<18] << 9) | (x#[1..<6] << 1) | x#[0]
  }
  const traceBuffer = TraceBuffer::[name=traceBuffer](`clock` = `clock`, `reset` = `reset`, io_in_fromEncoder.enable = io_in_fromEncoder.enable, io_in_fromEncoder.stall = io_in_fromEncoder.stall, io_in_fromRob.blocks = s2Blocks)
  const blockCommit = traceBuffer.io_out.blockCommit
  if blockCommit == 0 { s1_out_blocks_0_valid_r = inBlocks#[18] }
  if blockCommit == 0 { s1_out_blocks_1_valid_r = inBlocks#[37] }
  if blockCommit == 0 { s1_out_blocks_2_valid_r = inBlocks#[56] }
  if blockCommit == 0 { s1_out_blocks_3_valid_r = inBlocks#[75] }
  if blockCommit == 0 { s1_out_blocks_4_valid_r = inBlocks#[94] }
  if blockCommit == 0 { s1_out_blocks_5_valid_r = inBlocks#[113] }
  if blockCommit == 0 { s1_out_blocks_6_valid_r = inBlocks#[132] }
  if blockCommit == 0 { s1_out_blocks_7_valid_r = inBlocks#[151] }
  if inBlocks#[18] != 0 { s1_out_blocks_0_bits_r = inBlocks#[0..<18] }
  if inBlocks#[37] != 0 { s1_out_blocks_1_bits_r = inBlocks#[19..<37] }
  if inBlocks#[56] != 0 { s1_out_blocks_2_bits_r = inBlocks#[38..<56] }
  if inBlocks#[75] != 0 { s1_out_blocks_3_bits_r = inBlocks#[57..<75] }
  if inBlocks#[94] != 0 { s1_out_blocks_4_bits_r = inBlocks#[76..<94] }
  if inBlocks#[113] != 0 { s1_out_blocks_5_bits_r = inBlocks#[95..<113] }
  if inBlocks#[132] != 0 { s1_out_blocks_6_bits_r = inBlocks#[114..<132] }
  if inBlocks#[151] != 0 { s1_out_blocks_7_bits_r = inBlocks#[133..<151] }
  s3_out_groups = traceBuffer.io_out.groups.blocks
  io_out.toPcMem.blocks = traceBuffer.io_out.groups.blocks
  io_out.toEncoder.blocks = s3_out_groups
  io_out.blockRobCommit = blockCommit
}
