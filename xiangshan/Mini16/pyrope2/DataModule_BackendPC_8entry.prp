pub mod DataModule_BackendPC_8entry::[timecheck=false](`clock`:Clock, io_raddr:U48, io_wen:U1, io_waddr:U3, io_wdata:U49) -> (io_rdata:U784@[]) {
  // 8-entry backend PC memory: 16 read ports and 1 write port. A read of the entry being
  // written in the same cycle returns the write data (bypass).
  reg data:[8]U49:[ordering="old"]
  mut rdata:U784 = 0
  for i in 0..<16 {
    const a:U3 = io_raddr#[(i*3)..<((i*3)+3)]
    rdata#[(i*49)..<((i*49)+49)] = if io_wen != 0 and io_waddr == a { io_wdata } else { data[a] }
  }
  if io_wen != 0 {
    data[io_waddr] = io_wdata
  }
  io_rdata = rdata
}
