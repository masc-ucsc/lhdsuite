  mut _mux_1:u1 = if w.wen != 0 { `wdata.SE` & 1 } else { reg_0 & 1 }
  reg_0 = _mux_1
  mut `regOut__bpo.SE` = _regOut_SE_WIRE_1__w1 & 1
  regOut.SE = `regOut__bpo.SE`
