pub comb CloseShiftLeftWithMux_11::[timecheck=false](io_src:u12, io_shiftValue:u4) -> (io_result:u12) {
  wire io:(src:u12, shiftValue:u4, result:u12) = nil
  wire io_result_res_vec:u60
  mut _mux_1:u12 = if ((io.shiftValue >> 3) & 1) != 0 { io_result_res_vec#[0..=11]#[0..=3] << 8 } else { io_result_res_vec#[0..=11] }
  mut _mux_2:u12 = if ((io.shiftValue >> 2) & 1) != 0 { io_result_res_vec#[12..=23]#[0..=7] << 4 } else { io_result_res_vec#[12..=23] }
  mut _mux_3:u12 = if ((io.shiftValue >> 1) & 1) != 0 { io_result_res_vec#[24..=35]#[0..=9] << 2 } else { io_result_res_vec#[24..=35] }
  mut _mux_4:u12 = if (io.shiftValue & 1) != 0 { io_result_res_vec#[36..=47]#[0..=10] << 1 } else { io_result_res_vec#[36..=47] }
  io_result_res_vec = (_mux_4 << 48) | (_mux_3 << 36) | (_mux_2 << 24) | (_mux_1 << 12) | io.src#[0..=11]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec#[48..=59]
  io_result = io.result
}
