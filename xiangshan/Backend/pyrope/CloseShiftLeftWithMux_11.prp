pub comb CloseShiftLeftWithMux_11::[timecheck=false](io_src:u12, io_shiftValue:u4) -> (io_result:u12) {
  wire io:(src:u12, shiftValue:u4, result:u12) = nil
  wire io_result_res_vec:(e4:u12, e3:u12, e2:u12, e1:u12, e0:u12) = nil
  mut _mux_1:u12 = if ((io.shiftValue >> 3) & 1) != 0 { io_result_res_vec.e0#[0..=3] << 8 } else { io_result_res_vec.e0#[0..=11] }
  mut _mux_2:u12 = if ((io.shiftValue >> 2) & 1) != 0 { io_result_res_vec.e1#[0..=7] << 4 } else { io_result_res_vec.e1#[0..=11] }
  mut _mux_3:u12 = if ((io.shiftValue >> 1) & 1) != 0 { io_result_res_vec.e2#[0..=9] << 2 } else { io_result_res_vec.e2#[0..=11] }
  mut _mux_4:u12 = if (io.shiftValue & 1) != 0 { io_result_res_vec.e3#[0..=10] << 1 } else { io_result_res_vec.e3#[0..=11] }
  io_result_res_vec.e4 = _mux_4
  io_result_res_vec.e3 = _mux_3
  io_result_res_vec.e2 = _mux_2
  io_result_res_vec.e1 = _mux_1
  io_result_res_vec.e0 = io.src#[0..=11]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec.e4#[0..=11]
  io_result = io.result
}
