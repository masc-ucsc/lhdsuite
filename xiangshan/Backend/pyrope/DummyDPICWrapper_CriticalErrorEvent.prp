const DiffExtCriticalErrorEvent = import("DiffExtCriticalErrorEvent.DiffExtCriticalErrorEvent")

pub mod DummyDPICWrapper_CriticalErrorEvent::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(valid:u1, criticalError:u1, coreid:u8))) -> () {
  mut dpic = DiffExtCriticalErrorEvent::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 10) | (io.bits.valid << 9) | (io.bits.criticalError << 8) | io.bits.coreid)#[0..=9])
}
