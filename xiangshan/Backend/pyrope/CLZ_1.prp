pub comb CLZ_1::[timecheck=false](io_in:u10) -> (io_out:u4) {
  wire io:(`in`:u10, out:u4) = nil
  mut _mux_1:u4 = if (io.`in` & 1) != 0 { 9 } else { 10 }
  mut _mux_2:u4 = if ((io.`in` >> 1) & 1) != 0 { 8 } else { _mux_1 }
  mut _mux_3:u4 = if ((io.`in` >> 2) & 1) != 0 { 7 } else { _mux_2 }
  mut _mux_4:u4 = if ((io.`in` >> 3) & 1) != 0 { 6 } else { _mux_3 }
  mut _mux_5:u4 = if ((io.`in` >> 4) & 1) != 0 { 5 } else { _mux_4 }
  mut _mux_6:u4 = if ((io.`in` >> 5) & 1) != 0 { 4 } else { _mux_5 }
  mut _mux_7:u4 = if ((io.`in` >> 6) & 1) != 0 { 3 } else { _mux_6 }
  mut _mux_8:u4 = if ((io.`in` >> 7) & 1) != 0 { 2 } else { _mux_7 }
  mut _mux_9:u4 = if ((io.`in` >> 8) & 1) != 0 { 1 } else { _mux_8 }
  mut _mux_10:u4 = if ((io.`in` >> 9) & 1) != 0 { 0 } else { _mux_9 }
  io.`in` = io_in
  io.out = _mux_10
  io_out = io.out
}
