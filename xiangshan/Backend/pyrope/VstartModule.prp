pub mod VstartModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), robCommit:(instNum:(valid:u1, bits:u7), fflags:(valid:u1, bits:u5), fsDirty:u1, vxsat:(valid:u1, bits:u1), vsDirty:u1, vtype:(valid:u1, bits:(VILL:u1, VMA:u1, VTA:u1, VSEW:u3, VLMUL:u3)), vl:u8, vstart:(valid:u1, bits:u7))) -> (rdata:u64@[], regOut:(vstart:u7)@[]) {
  reg reg_0:u7:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.vstart` = 0
  mut `wdata.vstart` = w.wdata#[0..=6]
  mut _mux_1:u7 = if robCommit.vstart.valid != 0 { robCommit.vstart.bits#[0..=6] } else { reg_0 }
  mut _mux_2:u7 = if (robCommit.vsDirty & (~robCommit.vstart.valid) & 1 & 1) != 0 { 0 } else { _mux_1 }
  mut _mux_3:u7 = if w.wen != 0 { w.wdata#[0..=6] } else { _mux_2 }
  reg_0 = _mux_3
  mut `regOut__bpo.vstart` = reg_0
  regOut.vstart = `regOut__bpo.vstart`
  rdata = reg_0
}
