pub mod VstartModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), robCommit:(instNum:(valid:U1, bits:U7), fflags:(valid:U1, bits:U5), fsDirty:U1, vxsat:(valid:U1, bits:U1), vsDirty:U1, vtype:(valid:U1, bits:(VILL:U1, VMA:U1, VTA:U1, VSEW:U3, VLMUL:U3)), vl:U8, vstart:(valid:U1, bits:U7))) -> (rdata:U64@[], regOut:(vstart:U7)@[]) {
  mut _mux_1:U7 = 0
  mut _mux_2:U7 = 0
  mut _mux_3:U7 = 0
  mut t10 = 0
  mut t8 = 0
  mut t9 = 0
  reg reg_0:U7:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U7
  reg _GEN_0:U7
  reg _GEN_1:U7
  wire `regOut__bpr.vstart`:U7 = nil
  mut `reg_init.vstart` = 0
  mut `wdata.vstart` = w.wdata#[0..<7]
  t8 = _GEN
  t9 = _GEN_0
  t10 = _GEN_1
  if not (`reset` != 0) {
    _mux_1 = if robCommit.vstart.valid != 0 { robCommit.vstart.bits#[0..<7] } else { reg_0#[0..<7] }
    t8 = _mux_1
    _mux_2 = if (robCommit.vsDirty & (~robCommit.vstart.valid#[0]) & 1) != 0 { 0 } else { t8#[0..<7] }
    t9 = _mux_2
    _mux_3 = if w.wen != 0 { w.wdata#[0..<7] } else { t9#[0..<7] }
    t10 = _mux_3
    reg_0 = t10
  }
  _GEN = t8
  _GEN_0 = t9
  _GEN_1 = t10
  mut `regOut__bpo.vstart` = reg_0#[0..<7]
  const t31 = `regOut__bpo.vstart`
  `regOut__bpr.vstart` = t31
  regOut.vstart = t31
  rdata = reg_0#[0..<7]
}
