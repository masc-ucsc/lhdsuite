pub comb RealWBArbiter::[timecheck=false](io_in_0_valid:u1, io_in_0_bits:(rfWen:u1, fpWen:u1, vecWen:u1, v0Wen:u1, vlWen:u1, pdest:u8, data:u64)) -> (io_in_0_ready:u1, io_out_valid:u1, io_out_bits:(rfWen:u1, fpWen:u1, vecWen:u1, v0Wen:u1, vlWen:u1, pdest:u8, data:u64)) {
  mut `_GEN.ready` = 0
  mut `io_out.ready` = 0
  mut `_GEN.valid` = io_in_0_valid & 1
  mut `_GEN.bits` = ((io_in_0_bits.rfWen << 0x4c) | (io_in_0_bits.fpWen << 0x4b) | (io_in_0_bits.vecWen << 0x4a) | (io_in_0_bits.v0Wen << 0x49) | (io_in_0_bits.vlWen << 0x48) | (io_in_0_bits.pdest << 0x40) | io_in_0_bits.data)#[0..=76]
  const io_in__w1 = (0x40000000000000000000 | (`_GEN.valid` << 0x4d) | `_GEN.bits`)#[0..=78]
  mut `io_out.valid` = (io_in__w1 >> 0x4d) & 1
  mut `io_out.bits` = io_in__w1#[0..=76]
  const t53 = `io_out.bits`
  mut `io_out_bits__bpo.rfWen` = (t53 >> 0x4c) & 1
  mut `io_out_bits__bpo.fpWen` = (t53 >> 0x4b) & 1
  mut `io_out_bits__bpo.vecWen` = (t53 >> 0x4a) & 1
  mut `io_out_bits__bpo.v0Wen` = (t53 >> 0x49) & 1
  mut `io_out_bits__bpo.vlWen` = (t53 >> 0x48) & 1
  mut `io_out_bits__bpo.pdest` = t53#[64..=71]
  mut `io_out_bits__bpo.data` = t53#[0..=63]
  io_out_bits.rfWen = `io_out_bits__bpo.rfWen`
  io_out_bits.fpWen = `io_out_bits__bpo.fpWen`
  io_out_bits.vecWen = `io_out_bits__bpo.vecWen`
  io_out_bits.v0Wen = `io_out_bits__bpo.v0Wen`
  io_out_bits.vlWen = `io_out_bits__bpo.vlWen`
  io_out_bits.pdest = `io_out_bits__bpo.pdest`
  io_out_bits.data = `io_out_bits__bpo.data`
  io_in_0_ready = (io_in__w1 >> 0x4e) & 1
  io_out_valid = `io_out.valid`
}
