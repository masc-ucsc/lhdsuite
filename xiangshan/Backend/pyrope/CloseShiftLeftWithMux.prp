pub comb CloseShiftLeftWithMux::[timecheck=false](io_src:u54, io_shiftValue:u6) -> (io_result:u54) {
  wire io:(src:u54, shiftValue:u6, result:u54) = nil
  wire io_result_res_vec:u378
  mut _mux_1:u54 = if ((io.shiftValue >> 5) & 1) != 0 { io_result_res_vec#[0..=53]#[0..=21] << 32 } else { io_result_res_vec#[0..=53] }
  mut _mux_2:u54 = if ((io.shiftValue >> 4) & 1) != 0 { io_result_res_vec#[54..=107]#[0..=37] << 16 } else { io_result_res_vec#[54..=107] }
  mut _mux_3:u54 = if ((io.shiftValue >> 3) & 1) != 0 { io_result_res_vec#[108..=161]#[0..=45] << 8 } else { io_result_res_vec#[108..=161] }
  mut _mux_4:u54 = if ((io.shiftValue >> 2) & 1) != 0 { io_result_res_vec#[162..=215]#[0..=49] << 4 } else { io_result_res_vec#[162..=215] }
  mut _mux_5:u54 = if ((io.shiftValue >> 1) & 1) != 0 { io_result_res_vec#[216..=269]#[0..=51] << 2 } else { io_result_res_vec#[216..=269] }
  mut _mux_6:u54 = if (io.shiftValue & 1) != 0 { io_result_res_vec#[270..=323]#[0..=52] << 1 } else { io_result_res_vec#[270..=323] }
  io_result_res_vec = (_mux_6 << 324) | (_mux_5 << 270) | (_mux_4 << 216) | (_mux_3 << 162) | (_mux_2 << 108) | (_mux_1 << 54) | io.src#[0..=53]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec#[324..=377]
  io_result = io.result
}
