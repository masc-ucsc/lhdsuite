pub comb CloseShiftLeftWithMux::[timecheck=false](io_src:u54, io_shiftValue:u6) -> (io_result:u54) {
  wire io:(src:u54, shiftValue:u6, result:u54) = nil
  wire io_result_res_vec:(e6:u54, e5:u54, e4:u54, e3:u54, e2:u54, e1:u54, e0:u54) = nil
  mut _mux_1:u54 = if ((io.shiftValue >> 5) & 1) != 0 { io_result_res_vec.e0#[0..=21] << 32 } else { io_result_res_vec.e0#[0..=53] }
  mut _mux_2:u54 = if ((io.shiftValue >> 4) & 1) != 0 { io_result_res_vec.e1#[0..=37] << 16 } else { io_result_res_vec.e1#[0..=53] }
  mut _mux_3:u54 = if ((io.shiftValue >> 3) & 1) != 0 { io_result_res_vec.e2#[0..=45] << 8 } else { io_result_res_vec.e2#[0..=53] }
  mut _mux_4:u54 = if ((io.shiftValue >> 2) & 1) != 0 { io_result_res_vec.e3#[0..=49] << 4 } else { io_result_res_vec.e3#[0..=53] }
  mut _mux_5:u54 = if ((io.shiftValue >> 1) & 1) != 0 { io_result_res_vec.e4#[0..=51] << 2 } else { io_result_res_vec.e4#[0..=53] }
  mut _mux_6:u54 = if (io.shiftValue & 1) != 0 { io_result_res_vec.e5#[0..=52] << 1 } else { io_result_res_vec.e5#[0..=53] }
  io_result_res_vec.e6 = _mux_6
  io_result_res_vec.e5 = _mux_5
  io_result_res_vec.e4 = _mux_4
  io_result_res_vec.e3 = _mux_3
  io_result_res_vec.e2 = _mux_2
  io_result_res_vec.e1 = _mux_1
  io_result_res_vec.e0 = io.src#[0..=53]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec.e6#[0..=53]
  io_result = io.result
}
