pub comb RoundingUnit_2::[timecheck=false](io_in:u23, io_roundIn:u1, io_stickyIn:u1, io_signIn:u1, io_rm:u3) -> (io_inexact:u1, io_r_up:u1) {
  wire io:(`in`:u23, roundIn:u1, stickyIn:u1, signIn:u1, rm:u3, inexact:u1, r_up:u1) = nil
  const g__w1 = io.`in` & 1
  const inexact__w1 = (io.roundIn | io.stickyIn) & 1
  mut _mux_3:u1 = if io.rm == 3 { inexact__w1 & (~io.signIn) & 1 & 1 } else { unsigned(io.rm != 1) & unsigned(io.rm == 0) & 1 & ((io.roundIn & io.stickyIn & 1) | (io.roundIn & (~io.stickyIn) & 1 & 1 & g__w1 & 1)) & 1 & 1 }
  mut _mux_4:u1 = if io.rm == 2 { inexact__w1 & io.signIn & 1 } else { _mux_3 & 1 }
  mut _mux_5:u1 = if io.rm == 4 { io.roundIn & 1 } else { _mux_4 & 1 }
  mut _mux_6:u1 = if io.rm == 6 { inexact__w1 & (~g__w1) & 1 & 1 } else { _mux_5 & 1 }
  io.`in` = io_in
  io.roundIn = io_roundIn & 1
  io.stickyIn = io_stickyIn & 1
  io.signIn = io_signIn & 1
  io.rm = io_rm
  io.inexact = inexact__w1 & 1
  io.r_up = _mux_6 & 1
  io_inexact = io.inexact
  io_r_up = io.r_up
}
