pub mod StoreBubbleReason::[timecheck=false](clock:u1, reset:u1, io_bubbleValid:u1, io_bubbleReason:u7, io_redirect:u1) -> (io_outReasonValid:u1@[], io_outReason:u7@[]) {
  wire io:(bubbleValid:u1, bubbleReason:u7, redirect:u1, reasonFire:u1, outReasonValid:u1, outReason:u7) = nil
  reg bubbleValidReg:u1:[init=0, reset_pin=ref reset, async=true]
  reg bubbleReasonReg:u7:[init=0, reset_pin=ref reset, async=true]
  const _GEN__w1 = ((~bubbleValidReg) & 1) & io.bubbleValid & 1
  const bubblevalidNext__w1 = (~io.redirect) & 1 & (_GEN__w1 | bubbleValidReg) & 1 & 1
  mut _mux_1:u7 = if _GEN__w1 != 0 { io.bubbleReason#[0..=6] } else { bubbleReasonReg }
  mut _mux_2:u7 = if io.redirect != 0 { 0 } else { _mux_1 }
  mut _mux_3:u7 = if (io.bubbleValid & (~bubbleValidReg) & 1 & 1) != 0 { io.bubbleReason#[0..=6] } else { bubbleReasonReg }
  io.bubbleValid = io_bubbleValid & 1
  io.bubbleReason = io_bubbleReason
  io.redirect = io_redirect & 1
  io.outReasonValid = (bubbleValidReg | io.bubbleValid) & 1
  io.outReason = _mux_3
  bubbleValidReg = bubblevalidNext__w1
  bubbleReasonReg = _mux_2
  io_outReasonValid = io.outReasonValid
  io_outReason = io.outReason
}
