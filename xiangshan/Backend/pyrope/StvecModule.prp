pub mod StvecModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(mode:u2, addr:u62)@[]) {
  reg reg_0:u64:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.mode` = 0
  mut `reg_init.addr` = 0
  mut `wdata.mode` = w.wdata#[0..=1]
  mut `wdata.addr` = w.wdata#[2..=63]
  mut _mux_3:u2 = if (w.wen & (unsigned(`wdata.mode` == 0) | unsigned(`wdata.mode` == 1)) & 1 & 1) != 0 { `wdata.mode`#[0..=1] } else { reg_0#[62..=63] }
  mut _mux_4:u62 = if w.wen != 0 { `wdata.addr`#[0..=61] } else { reg_0#[0..=61] }
  reg_0 = _mux_4 | (_mux_3 << 62)
  mut `regOut__bpo.mode` = reg_0#[62..=63]
  mut `regOut__bpo.addr` = reg_0#[0..=61]
  regOut.mode = `regOut__bpo.mode`
  regOut.addr = `regOut__bpo.addr`
  rdata = (reg_0#[0..=61] << 2) | reg_0#[62..=63]
}
