pub comb ShiftLeftPriorityWithF32EXPResult::[timecheck=false](io_src:u10, io_priority_shiftValue:u10) -> (io_lshift_result:u10, io_exp_result:u8) {
  wire io:(src:u10, priority_shiftValue:u10, lshift_result:u10, exp_result:u8) = nil
  mut _mux_1:u10 = if (io.priority_shiftValue & 1) != 0 { (io.src & 1) << 9 } else { 0 }
  mut _mux_2:u18 = if ((io.priority_shiftValue >> 1) & 1) != 0 { (io.src#[0..=1] << 16) | 0x68 } else { (_mux_1 << 8) | (51 << 1) | (io.priority_shiftValue & 1) }
  mut _mux_3:u18 = if ((io.priority_shiftValue >> 2) & 1) != 0 { (io.src#[0..=2] << 15) | 0x69 } else { _mux_2 }
  mut _mux_4:u18 = if ((io.priority_shiftValue >> 3) & 1) != 0 { (io.src#[0..=3] << 14) | 0x6a } else { _mux_3 }
  mut _mux_5:u18 = if ((io.priority_shiftValue >> 4) & 1) != 0 { (io.src#[0..=4] << 13) | 0x6b } else { _mux_4 }
  mut _mux_6:u18 = if ((io.priority_shiftValue >> 5) & 1) != 0 { (io.src#[0..=5] << 12) | 0x6c } else { _mux_5 }
  mut _mux_7:u18 = if ((io.priority_shiftValue >> 6) & 1) != 0 { (io.src#[0..=6] << 11) | 0x6d } else { _mux_6 }
  mut _mux_8:u18 = if ((io.priority_shiftValue >> 7) & 1) != 0 { (io.src#[0..=7] << 10) | 0x6e } else { _mux_7 }
  mut _mux_9:u18 = if ((io.priority_shiftValue >> 8) & 1) != 0 { (io.src#[0..=8] << 9) | 0x6f } else { _mux_8 }
  mut _mux_10:u18 = if ((io.priority_shiftValue >> 9) & 1) != 0 { (io.src#[0..=9] << 8) | 0x70 } else { _mux_9 }
  const lshift_result_lzd_exp__w1 = _mux_10
  io.src = io_src
  io.priority_shiftValue = io_priority_shiftValue
  io.lshift_result = lshift_result_lzd_exp__w1#[8..=17]
  io.exp_result = lshift_result_lzd_exp__w1#[0..=7]
  io_lshift_result = io.lshift_result
  io_exp_result = io.exp_result
}
