pub mod McycleModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), mcountinhibit:(CY:U1, IR:U1, HPM3:U29), countingEn:U1, fromSireg:(valid:U1, bits:U64)) -> (rdata:U64@[], regOut:(ALL:U64)@[], toSireg:U64@[]) {
  mut _mux_1:U64 = 0
  mut _mux_2:U64 = 0
  mut _mux_3:U64 = 0
  mut t10 = 0
  mut t8 = 0
  mut t9 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U64
  reg _GEN_0:U64
  reg _GEN_1:U64
  wire `regOut__bpr.ALL`:U64 = nil
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..<0x40]
  t8 = _GEN
  t9 = _GEN_0
  t10 = _GEN_1
  if not (`reset` != 0) {
    _mux_1 = if ((~mcountinhibit.CY#[0]) & countingEn & 1) != 0 { (reg_0#[0..<0x40] + 1)#[0..<0x40] } else { reg_0#[0..<0x40] }
    t8 = _mux_1
    _mux_2 = if fromSireg.valid != 0 { fromSireg.bits#[0..<0x40] } else { t8#[0..<0x40] }
    t9 = _mux_2
    _mux_3 = if w.wen != 0 { w.wdata#[0..<0x40] } else { t9#[0..<0x40] }
    t10 = _mux_3
    reg_0 = t10
  }
  _GEN = t8
  _GEN_0 = t9
  _GEN_1 = t10
  mut `regOut__bpo.ALL` = reg_0#[0..<0x40]
  const t33 = `regOut__bpo.ALL`
  `regOut__bpr.ALL` = t33
  regOut.ALL = t33
  rdata = reg_0#[0..<0x40]
  toSireg = reg_0#[0..<0x40]
}
