pub mod SiselectModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(ALL:u13)@[], inIMSICRange:u1@[]) {
  reg reg_0:u13:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  const value__w1 = reg_0
  mut `wdata.ALL` = w.wdata#[0..=12]
  mut _mux_1:u13 = if (w.wen & (~((`wdata.ALL` >> 12) & 1)) & 1 & 1) != 0 { `wdata.ALL`#[0..=12] } else { value__w1 }
  reg_0 = _mux_1
  mut `regOut__bpo.ALL` = reg_0
  regOut.ALL = `regOut__bpo.ALL`
  rdata = reg_0
  inIMSICRange = unsigned(value__w1 > 0x6f) & unsigned(value__w1 < 0x100) & 1
}
