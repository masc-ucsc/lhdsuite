pub comb FarShiftRightWithMuxInvFirst::[timecheck=false](io_src:u110, io_shiftValue:u6, io_EOP:u1) -> (io_result:u110) {
  wire io:(src:u110, shiftValue:u6, result:u110, EOP:u1) = nil
  wire io_result_res_vec:u770
  mut _mux_1:u110 = if (io.shiftValue & 1) != 0 { ((io.EOP & 1) << 109) | io_result_res_vec#[0..=109]#[1..=109] } else { io_result_res_vec#[0..=109] }
  mut _rep_2:u2 = if (io.EOP & 1) != 0 { 3 } else { 0 }
  mut _mux_3:u110 = if ((io.shiftValue >> 1) & 1) != 0 { (_rep_2 << 108) | io_result_res_vec#[110..=219]#[2..=109] } else { io_result_res_vec#[110..=219] }
  mut _rep_4:u4 = if (io.EOP & 1) != 0 { 15 } else { 0 }
  mut _mux_5:u110 = if ((io.shiftValue >> 2) & 1) != 0 { (_rep_4 << 106) | io_result_res_vec#[220..=329]#[4..=109] } else { io_result_res_vec#[220..=329] }
  mut _rep_6:u8 = if (io.EOP & 1) != 0 { 0xff } else { 0 }
  mut _mux_7:u110 = if ((io.shiftValue >> 3) & 1) != 0 { (_rep_6 << 102) | io_result_res_vec#[330..=439]#[8..=109] } else { io_result_res_vec#[330..=439] }
  mut _rep_8:u16 = if (io.EOP & 1) != 0 { 0xffff } else { 0 }
  mut _mux_9:u110 = if ((io.shiftValue >> 4) & 1) != 0 { (_rep_8 << 94) | io_result_res_vec#[440..=549]#[16..=109] } else { io_result_res_vec#[440..=549] }
  mut _rep_10:u32 = if (io.EOP & 1) != 0 { 0xffffffff } else { 0 }
  mut _mux_11:u110 = if ((io.shiftValue >> 5) & 1) != 0 { (_rep_10 << 78) | io_result_res_vec#[550..=659]#[32..=109] } else { io_result_res_vec#[550..=659] }
  io_result_res_vec = (_mux_11 << 660) | (_mux_9 << 550) | (_mux_7 << 440) | (_mux_5 << 330) | (_mux_3 << 220) | (_mux_1 << 110) | io.src#[0..=109]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec#[660..=769]
  io.EOP = io_EOP & 1
  io_result = io.result
}
