pub comb FarShiftRightWithMuxInvFirst::[timecheck=false](io_src:u110, io_shiftValue:u6, io_EOP:u1) -> (io_result:u110) {
  wire io:(src:u110, shiftValue:u6, result:u110, EOP:u1) = nil
  wire io_result_res_vec:(e6:u110, e5:u110, e4:u110, e3:u110, e2:u110, e1:u110, e0:u110) = nil
  mut _mux_1:u110 = if (io.shiftValue & 1) != 0 { ((io.EOP & 1) << 109) | io_result_res_vec.e0#[1..=109] } else { io_result_res_vec.e0#[0..=109] }
  mut _rep_2:u2 = if (io.EOP & 1) != 0 { 3 } else { 0 }
  mut _mux_3:u110 = if ((io.shiftValue >> 1) & 1) != 0 { (_rep_2 << 108) | io_result_res_vec.e1#[2..=109] } else { io_result_res_vec.e1#[0..=109] }
  mut _rep_4:u4 = if (io.EOP & 1) != 0 { 15 } else { 0 }
  mut _mux_5:u110 = if ((io.shiftValue >> 2) & 1) != 0 { (_rep_4 << 106) | io_result_res_vec.e2#[4..=109] } else { io_result_res_vec.e2#[0..=109] }
  mut _rep_6:u8 = if (io.EOP & 1) != 0 { 0xff } else { 0 }
  mut _mux_7:u110 = if ((io.shiftValue >> 3) & 1) != 0 { (_rep_6 << 102) | io_result_res_vec.e3#[8..=109] } else { io_result_res_vec.e3#[0..=109] }
  mut _rep_8:u16 = if (io.EOP & 1) != 0 { 0xffff } else { 0 }
  mut _mux_9:u110 = if ((io.shiftValue >> 4) & 1) != 0 { (_rep_8 << 94) | io_result_res_vec.e4#[16..=109] } else { io_result_res_vec.e4#[0..=109] }
  mut _rep_10:u32 = if (io.EOP & 1) != 0 { 0xffffffff } else { 0 }
  mut _mux_11:u110 = if ((io.shiftValue >> 5) & 1) != 0 { (_rep_10 << 78) | io_result_res_vec.e5#[32..=109] } else { io_result_res_vec.e5#[0..=109] }
  io_result_res_vec.e6 = _mux_11
  io_result_res_vec.e5 = _mux_9
  io_result_res_vec.e4 = _mux_7
  io_result_res_vec.e3 = _mux_5
  io_result_res_vec.e2 = _mux_3
  io_result_res_vec.e1 = _mux_1
  io_result_res_vec.e0 = io.src#[0..=109]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec.e6#[0..=109]
  io.EOP = io_EOP & 1
  io_result = io.result
}
