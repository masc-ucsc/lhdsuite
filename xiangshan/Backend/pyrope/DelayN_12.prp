pub mod DelayN_12::[timecheck=false](clock:u1, io_in:u1) -> (io_out:u1@[]) {
  reg REG:u1
  reg REG_1:u1
  reg REG_2:u1
  reg REG_3:u1
  reg REG_4:u1
  mut `io.in` = io_in & 1
  mut `io.out` = REG_4 & 1
  REG = `io.in`
  REG_1 = REG
  REG_2 = REG_1
  REG_3 = REG_2
  REG_4 = REG_3
  io_out = `io.out`
}
