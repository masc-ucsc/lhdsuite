pub mod Mstateen3Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(SE:U1)@[]) {
  mut _mux_1:U1 = 0
