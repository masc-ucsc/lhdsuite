pub mod Mstateen3Module::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(SE:u1)@[]) {
  reg reg_0:u1:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.SE` = 0
  mut `wdata.SE` = (w.wdata >> 63) & 1
  mut _mux_1:u1 = if w.wen != 0 { `wdata.SE` & 1 } else { reg_0 & 1 }
  reg_0 = _mux_1
  mut `regOut__bpo.SE` = reg_0 & 1
  regOut.SE = `regOut__bpo.SE`
  rdata = (reg_0 & 1) << 63
}
