pub comb IterBlockI8Nr4::[timecheck=false](io_d_cons:U36, io_pre_w:U9, io_pre_w_low:U8, io_pre_q:U8) -> (io_nxt_w:U9, io_nxt_w_low:U8, io_nxt_q:U8) {
