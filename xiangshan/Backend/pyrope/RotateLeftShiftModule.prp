pub comb RotateLeftShiftModule::[timecheck=false](io_shamt:U6, io_rolSrc:U64) -> (io_rol:U64) {
  wire io:(shamt:U6, rolSrc:U64, rol:U64) = nil
  wire io_rol_shifted:U64 = nil
  wire io_rol_shifted_1:U64 = nil
  wire io_rol_shifted_2:U64 = nil
  wire io_rol_shifted_3:U64 = nil
  wire io_rol_shifted_4:U64 = nil
  wire io_rol_shifted_5:U64 = nil
  mut _mux_1:U64 = if io.shamt#[5..<6] != 0 { (io.rolSrc#[0..<32] << 32) | io.rolSrc#[32..<0x40] } else { io.rolSrc#[0..<0x40] }
  io_rol_shifted = _mux_1
  mut _mux_2:U64 = if io.shamt#[4..<5] != 0 { (io_rol_shifted#[0..<48] << 16) | io_rol_shifted#[48..<0x40] } else { io_rol_shifted#[0..<0x40] }
  io_rol_shifted_1 = _mux_2
  mut _mux_3:U64 = if io.shamt#[3..<4] != 0 { (io_rol_shifted_1#[0..<56] << 8) | io_rol_shifted_1#[56..<0x40] } else { io_rol_shifted_1#[0..<0x40] }
  io_rol_shifted_2 = _mux_3
  mut _mux_4:U64 = if io.shamt#[2..<3] != 0 { (io_rol_shifted_2#[0..<60] << 4) | io_rol_shifted_2#[60..<0x40] } else { io_rol_shifted_2#[0..<0x40] }
  io_rol_shifted_3 = _mux_4
  mut _mux_5:U64 = if io.shamt#[1..<2] != 0 { (io_rol_shifted_3#[0..<62] << 2) | io_rol_shifted_3#[62..<0x40] } else { io_rol_shifted_3#[0..<0x40] }
  io_rol_shifted_4 = _mux_5
  mut _mux_6:U64 = if (io.shamt & 1) != 0 { (io_rol_shifted_4#[0..<63] << 1) | io_rol_shifted_4#[63..<0x40] } else { io_rol_shifted_4#[0..<0x40] }
  io_rol_shifted_5 = _mux_6
  io.shamt = io_shamt#[0..<6]
  io.rolSrc = io_rolSrc#[0..<0x40]
  io.rol = io_rol_shifted_5#[0..<0x40]
  io_rol = io.rol
}
