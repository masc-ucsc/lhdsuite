pub comb RotateLeftShiftModule::[timecheck=false](io_shamt:u6, io_rolSrc:u64) -> (io_rol:u64) {
  wire io:(shamt:u6, rolSrc:u64, rol:u64) = nil
  mut _mux_1:u64 = if ((io.shamt >> 5) & 1) != 0 { (io.rolSrc#[0..=31] << 32) | io.rolSrc#[32..=63] } else { io.rolSrc#[0..=63] }
  const io_rol_shifted__w1 = _mux_1
  mut _mux_2:u64 = if ((io.shamt >> 4) & 1) != 0 { (io_rol_shifted__w1#[0..=47] << 16) | io_rol_shifted__w1#[48..=63] } else { io_rol_shifted__w1 }
  const io_rol_shifted_1__w1 = _mux_2
  mut _mux_3:u64 = if ((io.shamt >> 3) & 1) != 0 { (io_rol_shifted_1__w1#[0..=55] << 8) | io_rol_shifted_1__w1#[56..=63] } else { io_rol_shifted_1__w1 }
  const io_rol_shifted_2__w1 = _mux_3
  mut _mux_4:u64 = if ((io.shamt >> 2) & 1) != 0 { (io_rol_shifted_2__w1#[0..=59] << 4) | io_rol_shifted_2__w1#[60..=63] } else { io_rol_shifted_2__w1 }
  const io_rol_shifted_3__w1 = _mux_4
  mut _mux_5:u64 = if ((io.shamt >> 1) & 1) != 0 { (io_rol_shifted_3__w1#[0..=61] << 2) | io_rol_shifted_3__w1#[62..=63] } else { io_rol_shifted_3__w1 }
  const io_rol_shifted_4__w1 = _mux_5
  mut _mux_6:u64 = if (io.shamt & 1) != 0 { (io_rol_shifted_4__w1#[0..=62] << 1) | ((io_rol_shifted_4__w1 >> 63) & 1) } else { io_rol_shifted_4__w1 }
  io.shamt = io_shamt
  io.rolSrc = io_rolSrc
  io.rol = _mux_6
  io_rol = io.rol
}
