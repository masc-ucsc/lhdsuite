pub comb OldestArbiter_62::[timecheck=false](io_in_0_valid:u1, io_in_0_bits:(addr:u7, robIdx:(flag:u1, value:u9), issueValid:u1)) -> (io_in_0_ready:u1, io_out:(valid:u1, bits:(addr:u7, robIdx:(flag:u1, value:u9), issueValid:u1))) {
  wire io:u39
  mut `_GEN.ready` = 0
  mut `_GEN.valid` = io_in_0_valid & 1
  mut `_GEN.bits` = ((io_in_0_bits.addr << 11) | (io_in_0_bits.robIdx.flag << 10) | (io_in_0_bits.robIdx.value << 1) | io_in_0_bits.issueValid)#[0..=17]
  mut `_GEN_0.valid` = (io#[19..=38] >> 18) & 1
  mut `_GEN_0.bits` = io#[19..=38]#[0..=17]
  io = (`_GEN_0.valid` << 18) | `_GEN_0.bits` | ((0x80000 | (`_GEN.valid` << 18) | `_GEN.bits`)#[0..=19] << 19)
  mut `io_out__bpo.valid` = (io#[0..=18] >> 18) & 1
  mut `io_out__bpo.bits.addr` = io#[0..=18]#[11..=17]
  mut `io_out__bpo.bits.robIdx.flag` = (io#[0..=18] >> 10) & 1
  mut `io_out__bpo.bits.robIdx.value` = io#[0..=18]#[1..=9]
  mut `io_out__bpo.bits.issueValid` = io#[0..=18] & 1
  io_out.valid = `io_out__bpo.valid`
  io_out.bits.addr = `io_out__bpo.bits.addr`
  io_out.bits.robIdx.flag = `io_out__bpo.bits.robIdx.flag`
  io_out.bits.robIdx.value = `io_out__bpo.bits.robIdx.value`
  io_out.bits.issueValid = `io_out__bpo.bits.issueValid`
  io_in_0_ready = (io#[19..=38] >> 19) & 1
}
