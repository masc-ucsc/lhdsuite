pub comb RightShifter::[timecheck=false](io_shiftNum:u6, io_in:u64, io_msb:u1) -> (io_out:u64) {
  wire io:(shiftNum:u6, `in`:u64, msb:u1, out:u64) = nil
  mut _mux_1:u64 = if (io.shiftNum & 1) != 0 { ((io.msb & 1) << 63) | io.`in`#[1..=63] } else { io.`in`#[0..=63] }
  const s0__w1 = _mux_1
  mut _rep_2:u2 = if (io.msb & 1) != 0 { 3 } else { 0 }
  mut _mux_3:u64 = if ((io.shiftNum >> 1) & 1) != 0 { (_rep_2 << 62) | s0__w1#[2..=63] } else { s0__w1 }
  const s1__w1 = _mux_3
  mut _rep_4:u4 = if (io.msb & 1) != 0 { 15 } else { 0 }
  mut _mux_5:u64 = if ((io.shiftNum >> 2) & 1) != 0 { (_rep_4 << 60) | s1__w1#[4..=63] } else { s1__w1 }
  const s2__w1 = _mux_5
  mut _rep_6:u8 = if (io.msb & 1) != 0 { 0xff } else { 0 }
  mut _mux_7:u64 = if ((io.shiftNum >> 3) & 1) != 0 { (_rep_6 << 56) | s2__w1#[8..=63] } else { s2__w1 }
  const s3__w1 = _mux_7
  mut _rep_8:u16 = if (io.msb & 1) != 0 { 0xffff } else { 0 }
  mut _mux_9:u64 = if ((io.shiftNum >> 4) & 1) != 0 { (_rep_8 << 48) | s3__w1#[16..=63] } else { s3__w1 }
  const s4__w1 = _mux_9
  mut _rep_10:u32 = if (io.msb & 1) != 0 { 0xffffffff } else { 0 }
  mut _mux_11:u64 = if ((io.shiftNum >> 5) & 1) != 0 { (_rep_10 << 32) | s4__w1#[32..=63] } else { s4__w1 }
  io.shiftNum = io_shiftNum
  io.`in` = io_in
  io.msb = io_msb & 1
  io.out = _mux_11
  io_out = io.out
}
