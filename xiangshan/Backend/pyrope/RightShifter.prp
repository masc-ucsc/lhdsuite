pub comb RightShifter::[timecheck=false](io_shiftNum:U6, io_in:U64, io_msb:U1) -> (io_out:U64) {
  wire io:(shiftNum:U6, `in`:U64, msb:U1, out:U64) = nil
  wire `s0`:U64 = nil
  wire `s1`:U64 = nil
  wire `s2`:U64 = nil
  wire `s3`:U64 = nil
  wire `s4`:U64 = nil
  wire `s5`:U64 = nil
  mut _mux_1:U64 = if (io.shiftNum & 1) != 0 { ((io.msb & 1) << 63) | io.`in`#[1..<0x40] } else { io.`in`#[0..<0x40] }
  `s0` = _mux_1
  mut _rep_2:U2 = if (io.msb & 1) != 0 { 3 } else { 0 }
  mut _mux_3:U64 = if io.shiftNum#[1..<2] != 0 { (_rep_2#[0..<2] << 62) | `s0`#[2..<0x40] } else { `s0`#[0..<0x40] }
  `s1` = _mux_3
  mut _rep_4:U4 = if (io.msb & 1) != 0 { 15 } else { 0 }
  mut _mux_5:U64 = if io.shiftNum#[2..<3] != 0 { (_rep_4#[0..<4] << 60) | `s1`#[4..<0x40] } else { `s1`#[0..<0x40] }
  `s2` = _mux_5
  mut _rep_6:U8 = if (io.msb & 1) != 0 { 0xff } else { 0 }
  mut _mux_7:U64 = if io.shiftNum#[3..<4] != 0 { (_rep_6#[0..<8] << 56) | `s2`#[8..<0x40] } else { `s2`#[0..<0x40] }
  `s3` = _mux_7
  mut _rep_8:U16 = if (io.msb & 1) != 0 { 0xffff } else { 0 }
  mut _mux_9:U64 = if io.shiftNum#[4..<5] != 0 { (_rep_8#[0..<16] << 48) | `s3`#[16..<0x40] } else { `s3`#[0..<0x40] }
  `s4` = _mux_9
  mut _rep_10:U32 = if (io.msb & 1) != 0 { 0xffffffff } else { 0 }
  mut _mux_11:U64 = if io.shiftNum#[5..<6] != 0 { (_rep_10#[0..<32] << 32) | `s4`#[32..<0x40] } else { `s4`#[0..<0x40] }
  `s5` = _mux_11
  io.shiftNum = io_shiftNum#[0..<6]
  io.`in` = io_in#[0..<0x40]
  io.msb = io_msb & 1
  io.out = `s5`#[0..<0x40]
  io_out = io.out
}
