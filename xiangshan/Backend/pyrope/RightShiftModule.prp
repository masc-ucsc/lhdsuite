pub comb RightShiftModule::[timecheck=false](io_shamt:U6, io_src:U64) -> (io_srl:U64, io_sra:U64) {
  wire io:(shamt:U6, src:U64, srl:U64, sra:U64) = nil
  wire io_sra_shifted:U64 = nil
  wire io_sra_shifted_1:U64 = nil
  wire io_sra_shifted_2:U64 = nil
  wire io_sra_shifted_3:U64 = nil
  wire io_sra_shifted_4:U64 = nil
  wire io_sra_shifted_5:U64 = nil
  mut _mux_1:U64 = if io.shamt#[5..<6] != 0 { io.src#[32..<0x40]#sext[0..=31]#[0..<0x40] } else { io.src#[0..<0x40] }
  io_sra_shifted = _mux_1
  mut _mux_2:U64 = if io.shamt#[4..<5] != 0 { io_sra_shifted#[16..<0x40]#sext[0..=47]#[0..<0x40] } else { io_sra_shifted#[0..<0x40] }
  io_sra_shifted_1 = _mux_2
  mut _mux_3:U64 = if io.shamt#[3..<4] != 0 { io_sra_shifted_1#[8..<0x40]#sext[0..=55]#[0..<0x40] } else { io_sra_shifted_1#[0..<0x40] }
  io_sra_shifted_2 = _mux_3
  mut _mux_4:U64 = if io.shamt#[2..<3] != 0 { io_sra_shifted_2#[4..<0x40]#sext[0..=59]#[0..<0x40] } else { io_sra_shifted_2#[0..<0x40] }
  io_sra_shifted_3 = _mux_4
  mut _mux_5:U64 = if io.shamt#[1..<2] != 0 { io_sra_shifted_3#[2..<0x40]#sext[0..=61]#[0..<0x40] } else { io_sra_shifted_3#[0..<0x40] }
  io_sra_shifted_4 = _mux_5
  mut _mux_6:U64 = if (io.shamt & 1) != 0 { (io_sra_shifted_4#[63..<0x40] << 63) | io_sra_shifted_4#[1..<0x40] } else { io_sra_shifted_4#[0..<0x40] }
  io_sra_shifted_5 = _mux_6
  io.shamt = io_shamt#[0..<6]
  io.src = io_src#[0..<0x40]
  io.srl = (io.src >> io.shamt)#[0..<0x40]
  io.sra = io_sra_shifted_5#[0..<0x40]
  io_srl = io.srl
  io_sra = io.sra
}
