pub comb RightShiftModule::[timecheck=false](io_shamt:u6, io_src:u64) -> (io_srl:u64, io_sra:u64) {
  wire io:(shamt:u6, src:u64, srl:u64, sra:u64) = nil
  mut _mux_1:u64 = if ((io.shamt >> 5) & 1) != 0 { io.src#[32..=63]#sext[0..=31]#[0..=63] } else { io.src#[0..=63] }
  const io_sra_shifted__w1 = _mux_1
  mut _mux_2:u64 = if ((io.shamt >> 4) & 1) != 0 { io_sra_shifted__w1#[16..=63]#sext[0..=47]#[0..=63] } else { io_sra_shifted__w1 }
  const io_sra_shifted_1__w1 = _mux_2
  mut _mux_3:u64 = if ((io.shamt >> 3) & 1) != 0 { io_sra_shifted_1__w1#[8..=63]#sext[0..=55]#[0..=63] } else { io_sra_shifted_1__w1 }
  const io_sra_shifted_2__w1 = _mux_3
  mut _mux_4:u64 = if ((io.shamt >> 2) & 1) != 0 { io_sra_shifted_2__w1#[4..=63]#sext[0..=59]#[0..=63] } else { io_sra_shifted_2__w1 }
  const io_sra_shifted_3__w1 = _mux_4
  mut _mux_5:u64 = if ((io.shamt >> 1) & 1) != 0 { io_sra_shifted_3__w1#[2..=63]#sext[0..=61]#[0..=63] } else { io_sra_shifted_3__w1 }
  const io_sra_shifted_4__w1 = _mux_5
  mut _mux_6:u64 = if (io.shamt & 1) != 0 { (((io_sra_shifted_4__w1 >> 63) & 1) << 63) | io_sra_shifted_4__w1#[1..=63] } else { io_sra_shifted_4__w1 }
  io.shamt = io_shamt
  io.src = io_src
  io.srl = (io.src >> io.shamt)#[0..=63]
  io.sra = _mux_6
  io_srl = io.srl
  io_sra = io.sra
}
