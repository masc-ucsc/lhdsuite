pub mod Hviprio1Module::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(PrioSSI:u8, PrioSTI:u8, PrioCOI:u8, Prio14:u8, Prio15:u8)@[]) {
  reg reg_0:u40:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.PrioSSI` = 0
  mut `reg_init.PrioSTI` = 0
  mut `reg_init.PrioCOI` = 0
  mut `reg_init.Prio14` = 0
  mut `reg_init.Prio15` = 0
  mut `wdata.PrioSSI` = w.wdata#[8..=15]
  mut `wdata.PrioSTI` = w.wdata#[24..=31]
  mut `wdata.PrioCOI` = w.wdata#[40..=47]
  mut `wdata.Prio14` = w.wdata#[48..=55]
  mut `wdata.Prio15` = w.wdata#[56..=63]
  mut _mux_1:u8 = if w.wen != 0 { `wdata.PrioSSI`#[0..=7] } else { reg_0#[32..=39] }
  mut _mux_2:u8 = if w.wen != 0 { `wdata.PrioSTI`#[0..=7] } else { reg_0#[24..=31] }
  mut _mux_3:u8 = if w.wen != 0 { `wdata.PrioCOI`#[0..=7] } else { reg_0#[16..=23] }
  mut _mux_4:u8 = if w.wen != 0 { `wdata.Prio14`#[0..=7] } else { reg_0#[8..=15] }
  mut _mux_5:u8 = if w.wen != 0 { `wdata.Prio15`#[0..=7] } else { reg_0#[0..=7] }
  reg_0 = _mux_5 | (_mux_4 << 8) | (_mux_3 << 16) | (_mux_2 << 24) | (_mux_1 << 32)
  mut `regOut__bpo.PrioSSI` = reg_0#[32..=39]
  mut `regOut__bpo.PrioSTI` = reg_0#[24..=31]
  mut `regOut__bpo.PrioCOI` = reg_0#[16..=23]
  mut `regOut__bpo.Prio14` = reg_0#[8..=15]
  mut `regOut__bpo.Prio15` = reg_0#[0..=7]
  regOut.PrioSSI = `regOut__bpo.PrioSSI`
  regOut.PrioSTI = `regOut__bpo.PrioSTI`
  regOut.PrioCOI = `regOut__bpo.PrioCOI`
  regOut.Prio14 = `regOut__bpo.Prio14`
  regOut.Prio15 = `regOut__bpo.Prio15`
  rdata = (reg_0#[0..=7] << 56) | (reg_0#[8..=15] << 48) | (reg_0#[16..=23] << 40) | (reg_0#[24..=31] << 24) | (reg_0#[32..=39] << 8)
}
