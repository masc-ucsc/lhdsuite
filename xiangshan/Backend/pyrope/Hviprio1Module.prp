pub mod Hviprio1Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(PrioSSI:U8, PrioSTI:U8, PrioCOI:U8, Prio14:U8, Prio15:U8)@[]) {
  mut _mux_1:U8 = 0
  mut _mux_2:U8 = 0
  mut _mux_3:U8 = 0
  mut _mux_4:U8 = 0
  mut _mux_5:U8 = 0
  mut t28 = 0
  mut t29 = 0
  mut t30 = 0
  mut t31 = 0
  mut t32 = 0
  reg reg_0:U40:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U8
  reg _GEN_0:U8
  reg _GEN_1:U8
  reg _GEN_2:U8
  reg _GEN_3:U8
  wire `regOut__bpr.PrioSSI`:U8 = nil
  wire `regOut__bpr.PrioSTI`:U8 = nil
  wire `regOut__bpr.PrioCOI`:U8 = nil
  wire `regOut__bpr.Prio14`:U8 = nil
  wire `regOut__bpr.Prio15`:U8 = nil
  mut `reg_init.PrioSSI` = 0
  mut `reg_init.PrioSTI` = 0
  mut `reg_init.PrioCOI` = 0
  mut `reg_init.Prio14` = 0
  mut `reg_init.Prio15` = 0
  mut `wdata.PrioSSI` = w.wdata#[8..<16]
  mut `wdata.PrioSTI` = w.wdata#[24..<32]
  mut `wdata.PrioCOI` = w.wdata#[40..<48]
  mut `wdata.Prio14` = w.wdata#[48..<56]
  mut `wdata.Prio15` = w.wdata#[56..<0x40]
  t28 = _GEN
  t29 = _GEN_0
  t30 = _GEN_1
  t31 = _GEN_2
  t32 = _GEN_3
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.PrioSSI`#[0..<8] } else { reg_0#[32..<40] }
    t28 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.PrioSTI`#[0..<8] } else { reg_0#[24..<32] }
    t29 = _mux_2
    _mux_3 = if w.wen != 0 { `wdata.PrioCOI`#[0..<8] } else { reg_0#[16..<24] }
    t30 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.Prio14`#[0..<8] } else { reg_0#[8..<16] }
    t31 = _mux_4
    _mux_5 = if w.wen != 0 { `wdata.Prio15`#[0..<8] } else { reg_0#[0..<8] }
    t32 = _mux_5
    reg_0 = t32 | (t31 << 8) | (t30 << 16) | (t29 << 24) | (t28 << 32)
  }
  _GEN = t28
  _GEN_0 = t29
  _GEN_1 = t30
  _GEN_2 = t31
  _GEN_3 = t32
  mut `regOut__bpo.PrioSSI` = reg_0#[32..<40]
  mut `regOut__bpo.PrioSTI` = reg_0#[24..<32]
  mut `regOut__bpo.PrioCOI` = reg_0#[16..<24]
  mut `regOut__bpo.Prio14` = reg_0#[8..<16]
  mut `regOut__bpo.Prio15` = reg_0#[0..<8]
  const t77 = `regOut__bpo.PrioSSI`
  `regOut__bpr.PrioSSI` = t77
  regOut.PrioSSI = t77
  const t78 = `regOut__bpo.PrioSTI`
  `regOut__bpr.PrioSTI` = t78
  regOut.PrioSTI = t78
  const t79 = `regOut__bpo.PrioCOI`
  `regOut__bpr.PrioCOI` = t79
  regOut.PrioCOI = t79
  const t80 = `regOut__bpo.Prio14`
  `regOut__bpr.Prio14` = t80
  regOut.Prio14 = t80
  const t81 = `regOut__bpo.Prio15`
  `regOut__bpr.Prio15` = t81
  regOut.Prio15 = t81
  rdata = (reg_0#[0..<8] << 56) | (reg_0#[8..<16] << 48) | (reg_0#[16..<24] << 40) | (reg_0#[24..<32] << 24) | (reg_0#[32..<40] << 8)
}
