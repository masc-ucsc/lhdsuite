pub mod McorepwrModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(POWER_DOWN_ENABLE:U1)@[]) {
  mut _mux_1:U1 = 0
  mut t8 = 0
