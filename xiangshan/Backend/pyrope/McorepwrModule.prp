  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.POWER_DOWN_ENABLE` & 1 } else { reg_0 & 1 }
    t8 = _mux_1
    reg_0 = t8
  }
  _GEN = t8
  mut `regOut__bpo.POWER_DOWN_ENABLE` = reg_0 & 1
  const t17 = `regOut__bpo.POWER_DOWN_ENABLE`
  `regOut__bpr.POWER_DOWN_ENABLE` = t17
  regOut.POWER_DOWN_ENABLE = t17
  rdata = (reg_0 & 1)
