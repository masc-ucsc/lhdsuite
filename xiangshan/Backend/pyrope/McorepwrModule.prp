  reg _GEN:U1
  wire `regOut__bpr.POWER_DOWN_ENABLE`:U1 = nil
  mut `reg_init.POWER_DOWN_ENABLE` = 0
  mut `wdata.POWER_DOWN_ENABLE` = w.wdata & 1
