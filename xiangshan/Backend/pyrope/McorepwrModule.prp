pub mod McorepwrModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(POWER_DOWN_ENABLE:u1)@[]) {
  reg reg_0:u1:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.POWER_DOWN_ENABLE` = 0
  mut `wdata.POWER_DOWN_ENABLE` = w.wdata & 1
  mut _mux_1:u1 = if w.wen != 0 { `wdata.POWER_DOWN_ENABLE` & 1 } else { reg_0 & 1 }
  reg_0 = _mux_1
  mut `regOut__bpo.POWER_DOWN_ENABLE` = reg_0 & 1
  regOut.POWER_DOWN_ENABLE = `regOut__bpo.POWER_DOWN_ENABLE`
  rdata = (reg_0 & 1)
}
