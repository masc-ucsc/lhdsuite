pub mod MinstretcfgModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), fromSireg2:(valid:u1, bits:u64)) -> (rdata:u64@[], regOut:(MINH:u1, SINH:u1, UINH:u1, VSINH:u1, VUINH:u1)@[], toSireg2:u64@[]) {
  reg reg_0:u5:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.MINH` = 0
  mut `reg_init.SINH` = 0
  mut `reg_init.UINH` = 0
  mut `reg_init.VSINH` = 0
  mut `reg_init.VUINH` = 0
  mut `wdata.MINH` = (w.wdata >> 62) & 1
  mut `wdata.SINH` = (w.wdata >> 61) & 1
  mut `wdata.UINH` = (w.wdata >> 60) & 1
  mut `wdata.VSINH` = (w.wdata >> 59) & 1
  mut `wdata.VUINH` = (w.wdata >> 58) & 1
  mut _mux_1:u1 = if fromSireg2.valid != 0 { (fromSireg2.bits >> 62) & 1 } else { (reg_0 >> 4) & 1 }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.MINH` & 1 } else { _mux_1 & 1 }
  mut _mux_3:u1 = if fromSireg2.valid != 0 { (fromSireg2.bits >> 61) & 1 } else { (reg_0 >> 3) & 1 }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.SINH` & 1 } else { _mux_3 & 1 }
  mut _mux_5:u1 = if fromSireg2.valid != 0 { (fromSireg2.bits >> 60) & 1 } else { (reg_0 >> 2) & 1 }
  mut _mux_6:u1 = if w.wen != 0 { `wdata.UINH` & 1 } else { _mux_5 & 1 }
  mut _mux_7:u1 = if fromSireg2.valid != 0 { (fromSireg2.bits >> 59) & 1 } else { (reg_0 >> 1) & 1 }
  mut _mux_8:u1 = if w.wen != 0 { `wdata.VSINH` & 1 } else { _mux_7 & 1 }
  mut _mux_9:u1 = if fromSireg2.valid != 0 { (fromSireg2.bits >> 58) & 1 } else { reg_0 & 1 }
  mut _mux_10:u1 = if w.wen != 0 { `wdata.VUINH` & 1 } else { _mux_9 & 1 }
  reg_0 = _mux_10 | (_mux_8 << 1) | (_mux_6 << 2) | (_mux_4 << 3) | (_mux_2 << 4)
  mut `regOut__bpo.MINH` = (reg_0 >> 4) & 1
  mut `regOut__bpo.SINH` = (reg_0 >> 3) & 1
  mut `regOut__bpo.UINH` = (reg_0 >> 2) & 1
  mut `regOut__bpo.VSINH` = (reg_0 >> 1) & 1
  mut `regOut__bpo.VUINH` = reg_0 & 1
  regOut.MINH = `regOut__bpo.MINH`
  regOut.SINH = `regOut__bpo.SINH`
  regOut.UINH = `regOut__bpo.UINH`
  regOut.VSINH = `regOut__bpo.VSINH`
  regOut.VUINH = `regOut__bpo.VUINH`
  rdata = (((reg_0 >> 4) & 1) << 62) | (((reg_0 >> 3) & 1) << 61) | (((reg_0 >> 2) & 1) << 60) | (((reg_0 >> 1) & 1) << 59) | ((reg_0 & 1) << 58)
  toSireg2 = (((reg_0 >> 4) & 1) << 62) | (((reg_0 >> 3) & 1) << 61) | (((reg_0 >> 2) & 1) << 60) | (((reg_0 >> 1) & 1) << 59) | ((reg_0 & 1) << 58)
}
