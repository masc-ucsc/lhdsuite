pub mod MinstretcfgModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), fromSireg2:(valid:U1, bits:U64)) -> (rdata:U64@[], regOut:(MINH:U1, SINH:U1, UINH:U1, VSINH:U1, VUINH:U1)@[], toSireg2:U64@[]) {
  mut _mux_1:U1 = 0
  mut _mux_10:U1 = 0
  mut _mux_2:U1 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U1 = 0
  mut _mux_5:U1 = 0
  mut _mux_6:U1 = 0
  mut _mux_7:U1 = 0
  mut _mux_8:U1 = 0
  mut _mux_9:U1 = 0
  mut t28 = 0
  mut t29 = 0
  mut t30 = 0
  mut t31 = 0
  mut t32 = 0
  mut t33 = 0
  mut t34 = 0
  mut t35 = 0
  mut t36 = 0
  mut t37 = 0
  reg reg_0:U5:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U1
  reg _GEN_0:U1
  reg _GEN_1:U1
  reg _GEN_2:U1
  reg _GEN_3:U1
  reg _GEN_4:U1
  reg _GEN_5:U1
  reg _GEN_6:U1
  reg _GEN_7:U1
  reg _GEN_8:U1
  wire `regOut__bpr.MINH`:U1 = nil
  wire `regOut__bpr.SINH`:U1 = nil
  wire `regOut__bpr.UINH`:U1 = nil
  wire `regOut__bpr.VSINH`:U1 = nil
  wire `regOut__bpr.VUINH`:U1 = nil
  mut `reg_init.MINH` = 0
  mut `reg_init.SINH` = 0
  mut `reg_init.UINH` = 0
  mut `reg_init.VSINH` = 0
  mut `reg_init.VUINH` = 0
  mut `wdata.MINH` = w.wdata#[62..<63]
  mut `wdata.SINH` = w.wdata#[61..<62]
  mut `wdata.UINH` = w.wdata#[60..<61]
  mut `wdata.VSINH` = w.wdata#[59..<60]
  mut `wdata.VUINH` = w.wdata#[58..<59]
  t28 = _GEN
  t29 = _GEN_0
  t30 = _GEN_1
  t31 = _GEN_2
  t32 = _GEN_3
  t33 = _GEN_4
  t34 = _GEN_5
  t35 = _GEN_6
  t36 = _GEN_7
  t37 = _GEN_8
  if not (`reset` != 0) {
    _mux_1 = if fromSireg2.valid != 0 { fromSireg2.bits#[62..<63] } else { reg_0#[4..<5] }
    t28 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.MINH` & 1 } else { t28 & 1 }
    t29 = _mux_2
    _mux_3 = if fromSireg2.valid != 0 { fromSireg2.bits#[61..<62] } else { reg_0#[3..<4] }
    t30 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.SINH` & 1 } else { t30 & 1 }
    t31 = _mux_4
    _mux_5 = if fromSireg2.valid != 0 { fromSireg2.bits#[60..<61] } else { reg_0#[2..<3] }
    t32 = _mux_5
    _mux_6 = if w.wen != 0 { `wdata.UINH` & 1 } else { t32 & 1 }
    t33 = _mux_6
    _mux_7 = if fromSireg2.valid != 0 { fromSireg2.bits#[59..<60] } else { reg_0#[1..<2] }
    t34 = _mux_7
    _mux_8 = if w.wen != 0 { `wdata.VSINH` & 1 } else { t34 & 1 }
    t35 = _mux_8
    _mux_9 = if fromSireg2.valid != 0 { fromSireg2.bits#[58..<59] } else { reg_0 & 1 }
    t36 = _mux_9
    _mux_10 = if w.wen != 0 { `wdata.VUINH` & 1 } else { t36 & 1 }
    t37 = _mux_10
    reg_0 = t37 | (t35 << 1) | (t33 << 2) | (t31 << 3) | (t29 << 4)
  }
  _GEN = t28
  _GEN_0 = t29
  _GEN_1 = t30
  _GEN_2 = t31
  _GEN_3 = t32
  _GEN_4 = t33
  _GEN_5 = t34
  _GEN_6 = t35
  _GEN_7 = t36
  _GEN_8 = t37
  mut `regOut__bpo.MINH` = reg_0#[4..<5]
  mut `regOut__bpo.SINH` = reg_0#[3..<4]
  mut `regOut__bpo.UINH` = reg_0#[2..<3]
  mut `regOut__bpo.VSINH` = reg_0#[1..<2]
  mut `regOut__bpo.VUINH` = reg_0 & 1
  const t113 = `regOut__bpo.MINH`
  `regOut__bpr.MINH` = t113
  regOut.MINH = t113
  const t114 = `regOut__bpo.SINH`
  `regOut__bpr.SINH` = t114
  regOut.SINH = t114
  const t115 = `regOut__bpo.UINH`
  `regOut__bpr.UINH` = t115
  regOut.UINH = t115
  const t116 = `regOut__bpo.VSINH`
  `regOut__bpr.VSINH` = t116
  regOut.VSINH = t116
  const t117 = `regOut__bpo.VUINH`
  `regOut__bpr.VUINH` = t117
  regOut.VUINH = t117
  rdata = (reg_0#[4..<5] << 62) | (reg_0#[3..<4] << 61) | (reg_0#[2..<3] << 60) | (reg_0#[1..<2] << 59) | ((reg_0 & 1) << 58)
  toSireg2 = (reg_0#[4..<5] << 62) | (reg_0#[3..<4] << 61) | (reg_0#[2..<3] << 60) | (reg_0#[1..<2] << 59) | ((reg_0 & 1) << 58)
}
