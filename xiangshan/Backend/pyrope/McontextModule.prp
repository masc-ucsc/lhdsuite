pub mod McontextModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), fromHcontext:(valid:u1, bits:(HCONTEXT:u14))) -> (rdata:u14@[], regOut:(HCONTEXT:u14)@[], toHcontext:(HCONTEXT:u14)@[]) {
  reg reg_0:u14:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.HCONTEXT` = 0
  mut `wdata.HCONTEXT` = w.wdata#[0..=13]
  mut _mux_1:u14 = if fromHcontext.valid != 0 { fromHcontext.bits.HCONTEXT#[0..=13] } else { reg_0 }
  mut _mux_2:u14 = if w.wen != 0 { `wdata.HCONTEXT`#[0..=13] } else { _mux_1 }
  reg_0 = _mux_2
  mut `regOut__bpo.HCONTEXT` = reg_0
  mut `toHcontext__bpo.HCONTEXT` = reg_0
  regOut.HCONTEXT = `regOut__bpo.HCONTEXT`
  toHcontext.HCONTEXT = `toHcontext__bpo.HCONTEXT`
  rdata = reg_0
}
