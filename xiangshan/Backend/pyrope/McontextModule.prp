pub mod McontextModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), fromHcontext:(valid:U1, bits:(HCONTEXT:U14))) -> (rdata:U14@[], regOut:(HCONTEXT:U14)@[], toHcontext:(HCONTEXT:U14)@[]) {
  mut _mux_1:U14 = 0
  mut _mux_2:U14 = 0
  mut t10 = 0
  mut t9 = 0
  reg reg_0:U14:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U14
  reg _GEN_0:U14
  wire `regOut__bpr.HCONTEXT`:U14 = nil
  wire `toHcontext__bpr.HCONTEXT`:U14 = nil
  mut `reg_init.HCONTEXT` = 0
  mut `wdata.HCONTEXT` = w.wdata#[0..<14]
  t9 = _GEN
  t10 = _GEN_0
  if not (`reset` != 0) {
    _mux_1 = if fromHcontext.valid != 0 { fromHcontext.bits.HCONTEXT#[0..<14] } else { reg_0#[0..<14] }
    t9 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.HCONTEXT`#[0..<14] } else { t9#[0..<14] }
    t10 = _mux_2
    reg_0 = t10
  }
  _GEN = t9
  _GEN_0 = t10
  mut `regOut__bpo.HCONTEXT` = reg_0#[0..<14]
  mut `toHcontext__bpo.HCONTEXT` = reg_0#[0..<14]
  const t24 = `regOut__bpo.HCONTEXT`
  `regOut__bpr.HCONTEXT` = t24
  regOut.HCONTEXT = t24
  const t25 = `toHcontext__bpo.HCONTEXT`
  `toHcontext__bpr.HCONTEXT` = t25
  toHcontext.HCONTEXT = t25
  rdata = reg_0#[0..<14]
}
