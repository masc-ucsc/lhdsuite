pub mod HcontextModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), fromMcontext:(HCONTEXT:u14)) -> (rdata:u14@[], regOut:(HCONTEXT:u14)@[], toMcontext:(valid:u1, bits:(HCONTEXT:u14))@[]) {
  reg reg_0:u14:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.HCONTEXT` = 0
  mut `wdata.HCONTEXT` = w.wdata#[0..=13]
  mut _mux_1:u14 = if w.wen != 0 { `wdata.HCONTEXT`#[0..=13] } else { reg_0 }
  reg_0 = _mux_1
  mut `regOut__bpo.HCONTEXT` = fromMcontext.HCONTEXT#[0..=13]
  const t19 = `wdata.HCONTEXT` | (w.wen << 14)
  mut `toMcontext__bpo.valid` = (t19 >> 14) & 1
  mut `toMcontext__bpo.bits.HCONTEXT` = t19#[0..=13]
  regOut.HCONTEXT = `regOut__bpo.HCONTEXT`
  toMcontext.valid = `toMcontext__bpo.valid`
  toMcontext.bits.HCONTEXT = `toMcontext__bpo.bits.HCONTEXT`
  rdata = fromMcontext.HCONTEXT
}
