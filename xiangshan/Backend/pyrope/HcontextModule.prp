pub mod HcontextModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), fromMcontext:(HCONTEXT:U14)) -> (rdata:U14@[], regOut:(HCONTEXT:U14)@[], toMcontext:(valid:U1, bits:(HCONTEXT:U14))@[]) {
  mut _mux_1:U14 = 0
  mut t10 = 0
  reg reg_0:U14:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U14
  wire `regOut__bpr.HCONTEXT`:U14 = nil
  wire `toMcontext__bpr.valid`:U1 = nil
  wire `toMcontext__bpr.bits.HCONTEXT`:U14 = nil
  mut `reg_init.HCONTEXT` = 0
  mut `wdata.HCONTEXT` = w.wdata#[0..<14]
  t10 = _GEN
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.HCONTEXT`#[0..<14] } else { reg_0#[0..<14] }
    t10 = _mux_1
    reg_0 = t10
  }
  _GEN = t10
  mut `regOut__bpo.HCONTEXT` = fromMcontext.HCONTEXT#[0..<14]
  const t22 = `wdata.HCONTEXT` | (w.wen << 14)
  mut `toMcontext__bpo.valid` = t22#[14..<15]
  mut `toMcontext__bpo.bits.HCONTEXT` = t22#[0..<14]
  const t25 = `regOut__bpo.HCONTEXT`
  `regOut__bpr.HCONTEXT` = t25
  regOut.HCONTEXT = t25
  const t26 = `toMcontext__bpo.valid`
  `toMcontext__bpr.valid` = t26
  toMcontext.valid = t26
  const t27 = `toMcontext__bpo.bits.HCONTEXT`
  `toMcontext__bpr.bits.HCONTEXT` = t27
  toMcontext.bits.HCONTEXT = t27
  rdata = fromMcontext.HCONTEXT
}
