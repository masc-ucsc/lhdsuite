pub comb FarShiftRightWithMuxInvFirst_22::[timecheck=false](io_src:u26, io_shiftValue:u4, io_EOP:u1) -> (io_result:u26) {
  wire io:(src:u26, shiftValue:u4, result:u26, EOP:u1) = nil
  wire io_result_res_vec:(e4:u26, e3:u26, e2:u26, e1:u26, e0:u26) = nil
  mut _mux_1:u26 = if (io.shiftValue & 1) != 0 { ((io.EOP & 1) << 25) | io_result_res_vec.e0#[1..=25] } else { io_result_res_vec.e0#[0..=25] }
  mut _rep_2:u2 = if (io.EOP & 1) != 0 { 3 } else { 0 }
  mut _mux_3:u26 = if ((io.shiftValue >> 1) & 1) != 0 { (_rep_2 << 24) | io_result_res_vec.e1#[2..=25] } else { io_result_res_vec.e1#[0..=25] }
  mut _rep_4:u4 = if (io.EOP & 1) != 0 { 15 } else { 0 }
  mut _mux_5:u26 = if ((io.shiftValue >> 2) & 1) != 0 { (_rep_4 << 22) | io_result_res_vec.e2#[4..=25] } else { io_result_res_vec.e2#[0..=25] }
  mut _rep_6:u8 = if (io.EOP & 1) != 0 { 0xff } else { 0 }
  mut _mux_7:u26 = if ((io.shiftValue >> 3) & 1) != 0 { (_rep_6 << 18) | io_result_res_vec.e3#[8..=25] } else { io_result_res_vec.e3#[0..=25] }
  io_result_res_vec.e4 = _mux_7
  io_result_res_vec.e3 = _mux_5
  io_result_res_vec.e2 = _mux_3
  io_result_res_vec.e1 = _mux_1
  io_result_res_vec.e0 = io.src#[0..=25]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec.e4#[0..=25]
  io.EOP = io_EOP & 1
  io_result = io.result
}
