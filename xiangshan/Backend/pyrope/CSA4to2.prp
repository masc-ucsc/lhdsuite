pub comb CSA4to2::[timecheck=false](io_ppIn:U512) -> (io_ppOut:U256) {
  wire io:(ppIn:U512, ppOut:U256) = nil
  wire l1pp2:U128 = nil
  wire l0ppS:U128 = nil
  wire l1pp0:U128 = nil
  wire l0ppC:U128 = nil
  wire l1pp1:U128 = nil
  wire l2ppS:U128 = nil
  wire ppOut0:U128 = nil
  wire l2ppC:U128 = nil
  wire ppOut1:U128 = nil
  l1pp2 = io.ppIn#[0x180..<0x200]
  l0ppS = ((io.ppIn#[0..<0x80] ^ io.ppIn#[0x80..<0x100])#[0..<0x80] ^ io.ppIn#[0x100..<0x180])#[0..<0x80]
  l1pp0 = l0ppS
  l0ppC = (((io.ppIn#[0..<0x80] & io.ppIn#[0x80..<0x100])#[0..<0x80] | (io.ppIn#[0..<0x80] & io.ppIn#[0x100..<0x180])#[0..<0x80])#[0..<0x80] | (io.ppIn#[0x80..<0x100] & io.ppIn#[0x100..<0x180])#[0..<0x80])#[0..<0x80]
  l1pp1 = l0ppC#[0..<0x7f] << 1
  l2ppS = ((l1pp0 ^ l1pp1)#[0..<0x80] ^ l1pp2)#[0..<0x80]
  ppOut0 = l2ppS
  l2ppC = (((l1pp0 & l1pp1)#[0..<0x80] | (l1pp0 & l1pp2)#[0..<0x80])#[0..<0x80] | (l1pp1 & l1pp2)#[0..<0x80])#[0..<0x80]
  ppOut1 = l2ppC#[0..<0x7f] << 1
  io.ppIn = io_ppIn#[0..<0x200]
  io.ppOut = (ppOut1#[0..<0x80] << 128) | ppOut0#[0..<0x80]
  io_ppOut = io.ppOut
}
