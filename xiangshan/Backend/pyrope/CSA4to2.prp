pub comb CSA4to2::[timecheck=false](io_ppIn:u512) -> (io_ppOut:u256) {
  wire io:(ppIn:u512, ppOut:u256) = nil
  const l1pp2__w1 = io.ppIn#[384..=511]
  const l1pp0__w1 = (io.ppIn#[0..=127] ^ io.ppIn#[128..=255]) ^ io.ppIn#[256..=383]
  const l1pp1__w1 = (((io.ppIn#[0..=127] & io.ppIn#[128..=255]) | (io.ppIn#[0..=127] & io.ppIn#[256..=383])) | (io.ppIn#[128..=255] & io.ppIn#[256..=383]))#[0..=126] << 1
  const ppOut0__w1 = (l1pp0__w1 ^ l1pp1__w1) ^ l1pp2__w1
  const ppOut1__w1 = (((l1pp0__w1 & l1pp1__w1) | (l1pp0__w1 & l1pp2__w1)) | (l1pp1__w1 & l1pp2__w1))#[0..=126] << 1
  io.ppIn = io_ppIn
  io.ppOut = (ppOut1__w1 << 128) | ppOut0__w1
  io_ppOut = io.ppOut
}
