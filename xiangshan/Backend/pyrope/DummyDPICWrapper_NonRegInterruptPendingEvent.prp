const DiffExtNonRegInterruptPendingEvent = import("DiffExtNonRegInterruptPendingEvent.DiffExtNonRegInterruptPendingEvent")

pub mod DummyDPICWrapper_NonRegInterruptPendingEvent::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(valid:u1, platformIRPMeip:u1, platformIRPMtip:u1, platformIRPMsip:u1, platformIRPSeip:u1, platformIRPStip:u1, platformIRPVseip:u1, platformIRPVstip:u1, fromAIAMeip:u1, fromAIASeip:u1, localCounterOverflowInterruptReq:u1, coreid:u8))) -> () {
  mut dpic = DiffExtNonRegInterruptPendingEvent::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 19) | (io.bits.valid << 18) | (io.bits.platformIRPMeip << 17) | (io.bits.platformIRPMtip << 16) | (io.bits.platformIRPMsip << 15) | (io.bits.platformIRPSeip << 14) | (io.bits.platformIRPStip << 13) | (io.bits.platformIRPVseip << 12) | (io.bits.platformIRPVstip << 11) | (io.bits.fromAIAMeip << 10) | (io.bits.fromAIASeip << 9) | (io.bits.localCounterOverflowInterruptReq << 8) | io.bits.coreid)#[0..=18])
}
