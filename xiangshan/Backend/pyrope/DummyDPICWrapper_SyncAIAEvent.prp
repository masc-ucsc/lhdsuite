const DiffExtSyncAIAEvent = import("DiffExtSyncAIAEvent.DiffExtSyncAIAEvent")

pub mod DummyDPICWrapper_SyncAIAEvent::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(valid:u1, mtopei:u64, stopei:u64, vstopei:u64, hgeip:u64, coreid:u8))) -> () {
  mut dpic = DiffExtSyncAIAEvent::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x109) | (io.bits.valid << 0x108) | (io.bits.mtopei << 0xc8) | (io.bits.stopei << 0x88) | (io.bits.vstopei << 0x48) | (io.bits.hgeip << 8) | io.bits.coreid)#[0..=264])
}
