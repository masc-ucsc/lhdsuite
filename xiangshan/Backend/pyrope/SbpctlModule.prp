pub mod SbpctlModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(RAS_ENABLE:U1, ITTAGE_ENABLE:U1, SC_ENABLE:U1, TAGE_ENABLE:U1, MBTB_ENABLE:U1, ABTB_ENABLE:U1, UBTB_ENABLE:U1)@[]) {
  mut _mux_1:U1 = 0
  mut _mux_2:U1 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U1 = 0
  mut _mux_5:U1 = 0
  mut _mux_6:U1 = 0
  mut _mux_7:U1 = 0
  mut t38 = 0
  mut t39 = 0
  mut t40 = 0
  mut t41 = 0
  mut t42 = 0
  mut t43 = 0
  mut t44 = 0
  reg reg_0:U7:[initial=127, reset_pin=`reset`, async=true]
  reg _GEN:U1
  reg _GEN_0:U1
  reg _GEN_1:U1
  reg _GEN_2:U1
  reg _GEN_3:U1
  reg _GEN_4:U1
  reg _GEN_5:U1
  wire `regOut__bpr.RAS_ENABLE`:U1 = nil
  wire `regOut__bpr.ITTAGE_ENABLE`:U1 = nil
  wire `regOut__bpr.SC_ENABLE`:U1 = nil
  wire `regOut__bpr.TAGE_ENABLE`:U1 = nil
  wire `regOut__bpr.MBTB_ENABLE`:U1 = nil
  wire `regOut__bpr.ABTB_ENABLE`:U1 = nil
  wire `regOut__bpr.UBTB_ENABLE`:U1 = nil
  mut `reg_init.RAS_ENABLE` = 1
  mut `reg_init.ITTAGE_ENABLE` = 1
  mut `reg_init.SC_ENABLE` = 1
  mut `reg_init.TAGE_ENABLE` = 1
  mut `reg_init.MBTB_ENABLE` = 1
  mut `reg_init.ABTB_ENABLE` = 1
  mut `reg_init.UBTB_ENABLE` = 1
  mut `wdata.RAS_ENABLE` = w.wdata#[6..<7]
  mut `wdata.ITTAGE_ENABLE` = w.wdata#[5..<6]
  mut `wdata.SC_ENABLE` = w.wdata#[4..<5]
  mut `wdata.TAGE_ENABLE` = w.wdata#[3..<4]
  mut `wdata.MBTB_ENABLE` = w.wdata#[2..<3]
  mut `wdata.ABTB_ENABLE` = w.wdata#[1..<2]
  mut `wdata.UBTB_ENABLE` = w.wdata & 1
  t38 = _GEN
  t39 = _GEN_0
  t40 = _GEN_1
  t41 = _GEN_2
  t42 = _GEN_3
  t43 = _GEN_4
  t44 = _GEN_5
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.RAS_ENABLE` & 1 } else { reg_0#[6..<7] }
    t38 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.ITTAGE_ENABLE` & 1 } else { reg_0#[5..<6] }
    t39 = _mux_2
    _mux_3 = if w.wen != 0 { `wdata.SC_ENABLE` & 1 } else { reg_0#[4..<5] }
    t40 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.TAGE_ENABLE` & 1 } else { reg_0#[3..<4] }
    t41 = _mux_4
    _mux_5 = if w.wen != 0 { `wdata.MBTB_ENABLE` & 1 } else { reg_0#[2..<3] }
    t42 = _mux_5
    _mux_6 = if w.wen != 0 { `wdata.ABTB_ENABLE` & 1 } else { reg_0#[1..<2] }
    t43 = _mux_6
    _mux_7 = if w.wen != 0 { `wdata.UBTB_ENABLE` & 1 } else { reg_0 & 1 }
    t44 = _mux_7
    reg_0 = t44 | (t43 << 1) | (t42 << 2) | (t41 << 3) | (t40 << 4) | (t39 << 5) | (t38 << 6)
  }
  _GEN = t38
  _GEN_0 = t39
  _GEN_1 = t40
  _GEN_2 = t41
  _GEN_3 = t42
  _GEN_4 = t43
  _GEN_5 = t44
  mut `regOut__bpo.RAS_ENABLE` = reg_0#[6..<7]
  mut `regOut__bpo.ITTAGE_ENABLE` = reg_0#[5..<6]
  mut `regOut__bpo.SC_ENABLE` = reg_0#[4..<5]
  mut `regOut__bpo.TAGE_ENABLE` = reg_0#[3..<4]
  mut `regOut__bpo.MBTB_ENABLE` = reg_0#[2..<3]
  mut `regOut__bpo.ABTB_ENABLE` = reg_0#[1..<2]
  mut `regOut__bpo.UBTB_ENABLE` = reg_0 & 1
  const t107 = `regOut__bpo.RAS_ENABLE`
  `regOut__bpr.RAS_ENABLE` = t107
  regOut.RAS_ENABLE = t107
  const t108 = `regOut__bpo.ITTAGE_ENABLE`
  `regOut__bpr.ITTAGE_ENABLE` = t108
  regOut.ITTAGE_ENABLE = t108
  const t109 = `regOut__bpo.SC_ENABLE`
  `regOut__bpr.SC_ENABLE` = t109
  regOut.SC_ENABLE = t109
  const t110 = `regOut__bpo.TAGE_ENABLE`
  `regOut__bpr.TAGE_ENABLE` = t110
  regOut.TAGE_ENABLE = t110
  const t111 = `regOut__bpo.MBTB_ENABLE`
  `regOut__bpr.MBTB_ENABLE` = t111
  regOut.MBTB_ENABLE = t111
  const t112 = `regOut__bpo.ABTB_ENABLE`
  `regOut__bpr.ABTB_ENABLE` = t112
  regOut.ABTB_ENABLE = t112
  const t113 = `regOut__bpo.UBTB_ENABLE`
  `regOut__bpr.UBTB_ENABLE` = t113
  regOut.UBTB_ENABLE = t113
  rdata = (reg_0#[6..<7] << 6) | (reg_0#[5..<6] << 5) | (reg_0#[4..<5] << 4) | (reg_0#[3..<4] << 3) | (reg_0#[2..<3] << 2) | (reg_0#[1..<2] << 1) | (reg_0 & 1)
}
