pub mod SbpctlModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(RAS_ENABLE:u1, ITTAGE_ENABLE:u1, SC_ENABLE:u1, TAGE_ENABLE:u1, MBTB_ENABLE:u1, ABTB_ENABLE:u1, UBTB_ENABLE:u1)@[]) {
  reg reg_0:u7:[init=127, reset_pin=ref reset, async=true]
  mut `reg_init.RAS_ENABLE` = 0
  mut `reg_init.ITTAGE_ENABLE` = 0
  mut `reg_init.SC_ENABLE` = 0
  mut `reg_init.TAGE_ENABLE` = 0
  mut `reg_init.MBTB_ENABLE` = 0
  mut `reg_init.ABTB_ENABLE` = 0
  mut `reg_init.UBTB_ENABLE` = 0
  mut `wdata.RAS_ENABLE` = (w.wdata >> 6) & 1
  mut `wdata.ITTAGE_ENABLE` = (w.wdata >> 5) & 1
  mut `wdata.SC_ENABLE` = (w.wdata >> 4) & 1
  mut `wdata.TAGE_ENABLE` = (w.wdata >> 3) & 1
  mut `wdata.MBTB_ENABLE` = (w.wdata >> 2) & 1
  mut `wdata.ABTB_ENABLE` = (w.wdata >> 1) & 1
  mut `wdata.UBTB_ENABLE` = w.wdata & 1
  mut _mux_1:u1 = if w.wen != 0 { `wdata.RAS_ENABLE` & 1 } else { (reg_0 >> 6) & 1 }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.ITTAGE_ENABLE` & 1 } else { (reg_0 >> 5) & 1 }
  mut _mux_3:u1 = if w.wen != 0 { `wdata.SC_ENABLE` & 1 } else { (reg_0 >> 4) & 1 }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.TAGE_ENABLE` & 1 } else { (reg_0 >> 3) & 1 }
  mut _mux_5:u1 = if w.wen != 0 { `wdata.MBTB_ENABLE` & 1 } else { (reg_0 >> 2) & 1 }
  mut _mux_6:u1 = if w.wen != 0 { `wdata.ABTB_ENABLE` & 1 } else { (reg_0 >> 1) & 1 }
  mut _mux_7:u1 = if w.wen != 0 { `wdata.UBTB_ENABLE` & 1 } else { reg_0 & 1 }
  reg_0 = _mux_7 | (_mux_6 << 1) | (_mux_5 << 2) | (_mux_4 << 3) | (_mux_3 << 4) | (_mux_2 << 5) | (_mux_1 << 6)
  mut `regOut__bpo.RAS_ENABLE` = (reg_0 >> 6) & 1
  mut `regOut__bpo.ITTAGE_ENABLE` = (reg_0 >> 5) & 1
  mut `regOut__bpo.SC_ENABLE` = (reg_0 >> 4) & 1
  mut `regOut__bpo.TAGE_ENABLE` = (reg_0 >> 3) & 1
  mut `regOut__bpo.MBTB_ENABLE` = (reg_0 >> 2) & 1
  mut `regOut__bpo.ABTB_ENABLE` = (reg_0 >> 1) & 1
  mut `regOut__bpo.UBTB_ENABLE` = reg_0 & 1
  regOut.RAS_ENABLE = `regOut__bpo.RAS_ENABLE`
  regOut.ITTAGE_ENABLE = `regOut__bpo.ITTAGE_ENABLE`
  regOut.SC_ENABLE = `regOut__bpo.SC_ENABLE`
  regOut.TAGE_ENABLE = `regOut__bpo.TAGE_ENABLE`
  regOut.MBTB_ENABLE = `regOut__bpo.MBTB_ENABLE`
  regOut.ABTB_ENABLE = `regOut__bpo.ABTB_ENABLE`
  regOut.UBTB_ENABLE = `regOut__bpo.UBTB_ENABLE`
  rdata = (((reg_0 >> 6) & 1) << 6) | (((reg_0 >> 5) & 1) << 5) | (((reg_0 >> 4) & 1) << 4) | (((reg_0 >> 3) & 1) << 3) | (((reg_0 >> 2) & 1) << 2) | (((reg_0 >> 1) & 1) << 1) | (reg_0 & 1)
}
