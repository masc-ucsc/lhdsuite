pub mod Pmpaddr4Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), addrRData:U2048) -> (rdata:U64@[], regOut:(ADDRESS:U46)@[]) {
  mut _mux_1:U46 = 0
  mut t8 = 0
  reg reg_0:U46:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U46
  wire `regOut__bpr.ADDRESS`:U46 = nil
  mut `reg_init.ADDRESS` = 0
  mut `wdata.ADDRESS` = w.wdata#[0..<46]
  t8 = _GEN
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.ADDRESS`#[0..<46] } else { reg_0#[0..<46] }
    t8 = _mux_1
    reg_0 = t8
  }
  _GEN = t8
  mut `regOut__bpo.ADDRESS` = reg_0#[0..<46]
  const t16 = `regOut__bpo.ADDRESS`
  `regOut__bpr.ADDRESS` = t16
  regOut.ADDRESS = t16
  rdata = addrRData#[0x100..<0x140]
}
