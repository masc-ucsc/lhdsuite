pub comb JumpDataModule::[timecheck=false](io_src:u64, io_pc:u64, io_imm:u33, io_nextPcOffset:u7, io_func:u9, io_isRVC:u1) -> (io_result:u64, io_target:u64, io_isAuipc:u1) {
  wire io:(src:u64, pc:u64, imm:u33, nextPcOffset:u7, func:u9, isRVC:u1, result:u64, target:u64, isAuipc:u1) = nil
  const isAuipc__w1 = (io.func >> 1) & 1
  mut _rep_1:u31 = if (((io.imm >> 32) & 1) & 1) != 0 { 0x7fffffff } else { 0 }
  const offset__w1 = (_rep_1 << 33) | io.imm#[0..=32]
  mut _mux_2:u64 = if (io.func & 1) != 0 { (io.src + offset__w1)#[0..=63] } else { (io.pc + offset__w1)#[0..=63] }
  const target__w1 = _mux_2
  mut _mux_3:u64 = if isAuipc__w1 != 0 { target__w1 } else { (io.pc + io.nextPcOffset#[0..=6])#[0..=63] }
  io.src = io_src
  io.pc = io_pc
  io.imm = io_imm
  io.nextPcOffset = io_nextPcOffset
  io.func = io_func
  io.isRVC = io_isRVC & 1
  io.result = _mux_3
  io.target = target__w1#[1..=63] << 1
  io.isAuipc = isAuipc__w1 & 1
  io_result = io.result
  io_target = io.target
  io_isAuipc = io.isAuipc
}
