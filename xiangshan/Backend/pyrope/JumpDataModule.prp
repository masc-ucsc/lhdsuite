pub comb JumpDataModule::[timecheck=false](io_src:U64, io_pc:U64, io_imm:U33, io_nextPcOffset:U7, io_func:U9, io_isRVC:U1) -> (io_result:U64, io_target:U64, io_isAuipc:U1) {
  wire io:(src:U64, pc:U64, imm:U33, nextPcOffset:U7, func:U9, isRVC:U1, result:U64, target:U64, isAuipc:U1) = nil
  wire isJalr:U1 = nil
  wire isAuipc:U1 = nil
  wire offset_signBit:U1 = nil
  wire offset:U64 = nil
  wire snpc:U64 = nil
  wire target:U64 = nil
  wire _io_result_T_1:U64 = nil
  isJalr = io.func & 1
  isAuipc = io.func#[1..<2]
  offset_signBit = io.imm#[32..<33]
  mut _rep_1:U31 = if (offset_signBit & 1) != 0 { 0x7fffffff } else { 0 }
  offset = (_rep_1#[0..<31] << 33) | io.imm#[0..<33]
  snpc = (io.pc + io.nextPcOffset#[0..<7])#[0..<0x40]
  mut _mux_2:U64 = if isJalr != 0 { (io.src + offset)#[0..<0x40] } else { (io.pc + offset)#[0..<0x40] }
  target = _mux_2
  mut _mux_3:U64 = if isAuipc != 0 { target#[0..<0x40] } else { snpc#[0..<0x40] }
  _io_result_T_1 = _mux_3
  io.src = io_src#[0..<0x40]
  io.pc = io_pc#[0..<0x40]
  io.imm = io_imm#[0..<33]
  io.nextPcOffset = io_nextPcOffset#[0..<7]
  io.func = io_func#[0..<9]
  io.isRVC = io_isRVC & 1
  io.result = _io_result_T_1#[0..<0x40]
  io.target = target#[1..<0x40] << 1
  io.isAuipc = isAuipc & 1
  io_result = io.result
  io_target = io.target
  io_isAuipc = io.isAuipc
}
