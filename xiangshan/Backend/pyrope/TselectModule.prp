pub mod TselectModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U2@[], regOut:(ALL:U2)@[]) {
  mut _mux_2:U2 = 0
  mut t8 = 0
  reg reg_0:U2:[initial=0, reset_pin=`reset`, async=true]
