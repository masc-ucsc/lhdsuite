  if not (`reset` != 0) {
    _mux_2 = if (w.wen & U1(w.wdata < 4) & 1) != 0 { w.wdata#[0..<2] } else { reg_0#[0..<2] }
    t8 = _mux_2
    reg_0 = t8
  }
  _GEN = t8
  mut `regOut__bpo.ALL` = reg_0#[0..<2]
  const t20 = `regOut__bpo.ALL`
