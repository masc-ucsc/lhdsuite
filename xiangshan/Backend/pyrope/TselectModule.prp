pub mod TselectModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u2@[], regOut:(ALL:u2)@[]) {
  reg reg_0:u2:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..=1]
  mut _mux_2:u2 = if (w.wen & unsigned(w.wdata < 4) & 1) != 0 { w.wdata#[0..=1] } else { reg_0 }
  reg_0 = _mux_2
  mut `regOut__bpo.ALL` = reg_0
  regOut.ALL = `regOut__bpo.ALL`
  rdata = reg_0
}
