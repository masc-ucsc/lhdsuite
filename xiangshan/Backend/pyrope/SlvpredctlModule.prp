pub mod SlvpredctlModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(LVPRED_TIMEOUT:u5, STORESET_NO_FAST_WAKEUP:u1, STORESET_WAIT_STORE:u1, NO_SPEC_LOAD:u1, LVPRED_DISABLE:u1)@[]) {
  reg reg_0:u9:[init=48, reset_pin=ref reset, async=true]
  mut `reg_init.LVPRED_TIMEOUT` = 0
  mut `reg_init.STORESET_NO_FAST_WAKEUP` = 0
  mut `reg_init.STORESET_WAIT_STORE` = 0
  mut `reg_init.NO_SPEC_LOAD` = 0
  mut `reg_init.LVPRED_DISABLE` = 0
  mut `wdata.LVPRED_TIMEOUT` = w.wdata#[4..=8]
  mut `wdata.STORESET_NO_FAST_WAKEUP` = (w.wdata >> 3) & 1
  mut `wdata.STORESET_WAIT_STORE` = (w.wdata >> 2) & 1
  mut `wdata.NO_SPEC_LOAD` = (w.wdata >> 1) & 1
  mut `wdata.LVPRED_DISABLE` = w.wdata & 1
  mut _mux_1:u5 = if w.wen != 0 { `wdata.LVPRED_TIMEOUT`#[0..=4] } else { reg_0#[4..=8] }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.STORESET_NO_FAST_WAKEUP` & 1 } else { (reg_0 >> 3) & 1 }
  mut _mux_3:u1 = if w.wen != 0 { `wdata.STORESET_WAIT_STORE` & 1 } else { (reg_0 >> 2) & 1 }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.NO_SPEC_LOAD` & 1 } else { (reg_0 >> 1) & 1 }
  mut _mux_5:u1 = if w.wen != 0 { `wdata.LVPRED_DISABLE` & 1 } else { reg_0 & 1 }
  reg_0 = _mux_5 | (_mux_4 << 1) | (_mux_3 << 2) | (_mux_2 << 3) | (_mux_1 << 4)
  mut `regOut__bpo.LVPRED_TIMEOUT` = reg_0#[4..=8]
  mut `regOut__bpo.STORESET_NO_FAST_WAKEUP` = (reg_0 >> 3) & 1
  mut `regOut__bpo.STORESET_WAIT_STORE` = (reg_0 >> 2) & 1
  mut `regOut__bpo.NO_SPEC_LOAD` = (reg_0 >> 1) & 1
  mut `regOut__bpo.LVPRED_DISABLE` = reg_0 & 1
  regOut.LVPRED_TIMEOUT = `regOut__bpo.LVPRED_TIMEOUT`
  regOut.STORESET_NO_FAST_WAKEUP = `regOut__bpo.STORESET_NO_FAST_WAKEUP`
  regOut.STORESET_WAIT_STORE = `regOut__bpo.STORESET_WAIT_STORE`
  regOut.NO_SPEC_LOAD = `regOut__bpo.NO_SPEC_LOAD`
  regOut.LVPRED_DISABLE = `regOut__bpo.LVPRED_DISABLE`
  rdata = (reg_0#[4..=8] << 4) | (((reg_0 >> 3) & 1) << 3) | (((reg_0 >> 2) & 1) << 2) | (((reg_0 >> 1) & 1) << 1) | (reg_0 & 1)
}
