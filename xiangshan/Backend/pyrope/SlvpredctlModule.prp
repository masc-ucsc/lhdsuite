pub mod SlvpredctlModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(LVPRED_TIMEOUT:U5, STORESET_NO_FAST_WAKEUP:U1, STORESET_WAIT_STORE:U1, NO_SPEC_LOAD:U1, LVPRED_DISABLE:U1)@[]) {
  mut _mux_1:U5 = 0
  mut _mux_2:U1 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U1 = 0
  mut _mux_5:U1 = 0
  mut t28 = 0
  mut t29 = 0
  mut t30 = 0
  mut t31 = 0
  mut t32 = 0
  reg reg_0:U9:[initial=48, reset_pin=`reset`, async=true]
  reg _GEN:U5
  reg _GEN_0:U1
  reg _GEN_1:U1
  reg _GEN_2:U1
  reg _GEN_3:U1
  wire `regOut__bpr.LVPRED_TIMEOUT`:U5 = nil
  wire `regOut__bpr.STORESET_NO_FAST_WAKEUP`:U1 = nil
  wire `regOut__bpr.STORESET_WAIT_STORE`:U1 = nil
  wire `regOut__bpr.NO_SPEC_LOAD`:U1 = nil
  wire `regOut__bpr.LVPRED_DISABLE`:U1 = nil
  mut `reg_init.LVPRED_TIMEOUT` = 3
  mut `reg_init.STORESET_NO_FAST_WAKEUP` = 0
  mut `reg_init.STORESET_WAIT_STORE` = 0
  mut `reg_init.NO_SPEC_LOAD` = 0
  mut `reg_init.LVPRED_DISABLE` = 0
  mut `wdata.LVPRED_TIMEOUT` = w.wdata#[4..<9]
  mut `wdata.STORESET_NO_FAST_WAKEUP` = w.wdata#[3..<4]
  mut `wdata.STORESET_WAIT_STORE` = w.wdata#[2..<3]
  mut `wdata.NO_SPEC_LOAD` = w.wdata#[1..<2]
  mut `wdata.LVPRED_DISABLE` = w.wdata & 1
  t28 = _GEN
  t29 = _GEN_0
  t30 = _GEN_1
  t31 = _GEN_2
  t32 = _GEN_3
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.LVPRED_TIMEOUT`#[0..<5] } else { reg_0#[4..<9] }
    t28 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.STORESET_NO_FAST_WAKEUP` & 1 } else { reg_0#[3..<4] }
    t29 = _mux_2
    _mux_3 = if w.wen != 0 { `wdata.STORESET_WAIT_STORE` & 1 } else { reg_0#[2..<3] }
    t30 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.NO_SPEC_LOAD` & 1 } else { reg_0#[1..<2] }
    t31 = _mux_4
    _mux_5 = if w.wen != 0 { `wdata.LVPRED_DISABLE` & 1 } else { reg_0 & 1 }
    t32 = _mux_5
    reg_0 = t32 | (t31 << 1) | (t30 << 2) | (t29 << 3) | (t28 << 4)
  }
  _GEN = t28
  _GEN_0 = t29
  _GEN_1 = t30
  _GEN_2 = t31
  _GEN_3 = t32
  mut `regOut__bpo.LVPRED_TIMEOUT` = reg_0#[4..<9]
  mut `regOut__bpo.STORESET_NO_FAST_WAKEUP` = reg_0#[3..<4]
  mut `regOut__bpo.STORESET_WAIT_STORE` = reg_0#[2..<3]
  mut `regOut__bpo.NO_SPEC_LOAD` = reg_0#[1..<2]
  mut `regOut__bpo.LVPRED_DISABLE` = reg_0 & 1
  const t77 = `regOut__bpo.LVPRED_TIMEOUT`
  `regOut__bpr.LVPRED_TIMEOUT` = t77
  regOut.LVPRED_TIMEOUT = t77
  const t78 = `regOut__bpo.STORESET_NO_FAST_WAKEUP`
  `regOut__bpr.STORESET_NO_FAST_WAKEUP` = t78
  regOut.STORESET_NO_FAST_WAKEUP = t78
  const t79 = `regOut__bpo.STORESET_WAIT_STORE`
  `regOut__bpr.STORESET_WAIT_STORE` = t79
  regOut.STORESET_WAIT_STORE = t79
  const t80 = `regOut__bpo.NO_SPEC_LOAD`
  `regOut__bpr.NO_SPEC_LOAD` = t80
  regOut.NO_SPEC_LOAD = t80
  const t81 = `regOut__bpo.LVPRED_DISABLE`
  `regOut__bpr.LVPRED_DISABLE` = t81
  regOut.LVPRED_DISABLE = t81
  rdata = (reg_0#[4..<9] << 4) | (reg_0#[3..<4] << 3) | (reg_0#[2..<3] << 2) | (reg_0#[1..<2] << 1) | (reg_0 & 1)
}
