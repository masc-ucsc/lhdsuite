pub mod MepcModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), trapToM:(privState:(valid:u1, bits:(PRVM:u2, V:u1)), mstatus:(valid:u1, bits:(SIE:u1, MIE:u1, SPIE:u1, UBE:u1, MPIE:u1, SPP:u1, VS:u2, MPP:u2, FS:u2, XS:u2, MPRV:u1, SUM:u1, MXR:u1, TVM:u1, TW:u1, TSR:u1, SDT:u1, UXL:u2, SXL:u2, SBE:u1, MBE:u1, GVA:u1, MPV:u1, MDT:u1, SD:u1)), mepc:(valid:u1, bits:(epc:u63)), mcause:(valid:u1, bits:(Interrupt:u1, ExceptionCode:u63)), mtval:(valid:u1, bits:(ALL:u64)), mtval2:(valid:u1, bits:(ALL:u64)), mtinst:(valid:u1, bits:(ALL:u64)))) -> (rdata:u64@[], regOut:(epc:u63)@[]) {
  reg reg_0:u63:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.epc` = 0
  mut `wdata.epc` = w.wdata#[1..=63]
  mut _mux_1:u63 = if trapToM.mepc.valid != 0 { trapToM.mepc.bits.epc#[0..=62] } else { 0 }
  mut _mux_2:u63 = if w.wen != 0 { `wdata.epc`#[0..=62] } else { 0 }
  mut _mux_3:u63 = if ((w.wen | trapToM.mepc.valid) & 1) != 0 { _mux_1 | _mux_2 } else { reg_0 }
  reg_0 = _mux_3
  mut `regOut__bpo.epc` = reg_0
  regOut.epc = `regOut__bpo.epc`
  rdata = reg_0 << 1
}
