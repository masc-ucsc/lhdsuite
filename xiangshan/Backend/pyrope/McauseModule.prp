pub mod McauseModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), trapToM:(privState:(valid:U1, bits:(PRVM:U2, V:U1)), mstatus:(valid:U1, bits:(SIE:U1, MIE:U1, SPIE:U1, UBE:U1, MPIE:U1, SPP:U1, VS:U2, MPP:U2, FS:U2, XS:U2, MPRV:U1, SUM:U1, MXR:U1, TVM:U1, TW:U1, TSR:U1, SDT:U1, UXL:U2, SXL:U2, SBE:U1, MBE:U1, GVA:U1, MPV:U1, MDT:U1, SD:U1)), mepc:(valid:U1, bits:(epc:U63)), mcause:(valid:U1, bits:(Interrupt:U1, ExceptionCode:U63)), mtval:(valid:U1, bits:(ALL:U64)), mtval2:(valid:U1, bits:(ALL:U64)), mtinst:(valid:U1, bits:(ALL:U64)))) -> (rdata:U64@[], regOut:(Interrupt:U1, ExceptionCode:U63)@[]) {
  mut _GEN:U1 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U63 = 0
  mut t33 = 0
  mut t34 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN_0:U1
  reg _GEN_1:U63
