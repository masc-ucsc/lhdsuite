  if not (`reset` != 0) {
    _GEN = 0ub?
    _GEN = (w.wen | trapToM.mcause.valid) & 1
    _mux_3 = if _GEN != 0 { (((trapToM.mcause.valid & trapToM.mcause.bits.Interrupt & 1) | (w.wen & `wdata.Interrupt` & 1)) & 1) & 1 } else { reg_0#[63..<0x40] }
    t33 = _mux_3
    _mux_4 = if _GEN != 0 { (_mux_1 | _mux_2)#[0..<63]#[0..<63] } else { reg_0#[0..<63] }
    t34 = _mux_4
    reg_0 = t34 | (t33 << 63)
  }
  _GEN_0 = t33
  _GEN_1 = t34
  mut `regOut__bpo.Interrupt` = reg_0#[63..<0x40]
  mut `regOut__bpo.ExceptionCode` = reg_0#[0..<63]
  const t52 = `regOut__bpo.Interrupt`
