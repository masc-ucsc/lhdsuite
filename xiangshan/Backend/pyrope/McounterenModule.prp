pub mod McounterenModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(CY:u1, TM:u1, IR:u1, HPM:u29)@[]) {
  reg reg_0:u32:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.CY` = 0
  mut `reg_init.TM` = 0
  mut `reg_init.IR` = 0
  mut `reg_init.HPM` = 0
  mut `wdata.CY` = w.wdata & 1
  mut `wdata.TM` = (w.wdata >> 1) & 1
  mut `wdata.IR` = (w.wdata >> 2) & 1
  mut `wdata.HPM` = w.wdata#[3..=31]
  mut _mux_1:u1 = if w.wen != 0 { `wdata.CY` & 1 } else { (reg_0 >> 31) & 1 }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.TM` & 1 } else { (reg_0 >> 30) & 1 }
  mut _mux_3:u1 = if w.wen != 0 { `wdata.IR` & 1 } else { (reg_0 >> 29) & 1 }
  mut _mux_4:u29 = if w.wen != 0 { `wdata.HPM`#[0..=28] } else { reg_0#[0..=28] }
  reg_0 = _mux_4 | (_mux_3 << 29) | (_mux_2 << 30) | (_mux_1 << 31)
  mut `regOut__bpo.CY` = (reg_0 >> 31) & 1
  mut `regOut__bpo.TM` = (reg_0 >> 30) & 1
  mut `regOut__bpo.IR` = (reg_0 >> 29) & 1
  mut `regOut__bpo.HPM` = reg_0#[0..=28]
  regOut.CY = `regOut__bpo.CY`
  regOut.TM = `regOut__bpo.TM`
  regOut.IR = `regOut__bpo.IR`
  regOut.HPM = `regOut__bpo.HPM`
  rdata = (reg_0#[0..=28] << 3) | (((reg_0 >> 29) & 1) << 2) | (((reg_0 >> 30) & 1) << 1) | ((reg_0 >> 31) & 1)
}
