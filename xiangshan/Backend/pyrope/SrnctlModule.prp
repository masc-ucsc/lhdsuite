pub mod SrnctlModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(WFI_ENABLE:u1, FUSION_ENABLE:u1)@[]) {
  reg reg_0:u2:[init=3, reset_pin=ref reset, async=true]
  mut `reg_init.WFI_ENABLE` = 0
  mut `reg_init.FUSION_ENABLE` = 0
  mut `wdata.WFI_ENABLE` = (w.wdata >> 2) & 1
  mut `wdata.FUSION_ENABLE` = w.wdata & 1
  mut _mux_1:u1 = if w.wen != 0 { `wdata.WFI_ENABLE` & 1 } else { (reg_0 >> 1) & 1 }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.FUSION_ENABLE` & 1 } else { reg_0 & 1 }
  reg_0 = _mux_2 | (_mux_1 << 1)
  mut `regOut__bpo.WFI_ENABLE` = (reg_0 >> 1) & 1
  mut `regOut__bpo.FUSION_ENABLE` = reg_0 & 1
  regOut.WFI_ENABLE = `regOut__bpo.WFI_ENABLE`
  regOut.FUSION_ENABLE = `regOut__bpo.FUSION_ENABLE`
  rdata = (((reg_0 >> 1) & 1) << 2) | (reg_0 & 1)
}
