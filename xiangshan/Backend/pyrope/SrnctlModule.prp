pub mod SrnctlModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(WFI_ENABLE:U1, FUSION_ENABLE:U1)@[]) {
  mut _mux_1:U1 = 0
  mut _mux_2:U1 = 0
  mut t13 = 0
  mut t14 = 0
  reg reg_0:U2:[initial=3, reset_pin=`reset`, async=true]
  reg _GEN:U1
  reg _GEN_0:U1
  wire `regOut__bpr.WFI_ENABLE`:U1 = nil
  wire `regOut__bpr.FUSION_ENABLE`:U1 = nil
  mut `reg_init.WFI_ENABLE` = 1
  mut `reg_init.FUSION_ENABLE` = 1
  mut `wdata.WFI_ENABLE` = w.wdata#[2..<3]
  mut `wdata.FUSION_ENABLE` = w.wdata & 1
  t13 = _GEN
  t14 = _GEN_0
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.WFI_ENABLE` & 1 } else { reg_0#[1..<2] }
    t13 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.FUSION_ENABLE` & 1 } else { reg_0 & 1 }
    t14 = _mux_2
    reg_0 = t14 | (t13 << 1)
  }
  _GEN = t13
  _GEN_0 = t14
  mut `regOut__bpo.WFI_ENABLE` = reg_0#[1..<2]
  mut `regOut__bpo.FUSION_ENABLE` = reg_0 & 1
  const t32 = `regOut__bpo.WFI_ENABLE`
  `regOut__bpr.WFI_ENABLE` = t32
  regOut.WFI_ENABLE = t32
  const t33 = `regOut__bpo.FUSION_ENABLE`
  `regOut__bpr.FUSION_ENABLE` = t33
  regOut.FUSION_ENABLE = t33
  rdata = (reg_0#[1..<2] << 2) | (reg_0 & 1)
}
