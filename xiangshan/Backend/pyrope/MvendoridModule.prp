pub mod MvendoridModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(Bank:u25, Offset:u7)@[]) {
  reg reg_0:u32:[init=0x86f, reset_pin=ref reset, async=true]
  mut `reg_init.Bank` = 0
  mut `reg_init.Offset` = 0
  mut `wdata.Bank` = w.wdata#[7..=31]
  mut `wdata.Offset` = w.wdata#[0..=6]
  mut `regOut__bpo.Bank` = reg_0#[7..=31]
  mut `regOut__bpo.Offset` = reg_0#[0..=6]
  regOut.Bank = `regOut__bpo.Bank`
  regOut.Offset = `regOut__bpo.Offset`
  rdata = (reg_0#[7..=31] << 7) | reg_0#[0..=6]
}
