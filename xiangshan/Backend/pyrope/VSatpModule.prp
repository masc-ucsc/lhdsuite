pub mod VSatpModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), v:U1, hgatp:(MODE:U4, VMID:U14, PPN:U44)) -> (rdata:U64@[], regOut:(MODE:U4, ASID:U16, PPN:U44)@[]) {
  mut _GEN:U1 = 0
  mut _GEN_0:U1 = 0
  mut _GEN_1:U1 = 0
  mut _mux_10:U4 = 0
  mut _mux_7:U44 = 0
  mut _mux_8:U44 = 0
  mut _mux_9:U16 = 0
  mut t28 = 0
  mut t29 = 0
  mut t30 = 0
  mut t31 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN_2:U44
  reg _GEN_3:U44
  reg _GEN_4:U16
  reg _GEN_5:U4
  wire `regOut__bpr.MODE`:U4 = nil
  wire `regOut__bpr.ASID`:U16 = nil
  wire `regOut__bpr.PPN`:U44 = nil
  mut `reg_init.MODE` = 0
  mut `reg_init.ASID` = 0
  mut `reg_init.PPN` = 0
  mut `wdata.MODE` = w.wdata#[60..<0x40]
  mut `wdata.ASID` = w.wdata#[44..<60]
  mut `wdata.PPN` = w.wdata#[0..<44]
  mut _mux_1:U44 = if hgatp.MODE == 0 { 0xfffffffff } else { 0 }
  mut _mux_2:U44 = if hgatp.MODE == 8 { 0x1fffffff } else { 0 }
  mut _mux_3:U44 = if hgatp.MODE == 9 { 0x3fffffffff } else { 0 }
  const effectivePPNMask__w1 = ((_mux_1 | _mux_2)#[0..<44] | _mux_3)#[0..<44]
  t28 = _GEN_2
  t29 = _GEN_3
  t30 = _GEN_4
  t31 = _GEN_5
  if not (`reset` != 0) {
    _GEN = 0ub?
    _GEN = (((U1(`wdata.MODE` == 0) | U1(`wdata.MODE` == 8)) & 1) | U1(`wdata.MODE` == 9)) & 1
    _GEN_0 = 0ub?
    _GEN_0 = w.wen & _GEN & 1
    _GEN_1 = 0ub?
    _GEN_1 = w.wen & (~v) & 1 & (~_GEN#[0]) & 1
    _mux_7 = if _GEN_1 != 0 { (`wdata.PPN` & effectivePPNMask__w1)#[0..<44] } else { reg_0#[0..<44] }
    t28 = _mux_7
    _mux_8 = if _GEN_0 != 0 { (`wdata.PPN` & effectivePPNMask__w1)#[0..<44] } else { t28#[0..<44] }
    t29 = _mux_8
    _mux_9 = if ((_GEN_0 | _GEN_1) & 1) != 0 { `wdata.ASID`#[0..<16] } else { reg_0#[44..<60] }
    t30 = _mux_9
    _mux_10 = if ((_GEN_0 | (_GEN_1 & _GEN_0 & 1)) & 1) != 0 { `wdata.MODE`#[0..<4] } else { reg_0#[60..<0x40] }
    t31 = _mux_10
    reg_0 = t29 | (t30 << 44) | (t31 << 60)
  }
  _GEN_2 = t28
  _GEN_3 = t29
  _GEN_4 = t30
  _GEN_5 = t31
  mut `regOut__bpo.MODE` = reg_0#[60..<0x40]
  mut `regOut__bpo.ASID` = reg_0#[44..<60]
  mut `regOut__bpo.PPN` = reg_0#[0..<44]
  const t87 = `regOut__bpo.MODE`
  `regOut__bpr.MODE` = t87
  regOut.MODE = t87
  const t88 = `regOut__bpo.ASID`
  `regOut__bpr.ASID` = t88
  regOut.ASID = t88
  const t89 = `regOut__bpo.PPN`
  `regOut__bpr.PPN` = t89
  regOut.PPN = t89
  rdata = (reg_0#[60..<0x40] << 60) | (reg_0#[44..<60] << 44) | reg_0#[0..<44]
}
