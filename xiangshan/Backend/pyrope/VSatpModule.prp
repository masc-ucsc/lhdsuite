pub mod VSatpModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), v:u1, hgatp:(MODE:u4, VMID:u14, PPN:u44)) -> (rdata:u64@[], regOut:(MODE:u4, ASID:u16, PPN:u44)@[]) {
  reg reg_0:u64:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.MODE` = 0
  mut `reg_init.ASID` = 0
  mut `reg_init.PPN` = 0
  mut `wdata.MODE` = w.wdata#[60..=63]
  mut `wdata.ASID` = w.wdata#[44..=59]
  mut `wdata.PPN` = w.wdata#[0..=43]
  mut _mux_1:u44 = if hgatp.MODE == 0 { 0xfffffffff } else { 0 }
  mut _mux_2:u44 = if hgatp.MODE == 8 { 0x1fffffff } else { 0 }
  mut _mux_3:u44 = if hgatp.MODE == 9 { 0x3fffffffff } else { 0 }
  const effectivePPNMask__w1 = (_mux_1 | _mux_2) | _mux_3
  const _GEN__w1 = (((unsigned(`wdata.MODE` == 0) | unsigned(`wdata.MODE` == 8)) & 1) | unsigned(`wdata.MODE` == 9)) & 1
  const _GEN_0__w1 = w.wen & _GEN__w1 & 1
  const _GEN_1__w1 = w.wen & (~v) & 1 & 1 & (~_GEN__w1) & 1 & 1
  mut _mux_7:u44 = if _GEN_1__w1 != 0 { `wdata.PPN` & effectivePPNMask__w1 } else { reg_0#[0..=43] }
  mut _mux_8:u44 = if _GEN_0__w1 != 0 { `wdata.PPN` & effectivePPNMask__w1 } else { _mux_7 }
  mut _mux_9:u16 = if ((_GEN_0__w1 | _GEN_1__w1) & 1) != 0 { `wdata.ASID`#[0..=15] } else { reg_0#[44..=59] }
  mut _mux_10:u4 = if ((_GEN_0__w1 | (_GEN_1__w1 & _GEN_0__w1 & 1)) & 1) != 0 { `wdata.MODE`#[0..=3] } else { reg_0#[60..=63] }
  reg_0 = _mux_8 | (_mux_9 << 44) | (_mux_10 << 60)
  mut `regOut__bpo.MODE` = reg_0#[60..=63]
  mut `regOut__bpo.ASID` = reg_0#[44..=59]
  mut `regOut__bpo.PPN` = reg_0#[0..=43]
  regOut.MODE = `regOut__bpo.MODE`
  regOut.ASID = `regOut__bpo.ASID`
  regOut.PPN = `regOut__bpo.PPN`
  rdata = (reg_0#[60..=63] << 60) | (reg_0#[44..=59] << 44) | reg_0#[0..=43]
}
