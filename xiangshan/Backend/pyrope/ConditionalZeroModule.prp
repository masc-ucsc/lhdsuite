pub comb ConditionalZeroModule::[timecheck=false](io_condition:u64, io_value:u64, io_isNez:u1) -> (io_condRes:u64) {
  wire io:(condition:u64, value:u64, isNez:u1, condRes:u64) = nil
  const condition_zero__w1 = unsigned(io.condition == 0)
  mut _mux_2:u64 = if ((((~io.isNez) & 1 & condition_zero__w1 & 1) | (io.isNez & (~condition_zero__w1) & 1 & 1)) & 1) != 0 { 0 } else { io.value#[0..=63] }
  io.condition = io_condition
  io.value = io_value
  io.isNez = io_isNez & 1
  io.condRes = _mux_2
  io_condRes = io.condRes
}
