pub comb ConditionalZeroModule::[timecheck=false](io_condition:U64, io_value:U64, io_isNez:U1) -> (io_condRes:U64) {
  wire io:(condition:U64, value:U64, isNez:U1, condRes:U64) = nil
  wire condition_zero:U1 = nil
  wire use_zero:U1 = nil
  wire _io_condRes_T:U64 = nil
  condition_zero = U1(io.condition == 0)
  use_zero = (((~io.isNez#[0]) & condition_zero & 1) | (io.isNez & (~condition_zero) & 1)) & 1
  mut _mux_2:U64 = if use_zero != 0 { 0 } else { io.value#[0..<0x40] }
  _io_condRes_T = _mux_2
  io.condition = io_condition#[0..<0x40]
  io.value = io_value#[0..<0x40]
  io.isNez = io_isNez & 1
  io.condRes = _io_condRes_T#[0..<0x40]
  io_condRes = io.condRes
}
