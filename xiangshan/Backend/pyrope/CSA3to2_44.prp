pub comb CSA3to2_44::[timecheck=false](io_in_a:U72, io_in_b:U72, io_in_c:U72) -> (io_out_sum:U72, io_out_car:U72) {
  mut `io.in_a` = io_in_a#[0..<0x48]
  mut `io.in_b` = io_in_b#[0..<0x48]
  mut `io.in_c` = io_in_c#[0..<0x48]
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..<0x48] ^ `io.in_c`)#[0..<0x48]
  mut `io.out_car` = (((`io.in_a`#[0..<0x47] & `io.in_b`#[0..<0x47])#[0..<0x47] | (`io.in_a`#[0..<0x47] & `io.in_c`#[0..<0x47])#[0..<0x47])#[0..<0x47] | (`io.in_b`#[0..<0x47] & `io.in_c`#[0..<0x47])#[0..<0x47])#[0..<0x47] << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
