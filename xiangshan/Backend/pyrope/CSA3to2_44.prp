pub comb CSA3to2_44::[timecheck=false](io_in_a:u72, io_in_b:u72, io_in_c:u72) -> (io_out_sum:u72, io_out_car:u72) {
  mut `io.in_a` = io_in_a
  mut `io.in_b` = io_in_b
  mut `io.in_c` = io_in_c
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..=71] ^ `io.in_c`)#[0..=71]
  mut `io.out_car` = (((`io.in_a`#[0..=70] & `io.in_b`#[0..=70]) | (`io.in_a`#[0..=70] & `io.in_c`#[0..=70])) | (`io.in_b`#[0..=70] & `io.in_c`#[0..=70])) << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
