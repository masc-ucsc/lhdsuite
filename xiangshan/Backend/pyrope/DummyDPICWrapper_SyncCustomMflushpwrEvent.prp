const DiffExtSyncCustomMflushpwrEvent = import("DiffExtSyncCustomMflushpwrEvent.DiffExtSyncCustomMflushpwrEvent")

pub mod DummyDPICWrapper_SyncCustomMflushpwrEvent::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(valid:u1, l2FlushDone:u1, coreid:u8))) -> () {
  mut dpic = DiffExtSyncCustomMflushpwrEvent::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 10) | (io.bits.valid << 9) | (io.bits.l2FlushDone << 8) | io.bits.coreid)#[0..=9])
}
