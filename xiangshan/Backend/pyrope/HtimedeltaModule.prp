pub mod HtimedeltaModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(ALL:U64)@[]) {
  mut _mux_1:U64 = 0
  mut t8 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U64
  wire `regOut__bpr.ALL`:U64 = nil
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..<0x40]
