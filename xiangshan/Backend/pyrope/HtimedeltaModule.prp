  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.ALL`#[0..<0x40] } else { reg_0#[0..<0x40] }
    t8 = _mux_1
    reg_0 = t8
  }
  _GEN = t8
  mut `regOut__bpo.ALL` = reg_0#[0..<0x40]
  const t16 = `regOut__bpo.ALL`
  `regOut__bpr.ALL` = t16
  regOut.ALL = t16
  rdata = reg_0#[0..<0x40]
}
