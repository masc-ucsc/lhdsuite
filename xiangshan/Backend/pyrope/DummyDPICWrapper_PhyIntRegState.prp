const DiffExtPhyIntRegState = import("DiffExtPhyIntRegState.DiffExtPhyIntRegState")

pub mod DummyDPICWrapper_PhyIntRegState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(value:u14336, coreid:u8))) -> () {
  mut dpic = DiffExtPhyIntRegState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x3808) | (io.bits.value << 8) | io.bits.coreid)#[0..=14343])
}
