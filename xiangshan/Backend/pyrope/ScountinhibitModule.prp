pub mod ScountinhibitModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), mcounteren:(CY:u1, TM:u1, IR:u1, HPM:u29), fromMcntinhibit:(CY:u1, IR:u1, HPM3:u29)) -> (rdata:u64@[], regOut:(CY:u1, IR:u1, HPM3:u29)@[], toMcntinhibit:(valid:u1, bits:(CY:u1, IR:u1, HPM3:u29))@[]) {
  reg reg_0:u31:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.CY` = 0
  mut `reg_init.IR` = 0
  mut `reg_init.HPM3` = 0
  mut `wdata.CY` = w.wdata & 1
  mut `wdata.IR` = (w.wdata >> 2) & 1
  mut `wdata.HPM3` = w.wdata#[3..=31]
  const delegMask__w1 = (mcounteren.HPM#[0..=28] << 3) | ((mcounteren.IR & 1) << 2) | (mcounteren.CY & 1)
  const _GEN_0__w1 = (fromMcntinhibit.HPM3#[0..=28] << 3) | ((fromMcntinhibit.IR & 1) << 2) | (fromMcntinhibit.CY & 1)
  const _GEN_1__w1 = (((`wdata.HPM3`#[0..=28] << 3) | ((`wdata.IR` & 1) << 2) | (`wdata.CY` & 1)) & delegMask__w1) | (_GEN_0__w1 & (~delegMask__w1)#[0..=31])
  const _GEN__w1 = _GEN_0__w1 & delegMask__w1
  const _regOut_CY_WIRE_1__w1 = _GEN__w1 & 1
  mut `_GEN_2.CY` = _GEN_1__w1 & 1
  mut `_GEN_2.IR` = (_GEN_1__w1 >> 2) & 1
  mut `_GEN_2.HPM3` = _GEN_1__w1#[3..=31]
  mut _mux_1:u1 = if w.wen != 0 { `wdata.CY` & 1 } else { (reg_0 >> 30) & 1 }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.IR` & 1 } else { (reg_0 >> 29) & 1 }
  mut _mux_3:u29 = if w.wen != 0 { `wdata.HPM3`#[0..=28] } else { reg_0#[0..=28] }
  reg_0 = _mux_3 | (_mux_2 << 29) | (_mux_1 << 30)
  const t90 = _GEN__w1#[3..=31] | (((_GEN__w1 >> 2) & 1) << 29) | (_regOut_CY_WIRE_1__w1 << 30)
  mut `regOut__bpo.CY` = (t90 >> 30) & 1
  mut `regOut__bpo.IR` = (t90 >> 29) & 1
  mut `regOut__bpo.HPM3` = t90#[0..=28]
  const t105 = (`_GEN_2.CY` << 30) | (`_GEN_2.IR` << 29) | `_GEN_2.HPM3` | (w.wen << 31)
  mut `toMcntinhibit__bpo.valid` = (t105 >> 31) & 1
  mut `toMcntinhibit__bpo.bits.CY` = (t105 >> 30) & 1
  mut `toMcntinhibit__bpo.bits.IR` = (t105 >> 29) & 1
  mut `toMcntinhibit__bpo.bits.HPM3` = t105#[0..=28]
  regOut.CY = `regOut__bpo.CY`
  regOut.IR = `regOut__bpo.IR`
  regOut.HPM3 = `regOut__bpo.HPM3`
  toMcntinhibit.valid = `toMcntinhibit__bpo.valid`
  toMcntinhibit.bits.CY = `toMcntinhibit__bpo.bits.CY`
  toMcntinhibit.bits.IR = `toMcntinhibit__bpo.bits.IR`
  toMcntinhibit.bits.HPM3 = `toMcntinhibit__bpo.bits.HPM3`
  rdata = (_GEN__w1#[2..=31] << 2) | (_regOut_CY_WIRE_1__w1 & 1)
}
