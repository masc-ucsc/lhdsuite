pub mod VcsrModule::[timecheck=false](clock:u1, w:(wen:u1, wdata:u64), robCommit:(instNum:(valid:u1, bits:u7), fflags:(valid:u1, bits:u5), fsDirty:u1, vxsat:(valid:u1, bits:u1), vsDirty:u1, vtype:(valid:u1, bits:(VILL:u1, VMA:u1, VTA:u1, VSEW:u3, VLMUL:u3)), vl:u8, vstart:(valid:u1, bits:u7)), wAliasVxsat:(wen:u1, wdata:u64), wAliasVxrm:(wen:u1, wdata:u64)) -> (rdata:u64@[], vxsat:u1@[], vxrm:u2@[]) {
  reg reg_0:u3
  mut `wdata.VXSAT` = w.wdata & 1
  mut `wdata.VXRM` = w.wdata#[1..=2]
  mut `wdataField.VXSAT` = wAliasVxsat.wdata & 1
  mut `wdataField_1.VXRM` = wAliasVxrm.wdata#[0..=1]
  mut _mux_1:u2 = if wAliasVxrm.wen != 0 { `wdataField_1.VXRM`#[0..=1] } else { 0 }
  mut _mux_2:u2 = if w.wen != 0 { `wdata.VXRM`#[0..=1] } else { 0 }
  mut _mux_3:u1 = if ((w.wen | wAliasVxsat.wen) & 1) != 0 { (((wAliasVxsat.wen & `wdataField.VXSAT` & 1) | (w.wen & `wdata.VXSAT` & 1)) & 1) & 1 } else { (reg_0 >> 2) & 1 }
  mut _mux_4:u1 = if robCommit.vxsat.valid != 0 { (((reg_0 >> 2) & 1) | robCommit.vxsat.bits) & 1 } else { _mux_3 & 1 }
  mut _mux_5:u2 = if ((w.wen | wAliasVxrm.wen) & 1) != 0 { _mux_1 | _mux_2 } else { reg_0#[0..=1] }
  reg_0 = _mux_5 | (_mux_4 << 2)
  rdata = (reg_0#[0..=1] << 1) | ((reg_0 >> 2) & 1)
  vxsat = (reg_0 >> 2) & 1
  vxrm = reg_0#[0..=1]
}
