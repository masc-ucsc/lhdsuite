pub mod VcsrModule::[timecheck=false](`clock`:Clock, w:(wen:U1, wdata:U64), robCommit:(instNum:(valid:U1, bits:U7), fflags:(valid:U1, bits:U5), fsDirty:U1, vxsat:(valid:U1, bits:U1), vsDirty:U1, vtype:(valid:U1, bits:(VILL:U1, VMA:U1, VTA:U1, VSEW:U3, VLMUL:U3)), vl:U8, vstart:(valid:U1, bits:U7)), wAliasVxsat:(wen:U1, wdata:U64), wAliasVxrm:(wen:U1, wdata:U64)) -> (rdata:U64@[], vxsat:U1@[], vxrm:U2@[]) {
  reg reg_0:U3
  mut `wdata.VXSAT` = w.wdata & 1
  mut `wdata.VXRM` = w.wdata#[1..<3]
  mut `wdataField.VXSAT` = wAliasVxsat.wdata & 1
  mut `wdataField_1.VXRM` = wAliasVxrm.wdata#[0..<2]
  mut _mux_1:U2 = if wAliasVxrm.wen != 0 { `wdataField_1.VXRM`#[0..<2] } else { 0 }
  mut _mux_2:U2 = if w.wen != 0 { `wdata.VXRM`#[0..<2] } else { 0 }
  mut _mux_3:U1 = if ((w.wen | wAliasVxsat.wen) & 1) != 0 { (((wAliasVxsat.wen & `wdataField.VXSAT` & 1) | (w.wen & `wdata.VXSAT` & 1)) & 1) & 1 } else { reg_0#[2..<3] }
  mut _mux_4:U1 = if robCommit.vxsat.valid != 0 { (reg_0#[2..<3] | robCommit.vxsat.bits) & 1 } else { _mux_3 & 1 }
  mut _mux_5:U2 = if ((w.wen | wAliasVxrm.wen) & 1) != 0 { (_mux_1 | _mux_2)#[0..<2]#[0..<2] } else { reg_0#[0..<2] }
  reg_0 = _mux_5 | (_mux_4 << 2)
  rdata = (reg_0#[0..<2] << 1) | reg_0#[2..<3]
  vxsat = reg_0#[2..<3]
  vxrm = reg_0#[0..<2]
}
