pub mod FarPathAdderF16Pipeline::[timecheck=false](clock:u1, io_fire:u1, io_A:u12, io_B:u12) -> (io_result:u12@[]) {
  reg io_result_r:u12
  reg io_result_r_1:u12
  mut `io.fire` = io_fire & 1
  mut `io.A` = io_A
  mut `io.B` = io_B
  mut `io.result` = (io_result_r + io_result_r_1)#[0..=11]
  if `io.fire` != 0 {
    io_result_r = `io.A`
  }
  if `io.fire` != 0 {
    io_result_r_1 = `io.B`
  }
  io_result = `io.result`
}
