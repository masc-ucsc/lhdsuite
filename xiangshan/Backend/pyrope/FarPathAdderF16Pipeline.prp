pub mod FarPathAdderF16Pipeline::[timecheck=false](`clock`:Clock, io_fire:U1, io_A:U12, io_B:U12) -> (io_result:U12@[]) {
  reg io_result_r:U12
  reg io_result_r_1:U12
  mut `io.fire` = io_fire & 1
  mut `io.A` = io_A#[0..<12]
  mut `io.B` = io_B#[0..<12]
  mut `io.result` = (io_result_r + io_result_r_1)#[0..<12]
  if `io.fire` != 0 {
    io_result_r = `io.A`
  }
  if `io.fire` != 0 {
    io_result_r_1 = `io.B`
  }
  io_result = `io.result`
}
