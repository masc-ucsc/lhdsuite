pub mod HgeieModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(ie:u7)@[]) {
  reg reg_0:u7:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ie` = 0
  mut `wdata.ie` = w.wdata#[1..=7]
  mut _mux_1:u7 = if w.wen != 0 { `wdata.ie`#[0..=6] } else { reg_0 }
  reg_0 = _mux_1
  mut `regOut__bpo.ie` = reg_0
  regOut.ie = `regOut__bpo.ie`
  rdata = reg_0 << 1
}
