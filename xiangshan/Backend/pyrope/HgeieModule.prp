pub mod HgeieModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(ie:U7)@[]) {
  mut _mux_1:U7 = 0
  mut t8 = 0
  reg reg_0:U7:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U7
  wire `regOut__bpr.ie`:U7 = nil
  mut `reg_init.ie` = 0
  mut `wdata.ie` = w.wdata#[1..<8]
  t8 = _GEN
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.ie`#[0..<7] } else { reg_0#[0..<7] }
    t8 = _mux_1
    reg_0 = t8
  }
  _GEN = t8
  mut `regOut__bpo.ie` = reg_0#[0..<7]
  const t17 = `regOut__bpo.ie`
  `regOut__bpr.ie` = t17
  regOut.ie = t17
  rdata = reg_0#[0..<7] << 1
}
