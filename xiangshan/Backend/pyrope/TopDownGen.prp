pub mod TopDownGen::[timecheck=false](`clock`:Clock, io_intTopDown:(uopsIssued:U1, uopsIssuedCnt:U5, noStoreIssued:U1), io_fpTopDown:(uopsIssued:U1, uopsIssuedCnt:U5, noStoreIssued:U1), io_vecTopDown:(uopsIssued:U1, uopsIssuedCnt:U5, noStoreIssued:U1), io_topDownInfo_lqEmpty:U1, io_topDownInfo_sqEmpty:U1, io_topDownInfo_l1Miss:U1, io_topDownInfo_l2TopMiss:(l2Miss:U1, l3Miss:U1)) -> (io_topDownInfo_noUopsIssued:U1@[], io_perf:U30@[]) {
  wire io:(intTopDown:U7, fpTopDown:U7, vecTopDown:U7, topDownInfo:U6) = nil
