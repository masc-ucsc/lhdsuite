pub mod TopDownGen::[timecheck=false](clock:u1, io_intTopDown:(uopsIssued:u1, uopsIssuedCnt:u5, noStoreIssued:u1), io_fpTopDown:(uopsIssued:u1, uopsIssuedCnt:u5, noStoreIssued:u1), io_vecTopDown:(uopsIssued:u1, uopsIssuedCnt:u5, noStoreIssued:u1), io_topDownInfo_lqEmpty:u1, io_topDownInfo_sqEmpty:u1, io_topDownInfo_l1Miss:u1, io_topDownInfo_l2TopMiss:(l2Miss:u1, l3Miss:u1)) -> (io_topDownInfo_noUopsIssued:u1@[], io_perf:u30@[]) {
  wire io:(intTopDown:u7, fpTopDown:u7, vecTopDown:u7, topDownInfo:u6) = nil
  reg stallStore_REG:u1
  reg stallLoadDly:u1
  reg stallStoreDly:u1
  reg io_perf_0_value_REG:u1
  reg io_perf_0_value_REG_1:u1
  reg io_perf_1_value_REG:u1
  reg io_perf_1_value_REG_1:u1
  reg io_perf_2_value_REG:u1
  reg io_perf_2_value_REG_1:u1
  reg io_perf_3_value_REG:u1
  reg io_perf_3_value_REG_1:u1
  reg io_perf_4_value_REG:u1
  reg io_perf_4_value_REG_1:u1
  mut `_GEN_0.value` = (io_perf_4_value_REG_1 & 1)
  mut `_GEN_1.value` = (io_perf_3_value_REG_1 & 1)
  mut `_GEN_2.value` = (io_perf_2_value_REG_1 & 1)
  mut `_GEN_3.value` = (io_perf_1_value_REG_1 & 1)
  mut `_GEN_4.value` = (io_perf_0_value_REG_1 & 1)
  io_perf_0_value_REG_1 = io_perf_0_value_REG
  io_perf_1_value_REG_1 = io_perf_1_value_REG
  io_perf_2_value_REG_1 = io_perf_2_value_REG
  io_perf_3_value_REG_1 = io_perf_3_value_REG
  io_perf_4_value_REG_1 = io_perf_4_value_REG
  const uopsIssued__w1 = (((((io.intTopDown >> 6) & 1) | ((io.fpTopDown >> 6) & 1)) & 1) | ((io.vecTopDown >> 6) & 1)) & 1
  const uopsIssuedCnt__w1 = (io.intTopDown#[1..=5] + io.vecTopDown#[1..=5])#[0..=4]
  const stallLoad__w1 = (~uopsIssued__w1) & 1
  const stallStore__w1 = uopsIssued__w1 & stallStore_REG & 1
  const memStallStore__w1 = stallStoreDly & (~((io.topDownInfo >> 4) & 1)) & 1 & 1
  const memStallL1Miss__w1 = (stallLoadDly & (~((io.topDownInfo >> 5) & 1)) & 1 & 1) & (io.topDownInfo >> 3) & 1 & 1
  const memStallL2Miss__w1 = memStallL1Miss__w1 & (io.topDownInfo#[0..=1] >> 1) & 1 & 1
  const memStallL3Miss__w1 = memStallL2Miss__w1 & io.topDownInfo#[0..=1] & 1 & 1
  mut `_GEN.lqEmpty` = io_topDownInfo_lqEmpty & 1
  mut `_GEN.sqEmpty` = io_topDownInfo_sqEmpty & 1
  mut `_GEN.l1Miss` = io_topDownInfo_l1Miss & 1
  mut `_GEN.noUopsIssued` = stallLoad__w1 & 1
  mut `_GEN.l2TopMiss` = ((io_topDownInfo_l2TopMiss.l2Miss << 1) | io_topDownInfo_l2TopMiss.l3Miss)#[0..=1]
  io.intTopDown = ((io_intTopDown.uopsIssued << 6) | (io_intTopDown.uopsIssuedCnt << 1) | io_intTopDown.noStoreIssued)#[0..=6]
  io.fpTopDown = ((io_fpTopDown.uopsIssued << 6) | (io_fpTopDown.uopsIssuedCnt << 1) | io_fpTopDown.noStoreIssued)#[0..=6]
  io.vecTopDown = ((io_vecTopDown.uopsIssued << 6) | (io_vecTopDown.uopsIssuedCnt << 1) | io_vecTopDown.noStoreIssued)#[0..=6]
  io.topDownInfo = ((`_GEN.lqEmpty` << 5) | (`_GEN.sqEmpty` << 4) | (`_GEN.l1Miss` << 3) | (`_GEN.noUopsIssued` << 2) | `_GEN.l2TopMiss`)#[0..=5]
  stallStore_REG = io.intTopDown & 1
  stallLoadDly = stallLoad__w1
  stallStoreDly = stallStore__w1
  io_perf_0_value_REG = (((((unsigned(uopsIssuedCnt__w1 == 0) | unsigned(uopsIssuedCnt__w1 == 1)) & 1) | unsigned(uopsIssuedCnt__w1 == 2)) & 1) | unsigned(uopsIssuedCnt__w1 == 3)) & 1
  io_perf_1_value_REG = memStallStore__w1
  io_perf_2_value_REG = memStallL1Miss__w1
  io_perf_3_value_REG = memStallL2Miss__w1
  io_perf_4_value_REG = memStallL3Miss__w1
  io_topDownInfo_noUopsIssued = (io.topDownInfo >> 2) & 1
