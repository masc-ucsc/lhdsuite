  mut `_GEN.noUopsIssued` = stallLoad & 1
  mut `_GEN.l2TopMiss` = ((io_topDownInfo_l2TopMiss.l2Miss << 1) | io_topDownInfo_l2TopMiss.l3Miss)#[0..<2]
  io.intTopDown = ((io_intTopDown.uopsIssued << 6) | (io_intTopDown.uopsIssuedCnt << 1) | io_intTopDown.noStoreIssued)#[0..<7]
  io.fpTopDown = ((io_fpTopDown.uopsIssued << 6) | (io_fpTopDown.uopsIssuedCnt << 1) | io_fpTopDown.noStoreIssued)#[0..<7]
  io.vecTopDown = ((io_vecTopDown.uopsIssued << 6) | (io_vecTopDown.uopsIssuedCnt << 1) | io_vecTopDown.noStoreIssued)#[0..<7]
  io.topDownInfo = ((`_GEN.lqEmpty` << 5) | (`_GEN.sqEmpty` << 4) | (`_GEN.l1Miss` << 3) | (`_GEN.noUopsIssued` << 2) | `_GEN.l2TopMiss`)#[0..<6]
  stallStore_REG = io.intTopDown & 1
  stallLoadDly = stallLoad
  stallStoreDly = stallStore__w1
  io_perf_0_value_REG = (((((U1(uopsIssuedCnt__w1 == 0) | U1(uopsIssuedCnt__w1 == 1)) & 1) | U1(uopsIssuedCnt__w1 == 2)) & 1) | U1(uopsIssuedCnt__w1 == 3)) & 1
  io_perf_1_value_REG = memStallStore__w1
