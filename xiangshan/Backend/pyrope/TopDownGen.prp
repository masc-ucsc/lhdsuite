  io_perf_2_value_REG_1 = io_perf_2_value_REG
  io_perf_3_value_REG_1 = io_perf_3_value_REG
  io_perf_4_value_REG_1 = io_perf_4_value_REG
  uopsIssued = (((io.intTopDown#[6..<7] | io.fpTopDown#[6..<7]) & 1) | io.vecTopDown#[6..<7]) & 1
  const uopsIssuedCnt__w1 = (io.intTopDown#[1..<6] + io.vecTopDown#[1..<6])#[0..<5]
  stallLoad = ~uopsIssued
  const stallStore__w1 = uopsIssued & stallStore_REG & 1
  const memStallStore__w1 = stallStoreDly & (~io.topDownInfo#[4..<5]) & 1
  const memStallL1Miss__w1 = (stallLoadDly & (~io.topDownInfo#[5..<6]) & 1) & io.topDownInfo#[3..<4] & 1
