const DiffExtTriggerCSRState = import("DiffExtTriggerCSRState.DiffExtTriggerCSRState")

pub mod DummyDPICWrapper_TriggerCSRState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(tselect:u64, tdata1:u64, tinfo:u64, coreid:u8))) -> () {
  mut dpic = DiffExtTriggerCSRState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0xc8) | (io.bits.tselect << 0x88) | (io.bits.tdata1 << 0x48) | (io.bits.tinfo << 8) | io.bits.coreid)#[0..=199])
}
