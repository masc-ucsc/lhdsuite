pub mod VSiselectModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(ALL:U13)@[], inIMSICRange:U1@[]) {
  mut _GEN:U13 = 0
  mut _mux_1:U13 = 0
  reg reg_0:U13:[initial=0, reset_pin=`reset`, async=true]
  wire `regOut__bpr.ALL`:U13 = nil
  mut `reg_init.ALL` = 0
  const value__w1 = reg_0#[0..<13]
  mut `wdata.ALL` = w.wdata#[0..<13]
  if not (`reset` != 0) {
    _GEN = 0ub?????????????
    _mux_1 = if (w.wen & (~`wdata.ALL`#[12..<13]) & 1) != 0 { `wdata.ALL`#[0..<13] } else { value__w1#[0..<13] }
    _GEN = _mux_1
    reg_0 = _GEN
  }
  mut `regOut__bpo.ALL` = reg_0#[0..<13]
  mut _b2i_2 = if value__w1 > 0x6f { 1 } else { 0 }
  mut _b2i_3 = if value__w1 < 0x100 { 1 } else { 0 }
  const t26 = `regOut__bpo.ALL`
  `regOut__bpr.ALL` = t26
  regOut.ALL = t26
  rdata = reg_0#[0..<13]
  inIMSICRange = _b2i_2 & _b2i_3 & 1
}
