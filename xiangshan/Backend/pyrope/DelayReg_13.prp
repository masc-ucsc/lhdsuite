pub mod DelayReg_13::[timecheck=false](clock:u1, reset:u1, i:(valid:u1, criticalError:u1, coreid:u8)) -> (o:(valid:u1, criticalError:u1, coreid:u8)@[]) {
  reg r_1:u10:[init=0, reset_pin=ref reset, async=true]
  reg r_2:u10:[init=0, reset_pin=ref reset, async=true]
  reg r_3:u10:[init=0, reset_pin=ref reset, async=true]
  reg r_4:u10:[init=0, reset_pin=ref reset, async=true]
  const t13 = (i.valid << 9) | (i.criticalError << 8) | i.coreid
  mut `r.valid` = (t13 >> 9) & 1
  mut `r.criticalError` = (t13 >> 8) & 1
  mut `r.coreid` = t13#[0..=7]
  r_1 = (`r.valid` << 9) | (`r.criticalError` << 8) | `r.coreid`
  r_2 = r_1
  r_3 = r_2
  r_4 = r_3
  mut `o__bpo.valid` = (r_4 >> 9) & 1
  mut `o__bpo.criticalError` = (r_4 >> 8) & 1
  mut `o__bpo.coreid` = r_4#[0..=7]
  o.valid = `o__bpo.valid`
  o.criticalError = `o__bpo.criticalError`
  o.coreid = `o__bpo.coreid`
}
