pub mod DelayReg_13::[timecheck=false](`clock`:Clock, `reset`:U1, i:(valid:U1, criticalError:U1, coreid:U8)) -> (o:(valid:U1, criticalError:U1, coreid:U8)@[]) {
  reg r_1:U10:[initial=0, reset_pin=`reset`, async=true]
  reg r_2:U10:[initial=0, reset_pin=`reset`, async=true]
  reg r_3:U10:[initial=0, reset_pin=`reset`, async=true]
  reg r_4:U10:[initial=0, reset_pin=`reset`, async=true]
  wire `o__bpr.valid`:U1 = nil
  wire `o__bpr.criticalError`:U1 = nil
  wire `o__bpr.coreid`:U8 = nil
  const t13 = (i.valid << 9) | (i.criticalError << 8) | i.coreid
  mut `r.valid` = t13#[9..<10]
  mut `r.criticalError` = t13#[8..<9]
  mut `r.coreid` = t13#[0..<8]
  if not (`reset` != 0) {
    r_1 = (`r.valid` << 9) | (`r.criticalError` << 8) | `r.coreid`
  }
  if not (`reset` != 0) {
    r_2 = r_1
  }
  if not (`reset` != 0) {
    r_3 = r_2
  }
  if not (`reset` != 0) {
    r_4 = r_3
  }
  mut `o__bpo.valid` = r_4#[9..<10]
  mut `o__bpo.criticalError` = r_4#[8..<9]
  mut `o__bpo.coreid` = r_4#[0..<8]
  const t35 = `o__bpo.valid`
  `o__bpr.valid` = t35
  o.valid = t35
  const t36 = `o__bpo.criticalError`
  `o__bpr.criticalError` = t36
  o.criticalError = t36
  const t37 = `o__bpo.coreid`
  `o__bpr.coreid` = t37
  o.coreid = t37
}
