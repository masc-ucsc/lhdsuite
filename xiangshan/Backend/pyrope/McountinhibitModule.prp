pub mod McountinhibitModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), fromScntinhibit:(valid:U1, bits:(CY:U1, IR:U1, HPM3:U29))) -> (rdata:U64@[], regOut:(CY:U1, IR:U1, HPM3:U29)@[], toScntinhibit:(CY:U1, IR:U1, HPM3:U29)@[]) {
  mut _mux_1:U29 = 0
  mut _mux_2:U29 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U1 = 0
  mut _mux_5:U1 = 0
  mut _mux_6:U1 = 0
  mut t21 = 0
  mut t22 = 0
  mut t23 = 0
  mut t24 = 0
  mut t25 = 0
  mut t26 = 0
  reg reg_0:U31:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U29
  reg _GEN_0:U29
  reg _GEN_1:U1
  reg _GEN_2:U1
  reg _GEN_3:U1
  reg _GEN_4:U1
  wire `regOut__bpr.CY`:U1 = nil
  wire `regOut__bpr.IR`:U1 = nil
  wire `regOut__bpr.HPM3`:U29 = nil
  wire `toScntinhibit__bpr.CY`:U1 = nil
  wire `toScntinhibit__bpr.IR`:U1 = nil
  wire `toScntinhibit__bpr.HPM3`:U29 = nil
  mut `reg_init.CY` = 0
  mut `reg_init.IR` = 0
  mut `reg_init.HPM3` = 0
  mut `wdata.CY` = w.wdata & 1
  mut `wdata.IR` = w.wdata#[2..<3]
  mut `wdata.HPM3` = w.wdata#[3..<32]
  t21 = _GEN
  t22 = _GEN_0
  t23 = _GEN_1
  t24 = _GEN_2
  t25 = _GEN_3
  t26 = _GEN_4
  if not (`reset` != 0) {
    _mux_1 = if fromScntinhibit.valid != 0 { fromScntinhibit.bits.HPM3#[0..<29] } else { reg_0#[0..<29] }
    t21 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.HPM3`#[0..<29] } else { t21#[0..<29] }
    t22 = _mux_2
    _mux_3 = if fromScntinhibit.valid != 0 { fromScntinhibit.bits.IR & 1 } else { reg_0#[29..<30] }
    t23 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.IR` & 1 } else { t23 & 1 }
    t24 = _mux_4
    _mux_5 = if fromScntinhibit.valid != 0 { fromScntinhibit.bits.CY & 1 } else { reg_0#[30..<31] }
    t25 = _mux_5
    _mux_6 = if w.wen != 0 { `wdata.CY` & 1 } else { t25 & 1 }
    t26 = _mux_6
    reg_0 = t22 | (t24 << 29) | (t26 << 30)
  }
  _GEN = t21
  _GEN_0 = t22
  _GEN_1 = t23
  _GEN_2 = t24
  _GEN_3 = t25
  _GEN_4 = t26
  mut `regOut__bpo.CY` = reg_0#[30..<31]
  mut `regOut__bpo.IR` = reg_0#[29..<30]
  mut `regOut__bpo.HPM3` = reg_0#[0..<29]
  mut `toScntinhibit__bpo.CY` = reg_0#[30..<31]
  mut `toScntinhibit__bpo.IR` = reg_0#[29..<30]
  mut `toScntinhibit__bpo.HPM3` = reg_0#[0..<29]
  const t71 = `regOut__bpo.CY`
  `regOut__bpr.CY` = t71
  regOut.CY = t71
  const t72 = `regOut__bpo.IR`
  `regOut__bpr.IR` = t72
  regOut.IR = t72
  const t73 = `regOut__bpo.HPM3`
  `regOut__bpr.HPM3` = t73
  regOut.HPM3 = t73
  const t74 = `toScntinhibit__bpo.CY`
  `toScntinhibit__bpr.CY` = t74
  toScntinhibit.CY = t74
  const t75 = `toScntinhibit__bpo.IR`
  `toScntinhibit__bpr.IR` = t75
  toScntinhibit.IR = t75
  const t76 = `toScntinhibit__bpo.HPM3`
  `toScntinhibit__bpr.HPM3` = t76
  toScntinhibit.HPM3 = t76
  rdata = (reg_0#[0..<29] << 3) | (reg_0#[29..<30] << 2) | reg_0#[30..<31]
}
