pub mod McountinhibitModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), fromScntinhibit:(valid:u1, bits:(CY:u1, IR:u1, HPM3:u29))) -> (rdata:u64@[], regOut:(CY:u1, IR:u1, HPM3:u29)@[], toScntinhibit:(CY:u1, IR:u1, HPM3:u29)@[]) {
  reg reg_0:u31:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.CY` = 0
  mut `reg_init.IR` = 0
  mut `reg_init.HPM3` = 0
  mut `wdata.CY` = w.wdata & 1
  mut `wdata.IR` = (w.wdata >> 2) & 1
  mut `wdata.HPM3` = w.wdata#[3..=31]
  mut _mux_1:u29 = if fromScntinhibit.valid != 0 { fromScntinhibit.bits.HPM3#[0..=28] } else { reg_0#[0..=28] }
  mut _mux_2:u29 = if w.wen != 0 { `wdata.HPM3`#[0..=28] } else { _mux_1 }
  mut _mux_3:u1 = if fromScntinhibit.valid != 0 { fromScntinhibit.bits.IR & 1 } else { (reg_0 >> 29) & 1 }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.IR` & 1 } else { _mux_3 & 1 }
  mut _mux_5:u1 = if fromScntinhibit.valid != 0 { fromScntinhibit.bits.CY & 1 } else { (reg_0 >> 30) & 1 }
  mut _mux_6:u1 = if w.wen != 0 { `wdata.CY` & 1 } else { _mux_5 & 1 }
  reg_0 = _mux_2 | (_mux_4 << 29) | (_mux_6 << 30)
  mut `regOut__bpo.CY` = (reg_0 >> 30) & 1
  mut `regOut__bpo.IR` = (reg_0 >> 29) & 1
  mut `regOut__bpo.HPM3` = reg_0#[0..=28]
  mut `toScntinhibit__bpo.CY` = (reg_0 >> 30) & 1
  mut `toScntinhibit__bpo.IR` = (reg_0 >> 29) & 1
  mut `toScntinhibit__bpo.HPM3` = reg_0#[0..=28]
  regOut.CY = `regOut__bpo.CY`
  regOut.IR = `regOut__bpo.IR`
  regOut.HPM3 = `regOut__bpo.HPM3`
  toScntinhibit.CY = `toScntinhibit__bpo.CY`
  toScntinhibit.IR = `toScntinhibit__bpo.IR`
  toScntinhibit.HPM3 = `toScntinhibit__bpo.HPM3`
  rdata = (reg_0#[0..=28] << 3) | (((reg_0 >> 29) & 1) << 2) | ((reg_0 >> 30) & 1)
}
