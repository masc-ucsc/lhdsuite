pub comb CSA3to2_145::[timecheck=false](io_in_a:U32, io_in_b:U32, io_in_c:U32) -> (io_out_sum:U32, io_out_car:U32) {
  mut `io.in_a` = io_in_a#[0..<32]
  mut `io.in_b` = io_in_b#[0..<32]
  mut `io.in_c` = io_in_c#[0..<32]
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..<32] ^ `io.in_c`)#[0..<32]
  mut `io.out_car` = (((`io.in_a`#[0..<31] & `io.in_b`#[0..<31])#[0..<31] | (`io.in_a`#[0..<31] & `io.in_c`#[0..<31])#[0..<31])#[0..<31] | (`io.in_b`#[0..<31] & `io.in_c`#[0..<31])#[0..<31])#[0..<31] << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
