pub comb CSA3to2_145::[timecheck=false](io_in_a:u32, io_in_b:u32, io_in_c:u32) -> (io_out_sum:u32, io_out_car:u32) {
  mut `io.in_a` = io_in_a
  mut `io.in_b` = io_in_b
  mut `io.in_c` = io_in_c
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..=31] ^ `io.in_c`)#[0..=31]
  mut `io.out_car` = (((`io.in_a`#[0..=30] & `io.in_b`#[0..=30]) | (`io.in_a`#[0..=30] & `io.in_c`#[0..=30])) | (`io.in_b`#[0..=30] & `io.in_c`#[0..=30])) << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
