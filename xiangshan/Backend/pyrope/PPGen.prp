pub comb PPGen::[timecheck=false](io_in:(b:u64, booth:u4, sign:u1)) -> (io_out:(ppOut:u66, ppCOut:u1)) {
  wire io:(`in`:u69, out:u67) = nil
  const noShift__w1 = (io.`in`#[1..=4] >> 3) & 1
  const shift__w1 = (io.`in`#[1..=4] >> 2) & 1
  const bNeg__w1 = (io.`in`#[1..=4] >> 1) & 1
  mut _mux_1:u66 = if shift__w1 != 0 { ((io.`in` & 1) << 65) | (io.`in`#[5..=68] << 1) } else { 0 }
  mut _rep_2:u2 = if (io.`in` & 1) != 0 { 3 } else { 0 }
  mut _mux_3:u66 = if noShift__w1 != 0 { (_rep_2 << 64) | io.`in`#[5..=68] } else { 0 }
  mut _mux_4:u66 = if shift__w1 != 0 { (((~(io.`in` & 1)) & 1) << 65) | ((~io.`in`#[5..=68])#[0..=63] << 1) | 1 } else { 0 }
  mut _rep_5:u2 = if ((~(io.`in` & 1)) & 1) != 0 { 3 } else { 0 }
  mut _mux_6:u66 = if noShift__w1 != 0 { (_rep_5 << 64) | (~io.`in`#[5..=68])#[0..=63] } else { 0 }
  mut _mux_7:u66 = if (io.`in`#[1..=4] & 1) != 0 { _mux_1 | _mux_3 } else { 0 }
  mut _mux_8:u66 = if bNeg__w1 != 0 { _mux_4 | _mux_6 } else { 0 }
  mut `_GEN.ppOut` = _mux_7 | _mux_8
  mut `_GEN.ppCOut` = bNeg__w1 & 1
  io.`in` = ((io_in.b << 5) | (io_in.booth << 1) | io_in.sign)#[0..=68]
  io.out = ((`_GEN.ppOut` << 1) | `_GEN.ppCOut`)#[0..=66]
  const t83 = io.out
  mut `io_out__bpo.ppOut` = t83#[1..=66]
  mut `io_out__bpo.ppCOut` = t83 & 1
  io_out.ppOut = `io_out__bpo.ppOut`
  io_out.ppCOut = `io_out__bpo.ppCOut`
}
