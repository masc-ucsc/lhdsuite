pub comb PPGen::[timecheck=false](io_in:(b:U64, booth:U4, sign:U1)) -> (io_out:(ppOut:U66, ppCOut:U1)) {
  wire io:(`in`:U69, out:U67) = nil
  wire noShift:U1 = nil
  wire shift:U1 = nil
  wire bNeg:U1 = nil
  wire bPos:U1 = nil
  wire _ppPos_T_2:U66 = nil
  wire _ppPos_T_5:U66 = nil
  wire ppPos:U66 = nil
  wire _ppNeg_T_4:U66 = nil
  wire _ppNeg_T_10:U66 = nil
  wire ppNeg:U66 = nil
  wire _pp_T_1:U66 = nil
  wire _pp_T_3:U66 = nil
  wire pp:U66 = nil
  wire `io_out__bpr.ppOut`:U66 = nil
  wire `io_out__bpr.ppCOut`:U1 = nil
  noShift = io.`in`#[1..<5]#[3..<4]
  shift = io.`in`#[1..<5]#[2..<3]
  bNeg = io.`in`#[1..<5]#[1..<2]
  bPos = io.`in`#[1..<5] & 1
  mut _mux_1:U66 = if shift != 0 { ((io.`in` & 1) << 65) | (io.`in`#[5..<0x45] << 1) } else { 0 }
  _ppPos_T_2 = _mux_1
  mut _rep_2:U2 = if (io.`in` & 1) != 0 { 3 } else { 0 }
  mut _mux_3:U66 = if noShift != 0 { (_rep_2#[0..<2] << 64) | io.`in`#[5..<0x45] } else { 0 }
  _ppPos_T_5 = _mux_3
  ppPos = (_ppPos_T_2 | _ppPos_T_5)#[0..<0x42]
  mut _mux_4:U66 = if shift != 0 { ((~(io.`in` & 1)#[0]) << 65) | ((~io.`in`#[5..<0x45]) << 1) | 1 } else { 0 }
  _ppNeg_T_4 = _mux_4
  mut _rep_5:U2 = if (~(io.`in` & 1)#[0]) != 0 { 3 } else { 0 }
  mut _mux_6:U66 = if noShift != 0 { (_rep_5#[0..<2] << 64) | (~io.`in`#[5..<0x45]) } else { 0 }
  _ppNeg_T_10 = _mux_6
  ppNeg = (_ppNeg_T_4 | _ppNeg_T_10)#[0..<0x42]
  mut _mux_7:U66 = if bPos != 0 { ppPos#[0..<0x42] } else { 0 }
  _pp_T_1 = _mux_7
  mut _mux_8:U66 = if bNeg != 0 { ppNeg#[0..<0x42] } else { 0 }
  _pp_T_3 = _mux_8
  pp = (_pp_T_1 | _pp_T_3)#[0..<0x42]
  mut `_GEN.ppOut` = pp#[0..<0x42]
  mut `_GEN.ppCOut` = bNeg & 1
  io.`in` = ((io_in.b << 5) | (io_in.booth << 1) | io_in.sign)#[0..<0x45]
  io.out = ((`_GEN.ppOut` << 1) | `_GEN.ppCOut`)#[0..<0x43]
  const t76 = io.out
  mut `io_out__bpo.ppOut` = t76#[1..<0x43]
  mut `io_out__bpo.ppCOut` = t76 & 1
  const t79 = `io_out__bpo.ppOut`
  `io_out__bpr.ppOut` = t79
  io_out.ppOut = t79
  const t80 = `io_out__bpo.ppCOut`
  `io_out__bpr.ppCOut` = t80
  io_out.ppCOut = t80
}
