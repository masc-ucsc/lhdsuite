const Adder_xb_3 = import("Adder_xb_3.Adder_xb_3")

pub mod compare_2to1::[timecheck=false](io_a:u32, io_b:u32, io_max:u1, io_signed:u1) -> (io_c:u32@[]) {
  wire io:(a:u32, b:u32, max:u1, signed_0:u1, c:u32) = nil
  wire cout:u1
  const b_inv__w1 = (~io.b)#[0..=31]
  mut _mux_1:u1 = if io.signed_0 != 0 { (((((io.a >> 31) & 1) ^ ((b_inv__w1 >> 31) & 1)) & 1) ^ cout) & 1 } else { (~cout) & 1 }
  mut _mux_2:u32 = if _mux_1 == io.max { io.b#[0..=31] } else { io.a#[0..=31] }
  io.a = io_a
  io.b = io_b
  io.max = io_max & 1
  io.signed_0 = io_signed & 1
  io.c = _mux_2
  mut adder_xb = Adder_xb_3::[name=adder_xb](io_in1 = b_inv__w1, io_in2 = io.a, io_cin = 1)
  cout = adder_xb
  io_c = io.c
}
