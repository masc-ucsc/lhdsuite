const Adder_xb_3 = import("Adder_xb_3.Adder_xb_3")

pub mod compare_2to1::[timecheck=false](io_a:U32, io_b:U32, io_max:U1, io_signed:U1) -> (io_c:U32@[]) {
  wire io:(a:U32, b:U32, max:U1, signed_0:U1, c:U32) = nil
  wire b_inv:U32 = nil
  wire cout:U1 = nil
  wire less:U1 = nil
  wire _io_c_T_1:U32 = nil
  b_inv = ~io.b#[0..=31]
  mut _mux_1:U1 = if io.signed_0 != 0 { (((io.a#[31..<32] ^ b_inv#[31..<32]) & 1) ^ cout) & 1 } else { ~cout }
  less = _mux_1
  mut _mux_2:U32 = if less == io.max { io.b#[0..<32] } else { io.a#[0..<32] }
  _io_c_T_1 = _mux_2
  io.a = io_a#[0..<32]
  io.b = io_b#[0..<32]
  io.max = io_max & 1
  io.signed_0 = io_signed & 1
  io.c = _io_c_T_1#[0..<32]
  mut adder_xb = Adder_xb_3::[name=adder_xb](io_in1 = b_inv, io_in2 = io.a, io_cin = 1)
  cout = adder_xb
  io_c = io.c
}
