pub comb StopiModule::[timecheck=false](clock:u1, w:(wen:u1, wdata:u64), topIR_mtopi:(IID:u12, IPRIO:u8), topIR_stopi:(IID:u12, IPRIO:u8), topIR_vstopi:(IID:u12, IPRIO:u8)) -> (rdata:u64, regOut:(IID:u12, IPRIO:u8)) {
  mut `reg_0.IID` = 0
  mut `reg_0.IPRIO` = 0
  mut `topIR.mtopi` = ((topIR_mtopi.IID << 8) | topIR_mtopi.IPRIO)#[0..=19]
  mut `topIR.stopi` = ((topIR_stopi.IID << 8) | topIR_stopi.IPRIO)#[0..=19]
  mut `topIR.vstopi` = ((topIR_vstopi.IID << 8) | topIR_vstopi.IPRIO)#[0..=19]
  mut `wdata.IID` = w.wdata#[16..=27]
  mut `wdata.IPRIO` = w.wdata#[0..=7]
  const t34 = `topIR.stopi`
  mut `regOut__bpo.IID` = t34#[8..=19]
  mut `regOut__bpo.IPRIO` = t34#[0..=7]
  regOut.IID = `regOut__bpo.IID`
  regOut.IPRIO = `regOut__bpo.IPRIO`
  rdata = (`topIR.stopi`#[8..=19] << 16) | `topIR.stopi`#[0..=7]
}
