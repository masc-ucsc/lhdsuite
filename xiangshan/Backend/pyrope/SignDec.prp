pub comb SignDec::[timecheck=false](io_sign:U4) -> (io_q:U5) {
  wire io:(sign:U4, q:U5) = nil
  wire q_i:U5 = nil
  q_i = ((((io.sign & 1) << 4) | ((~(io.sign & 1)#[0]) << 3) | ((~io.sign#[1..<2]) << 2) | ((~io.sign#[2..<3]) << 1) | (~io.sign#[2..<3])) & ((io.sign#[1..<2] << 4) | (io.sign#[1..<2] << 3) | (io.sign#[2..<3] << 2) | (io.sign#[3..<4] << 1) | (~io.sign#[3..<4])))#[0..<5]
  io.sign = io_sign#[0..<4]
  io.q = q_i#[0..<5]
  io_q = io.q
}
