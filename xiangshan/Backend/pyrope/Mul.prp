const MulModuleS0 = import("MulModuleS0.MulModuleS0")
const MulModuleS1 = import("MulModuleS1.MulModuleS1")
const MulModuleS2 = import("MulModuleS2.MulModuleS2")

pub mod Mul::[timecheck=false](`clock`:Clock, `reset`:U1, io_in:(valid:U1, bits:(fuOpType:U5, src:U128))) -> (io_out:U64@[]) {
  reg validS1_last_r:U1:[initial=0, reset_pin=`reset`, async=true]
  reg isWS2_r:U1
  reg isWS2:U1
  reg isHiS2_r:U1
  reg isHiS2:U1
  reg r:U512
  reg r_1:U128
  reg resLowS2_r:U65
  const validS1__w1 = validS1_last_r
  mut `_GEN_0.ppIn` = r#[0..<0x200]
  mut `_GEN_1.resIn` = r_1#[0..<0x80]
  mut `_GEN_1.resLow` = resLowS2_r#[0..<0x41]
  mut `_GEN_1.isHi` = isHiS2 & 1
  mut `_GEN_1.isW` = isWS2 & 1
  if validS1__w1 != 0 {
    isWS2 = isWS2_r
  }
  if validS1__w1 != 0 {
    isHiS2 = isHiS2_r
  }
  mut mulModuleS1 = MulModuleS1::[name=mulModuleS1](`io_in.ppIn` = `_GEN_0.ppIn`)
  mut mulModuleS2 = MulModuleS2::[name=mulModuleS2](`io_in.resIn` = `_GEN_1.resIn`, `io_in.resLow` = `_GEN_1.resLow`, `io_in.isHi` = `_GEN_1.isHi`, `io_in.isW` = `_GEN_1.isW`)
  mut `io.in` = ((io_in.valid << 0x85) | (io_in.bits.fuOpType << 0x80) | io_in.bits.src)#[0..<0x86]
  mut `io.out` = mulModuleS2.io_out.result#[0..<0x40]
  if not (`reset` != 0) {
    if ((`io.in`#[0x85..<0x86] | validS1__w1) & 1) != 0 {
      validS1_last_r = `io.in`#[0x85..<0x86]
    }
  }
  if validS1__w1 != 0 {
    r_1 = mulModuleS1.io_out.resHigh
  }
  if validS1__w1 != 0 {
    resLowS2_r = mulModuleS1.io_out.resLow
  }
  const isW__w1 = `io.in`#[0..<0x85]#[0x80..<0x85]#[2..<3]
  const isHi__w1 = U1(`io.in`#[0..<0x85]#[0x80..<0x85]#[0..<2] != 0)
  mut `_GEN.a` = `io.in`#[0..<0x85]#[0..<0x80]#[0..<0x40]
  mut `_GEN.b` = `io.in`#[0..<0x85]#[0..<0x80]#[0x40..<0x80]
  mut `_GEN.isMul32` = isW__w1 & 1
  mut `_GEN.isMul64` = ~isW__w1#[0]
  mut `_GEN.aIsUnSigned` = `io.in`#[0..<0x85]#[0x80..<0x85]#[1..<2] & `io.in`#[0..<0x85]#[0x80..<0x85] & 1 & 1
  mut `_GEN.bIsSigned` = ~`io.in`#[0..<0x85]#[0x80..<0x85]#[1..<2]
  mut `_GEN.isHi` = isHi__w1 & 1
  if `io.in`#[0x85..<0x86] != 0 {
    isWS2_r = isW__w1
  }
  if `io.in`#[0x85..<0x86] != 0 {
    isHiS2_r = isHi__w1
  }
  mut mulModuleS0 = MulModuleS0::[name=mulModuleS0](`io_in.a` = `_GEN.a`, `io_in.b` = `_GEN.b`, `io_in.isMul32` = `_GEN.isMul32`, `io_in.isMul64` = `_GEN.isMul64`, `io_in.aIsUnSigned` = `_GEN.aIsUnSigned`, `io_in.bIsSigned` = `_GEN.bIsSigned`, `io_in.isHi` = `_GEN.isHi`)
  if `io.in`#[0x85..<0x86] != 0 {
    r = mulModuleS0.io_out.ppS0
  }
  io_out = `io.out`
}
