const MulModuleS0 = import("MulModuleS0.MulModuleS0")
const MulModuleS1 = import("MulModuleS1.MulModuleS1")
const MulModuleS2 = import("MulModuleS2.MulModuleS2")

pub mod Mul::[timecheck=false](clock:u1, reset:u1, io_in:(valid:u1, bits:(fuOpType:u5, src:u128))) -> (io_out:u64@[]) {
  reg validS1_last_r:u1:[init=0, reset_pin=ref reset, async=true]
  reg isWS2_r:u1
  reg isWS2:u1
  reg isHiS2_r:u1
  reg isHiS2:u1
  reg r:u512
  reg r_1:u128
  reg resLowS2_r:u65
  const validS1__w1 = validS1_last_r
  mut `_GEN_0.ppIn` = r
  mut `_GEN_1.resIn` = r_1
  mut `_GEN_1.resLow` = resLowS2_r
  mut `_GEN_1.isHi` = isHiS2 & 1
  mut `_GEN_1.isW` = isWS2 & 1
  if validS1__w1 != 0 {
    isWS2 = isWS2_r
  }
  if validS1__w1 != 0 {
    isHiS2 = isHiS2_r
  }
  mut mulModuleS1 = MulModuleS1::[name=mulModuleS1](`io_in.ppIn` = `_GEN_0.ppIn`)
  mut mulModuleS2 = MulModuleS2::[name=mulModuleS2](`io_in.resIn` = `_GEN_1.resIn`, `io_in.resLow` = `_GEN_1.resLow`, `io_in.isHi` = `_GEN_1.isHi`, `io_in.isW` = `_GEN_1.isW`)
  mut `io.in` = ((io_in.valid << 0x85) | (io_in.bits.fuOpType << 0x80) | io_in.bits.src)#[0..=133]
  mut `io.out` = mulModuleS2.io_out.result#[0..=63]
  if ((((`io.in` >> 0x85) & 1) | validS1__w1) & 1) != 0 {
    validS1_last_r = (`io.in` >> 0x85) & 1
  }
  if validS1__w1 != 0 {
    r_1 = mulModuleS1.io_out.resHigh
  }
  if validS1__w1 != 0 {
    resLowS2_r = mulModuleS1.io_out.resLow
  }
  const isW__w1 = (`io.in`#[0..=132]#[128..=132] >> 2) & 1
  const isHi__w1 = unsigned(`io.in`#[0..=132]#[128..=132]#[0..=1] != 0)
  mut `_GEN.a` = `io.in`#[0..=132]#[0..=127]#[0..=63]
  mut `_GEN.b` = `io.in`#[0..=132]#[0..=127]#[64..=127]
  mut `_GEN.isMul32` = isW__w1 & 1
  mut `_GEN.isMul64` = (~isW__w1) & 1
  mut `_GEN.aIsUnSigned` = (`io.in`#[0..=132]#[128..=132] >> 1) & 1 & `io.in`#[0..=132]#[128..=132] & 1 & 1
  mut `_GEN.bIsSigned` = (~((`io.in`#[0..=132]#[128..=132] >> 1) & 1)) & 1
  mut `_GEN.isHi` = isHi__w1 & 1
  if ((`io.in` >> 0x85) & 1) != 0 {
    isWS2_r = isW__w1
  }
  if ((`io.in` >> 0x85) & 1) != 0 {
    isHiS2_r = isHi__w1
  }
  mut mulModuleS0 = MulModuleS0::[name=mulModuleS0](`io_in.a` = `_GEN.a`, `io_in.b` = `_GEN.b`, `io_in.isMul32` = `_GEN.isMul32`, `io_in.isMul64` = `_GEN.isMul64`, `io_in.aIsUnSigned` = `_GEN.aIsUnSigned`, `io_in.bIsSigned` = `_GEN.bIsSigned`, `io_in.isHi` = `_GEN.isHi`)
  if ((`io.in` >> 0x85) & 1) != 0 {
    r = mulModuleS0.io_out.ppS0
  }
  io_out = `io.out`
}
