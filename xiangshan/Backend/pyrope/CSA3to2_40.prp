pub comb CSA3to2_40::[timecheck=false](io_in_a:u200, io_in_b:u200, io_in_c:u200) -> (io_out_sum:u200, io_out_car:u200) {
  mut `io.in_a` = io_in_a
  mut `io.in_b` = io_in_b
  mut `io.in_c` = io_in_c
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..=199] ^ `io.in_c`)#[0..=199]
  mut `io.out_car` = (((`io.in_a`#[0..=198] & `io.in_b`#[0..=198]) | (`io.in_a`#[0..=198] & `io.in_c`#[0..=198])) | (`io.in_b`#[0..=198] & `io.in_c`#[0..=198])) << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
