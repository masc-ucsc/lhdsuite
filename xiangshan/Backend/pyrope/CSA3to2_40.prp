pub comb CSA3to2_40::[timecheck=false](io_in_a:U200, io_in_b:U200, io_in_c:U200) -> (io_out_sum:U200, io_out_car:U200) {
  mut `io.in_a` = io_in_a#[0..<0xc8]
  mut `io.in_b` = io_in_b#[0..<0xc8]
  mut `io.in_c` = io_in_c#[0..<0xc8]
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..<0xc8] ^ `io.in_c`)#[0..<0xc8]
  mut `io.out_car` = (((`io.in_a`#[0..<0xc7] & `io.in_b`#[0..<0xc7])#[0..<0xc7] | (`io.in_a`#[0..<0xc7] & `io.in_c`#[0..<0xc7])#[0..<0xc7])#[0..<0xc7] | (`io.in_b`#[0..<0xc7] & `io.in_c`#[0..<0xc7])#[0..<0xc7])#[0..<0xc7] << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
