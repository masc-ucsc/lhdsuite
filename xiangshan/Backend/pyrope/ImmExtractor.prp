pub comb ImmExtractor::[timecheck=false](io_in:(imm:u32, immType:u4)) -> (io_out:(imm:u64)) {
  wire io:(`in`:u36, out:u64) = nil
  const io_out_imm_signBit__w1 = (io.`in`#[4..=35] >> 11) & 1
  const io_out_imm_signBit_2__w1 = (io.`in`#[4..=35] >> 19) & 1
  mut _rep_1:u32 = if (io_out_imm_signBit__w1 & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_2:u20 = if (io_out_imm_signBit__w1 & 1) != 0 { 0xfffff } else { 0 }
  mut _mux_3:u64 = if io.`in`#[0..=3] == 4 { (_rep_1 << 32) | (_rep_2 << 12) | io.`in`#[4..=35]#[0..=11] } else { 0 }
  mut _rep_4:u32 = if (io_out_imm_signBit_2__w1 & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_5:u11 = if (io_out_imm_signBit_2__w1 & 1) != 0 { 0x7ff } else { 0 }
  mut _mux_6:u64 = if io.`in`#[0..=3] == 3 { (_rep_4 << 32) | (_rep_5 << 21) | (io.`in`#[4..=35]#[0..=19] << 1) } else { 0 }
  mut _rep_7:u32 = if (((io.`in`#[4..=35] >> 19) & 1) & 1) != 0 { 0xffffffff } else { 0 }
  mut _mux_8:u64 = if io.`in`#[0..=3] == 2 { (_rep_7 << 32) | (io.`in`#[4..=35]#[0..=19] << 12) } else { 0 }
  mut _rep_9:u32 = if (((io.`in`#[4..=35] >> 31) & 1) & 1) != 0 { 0xffffffff } else { 0 }
  mut _mux_10:u64 = if io.`in`#[0..=3] == 11 { (_rep_9 << 32) | io.`in`#[4..=35] } else { 0 }
  mut `_GEN.imm` = ((_mux_3 | _mux_6) | _mux_8) | _mux_10
  io.`in` = ((io_in.imm << 4) | io_in.immType)#[0..=35]
  io.out = `_GEN.imm`#[0..=63]
  mut `io_out__bpo.imm` = io.out#[0..=63]
  io_out.imm = `io_out__bpo.imm`
}
