pub mod DelayNWithValid_9::[timecheck=false](clock:u1, reset:u1, io_in_bits:(flag:u1, value:u9), io_in_valid:u1) -> (io_out_bits:(flag:u1, value:u9)@[], io_out_valid:u1@[]) {
  reg valid_REG:u1:[init=0, reset_pin=ref reset, async=true]
  reg data:u10
  reg valid_REG_1:u1:[init=0, reset_pin=ref reset, async=true]
  reg data_1:u10
  reg valid_REG_2:u1:[init=0, reset_pin=ref reset, async=true]
  reg res_bits:u10
  const valid__w1 = valid_REG
  const valid_1__w1 = valid_REG_1
  mut `io.in_bits` = ((io_in_bits.flag << 9) | io_in_bits.value)#[0..=9]
  mut `io.in_valid` = io_in_valid & 1
  mut `io.out_bits` = res_bits
  mut `io.out_valid` = valid_REG_2 & 1
  valid_REG = `io.in_valid`
  mut _mux_1:u1 = if `io.in_valid` != 0 { (`io.in_bits` >> 9) & 1 } else { (data >> 9) & 1 }
  mut _mux_2:u9 = if `io.in_valid` != 0 { `io.in_bits`#[0..=8] } else { data#[0..=8] }
  data = _mux_2 | (_mux_1 << 9)
  valid_REG_1 = valid__w1
  mut _mux_3:u1 = if valid__w1 != 0 { (data >> 9) & 1 } else { (data_1 >> 9) & 1 }
  mut _mux_4:u9 = if valid__w1 != 0 { data#[0..=8] } else { data_1#[0..=8] }
  data_1 = _mux_4 | (_mux_3 << 9)
  valid_REG_2 = valid_1__w1
  mut _mux_5:u1 = if valid_1__w1 != 0 { (data_1 >> 9) & 1 } else { (res_bits >> 9) & 1 }
  mut _mux_6:u9 = if valid_1__w1 != 0 { data_1#[0..=8] } else { res_bits#[0..=8] }
  res_bits = _mux_6 | (_mux_5 << 9)
  const t50 = `io.out_bits`
  mut `io_out_bits__bpo.flag` = (t50 >> 9) & 1
  mut `io_out_bits__bpo.value` = t50#[0..=8]
  io_out_bits.flag = `io_out_bits__bpo.flag`
  io_out_bits.value = `io_out_bits__bpo.value`
  io_out_valid = `io.out_valid`
}
