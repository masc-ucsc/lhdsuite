pub mod DelayNWithValid_9::[timecheck=false](`clock`:Clock, `reset`:U1, io_in_bits:(flag:U1, value:U9), io_in_valid:U1) -> (io_out_bits:(flag:U1, value:U9)@[], io_out_valid:U1@[]) {
  reg valid_REG:U1:[initial=0, reset_pin=`reset`, async=true]
  reg data:U10
  reg valid_REG_1:U1:[initial=0, reset_pin=`reset`, async=true]
  reg data_1:U10
  reg valid_REG_2:U1:[initial=0, reset_pin=`reset`, async=true]
  reg res_bits:U10
  wire `io_out_bits__bpr.flag`:U1 = nil
  wire `io_out_bits__bpr.value`:U9 = nil
  const valid__w1 = valid_REG
  const valid_1__w1 = valid_REG_1
  mut `io.in_bits` = ((io_in_bits.flag << 9) | io_in_bits.value)#[0..<10]
  mut `io.in_valid` = io_in_valid & 1
  mut `io.out_bits` = res_bits#[0..<10]
  mut `io.out_valid` = valid_REG_2 & 1
  if not (`reset` != 0) {
    valid_REG = `io.in_valid`
  }
  mut _mux_1:U1 = if `io.in_valid` != 0 { `io.in_bits`#[9..<10] } else { data#[9..<10] }
  mut _mux_2:U9 = if `io.in_valid` != 0 { `io.in_bits`#[0..<9] } else { data#[0..<9] }
  data = _mux_2 | (_mux_1 << 9)
  if not (`reset` != 0) {
    valid_REG_1 = valid__w1
  }
  mut _mux_3:U1 = if valid__w1 != 0 { data#[9..<10] } else { data_1#[9..<10] }
  mut _mux_4:U9 = if valid__w1 != 0 { data#[0..<9] } else { data_1#[0..<9] }
  data_1 = _mux_4 | (_mux_3 << 9)
  if not (`reset` != 0) {
    valid_REG_2 = valid_1__w1
  }
  mut _mux_5:U1 = if valid_1__w1 != 0 { data_1#[9..<10] } else { res_bits#[9..<10] }
  mut _mux_6:U9 = if valid_1__w1 != 0 { data_1#[0..<9] } else { res_bits#[0..<9] }
  res_bits = _mux_6 | (_mux_5 << 9)
  const t50 = `io.out_bits`
  mut `io_out_bits__bpo.flag` = t50#[9..<10]
  mut `io_out_bits__bpo.value` = t50#[0..<9]
  const t54 = `io_out_bits__bpo.flag`
  `io_out_bits__bpr.flag` = t54
  io_out_bits.flag = t54
  const t55 = `io_out_bits__bpo.value`
  `io_out_bits__bpr.value` = t55
  io_out_bits.value = t55
  io_out_valid = `io.out_valid`
}
