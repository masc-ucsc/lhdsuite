const DiffExtTrapEvent = import("DiffExtTrapEvent.DiffExtTrapEvent")

pub mod DummyDPICWrapper_TrapEvent::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(hasTrap:u1, cycleCnt:u64, instrCnt:u64, hasWFI:u1, code:u64, pc:u64, coreid:u8))) -> () {
  mut dpic = DiffExtTrapEvent::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x10a) | (io.bits.hasTrap << 0x109) | (io.bits.cycleCnt << 0xc9) | (io.bits.instrCnt << 0x89) | (io.bits.hasWFI << 0x88) | (io.bits.code << 0x48) | (io.bits.pc << 8) | io.bits.coreid)#[0..=265])
}
