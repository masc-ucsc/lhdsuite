pub mod Sstateen0Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), fromMstateen0:(JVT:U1, FCSR:U1, SE0:U1, ENVCFG:U1, CSRIND:U1, AIA:U1, IMSIC:U1, CONTEXT:U1, P1P13:U1, C:U1), fromHstateen0:(JVT:U1, FCSR:U1, C:U1, SE0:U1, ENVCFG:U1, CSRIND:U1, AIA:U1, IMSIC:U1, CONTEXT:U1), privState:(PRVM:U2, V:U1)) -> (rdata:U32@[], regOut:(JVT:U1, FCSR:U1, C:U1)@[]) {
