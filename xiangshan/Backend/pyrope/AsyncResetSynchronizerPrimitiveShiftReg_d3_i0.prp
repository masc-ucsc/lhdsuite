pub mod AsyncResetSynchronizerPrimitiveShiftReg_d3_i0::[timecheck=false](`clock`:Clock, `reset`:U1, io_d:U1) -> (io_q:U1@[]) {
  reg sync_0:U1:[initial=0, reset_pin=`reset`, async=true]
  reg sync_1:U1:[initial=0, reset_pin=`reset`, async=true]
  reg sync_2:U1:[initial=0, reset_pin=`reset`, async=true]
  mut `io.d` = io_d & 1
  mut `io.q` = sync_0 & 1
  if not (`reset` != 0) {
    sync_0 = sync_1
  }
  if not (`reset` != 0) {
    sync_1 = sync_2
  }
  if not (`reset` != 0) {
    sync_2 = `io.d`
  }
  io_q = `io.q`
}
