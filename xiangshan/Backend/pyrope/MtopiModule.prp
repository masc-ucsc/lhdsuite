pub mod MtopiModule::[timecheck=false](`clock`:Clock, w:(wen:U1, wdata:U64), topIR_mtopi:(IID:U12, IPRIO:U8), topIR_stopi:(IID:U12, IPRIO:U8), topIR_vstopi:(IID:U12, IPRIO:U8)) -> (rdata:U64@[], regOut:(IID:U12, IPRIO:U8)@[]) {
  mut `reg_0.IID` = 0
  mut `reg_0.IPRIO` = 0
  wire `regOut__bpr.IID`:U12 = nil
  wire `regOut__bpr.IPRIO`:U8 = nil
  mut `topIR.mtopi` = ((topIR_mtopi.IID << 8) | topIR_mtopi.IPRIO)#[0..<20]
  mut `topIR.stopi` = ((topIR_stopi.IID << 8) | topIR_stopi.IPRIO)#[0..<20]
  mut `topIR.vstopi` = ((topIR_vstopi.IID << 8) | topIR_vstopi.IPRIO)#[0..<20]
  mut `wdata.IID` = w.wdata#[16..<28]
  mut `wdata.IPRIO` = w.wdata#[0..<8]
  const t34 = `topIR.mtopi`
  mut `regOut__bpo.IID` = t34#[8..<20]
  mut `regOut__bpo.IPRIO` = t34#[0..<8]
  const t37 = `regOut__bpo.IID`
  `regOut__bpr.IID` = t37
  regOut.IID = t37
  const t38 = `regOut__bpo.IPRIO`
  `regOut__bpr.IPRIO` = t38
  regOut.IPRIO = t38
  rdata = (`topIR.mtopi`#[8..<20] << 16) | `topIR.mtopi`#[0..<8]
}
