pub mod FarPathF32WidenF16MixedAdderPipeline::[timecheck=false](clock:u1, io_fire:u1, io_A:u25, io_B:u25) -> (io_result:u25@[]) {
  reg io_result_r:u7
  reg io_result_r_1:u7
  reg io_result_r_2:u18
  mut `io.fire` = io_fire & 1
  mut `io.A` = io_A
  mut `io.B` = io_B
  mut `io.result` = ((io_result_r + io_result_r_1)#[0..=6] << 18) | io_result_r_2
  const seq_short_full_adder__w1 = ((`io.A`#[18..=24] + `io.B`#[18..=24])#[0..=6] << 19) | (`io.A`#[0..=17] + `io.B`#[0..=17])#[0..=18]
  const reg_short_adder_sum__w1 = (seq_short_full_adder__w1#[19..=25] << 18) | seq_short_full_adder__w1#[0..=17]
  if `io.fire` != 0 {
    io_result_r = reg_short_adder_sum__w1#[18..=24]
  }
  if `io.fire` != 0 {
    io_result_r_1 = (((seq_short_full_adder__w1 >> 18) & 1) << 17)#[17..=23]
  }
  if `io.fire` != 0 {
    io_result_r_2 = reg_short_adder_sum__w1#[0..=17]
  }
  io_result = `io.result`
}
