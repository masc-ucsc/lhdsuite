pub mod FarPathF32WidenF16MixedAdderPipeline::[timecheck=false](`clock`:Clock, io_fire:U1, io_A:U25, io_B:U25) -> (io_result:U25@[]) {
  reg io_result_r:U7
  reg io_result_r_1:U7
  reg io_result_r_2:U18
  mut `io.fire` = io_fire & 1
  mut `io.A` = io_A#[0..<25]
  mut `io.B` = io_B#[0..<25]
  mut `io.result` = ((io_result_r + io_result_r_1)#[0..<7] << 18) | io_result_r_2#[0..<18]
  const seq_short_full_adder__w1 = ((`io.A`#[18..<25] + `io.B`#[18..<25])#[0..<7] << 19) | (`io.A`#[0..<18] + `io.B`#[0..<18])#[0..<19]
  const reg_short_adder_sum__w1 = (seq_short_full_adder__w1#[19..<26] << 18) | seq_short_full_adder__w1#[0..<18]
  if `io.fire` != 0 {
    io_result_r = reg_short_adder_sum__w1#[18..<25]
  }
  if `io.fire` != 0 {
    io_result_r_1 = (seq_short_full_adder__w1#[18..<19] << 17)#[17..<24]
  }
  if `io.fire` != 0 {
    io_result_r_2 = reg_short_adder_sum__w1#[0..<18]
  }
  io_result = `io.result`
}
