pub comb vdRndGenerator::[timecheck=false](io_sumFinalFixP:u152, io_sewIs8:u1, io_sewIs16:u1, io_sewIs32:u1, io_sewIs64:u1) -> (io_vdRndInc:u64) {
  wire io:(sumFinalFixP:u152, sewIs8:u1, sewIs16:u1, sewIs32:u1, sewIs64:u1, vdRndInc:u64) = nil
  mut _mux_1:u64 = if io.sewIs8 != 0 { (io.sumFinalFixP#[140..=147] << 56) | (io.sumFinalFixP#[121..=128] << 48) | (io.sumFinalFixP#[102..=109] << 40) | (io.sumFinalFixP#[83..=90] << 32) | (io.sumFinalFixP#[64..=71] << 24) | (io.sumFinalFixP#[45..=52] << 16) | (io.sumFinalFixP#[26..=33] << 8) | io.sumFinalFixP#[7..=14] } else { 0 }
  mut _mux_2:u64 = if io.sewIs16 != 0 { (io.sumFinalFixP#[129..=144] << 48) | (io.sumFinalFixP#[91..=106] << 32) | (io.sumFinalFixP#[53..=68] << 16) | io.sumFinalFixP#[15..=30] } else { 0 }
  mut _mux_3:u64 = if io.sewIs32 != 0 { (io.sumFinalFixP#[107..=138] << 32) | io.sumFinalFixP#[31..=62] } else { 0 }
  mut _mux_4:u64 = if io.sewIs64 != 0 { io.sumFinalFixP#[63..=126] } else { 0 }
  io.sumFinalFixP = io_sumFinalFixP
  io.sewIs8 = io_sewIs8 & 1
  io.sewIs16 = io_sewIs16 & 1
  io.sewIs32 = io_sewIs32 & 1
  io.sewIs64 = io_sewIs64 & 1
  io.vdRndInc = ((_mux_1 | _mux_2) | _mux_3) | _mux_4
  io_vdRndInc = io.vdRndInc
}
