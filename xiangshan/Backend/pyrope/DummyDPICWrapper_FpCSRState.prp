const DiffExtFpCSRState = import("DiffExtFpCSRState.DiffExtFpCSRState")

pub mod DummyDPICWrapper_FpCSRState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(fcsr:u64, coreid:u8))) -> () {
  mut dpic = DiffExtFpCSRState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x48) | (io.bits.fcsr << 8) | io.bits.coreid)#[0..=71])
}
