pub mod Iprio8Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> () {
  mut _mux_1:U64 = 0
  mut t7 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U64
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..<0x40]
  t7 = _GEN
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.ALL`#[0..<0x40] } else { reg_0#[0..<0x40] }
    t7 = _mux_1
    reg_0 = t7
  }
  _GEN = t7
}
