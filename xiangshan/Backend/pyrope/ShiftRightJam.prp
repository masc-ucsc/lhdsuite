pub comb ShiftRightJam::[timecheck=false](io_in:u65, io_shamt:u11) -> (io_out:u65, io_sticky:u1) {
  wire io:(`in`:u65, shamt:u11, out:u65, sticky:u1) = nil
  const exceed_max_shift__w1 = unsigned(io.shamt > 0x41)
  mut _rep_2:u65 = if (exceed_max_shift__w1 & 1) != 0 { 0x1ffffffffffffffff } else { 0 }
  const sticky_mask__w1 = ((1 << io.shamt#[0..=6])#[0..=127]#[0..=64] - 1)#[0..=64] | _rep_2
  mut _mux_3:u65 = if exceed_max_shift__w1 != 0 { 0 } else { (io.`in` >> io.shamt)#[0..=64] }
  io.`in` = io_in
  io.shamt = io_shamt
  io.out = _mux_3
  io.sticky = unsigned((io.`in` & sticky_mask__w1) != 0) & 1
  io_out = io.out
  io_sticky = io.sticky
}
