pub comb ShiftRightJam::[timecheck=false](io_in:U65, io_shamt:U11) -> (io_out:U65, io_sticky:U1) {
  wire io:(`in`:U65, shamt:U11, out:U65, sticky:U1) = nil
  wire exceed_max_shift:U1 = nil
  wire shamt:U7 = nil
  wire _sticky_mask_T:U128 = nil
  wire sticky_mask:U65 = nil
  wire _io_out_T_1:U65 = nil
  exceed_max_shift = U1(io.shamt > 0x41)
  shamt = io.shamt#[0..<7]
  _sticky_mask_T = (1 << shamt)#[0..<0x80]
  mut _rep_2:U65 = if (exceed_max_shift & 1) != 0 { 0x1ffffffffffffffff } else { 0 }
  sticky_mask = ((_sticky_mask_T#[0..<0x41] - 1)#[0..<0x41] | _rep_2)#[0..<0x41]
  mut _mux_3:U65 = if exceed_max_shift != 0 { 0 } else { (io.`in` >> io.shamt)#[0..<0x41] }
  _io_out_T_1 = _mux_3
  io.`in` = io_in#[0..<0x41]
  io.shamt = io_shamt#[0..<11]
  io.out = _io_out_T_1#[0..<0x41]
  mut _b2i_4 = if (io.`in` & sticky_mask)#[0..<0x41] != 0 { 1 } else { 0 }
  io.sticky = _b2i_4 & 1
  io_out = io.out
  io_sticky = io.sticky
}
