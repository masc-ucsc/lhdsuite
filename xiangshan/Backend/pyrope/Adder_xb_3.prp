pub comb Adder_xb_3::[timecheck=false](io_in1:U32, io_in2:U32, io_cin:U1) -> (io_cout:U1) {
  wire io:(in1:U32, in2:U32, cin:U1, cout:U1) = nil
  wire bits:U34 = nil
  bits = (((io.in1#[0..<32] << 1) | (io.cin & 1)) + ((io.in2#[0..<32] << 1) | (io.cin & 1)))#[0..<34]
  io.in1 = io_in1#[0..<32]
  io.in2 = io_in2#[0..<32]
  io.cin = io_cin & 1
  io.cout = bits#[33..<34]
  io_cout = io.cout
}
