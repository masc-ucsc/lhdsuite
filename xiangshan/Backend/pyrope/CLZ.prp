pub comb CLZ::[timecheck=false](io_in:u16) -> (io_out:u5) {
  wire io:(`in`:u16, out:u5) = nil
  mut _mux_1:u5 = if (io.`in` & 1) != 0 { 15 } else { 16 }
  mut _mux_2:u5 = if ((io.`in` >> 1) & 1) != 0 { 14 } else { _mux_1 }
  mut _mux_3:u5 = if ((io.`in` >> 2) & 1) != 0 { 13 } else { _mux_2 }
  mut _mux_4:u5 = if ((io.`in` >> 3) & 1) != 0 { 12 } else { _mux_3 }
  mut _mux_5:u5 = if ((io.`in` >> 4) & 1) != 0 { 11 } else { _mux_4 }
  mut _mux_6:u5 = if ((io.`in` >> 5) & 1) != 0 { 10 } else { _mux_5 }
  mut _mux_7:u5 = if ((io.`in` >> 6) & 1) != 0 { 9 } else { _mux_6 }
  mut _mux_8:u5 = if ((io.`in` >> 7) & 1) != 0 { 8 } else { _mux_7 }
  mut _mux_9:u5 = if ((io.`in` >> 8) & 1) != 0 { 7 } else { _mux_8 }
  mut _mux_10:u5 = if ((io.`in` >> 9) & 1) != 0 { 6 } else { _mux_9 }
