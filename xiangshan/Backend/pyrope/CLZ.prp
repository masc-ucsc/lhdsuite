  mut _mux_15:u5 = if ((io.`in` >> 14) & 1) != 0 { 1 } else { _mux_14 }
  mut _mux_16:u5 = if ((io.`in` >> 15) & 1) != 0 { 0 } else { _mux_15 }
  io.`in` = io_in
  io.out = _mux_16
