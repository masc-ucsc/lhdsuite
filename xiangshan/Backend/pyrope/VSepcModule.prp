pub mod VSepcModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), trapToVS:(privState:(valid:U1, bits:(PRVM:U2, V:U1)), vsstatus:(valid:U1, bits:(SIE:U1, SPIE:U1, UBE:U1, SPP:U1, VS:U2, FS:U2, XS:U2, SUM:U1, MXR:U1, SDT:U1, UXL:U2, SD:U1)), vsepc:(valid:U1, bits:(epc:U63)), vscause:(valid:U1, bits:(Interrupt:U1, ExceptionCode:U63)), vstval:(valid:U1, bits:(ALL:U64)))) -> (rdata:U64@[], regOut:(epc:U63)@[]) {
  mut _mux_3:U63 = 0
