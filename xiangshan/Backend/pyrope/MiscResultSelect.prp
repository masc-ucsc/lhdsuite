  _logicRes_WIRE = (io.orcb#[0..<0x40] << 192) | (io.xor_0#[0..<0x40] << 128) | (io.or_0#[0..<0x40] << 64) | io.and_0#[0..<0x40]
  _miscRes_WIRE = (io.packw#[0..<0x40] << 192) | (io.sexth#[0..<0x40] << 128) | (io.packh#[0..<0x40] << 64) | io.sextb#[0..<0x40]
  _GEN = ((_logicRes_WIRE << 0x40) >> ((io.func#[1..<3] * 0x40) + 0x40))#[0..<0x40]
  mut _mux_1:U64 = if io.func#[3..<4] != 0 { ((_miscRes_WIRE << 0x40) >> ((io.func#[0..<2] * 0x40) + 0x40))#[0..<0x40] } else { _GEN#[0..<0x40] }
  logicBase = _mux_1
