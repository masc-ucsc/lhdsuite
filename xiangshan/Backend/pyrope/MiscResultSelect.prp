  _customRes_WIRE = (io.src#[8..<16] << 192) | ((io.src#[0..<32] << 3) << 128) | ((io.src#[0..<32] << 2) << 64) | (io.src#[0..<32] << 1)
  mut _mux_2:U64 = if io.func#[3..<4] != 0 { ((_customRes_WIRE << 0x40) >> ((io.func#[0..<2] * 0x40) + 0x40))#[0..<0x40] } else { ((_revRes_WIRE << 0x40) >> ((io.func#[0..<2] * 0x40) + 0x40))#[0..<0x40] }
  logicAdv = _mux_2
  mut _rep_3:U15 = if (io.func & 1) != 0 { 0x7fff } else { 0 }
  mask = (_rep_3#[0..<15] << 1) | 1
  maskedLogicRes = (_GEN#[0..<16] & mask)#[0..<16]
