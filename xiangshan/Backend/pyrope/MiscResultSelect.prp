pub comb MiscResultSelect::[timecheck=false](io_func:u6, io_and:u64, io_or:u64, io_xor:u64, io_orcb:u64, io_orh48:u64, io_sextb:u64, io_packh:u64, io_sexth:u64, io_packw:u64, io_revb:u64, io_rev8:u64, io_pack:u64, io_src:u64) -> (io_miscRes:u64) {
  wire io:(func:u6, and_0:u64, or_0:u64, xor_0:u64, orcb:u64, orh48:u64, sextb:u64, packh:u64, sexth:u64, packw:u64, revb:u64, rev8:u64, pack:u64, src:u64, miscRes:u64) = nil
  wire _logicRes_WIRE:u256
  wire _miscRes_WIRE:u256
  wire _revRes_WIRE:u256
  wire _customRes_WIRE:u256
  _logicRes_WIRE = (io.orcb#[0..=63] << 192) | (io.xor_0#[0..=63] << 128) | (io.or_0#[0..=63] << 64) | io.and_0#[0..=63]
  _miscRes_WIRE = (io.packw#[0..=63] << 192) | (io.sexth#[0..=63] << 128) | (io.packh#[0..=63] << 64) | io.sextb#[0..=63]
  const _GEN__w1 = ((_logicRes_WIRE << 0x40) >> ((io.func#[1..=2] * 0x40) + 0x40))#[0..=63]
  mut _mux_1:u64 = if ((io.func >> 3) & 1) != 0 { ((_miscRes_WIRE << 0x40) >> ((io.func#[0..=1] * 0x40) + 0x40))#[0..=63] } else { _GEN__w1 }
  _revRes_WIRE = (io.orh48#[0..=63] << 192) | (io.pack#[0..=63] << 128) | (io.rev8#[0..=63] << 64) | io.revb#[0..=63]
  _customRes_WIRE = (io.src#[8..=15] << 192) | ((io.src#[0..=31] << 3) << 128) | ((io.src#[0..=31] << 2) << 64) | (io.src#[0..=31] << 1)
  mut _mux_2:u64 = if ((io.func >> 3) & 1) != 0 { ((_customRes_WIRE << 0x40) >> ((io.func#[0..=1] * 0x40) + 0x40))#[0..=63] } else { ((_revRes_WIRE << 0x40) >> ((io.func#[0..=1] * 0x40) + 0x40))#[0..=63] }
  mut _rep_3:u15 = if (io.func & 1) != 0 { 0x7fff } else { 0 }
  mut _mux_4:u64 = if ((io.func >> 4) & 1) != 0 { _mux_2 } else { _mux_1 }
  mut _mux_5:u64 = if ((io.func >> 5) & 1) != 0 { (_GEN__w1#[0..=15] & ((_rep_3 << 1) | 1)) } else { _mux_4 }
  io.func = io_func
  io.and_0 = io_and
  io.or_0 = io_or
  io.xor_0 = io_xor
  io.orcb = io_orcb
  io.orh48 = io_orh48
  io.sextb = io_sextb
  io.packh = io_packh
  io.sexth = io_sexth
  io.packw = io_packw
  io.revb = io_revb
  io.rev8 = io_rev8
  io.pack = io_pack
  io.src = io_src
  io.miscRes = _mux_5
  io_miscRes = io.miscRes
}
