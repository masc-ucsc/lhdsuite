pub comb CSA3to2_144::[timecheck=false](io_in_a:u64, io_in_b:u64, io_in_c:u64) -> (io_out_sum:u64, io_out_car:u64) {
  mut `io.in_a` = io_in_a
  mut `io.in_b` = io_in_b
  mut `io.in_c` = io_in_c
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..=63] ^ `io.in_c`)#[0..=63]
  mut `io.out_car` = (((`io.in_a`#[0..=62] & `io.in_b`#[0..=62]) | (`io.in_a`#[0..=62] & `io.in_c`#[0..=62])) | (`io.in_b`#[0..=62] & `io.in_c`#[0..=62])) << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
