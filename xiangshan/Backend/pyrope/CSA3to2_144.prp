pub comb CSA3to2_144::[timecheck=false](io_in_a:U64, io_in_b:U64, io_in_c:U64) -> (io_out_sum:U64, io_out_car:U64) {
  mut `io.in_a` = io_in_a#[0..<0x40]
  mut `io.in_b` = io_in_b#[0..<0x40]
  mut `io.in_c` = io_in_c#[0..<0x40]
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..<0x40] ^ `io.in_c`)#[0..<0x40]
  mut `io.out_car` = (((`io.in_a`#[0..<63] & `io.in_b`#[0..<63])#[0..<63] | (`io.in_a`#[0..<63] & `io.in_c`#[0..<63])#[0..<63])#[0..<63] | (`io.in_b`#[0..<63] & `io.in_c`#[0..<63])#[0..<63])#[0..<63] << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
