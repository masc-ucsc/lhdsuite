pub comb RotateRightShiftWordModule::[timecheck=false](io_shamt:U5, io_rorwSrc:U32) -> (io_rorw:U64) {
  wire io:(shamt:U5, rorwSrc:U32, rorw:U64) = nil
  wire io_rorw_shifted_shifted:U32 = nil
  wire io_rorw_shifted_shifted_1:U32 = nil
  wire io_rorw_shifted_shifted_2:U32 = nil
  wire io_rorw_shifted_shifted_3:U32 = nil
  wire io_rorw_shifted:U32 = nil
  mut _mux_1:U32 = if io.shamt#[4..<5] != 0 { (io.rorwSrc#[0..<16] << 16) | io.rorwSrc#[16..<32] } else { io.rorwSrc#[0..<32] }
  io_rorw_shifted_shifted = _mux_1
  mut _mux_2:U32 = if io.shamt#[3..<4] != 0 { (io_rorw_shifted_shifted#[0..<8] << 24) | io_rorw_shifted_shifted#[8..<32] } else { io_rorw_shifted_shifted#[0..<32] }
  io_rorw_shifted_shifted_1 = _mux_2
  mut _mux_3:U32 = if io.shamt#[2..<3] != 0 { (io_rorw_shifted_shifted_1#[0..<4] << 28) | io_rorw_shifted_shifted_1#[4..<32] } else { io_rorw_shifted_shifted_1#[0..<32] }
  io_rorw_shifted_shifted_2 = _mux_3
  mut _mux_4:U32 = if io.shamt#[1..<2] != 0 { (io_rorw_shifted_shifted_2#[0..<2] << 30) | io_rorw_shifted_shifted_2#[2..<32] } else { io_rorw_shifted_shifted_2#[0..<32] }
  io_rorw_shifted_shifted_3 = _mux_4
  mut _mux_5:U32 = if (io.shamt & 1) != 0 { ((io_rorw_shifted_shifted_3 & 1) << 31) | io_rorw_shifted_shifted_3#[1..<32] } else { io_rorw_shifted_shifted_3#[0..<32] }
  io_rorw_shifted = _mux_5
  io.shamt = io_shamt#[0..<5]
  io.rorwSrc = io_rorwSrc#[0..<32]
  io.rorw = io_rorw_shifted#[0..<32]#sext[0..=31]#[0..<0x40]
  io_rorw = io.rorw
}
