pub comb RotateRightShiftWordModule::[timecheck=false](io_shamt:u5, io_rorwSrc:u32) -> (io_rorw:u64) {
  wire io:(shamt:u5, rorwSrc:u32, rorw:u64) = nil
  mut _mux_1:u32 = if ((io.shamt >> 4) & 1) != 0 { (io.rorwSrc#[0..=15] << 16) | io.rorwSrc#[16..=31] } else { io.rorwSrc#[0..=31] }
  const io_rorw_shifted_shifted__w1 = _mux_1
  mut _mux_2:u32 = if ((io.shamt >> 3) & 1) != 0 { (io_rorw_shifted_shifted__w1#[0..=7] << 24) | io_rorw_shifted_shifted__w1#[8..=31] } else { io_rorw_shifted_shifted__w1 }
  const io_rorw_shifted_shifted_1__w1 = _mux_2
  mut _mux_3:u32 = if ((io.shamt >> 2) & 1) != 0 { (io_rorw_shifted_shifted_1__w1#[0..=3] << 28) | io_rorw_shifted_shifted_1__w1#[4..=31] } else { io_rorw_shifted_shifted_1__w1 }
  const io_rorw_shifted_shifted_2__w1 = _mux_3
  mut _mux_4:u32 = if ((io.shamt >> 1) & 1) != 0 { (io_rorw_shifted_shifted_2__w1#[0..=1] << 30) | io_rorw_shifted_shifted_2__w1#[2..=31] } else { io_rorw_shifted_shifted_2__w1 }
  const io_rorw_shifted_shifted_3__w1 = _mux_4
  mut _mux_5:u32 = if (io.shamt & 1) != 0 { ((io_rorw_shifted_shifted_3__w1 & 1) << 31) | io_rorw_shifted_shifted_3__w1#[1..=31] } else { io_rorw_shifted_shifted_3__w1 }
  io.shamt = io_shamt
  io.rorwSrc = io_rorwSrc
  io.rorw = _mux_5#sext[0..=31]#[0..=63]
  io_rorw = io.rorw
}
