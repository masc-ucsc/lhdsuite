const SubModule = import("SubModule.SubModule")

pub mod BranchModule::[timecheck=false](io_src:u128, io_func:u9, io_fixedTaken:u1) -> (io_taken:u1@[], io_mispredict:u1@[]) {
  wire io:(src:u128, func:u9, fixedTaken:u1, taken:u1, mispredict:u1) = nil
  wire _subModule_io_sub:u65
  const sltu__w1 = (~((_subModule_io_sub >> 0x40) & 1)) & 1
  const taken__w1 = ((((((unsigned(io.func#[1..=3] == 0) & unsigned((io.src#[0..=63] ^ io.src#[64..=127]) == 0) & 1) | (unsigned(io.func#[1..=3] == 2) & ((((((io.src#[0..=63] >> 63) & 1) ^ ((io.src#[64..=127] >> 63) & 1)) & 1) ^ sltu__w1) & 1) & 1)) & 1) | (unsigned(io.func#[1..=3] == 4) & sltu__w1 & 1)) & 1) ^ (io.func & 1)) & 1
  io.src = io_src
  io.func = io_func
  io.fixedTaken = io_fixedTaken & 1
  io.taken = taken__w1 & 1
  io.mispredict = (io.fixedTaken ^ taken__w1) & 1
  mut subModule = SubModule::[name=subModule](io_src = io.src)
  _subModule_io_sub = subModule
  io_taken = io.taken
