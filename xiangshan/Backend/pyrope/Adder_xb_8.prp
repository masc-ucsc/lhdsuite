pub comb Adder_xb_8::[timecheck=false](io_in1:U16, io_in2:U16, io_cin:U1) -> (io_cout:U1) {
  wire io:(in1:U16, in2:U16, cin:U1, cout:U1) = nil
  wire bits:U18 = nil
  bits = (((io.in1#[0..<16] << 1) | (io.cin & 1)) + ((io.in2#[0..<16] << 1) | (io.cin & 1)))#[0..<18]
  io.in1 = io_in1#[0..<16]
  io.in2 = io_in2#[0..<16]
  io.cin = io_cin & 1
  io.cout = bits#[17..<18]
  io_cout = io.cout
}
