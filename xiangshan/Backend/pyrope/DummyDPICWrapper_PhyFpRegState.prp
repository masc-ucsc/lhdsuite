const DiffExtPhyFpRegState = import("DiffExtPhyFpRegState.DiffExtPhyFpRegState")

pub mod DummyDPICWrapper_PhyFpRegState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(value:u16384, coreid:u8))) -> () {
  mut dpic = DiffExtPhyFpRegState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x4008) | (io.bits.value << 8) | io.bits.coreid)#[0..=16391])
}
