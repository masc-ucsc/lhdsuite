pub mod VIMac64bStage3::[timecheck=false](io_in:(sumFinalNonFixPS2:U152, sumFinalFixPS2:U152, highHalfS2:U1, uopIdxS2:U6, widenS2:U1, vxrmS2:U2, isFixPS2:U1, sewIs8S2:U1, sewIs16S2:U1, sewIs32S2:U1, sewIs64S2:U1)) -> (io_out:(vd:U64, vxsat:U8)@[]) {
  wire _outputMux_io_vdOut:U64 = nil
  wire _outputMux_io_vxsatOut:U8 = nil
  wire `io_out__bpr.vd`:U64 = nil
  wire `io_out__bpr.vxsat`:U8 = nil
  mut `_GEN.vd` = _outputMux_io_vdOut#[0..<0x40]
  mut `_GEN.vxsat` = _outputMux_io_vxsatOut#[0..<8]
  mut `io.in` = ((io_in.sumFinalNonFixPS2 << 0xa7) | (io_in.sumFinalFixPS2 << 15) | (io_in.highHalfS2 << 14) | (io_in.uopIdxS2 << 8) | (io_in.widenS2 << 7) | (io_in.vxrmS2 << 5) | (io_in.isFixPS2 << 4) | (io_in.sewIs8S2 << 3) | (io_in.sewIs16S2 << 2) | (io_in.sewIs32S2 << 1) | io_in.sewIs64S2)#[0..<0x13f]
  mut `io.out` = ((`_GEN.vd` << 8) | `_GEN.vxsat`)#[0..<0x48]
  mut vdNonFixPGen = vdNonFixPGenerator::[name=vdNonFixPGen](io_sumFinalNonFixP = `io.in`#[0xa7..<0x13f], io_highHalf = `io.in`#[14..<15], io_widen = `io.in`#[7..<8], io_uopIdx = `io.in`#[8..<14], io_sewIs8 = `io.in`#[3..<4], io_sewIs16 = `io.in`#[2..<3], io_sewIs32 = `io.in`#[1..<2], io_sewIs64 = `io.in` & 1)
  mut vxsatGen = vxsatGenerator::[name=vxsatGen](io_sumFinalNonFixP = `io.in`#[0xa7..<0x13f], io_sewIs8 = `io.in`#[3..<4], io_sewIs16 = `io.in`#[2..<3], io_sewIs32 = `io.in`#[1..<2], io_sewIs64 = `io.in` & 1)
  mut rndIncVecGen = rndIncVecGenerator::[name=rndIncVecGen](io_sumFinalNonFixP = `io.in`#[0xa7..<0x13f], io_vxrm = `io.in`#[5..<7], io_sewIs8 = `io.in`#[3..<4], io_sewIs16 = `io.in`#[2..<3], io_sewIs32 = `io.in`#[1..<2], io_sewIs64 = `io.in` & 1)
  mut vdRndGen = vdRndGenerator::[name=vdRndGen](io_sumFinalFixP = `io.in`#[15..<0xa7], io_sewIs8 = `io.in`#[3..<4], io_sewIs16 = `io.in`#[2..<3], io_sewIs32 = `io.in`#[1..<2], io_sewIs64 = `io.in` & 1)
  mut vdFixPGen = vdFixPGenerator::[name=vdFixPGen](io_vdRndInc = vdRndGen, io_vdSat = vxsatGen.io_vdSat, io_rndIncVec = rndIncVecGen, io_sewIs8 = `io.in`#[3..<4], io_sewIs16 = `io.in`#[2..<3], io_sewIs32 = `io.in`#[1..<2], io_sewIs64 = `io.in` & 1)
  mut outputMux = outputSelect::[name=outputMux](io_vdNonFixP = vdNonFixPGen, io_vdFixP = vdFixPGen, io_vxsat = vxsatGen.io_vxsat, io_isFixP = `io.in`#[4..<5])
  _outputMux_io_vdOut = outputMux.io_vdOut
  _outputMux_io_vxsatOut = outputMux.io_vxsatOut
  const t108 = `io.out`
  mut `io_out__bpo.vd` = t108#[8..<0x48]
  mut `io_out__bpo.vxsat` = t108#[0..<8]
  const t111 = `io_out__bpo.vd`
  `io_out__bpr.vd` = t111
  io_out.vd = t111
  const t112 = `io_out__bpo.vxsat`
  `io_out__bpr.vxsat` = t112
  io_out.vxsat = t112
}
