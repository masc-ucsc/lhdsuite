const outputSelect = import("outputSelect.outputSelect")
const rndIncVecGenerator = import("rndIncVecGenerator.rndIncVecGenerator")
const vdFixPGenerator = import("vdFixPGenerator.vdFixPGenerator")
const vdNonFixPGenerator = import("vdNonFixPGenerator.vdNonFixPGenerator")
const vdRndGenerator = import("vdRndGenerator.vdRndGenerator")
const vxsatGenerator = import("vxsatGenerator.vxsatGenerator")

pub mod VIMac64bStage3::[timecheck=false](io_in:(sumFinalNonFixPS2:u152, sumFinalFixPS2:u152, highHalfS2:u1, uopIdxS2:u6, widenS2:u1, vxrmS2:u2, isFixPS2:u1, sewIs8S2:u1, sewIs16S2:u1, sewIs32S2:u1, sewIs64S2:u1)) -> (io_out:(vd:u64, vxsat:u8)@[]) {
  wire _outputMux_io_vdOut:u64
  wire _outputMux_io_vxsatOut:u8
  mut `_GEN.vd` = _outputMux_io_vdOut
  mut `_GEN.vxsat` = _outputMux_io_vxsatOut
  mut `io.in` = ((io_in.sumFinalNonFixPS2 << 0xa7) | (io_in.sumFinalFixPS2 << 15) | (io_in.highHalfS2 << 14) | (io_in.uopIdxS2 << 8) | (io_in.widenS2 << 7) | (io_in.vxrmS2 << 5) | (io_in.isFixPS2 << 4) | (io_in.sewIs8S2 << 3) | (io_in.sewIs16S2 << 2) | (io_in.sewIs32S2 << 1) | io_in.sewIs64S2)#[0..=318]
  mut `io.out` = ((`_GEN.vd` << 8) | `_GEN.vxsat`)#[0..=71]
  mut vdNonFixPGen = vdNonFixPGenerator::[name=vdNonFixPGen](io_sumFinalNonFixP = `io.in`#[167..=318], io_highHalf = (`io.in` >> 14) & 1, io_widen = (`io.in` >> 7) & 1, io_uopIdx = `io.in`#[8..=13], io_sewIs8 = (`io.in` >> 3) & 1, io_sewIs16 = (`io.in` >> 2) & 1, io_sewIs32 = (`io.in` >> 1) & 1, io_sewIs64 = `io.in` & 1)
  mut vxsatGen = vxsatGenerator::[name=vxsatGen](io_sumFinalNonFixP = `io.in`#[167..=318], io_sewIs8 = (`io.in` >> 3) & 1, io_sewIs16 = (`io.in` >> 2) & 1, io_sewIs32 = (`io.in` >> 1) & 1, io_sewIs64 = `io.in` & 1)
  mut rndIncVecGen = rndIncVecGenerator::[name=rndIncVecGen](io_sumFinalNonFixP = `io.in`#[167..=318], io_vxrm = `io.in`#[5..=6], io_sewIs8 = (`io.in` >> 3) & 1, io_sewIs16 = (`io.in` >> 2) & 1, io_sewIs32 = (`io.in` >> 1) & 1, io_sewIs64 = `io.in` & 1)
  mut vdRndGen = vdRndGenerator::[name=vdRndGen](io_sumFinalFixP = `io.in`#[15..=166], io_sewIs8 = (`io.in` >> 3) & 1, io_sewIs16 = (`io.in` >> 2) & 1, io_sewIs32 = (`io.in` >> 1) & 1, io_sewIs64 = `io.in` & 1)
  mut vdFixPGen = vdFixPGenerator::[name=vdFixPGen](io_vdRndInc = vdRndGen, io_vdSat = vxsatGen.io_vdSat, io_rndIncVec = rndIncVecGen, io_sewIs8 = (`io.in` >> 3) & 1, io_sewIs16 = (`io.in` >> 2) & 1, io_sewIs32 = (`io.in` >> 1) & 1, io_sewIs64 = `io.in` & 1)
  mut outputMux = outputSelect::[name=outputMux](io_vdNonFixP = vdNonFixPGen, io_vdFixP = vdFixPGen, io_vxsat = vxsatGen.io_vxsat, io_isFixP = (`io.in` >> 4) & 1)
  _outputMux_io_vdOut = outputMux.io_vdOut
  _outputMux_io_vxsatOut = outputMux.io_vxsatOut
  const t126 = `io.out`
  mut `io_out__bpo.vd` = t126#[8..=71]
  mut `io_out__bpo.vxsat` = t126#[0..=7]
  io_out.vd = `io_out__bpo.vd`
  io_out.vxsat = `io_out__bpo.vxsat`
}
