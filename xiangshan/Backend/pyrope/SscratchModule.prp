pub mod SscratchModule::[timecheck=false](clock:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(ALL:u64)@[]) {
  reg reg_0:u64
  mut `wdata.ALL` = w.wdata#[0..=63]
  mut _mux_1:u64 = if w.wen != 0 { `wdata.ALL`#[0..=63] } else { reg_0 }
  reg_0 = _mux_1
  mut `regOut__bpo.ALL` = reg_0
  regOut.ALL = `regOut__bpo.ALL`
  rdata = reg_0
}
