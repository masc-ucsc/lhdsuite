pub mod Mhpmcounter4Module::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), mcountinhibit:(CY:u1, IR:u1, HPM3:u29), countingEn:u1, perf:(value:u6), fromSireg:(valid:u1, bits:u64)) -> (rdata:u64@[], regOut:(ALL:u64)@[], toMhpmeventOF:u1@[], toSireg:u64@[]) {
  reg reg_0:u64:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  const countingInhibit__w1 = (((mcountinhibit.HPM3 >> 1) & 1) | ((~countingEn) & 1)) & 1
  const counterAdd__w1 = (reg_0 + perf.value#[0..=5])#[0..=64]
  mut `wdata.ALL` = w.wdata#[0..=63]
  mut _mux_2:u64 = if (unsigned(perf.value != 0) & (~countingInhibit__w1) & 1 & 1) != 0 { counterAdd__w1#[0..=63] } else { reg_0 }
  mut _mux_3:u64 = if fromSireg.valid != 0 { fromSireg.bits#[0..=63] } else { _mux_2 }
  mut _mux_4:u64 = if w.wen != 0 { w.wdata#[0..=63] } else { _mux_3 }
  reg_0 = _mux_4
  mut `regOut__bpo.ALL` = reg_0
  regOut.ALL = `regOut__bpo.ALL`
  rdata = reg_0
  toMhpmeventOF = (~countingInhibit__w1) & 1 & (counterAdd__w1 >> 0x40) & 1 & 1
  toSireg = reg_0
}
