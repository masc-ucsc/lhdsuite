pub mod MiselectModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(ALL:u9)@[], inIMSICRange:u1@[]) {
  reg reg_0:u9:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  const value__w1 = reg_0
  mut `wdata.ALL` = w.wdata#[0..=8]
  mut _mux_1:u9 = if (w.wen & (~((`wdata.ALL` >> 8) & 1)) & 1 & 1) != 0 { `wdata.ALL`#[0..=8] } else { value__w1 }
  reg_0 = _mux_1
  mut `regOut__bpo.ALL` = reg_0
  regOut.ALL = `regOut__bpo.ALL`
  rdata = reg_0
  inIMSICRange = unsigned(value__w1 > 0x6f) & (~((value__w1 >> 8) & 1)) & 1 & 1
}
