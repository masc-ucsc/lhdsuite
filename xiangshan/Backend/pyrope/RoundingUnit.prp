pub comb RoundingUnit::[timecheck=false](io_in:U64, io_roundIn:U1, io_stickyIn:U1, io_signIn:U1, io_rm:U3) -> (io_inexact:U1, io_r_up:U1) {
  wire io:(`in`:U64, roundIn:U1, stickyIn:U1, signIn:U1, rm:U3, inexact:U1, r_up:U1) = nil
  wire g:U1 = nil
  wire inexact:U1 = nil
  wire _r_up_T_16:U1 = nil
  wire _r_up_T_18:U1 = nil
  wire _r_up_T_20:U1 = nil
  wire r_up:U1 = nil
  g = io.`in` & 1
  inexact = (io.roundIn | io.stickyIn) & 1
  mut _mux_3:U1 = if io.rm == 3 { inexact & (~io.signIn#[0]) & 1 } else { U1(io.rm != 1) & U1(io.rm == 0) & 1 & ((io.roundIn & io.stickyIn & 1) | (io.roundIn & (~io.stickyIn#[0]) & 1 & g & 1)) & 1 & 1 }
  _r_up_T_16 = _mux_3
  mut _mux_4:U1 = if io.rm == 2 { inexact & io.signIn & 1 } else { _r_up_T_16 & 1 }
  _r_up_T_18 = _mux_4
  mut _mux_5:U1 = if io.rm == 4 { io.roundIn & 1 } else { _r_up_T_18 & 1 }
  _r_up_T_20 = _mux_5
  mut _mux_6:U1 = if io.rm == 6 { inexact & (~g) & 1 } else { _r_up_T_20 & 1 }
  r_up = _mux_6
  io.`in` = io_in#[0..<0x40]
  io.roundIn = io_roundIn & 1
  io.stickyIn = io_stickyIn & 1
  io.signIn = io_signIn & 1
  io.rm = io_rm#[0..<3]
  io.inexact = inexact & 1
  io.r_up = r_up & 1
  io_inexact = io.inexact
  io_r_up = io.r_up
}
