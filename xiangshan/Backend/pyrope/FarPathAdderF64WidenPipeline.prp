pub mod FarPathAdderF64WidenPipeline::[timecheck=false](`clock`:Clock, io_fire:U1, io_A:U54, io_B:U54) -> (io_result:U54@[]) {
  reg io_result_r:U54
  reg io_result_r_1:U54
  mut `io.fire` = io_fire & 1
  mut `io.A` = io_A#[0..<54]
  mut `io.B` = io_B#[0..<54]
  mut `io.result` = (io_result_r + io_result_r_1)#[0..<54]
  if `io.fire` != 0 {
    io_result_r = `io.A`
  }
  if `io.fire` != 0 {
    io_result_r_1 = `io.B`
  }
  io_result = `io.result`
}
