pub mod Iprio4Module_1::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), sie:(SSIE:U1, VSSIE:U1, MSIE:U1, STIE:U1, VSTIE:U1, MTIE:U1, SEIE:U1, VSEIE:U1, MEIE:U1, SGEIE:U1, LCOFIE:U1, LC14IE:U1, LC15IE:U1, LC16IE:U1, LC17IE:U1, LC18IE:U1, LC19IE:U1, LC20IE:U1, LC21IE:U1, LC22IE:U1, LC23IE:U1, LC24IE:U1, LC25IE:U1, LC26IE:U1, LC27IE:U1, LC28IE:U1, LC29IE:U1, LC30IE:U1, LC31IE:U1, LC32IE:U1, LC33IE:U1, LC34IE:U1, LPRASEIE:U1, LC36IE:U1, LC37IE:U1, LC38IE:U1, LC39IE:U1, LC40IE:U1, LC41IE:U1, LC42IE:U1, HPRASEIE:U1, LC44IE:U1, LC45IE:U1, LC46IE:U1, LC47IE:U1, LC48IE:U1, LC49IE:U1, LC50IE:U1, LC51IE:U1, LC52IE:U1, LC53IE:U1, LC54IE:U1, LC55IE:U1, LC56IE:U1, LC57IE:U1, LC58IE:U1, LC59IE:U1, LC60IE:U1, LC61IE:U1, LC62IE:U1, LC63IE:U1)) -> (rdata:U64@[]) {
  mut _mux_9:U64 = 0
  mut t56 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN_0:U64
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..<0x40]
  mut _rep_1:U8 = if (sie.LC23IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_2:U8 = if (sie.LC22IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_3:U8 = if (sie.LC21IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_4:U8 = if (sie.LC20IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_5:U8 = if (sie.LC19IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_6:U8 = if (sie.LC18IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_7:U8 = if (sie.LC17IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_8:U8 = if (sie.LC16IE & 1) != 0 { 0xff } else { 0 }
  t56 = _GEN_0
  if not (`reset` != 0) {
    _mux_9 = if w.wen != 0 { `wdata.ALL`#[0..<0x40] } else { reg_0#[0..<0x40] }
    t56 = _mux_9
    reg_0 = t56
  }
  _GEN_0 = t56
  rdata = (reg_0#[0..<0x40] & ((_rep_1#[0..<8] << 56) | (_rep_2#[0..<8] << 48) | (_rep_3#[0..<8] << 40) | (_rep_4#[0..<8] << 32) | (_rep_5#[0..<8] << 24) | (_rep_6#[0..<8] << 16) | (_rep_7#[0..<8] << 8) | _rep_8#[0..<8]))#[0..<0x40]
}
