pub mod Mhpmcounter20Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), mcountinhibit:(CY:U1, IR:U1, HPM3:U29), countingEn:U1, perf:(value:U6), fromSireg:(valid:U1, bits:U64)) -> (rdata:U64@[], regOut:(ALL:U64)@[], toMhpmeventOF:U1@[], toSireg:U64@[]) {
  mut _mux_2:U64 = 0
  mut _mux_3:U64 = 0
  mut _mux_4:U64 = 0
  mut t20 = 0
  mut t21 = 0
  mut t22 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U64
  reg _GEN_0:U64
  reg _GEN_1:U64
  wire `regOut__bpr.ALL`:U64 = nil
  mut `reg_init.ALL` = 0
  const countingInhibit__w1 = (mcountinhibit.HPM3#[17..<18] | (~countingEn)) & 1
  const counterAdd__w1 = (reg_0#[0..<0x40] + perf.value#[0..<6])#[0..<0x41]
  mut `wdata.ALL` = w.wdata#[0..<0x40]
  t20 = _GEN
  t21 = _GEN_0
  t22 = _GEN_1
  if not (`reset` != 0) {
    _mux_2 = if (U1(perf.value != 0) & (~countingInhibit__w1#[0]) & 1) != 0 { counterAdd__w1#[0..<0x40] } else { reg_0#[0..<0x40] }
    t20 = _mux_2
    _mux_3 = if fromSireg.valid != 0 { fromSireg.bits#[0..<0x40] } else { t20#[0..<0x40] }
    t21 = _mux_3
    _mux_4 = if w.wen != 0 { w.wdata#[0..<0x40] } else { t21#[0..<0x40] }
    t22 = _mux_4
    reg_0 = t22
  }
  _GEN = t20
  _GEN_0 = t21
  _GEN_1 = t22
  mut `regOut__bpo.ALL` = reg_0#[0..<0x40]
  const t48 = `regOut__bpo.ALL`
  `regOut__bpr.ALL` = t48
  regOut.ALL = t48
  rdata = reg_0#[0..<0x40]
  toMhpmeventOF = (~countingInhibit__w1#[0]) & counterAdd__w1#[0x40..<0x41] & 1
  toSireg = reg_0#[0..<0x40]
}
