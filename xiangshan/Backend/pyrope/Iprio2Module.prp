  mut `wdata.Prio15` = w.wdata#[56..<0x40]
  mut _rep_1:U8 = if (mie.LCOFIE & 1) != 0 { 0xff } else { 0 }
  mut _rep_2:U8 = if (mie.SGEIE & 1) != 0 { 0xff } else { 0 }
  mut _rep_3:U8 = if (mie.MEIE & 1) != 0 { 0xff } else { 0 }
