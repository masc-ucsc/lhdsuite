pub mod Iprio2Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), mie:(SSIE:U1, VSSIE:U1, MSIE:U1, STIE:U1, VSTIE:U1, MTIE:U1, SEIE:U1, VSEIE:U1, MEIE:U1, SGEIE:U1, LCOFIE:U1, LC14IE:U1, LC15IE:U1, LC16IE:U1, LC17IE:U1, LC18IE:U1, LC19IE:U1, LC20IE:U1, LC21IE:U1, LC22IE:U1, LC23IE:U1, LC24IE:U1, LC25IE:U1, LC26IE:U1, LC27IE:U1, LC28IE:U1, LC29IE:U1, LC30IE:U1, LC31IE:U1, LC32IE:U1, LC33IE:U1, LC34IE:U1, LPRASEIE:U1, LC36IE:U1, LC37IE:U1, LC38IE:U1, LC39IE:U1, LC40IE:U1, LC41IE:U1, LC42IE:U1, HPRASEIE:U1, LC44IE:U1, LC45IE:U1, LC46IE:U1, LC47IE:U1, LC48IE:U1, LC49IE:U1, LC50IE:U1, LC51IE:U1, LC52IE:U1, LC53IE:U1, LC54IE:U1, LC55IE:U1, LC56IE:U1, LC57IE:U1, LC58IE:U1, LC59IE:U1, LC60IE:U1, LC61IE:U1, LC62IE:U1, LC63IE:U1)) -> (rdata:U64@[]) {
