  const _regOut_PrioMEI_WIRE_1__w1 = (reg_0#[32..<40] & mask__w1#[24..<32])#[0..<8]
  const _regOut_PrioVSEI_WIRE_1__w1 = (reg_0#[40..<48] & mask__w1#[16..<24])#[0..<8]
