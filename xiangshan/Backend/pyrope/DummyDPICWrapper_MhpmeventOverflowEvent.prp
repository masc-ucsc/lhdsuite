const DiffExtMhpmeventOverflowEvent = import("DiffExtMhpmeventOverflowEvent.DiffExtMhpmeventOverflowEvent")

pub mod DummyDPICWrapper_MhpmeventOverflowEvent::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(valid:u1, mhpmeventOverflow:u64, coreid:u8))) -> () {
  mut dpic = DiffExtMhpmeventOverflowEvent::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x49) | (io.bits.valid << 0x48) | (io.bits.mhpmeventOverflow << 8) | io.bits.coreid)#[0..=72])
}
