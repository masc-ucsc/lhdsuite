pub comb RotateLeftShiftWordModule::[timecheck=false](io_shamt:u5, io_rolwSrc:u32) -> (io_rolw:u64) {
  wire io:(shamt:u5, rolwSrc:u32, rolw:u64) = nil
  mut _mux_1:u32 = if ((io.shamt >> 4) & 1) != 0 { (io.rolwSrc#[0..=15] << 16) | io.rolwSrc#[16..=31] } else { io.rolwSrc#[0..=31] }
  const io_rolw_shifted_shifted__w1 = _mux_1
  mut _mux_2:u32 = if ((io.shamt >> 3) & 1) != 0 { (io_rolw_shifted_shifted__w1#[0..=23] << 8) | io_rolw_shifted_shifted__w1#[24..=31] } else { io_rolw_shifted_shifted__w1 }
  const io_rolw_shifted_shifted_1__w1 = _mux_2
  mut _mux_3:u32 = if ((io.shamt >> 2) & 1) != 0 { (io_rolw_shifted_shifted_1__w1#[0..=27] << 4) | io_rolw_shifted_shifted_1__w1#[28..=31] } else { io_rolw_shifted_shifted_1__w1 }
  const io_rolw_shifted_shifted_2__w1 = _mux_3
  mut _mux_4:u32 = if ((io.shamt >> 1) & 1) != 0 { (io_rolw_shifted_shifted_2__w1#[0..=29] << 2) | io_rolw_shifted_shifted_2__w1#[30..=31] } else { io_rolw_shifted_shifted_2__w1 }
  const io_rolw_shifted_shifted_3__w1 = _mux_4
  mut _mux_5:u32 = if (io.shamt & 1) != 0 { (io_rolw_shifted_shifted_3__w1#[0..=30] << 1) | ((io_rolw_shifted_shifted_3__w1 >> 31) & 1) } else { io_rolw_shifted_shifted_3__w1 }
  io.shamt = io_shamt
  io.rolwSrc = io_rolwSrc
  io.rolw = _mux_5#sext[0..=31]#[0..=63]
  io_rolw = io.rolw
}
