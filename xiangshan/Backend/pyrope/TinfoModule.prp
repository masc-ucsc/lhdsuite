pub mod TinfoModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(VERSION:u8, MCONTROL6EN:u1)@[]) {
  reg reg_0:u9:[init=3, reset_pin=ref reset, async=true]
  mut `reg_init.VERSION` = 0
  mut `reg_init.MCONTROL6EN` = 0
  mut `wdata.VERSION` = w.wdata#[24..=31]
  mut `wdata.MCONTROL6EN` = (w.wdata >> 6) & 1
  mut `regOut__bpo.VERSION` = reg_0#[1..=8]
  mut `regOut__bpo.MCONTROL6EN` = reg_0 & 1
  regOut.VERSION = `regOut__bpo.VERSION`
  regOut.MCONTROL6EN = `regOut__bpo.MCONTROL6EN`
  rdata = (reg_0#[1..=8] << 24) | ((reg_0 & 1) << 6)
}
