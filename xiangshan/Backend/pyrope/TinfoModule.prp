pub mod TinfoModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(VERSION:U8, MCONTROL6EN:U1)@[]) {
  reg reg_0:U9:[initial=3, reset_pin=`reset`, async=true]
  wire `regOut__bpr.VERSION`:U8 = nil
  wire `regOut__bpr.MCONTROL6EN`:U1 = nil
  mut `reg_init.VERSION` = 1
  mut `reg_init.MCONTROL6EN` = 1
  mut `wdata.VERSION` = w.wdata#[24..<32]
  mut `wdata.MCONTROL6EN` = w.wdata#[6..<7]
  if not (`reset` != 0) {
  }
  mut `regOut__bpo.VERSION` = reg_0#[1..<9]
  mut `regOut__bpo.MCONTROL6EN` = reg_0 & 1
  const t18 = `regOut__bpo.VERSION`
  `regOut__bpr.VERSION` = t18
  regOut.VERSION = t18
  const t19 = `regOut__bpo.MCONTROL6EN`
  `regOut__bpr.MCONTROL6EN` = t19
  regOut.MCONTROL6EN = t19
  rdata = (reg_0#[1..<9] << 24) | ((reg_0 & 1) << 6)
}
