pub mod MinstretModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), mcountinhibit:(CY:u1, IR:u1, HPM3:u29), robCommit:(instNum:(valid:u1, bits:u7), fflags:(valid:u1, bits:u5), fsDirty:u1, vxsat:(valid:u1, bits:u1), vsDirty:u1, vtype:(valid:u1, bits:(VILL:u1, VMA:u1, VTA:u1, VSEW:u3, VLMUL:u3)), vl:u8, vstart:(valid:u1, bits:u7)), countingEn:u1, fromSireg:(valid:u1, bits:u64)) -> (rdata:u64@[], regOut:(ALL:u64)@[], toSireg:u64@[]) {
  reg reg_0:u64:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..=63]
  mut _mux_1:u64 = if ((~mcountinhibit.IR) & 1 & robCommit.instNum.valid & 1 & countingEn & 1) != 0 { (reg_0 + robCommit.instNum.bits#[0..=6])#[0..=63] } else { reg_0 }
  mut _mux_2:u64 = if fromSireg.valid != 0 { fromSireg.bits#[0..=63] } else { _mux_1 }
  mut _mux_3:u64 = if w.wen != 0 { w.wdata#[0..=63] } else { _mux_2 }
  reg_0 = _mux_3
  mut `regOut__bpo.ALL` = reg_0
  regOut.ALL = `regOut__bpo.ALL`
  rdata = reg_0
  toSireg = reg_0
}
