pub mod HgatpModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(MODE:u4, VMID:u14, PPN:u44)@[]) {
  reg reg_0:u62:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.MODE` = 0
  mut `reg_init.VMID` = 0
  mut `reg_init.PPN` = 0
  mut `wdata.MODE` = w.wdata#[60..=63]
  mut `wdata.VMID` = w.wdata#[44..=57]
  mut `wdata.PPN` = w.wdata#[0..=43]
  mut _mux_1:u44 = if w.wen != 0 { `wdata.PPN`#[2..=35] << 2 } else { reg_0#[0..=43] }
  mut _mux_2:u14 = if w.wen != 0 { `wdata.VMID`#[0..=13] } else { reg_0#[44..=57] }
  mut _mux_6:u4 = if (w.wen & (((unsigned(`wdata.MODE` == 0) | unsigned(`wdata.MODE` == 8)) & 1) | unsigned(`wdata.MODE` == 9)) & 1 & 1) != 0 { `wdata.MODE`#[0..=3] } else { reg_0#[58..=61] }
  reg_0 = _mux_1 | (_mux_2 << 44) | (_mux_6 << 58)
  mut `regOut__bpo.MODE` = reg_0#[58..=61]
  mut `regOut__bpo.VMID` = reg_0#[44..=57]
  mut `regOut__bpo.PPN` = reg_0#[0..=43]
  regOut.MODE = `regOut__bpo.MODE`
  regOut.VMID = `regOut__bpo.VMID`
  regOut.PPN = `regOut__bpo.PPN`
  rdata = (reg_0#[58..=61] << 60) | (reg_0#[44..=57] << 44) | reg_0#[0..=43]
}
