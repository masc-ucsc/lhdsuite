pub mod HgatpModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(MODE:U4, VMID:U14, PPN:U44)@[]) {
  mut _mux_1:U44 = 0
  mut _mux_2:U14 = 0
  mut _mux_6:U4 = 0
  mut t18 = 0
  mut t19 = 0
  mut t20 = 0
  reg reg_0:U62:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U44
  reg _GEN_0:U14
  reg _GEN_1:U4
  wire `regOut__bpr.MODE`:U4 = nil
  wire `regOut__bpr.VMID`:U14 = nil
  wire `regOut__bpr.PPN`:U44 = nil
  mut `reg_init.MODE` = 0
  mut `reg_init.VMID` = 0
  mut `reg_init.PPN` = 0
  mut `wdata.MODE` = w.wdata#[60..<0x40]
  mut `wdata.VMID` = w.wdata#[44..<58]
  mut `wdata.PPN` = w.wdata#[0..<44]
  t18 = _GEN
  t19 = _GEN_0
  t20 = _GEN_1
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.PPN`#[2..<36] << 2 } else { reg_0#[0..<44] }
    t18 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.VMID`#[0..<14] } else { reg_0#[44..<58] }
    t19 = _mux_2
    _mux_6 = if (w.wen & (((U1(`wdata.MODE` == 0) | U1(`wdata.MODE` == 8)) & 1) | U1(`wdata.MODE` == 9)) & 1 & 1) != 0 { `wdata.MODE`#[0..<4] } else { reg_0#[58..<62] }
    t20 = _mux_6
    reg_0 = t18 | (t19 << 44) | (t20 << 58)
  }
  _GEN = t18
  _GEN_0 = t19
  _GEN_1 = t20
  mut `regOut__bpo.MODE` = reg_0#[58..<62]
  mut `regOut__bpo.VMID` = reg_0#[44..<58]
  mut `regOut__bpo.PPN` = reg_0#[0..<44]
  const t60 = `regOut__bpo.MODE`
  `regOut__bpr.MODE` = t60
  regOut.MODE = t60
  const t61 = `regOut__bpo.VMID`
  `regOut__bpr.VMID` = t61
  regOut.VMID = t61
  const t62 = `regOut__bpo.PPN`
  `regOut__bpr.PPN` = t62
  regOut.PPN = t62
  rdata = (reg_0#[58..<62] << 60) | (reg_0#[44..<58] << 44) | reg_0#[0..<44]
}
