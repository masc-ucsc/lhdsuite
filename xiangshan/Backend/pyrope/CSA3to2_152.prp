pub comb CSA3to2_152::[timecheck=false](io_in_a:U8, io_in_b:U8, io_in_c:U8) -> (io_out_sum:U8, io_out_car:U8) {
  mut `io.in_a` = io_in_a#[0..<8]
  mut `io.in_b` = io_in_b#[0..<8]
  mut `io.in_c` = io_in_c#[0..<8]
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..<8] ^ `io.in_c`)#[0..<8]
  mut `io.out_car` = (((`io.in_a`#[0..<7] & `io.in_b`#[0..<7])#[0..<7] | (`io.in_a`#[0..<7] & `io.in_c`#[0..<7])#[0..<7])#[0..<7] | (`io.in_b`#[0..<7] & `io.in_c`#[0..<7])#[0..<7])#[0..<7] << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
