pub comb CSA3to2_152::[timecheck=false](io_in_a:u8, io_in_b:u8, io_in_c:u8) -> (io_out_sum:u8, io_out_car:u8) {
  mut `io.in_a` = io_in_a
  mut `io.in_b` = io_in_b
  mut `io.in_c` = io_in_c
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..=7] ^ `io.in_c`)#[0..=7]
  mut `io.out_car` = (((`io.in_a`#[0..=6] & `io.in_b`#[0..=6]) | (`io.in_a`#[0..=6] & `io.in_c`#[0..=6])) | (`io.in_b`#[0..=6] & `io.in_c`#[0..=6])) << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
