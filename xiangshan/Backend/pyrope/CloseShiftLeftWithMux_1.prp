pub comb CloseShiftLeftWithMux_1::[timecheck=false](io_src:u25, io_shiftValue:u5) -> (io_result:u25) {
  wire io:(src:u25, shiftValue:u5, result:u25) = nil
  wire io_result_res_vec:u150
  mut _mux_1:u25 = if ((io.shiftValue >> 4) & 1) != 0 { io_result_res_vec#[0..=24]#[0..=8] << 16 } else { io_result_res_vec#[0..=24] }
  mut _mux_2:u25 = if ((io.shiftValue >> 3) & 1) != 0 { io_result_res_vec#[25..=49]#[0..=16] << 8 } else { io_result_res_vec#[25..=49] }
  mut _mux_3:u25 = if ((io.shiftValue >> 2) & 1) != 0 { io_result_res_vec#[50..=74]#[0..=20] << 4 } else { io_result_res_vec#[50..=74] }
  mut _mux_4:u25 = if ((io.shiftValue >> 1) & 1) != 0 { io_result_res_vec#[75..=99]#[0..=22] << 2 } else { io_result_res_vec#[75..=99] }
  mut _mux_5:u25 = if (io.shiftValue & 1) != 0 { io_result_res_vec#[100..=124]#[0..=23] << 1 } else { io_result_res_vec#[100..=124] }
  io_result_res_vec = (_mux_5 << 125) | (_mux_4 << 100) | (_mux_3 << 75) | (_mux_2 << 50) | (_mux_1 << 25) | io.src#[0..=24]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec#[125..=149]
  io_result = io.result
}
