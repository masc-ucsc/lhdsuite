pub comb CloseShiftLeftWithMux_1::[timecheck=false](io_src:u25, io_shiftValue:u5) -> (io_result:u25) {
  wire io:(src:u25, shiftValue:u5, result:u25) = nil
  wire io_result_res_vec:(e5:u25, e4:u25, e3:u25, e2:u25, e1:u25, e0:u25) = nil
  mut _mux_1:u25 = if ((io.shiftValue >> 4) & 1) != 0 { io_result_res_vec.e0#[0..=8] << 16 } else { io_result_res_vec.e0#[0..=24] }
  mut _mux_2:u25 = if ((io.shiftValue >> 3) & 1) != 0 { io_result_res_vec.e1#[0..=16] << 8 } else { io_result_res_vec.e1#[0..=24] }
  mut _mux_3:u25 = if ((io.shiftValue >> 2) & 1) != 0 { io_result_res_vec.e2#[0..=20] << 4 } else { io_result_res_vec.e2#[0..=24] }
  mut _mux_4:u25 = if ((io.shiftValue >> 1) & 1) != 0 { io_result_res_vec.e3#[0..=22] << 2 } else { io_result_res_vec.e3#[0..=24] }
  mut _mux_5:u25 = if (io.shiftValue & 1) != 0 { io_result_res_vec.e4#[0..=23] << 1 } else { io_result_res_vec.e4#[0..=24] }
  io_result_res_vec.e5 = _mux_5
  io_result_res_vec.e4 = _mux_4
  io_result_res_vec.e3 = _mux_3
  io_result_res_vec.e2 = _mux_2
  io_result_res_vec.e1 = _mux_1
  io_result_res_vec.e0 = io.src#[0..=24]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec.e5#[0..=24]
  io_result = io.result
}
