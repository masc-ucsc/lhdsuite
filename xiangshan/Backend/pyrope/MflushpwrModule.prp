pub mod MflushpwrModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), l2FlushDone:U1) -> (rdata:U64@[], regOut:(FLUSH_L2_ENABLE:U1, L2_FLUSH_DONE:U1)@[]) {
  mut _mux_1:U1 = 0
  mut t13 = 0
  reg reg_0:U2:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U1
  wire `regOut__bpr.FLUSH_L2_ENABLE`:U1 = nil
  wire `regOut__bpr.L2_FLUSH_DONE`:U1 = nil
  mut `reg_init.FLUSH_L2_ENABLE` = 0
  mut `reg_init.L2_FLUSH_DONE` = 0
  mut `wdata.FLUSH_L2_ENABLE` = w.wdata & 1
  mut `wdata.L2_FLUSH_DONE` = w.wdata#[1..<2]
  t13 = _GEN
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.FLUSH_L2_ENABLE` & 1 } else { reg_0#[1..<2] }
    t13 = _mux_1
    reg_0 = (reg_0 & 1) | (t13 << 1)
  }
  _GEN = t13
  const t27 = l2FlushDone | (reg_0#[1..<2] << 1)
  mut `regOut__bpo.FLUSH_L2_ENABLE` = t27#[1..<2]
  mut `regOut__bpo.L2_FLUSH_DONE` = t27 & 1
  const t30 = `regOut__bpo.FLUSH_L2_ENABLE`
  `regOut__bpr.FLUSH_L2_ENABLE` = t30
  regOut.FLUSH_L2_ENABLE = t30
  const t31 = `regOut__bpo.L2_FLUSH_DONE`
  `regOut__bpr.L2_FLUSH_DONE` = t31
  regOut.L2_FLUSH_DONE = t31
  rdata = ((l2FlushDone & 1) << 1) | reg_0#[1..<2]
}
