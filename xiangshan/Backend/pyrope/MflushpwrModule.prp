pub mod MflushpwrModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), l2FlushDone:u1) -> (rdata:u64@[], regOut:(FLUSH_L2_ENABLE:u1, L2_FLUSH_DONE:u1)@[]) {
  reg reg_0:u2:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.FLUSH_L2_ENABLE` = 0
  mut `reg_init.L2_FLUSH_DONE` = 0
  mut `wdata.FLUSH_L2_ENABLE` = w.wdata & 1
  mut `wdata.L2_FLUSH_DONE` = (w.wdata >> 1) & 1
  mut _mux_1:u1 = if w.wen != 0 { `wdata.FLUSH_L2_ENABLE` & 1 } else { (reg_0 >> 1) & 1 }
  reg_0 = (reg_0 & 1) | (_mux_1 << 1)
  const t28 = l2FlushDone | (((reg_0 >> 1) & 1) << 1)
  mut `regOut__bpo.FLUSH_L2_ENABLE` = (t28 >> 1) & 1
  mut `regOut__bpo.L2_FLUSH_DONE` = t28 & 1
  regOut.FLUSH_L2_ENABLE = `regOut__bpo.FLUSH_L2_ENABLE`
  regOut.L2_FLUSH_DONE = `regOut__bpo.L2_FLUSH_DONE`
  rdata = ((l2FlushDone & 1) << 1) | ((reg_0 >> 1) & 1)
}
