pub comb ImmExtractor_12::[timecheck=false](io_in:(imm:u32, immType:u4)) -> (io_out:(imm:u64)) {
  wire io:(`in`:u36, out:u64) = nil
  const io_out_imm_signBit__w1 = (io.`in`#[4..=35] >> 11) & 1
  mut _rep_1:u32 = if (io_out_imm_signBit__w1 & 1) != 0 { 0xffffffff } else { 0 }
  mut _rep_2:u20 = if (io_out_imm_signBit__w1 & 1) != 0 { 0xfffff } else { 0 }
  mut `_GEN.imm` = (_rep_1 << 32) | (_rep_2 << 12) | io.`in`#[4..=35]#[0..=11]
  io.`in` = ((io_in.imm << 4) | io_in.immType)#[0..=35]
  io.out = `_GEN.imm`#[0..=63]
  mut `io_out__bpo.imm` = io.out#[0..=63]
  io_out.imm = `io_out__bpo.imm`
}
