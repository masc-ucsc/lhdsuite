pub comb Adder_xb::[timecheck=false](io_in1:u64, io_in2:u64, io_cin:u1) -> (io_cout:u1) {
  wire io:(in1:u64, in2:u64, cin:u1, cout:u1) = nil
  const bits__w1 = (((io.in1#[0..=63] << 1) | (io.cin & 1)) + ((io.in2#[0..=63] << 1) | (io.cin & 1)))#[0..=65]
  io.in1 = io_in1
  io.in2 = io_in2
  io.cin = io_cin & 1
  io.cout = (bits__w1 >> 0x41) & 1
  io_cout = io.cout
}
