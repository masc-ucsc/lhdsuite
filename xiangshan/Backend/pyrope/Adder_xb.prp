pub comb Adder_xb::[timecheck=false](io_in1:U64, io_in2:U64, io_cin:U1) -> (io_cout:U1) {
  wire io:(in1:U64, in2:U64, cin:U1, cout:U1) = nil
  wire bits:U66 = nil
  bits = (((io.in1#[0..<0x40] << 1) | (io.cin & 1)) + ((io.in2#[0..<0x40] << 1) | (io.cin & 1)))#[0..<0x42]
  io.in1 = io_in1#[0..<0x40]
  io.in2 = io_in2#[0..<0x40]
  io.cin = io_cin & 1
  io.cout = bits#[0x41..<0x42]
  io_cout = io.cout
}
