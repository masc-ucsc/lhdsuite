pub comb vdFixPGenerator::[timecheck=false](io_vdRndInc:u64, io_vdSat:u64, io_rndIncVec:u8, io_sewIs8:u1, io_sewIs16:u1, io_sewIs32:u1, io_sewIs64:u1) -> (io_vdFixP:u64) {
  wire io:(vdRndInc:u64, vdSat:u64, rndIncVec:u8, sewIs8:u1, sewIs16:u1, sewIs32:u1, sewIs64:u1, vdFixP:u64) = nil
  mut _mux_1:u8 = if ((io.rndIncVec >> 7) & 1) != 0 { io.vdRndInc#[56..=63] } else { io.vdSat#[56..=63] }
  mut _mux_2:u8 = if ((io.rndIncVec >> 6) & 1) != 0 { io.vdRndInc#[48..=55] } else { io.vdSat#[48..=55] }
  mut _mux_3:u8 = if ((io.rndIncVec >> 5) & 1) != 0 { io.vdRndInc#[40..=47] } else { io.vdSat#[40..=47] }
  mut _mux_4:u8 = if ((io.rndIncVec >> 4) & 1) != 0 { io.vdRndInc#[32..=39] } else { io.vdSat#[32..=39] }
  mut _mux_5:u8 = if ((io.rndIncVec >> 3) & 1) != 0 { io.vdRndInc#[24..=31] } else { io.vdSat#[24..=31] }
  mut _mux_6:u8 = if ((io.rndIncVec >> 2) & 1) != 0 { io.vdRndInc#[16..=23] } else { io.vdSat#[16..=23] }
  mut _mux_7:u8 = if ((io.rndIncVec >> 1) & 1) != 0 { io.vdRndInc#[8..=15] } else { io.vdSat#[8..=15] }
  mut _mux_8:u8 = if (io.rndIncVec & 1) != 0 { io.vdRndInc#[0..=7] } else { io.vdSat#[0..=7] }
  io.vdRndInc = io_vdRndInc
  io.vdSat = io_vdSat
  io.rndIncVec = io_rndIncVec
  io.sewIs8 = io_sewIs8 & 1
  io.sewIs16 = io_sewIs16 & 1
  io.sewIs32 = io_sewIs32 & 1
  io.sewIs64 = io_sewIs64 & 1
  io.vdFixP = (_mux_1 << 56) | (_mux_2 << 48) | (_mux_3 << 40) | (_mux_4 << 32) | (_mux_5 << 24) | (_mux_6 << 16) | (_mux_7 << 8) | _mux_8
  io_vdFixP = io.vdFixP
}
