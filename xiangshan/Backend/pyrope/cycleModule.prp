pub mod cycleModule::[timecheck=false](`clock`:Clock, w:(wen:U1, wdata:U64), mHPM:(cycle:U64, time_0:(valid:U1, bits:U64), instret:U64, hpmcounters:U1856), debugModeStopCount:U1, unprivCountUpdate:U1) -> (rdata:U64@[]) {
  reg reg_0:U64
  mut `wdata.cycle` = w.wdata#[0..<0x40]
  mut _mux_1:U64 = if unprivCountUpdate != 0 { mHPM.cycle#[0..<0x40] } else { reg_0#[0..<0x40] }
  reg_0 = _mux_1
  mut _mux_2:U64 = if debugModeStopCount != 0 { reg_0#[0..<0x40] } else { mHPM.cycle#[0..<0x40] }
  rdata = _mux_2
}
