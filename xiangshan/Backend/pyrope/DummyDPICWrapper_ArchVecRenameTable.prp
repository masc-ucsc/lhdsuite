const DiffExtArchVecRenameTable = import("DiffExtArchVecRenameTable.DiffExtArchVecRenameTable")

pub mod DummyDPICWrapper_ArchVecRenameTable::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(value:u576, coreid:u8))) -> () {
  mut dpic = DiffExtArchVecRenameTable::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x248) | (io.bits.value << 8) | io.bits.coreid)#[0..=583])
}
