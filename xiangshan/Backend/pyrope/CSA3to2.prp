pub comb CSA3to2::[timecheck=false](io_in_a:U107, io_in_b:U107, io_in_c:U107) -> (io_out_sum:U107, io_out_car:U107) {
  mut `io.in_a` = io_in_a#[0..<0x6b]
  mut `io.in_b` = io_in_b#[0..<0x6b]
  mut `io.in_c` = io_in_c#[0..<0x6b]
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..<0x6b] ^ `io.in_c`)#[0..<0x6b]
  mut `io.out_car` = (((`io.in_a`#[0..<0x6a] & `io.in_b`#[0..<0x6a])#[0..<0x6a] | (`io.in_a`#[0..<0x6a] & `io.in_c`#[0..<0x6a])#[0..<0x6a])#[0..<0x6a] | (`io.in_b`#[0..<0x6a] & `io.in_c`#[0..<0x6a])#[0..<0x6a])#[0..<0x6a] << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
