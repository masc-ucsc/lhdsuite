pub comb CSA3to2::[timecheck=false](io_in_a:u107, io_in_b:u107, io_in_c:u107) -> (io_out_sum:u107, io_out_car:u107) {
  mut `io.in_a` = io_in_a
  mut `io.in_b` = io_in_b
  mut `io.in_c` = io_in_c
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..=106] ^ `io.in_c`)#[0..=106]
  mut `io.out_car` = (((`io.in_a`#[0..=105] & `io.in_b`#[0..=105]) | (`io.in_a`#[0..=105] & `io.in_c`#[0..=105])) | (`io.in_b`#[0..=105] & `io.in_c`#[0..=105])) << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
