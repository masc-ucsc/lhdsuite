pub comb r4_qds::[timecheck=false](rem_i:u7, m_neg_1_i:u7, m_neg_0_i:u7, m_pos_1_i:u7, m_pos_2_i:u7) -> (rt_dig_o:u5) {
  const qds_sign__w1 = ((((rem_i + m_pos_2_i)#[0..=6] >> 6) & 1) << 3) | ((((rem_i + m_pos_1_i)#[0..=6] >> 6) & 1) << 2) | ((((rem_i + m_neg_0_i)#[0..=6] >> 6) & 1) << 1) | (((rem_i + m_neg_1_i)#[0..=6] >> 6) & 1)
  rt_dig_o = ((unsigned(qds_sign__w1#[0..=1] == 3) & 1) << 4) | ((unsigned(qds_sign__w1#[0..=1] == 2) & 1) << 3) | ((unsigned(qds_sign__w1#[1..=2] == 2) & 1) << 2) | ((unsigned(qds_sign__w1#[2..=3] == 2) & 1) << 1) | (unsigned(qds_sign__w1#[2..=3] == 0) & 1)
}
