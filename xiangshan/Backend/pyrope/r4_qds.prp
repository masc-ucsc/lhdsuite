pub comb r4_qds::[timecheck=false](rem_i:U7, m_neg_1_i:U7, m_neg_0_i:U7, m_pos_1_i:U7, m_pos_2_i:U7) -> (rt_dig_o:U5) {
  const qds_sign__w1 = ((rem_i + m_pos_2_i)#[0..<7]#[6..<7] << 3) | ((rem_i + m_pos_1_i)#[0..<7]#[6..<7] << 2) | ((rem_i + m_neg_0_i)#[0..<7]#[6..<7] << 1) | (rem_i + m_neg_1_i)#[0..<7]#[6..<7]
  rt_dig_o = ((U1(qds_sign__w1#[0..<2] == 3) & 1) << 4) | ((U1(qds_sign__w1#[0..<2] == 2) & 1) << 3) | ((U1(qds_sign__w1#[1..<3] == 2) & 1) << 2) | ((U1(qds_sign__w1#[2..<4] == 2) & 1) << 1) | (U1(qds_sign__w1#[2..<4] == 0) & 1)
}
