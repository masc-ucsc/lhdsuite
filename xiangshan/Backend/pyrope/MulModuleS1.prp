const CSA4to2 = import("CSA4to2.CSA4to2")

pub mod MulModuleS1::[timecheck=false](io_in:(ppIn:u512)) -> (io_out:(resHigh:u128, resLow:u65)@[]) {
  wire _c42_io_ppOut:u256
  const resC__w1 = _c42_io_ppOut#[128..=255]
  const resS__w1 = _c42_io_ppOut#[0..=127]
  mut `_GEN.resHigh` = (resC__w1#[64..=127] << 64) | resS__w1#[64..=127]
  mut `_GEN.resLow` = (resS__w1#[0..=63] + resC__w1#[0..=63])#[0..=64]
  mut `io.in` = io_in.ppIn#[0..=511]
  mut `io.out` = ((`_GEN.resHigh` << 0x41) | `_GEN.resLow`)#[0..=192]
  mut c42 = CSA4to2::[name=c42](io_ppIn = `io.in`#[0..=511])
  _c42_io_ppOut = c42
  const t32 = `io.out`
  mut `io_out__bpo.resHigh` = t32#[65..=192]
  mut `io_out__bpo.resLow` = t32#[0..=64]
  io_out.resHigh = `io_out__bpo.resHigh`
  io_out.resLow = `io_out__bpo.resLow`
}
