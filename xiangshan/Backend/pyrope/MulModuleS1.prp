const CSA4to2 = import("CSA4to2.CSA4to2")

pub mod MulModuleS1::[timecheck=false](io_in:(ppIn:U512)) -> (io_out:(resHigh:U128, resLow:U65)@[]) {
  wire _c42_io_ppOut:U256 = nil
  wire `io_out__bpr.resHigh`:U128 = nil
  wire `io_out__bpr.resLow`:U65 = nil
  const resC__w1 = _c42_io_ppOut#[0x80..<0x100]
  const resS__w1 = _c42_io_ppOut#[0..<0x80]
  mut `_GEN.resHigh` = (resC__w1#[0x40..<0x80]#[0..<0x40] << 64) | resS__w1#[0x40..<0x80]#[0..<0x40]
  mut `_GEN.resLow` = (resS__w1#[0..<0x40] + resC__w1#[0..<0x40])#[0..<0x41]#[0..<0x41]
  mut `io.in` = io_in.ppIn#[0..<0x200]
  mut `io.out` = ((`_GEN.resHigh` << 0x41) | `_GEN.resLow`)#[0..<0xc1]
  mut c42 = CSA4to2::[name=c42](io_ppIn = `io.in`#[0..<0x200])
  _c42_io_ppOut = c42
  const t32 = `io.out`
  mut `io_out__bpo.resHigh` = t32#[0x41..<0xc1]
  mut `io_out__bpo.resLow` = t32#[0..<0x41]
  const t35 = `io_out__bpo.resHigh`
  `io_out__bpr.resHigh` = t35
  io_out.resHigh = t35
  const t36 = `io_out__bpo.resLow`
  `io_out__bpr.resLow` = t36
  io_out.resLow = t36
}
