pub mod DelayNWithValid_8::[timecheck=false](`clock`:Clock, `reset`:U1, io_in_bits:U64, io_in_valid:U1) -> (io_out_bits:U64@[], io_out_valid:U1@[]) {
  reg valid_REG:U1:[initial=0, reset_pin=`reset`, async=true]
  reg data:U64
  reg valid_REG_1:U1:[initial=0, reset_pin=`reset`, async=true]
  reg data_1:U64
  reg valid_REG_2:U1:[initial=0, reset_pin=`reset`, async=true]
  reg res_bits:U64
  const valid__w1 = valid_REG
  const valid_1__w1 = valid_REG_1
  mut `io.in_bits` = io_in_bits#[0..<0x40]
  mut `io.in_valid` = io_in_valid & 1
  mut `io.out_bits` = res_bits#[0..<0x40]
  mut `io.out_valid` = valid_REG_2 & 1
  if not (`reset` != 0) {
    valid_REG = `io.in_valid`
  }
  if `io.in_valid` != 0 {
    data = `io.in_bits`
  }
  if not (`reset` != 0) {
    valid_REG_1 = valid__w1
  }
  if valid__w1 != 0 {
    data_1 = data
  }
  if not (`reset` != 0) {
    valid_REG_2 = valid_1__w1
  }
  if valid_1__w1 != 0 {
    res_bits = data_1
  }
  io_out_bits = `io.out_bits`
  io_out_valid = `io.out_valid`
}
