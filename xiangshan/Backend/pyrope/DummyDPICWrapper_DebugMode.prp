const DiffExtDebugMode = import("DiffExtDebugMode.DiffExtDebugMode")

pub mod DummyDPICWrapper_DebugMode::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(debugMode:u1, dcsr:u64, dpc:u64, dscratch0:u64, dscratch1:u64, coreid:u8))) -> () {
  mut dpic = DiffExtDebugMode::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x109) | (io.bits.debugMode << 0x108) | (io.bits.dcsr << 0xc8) | (io.bits.dpc << 0x88) | (io.bits.dscratch0 << 0x48) | (io.bits.dscratch1 << 8) | io.bits.coreid)#[0..=264])
}
