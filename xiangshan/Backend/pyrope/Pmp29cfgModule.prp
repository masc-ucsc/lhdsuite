pub mod Pmp29cfgModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U8@[], regOut:(R:U1, W:U1, X:U1, A:U2, ATOMIC:U1, C:U1, L:U1)@[]) {
  mut _GEN:U2 = 0
  mut _mux_1:U2 = 0
  mut _mux_2:U2 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U1 = 0
  mut _mux_5:U1 = 0
  mut _mux_6:U1 = 0
  mut t38 = 0
  mut t39 = 0
  mut t40 = 0
  mut t41 = 0
  mut t42 = 0
  reg reg_0:U8:[initial=0, reset_pin=`reset`, async=true]
  reg _reg_A_WIRE_1:U2
  reg _GEN_0:U1
  reg _GEN_1:U1
  reg _GEN_2:U1
  reg _GEN_3:U1
  wire `regOut__bpr.R`:U1 = nil
  wire `regOut__bpr.W`:U1 = nil
  wire `regOut__bpr.X`:U1 = nil
  wire `regOut__bpr.A`:U2 = nil
  wire `regOut__bpr.ATOMIC`:U1 = nil
  wire `regOut__bpr.C`:U1 = nil
  wire `regOut__bpr.L`:U1 = nil
  mut `reg_init.R` = 0
  mut `reg_init.W` = 0
  mut `reg_init.X` = 0
  mut `reg_init.A` = 0
  mut `reg_init.ATOMIC` = 0
  mut `reg_init.C` = 0
  mut `reg_init.L` = 0
  mut `wdata.R` = w.wdata & 1
  mut `wdata.W` = w.wdata#[1..<2]
  mut `wdata.X` = w.wdata#[2..<3]
  mut `wdata.A` = w.wdata#[3..<5]
  mut `wdata.ATOMIC` = w.wdata#[5..<6]
  mut `wdata.C` = w.wdata#[6..<7]
  mut `wdata.L` = w.wdata#[7..<8]
  t38 = _reg_A_WIRE_1
  t39 = _GEN_0
  t40 = _GEN_1
  t41 = _GEN_2
  t42 = _GEN_3
  if not (`reset` != 0) {
    _GEN = 0ub??
    _mux_1 = if w.wdata#[3..<5] == 2 { 3 } else { w.wdata#[3..<5] }
    _GEN = _mux_1
    _mux_2 = if w.wen != 0 { _GEN#[0..<2] } else { reg_0#[3..<5] }
    t38 = _mux_2
    _mux_3 = if (w.wen & (~((~(w.wdata & 1)#[0]) & w.wdata#[1..<2] & 1)#[0]) & 1) != 0 { w.wdata#[1..<2] } else { reg_0#[6..<7] }
    t39 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.R` & 1 } else { reg_0#[7..<8] }
    t40 = _mux_4
    _mux_5 = if w.wen != 0 { `wdata.X` & 1 } else { reg_0#[5..<6] }
    t41 = _mux_5
    _mux_6 = if w.wen != 0 { `wdata.L` & 1 } else { reg_0 & 1 }
    t42 = _mux_6
    reg_0 = t42 | (reg_0#[1..<2] << 1) | (reg_0#[2..<3] << 2) | (t38 << 3) | (t41 << 5) | (t39 << 6) | (t40 << 7)
  }
  _reg_A_WIRE_1 = t38
  _GEN_0 = t39
  _GEN_1 = t40
  _GEN_2 = t41
  _GEN_3 = t42
  mut `regOut__bpo.R` = reg_0#[7..<8]
  mut `regOut__bpo.W` = reg_0#[6..<7]
  mut `regOut__bpo.X` = reg_0#[5..<6]
  mut `regOut__bpo.A` = reg_0#[3..<5]
  mut `regOut__bpo.ATOMIC` = reg_0#[2..<3]
  mut `regOut__bpo.C` = reg_0#[1..<2]
  mut `regOut__bpo.L` = reg_0 & 1
  const t111 = `regOut__bpo.R`
  `regOut__bpr.R` = t111
  regOut.R = t111
  const t112 = `regOut__bpo.W`
  `regOut__bpr.W` = t112
  regOut.W = t112
  const t113 = `regOut__bpo.X`
  `regOut__bpr.X` = t113
  regOut.X = t113
  const t114 = `regOut__bpo.A`
  `regOut__bpr.A` = t114
  regOut.A = t114
  const t115 = `regOut__bpo.ATOMIC`
  `regOut__bpr.ATOMIC` = t115
  regOut.ATOMIC = t115
  const t116 = `regOut__bpo.C`
  `regOut__bpr.C` = t116
  regOut.C = t116
  const t117 = `regOut__bpo.L`
  `regOut__bpr.L` = t117
  regOut.L = t117
  rdata = ((reg_0 & 1) << 7) | (reg_0#[1..<2] << 6) | (reg_0#[2..<3] << 5) | (reg_0#[3..<5] << 3) | (reg_0#[5..<6] << 2) | (reg_0#[6..<7] << 1) | reg_0#[7..<8]
}
