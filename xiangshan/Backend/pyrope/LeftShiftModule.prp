pub comb LeftShiftModule::[timecheck=false](io_shamt:u6, io_sllSrc:u64) -> (io_sll:u64) {
  wire io:(shamt:u6, sllSrc:u64, sll:u64) = nil
  mut _mux_1:u64 = if ((io.shamt >> 5) & 1) != 0 { io.sllSrc#[0..=31] << 32 } else { io.sllSrc#[0..=63] }
  const io_sll_shifted__w1 = _mux_1
  mut _mux_2:u64 = if ((io.shamt >> 4) & 1) != 0 { io_sll_shifted__w1#[0..=47] << 16 } else { io_sll_shifted__w1 }
  const io_sll_shifted_1__w1 = _mux_2
  mut _mux_3:u64 = if ((io.shamt >> 3) & 1) != 0 { io_sll_shifted_1__w1#[0..=55] << 8 } else { io_sll_shifted_1__w1 }
  const io_sll_shifted_2__w1 = _mux_3
  mut _mux_4:u64 = if ((io.shamt >> 2) & 1) != 0 { io_sll_shifted_2__w1#[0..=59] << 4 } else { io_sll_shifted_2__w1 }
  const io_sll_shifted_3__w1 = _mux_4
  mut _mux_5:u64 = if ((io.shamt >> 1) & 1) != 0 { io_sll_shifted_3__w1#[0..=61] << 2 } else { io_sll_shifted_3__w1 }
  const io_sll_shifted_4__w1 = _mux_5
  mut _mux_6:u64 = if (io.shamt & 1) != 0 { io_sll_shifted_4__w1#[0..=62] << 1 } else { io_sll_shifted_4__w1 }
  io.shamt = io_shamt
  io.sllSrc = io_sllSrc
  io.sll = _mux_6
  io_sll = io.sll
}
