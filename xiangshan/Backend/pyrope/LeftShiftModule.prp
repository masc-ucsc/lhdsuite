pub comb LeftShiftModule::[timecheck=false](io_shamt:U6, io_sllSrc:U64) -> (io_sll:U64) {
  wire io:(shamt:U6, sllSrc:U64, sll:U64) = nil
  wire io_sll_shifted:U64 = nil
  wire io_sll_shifted_1:U64 = nil
  wire io_sll_shifted_2:U64 = nil
  wire io_sll_shifted_3:U64 = nil
  wire io_sll_shifted_4:U64 = nil
  wire io_sll_shifted_5:U64 = nil
  mut _mux_1:U64 = if io.shamt#[5..<6] != 0 { io.sllSrc#[0..<32] << 32 } else { io.sllSrc#[0..<0x40] }
  io_sll_shifted = _mux_1
  mut _mux_2:U64 = if io.shamt#[4..<5] != 0 { io_sll_shifted#[0..<48] << 16 } else { io_sll_shifted#[0..<0x40] }
  io_sll_shifted_1 = _mux_2
  mut _mux_3:U64 = if io.shamt#[3..<4] != 0 { io_sll_shifted_1#[0..<56] << 8 } else { io_sll_shifted_1#[0..<0x40] }
  io_sll_shifted_2 = _mux_3
  mut _mux_4:U64 = if io.shamt#[2..<3] != 0 { io_sll_shifted_2#[0..<60] << 4 } else { io_sll_shifted_2#[0..<0x40] }
  io_sll_shifted_3 = _mux_4
  mut _mux_5:U64 = if io.shamt#[1..<2] != 0 { io_sll_shifted_3#[0..<62] << 2 } else { io_sll_shifted_3#[0..<0x40] }
  io_sll_shifted_4 = _mux_5
  mut _mux_6:U64 = if (io.shamt & 1) != 0 { io_sll_shifted_4#[0..<63] << 1 } else { io_sll_shifted_4#[0..<0x40] }
  io_sll_shifted_5 = _mux_6
  io.shamt = io_shamt#[0..<6]
  io.sllSrc = io_sllSrc#[0..<0x40]
  io.sll = io_sll_shifted_5#[0..<0x40]
  io_sll = io.sll
}
