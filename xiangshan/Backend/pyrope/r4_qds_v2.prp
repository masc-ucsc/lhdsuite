pub comb r4_qds_v2::[timecheck=false](io_rem_i:U6) -> (io_quo_dig_o:U5) {
  wire io:(rem_i:U6, quo_dig_o:U5) = nil
  wire rem_i_signed:U6 = nil
  wire _qds_sign_T:U6 = nil
  wire _qds_sign_T_4:U6 = nil
  wire _qds_sign_T_8:U6 = nil
  wire _qds_sign_T_12:U6 = nil
  wire qds_sign:U4 = nil
  rem_i_signed = io.rem_i
  _qds_sign_T = (rem_i_signed - 12)#[0..<6]
  _qds_sign_T_4 = (rem_i_signed - 3)#[0..<6]
  _qds_sign_T_8 = (rem_i_signed + 4)#[0..<6]
  _qds_sign_T_12 = (rem_i_signed + 13)#[0..<6]
  qds_sign = (_qds_sign_T#[5..<6] << 3) | (_qds_sign_T_4#[5..<6] << 2) | (_qds_sign_T_8#[5..<6] << 1) | _qds_sign_T_12#[5..<6]
  io.rem_i = io_rem_i#[0..<6]
  io.quo_dig_o = ((U1(qds_sign#[0..<2] == 3) & 1) << 4) | ((U1(qds_sign#[0..<2] == 2) & 1) << 3) | ((U1(qds_sign#[1..<3] == 2) & 1) << 2) | ((U1(qds_sign#[2..<4] == 2) & 1) << 1) | (U1(qds_sign#[2..<4] == 0) & 1)
  io_quo_dig_o = io.quo_dig_o
}
