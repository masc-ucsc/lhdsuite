pub comb outputSelect::[timecheck=false](io_vdNonFixP:U64, io_vdFixP:U64, io_vxsat:U8, io_isFixP:U1) -> (io_vdOut:U64, io_vxsatOut:U8) {
  wire io:(vdNonFixP:U64, vdFixP:U64, vxsat:U8, isFixP:U1, vdOut:U64, vxsatOut:U8) = nil
  wire _io_vdOut_T:U64 = nil
  wire _io_vxsatOut_T:U8 = nil
  mut _mux_1:U64 = if io.isFixP != 0 { io.vdFixP#[0..<0x40] } else { io.vdNonFixP#[0..<0x40] }
  _io_vdOut_T = _mux_1
  mut _mux_2:U8 = if io.isFixP != 0 { io.vxsat#[0..<8] } else { 0 }
  _io_vxsatOut_T = _mux_2
  io.vdNonFixP = io_vdNonFixP#[0..<0x40]
  io.vdFixP = io_vdFixP#[0..<0x40]
  io.vxsat = io_vxsat#[0..<8]
  io.isFixP = io_isFixP & 1
  io.vdOut = _io_vdOut_T#[0..<0x40]
  io.vxsatOut = _io_vxsatOut_T#[0..<8]
  io_vdOut = io.vdOut
  io_vxsatOut = io.vxsatOut
}
