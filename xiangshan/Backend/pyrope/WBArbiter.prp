pub mod WBArbiter::[timecheck=false](`clock`:Clock, `reset`:U1, io_in_0_valid:U1) -> (io_in_0_ready:U1@[], io_out_valid:U1@[]) {
  reg cancelCounter:[1]U3:[ordering="old", initial=0, reset_pin=`reset`, async=true]
  reg isFull:U1:[initial=0, reset_pin=`reset`, async=true]
  reg hasFull:U1:[initial=0, reset_pin=`reset`, async=true]
  const io_in_0_valid_0__w1 = io_in_0_valid
  mut _b2i_1 = if cancelCounter[0] == 7 { 1 } else { 0 }
  mut _b2i_2 = if cancelCounter[0] == 6 { 1 } else { 0 }
  mut _mux_3:U3 = if ((_b2i_1 | _b2i_2) & 1) != 0 { 7 } else { (cancelCounter[0] + 2)#[0..<3] }
  mut _mux_4:U3 = if cancelCounter[0] == 0 { 0 } else { (cancelCounter[0] - 1)#[0..<3] }
  const finalValid__w1 = (io_in_0_valid_0__w1 & 1) & ((((~hasFull) | (~(io_in_0_valid_0__w1 & isFull & 1 & 1)#[0])) & 1) | isFull) & 1 & 1
  mut _b2i_5 = if cancelCounter[0] == 7 { 1 } else { 0 }
  mut _b2i_6 = if cancelCounter[0] == 6 { 1 } else { 0 }
  const isFullNext__w1 = ((_b2i_5 & 1) | (_b2i_6 & 1)) & 1
  if not (`reset` != 0) {
    isFull = isFullNext__w1
  }
  if not (`reset` != 0) {
    hasFull = isFullNext__w1 & 1
  }
  const io_out_valid_0__w1 = finalValid__w1 & 1
  const io_in_0_ready_0__w1 = (io_out_valid_0__w1 | (~io_in_0_valid_0__w1#[0])) & 1
  mut _mux_7:U3 = if (io_in_0_valid_0__w1 & io_in_0_ready_0__w1 & 1) != 0 { _mux_4#[0..<3] } else { cancelCounter[0] }
  mut _mux_8:U3 = if (io_in_0_valid_0__w1 & (~io_in_0_ready_0__w1#[0]) & 1) != 0 { _mux_3#[0..<3] } else { _mux_7#[0..<3] }
  if not (`reset` != 0) {
    cancelCounter#[0..<3] = _mux_8#[0..<3]
  }
  io_in_0_ready = io_in_0_ready_0__w1
  io_out_valid = io_out_valid_0__w1
}
