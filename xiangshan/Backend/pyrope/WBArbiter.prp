pub mod WBArbiter::[timecheck=false](clock:u1, reset:u1, io_in_0_valid:u1) -> (io_in_0_ready:u1@[], io_out_valid:u1@[]) {
  reg cancelCounter:u3:[init=0, reset_pin=ref reset, async=true]
  reg isFull:u1:[init=0, reset_pin=ref reset, async=true]
  reg hasFull:u1:[init=0, reset_pin=ref reset, async=true]
  const io_in_0_valid_0__w1 = io_in_0_valid
  mut _mux_3:u3 = if ((unsigned(cancelCounter == 7) | unsigned(cancelCounter == 6)) & 1) != 0 { 7 } else { (cancelCounter + 2)#[0..=2] }
  mut _mux_4:u3 = if cancelCounter == 0 { 0 } else { (cancelCounter - 1)#[0..=2] }
  const finalValid__w1 = (io_in_0_valid_0__w1 & 1) & (((((~hasFull) & 1) | ((~(io_in_0_valid_0__w1 & isFull & 1 & 1)) & 1)) & 1) | isFull) & 1 & 1
  const isFullNext__w1 = ((unsigned(cancelCounter == 7) & 1) | (unsigned(cancelCounter == 6) & 1)) & 1
  isFull = isFullNext__w1
  hasFull = isFullNext__w1 & 1
  const io_out_valid_0__w1 = finalValid__w1 & 1
  const io_in_0_ready_0__w1 = (io_out_valid_0__w1 | ((~io_in_0_valid_0__w1) & 1)) & 1
  mut _mux_7:u3 = if (io_in_0_valid_0__w1 & io_in_0_ready_0__w1 & 1) != 0 { _mux_4 } else { cancelCounter }
  mut _mux_8:u3 = if (io_in_0_valid_0__w1 & (~io_in_0_ready_0__w1) & 1 & 1) != 0 { _mux_3 } else { _mux_7 }
  cancelCounter = _mux_8
  io_in_0_ready = io_in_0_ready_0__w1
  io_out_valid = io_out_valid_0__w1
}
