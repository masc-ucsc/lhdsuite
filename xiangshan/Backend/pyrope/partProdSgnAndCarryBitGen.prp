pub comb partProdSgnAndCarryBitGen::[timecheck=false](io_isSub:U1, io_vs2_is_signed:U1, io_sewIs8:U1, io_sewIs16:U1, io_sewIs32:U1, io_sewIs64:U1, io_sgnVs2:U8, io_vs1BoothPos:U32, io_vs1BoothNeg:U32, io_vs1BoothNonZ:U32) -> (io_partProdSgn:U32, io_partProdCin:U32) {
