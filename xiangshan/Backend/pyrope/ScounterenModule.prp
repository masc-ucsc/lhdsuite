pub mod ScounterenModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(CY:U1, TM:U1, IR:U1, HPM:U29)@[]) {
  mut _mux_1:U1 = 0
  mut _mux_2:U1 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U29 = 0
  mut t23 = 0
  mut t24 = 0
  mut t25 = 0
  mut t26 = 0
  reg reg_0:U32:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U1
  reg _GEN_0:U1
  reg _GEN_1:U1
  reg _GEN_2:U29
  wire `regOut__bpr.CY`:U1 = nil
  wire `regOut__bpr.TM`:U1 = nil
  wire `regOut__bpr.IR`:U1 = nil
  wire `regOut__bpr.HPM`:U29 = nil
  mut `reg_init.CY` = 0
  mut `reg_init.TM` = 0
  mut `reg_init.IR` = 0
  mut `reg_init.HPM` = 0
  mut `wdata.CY` = w.wdata & 1
  mut `wdata.TM` = w.wdata#[1..<2]
  mut `wdata.IR` = w.wdata#[2..<3]
  mut `wdata.HPM` = w.wdata#[3..<32]
  t23 = _GEN
  t24 = _GEN_0
  t25 = _GEN_1
  t26 = _GEN_2
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.CY` & 1 } else { reg_0#[31..<32] }
    t23 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.TM` & 1 } else { reg_0#[30..<31] }
    t24 = _mux_2
    _mux_3 = if w.wen != 0 { `wdata.IR` & 1 } else { reg_0#[29..<30] }
    t25 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.HPM`#[0..<29] } else { reg_0#[0..<29] }
    t26 = _mux_4
    reg_0 = t26 | (t25 << 29) | (t24 << 30) | (t23 << 31)
  }
  _GEN = t23
  _GEN_0 = t24
  _GEN_1 = t25
  _GEN_2 = t26
  mut `regOut__bpo.CY` = reg_0#[31..<32]
  mut `regOut__bpo.TM` = reg_0#[30..<31]
  mut `regOut__bpo.IR` = reg_0#[29..<30]
  mut `regOut__bpo.HPM` = reg_0#[0..<29]
  const t62 = `regOut__bpo.CY`
  `regOut__bpr.CY` = t62
  regOut.CY = t62
  const t63 = `regOut__bpo.TM`
  `regOut__bpr.TM` = t63
  regOut.TM = t63
  const t64 = `regOut__bpo.IR`
  `regOut__bpr.IR` = t64
  regOut.IR = t64
  const t65 = `regOut__bpo.HPM`
  `regOut__bpr.HPM` = t65
  regOut.HPM = t65
  rdata = (reg_0#[0..<29] << 3) | (reg_0#[29..<30] << 2) | (reg_0#[30..<31] << 1) | reg_0#[31..<32]
}
