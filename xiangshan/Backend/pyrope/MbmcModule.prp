pub mod MbmcModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(BMA:u58, KEYIDEN:u1, BME:u1, BCLEAR:u1, CMODE:u1)@[]) {
  reg reg_0:u62:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.BMA` = 0
  mut `reg_init.KEYIDEN` = 0
  mut `reg_init.BME` = 0
  mut `reg_init.BCLEAR` = 0
  mut `reg_init.CMODE` = 0
  const mbmc_lock__w1 = (reg_0 >> 2) & 1
  mut `wdata.BMA` = w.wdata#[6..=63]
  mut `wdata.KEYIDEN` = (w.wdata >> 3) & 1
  mut `wdata.BME` = (w.wdata >> 2) & 1
  mut `wdata.BCLEAR` = (w.wdata >> 1) & 1
  mut `wdata.CMODE` = w.wdata & 1
  mut _mux_1:u1 = if (w.wen & (~mbmc_lock__w1) & 1 & 1) != 0 { `wdata.BME` & 1 } else { mbmc_lock__w1 & 1 }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.CMODE` & 1 } else { reg_0 & 1 }
  mut _mux_3:u58 = if (w.wen & (~mbmc_lock__w1) & 1 & 1) != 0 { `wdata.BMA`#[0..=57] } else { reg_0#[4..=61] }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.KEYIDEN` & 1 } else { (reg_0 >> 3) & 1 }
  reg_0 = _mux_2 | (((~((reg_0 >> 1) & 1)) & 1 & w.wen & 1 & `wdata.BCLEAR` & 1) << 1) | (_mux_1 << 2) | (_mux_4 << 3) | (_mux_3 << 4)
  mut `regOut__bpo.BMA` = reg_0#[4..=61]
  mut `regOut__bpo.KEYIDEN` = (reg_0 >> 3) & 1
  mut `regOut__bpo.BME` = (reg_0 >> 2) & 1
  mut `regOut__bpo.BCLEAR` = (reg_0 >> 1) & 1
  mut `regOut__bpo.CMODE` = reg_0 & 1
  regOut.BMA = `regOut__bpo.BMA`
  regOut.KEYIDEN = `regOut__bpo.KEYIDEN`
  regOut.BME = `regOut__bpo.BME`
  regOut.BCLEAR = `regOut__bpo.BCLEAR`
  regOut.CMODE = `regOut__bpo.CMODE`
  rdata = (reg_0#[4..=61] << 6) | (((reg_0 >> 3) & 1) << 3) | (((reg_0 >> 2) & 1) << 2) | (((reg_0 >> 1) & 1) << 1) | (reg_0 & 1)
}
