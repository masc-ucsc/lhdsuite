pub mod MbmcModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(BMA:U58, KEYIDEN:U1, BME:U1, BCLEAR:U1, CMODE:U1)@[]) {
  reg reg_0:U62:[initial=0, reset_pin=`reset`, async=true]
  wire `regOut__bpr.BMA`:U58 = nil
  wire `regOut__bpr.KEYIDEN`:U1 = nil
  wire `regOut__bpr.BME`:U1 = nil
  wire `regOut__bpr.BCLEAR`:U1 = nil
  wire `regOut__bpr.CMODE`:U1 = nil
  mut `reg_init.BMA` = 0
  mut `reg_init.KEYIDEN` = 0
  mut `reg_init.BME` = 0
  mut `reg_init.BCLEAR` = 0
  mut `reg_init.CMODE` = 0
  const mbmc_lock__w1 = reg_0#[2..<3]
  mut `wdata.BMA` = w.wdata#[6..<0x40]
  mut `wdata.KEYIDEN` = w.wdata#[3..<4]
  mut `wdata.BME` = w.wdata#[2..<3]
  mut `wdata.BCLEAR` = w.wdata#[1..<2]
  mut `wdata.CMODE` = w.wdata & 1
  mut _mux_1:U1 = if (w.wen & (~mbmc_lock__w1#[0]) & 1) != 0 { `wdata.BME` & 1 } else { mbmc_lock__w1 & 1 }
  mut _mux_2:U1 = if w.wen != 0 { `wdata.CMODE` & 1 } else { reg_0 & 1 }
  mut _mux_3:U58 = if (w.wen & (~mbmc_lock__w1#[0]) & 1) != 0 { `wdata.BMA`#[0..<58] } else { reg_0#[4..<62] }
  mut _mux_4:U1 = if w.wen != 0 { `wdata.KEYIDEN` & 1 } else { reg_0#[3..<4] }
  if not (`reset` != 0) {
    reg_0 = _mux_2 | (((~reg_0#[1..<2]) & w.wen & 1 & `wdata.BCLEAR` & 1) << 1) | (_mux_1 << 2) | (_mux_4 << 3) | (_mux_3 << 4)
  }
  mut `regOut__bpo.BMA` = reg_0#[4..<62]
  mut `regOut__bpo.KEYIDEN` = reg_0#[3..<4]
  mut `regOut__bpo.BME` = reg_0#[2..<3]
  mut `regOut__bpo.BCLEAR` = reg_0#[1..<2]
  mut `regOut__bpo.CMODE` = reg_0 & 1
  const t82 = `regOut__bpo.BMA`
  `regOut__bpr.BMA` = t82
  regOut.BMA = t82
  const t83 = `regOut__bpo.KEYIDEN`
  `regOut__bpr.KEYIDEN` = t83
  regOut.KEYIDEN = t83
  const t84 = `regOut__bpo.BME`
  `regOut__bpr.BME` = t84
  regOut.BME = t84
  const t85 = `regOut__bpo.BCLEAR`
  `regOut__bpr.BCLEAR` = t85
  regOut.BCLEAR = t85
  const t86 = `regOut__bpo.CMODE`
  `regOut__bpr.CMODE` = t86
  regOut.CMODE = t86
  rdata = (reg_0#[4..<62] << 6) | (reg_0#[3..<4] << 3) | (reg_0#[2..<3] << 2) | (reg_0#[1..<2] << 1) | (reg_0 & 1)
}
