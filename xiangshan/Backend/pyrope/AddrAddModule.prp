pub comb AddrAddModule::[timecheck=false](io_pcExtend:U51, io_taken:U1, io_isRVC:U1, io_imm:U32, io_nextPcOffset:U7) -> (io_target:U64) {
  wire io:(pcExtend:U51, taken:U1, isRVC:U1, imm:U32, target:U64, nextPcOffset:U7) = nil
  wire io_target_signBit:U1 = nil
  wire _io_target_T_7:U51 = nil
  wire io_target_signBit_1:U1 = nil
  io_target_signBit = io.imm#[14..<15]
  mut _rep_1:U36 = if (io_target_signBit & 1) != 0 { 0xfffffffff } else { 0 }
  mut _mux_2:U51 = if io.taken != 0 { (io.pcExtend + ((_rep_1#[0..<36] << 15) | io.imm#[0..<15]))#[0..<51] } else { (io.pcExtend + io.nextPcOffset#[0..<7])#[0..<51] }
  _io_target_T_7 = _mux_2
  io_target_signBit_1 = _io_target_T_7#[50..<51]
  io.pcExtend = io_pcExtend#[0..<51]
  io.taken = io_taken & 1
  io.isRVC = io_isRVC & 1
  io.imm = io_imm#[0..<32]
  mut _rep_3:U13 = if (io_target_signBit_1 & 1) != 0 { 0x1fff } else { 0 }
  io.target = (_rep_3#[0..<13] << 51) | _io_target_T_7#[0..<51]
  io.nextPcOffset = io_nextPcOffset#[0..<7]
  io_target = io.target
}
