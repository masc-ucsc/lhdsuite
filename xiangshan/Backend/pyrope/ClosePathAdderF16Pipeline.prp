pub comb ClosePathAdderF16Pipeline::[timecheck=false](io_adder_op0:U11, io_adder_op1:U11) -> (io_result:U12) {
  mut `io.adder_op0` = io_adder_op0#[0..<11]
  mut `io.adder_op1` = io_adder_op1#[0..<11]
  mut `io.result` = (`io.adder_op0`#[0..<11] - `io.adder_op1`#[0..<11])#[0..<12]
  io_result = `io.result`
}
