pub comb CSA3to2_147::[timecheck=false](io_in_a:U16, io_in_b:U16, io_in_c:U16) -> (io_out_sum:U16, io_out_car:U16) {
  mut `io.in_a` = io_in_a#[0..<16]
  mut `io.in_b` = io_in_b#[0..<16]
  mut `io.in_c` = io_in_c#[0..<16]
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..<16] ^ `io.in_c`)#[0..<16]
  mut `io.out_car` = (((`io.in_a`#[0..<15] & `io.in_b`#[0..<15])#[0..<15] | (`io.in_a`#[0..<15] & `io.in_c`#[0..<15])#[0..<15])#[0..<15] | (`io.in_b`#[0..<15] & `io.in_c`#[0..<15])#[0..<15])#[0..<15] << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
