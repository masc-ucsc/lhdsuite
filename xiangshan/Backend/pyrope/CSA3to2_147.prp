pub comb CSA3to2_147::[timecheck=false](io_in_a:u16, io_in_b:u16, io_in_c:u16) -> (io_out_sum:u16, io_out_car:u16) {
  mut `io.in_a` = io_in_a
  mut `io.in_b` = io_in_b
  mut `io.in_c` = io_in_c
  mut `io.out_sum` = ((`io.in_a` ^ `io.in_b`)#[0..=15] ^ `io.in_c`)#[0..=15]
  mut `io.out_car` = (((`io.in_a`#[0..=14] & `io.in_b`#[0..=14]) | (`io.in_a`#[0..=14] & `io.in_c`#[0..=14])) | (`io.in_b`#[0..=14] & `io.in_c`#[0..=14])) << 1
  io_out_sum = `io.out_sum`
  io_out_car = `io.out_car`
}
