pub comb ShiftRightJam_3::[timecheck=false](io_in:U12, io_shamt:U5) -> (io_out:U12, io_sticky:U1) {
  wire io:(`in`:U12, shamt:U5, out:U12, sticky:U1) = nil
  wire exceed_max_shift:U1 = nil
  wire shamt:U4 = nil
  wire _sticky_mask_T:U16 = nil
  wire sticky_mask:U12 = nil
  wire _io_out_T_1:U12 = nil
  exceed_max_shift = U1(io.shamt > 12)
  shamt = io.shamt#[0..<4]
  _sticky_mask_T = (1 << shamt)#[0..<16]
  mut _rep_2:U12 = if (exceed_max_shift & 1) != 0 { 0xfff } else { 0 }
  sticky_mask = ((_sticky_mask_T#[0..<12] - 1)#[0..<12] | _rep_2)#[0..<12]
  mut _mux_3:U12 = if exceed_max_shift != 0 { 0 } else { (io.`in` >> io.shamt)#[0..<12] }
  _io_out_T_1 = _mux_3
  io.`in` = io_in#[0..<12]
  io.shamt = io_shamt#[0..<5]
  io.out = _io_out_T_1#[0..<12]
  mut _b2i_4 = if (io.`in` & sticky_mask)#[0..<12] != 0 { 1 } else { 0 }
  io.sticky = _b2i_4 & 1
  io_out = io.out
  io_sticky = io.sticky
}
