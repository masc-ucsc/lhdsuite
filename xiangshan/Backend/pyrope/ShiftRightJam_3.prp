pub comb ShiftRightJam_3::[timecheck=false](io_in:u12, io_shamt:u5) -> (io_out:u12, io_sticky:u1) {
  wire io:(`in`:u12, shamt:u5, out:u12, sticky:u1) = nil
  const exceed_max_shift__w1 = unsigned(io.shamt > 12)
  mut _rep_2:u12 = if (exceed_max_shift__w1 & 1) != 0 { 0xfff } else { 0 }
  const sticky_mask__w1 = ((1 << io.shamt#[0..=3])#[0..=15]#[0..=11] - 1)#[0..=11] | _rep_2
  mut _mux_3:u12 = if exceed_max_shift__w1 != 0 { 0 } else { (io.`in` >> io.shamt)#[0..=11] }
  io.`in` = io_in
  io.shamt = io_shamt
  io.out = _mux_3
  io.sticky = unsigned((io.`in` & sticky_mask__w1) != 0) & 1
  io_out = io.out
  io_sticky = io.sticky
}
