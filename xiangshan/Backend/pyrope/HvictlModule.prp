pub mod HvictlModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(VTI:u1, IID:u12, DPR:u1, IPRIOM:u1, IPRIO:u8)@[]) {
  reg reg_0:u23:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.VTI` = 0
  mut `reg_init.IID` = 0
  mut `reg_init.DPR` = 0
  mut `reg_init.IPRIOM` = 0
  mut `reg_init.IPRIO` = 0
  mut `wdata.VTI` = (w.wdata >> 30) & 1
  mut `wdata.IID` = w.wdata#[16..=27]
  mut `wdata.DPR` = (w.wdata >> 9) & 1
  mut `wdata.IPRIOM` = (w.wdata >> 8) & 1
  mut `wdata.IPRIO` = w.wdata#[0..=7]
  mut _mux_1:u1 = if w.wen != 0 { `wdata.VTI` & 1 } else { (reg_0 >> 22) & 1 }
  mut _mux_2:u12 = if w.wen != 0 { `wdata.IID`#[0..=11] } else { reg_0#[10..=21] }
  mut _mux_3:u1 = if w.wen != 0 { `wdata.DPR` & 1 } else { (reg_0 >> 9) & 1 }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.IPRIOM` & 1 } else { (reg_0 >> 8) & 1 }
  mut _mux_5:u8 = if w.wen != 0 { `wdata.IPRIO`#[0..=7] } else { reg_0#[0..=7] }
  reg_0 = _mux_5 | (_mux_4 << 8) | (_mux_3 << 9) | (_mux_2 << 10) | (_mux_1 << 22)
  mut `regOut__bpo.VTI` = (reg_0 >> 22) & 1
  mut `regOut__bpo.IID` = reg_0#[10..=21]
  mut `regOut__bpo.DPR` = (reg_0 >> 9) & 1
  mut `regOut__bpo.IPRIOM` = (reg_0 >> 8) & 1
  mut `regOut__bpo.IPRIO` = reg_0#[0..=7]
  regOut.VTI = `regOut__bpo.VTI`
  regOut.IID = `regOut__bpo.IID`
  regOut.DPR = `regOut__bpo.DPR`
  regOut.IPRIOM = `regOut__bpo.IPRIOM`
  regOut.IPRIO = `regOut__bpo.IPRIO`
  rdata = (((reg_0 >> 22) & 1) << 30) | (reg_0#[10..=21] << 16) | (((reg_0 >> 9) & 1) << 9) | (((reg_0 >> 8) & 1) << 8) | reg_0#[0..=7]
}
