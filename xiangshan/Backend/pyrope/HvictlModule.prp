pub mod HvictlModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(VTI:U1, IID:U12, DPR:U1, IPRIOM:U1, IPRIO:U8)@[]) {
  mut _mux_1:U1 = 0
  mut _mux_2:U12 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U1 = 0
  mut _mux_5:U8 = 0
  mut t28 = 0
  mut t29 = 0
  mut t30 = 0
  mut t31 = 0
  mut t32 = 0
  reg reg_0:U23:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U1
  reg _GEN_0:U12
  reg _GEN_1:U1
  reg _GEN_2:U1
  reg _GEN_3:U8
  wire `regOut__bpr.VTI`:U1 = nil
  wire `regOut__bpr.IID`:U12 = nil
  wire `regOut__bpr.DPR`:U1 = nil
  wire `regOut__bpr.IPRIOM`:U1 = nil
  wire `regOut__bpr.IPRIO`:U8 = nil
  mut `reg_init.VTI` = 0
  mut `reg_init.IID` = 0
  mut `reg_init.DPR` = 0
  mut `reg_init.IPRIOM` = 0
  mut `reg_init.IPRIO` = 0
  mut `wdata.VTI` = w.wdata#[30..<31]
  mut `wdata.IID` = w.wdata#[16..<28]
  mut `wdata.DPR` = w.wdata#[9..<10]
  mut `wdata.IPRIOM` = w.wdata#[8..<9]
  mut `wdata.IPRIO` = w.wdata#[0..<8]
  t28 = _GEN
  t29 = _GEN_0
  t30 = _GEN_1
  t31 = _GEN_2
  t32 = _GEN_3
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.VTI` & 1 } else { reg_0#[22..<23] }
    t28 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.IID`#[0..<12] } else { reg_0#[10..<22] }
    t29 = _mux_2
    _mux_3 = if w.wen != 0 { `wdata.DPR` & 1 } else { reg_0#[9..<10] }
    t30 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.IPRIOM` & 1 } else { reg_0#[8..<9] }
    t31 = _mux_4
    _mux_5 = if w.wen != 0 { `wdata.IPRIO`#[0..<8] } else { reg_0#[0..<8] }
    t32 = _mux_5
    reg_0 = t32 | (t31 << 8) | (t30 << 9) | (t29 << 10) | (t28 << 22)
  }
  _GEN = t28
  _GEN_0 = t29
  _GEN_1 = t30
  _GEN_2 = t31
  _GEN_3 = t32
  mut `regOut__bpo.VTI` = reg_0#[22..<23]
  mut `regOut__bpo.IID` = reg_0#[10..<22]
  mut `regOut__bpo.DPR` = reg_0#[9..<10]
  mut `regOut__bpo.IPRIOM` = reg_0#[8..<9]
  mut `regOut__bpo.IPRIO` = reg_0#[0..<8]
  const t77 = `regOut__bpo.VTI`
  `regOut__bpr.VTI` = t77
  regOut.VTI = t77
  const t78 = `regOut__bpo.IID`
  `regOut__bpr.IID` = t78
  regOut.IID = t78
  const t79 = `regOut__bpo.DPR`
  `regOut__bpr.DPR` = t79
  regOut.DPR = t79
  const t80 = `regOut__bpo.IPRIOM`
  `regOut__bpr.IPRIOM` = t80
  regOut.IPRIOM = t80
  const t81 = `regOut__bpo.IPRIO`
  `regOut__bpr.IPRIO` = t81
  regOut.IPRIO = t81
  rdata = (reg_0#[22..<23] << 30) | (reg_0#[10..<22] << 16) | (reg_0#[9..<10] << 9) | (reg_0#[8..<9] << 8) | reg_0#[0..<8]
}
