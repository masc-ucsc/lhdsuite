const DiffExtArchEvent = import("DiffExtArchEvent.DiffExtArchEvent")

pub mod DummyDPICWrapper_ArchEvent::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(valid:u1, interrupt:u32, exception:u32, exceptionPC:u64, exceptionInst:u32, hasNMI:u1, virtualInterruptIsHvictlInject:u1, irToHS:u1, irToVS:u1, coreid:u8))) -> () {
  mut dpic = DiffExtArchEvent::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0xad) | (io.bits.valid << 0xac) | (io.bits.interrupt << 0x8c) | (io.bits.exception << 0x6c) | (io.bits.exceptionPC << 44) | (io.bits.exceptionInst << 12) | (io.bits.hasNMI << 11) | (io.bits.virtualInterruptIsHvictlInject << 10) | (io.bits.irToHS << 9) | (io.bits.irToVS << 8) | io.bits.coreid)#[0..=172])
}
