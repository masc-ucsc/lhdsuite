pub comb CVT32ModuleS2::[timecheck=false](io_s2In:(result:u32, fflags:u5)) -> (io_s2Out:(result:u32, fflags:u5)) {
  mut `io.s2In` = ((io_s2In.result << 5) | io_s2In.fflags)#[0..=36]
  mut `io.s2Out` = `io.s2In`#[0..=36]
  const t12 = `io.s2Out`
  mut `io_s2Out__bpo.result` = t12#[5..=36]
  mut `io_s2Out__bpo.fflags` = t12#[0..=4]
  io_s2Out.result = `io_s2Out__bpo.result`
  io_s2Out.fflags = `io_s2Out__bpo.fflags`
}
