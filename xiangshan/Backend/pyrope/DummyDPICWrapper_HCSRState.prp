const DiffExtHCSRState = import("DiffExtHCSRState.DiffExtHCSRState")

pub mod DummyDPICWrapper_HCSRState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(virtMode:u64, mtval2:u64, mtinst:u64, hstatus:u64, hideleg:u64, hedeleg:u64, hcounteren:u64, htval:u64, htinst:u64, hgatp:u64, vsstatus:u64, vstvec:u64, vsepc:u64, vscause:u64, vstval:u64, vsatp:u64, vsscratch:u64, coreid:u8))) -> () {
  mut dpic = DiffExtHCSRState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x448) | (io.bits.virtMode << 0x408) | (io.bits.mtval2 << 0x3c8) | (io.bits.mtinst << 0x388) | (io.bits.hstatus << 0x348) | (io.bits.hideleg << 0x308) | (io.bits.hedeleg << 0x2c8) | (io.bits.hcounteren << 0x288) | (io.bits.htval << 0x248) | (io.bits.htinst << 0x208) | (io.bits.hgatp << 0x1c8) | (io.bits.vsstatus << 0x188) | (io.bits.vstvec << 0x148) | (io.bits.vsepc << 0x108) | (io.bits.vscause << 0xc8) | (io.bits.vstval << 0x88) | (io.bits.vsatp << 0x48) | (io.bits.vsscratch << 8) | io.bits.coreid)#[0..=1095])
}
