pub mod PipelineStallReason::[timecheck=false](`clock`:Clock, io_prePipeStall:U1, io_prePipeStallReason:U7, io_prePipeBubble:U1, io_prePipeBubbleReason:U7, io_redirect:U1, io_redirectReason:U7, io_currentPipeStall:U1, io_currentPipeStallReason:U7) -> (io_outReason:U7@[]) {
  wire io:(rightFire:U1, rightHasFire:U1, prePipeStall:U1, prePipeStallReason:U7, prePipeBubble:U1, prePipeBubbleReason:U7, redirect:U1, redirectReason:U7, currentPipeStall:U1, currentPipeStallReason:U7, currentPipeBubble:U1, currentPipeBubbleReason:U7, outReason:U7) = nil
  reg redirectReg:U1
  reg redirectReasonReg:U7
  reg prePipeStallReg:U1
  reg prePipeStallReasonReg:U7
  reg currentPipeStallReg:U1
  reg currentPipeStallReasonReg:U7
  wire _reasonNext_T:U7 = nil
  wire _GEN:U7 = nil
  wire _GEN_0:U7 = nil
  wire _GEN_1:U7 = nil
  wire reasonNext:U7 = nil
  mut _mux_1:U7 = if io.redirect != 0 { io.redirectReason#[0..<7] } else { redirectReasonReg#[0..<7] }
  _reasonNext_T = _mux_1
  mut _mux_2:U7 = if io.prePipeBubble != 0 { io.prePipeBubbleReason#[0..<7] } else { 0 }
  _GEN = _mux_2
  mut _mux_3:U7 = if currentPipeStallReg != 0 { currentPipeStallReasonReg#[0..<7] } else { _GEN#[0..<7] }
  _GEN_0 = _mux_3
  mut _mux_4:U7 = if prePipeStallReg != 0 { prePipeStallReasonReg#[0..<7] } else { _GEN_0#[0..<7] }
  _GEN_1 = _mux_4
  mut _mux_5:U7 = if ((io.redirect | redirectReg) & 1) != 0 { _reasonNext_T#[0..<7] } else { _GEN_1#[0..<7] }
  reasonNext = _mux_5
  io.rightFire = 0
  io.rightHasFire = 0
  io.prePipeStall = io_prePipeStall & 1
  io.prePipeStallReason = io_prePipeStallReason#[0..<7]
  io.prePipeBubble = io_prePipeBubble & 1
  io.prePipeBubbleReason = io_prePipeBubbleReason#[0..<7]
  io.redirect = io_redirect & 1
  io.redirectReason = io_redirectReason#[0..<7]
  io.currentPipeStall = io_currentPipeStall & 1
  io.currentPipeStallReason = io_currentPipeStallReason#[0..<7]
  io.currentPipeBubble = 0
  io.currentPipeBubbleReason = 0
  io.outReason = reasonNext#[0..<7]
  redirectReg = io.redirect
  redirectReasonReg = io.redirectReason
  prePipeStallReg = io.prePipeStall
  prePipeStallReasonReg = io.prePipeStallReason
  currentPipeStallReg = io.currentPipeStall
  currentPipeStallReasonReg = io.currentPipeStallReason
  io_outReason = io.outReason
}
