pub mod PipelineStallReason::[timecheck=false](clock:u1, io_prePipeStall:u1, io_prePipeStallReason:u7, io_prePipeBubble:u1, io_prePipeBubbleReason:u7, io_redirect:u1, io_redirectReason:u7, io_currentPipeStall:u1, io_currentPipeStallReason:u7) -> (io_outReason:u7@[]) {
  wire io:(rightFire:u1, rightHasFire:u1, prePipeStall:u1, prePipeStallReason:u7, prePipeBubble:u1, prePipeBubbleReason:u7, redirect:u1, redirectReason:u7, currentPipeStall:u1, currentPipeStallReason:u7, currentPipeBubble:u1, currentPipeBubbleReason:u7, outReason:u7) = nil
  reg redirectReg:u1
  reg redirectReasonReg:u7
  reg prePipeStallReg:u1
  reg prePipeStallReasonReg:u7
  reg currentPipeStallReg:u1
  reg currentPipeStallReasonReg:u7
  mut _mux_1:u7 = if io.redirect != 0 { io.redirectReason#[0..=6] } else { redirectReasonReg }
  mut _mux_2:u7 = if io.prePipeBubble != 0 { io.prePipeBubbleReason#[0..=6] } else { 0 }
  mut _mux_3:u7 = if currentPipeStallReg != 0 { currentPipeStallReasonReg } else { _mux_2 }
  mut _mux_4:u7 = if prePipeStallReg != 0 { prePipeStallReasonReg } else { _mux_3 }
  mut _mux_5:u7 = if ((io.redirect | redirectReg) & 1) != 0 { _mux_1 } else { _mux_4 }
  io.prePipeStall = io_prePipeStall & 1
  io.prePipeStallReason = io_prePipeStallReason
  io.prePipeBubble = io_prePipeBubble & 1
  io.prePipeBubbleReason = io_prePipeBubbleReason
  io.redirect = io_redirect & 1
  io.redirectReason = io_redirectReason
  io.currentPipeStall = io_currentPipeStall & 1
  io.currentPipeStallReason = io_currentPipeStallReason
  io.outReason = _mux_5
  redirectReg = io.redirect
  redirectReasonReg = io.redirectReason
  prePipeStallReg = io.prePipeStall
  prePipeStallReasonReg = io.prePipeStallReason
  currentPipeStallReg = io.currentPipeStall
  currentPipeStallReasonReg = io.currentPipeStallReason
  io_outReason = io.outReason
}
