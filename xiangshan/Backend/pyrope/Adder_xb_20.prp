pub comb Adder_xb_20::[timecheck=false](io_in1:U8, io_in2:U8, io_cin:U1) -> (io_cout:U1) {
  wire io:(in1:U8, in2:U8, cin:U1, cout:U1) = nil
  wire bits:U10 = nil
  bits = (((io.in1#[0..<8] << 1) | (io.cin & 1)) + ((io.in2#[0..<8] << 1) | (io.cin & 1)))#[0..<10]
  io.in1 = io_in1#[0..<8]
  io.in2 = io_in2#[0..<8]
  io.cin = io_cin & 1
  io.cout = bits#[9..<10]
  io_cout = io.cout
}
