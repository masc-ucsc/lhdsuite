pub mod SatpModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(MODE:U4, ASID:U16, PPN:U44)@[]) {
  mut _GEN:U1 = 0
  mut _mux_4:U44 = 0
  mut _mux_5:U16 = 0
  mut _mux_6:U4 = 0
  mut t18 = 0
  mut t19 = 0
  mut t20 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN_0:U44
  reg _GEN_1:U16
  reg _GEN_2:U4
  wire `regOut__bpr.MODE`:U4 = nil
  wire `regOut__bpr.ASID`:U16 = nil
  wire `regOut__bpr.PPN`:U44 = nil
  mut `reg_init.MODE` = 0
  mut `reg_init.ASID` = 0
  mut `reg_init.PPN` = 0
  mut `wdata.MODE` = w.wdata#[60..<0x40]
  mut `wdata.ASID` = w.wdata#[44..<60]
  mut `wdata.PPN` = w.wdata#[0..<44]
  t18 = _GEN_0
  t19 = _GEN_1
  t20 = _GEN_2
  if not (`reset` != 0) {
    _GEN = 0ub?
    _GEN = w.wen & (((U1(`wdata.MODE` == 0) | U1(`wdata.MODE` == 8)) & 1) | U1(`wdata.MODE` == 9)) & 1 & 1
    _mux_4 = if _GEN != 0 { `wdata.PPN`#[0..<36] } else { reg_0#[0..<44] }
    t18 = _mux_4
    _mux_5 = if _GEN != 0 { `wdata.ASID`#[0..<16] } else { reg_0#[44..<60] }
    t19 = _mux_5
    _mux_6 = if _GEN != 0 { `wdata.MODE`#[0..<4] } else { reg_0#[60..<0x40] }
    t20 = _mux_6
    reg_0 = t18 | (t19 << 44) | (t20 << 60)
  }
  _GEN_0 = t18
  _GEN_1 = t19
  _GEN_2 = t20
  mut `regOut__bpo.MODE` = reg_0#[60..<0x40]
  mut `regOut__bpo.ASID` = reg_0#[44..<60]
  mut `regOut__bpo.PPN` = reg_0#[0..<44]
  const t58 = `regOut__bpo.MODE`
  `regOut__bpr.MODE` = t58
  regOut.MODE = t58
  const t59 = `regOut__bpo.ASID`
  `regOut__bpr.ASID` = t59
  regOut.ASID = t59
  const t60 = `regOut__bpo.PPN`
  `regOut__bpr.PPN` = t60
  regOut.PPN = t60
  rdata = (reg_0#[60..<0x40] << 60) | (reg_0#[44..<60] << 44) | reg_0#[0..<44]
}
