pub mod SatpModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(MODE:u4, ASID:u16, PPN:u44)@[]) {
  reg reg_0:u64:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.MODE` = 0
  mut `reg_init.ASID` = 0
  mut `reg_init.PPN` = 0
  mut `wdata.MODE` = w.wdata#[60..=63]
  mut `wdata.ASID` = w.wdata#[44..=59]
  mut `wdata.PPN` = w.wdata#[0..=43]
  const _GEN__w1 = w.wen & (((unsigned(`wdata.MODE` == 0) | unsigned(`wdata.MODE` == 8)) & 1) | unsigned(`wdata.MODE` == 9)) & 1 & 1
  mut _mux_4:u44 = if _GEN__w1 != 0 { `wdata.PPN`#[0..=35] } else { reg_0#[0..=43] }
  mut _mux_5:u16 = if _GEN__w1 != 0 { `wdata.ASID`#[0..=15] } else { reg_0#[44..=59] }
  mut _mux_6:u4 = if _GEN__w1 != 0 { `wdata.MODE`#[0..=3] } else { reg_0#[60..=63] }
  reg_0 = _mux_4 | (_mux_5 << 44) | (_mux_6 << 60)
  mut `regOut__bpo.MODE` = reg_0#[60..=63]
  mut `regOut__bpo.ASID` = reg_0#[44..=59]
  mut `regOut__bpo.PPN` = reg_0#[0..=43]
  regOut.MODE = `regOut__bpo.MODE`
  regOut.ASID = `regOut__bpo.ASID`
  regOut.PPN = `regOut__bpo.PPN`
  rdata = (reg_0#[60..=63] << 60) | (reg_0#[44..=59] << 44) | reg_0#[0..=43]
}
