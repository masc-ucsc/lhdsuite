  reg io_perf_6_value_REG_1:u6
  reg io_perf_7_value_REG:u6
  reg io_perf_7_value_REG_1:u6
  const io__w1 = io_events_sets | (io_hpm_event << 0x1a4)
  mut `_GEN.value` = io_perf_7_value_REG_1
  mut `_GEN_0.value` = io_perf_6_value_REG_1
  mut `_GEN_1.value` = io_perf_5_value_REG_1
  mut `_GEN_2.value` = io_perf_4_value_REG_1
