const HPerfCounter_13 = import("HPerfCounter_13.HPerfCounter_13")

pub mod HPerfMonitor_2::[timecheck=false](clock:u1, io_hpm_event:u512, io_events_sets:u420) -> (io_perf:u48@[]) {
  reg io_perf_0_value_REG:u6
  reg io_perf_0_value_REG_1:u6
