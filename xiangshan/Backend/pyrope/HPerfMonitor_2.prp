  const t42 = io__w1#[0..=419]
  mut perfEvents_hpc_7 = HPerfCounter_13::[name=perfEvents_hpc_7](clock = clock, io_hpm_event = io__w1#[420..=931]#[448..=511], io_events_sets = t42)
  io_perf_0_value_REG = perfEvents_hpc#[0..=5]
  io_perf_1_value_REG = perfEvents_hpc_1#[0..=5]
  io_perf_2_value_REG = perfEvents_hpc_2#[0..=5]
  io_perf_3_value_REG = perfEvents_hpc_3#[0..=5]
