  mut `_GEN_5.value` = io_perf_1_value_REG_1
  mut `_GEN_6.value` = io_perf_0_value_REG_1
  io_perf_0_value_REG_1 = io_perf_0_value_REG
  io_perf_1_value_REG_1 = io_perf_1_value_REG
  io_perf_2_value_REG_1 = io_perf_2_value_REG
  io_perf_3_value_REG_1 = io_perf_3_value_REG
  io_perf_4_value_REG_1 = io_perf_4_value_REG
  io_perf_5_value_REG_1 = io_perf_5_value_REG
  io_perf_6_value_REG_1 = io_perf_6_value_REG
  io_perf_7_value_REG_1 = io_perf_7_value_REG
  const t21 = io__w1#[0..=419]
  mut perfEvents_hpc = HPerfCounter_13::[name=perfEvents_hpc](clock = clock, io_hpm_event = io__w1#[420..=931]#[0..=63], io_events_sets = t21)
  const t24 = io__w1#[0..=419]
  mut perfEvents_hpc_1 = HPerfCounter_13::[name=perfEvents_hpc_1](clock = clock, io_hpm_event = io__w1#[420..=931]#[64..=127], io_events_sets = t24)
  const t27 = io__w1#[0..=419]
  mut perfEvents_hpc_2 = HPerfCounter_13::[name=perfEvents_hpc_2](clock = clock, io_hpm_event = io__w1#[420..=931]#[128..=191], io_events_sets = t27)
  const t30 = io__w1#[0..=419]
  mut perfEvents_hpc_3 = HPerfCounter_13::[name=perfEvents_hpc_3](clock = clock, io_hpm_event = io__w1#[420..=931]#[192..=255], io_events_sets = t30)
  const t33 = io__w1#[0..=419]
  mut perfEvents_hpc_4 = HPerfCounter_13::[name=perfEvents_hpc_4](clock = clock, io_hpm_event = io__w1#[420..=931]#[256..=319], io_events_sets = t33)
