pub mod Tdata2Module::[timecheck=false](`clock`:Clock, w:(wen:U1, wdata:U64), tdataRead:(tdata1:U64, tdata2:U64, tdata3:U64)) -> (rdata:U64@[], regOut:(ALL:U64)@[]) {
  reg reg_0:U64
  wire `regOut__bpr.ALL`:U64 = nil
  mut `wdata.ALL` = w.wdata#[0..<0x40]
  mut _mux_1:U64 = if w.wen != 0 { `wdata.ALL`#[0..<0x40] } else { reg_0#[0..<0x40] }
  reg_0 = _mux_1
  mut `regOut__bpo.ALL` = tdataRead.tdata2#[0..<0x40]
  const t13 = `regOut__bpo.ALL`
  `regOut__bpr.ALL` = t13
  regOut.ALL = t13
  rdata = tdataRead.tdata2
}
