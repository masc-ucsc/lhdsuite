pub mod StopeiModule::[timecheck=false](clock:u1, w:(wen:u1, wdata:u64), aiaToCSR:(rdata:(valid:u1, bits:(data:u64, illegal:u1)), meip:u1, seip:u1, notice_pending:u1, vseip:u7, mtopei:(IID:u11, IPRIO:u11), stopei:(IID:u11, IPRIO:u11), vstopei:(IID:u11, IPRIO:u11))) -> (rdata:u64@[], regOut:(IID:u11, IPRIO:u11)@[]) {
  reg reg_0:u22
  mut `wdata.IID` = w.wdata#[16..=26]
  mut `wdata.IPRIO` = w.wdata#[0..=10]
  mut _mux_1:u11 = if w.wen != 0 { `wdata.IID`#[0..=10] } else { reg_0#[11..=21] }
  mut _mux_2:u11 = if w.wen != 0 { `wdata.IPRIO`#[0..=10] } else { reg_0#[0..=10] }
  reg_0 = _mux_2 | (_mux_1 << 11)
  mut `regOut__bpo.IID` = ((aiaToCSR.rdata.valid << 0x8d) | (aiaToCSR.rdata.bits.data << 0x4d) | (aiaToCSR.rdata.bits.illegal << 0x4c) | (aiaToCSR.meip << 0x4b) | (aiaToCSR.seip << 0x4a) | (aiaToCSR.notice_pending << 0x49) | (aiaToCSR.vseip << 0x42) | (aiaToCSR.mtopei.IID << 55) | (aiaToCSR.mtopei.IPRIO << 44) | (aiaToCSR.stopei.IID << 33) | (aiaToCSR.stopei.IPRIO << 22) | (aiaToCSR.vstopei.IID << 11) | aiaToCSR.vstopei.IPRIO)#[22..=43]#[11..=21]
  mut `regOut__bpo.IPRIO` = ((aiaToCSR.rdata.valid << 0x8d) | (aiaToCSR.rdata.bits.data << 0x4d) | (aiaToCSR.rdata.bits.illegal << 0x4c) | (aiaToCSR.meip << 0x4b) | (aiaToCSR.seip << 0x4a) | (aiaToCSR.notice_pending << 0x49) | (aiaToCSR.vseip << 0x42) | (aiaToCSR.mtopei.IID << 55) | (aiaToCSR.mtopei.IPRIO << 44) | (aiaToCSR.stopei.IID << 33) | (aiaToCSR.stopei.IPRIO << 22) | (aiaToCSR.vstopei.IID << 11) | aiaToCSR.vstopei.IPRIO)#[22..=43]#[0..=10]
  regOut.IID = `regOut__bpo.IID`
  regOut.IPRIO = `regOut__bpo.IPRIO`
  rdata = (aiaToCSR.stopei.IID#[0..=10] << 16) | aiaToCSR.stopei.IPRIO#[0..=10]
}
