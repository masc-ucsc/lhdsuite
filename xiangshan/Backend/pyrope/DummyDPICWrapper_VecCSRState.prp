const DiffExtVecCSRState = import("DiffExtVecCSRState.DiffExtVecCSRState")

pub mod DummyDPICWrapper_VecCSRState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(vstart:u64, vxsat:u64, vxrm:u64, vcsr:u64, vl:u64, vtype:u64, vlenb:u64, coreid:u8))) -> () {
  mut dpic = DiffExtVecCSRState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x1c8) | (io.bits.vstart << 0x188) | (io.bits.vxsat << 0x148) | (io.bits.vxrm << 0x108) | (io.bits.vcsr << 0xc8) | (io.bits.vl << 0x88) | (io.bits.vtype << 0x48) | (io.bits.vlenb << 8) | io.bits.coreid)#[0..=455])
}
