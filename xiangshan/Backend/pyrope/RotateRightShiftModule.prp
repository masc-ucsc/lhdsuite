pub comb RotateRightShiftModule::[timecheck=false](io_shamt:u6, io_rorSrc:u64) -> (io_ror:u64) {
  wire io:(shamt:u6, rorSrc:u64, ror:u64) = nil
  mut _mux_1:u64 = if ((io.shamt >> 5) & 1) != 0 { (io.rorSrc#[0..=31] << 32) | io.rorSrc#[32..=63] } else { io.rorSrc#[0..=63] }
  const io_ror_shifted__w1 = _mux_1
  mut _mux_2:u64 = if ((io.shamt >> 4) & 1) != 0 { (io_ror_shifted__w1#[0..=15] << 48) | io_ror_shifted__w1#[16..=63] } else { io_ror_shifted__w1 }
  const io_ror_shifted_1__w1 = _mux_2
  mut _mux_3:u64 = if ((io.shamt >> 3) & 1) != 0 { (io_ror_shifted_1__w1#[0..=7] << 56) | io_ror_shifted_1__w1#[8..=63] } else { io_ror_shifted_1__w1 }
  const io_ror_shifted_2__w1 = _mux_3
  mut _mux_4:u64 = if ((io.shamt >> 2) & 1) != 0 { (io_ror_shifted_2__w1#[0..=3] << 60) | io_ror_shifted_2__w1#[4..=63] } else { io_ror_shifted_2__w1 }
  const io_ror_shifted_3__w1 = _mux_4
  mut _mux_5:u64 = if ((io.shamt >> 1) & 1) != 0 { (io_ror_shifted_3__w1#[0..=1] << 62) | io_ror_shifted_3__w1#[2..=63] } else { io_ror_shifted_3__w1 }
  const io_ror_shifted_4__w1 = _mux_5
  mut _mux_6:u64 = if (io.shamt & 1) != 0 { ((io_ror_shifted_4__w1 & 1) << 63) | io_ror_shifted_4__w1#[1..=63] } else { io_ror_shifted_4__w1 }
  io.shamt = io_shamt
  io.rorSrc = io_rorSrc
  io.ror = _mux_6
  io_ror = io.ror
}
