pub comb RotateRightShiftModule::[timecheck=false](io_shamt:U6, io_rorSrc:U64) -> (io_ror:U64) {
  wire io:(shamt:U6, rorSrc:U64, ror:U64) = nil
  wire io_ror_shifted:U64 = nil
  wire io_ror_shifted_1:U64 = nil
  wire io_ror_shifted_2:U64 = nil
  wire io_ror_shifted_3:U64 = nil
  wire io_ror_shifted_4:U64 = nil
  wire io_ror_shifted_5:U64 = nil
  mut _mux_1:U64 = if io.shamt#[5..<6] != 0 { (io.rorSrc#[0..<32] << 32) | io.rorSrc#[32..<0x40] } else { io.rorSrc#[0..<0x40] }
  io_ror_shifted = _mux_1
  mut _mux_2:U64 = if io.shamt#[4..<5] != 0 { (io_ror_shifted#[0..<16] << 48) | io_ror_shifted#[16..<0x40] } else { io_ror_shifted#[0..<0x40] }
  io_ror_shifted_1 = _mux_2
  mut _mux_3:U64 = if io.shamt#[3..<4] != 0 { (io_ror_shifted_1#[0..<8] << 56) | io_ror_shifted_1#[8..<0x40] } else { io_ror_shifted_1#[0..<0x40] }
  io_ror_shifted_2 = _mux_3
  mut _mux_4:U64 = if io.shamt#[2..<3] != 0 { (io_ror_shifted_2#[0..<4] << 60) | io_ror_shifted_2#[4..<0x40] } else { io_ror_shifted_2#[0..<0x40] }
  io_ror_shifted_3 = _mux_4
  mut _mux_5:U64 = if io.shamt#[1..<2] != 0 { (io_ror_shifted_3#[0..<2] << 62) | io_ror_shifted_3#[2..<0x40] } else { io_ror_shifted_3#[0..<0x40] }
  io_ror_shifted_4 = _mux_5
  mut _mux_6:U64 = if (io.shamt & 1) != 0 { ((io_ror_shifted_4 & 1) << 63) | io_ror_shifted_4#[1..<0x40] } else { io_ror_shifted_4#[0..<0x40] }
  io_ror_shifted_5 = _mux_6
  io.shamt = io_shamt#[0..<6]
  io.rorSrc = io_rorSrc#[0..<0x40]
  io.ror = io_ror_shifted_5#[0..<0x40]
  io_ror = io.ror
}
