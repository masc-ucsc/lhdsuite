pub mod DelayN_153::[timecheck=false](clock:u1, io_in:(flag:u1, value:u9)) -> (io_out:(flag:u1, value:u9)@[]) {
  reg REG:u10
  reg REG_1:u10
  mut `io.in` = ((io_in.flag << 9) | io_in.value)#[0..=9]
  mut `io.out` = REG_1
  REG = `io.in`
  REG_1 = REG
  const t12 = `io.out`
  mut `io_out__bpo.flag` = (t12 >> 9) & 1
  mut `io_out__bpo.value` = t12#[0..=8]
  io_out.flag = `io_out__bpo.flag`
  io_out.value = `io_out__bpo.value`
}
