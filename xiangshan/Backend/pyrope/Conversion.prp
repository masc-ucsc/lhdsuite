pub comb Conversion::[timecheck=false](io_q_j_1:u5, io_pre_q_A:u16, io_pre_q_B:u16) -> (io_nxt_q_A:u16, io_nxt_q_B:u16) {
  wire io:(q_j_1:u5, pre_q_A:u16, pre_q_B:u16, nxt_q_A:u16, nxt_q_B:u16) = nil
  wire new_q_A:(e4:u16, e3:u16, e2:u16, e1:u16, e0:u16) = nil
  wire new_q_B:(e4:u16, e3:u16, e2:u16, e1:u16, e0:u16) = nil
  const tmp_q_A__w1 = io.pre_q_A#[0..=13]
  const tmp_q_B__w1 = io.pre_q_B#[0..=13]
  const _new_q_B_T__w1 = (tmp_q_A__w1 << 2) | 1
  const _new_q_B_T_1__w1 = tmp_q_A__w1 << 2
  const _new_q_B_T_2__w1 = (tmp_q_B__w1 << 2) | 3
  const _new_q_B_T_3__w1 = (tmp_q_B__w1 << 2) | 2
  new_q_A.e4 = _new_q_B_T_3__w1
  new_q_A.e3 = _new_q_B_T_2__w1
  new_q_A.e2 = _new_q_B_T_1__w1
  new_q_A.e1 = _new_q_B_T__w1
  new_q_A.e0 = ((tmp_q_A__w1 << 2) | 2)
  new_q_B.e4 = ((tmp_q_B__w1 << 2) | 1)
  new_q_B.e3 = _new_q_B_T_3__w1
  new_q_B.e2 = _new_q_B_T_2__w1
  new_q_B.e1 = _new_q_B_T_1__w1
  new_q_B.e0 = _new_q_B_T__w1
  mut _mux_1:u16 = if (io.q_j_1 & 1) != 0 { new_q_A.e0#[0..=15] } else { 0 }
  mut _mux_2:u16 = if ((io.q_j_1 >> 1) & 1) != 0 { new_q_A.e1#[0..=15] } else { 0 }
  mut _mux_3:u16 = if ((io.q_j_1 >> 2) & 1) != 0 { new_q_A.e2#[0..=15] } else { 0 }
  mut _mux_4:u16 = if ((io.q_j_1 >> 3) & 1) != 0 { new_q_A.e3#[0..=15] } else { 0 }
  mut _mux_5:u16 = if ((io.q_j_1 >> 4) & 1) != 0 { new_q_A.e4#[0..=15] } else { 0 }
  mut _mux_6:u16 = if (io.q_j_1 & 1) != 0 { new_q_B.e0#[0..=15] } else { 0 }
  mut _mux_7:u16 = if ((io.q_j_1 >> 1) & 1) != 0 { new_q_B.e1#[0..=15] } else { 0 }
  mut _mux_8:u16 = if ((io.q_j_1 >> 2) & 1) != 0 { new_q_B.e2#[0..=15] } else { 0 }
  mut _mux_9:u16 = if ((io.q_j_1 >> 3) & 1) != 0 { new_q_B.e3#[0..=15] } else { 0 }
  mut _mux_10:u16 = if ((io.q_j_1 >> 4) & 1) != 0 { new_q_B.e4#[0..=15] } else { 0 }
  io.q_j_1 = io_q_j_1
  io.pre_q_A = io_pre_q_A
  io.pre_q_B = io_pre_q_B
  io.nxt_q_A = (((_mux_1 | _mux_2) | _mux_3) | _mux_4) | _mux_5
  io.nxt_q_B = (((_mux_6 | _mux_7) | _mux_8) | _mux_9) | _mux_10
  io_nxt_q_A = io.nxt_q_A
  io_nxt_q_B = io.nxt_q_B
}
