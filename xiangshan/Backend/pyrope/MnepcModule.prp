pub mod MnepcModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), trapToMN:(privState:(valid:u1, bits:(PRVM:u2, V:u1)), mnstatus:(valid:u1, bits:(NMIE:u1, MNPV:u1, MNPELP:u1, MNPP:u2)), mnepc:(valid:u1, bits:(epc:u63)), mncause:(valid:u1, bits:(Interrupt:u1, ExceptionCode:u63)))) -> (rdata:u64@[], regOut:(epc:u63)@[]) {
  reg reg_0:u63:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.epc` = 0
  mut `wdata.epc` = w.wdata#[1..=63]
  mut _mux_1:u63 = if trapToMN.mnepc.valid != 0 { trapToMN.mnepc.bits.epc#[0..=62] } else { 0 }
  mut _mux_2:u63 = if w.wen != 0 { `wdata.epc`#[0..=62] } else { 0 }
  mut _mux_3:u63 = if ((w.wen | trapToMN.mnepc.valid) & 1) != 0 { _mux_1 | _mux_2 } else { reg_0 }
  reg_0 = _mux_3
  mut `regOut__bpo.epc` = reg_0
  regOut.epc = `regOut__bpo.epc`
  rdata = reg_0 << 1
}
