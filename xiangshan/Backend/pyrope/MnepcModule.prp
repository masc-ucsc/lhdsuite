pub mod MnepcModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), trapToMN:(privState:(valid:U1, bits:(PRVM:U2, V:U1)), mnstatus:(valid:U1, bits:(NMIE:U1, MNPV:U1, MNPELP:U1, MNPP:U2)), mnepc:(valid:U1, bits:(epc:U63)), mncause:(valid:U1, bits:(Interrupt:U1, ExceptionCode:U63)))) -> (rdata:U64@[], regOut:(epc:U63)@[]) {
  mut _mux_3:U63 = 0
  mut t20 = 0
  reg reg_0:U63:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U63
  wire `regOut__bpr.epc`:U63 = nil
  mut `reg_init.epc` = 0
  mut `wdata.epc` = w.wdata#[1..<0x40]
  mut _mux_1:U63 = if trapToMN.mnepc.valid != 0 { trapToMN.mnepc.bits.epc#[0..<63] } else { 0 }
  mut _mux_2:U63 = if w.wen != 0 { `wdata.epc`#[0..<63] } else { 0 }
  t20 = _GEN
  if not (`reset` != 0) {
    _mux_3 = if ((w.wen | trapToMN.mnepc.valid) & 1) != 0 { (_mux_1 | _mux_2)#[0..<63]#[0..<63] } else { reg_0#[0..<63] }
    t20 = _mux_3
    reg_0 = t20
  }
  _GEN = t20
  mut `regOut__bpo.epc` = reg_0#[0..<63]
  const t31 = `regOut__bpo.epc`
  `regOut__bpr.epc` = t31
  regOut.epc = t31
  rdata = reg_0#[0..<63] << 1
}
