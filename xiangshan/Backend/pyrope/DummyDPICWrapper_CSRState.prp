const DiffExtCSRState = import("DiffExtCSRState.DiffExtCSRState")

pub mod DummyDPICWrapper_CSRState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(privilegeMode:u64, mstatus:u64, sstatus:u64, mepc:u64, sepc:u64, mtval:u64, stval:u64, mtvec:u64, stvec:u64, mcause:u64, scause:u64, satp:u64, mip:u64, mie:u64, mscratch:u64, sscratch:u64, mideleg:u64, medeleg:u64, coreid:u8))) -> () {
  mut dpic = DiffExtCSRState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x488) | (io.bits.privilegeMode << 0x448) | (io.bits.mstatus << 0x408) | (io.bits.sstatus << 0x3c8) | (io.bits.mepc << 0x388) | (io.bits.sepc << 0x348) | (io.bits.mtval << 0x308) | (io.bits.stval << 0x2c8) | (io.bits.mtvec << 0x288) | (io.bits.stvec << 0x248) | (io.bits.mcause << 0x208) | (io.bits.scause << 0x1c8) | (io.bits.satp << 0x188) | (io.bits.mip << 0x148) | (io.bits.mie << 0x108) | (io.bits.mscratch << 0xc8) | (io.bits.sscratch << 0x88) | (io.bits.mideleg << 0x48) | (io.bits.medeleg << 8) | io.bits.coreid)#[0..=1159])
}
