pub mod DelayReg_8::[timecheck=false](clock:u1, reset:u1, i:(value:u256, coreid:u8)) -> (o:(value:u256, coreid:u8)@[]) {
  reg r_1:u264:[init=0, reset_pin=ref reset, async=true]
  reg r_2:u264:[init=0, reset_pin=ref reset, async=true]
  const t8 = (i.value << 8) | i.coreid
  mut `r.value` = t8#[8..=263]
  mut `r.coreid` = t8#[0..=7]
  r_1 = (`r.value` << 8) | `r.coreid`
  r_2 = r_1
  mut `o__bpo.value` = r_2#[8..=263]
  mut `o__bpo.coreid` = r_2#[0..=7]
  o.value = `o__bpo.value`
  o.coreid = `o__bpo.coreid`
}
