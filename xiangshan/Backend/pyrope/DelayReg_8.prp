pub mod DelayReg_8::[timecheck=false](`clock`:Clock, `reset`:U1, i:(value:U256, coreid:U8)) -> (o:(value:U256, coreid:U8)@[]) {
  reg r_1:U264:[initial=0, reset_pin=`reset`, async=true]
  reg r_2:U264:[initial=0, reset_pin=`reset`, async=true]
  wire `o__bpr.value`:U256 = nil
  wire `o__bpr.coreid`:U8 = nil
  const t8 = (i.value << 8) | i.coreid
  mut `r.value` = t8#[8..<0x108]
  mut `r.coreid` = t8#[0..<8]
  if not (`reset` != 0) {
    r_1 = (`r.value` << 8) | `r.coreid`
  }
  if not (`reset` != 0) {
    r_2 = r_1
  }
  mut `o__bpo.value` = r_2#[8..<0x108]
  mut `o__bpo.coreid` = r_2#[0..<8]
  const t21 = `o__bpo.value`
  `o__bpr.value` = t21
  o.value = t21
  const t22 = `o__bpo.coreid`
  `o__bpr.coreid` = t22
  o.coreid = t22
}
