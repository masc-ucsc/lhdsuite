pub mod VtypeModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), robCommit:(instNum:(valid:U1, bits:U7), fflags:(valid:U1, bits:U5), fsDirty:U1, vxsat:(valid:U1, bits:U1), vsDirty:U1, vtype:(valid:U1, bits:(VILL:U1, VMA:U1, VTA:U1, VSEW:U3, VLMUL:U3)), vl:U8, vstart:(valid:U1, bits:U7))) -> (rdata:U64@[]) {
  mut _mux_1:U3 = 0
  mut _mux_2:U3 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U1 = 0
  mut _mux_5:U1 = 0
  mut t23 = 0
  mut t24 = 0
  mut t25 = 0
  mut t26 = 0
  mut t27 = 0
  reg reg_0:U9:[initial=256, reset_pin=`reset`, async=true]
  reg _GEN:U3
  reg _GEN_0:U3
  reg _GEN_1:U1
  reg _GEN_2:U1
  reg _GEN_3:U1
  mut `reg_init.VILL` = 1
  mut `reg_init.VMA` = 0
  mut `reg_init.VTA` = 0
  mut `reg_init.VSEW` = 0
  mut `reg_init.VLMUL` = 0
  mut `wdata.VILL` = w.wdata#[63..<0x40]
  mut `wdata.VMA` = w.wdata#[7..<8]
  mut `wdata.VTA` = w.wdata#[6..<7]
  mut `wdata.VSEW` = w.wdata#[3..<6]
  mut `wdata.VLMUL` = w.wdata#[0..<3]
  t23 = _GEN
  t24 = _GEN_0
  t25 = _GEN_1
  t26 = _GEN_2
  t27 = _GEN_3
  if not (`reset` != 0) {
    _mux_1 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VLMUL#[0..<3] } else { reg_0#[0..<3] }
    t23 = _mux_1
    _mux_2 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VSEW#[0..<3] } else { reg_0#[3..<6] }
    t24 = _mux_2
    _mux_3 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VTA & 1 } else { reg_0#[6..<7] }
    t25 = _mux_3
    _mux_4 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VMA & 1 } else { reg_0#[7..<8] }
    t26 = _mux_4
    _mux_5 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VILL & 1 } else { reg_0#[8..<9] }
    t27 = _mux_5
    reg_0 = t23 | (t24 << 3) | (t25 << 6) | (t26 << 7) | (t27 << 8)
  }
  _GEN = t23
  _GEN_0 = t24
  _GEN_1 = t25
  _GEN_2 = t26
  _GEN_3 = t27
  rdata = (reg_0#[8..<9] << 63) | (reg_0#[7..<8] << 7) | (reg_0#[6..<7] << 6) | (reg_0#[3..<6] << 3) | reg_0#[0..<3]
}
