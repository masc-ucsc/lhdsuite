pub mod VtypeModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), robCommit:(instNum:(valid:u1, bits:u7), fflags:(valid:u1, bits:u5), fsDirty:u1, vxsat:(valid:u1, bits:u1), vsDirty:u1, vtype:(valid:u1, bits:(VILL:u1, VMA:u1, VTA:u1, VSEW:u3, VLMUL:u3)), vl:u8, vstart:(valid:u1, bits:u7))) -> (rdata:u64@[]) {
  reg reg_0:u9:[init=256, reset_pin=ref reset, async=true]
  mut `reg_init.VILL` = 0
  mut `reg_init.VMA` = 0
  mut `reg_init.VTA` = 0
  mut `reg_init.VSEW` = 0
  mut `reg_init.VLMUL` = 0
  mut `wdata.VILL` = (w.wdata >> 63) & 1
  mut `wdata.VMA` = (w.wdata >> 7) & 1
  mut `wdata.VTA` = (w.wdata >> 6) & 1
  mut `wdata.VSEW` = w.wdata#[3..=5]
  mut `wdata.VLMUL` = w.wdata#[0..=2]
  mut _mux_1:u3 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VLMUL#[0..=2] } else { reg_0#[0..=2] }
  mut _mux_2:u3 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VSEW#[0..=2] } else { reg_0#[3..=5] }
  mut _mux_3:u1 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VTA & 1 } else { (reg_0 >> 6) & 1 }
  mut _mux_4:u1 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VMA & 1 } else { (reg_0 >> 7) & 1 }
  mut _mux_5:u1 = if robCommit.vtype.valid != 0 { robCommit.vtype.bits.VILL & 1 } else { (reg_0 >> 8) & 1 }
  reg_0 = _mux_1 | (_mux_2 << 3) | (_mux_3 << 6) | (_mux_4 << 7) | (_mux_5 << 8)
  rdata = (((reg_0 >> 8) & 1) << 63) | (((reg_0 >> 7) & 1) << 7) | (((reg_0 >> 6) & 1) << 6) | (reg_0#[3..=5] << 3) | reg_0#[0..=2]
}
