pub mod MncauseModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), trapToMN:(privState:(valid:U1, bits:(PRVM:U2, V:U1)), mnstatus:(valid:U1, bits:(NMIE:U1, MNPV:U1, MNPELP:U1, MNPP:U2)), mnepc:(valid:U1, bits:(epc:U63)), mncause:(valid:U1, bits:(Interrupt:U1, ExceptionCode:U63)))) -> (rdata:U64@[], regOut:(Interrupt:U1, ExceptionCode:U63)@[]) {
  mut _GEN:U1 = 0
  mut _mux_3:U1 = 0
  mut _mux_4:U63 = 0
  mut t33 = 0
  mut t34 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN_0:U1
  reg _GEN_1:U63
  wire `regOut__bpr.Interrupt`:U1 = nil
  wire `regOut__bpr.ExceptionCode`:U63 = nil
  mut `reg_init.Interrupt` = 0
  mut `reg_init.ExceptionCode` = 0
  mut `wdata.Interrupt` = w.wdata#[63..<0x40]
  mut `wdata.ExceptionCode` = w.wdata#[0..<63]
  mut _mux_1:U63 = if trapToMN.mncause.valid != 0 { trapToMN.mncause.bits.ExceptionCode#[0..<63] } else { 0 }
  mut _mux_2:U63 = if w.wen != 0 { `wdata.ExceptionCode`#[0..<63] } else { 0 }
  t33 = _GEN_0
  t34 = _GEN_1
  if not (`reset` != 0) {
    _GEN = 0ub?
    _GEN = (w.wen | trapToMN.mncause.valid) & 1
    _mux_3 = if _GEN != 0 { (((trapToMN.mncause.valid & trapToMN.mncause.bits.Interrupt & 1) | (w.wen & `wdata.Interrupt` & 1)) & 1) & 1 } else { reg_0#[63..<0x40] }
    t33 = _mux_3
    _mux_4 = if _GEN != 0 { (_mux_1 | _mux_2)#[0..<63]#[0..<63] } else { reg_0#[0..<63] }
    t34 = _mux_4
    reg_0 = t34 | (t33 << 63)
  }
  _GEN_0 = t33
  _GEN_1 = t34
  mut `regOut__bpo.Interrupt` = reg_0#[63..<0x40]
  mut `regOut__bpo.ExceptionCode` = reg_0#[0..<63]
  const t52 = `regOut__bpo.Interrupt`
  `regOut__bpr.Interrupt` = t52
  regOut.Interrupt = t52
  const t53 = `regOut__bpo.ExceptionCode`
  `regOut__bpr.ExceptionCode` = t53
  regOut.ExceptionCode = t53
  rdata = (reg_0#[63..<0x40] << 63) | reg_0#[0..<63]
}
