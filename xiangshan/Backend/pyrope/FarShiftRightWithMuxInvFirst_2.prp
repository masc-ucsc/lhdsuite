pub comb FarShiftRightWithMuxInvFirst_2::[timecheck=false](io_src:u52, io_shiftValue:u5, io_EOP:u1) -> (io_result:u52) {
  wire io:(src:u52, shiftValue:u5, result:u52, EOP:u1) = nil
  wire io_result_res_vec:u312
  mut _mux_1:u52 = if (io.shiftValue & 1) != 0 { ((io.EOP & 1) << 51) | io_result_res_vec#[0..=51]#[1..=51] } else { io_result_res_vec#[0..=51] }
  mut _rep_2:u2 = if (io.EOP & 1) != 0 { 3 } else { 0 }
  mut _mux_3:u52 = if ((io.shiftValue >> 1) & 1) != 0 { (_rep_2 << 50) | io_result_res_vec#[52..=103]#[2..=51] } else { io_result_res_vec#[52..=103] }
  mut _rep_4:u4 = if (io.EOP & 1) != 0 { 15 } else { 0 }
  mut _mux_5:u52 = if ((io.shiftValue >> 2) & 1) != 0 { (_rep_4 << 48) | io_result_res_vec#[104..=155]#[4..=51] } else { io_result_res_vec#[104..=155] }
  mut _rep_6:u8 = if (io.EOP & 1) != 0 { 0xff } else { 0 }
  mut _mux_7:u52 = if ((io.shiftValue >> 3) & 1) != 0 { (_rep_6 << 44) | io_result_res_vec#[156..=207]#[8..=51] } else { io_result_res_vec#[156..=207] }
  mut _rep_8:u16 = if (io.EOP & 1) != 0 { 0xffff } else { 0 }
  mut _mux_9:u52 = if ((io.shiftValue >> 4) & 1) != 0 { (_rep_8 << 36) | io_result_res_vec#[208..=259]#[16..=51] } else { io_result_res_vec#[208..=259] }
  io_result_res_vec = (_mux_9 << 260) | (_mux_7 << 208) | (_mux_5 << 156) | (_mux_3 << 104) | (_mux_1 << 52) | io.src#[0..=51]
  io.src = io_src
  io.shiftValue = io_shiftValue
  io.result = io_result_res_vec#[260..=311]
  io.EOP = io_EOP & 1
  io_result = io.result
}
