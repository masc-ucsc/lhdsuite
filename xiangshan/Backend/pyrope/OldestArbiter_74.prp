pub comb OldestArbiter_74::[timecheck=false](io_in_0_valid:u1, io_in_0_bits:(addr:u5, robIdx:(flag:u1, value:u9), issueValid:u1)) -> (io_in_0_ready:u1, io_out:(valid:u1, bits:(addr:u5, robIdx:(flag:u1, value:u9), issueValid:u1))) {
  wire io:u35
  mut `_GEN.ready` = 0
  mut `_GEN.valid` = io_in_0_valid & 1
  mut `_GEN.bits` = ((io_in_0_bits.addr << 11) | (io_in_0_bits.robIdx.flag << 10) | (io_in_0_bits.robIdx.value << 1) | io_in_0_bits.issueValid)#[0..=15]
  mut `_GEN_0.valid` = (io#[17..=34] >> 16) & 1
  mut `_GEN_0.bits` = io#[17..=34]#[0..=15]
  io = (`_GEN_0.valid` << 16) | `_GEN_0.bits` | ((0x20000 | (`_GEN.valid` << 16) | `_GEN.bits`)#[0..=17] << 17)
  mut `io_out__bpo.valid` = (io#[0..=16] >> 16) & 1
  mut `io_out__bpo.bits.addr` = io#[0..=16]#[11..=15]
  mut `io_out__bpo.bits.robIdx.flag` = (io#[0..=16] >> 10) & 1
  mut `io_out__bpo.bits.robIdx.value` = io#[0..=16]#[1..=9]
  mut `io_out__bpo.bits.issueValid` = io#[0..=16] & 1
  io_out.valid = `io_out__bpo.valid`
  io_out.bits.addr = `io_out__bpo.bits.addr`
  io_out.bits.robIdx.flag = `io_out__bpo.bits.robIdx.flag`
  io_out.bits.robIdx.value = `io_out__bpo.bits.robIdx.value`
  io_out.bits.issueValid = `io_out__bpo.bits.issueValid`
  io_in_0_ready = (io#[17..=34] >> 17) & 1
}
