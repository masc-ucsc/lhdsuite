const DiffExtArchIntRenameTable = import("DiffExtArchIntRenameTable.DiffExtArchIntRenameTable")

pub mod DummyDPICWrapper_ArchIntRenameTable::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(value:u256, coreid:u8))) -> () {
  mut dpic = DiffExtArchIntRenameTable::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x108) | (io.bits.value << 8) | io.bits.coreid)#[0..=263])
}
