const IMSIC = import("IMSIC.IMSIC")

pub mod IMSIC_WRAP::[timecheck=false](clock:u1, reset:u1, fromCSR:(addr:(valid:u1, bits:(addr:u12, virt:u1, priv:u2)), vgein:u6, wdata:(valid:u1, bits:(op:u2, data:u64)), claims:u3), msiio_vld_req:u1, msiio_data:u13) -> (toCSR:(rdata:(valid:u1, bits:u64), illegal:u1, pendings:u9, topeis:u96)@[], msiio_vld_ack:u1@[]) {
  wire _imsic_msiio_vld_ack:u1
  mut `msiio.vld_req` = msiio_vld_req & 1
  mut `msiio.data` = msiio_data
  mut `msiio.vld_ack` = _imsic_msiio_vld_ack & 1
  mut imsic = IMSIC::[name=imsic](clock = clock, reset = reset, fromCSR.addr.valid = fromCSR.addr.valid, fromCSR.addr.bits.addr = fromCSR.addr.bits.addr, fromCSR.addr.bits.virt = fromCSR.addr.bits.virt, fromCSR.addr.bits.priv = fromCSR.addr.bits.priv, fromCSR.vgein = fromCSR.vgein, fromCSR.wdata.valid = fromCSR.wdata.valid, fromCSR.wdata.bits.op = fromCSR.wdata.bits.op, fromCSR.wdata.bits.data = fromCSR.wdata.bits.data, fromCSR.claims = fromCSR.claims, msiio_vld_req = `msiio.vld_req`, msiio_data = `msiio.data`)
  _imsic_msiio_vld_ack = imsic.msiio_vld_ack
  toCSR.rdata.valid = imsic.toCSR.rdata.valid
  toCSR.rdata.bits = imsic.toCSR.rdata.bits
  toCSR.illegal = imsic.toCSR.illegal
  toCSR.pendings = imsic.toCSR.pendings
  toCSR.topeis = imsic.toCSR.topeis
  msiio_vld_ack = `msiio.vld_ack`
