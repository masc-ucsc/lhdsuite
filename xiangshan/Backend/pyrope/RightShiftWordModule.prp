pub comb RightShiftWordModule::[timecheck=false](io_shamt:u5, io_src:u32) -> (io_srlw:u32, io_sraw:u32) {
  wire io:(shamt:u5, src:u32, srlw:u32, sraw:u32) = nil
  mut _mux_1:u32 = if ((io.shamt >> 4) & 1) != 0 { io.src#[16..=31]#sext[0..=15]#[0..=31] } else { io.src#[0..=31] }
  const io_sraw_shifted__w1 = _mux_1
  mut _mux_2:u32 = if ((io.shamt >> 3) & 1) != 0 { io_sraw_shifted__w1#[8..=31]#sext[0..=23]#[0..=31] } else { io_sraw_shifted__w1 }
  const io_sraw_shifted_1__w1 = _mux_2
  mut _mux_3:u32 = if ((io.shamt >> 2) & 1) != 0 { io_sraw_shifted_1__w1#[4..=31]#sext[0..=27]#[0..=31] } else { io_sraw_shifted_1__w1 }
  const io_sraw_shifted_2__w1 = _mux_3
  mut _mux_4:u32 = if ((io.shamt >> 1) & 1) != 0 { io_sraw_shifted_2__w1#[2..=31]#sext[0..=29]#[0..=31] } else { io_sraw_shifted_2__w1 }
  const io_sraw_shifted_3__w1 = _mux_4
  mut _mux_5:u32 = if (io.shamt & 1) != 0 { (((io_sraw_shifted_3__w1 >> 31) & 1) << 31) | io_sraw_shifted_3__w1#[1..=31] } else { io_sraw_shifted_3__w1 }
  io.shamt = io_shamt
  io.src = io_src
  io.srlw = (io.src >> io.shamt)#[0..=31]
  io.sraw = _mux_5
  io_srlw = io.srlw
  io_sraw = io.sraw
}
