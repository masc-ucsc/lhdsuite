pub comb RightShiftWordModule::[timecheck=false](io_shamt:U5, io_src:U32) -> (io_srlw:U32, io_sraw:U32) {
  wire io:(shamt:U5, src:U32, srlw:U32, sraw:U32) = nil
  wire io_sraw_shifted:U32 = nil
  wire io_sraw_shifted_1:U32 = nil
  wire io_sraw_shifted_2:U32 = nil
  wire io_sraw_shifted_3:U32 = nil
  wire io_sraw_shifted_4:U32 = nil
  mut _mux_1:U32 = if io.shamt#[4..<5] != 0 { io.src#[16..<32]#sext[0..=15]#[0..<32] } else { io.src#[0..<32] }
  io_sraw_shifted = _mux_1
  mut _mux_2:U32 = if io.shamt#[3..<4] != 0 { io_sraw_shifted#[8..<32]#sext[0..=23]#[0..<32] } else { io_sraw_shifted#[0..<32] }
  io_sraw_shifted_1 = _mux_2
  mut _mux_3:U32 = if io.shamt#[2..<3] != 0 { io_sraw_shifted_1#[4..<32]#sext[0..=27]#[0..<32] } else { io_sraw_shifted_1#[0..<32] }
  io_sraw_shifted_2 = _mux_3
  mut _mux_4:U32 = if io.shamt#[1..<2] != 0 { io_sraw_shifted_2#[2..<32]#sext[0..=29]#[0..<32] } else { io_sraw_shifted_2#[0..<32] }
  io_sraw_shifted_3 = _mux_4
  mut _mux_5:U32 = if (io.shamt & 1) != 0 { (io_sraw_shifted_3#[31..<32] << 31) | io_sraw_shifted_3#[1..<32] } else { io_sraw_shifted_3#[0..<32] }
  io_sraw_shifted_4 = _mux_5
  io.shamt = io_shamt#[0..<5]
  io.src = io_src#[0..<32]
  io.srlw = (io.src >> io.shamt)#[0..<32]
  io.sraw = io_sraw_shifted_4#[0..<32]
  io_srlw = io.srlw
  io_sraw = io.sraw
}
