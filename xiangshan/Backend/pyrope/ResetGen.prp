pub mod ResetGen::[timecheck=false](clock:u1, reset:u1, dft:(lgc_rst_n:u1, mode:u1, scan_mode:u1)) -> (o_reset:u1@[]) {
  reg pipe_reset:u3:[init=7, reset_pin=ref real_reset, async=true]
  wire real_reset:u1
  const lgc_rst__w1 = (~dft.lgc_rst_n) & 1
  mut _mux_1:u1 = if dft.mode != 0 { lgc_rst__w1 & 1 } else { reset & 1 }
  real_reset = _mux_1
  const raw_reset__w1 = (pipe_reset >> 2) & 1
  pipe_reset = pipe_reset#[0..=1] << 1
  mut _mux_2:u1 = if dft.scan_mode != 0 { lgc_rst__w1 & 1 } else { raw_reset__w1 & 1 }
  o_reset = _mux_2
}
