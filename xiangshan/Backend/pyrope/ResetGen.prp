pub mod ResetGen::[timecheck=false](`clock`:Clock, `reset`:U1, dft:(lgc_rst_n:U1, mode:U1, scan_mode:U1)) -> (o_reset:U1@[]) {
  reg pipe_reset:U3:[initial=7, reset_pin=real_reset, async=true]
  wire real_reset:U1 = nil
  const lgc_rst__w1 = ~dft.lgc_rst_n#[0]
  mut _mux_1:U1 = if dft.mode != 0 { lgc_rst__w1 & 1 } else { `reset` & 1 }
  real_reset = _mux_1
  const raw_reset__w1 = pipe_reset#[2..<3]
  if not (real_reset != 0) {
    pipe_reset = pipe_reset#[0..<2] << 1
  }
  mut _mux_2:U1 = if dft.scan_mode != 0 { lgc_rst__w1 & 1 } else { raw_reset__w1 & 1 }
  o_reset = _mux_2
}
