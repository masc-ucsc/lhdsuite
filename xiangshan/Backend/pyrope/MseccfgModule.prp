pub mod MseccfgModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(PMM:u2, MLPE:u1, SSEED:u1, USEED:u1, RLB:u1, MMWP:u1, MML:u1)@[]) {
  reg reg_0:u8:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.PMM` = 0
  mut `reg_init.MLPE` = 0
  mut `reg_init.SSEED` = 0
  mut `reg_init.USEED` = 0
  mut `reg_init.RLB` = 0
  mut `reg_init.MMWP` = 0
  mut `reg_init.MML` = 0
  mut `wdata.PMM` = w.wdata#[32..=33]
  mut `wdata.MLPE` = (w.wdata >> 10) & 1
  mut `wdata.SSEED` = (w.wdata >> 9) & 1
  mut `wdata.USEED` = (w.wdata >> 8) & 1
  mut `wdata.RLB` = (w.wdata >> 2) & 1
  mut `wdata.MMWP` = (w.wdata >> 1) & 1
  mut `wdata.MML` = w.wdata & 1
  mut _mux_4:u2 = if (w.wen & (((unsigned(`wdata.PMM` == 0) | unsigned(`wdata.PMM` == 2)) & 1) | unsigned(`wdata.PMM` == 3)) & 1 & 1) != 0 { `wdata.PMM`#[0..=1] } else { reg_0#[6..=7] }
  reg_0 = (reg_0 & 1) | (((reg_0 >> 1) & 1) << 1) | (((reg_0 >> 2) & 1) << 2) | (((reg_0 >> 3) & 1) << 3) | (((reg_0 >> 4) & 1) << 4) | (((reg_0 >> 5) & 1) << 5) | (_mux_4 << 6)
  mut `regOut__bpo.PMM` = reg_0#[6..=7]
  mut `regOut__bpo.MLPE` = (reg_0 >> 5) & 1
  mut `regOut__bpo.SSEED` = (reg_0 >> 4) & 1
  mut `regOut__bpo.USEED` = (reg_0 >> 3) & 1
  mut `regOut__bpo.RLB` = (reg_0 >> 2) & 1
  mut `regOut__bpo.MMWP` = (reg_0 >> 1) & 1
  mut `regOut__bpo.MML` = reg_0 & 1
  regOut.PMM = `regOut__bpo.PMM`
  regOut.MLPE = `regOut__bpo.MLPE`
  regOut.SSEED = `regOut__bpo.SSEED`
  regOut.USEED = `regOut__bpo.USEED`
  regOut.RLB = `regOut__bpo.RLB`
  regOut.MMWP = `regOut__bpo.MMWP`
  regOut.MML = `regOut__bpo.MML`
  rdata = (reg_0#[6..=7] << 32) | (((reg_0 >> 5) & 1) << 10) | (((reg_0 >> 4) & 1) << 9) | (((reg_0 >> 3) & 1) << 8) | (((reg_0 >> 2) & 1) << 2) | (((reg_0 >> 1) & 1) << 1) | (reg_0 & 1)
}
