pub mod MseccfgModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(PMM:U2, MLPE:U1, SSEED:U1, USEED:U1, RLB:U1, MMWP:U1, MML:U1)@[]) {
  mut _mux_4:U2 = 0
  mut t38 = 0
  reg reg_0:U8:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U2
  wire `regOut__bpr.PMM`:U2 = nil
  wire `regOut__bpr.MLPE`:U1 = nil
  wire `regOut__bpr.SSEED`:U1 = nil
  wire `regOut__bpr.USEED`:U1 = nil
  wire `regOut__bpr.RLB`:U1 = nil
  wire `regOut__bpr.MMWP`:U1 = nil
  wire `regOut__bpr.MML`:U1 = nil
  mut `reg_init.PMM` = 0
  mut `reg_init.MLPE` = 0
  mut `reg_init.SSEED` = 0
  mut `reg_init.USEED` = 0
  mut `reg_init.RLB` = 0
  mut `reg_init.MMWP` = 0
  mut `reg_init.MML` = 0
  mut `wdata.PMM` = w.wdata#[32..<34]
  mut `wdata.MLPE` = w.wdata#[10..<11]
  mut `wdata.SSEED` = w.wdata#[9..<10]
  mut `wdata.USEED` = w.wdata#[8..<9]
  mut `wdata.RLB` = w.wdata#[2..<3]
  mut `wdata.MMWP` = w.wdata#[1..<2]
  mut `wdata.MML` = w.wdata & 1
  t38 = _GEN
  if not (`reset` != 0) {
    _mux_4 = if (w.wen & (((U1(`wdata.PMM` == 0) | U1(`wdata.PMM` == 2)) & 1) | U1(`wdata.PMM` == 3)) & 1 & 1) != 0 { `wdata.PMM`#[0..<2] } else { reg_0#[6..<8] }
    t38 = _mux_4
    reg_0 = (reg_0 & 1) | (reg_0#[1..<2] << 1) | (reg_0#[2..<3] << 2) | (reg_0#[3..<4] << 3) | (reg_0#[4..<5] << 4) | (reg_0#[5..<6] << 5) | (t38 << 6)
  }
  _GEN = t38
  mut `regOut__bpo.PMM` = reg_0#[6..<8]
  mut `regOut__bpo.MLPE` = reg_0#[5..<6]
  mut `regOut__bpo.SSEED` = reg_0#[4..<5]
  mut `regOut__bpo.USEED` = reg_0#[3..<4]
  mut `regOut__bpo.RLB` = reg_0#[2..<3]
  mut `regOut__bpo.MMWP` = reg_0#[1..<2]
  mut `regOut__bpo.MML` = reg_0 & 1
  const t89 = `regOut__bpo.PMM`
  `regOut__bpr.PMM` = t89
  regOut.PMM = t89
  const t90 = `regOut__bpo.MLPE`
  `regOut__bpr.MLPE` = t90
  regOut.MLPE = t90
  const t91 = `regOut__bpo.SSEED`
  `regOut__bpr.SSEED` = t91
  regOut.SSEED = t91
  const t92 = `regOut__bpo.USEED`
  `regOut__bpr.USEED` = t92
  regOut.USEED = t92
  const t93 = `regOut__bpo.RLB`
  `regOut__bpr.RLB` = t93
  regOut.RLB = t93
  const t94 = `regOut__bpo.MMWP`
  `regOut__bpr.MMWP` = t94
  regOut.MMWP = t94
  const t95 = `regOut__bpo.MML`
  `regOut__bpr.MML` = t95
  regOut.MML = t95
  rdata = (reg_0#[6..<8] << 32) | (reg_0#[5..<6] << 10) | (reg_0#[4..<5] << 9) | (reg_0#[3..<4] << 8) | (reg_0#[2..<3] << 2) | (reg_0#[1..<2] << 1) | (reg_0 & 1)
}
