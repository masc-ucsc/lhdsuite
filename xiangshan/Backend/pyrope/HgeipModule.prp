pub mod HgeipModule::[timecheck=false](`clock`:Clock, w:(wen:U1, wdata:U64), aiaToCSR:(rdata:(valid:U1, bits:(data:U64, illegal:U1)), meip:U1, seip:U1, notice_pending:U1, vseip:U7, mtopei:(IID:U11, IPRIO:U11), stopei:(IID:U11, IPRIO:U11), vstopei:(IID:U11, IPRIO:U11))) -> (rdata:U64@[], regOut:(ip:U7)@[]) {
  mut `reg_0.ip` = 0
  wire `regOut__bpr.ip`:U7 = nil
  mut `wdata.ip` = w.wdata#[1..<8]
  mut `regOut__bpo.ip` = aiaToCSR.vseip#[0..<7]
  const t11 = `regOut__bpo.ip`
  `regOut__bpr.ip` = t11
  regOut.ip = t11
  rdata = aiaToCSR.vseip#[0..<7] << 1
