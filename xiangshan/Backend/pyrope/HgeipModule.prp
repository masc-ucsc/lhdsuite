pub comb HgeipModule::[timecheck=false](clock:u1, w:(wen:u1, wdata:u64), aiaToCSR:(rdata:(valid:u1, bits:(data:u64, illegal:u1)), meip:u1, seip:u1, notice_pending:u1, vseip:u7, mtopei:(IID:u11, IPRIO:u11), stopei:(IID:u11, IPRIO:u11), vstopei:(IID:u11, IPRIO:u11))) -> (rdata:u64, regOut:(ip:u7)) {
  mut `reg_0.ip` = 0
  mut `wdata.ip` = w.wdata#[1..=7]
  mut `regOut__bpo.ip` = aiaToCSR.vseip#[0..=6]
  regOut.ip = `regOut__bpo.ip`
  rdata = aiaToCSR.vseip#[0..=6] << 1
}
