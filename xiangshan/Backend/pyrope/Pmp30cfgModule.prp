pub mod Pmp30cfgModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u8@[], regOut:(R:u1, W:u1, X:u1, A:u2, ATOMIC:u1, C:u1, L:u1)@[]) {
  reg reg_0:u8:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.R` = 0
  mut `reg_init.W` = 0
  mut `reg_init.X` = 0
  mut `reg_init.A` = 0
  mut `reg_init.ATOMIC` = 0
  mut `reg_init.C` = 0
  mut `reg_init.L` = 0
  mut `wdata.R` = w.wdata & 1
  mut `wdata.W` = (w.wdata >> 1) & 1
  mut `wdata.X` = (w.wdata >> 2) & 1
  mut `wdata.A` = w.wdata#[3..=4]
  mut `wdata.ATOMIC` = (w.wdata >> 5) & 1
  mut `wdata.C` = (w.wdata >> 6) & 1
  mut `wdata.L` = (w.wdata >> 7) & 1
  mut _mux_1:u2 = if w.wdata#[3..=4] == 2 { 3 } else { w.wdata#[3..=4] }
  mut _mux_2:u2 = if w.wen != 0 { _mux_1 } else { reg_0#[3..=4] }
  mut _mux_3:u1 = if (w.wen & (~((~(w.wdata & 1)) & 1 & (w.wdata >> 1) & 1 & 1)) & 1 & 1) != 0 { (w.wdata >> 1) & 1 } else { (reg_0 >> 6) & 1 }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.R` & 1 } else { (reg_0 >> 7) & 1 }
  mut _mux_5:u1 = if w.wen != 0 { `wdata.X` & 1 } else { (reg_0 >> 5) & 1 }
  mut _mux_6:u1 = if w.wen != 0 { `wdata.L` & 1 } else { reg_0 & 1 }
  reg_0 = _mux_6 | (((reg_0 >> 1) & 1) << 1) | (((reg_0 >> 2) & 1) << 2) | (_mux_2 << 3) | (_mux_5 << 5) | (_mux_3 << 6) | (_mux_4 << 7)
  mut `regOut__bpo.R` = (reg_0 >> 7) & 1
  mut `regOut__bpo.W` = (reg_0 >> 6) & 1
  mut `regOut__bpo.X` = (reg_0 >> 5) & 1
  mut `regOut__bpo.A` = reg_0#[3..=4]
  mut `regOut__bpo.ATOMIC` = (reg_0 >> 2) & 1
  mut `regOut__bpo.C` = (reg_0 >> 1) & 1
  mut `regOut__bpo.L` = reg_0 & 1
  regOut.R = `regOut__bpo.R`
  regOut.W = `regOut__bpo.W`
  regOut.X = `regOut__bpo.X`
  regOut.A = `regOut__bpo.A`
  regOut.ATOMIC = `regOut__bpo.ATOMIC`
  regOut.C = `regOut__bpo.C`
  regOut.L = `regOut__bpo.L`
  rdata = ((reg_0 & 1) << 7) | (((reg_0 >> 1) & 1) << 6) | (((reg_0 >> 2) & 1) << 5) | (reg_0#[3..=4] << 3) | (((reg_0 >> 5) & 1) << 2) | (((reg_0 >> 6) & 1) << 1) | ((reg_0 >> 7) & 1)
}
