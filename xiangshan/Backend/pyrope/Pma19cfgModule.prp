pub mod Pma19cfgModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U8@[], regOut:(R:U1, W:U1, X:U1, A:U2, ATOMIC:U1, C:U1, L:U1)@[]) {
  mut _mux_1:U1 = 0
  mut _mux_10:U1 = 0
  mut _mux_11:U1 = 0
  mut _mux_2:U1 = 0
  mut _mux_3:U1 = 0
  mut _mux_8:U2 = 0
  mut _mux_9:U1 = 0
  mut t38 = 0
  mut t39 = 0
  mut t40 = 0
  mut t41 = 0
  mut t42 = 0
  mut t43 = 0
  mut t44 = 0
  reg reg_0:U8:[initial=200, reset_pin=`reset`, async=true]
  reg _GEN:U1
  reg _GEN_0:U1
  reg _GEN_1:U1
  reg _GEN_2:U2
  reg _GEN_3:U1
  reg _GEN_4:U1
  reg _GEN_5:U1
  wire `regOut__bpr.R`:U1 = nil
  wire `regOut__bpr.W`:U1 = nil
  wire `regOut__bpr.X`:U1 = nil
  wire `regOut__bpr.A`:U2 = nil
  wire `regOut__bpr.ATOMIC`:U1 = nil
  wire `regOut__bpr.C`:U1 = nil
  wire `regOut__bpr.L`:U1 = nil
  mut `reg_init.R` = 1
  mut `reg_init.W` = 1
  mut `reg_init.X` = 0
  mut `reg_init.A` = 1
  mut `reg_init.ATOMIC` = 0
  mut `reg_init.C` = 0
  mut `reg_init.L` = 0
  mut `wdata.R` = w.wdata & 1
  mut `wdata.W` = w.wdata#[1..<2]
  mut `wdata.X` = w.wdata#[2..<3]
  mut `wdata.A` = w.wdata#[3..<5]
  mut `wdata.ATOMIC` = w.wdata#[5..<6]
  mut `wdata.C` = w.wdata#[6..<7]
  mut `wdata.L` = w.wdata#[7..<8]
  t38 = _GEN
  t39 = _GEN_0
  t40 = _GEN_1
  t41 = _GEN_2
  t42 = _GEN_3
  t43 = _GEN_4
  t44 = _GEN_5
  if not (`reset` != 0) {
    _mux_1 = if w.wen != 0 { `wdata.R` & 1 } else { reg_0#[7..<8] }
    t38 = _mux_1
    _mux_2 = if w.wen != 0 { `wdata.W` & 1 } else { reg_0#[6..<7] }
    t39 = _mux_2
    _mux_3 = if w.wen != 0 { `wdata.X` & 1 } else { reg_0#[5..<6] }
    t40 = _mux_3
    _mux_8 = if (w.wen & (((((U1(`wdata.A` == 0) | U1(`wdata.A` == 1)) & 1) | U1(`wdata.A` == 2)) & 1) | U1(`wdata.A` == 3)) & 1 & 1) != 0 { `wdata.A`#[0..<2] } else { reg_0#[3..<5] }
    t41 = _mux_8
    _mux_9 = if w.wen != 0 { `wdata.ATOMIC` & 1 } else { reg_0#[2..<3] }
    t42 = _mux_9
    _mux_10 = if w.wen != 0 { `wdata.C` & 1 } else { reg_0#[1..<2] }
    t43 = _mux_10
    _mux_11 = if w.wen != 0 { `wdata.L` & 1 } else { reg_0 & 1 }
    t44 = _mux_11
    reg_0 = t44 | (t43 << 1) | (t42 << 2) | (t41 << 3) | (t40 << 5) | (t39 << 6) | (t38 << 7)
  }
  _GEN = t38
  _GEN_0 = t39
  _GEN_1 = t40
  _GEN_2 = t41
  _GEN_3 = t42
  _GEN_4 = t43
  _GEN_5 = t44
  mut `regOut__bpo.R` = reg_0#[7..<8]
  mut `regOut__bpo.W` = reg_0#[6..<7]
  mut `regOut__bpo.X` = reg_0#[5..<6]
  mut `regOut__bpo.A` = reg_0#[3..<5]
  mut `regOut__bpo.ATOMIC` = reg_0#[2..<3]
  mut `regOut__bpo.C` = reg_0#[1..<2]
  mut `regOut__bpo.L` = reg_0 & 1
  const t123 = `regOut__bpo.R`
  `regOut__bpr.R` = t123
  regOut.R = t123
  const t124 = `regOut__bpo.W`
  `regOut__bpr.W` = t124
  regOut.W = t124
  const t125 = `regOut__bpo.X`
  `regOut__bpr.X` = t125
  regOut.X = t125
  const t126 = `regOut__bpo.A`
  `regOut__bpr.A` = t126
  regOut.A = t126
  const t127 = `regOut__bpo.ATOMIC`
  `regOut__bpr.ATOMIC` = t127
  regOut.ATOMIC = t127
  const t128 = `regOut__bpo.C`
  `regOut__bpr.C` = t128
  regOut.C = t128
  const t129 = `regOut__bpo.L`
  `regOut__bpr.L` = t129
  regOut.L = t129
  rdata = ((reg_0 & 1) << 7) | (reg_0#[1..<2] << 6) | (reg_0#[2..<3] << 5) | (reg_0#[3..<5] << 3) | (reg_0#[5..<6] << 2) | (reg_0#[6..<7] << 1) | reg_0#[7..<8]
}
