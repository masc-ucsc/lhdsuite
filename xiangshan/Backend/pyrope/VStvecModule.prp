pub mod VStvecModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64)) -> (rdata:U64@[], regOut:(mode:U2, addr:U62)@[]) {
  mut _mux_3:U2 = 0
  mut _mux_4:U62 = 0
  mut t13 = 0
  mut t14 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U2
  reg _GEN_0:U62
  wire `regOut__bpr.mode`:U2 = nil
  wire `regOut__bpr.addr`:U62 = nil
  mut `reg_init.mode` = 0
  mut `reg_init.addr` = 0
  mut `wdata.mode` = w.wdata#[0..<2]
  mut `wdata.addr` = w.wdata#[2..<0x40]
  t13 = _GEN
  t14 = _GEN_0
  if not (`reset` != 0) {
    _mux_3 = if (w.wen & (U1(`wdata.mode` == 0) | U1(`wdata.mode` == 1)) & 1 & 1) != 0 { `wdata.mode`#[0..<2] } else { reg_0#[62..<0x40] }
    t13 = _mux_3
    _mux_4 = if w.wen != 0 { `wdata.addr`#[0..<62] } else { reg_0#[0..<62] }
    t14 = _mux_4
    reg_0 = t14 | (t13 << 62)
  }
  _GEN = t13
  _GEN_0 = t14
  mut `regOut__bpo.mode` = reg_0#[62..<0x40]
  mut `regOut__bpo.addr` = reg_0#[0..<62]
  const t40 = `regOut__bpo.mode`
  `regOut__bpr.mode` = t40
  regOut.mode = t40
  const t41 = `regOut__bpo.addr`
  `regOut__bpr.addr` = t41
  regOut.addr = t41
  rdata = (reg_0#[0..<62] << 2) | reg_0#[62..<0x40]
}
