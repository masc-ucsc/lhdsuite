pub mod ScountovfModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), ofVec:u29, privState:(PRVM:u2, V:u1), mcounteren:(CY:u1, TM:u1, IR:u1, HPM:u29), hcounteren:(CY:u1, TM:u1, IR:u1, HPM:u29)) -> (rdata:u32@[], regOut:(OFVEC:u29)@[]) {
  reg reg_0:u29:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.OFVEC` = 0
  const PrvmIsS__w1 = unsigned(privState.PRVM == 1)
  mut _mux_3:u29 = if unsigned(privState.PRVM == 3) != 0 { ofVec } else { 0 }
  mut _mux_4:u29 = if ((~privState.V) & 1 & PrvmIsS__w1 & 1) != 0 { mcounteren.HPM & ofVec } else { 0 }
  mut _mux_5:u29 = if (privState.V & PrvmIsS__w1 & 1) != 0 { (mcounteren.HPM & hcounteren.HPM)#[0..=28] & ofVec } else { 0 }
  const _regOut_OFVEC_WIRE_1__w1 = (_mux_3 | _mux_4) | _mux_5
  mut `wdata.OFVEC` = w.wdata#[3..=31]
  mut `regOut__bpo.OFVEC` = _regOut_OFVEC_WIRE_1__w1
  regOut.OFVEC = `regOut__bpo.OFVEC`
  rdata = _regOut_OFVEC_WIRE_1__w1 << 3
}
