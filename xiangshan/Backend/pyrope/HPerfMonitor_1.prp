const HPerfCounter_8 = import("HPerfCounter_8.HPerfCounter_8")

pub mod HPerfMonitor_1::[timecheck=false](clock:u1, io_hpm_event:u320, io_events_sets:u408) -> (io_perf:u30@[]) {
