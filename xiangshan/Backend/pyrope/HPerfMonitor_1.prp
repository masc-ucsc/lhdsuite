  io_perf_3_value_REG_1 = io_perf_3_value_REG
  io_perf_4_value_REG_1 = io_perf_4_value_REG
  const t15 = io__w1#[0..=407]
  mut perfEvents_hpc = HPerfCounter_8::[name=perfEvents_hpc](clock = clock, io_hpm_event = io__w1#[408..=727]#[0..=63], io_events_sets = t15)
