pub comb Booth4::[timecheck=false](io_in:U3) -> (io_out:U4) {
  wire io:(`in`:U3, out:U4) = nil
  wire code:U4 = nil
  code = (((io.`in`#[1..<2] ^ (io.`in` & 1)) & 1) << 3) | ((U1(io.`in`#[1..<2] == (io.`in` & 1)) & 1) << 2) | ((((~io.`in`#[1..<2]) | (~(io.`in` & 1)#[0])) & 1 & io.`in`#[2..<3] & 1) << 1) | ((io.`in`#[1..<2] | (io.`in` & 1)) & 1 & (~io.`in`#[2..<3]) & 1)
  io.`in` = io_in#[0..<3]
  io.out = code#[0..<4]
  io_out = io.out
}
