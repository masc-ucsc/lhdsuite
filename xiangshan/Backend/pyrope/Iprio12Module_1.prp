pub mod Iprio12Module_1::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), sie:(SSIE:u1, VSSIE:u1, MSIE:u1, STIE:u1, VSTIE:u1, MTIE:u1, SEIE:u1, VSEIE:u1, MEIE:u1, SGEIE:u1, LCOFIE:u1, LC14IE:u1, LC15IE:u1, LC16IE:u1, LC17IE:u1, LC18IE:u1, LC19IE:u1, LC20IE:u1, LC21IE:u1, LC22IE:u1, LC23IE:u1, LC24IE:u1, LC25IE:u1, LC26IE:u1, LC27IE:u1, LC28IE:u1, LC29IE:u1, LC30IE:u1, LC31IE:u1, LC32IE:u1, LC33IE:u1, LC34IE:u1, LPRASEIE:u1, LC36IE:u1, LC37IE:u1, LC38IE:u1, LC39IE:u1, LC40IE:u1, LC41IE:u1, LC42IE:u1, HPRASEIE:u1, LC44IE:u1, LC45IE:u1, LC46IE:u1, LC47IE:u1, LC48IE:u1, LC49IE:u1, LC50IE:u1, LC51IE:u1, LC52IE:u1, LC53IE:u1, LC54IE:u1, LC55IE:u1, LC56IE:u1, LC57IE:u1, LC58IE:u1, LC59IE:u1, LC60IE:u1, LC61IE:u1, LC62IE:u1, LC63IE:u1)) -> (rdata:u64@[]) {
  reg reg_0:u64:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..=63]
  mut _rep_1:u8 = if (sie.LC55IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_2:u8 = if (sie.LC54IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_3:u8 = if (sie.LC53IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_4:u8 = if (sie.LC52IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_5:u8 = if (sie.LC51IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_6:u8 = if (sie.LC50IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_7:u8 = if (sie.LC49IE & 1) != 0 { 0xff } else { 0 }
  mut _rep_8:u8 = if (sie.LC48IE & 1) != 0 { 0xff } else { 0 }
  mut _mux_9:u64 = if w.wen != 0 { `wdata.ALL`#[0..=63] } else { reg_0 }
  reg_0 = _mux_9
  rdata = reg_0 & ((_rep_1 << 56) | (_rep_2 << 48) | (_rep_3 << 40) | (_rep_4 << 32) | (_rep_5 << 24) | (_rep_6 << 16) | (_rep_7 << 8) | _rep_8)
}
