const DiffExtInstrCommit = import("DiffExtInstrCommit.DiffExtInstrCommit")

pub mod DummyDPICWrapper_InstrCommit::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(valid:u1, skip:u1, isRVC:u1, rfwen:u1, fpwen:u1, vecwen:u1, v0wen:u1, wpdest:u9, wdest:u8, otherwpdest:u144, pc:u64, instr:u32, robIdx:u10, lqIdx:u7, sqIdx:u7, isLoad:u1, isStore:u1, nFused:u8, special:u8, coreid:u8, index:u8))) -> () {
  mut dpic = DiffExtInstrCommit::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x142) | (io.bits.valid << 0x141) | (io.bits.skip << 0x140) | (io.bits.isRVC << 0x13f) | (io.bits.rfwen << 0x13e) | (io.bits.fpwen << 0x13d) | (io.bits.vecwen << 0x13c) | (io.bits.v0wen << 0x13b) | (io.bits.wpdest << 0x132) | (io.bits.wdest << 0x12a) | (io.bits.otherwpdest << 0x9a) | (io.bits.pc << 0x5a) | (io.bits.instr << 58) | (io.bits.robIdx << 48) | (io.bits.lqIdx << 41) | (io.bits.sqIdx << 34) | (io.bits.isLoad << 33) | (io.bits.isStore << 32) | (io.bits.nFused << 24) | (io.bits.special << 16) | (io.bits.coreid << 8) | io.bits.index)#[0..=321])
}
