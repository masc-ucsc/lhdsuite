pub mod SmblockctlModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(SBUFFER_TIMEOUT:u22, HD_MISALIGN_LD_ENABLE:u1, HD_MISALIGN_ST_ENABLE:u1, UNCACHE_WRITE_OUTSTANDING_ENABLE:u1, CACHE_ERROR_ENABLE:u1, SOFT_PREFETCH_ENABLE:u1, LDLD_VIO_CHECK_ENABLE:u1, SBUFFER_THRESHOLD:u4)@[]) {
  reg reg_0:u32:[init=0x40000377, reset_pin=ref reset, async=true]
  mut `reg_init.SBUFFER_TIMEOUT` = 0
  mut `reg_init.HD_MISALIGN_LD_ENABLE` = 0
  mut `reg_init.HD_MISALIGN_ST_ENABLE` = 0
  mut `reg_init.UNCACHE_WRITE_OUTSTANDING_ENABLE` = 0
  mut `reg_init.CACHE_ERROR_ENABLE` = 0
  mut `reg_init.SOFT_PREFETCH_ENABLE` = 0
  mut `reg_init.LDLD_VIO_CHECK_ENABLE` = 0
  mut `reg_init.SBUFFER_THRESHOLD` = 0
  mut `wdata.SBUFFER_TIMEOUT` = w.wdata#[10..=31]
  mut `wdata.HD_MISALIGN_LD_ENABLE` = (w.wdata >> 9) & 1
  mut `wdata.HD_MISALIGN_ST_ENABLE` = (w.wdata >> 8) & 1
  mut `wdata.UNCACHE_WRITE_OUTSTANDING_ENABLE` = (w.wdata >> 7) & 1
  mut `wdata.CACHE_ERROR_ENABLE` = (w.wdata >> 6) & 1
  mut `wdata.SOFT_PREFETCH_ENABLE` = (w.wdata >> 5) & 1
  mut `wdata.LDLD_VIO_CHECK_ENABLE` = (w.wdata >> 4) & 1
  mut `wdata.SBUFFER_THRESHOLD` = w.wdata#[0..=3]
  mut _mux_1:u22 = if w.wen != 0 { `wdata.SBUFFER_TIMEOUT`#[0..=21] } else { reg_0#[10..=31] }
  mut _mux_2:u1 = if w.wen != 0 { `wdata.HD_MISALIGN_LD_ENABLE` & 1 } else { (reg_0 >> 9) & 1 }
  mut _mux_3:u1 = if w.wen != 0 { `wdata.HD_MISALIGN_ST_ENABLE` & 1 } else { (reg_0 >> 8) & 1 }
  mut _mux_4:u1 = if w.wen != 0 { `wdata.UNCACHE_WRITE_OUTSTANDING_ENABLE` & 1 } else { (reg_0 >> 7) & 1 }
  mut _mux_5:u1 = if w.wen != 0 { `wdata.CACHE_ERROR_ENABLE` & 1 } else { (reg_0 >> 6) & 1 }
  mut _mux_6:u1 = if w.wen != 0 { `wdata.SOFT_PREFETCH_ENABLE` & 1 } else { (reg_0 >> 5) & 1 }
  mut _mux_7:u1 = if w.wen != 0 { `wdata.LDLD_VIO_CHECK_ENABLE` & 1 } else { (reg_0 >> 4) & 1 }
  mut _mux_8:u4 = if w.wen != 0 { `wdata.SBUFFER_THRESHOLD`#[0..=3] } else { reg_0#[0..=3] }
  reg_0 = _mux_8 | (_mux_7 << 4) | (_mux_6 << 5) | (_mux_5 << 6) | (_mux_4 << 7) | (_mux_3 << 8) | (_mux_2 << 9) | (_mux_1 << 10)
  mut `regOut__bpo.SBUFFER_TIMEOUT` = reg_0#[10..=31]
  mut `regOut__bpo.HD_MISALIGN_LD_ENABLE` = (reg_0 >> 9) & 1
  mut `regOut__bpo.HD_MISALIGN_ST_ENABLE` = (reg_0 >> 8) & 1
  mut `regOut__bpo.UNCACHE_WRITE_OUTSTANDING_ENABLE` = (reg_0 >> 7) & 1
  mut `regOut__bpo.CACHE_ERROR_ENABLE` = (reg_0 >> 6) & 1
  mut `regOut__bpo.SOFT_PREFETCH_ENABLE` = (reg_0 >> 5) & 1
  mut `regOut__bpo.LDLD_VIO_CHECK_ENABLE` = (reg_0 >> 4) & 1
  mut `regOut__bpo.SBUFFER_THRESHOLD` = reg_0#[0..=3]
  regOut.SBUFFER_TIMEOUT = `regOut__bpo.SBUFFER_TIMEOUT`
  regOut.HD_MISALIGN_LD_ENABLE = `regOut__bpo.HD_MISALIGN_LD_ENABLE`
  regOut.HD_MISALIGN_ST_ENABLE = `regOut__bpo.HD_MISALIGN_ST_ENABLE`
  regOut.UNCACHE_WRITE_OUTSTANDING_ENABLE = `regOut__bpo.UNCACHE_WRITE_OUTSTANDING_ENABLE`
  regOut.CACHE_ERROR_ENABLE = `regOut__bpo.CACHE_ERROR_ENABLE`
  regOut.SOFT_PREFETCH_ENABLE = `regOut__bpo.SOFT_PREFETCH_ENABLE`
  regOut.LDLD_VIO_CHECK_ENABLE = `regOut__bpo.LDLD_VIO_CHECK_ENABLE`
  regOut.SBUFFER_THRESHOLD = `regOut__bpo.SBUFFER_THRESHOLD`
  rdata = (reg_0#[10..=31] << 10) | (((reg_0 >> 9) & 1) << 9) | (((reg_0 >> 8) & 1) << 8) | (((reg_0 >> 7) & 1) << 7) | (((reg_0 >> 6) & 1) << 6) | (((reg_0 >> 5) & 1) << 5) | (((reg_0 >> 4) & 1) << 4) | reg_0#[0..=3]
}
