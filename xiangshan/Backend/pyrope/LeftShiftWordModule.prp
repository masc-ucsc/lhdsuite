pub comb LeftShiftWordModule::[timecheck=false](io_shamt:U5, io_sllSrc:U32) -> (io_sllw:U32) {
  wire io:(shamt:U5, sllSrc:U32, sllw:U32) = nil
  wire io_sllw_shifted:U32 = nil
  wire io_sllw_shifted_1:U32 = nil
  wire io_sllw_shifted_2:U32 = nil
  wire io_sllw_shifted_3:U32 = nil
  wire io_sllw_shifted_4:U32 = nil
  mut _mux_1:U32 = if io.shamt#[4..<5] != 0 { io.sllSrc#[0..<16] << 16 } else { io.sllSrc#[0..<32] }
  io_sllw_shifted = _mux_1
  mut _mux_2:U32 = if io.shamt#[3..<4] != 0 { io_sllw_shifted#[0..<24] << 8 } else { io_sllw_shifted#[0..<32] }
  io_sllw_shifted_1 = _mux_2
  mut _mux_3:U32 = if io.shamt#[2..<3] != 0 { io_sllw_shifted_1#[0..<28] << 4 } else { io_sllw_shifted_1#[0..<32] }
  io_sllw_shifted_2 = _mux_3
  mut _mux_4:U32 = if io.shamt#[1..<2] != 0 { io_sllw_shifted_2#[0..<30] << 2 } else { io_sllw_shifted_2#[0..<32] }
  io_sllw_shifted_3 = _mux_4
  mut _mux_5:U32 = if (io.shamt & 1) != 0 { io_sllw_shifted_3#[0..<31] << 1 } else { io_sllw_shifted_3#[0..<32] }
  io_sllw_shifted_4 = _mux_5
  io.shamt = io_shamt#[0..<5]
  io.sllSrc = io_sllSrc#[0..<32]
  io.sllw = io_sllw_shifted_4#[0..<32]
  io_sllw = io.sllw
}
