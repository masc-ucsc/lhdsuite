pub comb LeftShiftWordModule::[timecheck=false](io_shamt:u5, io_sllSrc:u32) -> (io_sllw:u32) {
  wire io:(shamt:u5, sllSrc:u32, sllw:u32) = nil
  mut _mux_1:u32 = if ((io.shamt >> 4) & 1) != 0 { io.sllSrc#[0..=15] << 16 } else { io.sllSrc#[0..=31] }
  const io_sllw_shifted__w1 = _mux_1
  mut _mux_2:u32 = if ((io.shamt >> 3) & 1) != 0 { io_sllw_shifted__w1#[0..=23] << 8 } else { io_sllw_shifted__w1 }
  const io_sllw_shifted_1__w1 = _mux_2
  mut _mux_3:u32 = if ((io.shamt >> 2) & 1) != 0 { io_sllw_shifted_1__w1#[0..=27] << 4 } else { io_sllw_shifted_1__w1 }
  const io_sllw_shifted_2__w1 = _mux_3
  mut _mux_4:u32 = if ((io.shamt >> 1) & 1) != 0 { io_sllw_shifted_2__w1#[0..=29] << 2 } else { io_sllw_shifted_2__w1 }
  const io_sllw_shifted_3__w1 = _mux_4
  mut _mux_5:u32 = if (io.shamt & 1) != 0 { io_sllw_shifted_3__w1#[0..=30] << 1 } else { io_sllw_shifted_3__w1 }
  io.shamt = io_shamt
  io.sllSrc = io_sllSrc
  io.sllw = _mux_5
  io_sllw = io.sllw
}
