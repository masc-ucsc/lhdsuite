pub mod DelayReg_12::[timecheck=false](clock:u1, reset:u1, i:(valid:u1, interrupt:u32, exception:u32, exceptionPC:u64, exceptionInst:u32, hasNMI:u1, virtualInterruptIsHvictlInject:u1, irToHS:u1, irToVS:u1, coreid:u8)) -> (o:(valid:u1, interrupt:u32, exception:u32, exceptionPC:u64, exceptionInst:u32, hasNMI:u1, virtualInterruptIsHvictlInject:u1, irToHS:u1, irToVS:u1, coreid:u8)@[]) {
  reg r_1:u173:[init=0, reset_pin=ref reset, async=true]
  reg r_2:u173:[init=0, reset_pin=ref reset, async=true]
  reg r_3:u173:[init=0, reset_pin=ref reset, async=true]
  const t48 = (i.valid << 0xac) | (i.interrupt << 0x8c) | (i.exception << 0x6c) | (i.exceptionPC << 44) | (i.exceptionInst << 12) | (i.hasNMI << 11) | (i.virtualInterruptIsHvictlInject << 10) | (i.irToHS << 9) | (i.irToVS << 8) | i.coreid
  mut `r.valid` = (t48 >> 0xac) & 1
  mut `r.interrupt` = t48#[140..=171]
  mut `r.exception` = t48#[108..=139]
  mut `r.exceptionPC` = t48#[44..=107]
  mut `r.exceptionInst` = t48#[12..=43]
  mut `r.hasNMI` = (t48 >> 11) & 1
  mut `r.virtualInterruptIsHvictlInject` = (t48 >> 10) & 1
  mut `r.irToHS` = (t48 >> 9) & 1
  mut `r.irToVS` = (t48 >> 8) & 1
  mut `r.coreid` = t48#[0..=7]
  r_1 = (`r.valid` << 0xac) | (`r.interrupt` << 0x8c) | (`r.exception` << 0x6c) | (`r.exceptionPC` << 44) | (`r.exceptionInst` << 12) | (`r.hasNMI` << 11) | (`r.virtualInterruptIsHvictlInject` << 10) | (`r.irToHS` << 9) | (`r.irToVS` << 8) | `r.coreid`
  r_2 = r_1
  r_3 = r_2
  mut `o__bpo.valid` = (r_3 >> 0xac) & 1
  mut `o__bpo.interrupt` = r_3#[140..=171]
  mut `o__bpo.exception` = r_3#[108..=139]
  mut `o__bpo.exceptionPC` = r_3#[44..=107]
  mut `o__bpo.exceptionInst` = r_3#[12..=43]
  mut `o__bpo.hasNMI` = (r_3 >> 11) & 1
  mut `o__bpo.virtualInterruptIsHvictlInject` = (r_3 >> 10) & 1
  mut `o__bpo.irToHS` = (r_3 >> 9) & 1
  mut `o__bpo.irToVS` = (r_3 >> 8) & 1
  mut `o__bpo.coreid` = r_3#[0..=7]
  o.valid = `o__bpo.valid`
  o.interrupt = `o__bpo.interrupt`
  o.exception = `o__bpo.exception`
  o.exceptionPC = `o__bpo.exceptionPC`
  o.exceptionInst = `o__bpo.exceptionInst`
  o.hasNMI = `o__bpo.hasNMI`
  o.virtualInterruptIsHvictlInject = `o__bpo.virtualInterruptIsHvictlInject`
  o.irToHS = `o__bpo.irToHS`
  o.irToVS = `o__bpo.irToVS`
  o.coreid = `o__bpo.coreid`
}
