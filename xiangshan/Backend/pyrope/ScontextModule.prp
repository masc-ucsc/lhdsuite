pub mod ScontextModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u32@[], regOut:(ALL:u32)@[]) {
  reg reg_0:u32:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata#[0..=31]
  mut _mux_1:u32 = if w.wen != 0 { `wdata.ALL`#[0..=31] } else { reg_0 }
  reg_0 = _mux_1
  mut `regOut__bpo.ALL` = reg_0
  regOut.ALL = `regOut__bpo.ALL`
  rdata = reg_0
}
