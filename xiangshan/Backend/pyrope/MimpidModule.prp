pub mod MimpidModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64)) -> (rdata:u64@[], regOut:(ALL:u1)@[]) {
  reg reg_0:u1:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.ALL` = 0
  mut `wdata.ALL` = w.wdata & 1
  mut `regOut__bpo.ALL` = reg_0 & 1
  regOut.ALL = `regOut__bpo.ALL`
  rdata = (reg_0 & 1)
}
