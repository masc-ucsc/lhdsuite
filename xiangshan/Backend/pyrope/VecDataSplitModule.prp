pub comb VecDataSplitModule::[timecheck=false](io_inVecData:U128) -> (io_outVec8b:U128, io_outVec16b:U128, io_outVec32b:U128, io_outVec64b:U128) {
  wire vec8b:U128 = nil
  wire vec16b:U128 = nil
  wire vec32b:U128 = nil
  wire vec64b:U128 = nil
  mut `io.inVecData` = io_inVecData#[0..<0x80]
  mut `io.outVec8b` = vec8b#[0..<0x80]
  mut `io.outVec16b` = vec16b#[0..<0x80]
  mut `io.outVec32b` = vec32b#[0..<0x80]
  mut `io.outVec64b` = vec64b#[0..<0x80]
  vec8b = (`io.inVecData`#[0x78..<0x80] << 120) | (`io.inVecData`#[0x70..<0x78] << 112) | (`io.inVecData`#[0x68..<0x70] << 104) | (`io.inVecData`#[0x60..<0x68] << 96) | (`io.inVecData`#[0x58..<0x60] << 88) | (`io.inVecData`#[0x50..<0x58] << 80) | (`io.inVecData`#[0x48..<0x50] << 72) | (`io.inVecData`#[0x40..<0x48] << 64) | (`io.inVecData`#[56..<0x40] << 56) | (`io.inVecData`#[48..<56] << 48) | (`io.inVecData`#[40..<48] << 40) | (`io.inVecData`#[32..<40] << 32) | (`io.inVecData`#[24..<32] << 24) | (`io.inVecData`#[16..<24] << 16) | (`io.inVecData`#[8..<16] << 8) | `io.inVecData`#[0..<8]
  vec16b = (`io.inVecData`#[0x70..<0x80] << 112) | (`io.inVecData`#[0x60..<0x70] << 96) | (`io.inVecData`#[0x50..<0x60] << 80) | (`io.inVecData`#[0x40..<0x50] << 64) | (`io.inVecData`#[48..<0x40] << 48) | (`io.inVecData`#[32..<48] << 32) | (`io.inVecData`#[16..<32] << 16) | `io.inVecData`#[0..<16]
  vec32b = (`io.inVecData`#[0x60..<0x80] << 96) | (`io.inVecData`#[0x40..<0x60] << 64) | (`io.inVecData`#[32..<0x40] << 32) | `io.inVecData`#[0..<32]
  vec64b = (`io.inVecData`#[0x40..<0x80] << 64) | `io.inVecData`#[0..<0x40]
  io_outVec8b = `io.outVec8b`
  io_outVec16b = `io.outVec16b`
  io_outVec32b = `io.outVec32b`
  io_outVec64b = `io.outVec64b`
}
