pub comb VecDataSplitModule::[timecheck=false](io_inVecData:u128) -> (io_outVec8b:u128, io_outVec16b:u128, io_outVec32b:u128, io_outVec64b:u128) {
  wire vec8b:u128
  wire vec16b:u128
  wire vec32b:u128
  wire vec64b:u128
  mut `io.inVecData` = io_inVecData
  mut `io.outVec8b` = vec8b
  mut `io.outVec16b` = vec16b
  mut `io.outVec32b` = vec32b
  mut `io.outVec64b` = vec64b
  vec8b = (`io.inVecData`#[120..=127] << 120) | (`io.inVecData`#[112..=119] << 112) | (`io.inVecData`#[104..=111] << 104) | (`io.inVecData`#[96..=103] << 96) | (`io.inVecData`#[88..=95] << 88) | (`io.inVecData`#[80..=87] << 80) | (`io.inVecData`#[72..=79] << 72) | (`io.inVecData`#[64..=71] << 64) | (`io.inVecData`#[56..=63] << 56) | (`io.inVecData`#[48..=55] << 48) | (`io.inVecData`#[40..=47] << 40) | (`io.inVecData`#[32..=39] << 32) | (`io.inVecData`#[24..=31] << 24) | (`io.inVecData`#[16..=23] << 16) | (`io.inVecData`#[8..=15] << 8) | `io.inVecData`#[0..=7]
  vec16b = (`io.inVecData`#[112..=127] << 112) | (`io.inVecData`#[96..=111] << 96) | (`io.inVecData`#[80..=95] << 80) | (`io.inVecData`#[64..=79] << 64) | (`io.inVecData`#[48..=63] << 48) | (`io.inVecData`#[32..=47] << 32) | (`io.inVecData`#[16..=31] << 16) | `io.inVecData`#[0..=15]
  vec32b = (`io.inVecData`#[96..=127] << 96) | (`io.inVecData`#[64..=95] << 64) | (`io.inVecData`#[32..=63] << 32) | `io.inVecData`#[0..=31]
  vec64b = (`io.inVecData`#[64..=127] << 64) | `io.inVecData`#[0..=63]
  io_outVec8b = `io.outVec8b`
  io_outVec16b = `io.outVec16b`
  io_outVec32b = `io.outVec32b`
  io_outVec64b = `io.outVec64b`
}
