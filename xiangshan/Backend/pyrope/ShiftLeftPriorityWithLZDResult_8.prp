pub comb ShiftLeftPriorityWithLZDResult_8::[timecheck=false](io_src:u11, io_priority_shiftValue:u11) -> (io_lshift_result:u11, io_lzd_result:u4) {
  wire io:(src:u11, priority_shiftValue:u11, lshift_result:u11, lzd_result:u4) = nil
  mut _mux_1:u11 = if (io.priority_shiftValue & 1) != 0 { (io.src & 1) << 10 } else { 0 }
  mut _mux_2:u15 = if ((io.priority_shiftValue >> 1) & 1) != 0 { (io.src#[0..=1] << 13) | 9 } else { (_mux_1 << 4) | (5 << 1) | ((~(io.priority_shiftValue & 1)) & 1) }
  mut _mux_3:u15 = if ((io.priority_shiftValue >> 2) & 1) != 0 { (io.src#[0..=2] << 12) | 8 } else { _mux_2 }
  mut _mux_4:u15 = if ((io.priority_shiftValue >> 3) & 1) != 0 { (io.src#[0..=3] << 11) | 7 } else { _mux_3 }
  mut _mux_5:u15 = if ((io.priority_shiftValue >> 4) & 1) != 0 { (io.src#[0..=4] << 10) | 6 } else { _mux_4 }
  mut _mux_6:u15 = if ((io.priority_shiftValue >> 5) & 1) != 0 { (io.src#[0..=5] << 9) | 5 } else { _mux_5 }
  mut _mux_7:u15 = if ((io.priority_shiftValue >> 6) & 1) != 0 { (io.src#[0..=6] << 8) | 4 } else { _mux_6 }
  mut _mux_8:u15 = if ((io.priority_shiftValue >> 7) & 1) != 0 { (io.src#[0..=7] << 7) | 3 } else { _mux_7 }
  mut _mux_9:u15 = if ((io.priority_shiftValue >> 8) & 1) != 0 { (io.src#[0..=8] << 6) | 2 } else { _mux_8 }
  mut _mux_10:u15 = if ((io.priority_shiftValue >> 9) & 1) != 0 { (io.src#[0..=9] << 5) | 1 } else { _mux_9 }
  mut _mux_11:u15 = if ((io.priority_shiftValue >> 10) & 1) != 0 { io.src#[0..=10] << 4 } else { _mux_10 }
  const lshift_result_lzd__w1 = _mux_11
  io.src = io_src
  io.priority_shiftValue = io_priority_shiftValue
  io.lshift_result = lshift_result_lzd__w1#[4..=14]
  io.lzd_result = lshift_result_lzd__w1#[0..=3]
  io_lshift_result = io.lshift_result
  io_lzd_result = io.lzd_result
}
