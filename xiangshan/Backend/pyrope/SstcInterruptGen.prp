pub mod SstcInterruptGen::[timecheck=false](clock:u1, reset:u1, i:(stime:(valid:u1, bits:u64), vstime:(valid:u1, bits:u64), stimecmp:(wen:u1, rdata:u64), vstimecmp:(wen:u1, rdata:u64), htimedeltaWen:u1, menvcfg:(wen:u1, STCE:u1), henvcfg:(wen:u1, STCE:u1))) -> (o:(STIP:u1, VSTIP:u1)@[]) {
  reg o_STIP_r:u1:[init=0, reset_pin=ref reset, async=true]
  reg o_VSTIP_r:u1:[init=0, reset_pin=ref reset, async=true]
  if ((((i.stime.valid | i.stimecmp.wen) & 1) | i.menvcfg.wen) & 1) != 0 {
    o_STIP_r = unsigned(i.stime.bits >= i.stimecmp.rdata) & i.menvcfg.STCE & 1
  }
  if ((((((((i.vstime.valid | i.vstimecmp.wen) & 1) | i.htimedeltaWen) & 1) | i.menvcfg.wen) & 1) | i.henvcfg.wen) & 1) != 0 {
    o_VSTIP_r = unsigned(i.vstime.bits >= i.vstimecmp.rdata) & i.henvcfg.STCE & 1
  }
  const t38 = o_VSTIP_r | (o_STIP_r << 1)
  mut `o__bpo.STIP` = (t38 >> 1) & 1
  mut `o__bpo.VSTIP` = t38 & 1
  o.STIP = `o__bpo.STIP`
  o.VSTIP = `o__bpo.VSTIP`
}
