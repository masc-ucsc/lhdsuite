pub mod DpcModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), trapToD:(privState:(valid:u1, bits:(PRVM:u2, V:u1)), dcsr:(valid:u1, bits:(DEBUGVER:u4, EXTCAUSE:u3, CETRIG:u1, EBREAKVS:u1, EBREAKVU:u1, EBREAKM:u1, EBREAKS:u1, EBREAKU:u1, STEPIE:u1, STOPCOUNT:u1, STOPTIME:u1, CAUSE:u3, V:u1, MPRVEN:u1, NMIP:u1, STEP:u1, PRV:u2)), dpc:(valid:u1, bits:(epc:u63)), targetPc:(valid:u1, bits:(pc:u64, raiseIPF:u1, raiseIAF:u1, raiseIGPF:u1)), debugMode:(valid:u1, bits:u1), debugIntrEnable:(valid:u1, bits:u1))) -> (rdata:u64@[], regOut:(epc:u63)@[]) {
  reg reg_0:u63:[init=0, reset_pin=ref reset, async=true]
  mut `reg_init.epc` = 0
  mut `wdata.epc` = w.wdata#[1..=63]
  mut _mux_1:u63 = if trapToD.dpc.valid != 0 { trapToD.dpc.bits.epc#[0..=62] } else { 0 }
  mut _mux_2:u63 = if w.wen != 0 { `wdata.epc`#[0..=62] } else { 0 }
  mut _mux_3:u63 = if ((w.wen | trapToD.dpc.valid) & 1) != 0 { _mux_1 | _mux_2 } else { reg_0 }
  reg_0 = _mux_3
  mut `regOut__bpo.epc` = reg_0
  regOut.epc = `regOut__bpo.epc`
  rdata = reg_0 << 1
}
