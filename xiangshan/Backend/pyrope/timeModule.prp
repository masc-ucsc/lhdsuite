pub mod timeModule::[timecheck=false](clock:u1, reset:u1, w:(wen:u1, wdata:u64), mHPM:(cycle:u64, time_0:(valid:u1, bits:u64), instret:u64, hpmcounters:u1856), v:u1, nextV:u1, htimedelta:u64, debugModeStopTime:u1) -> (rdata:u64@[], updated:u1@[], stime:u64@[], vstime:u64@[]) {
  reg reg_0:u64
  reg virtModeChanged:u1:[init=0, reset_pin=ref reset, async=true]
  reg updated_last_REG:u1:[init=0, reset_pin=ref reset, async=true]
  const vstimeTmp__w1 = (mHPM.time_0.bits + htimedelta)#[0..=63]
  const updated_last__w1 = updated_last_REG
  mut `wdata.time_0` = w.wdata#[0..=63]
  mut _mux_1:u64 = if v != 0 { vstimeTmp__w1 } else { mHPM.time_0.bits#[0..=63] }
  mut _mux_2:u64 = if (((mHPM.time_0.valid & (~debugModeStopTime) & 1 & 1) | virtModeChanged) & 1) != 0 { _mux_1 } else { reg_0 }
  reg_0 = _mux_2
  virtModeChanged = unsigned(nextV != v)
  updated_last_REG = mHPM.time_0.valid & (~debugModeStopTime) & 1 & 1
  rdata = reg_0
  updated = updated_last__w1
  stime = mHPM.time_0.bits
  vstime = vstimeTmp__w1
}
