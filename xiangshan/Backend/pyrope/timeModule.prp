pub mod timeModule::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), mHPM:(cycle:U64, time_0:(valid:U1, bits:U64), instret:U64, hpmcounters:U1856), v:U1, nextV:U1, htimedelta:U64, debugModeStopTime:U1) -> (rdata:U64@[], updated:U1@[], stime:U64@[], vstime:U64@[]) {
  reg reg_0:U64
  reg virtModeChanged:U1:[initial=0, reset_pin=`reset`, async=true]
  reg updated_last_REG:U1:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U64
  const vstimeTmp__w1 = (mHPM.time_0.bits + htimedelta)#[0..<0x40]
  const updated_last__w1 = updated_last_REG
  mut `wdata.time_0` = w.wdata#[0..<0x40]
  mut t7 = _GEN
  mut _mux_1:U64 = if v != 0 { vstimeTmp__w1#[0..<0x40] } else { mHPM.time_0.bits#[0..<0x40] }
  mut _mux_2:U64 = if (((mHPM.time_0.valid & (~debugModeStopTime) & 1) | virtModeChanged) & 1) != 0 { _mux_1#[0..<0x40] } else { reg_0#[0..<0x40] }
  t7 = _mux_2
  reg_0 = t7
  _GEN = t7
  if not (`reset` != 0) {
    virtModeChanged = U1(nextV != v)
  }
  if not (`reset` != 0) {
    updated_last_REG = mHPM.time_0.valid & (~debugModeStopTime) & 1
  }
  rdata = reg_0#[0..<0x40]
  updated = updated_last__w1
  stime = mHPM.time_0.bits
  vstime = vstimeTmp__w1
}
