pub comb GetE8OffsetInVreg::[timecheck=false](`in`:(eewOH:U4, idx:U7)) -> (out:(offset:U4)) {
  wire `out__bpr.offset`:U4 = nil
  mut _mux_1:U4 = if (`in`.eewOH & 1) != 0 { `in`.idx#[0..<4] } else { 0 }
  mut _mux_2:U4 = if `in`.eewOH#[1..<2] != 0 { `in`.idx#[0..<3] << 1 } else { 0 }
  mut _mux_3:U4 = if `in`.eewOH#[2..<3] != 0 { `in`.idx#[0..<2] << 2 } else { 0 }
  mut _mux_4:U4 = if `in`.eewOH#[3..<4] != 0 { (`in`.idx & 1) << 3 } else { 0 }
  mut `out__bpo.offset` = (((_mux_1 | _mux_2)#[0..<4] | _mux_3)#[0..<4] | _mux_4)#[0..<4]
  const t31 = `out__bpo.offset`
  `out__bpr.offset` = t31
  out.offset = t31
}
