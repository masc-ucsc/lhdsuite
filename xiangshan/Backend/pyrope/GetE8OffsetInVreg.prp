pub comb GetE8OffsetInVreg::[timecheck=false](`in`:(eewOH:u4, idx:u7)) -> (out:(offset:u4)) {
  mut _mux_1:u4 = if (`in`.eewOH & 1) != 0 { `in`.idx#[0..=3] } else { 0 }
  mut _mux_2:u4 = if ((`in`.eewOH >> 1) & 1) != 0 { `in`.idx#[0..=2] << 1 } else { 0 }
  mut _mux_3:u4 = if ((`in`.eewOH >> 2) & 1) != 0 { `in`.idx#[0..=1] << 2 } else { 0 }
  mut _mux_4:u4 = if ((`in`.eewOH >> 3) & 1) != 0 { (`in`.idx & 1) << 3 } else { 0 }
  mut `out__bpo.offset` = ((_mux_1 | _mux_2) | _mux_3) | _mux_4
  out.offset = `out__bpo.offset`
}
