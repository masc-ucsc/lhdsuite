const Adder_xb_20 = import("Adder_xb_20.Adder_xb_20")

pub mod compare_2to1_2::[timecheck=false](io_a:U8, io_b:U8, io_max:U1, io_signed:U1) -> (io_c:U8@[]) {
  wire io:(a:U8, b:U8, max:U1, signed_0:U1, c:U8) = nil
  wire b_inv:U8 = nil
  wire cout:U1 = nil
  wire less:U1 = nil
  wire _io_c_T_1:U8 = nil
  b_inv = ~io.b#[0..=7]
  mut _mux_1:U1 = if io.signed_0 != 0 { (((io.a#[7..<8] ^ b_inv#[7..<8]) & 1) ^ cout) & 1 } else { ~cout }
  less = _mux_1
  mut _mux_2:U8 = if less == io.max { io.b#[0..<8] } else { io.a#[0..<8] }
  _io_c_T_1 = _mux_2
  io.a = io_a#[0..<8]
  io.b = io_b#[0..<8]
  io.max = io_max & 1
  io.signed_0 = io_signed & 1
  io.c = _io_c_T_1#[0..<8]
  mut adder_xb = Adder_xb_20::[name=adder_xb](io_in1 = b_inv, io_in2 = io.a, io_cin = 1)
  cout = adder_xb
  io_c = io.c
}
