const Adder_xb_20 = import("Adder_xb_20.Adder_xb_20")

pub mod compare_2to1_2::[timecheck=false](io_a:u8, io_b:u8, io_max:u1, io_signed:u1) -> (io_c:u8@[]) {
  wire io:(a:u8, b:u8, max:u1, signed_0:u1, c:u8) = nil
  wire cout:u1
  const b_inv__w1 = (~io.b)#[0..=7]
  mut _mux_1:u1 = if io.signed_0 != 0 { (((((io.a >> 7) & 1) ^ ((b_inv__w1 >> 7) & 1)) & 1) ^ cout) & 1 } else { (~cout) & 1 }
  mut _mux_2:u8 = if _mux_1 == io.max { io.b#[0..=7] } else { io.a#[0..=7] }
  io.a = io_a
  io.b = io_b
  io.max = io_max & 1
  io.signed_0 = io_signed & 1
  io.c = _mux_2
  mut adder_xb = Adder_xb_20::[name=adder_xb](io_in1 = b_inv__w1, io_in2 = io.a, io_cin = 1)
  cout = adder_xb
  io_c = io.c
}
