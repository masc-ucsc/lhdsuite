pub mod Hpmcounter18Module::[timecheck=false](`clock`:Clock, `reset`:U1, w:(wen:U1, wdata:U64), mHPM:(cycle:U64, time_0:(valid:U1, bits:U64), instret:U64, hpmcounters:U1856), debugModeStopCount:U1, unprivCountUpdate:U1) -> (rdata:U64@[]) {
  mut _mux_1:U64 = 0
  mut t7 = 0
  reg reg_0:U64:[initial=0, reset_pin=`reset`, async=true]
  reg _GEN:U64
  mut `reg_init.hpmcounter` = 0
  mut `wdata.hpmcounter` = w.wdata#[0..<0x40]
  t7 = _GEN
  if not (`reset` != 0) {
    _mux_1 = if unprivCountUpdate != 0 { mHPM.hpmcounters#[0x3c0..<0x400] } else { reg_0#[0..<0x40] }
    t7 = _mux_1
    reg_0 = t7
  }
  _GEN = t7
  mut _mux_2:U64 = if debugModeStopCount != 0 { reg_0#[0..<0x40] } else { mHPM.hpmcounters#[0x3c0..<0x400] }
  rdata = _mux_2
}
