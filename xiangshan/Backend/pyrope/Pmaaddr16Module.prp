pub mod Pmaaddr16Module::[timecheck=false](`clock`:Clock, w:(wen:U1, wdata:U64), addrRData:U2048, addrRegOut:U2048) -> (rdata:U64@[], regOut:(ALL:U64)@[]) {
  reg reg_0:U64
  wire `regOut__bpr.ALL`:U64 = nil
  mut `wdata.ALL` = w.wdata#[0..<0x40]
  mut _mux_1:U64 = if w.wen != 0 { `wdata.ALL`#[0..<0x40] } else { reg_0#[0..<0x40] }
  reg_0 = _mux_1
  mut `regOut__bpo.ALL` = addrRegOut#[0x400..<0x440]
  const t12 = `regOut__bpo.ALL`
  `regOut__bpr.ALL` = t12
  regOut.ALL = t12
  rdata = addrRData#[0x400..<0x440]
}
