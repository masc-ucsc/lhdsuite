pub comb RealWBArbiter_27::[timecheck=false](io_in_0_valid:u1, io_in_0_bits:(rfWen:u1, fpWen:u1, vecWen:u1, v0Wen:u1, vlWen:u1, pdest:u5, data:u8)) -> (io_in_0_ready:u1, io_out_valid:u1, io_out_bits:(rfWen:u1, fpWen:u1, vecWen:u1, v0Wen:u1, vlWen:u1, pdest:u5, data:u8)) {
  mut `_GEN.ready` = 0
