pub comb ShiftRightJam_2::[timecheck=false](io_in:U33, io_shamt:U8) -> (io_out:U33, io_sticky:U1) {
  wire io:(`in`:U33, shamt:U8, out:U33, sticky:U1) = nil
  wire exceed_max_shift:U1 = nil
  wire shamt:U6 = nil
  wire _sticky_mask_T:U64 = nil
  wire sticky_mask:U33 = nil
  wire _io_out_T_1:U33 = nil
  exceed_max_shift = U1(io.shamt > 33)
  shamt = io.shamt#[0..<6]
  _sticky_mask_T = (1 << shamt)#[0..<0x40]
  mut _rep_2:U33 = if (exceed_max_shift & 1) != 0 { 0x1ffffffff } else { 0 }
  sticky_mask = ((_sticky_mask_T#[0..<33] - 1)#[0..<33] | _rep_2)#[0..<33]
  mut _mux_3:U33 = if exceed_max_shift != 0 { 0 } else { (io.`in` >> io.shamt)#[0..<33] }
  _io_out_T_1 = _mux_3
  io.`in` = io_in#[0..<33]
  io.shamt = io_shamt#[0..<8]
  io.out = _io_out_T_1#[0..<33]
  mut _b2i_4 = if (io.`in` & sticky_mask)#[0..<33] != 0 { 1 } else { 0 }
  io.sticky = _b2i_4 & 1
  io_out = io.out
  io_sticky = io.sticky
}
