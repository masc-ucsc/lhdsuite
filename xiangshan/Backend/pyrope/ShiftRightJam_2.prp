pub comb ShiftRightJam_2::[timecheck=false](io_in:u33, io_shamt:u8) -> (io_out:u33, io_sticky:u1) {
  wire io:(`in`:u33, shamt:u8, out:u33, sticky:u1) = nil
  const exceed_max_shift__w1 = unsigned(io.shamt > 33)
  mut _rep_2:u33 = if (exceed_max_shift__w1 & 1) != 0 { 0x1ffffffff } else { 0 }
  const sticky_mask__w1 = ((1 << io.shamt#[0..=5])#[0..=63]#[0..=32] - 1)#[0..=32] | _rep_2
  mut _mux_3:u33 = if exceed_max_shift__w1 != 0 { 0 } else { (io.`in` >> io.shamt)#[0..=32] }
  io.`in` = io_in
  io.shamt = io_shamt
  io.out = _mux_3
  io.sticky = unsigned((io.`in` & sticky_mask__w1) != 0) & 1
  io_out = io.out
  io_sticky = io.sticky
}
