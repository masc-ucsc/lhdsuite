pub comb VIMacSrcTypeModule::[timecheck=false](io_in:(fuOpType:u9, vsew:u2, isReverse:u1, isExt:u1, isDstMask:u1, isMove:u1)) -> (io_out:(vs1Type:u4, vs2Type:u4, vdType:u4, illegal:u1)) {
  wire io:(`in`:u15, out:u13) = nil
  const widen__w1 = (io.`in`#[6..=14] >> 3) & 1
  const vsewX2__w1 = (io.`in`#[4..=5] + 1)#[0..=1]
  mut _mux_1:u2 = if widen__w1 != 0 { vsewX2__w1 } else { io.`in`#[4..=5] }
  mut `_GEN.vs1Type` = ((((io.`in`#[6..=14] >> 5) & 1) & 1) << 2) | io.`in`#[4..=5]
  mut `_GEN.vs2Type` = ((((io.`in`#[6..=14] >> 6) & 1) & 1) << 2) | io.`in`#[4..=5]
  mut `_GEN.vdType` = ((((io.`in`#[6..=14] >> 4) & 1) & 1) << 2) | _mux_1
  mut `_GEN.illegal` = (widen__w1 & unsigned(vsewX2__w1 == 0) & 1) & 1
  io.`in` = ((io_in.fuOpType << 6) | (io_in.vsew << 4) | (io_in.isReverse << 3) | (io_in.isExt << 2) | (io_in.isDstMask << 1) | io_in.isMove)#[0..=14]
  io.out = ((`_GEN.vs1Type` << 9) | (`_GEN.vs2Type` << 5) | (`_GEN.vdType` << 1) | `_GEN.illegal`)#[0..=12]
  const t88 = io.out
  mut `io_out__bpo.vs1Type` = t88#[9..=12]
  mut `io_out__bpo.vs2Type` = t88#[5..=8]
  mut `io_out__bpo.vdType` = t88#[1..=4]
  mut `io_out__bpo.illegal` = t88 & 1
  io_out.vs1Type = `io_out__bpo.vs1Type`
  io_out.vs2Type = `io_out__bpo.vs2Type`
  io_out.vdType = `io_out__bpo.vdType`
  io_out.illegal = `io_out__bpo.illegal`
}
