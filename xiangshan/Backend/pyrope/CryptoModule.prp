const BlockCipherModule = import("BlockCipherModule.BlockCipherModule")
const HashModule = import("HashModule.HashModule")

pub mod CryptoModule::[timecheck=false](`clock`:Clock, io_src:U128, io_func:U9, io_regEnable:U1) -> (io_out:U64@[]) {
  reg funcReg:U9
  wire _blockCipherModule_io_out:U64 = nil
  wire _hashModule_io_out:U64 = nil
  mut _mux_1:U64 = if funcReg#[4..<5] != 0 { _hashModule_io_out#[0..<0x40] } else { _blockCipherModule_io_out#[0..<0x40] }
  mut `io.src` = io_src#[0..<0x80]
  mut `io.func` = io_func#[0..<9]
  mut `io.regEnable` = io_regEnable & 1
  mut `io.out` = _mux_1#[0..<0x40]
  if `io.regEnable` != 0 {
    funcReg = `io.func`
  }
  mut hashModule = HashModule::[name=hashModule](`clock` = `clock`, io_src = `io.src`#[0..<0x40], io_func = `io.func`, io_regEnable = `io.regEnable`)
  _hashModule_io_out = hashModule
  mut blockCipherModule = BlockCipherModule::[name=blockCipherModule](`clock` = `clock`, io_src = `io.src`, io_func = `io.func`, io_regEnable = `io.regEnable`)
  _blockCipherModule_io_out = blockCipherModule
  io_out = `io.out`
}
