const BlockCipherModule = import("BlockCipherModule.BlockCipherModule")
const HashModule = import("HashModule.HashModule")

pub mod CryptoModule::[timecheck=false](clock:u1, io_src:u128, io_func:u9, io_regEnable:u1) -> (io_out:u64@[]) {
  reg funcReg:u9
  wire _blockCipherModule_io_out:u64
  wire _hashModule_io_out:u64
  mut _mux_1:u64 = if ((funcReg >> 4) & 1) != 0 { _hashModule_io_out } else { _blockCipherModule_io_out }
  mut `io.src` = io_src
  mut `io.func` = io_func
  mut `io.regEnable` = io_regEnable & 1
  mut `io.out` = _mux_1
  if `io.regEnable` != 0 {
    funcReg = `io.func`
  }
  mut hashModule = HashModule::[name=hashModule](clock = clock, io_src = `io.src`#[0..=63], io_func = `io.func`, io_regEnable = `io.regEnable`)
  _hashModule_io_out = hashModule
  mut blockCipherModule = BlockCipherModule::[name=blockCipherModule](clock = clock, io_src = `io.src`, io_func = `io.func`, io_regEnable = `io.regEnable`)
  _blockCipherModule_io_out = blockCipherModule
  io_out = `io.out`
}
