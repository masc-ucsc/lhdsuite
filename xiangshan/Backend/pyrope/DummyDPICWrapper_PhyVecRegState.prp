const DiffExtPhyVecRegState = import("DiffExtPhyVecRegState.DiffExtPhyVecRegState")

pub mod DummyDPICWrapper_PhyVecRegState::[timecheck=false](clock:u1, reset:u1, io:(valid:u1, bits:(value:u19200, coreid:u8))) -> () {
  mut dpic = DiffExtPhyVecRegState::[name=dpic](clock = clock, enable = io.valid & (~reset) & 1 & 1, io = ((io.valid << 0x4b08) | (io.bits.value << 8) | io.bits.coreid)#[0..=19207])
}
