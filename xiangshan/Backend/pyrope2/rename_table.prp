// RenameTable.scala: speculative, architectural, and differential mappings.
const snapshot_next = import("snapshot_queue.snapshot_next")

pub mod rename_table<ENTRIES=32, ADDRESS_BITS=5, READ_PORTS=16, IDENTITY_RESET=false, DIFF_FIRST=0, DIFF_COUNT=32, Holds, AddressBus, Writes, DiffWrites, ReadData, DiffData>::[
  timecheck = false
](
  clock:u1,
  reset:u1,
  redirect:u1,
  read_hold:Holds,
  read_addr:AddressBus,
  spec_writes:Writes,
  arch_writes:Writes,
  diff_writes:DiffWrites,
  snpt:(snptEnq:u1, snptDeq:u1, useSnpt:u1, snptSelect:u2, flushVec:u4)
) -> (read_data:ReadData@[], old_data:u64@[], free:u8@[], diff_data:DiffData@[]) {
  comptime const LANES = 8
  comptime const DATA_BITS               = 8
  comptime const WRITE_BITS              = DATA_BITS + ADDRESS_BITS + 1
  comptime const VALID = WRITE_BITS - 1
  comptime const TABLE_BITS              = ENTRIES*DATA_BITS
  comptime mut initial_table:[ENTRIES]u8 = 0
  if IDENTITY_RESET {
    for entry in 0 ..< ENTRIES { initial_table[entry] = entry }
  }
  reg spec_table:unsigned(bits=TABLE_BITS):[reset_pin = ref reset, async = true]     = initial_table#[..]
  reg arch_table:unsigned(bits=TABLE_BITS):[reset_pin = ref reset, async = true]     = initial_table#[..]
  reg difftest_table:unsigned(bits=TABLE_BITS):[reset_pin = ref reset, async = true] = initial_table#[..]
  reg old_pdest:u64:[reset_pin = ref reset, async = true] = 0
  reg need_free:u8:[reset_pin = ref reset, async = true] = 0
  reg t1_redirect_last_REG:u1:[reset_pin = ref reset, async = true]                  = 0
  reg restore:u1 = nil
  reg t1_wSpec:unsigned(bits=LANES * WRITE_BITS) = nil
  reg t1_snpt:u9:[reset_pin = ref reset, async = true] = 0
  reg t2_snpt:u9:[reset_pin = ref reset, async = true] = 0
  reg read_addresses:unsigned(bits=READ_PORTS * ADDRESS_BITS) = nil
  reg bypass:unsigned(bits=READ_PORTS * LANES) = nil

  // The RTL tables are packed, asynchronously reset registers. Array reset
  // initializers would instead introduce a multi-cycle memory restore sweep.

  // Four snapshots hold the table before that cycle's speculative writes.
  reg snapshots:unsigned(bits=4 * TABLE_BITS)             = nil
  reg snptEnqPtr:u3:[reset_pin = ref reset, async = true] = 0
  reg snptDeqPtr:u3:[reset_pin = ref reset, async = true] = 0
  reg snptValids:u4:[reset_pin = ref reset, async = true] = 0
  const queue = snapshot_next<WIDTH=TABLE_BITS>(
    enqueue=t1_snpt#[8] != 0, data=spec_table, dequeue=t1_snpt#[7] != 0, redirect=t1_redirect_last_REG != 0, flush=t1_snpt#[0 ..= 3],
    snapshots=snapshots, snptEnqPtr=snptEnqPtr, snptDeqPtr=snptDeqPtr, snptValids=snptValids
  )
  const selected_snapshot:unsigned(bits=TABLE_BITS) = (snapshots >> (t2_snpt#[4 ..= 5]*TABLE_BITS))#[0 ..< TABLE_BITS]
  snapshots = queue.payloads
  snptEnqPtr = queue.enq_ptr
  snptDeqPtr = queue.deq_ptr
  snptValids = queue.valids

  // Each collection has last-lane priority. Out-of-range writes hit no entry.
  for entry in 0 ..< ENTRIES {
    mut next_spec:u8 = spec_table#[(entry*DATA_BITS) ..+ DATA_BITS]
    mut next_arch:u8 = arch_table#[(entry*DATA_BITS) ..+ DATA_BITS]
    mut next_diff:u8 = difftest_table#[(entry*DATA_BITS) ..+ DATA_BITS]
    for lane in 0 ..< LANES {
      const speculative   = t1_wSpec#[(lane*WRITE_BITS) ..+ WRITE_BITS]
      const architectural = arch_writes#[(lane*WRITE_BITS) ..+ WRITE_BITS]
      if speculative#[VALID] != 0 and speculative#[DATA_BITS ..+ ADDRESS_BITS] == entry {
        next_spec = speculative#[0 ..< DATA_BITS]
      }
      if architectural#[VALID] != 0 and architectural#[DATA_BITS ..+ ADDRESS_BITS] == entry {
        next_arch = architectural#[0 ..< DATA_BITS]
      }
    }
    if restore != 0 {
      next_spec = if t2_snpt#[6] != 0 { selected_snapshot#[(entry*DATA_BITS) ..+ DATA_BITS] }
        else { arch_table#[(entry*DATA_BITS) ..+ DATA_BITS] }
    }
    for lane in 0 ..< 520 {
      const differential = diff_writes#[(lane*WRITE_BITS) ..+ WRITE_BITS]
      if differential#[VALID] != 0 and differential#[DATA_BITS ..+ ADDRESS_BITS] == entry {
        next_diff = differential#[0 ..< DATA_BITS]
      }
    }
    spec_table#[(entry*DATA_BITS) ..+ DATA_BITS]     = next_spec
    arch_table#[(entry*DATA_BITS) ..+ DATA_BITS]     = next_arch
    difftest_table#[(entry*DATA_BITS) ..+ DATA_BITS] = next_diff
  }

  // Reads hold their address independently; yesterday's writes bypass today.
  read_data = 0
  for port in 0 ..< READ_PORTS {
    const address      = read_addresses#[(port*ADDRESS_BITS) ..+ ADDRESS_BITS]
    const next_address = if read_hold#[port] != 0 { address } else { read_addr#[(port*ADDRESS_BITS) ..+ ADDRESS_BITS] }
    mut data:u8        = spec_table#[(address*DATA_BITS) ..+ DATA_BITS]
    mut next_bypass:u8 = 0
    for lane in 0 ..< LANES {
      const prior    = t1_wSpec#[(lane*WRITE_BITS) ..+ WRITE_BITS]
      const incoming = spec_writes#[(lane*WRITE_BITS) ..+ WRITE_BITS]
      if bypass#[port*LANES + lane] != 0 { data = prior#[0 ..< DATA_BITS] }
      next_bypass#[lane] = unsigned(redirect == 0
        and incoming#[VALID] != 0
        and incoming#[DATA_BITS ..+ ADDRESS_BITS] == next_address)
    }
    read_data#[(port*DATA_BITS) ..+ DATA_BITS]            = data
    read_addresses#[(port*ADDRESS_BITS) ..+ ADDRESS_BITS] = next_address
    bypass#[(port*LANES) ..+ LANES] = next_bypass
  }

  // Retiring aliases see preceding writes. Freeing uses the previous old-data
  // vector and suppresses both still-mapped registers and duplicate releases.
  old_data = old_pdest
  free     = need_free
  for lane in 0 ..< LANES {
    const write     = arch_writes#[(lane*WRITE_BITS) ..+ WRITE_BITS]
    const address   = write#[DATA_BITS ..+ ADDRESS_BITS]
    mut previous:u8 = arch_table#[(address*DATA_BITS) ..+ DATA_BITS]
    for earlier in 0 ..< lane {
      const older = arch_writes#[(earlier*WRITE_BITS) ..+ WRITE_BITS]
      if older#[VALID] != 0 and older#[DATA_BITS ..+ ADDRESS_BITS] == address { previous = older#[0 ..< DATA_BITS] }
    }
    old_pdest#[(lane*DATA_BITS) ..+ DATA_BITS] = if write#[VALID] != 0 { previous } else { 0 }
    const retiring = old_pdest#[(lane*DATA_BITS) ..+ DATA_BITS]
    mut available:bool = true
    for entry in 0 ..< ENTRIES { if arch_table#[(entry*DATA_BITS) ..+ DATA_BITS] == retiring { available = false } }
    for earlier in 0 ..< lane { if old_pdest#[(earlier*DATA_BITS) ..+ DATA_BITS] == retiring { available = false } }
    need_free#[lane] = unsigned(available)
  }
  diff_data            = difftest_table#[(DIFF_FIRST*DATA_BITS) ..+ (DIFF_COUNT*DATA_BITS)]
  t1_redirect_last_REG = redirect
  restore              = t1_redirect_last_REG
  t1_wSpec             = if redirect != 0 { 0 } else { spec_writes }
  t1_snpt              = (snpt.snptEnq << 8) | (snpt.snptDeq << 7) | (snpt.useSnpt << 6) | (snpt.snptSelect << 4) | snpt.flushVec
  t2_snpt              = t1_snpt
}
