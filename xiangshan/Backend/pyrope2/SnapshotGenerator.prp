// Public RTL-compatible entry; payload layout belongs to this boundary.
const snapshot_next = import("snapshot_queue.snapshot_next")

pub mod SnapshotGenerator::[timecheck=false](clock:Clock, reset:U1, io_enq:U1, io_enqData:(flag:U1, value:U9), io_deq:U1, io_redirect:U1, io_flushVec:U4) -> (io_snapshots:U40@[], io_enqPtr:(flag:U1, value:U2)@[], io_deqPtr:(flag:U1, value:U2)@[], io_valids:U4@[]) {
  reg snapshots:U40 = nil
  reg snptEnqPtr:U3:[reset_pin=reset, async=true] = 0
  reg snptDeqPtr:U3:[reset_pin=reset, async=true] = 0
  reg snptValids:U4:[reset_pin=reset, async=true] = 0
  const payload:U10 = (io_enqData.value, io_enqData.flag)#[..]
  const queue = snapshot_next<WIDTH=10>(
    enqueue=io_enq != 0, data=payload, dequeue=io_deq != 0,
    redirect=io_redirect != 0, flush=io_flushVec, snapshots=snapshots,
    snptEnqPtr=snptEnqPtr, snptDeqPtr=snptDeqPtr, snptValids=snptValids)
  io_snapshots = snapshots
  io_enqPtr.flag = snptEnqPtr#[2]
  io_enqPtr.value = snptEnqPtr#[0..=1]
  io_deqPtr.flag = snptDeqPtr#[2]
  io_deqPtr.value = snptDeqPtr#[0..=1]
  io_valids = snptValids
  snapshots = queue.payloads
  snptEnqPtr = queue.enq_ptr
  snptDeqPtr = queue.deq_ptr
  snptValids = queue.valids
}
