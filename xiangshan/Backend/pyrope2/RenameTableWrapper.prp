// RenameTable.scala, fixed Backend configuration: eight rename/retire lanes.
// The external generated interface is preserved for Backend and its testbench.
const table = import("rename_table.rename_table")

comptime const LANES       = 8
comptime const DIFF_LANES  = 520
comptime const COMMIT_BITS = 20
comptime const DATA_BITS   = 8
comptime const RF_WEN      = 5
comptime const FP_WEN      = 4
comptime const VEC_WEN     = 3
comptime const V0_WEN      = 2

// External packed lanes are least-significant first. A commit lane is
// {ldest[19:14], pdest[13:6], rf/fp/vec/v0 enables[5:2], other flags[1:0]}.
// The existing table consumes {wen, address, data} lanes in the same order.
// v0 has one entry and carries no address bits.
comb commit_writes<ADDRESS_BITS, ENABLE_BIT, SINGLE=false>(
  rename,
  commits:(isCommit:U1, commitValid:U8, isWalk:U1, walkValid:U8, info:U160),
  differential:(isCommit:U1, commitValid:U520, info:U10400)
) -> (spec, arch, diff) {
  comptime const WRITE_BITS = ADDRESS_BITS + DATA_BITS + 1
  comptime const VALID = WRITE_BITS - 1
  mut speculative:Unsigned(bits=LANES*WRITE_BITS)      = 0
  mut architectural:Unsigned(bits=LANES*WRITE_BITS)    = 0
  mut diff_writes:Unsigned(bits=DIFF_LANES*WRITE_BITS) = 0
  for lane in 0 ..< LANES {
    const info = commits.info#[(lane*COMMIT_BITS) ..+ COMMIT_BITS]
    const address = if SINGLE { 0 } else { info#[14 ..+ ADDRESS_BITS] }
    const payload = (address << DATA_BITS) | info#[6 ..+ DATA_BITS]
    const retiring = commits.isCommit != 0 and commits.commitValid#[lane] != 0 and info#[ENABLE_BIT] != 0
    const walking = commits.isWalk != 0 and commits.walkValid#[lane] != 0 and info#[ENABLE_BIT] != 0
    const incoming = rename#[(lane*WRITE_BITS) ..+ WRITE_BITS]
    architectural#[(lane*WRITE_BITS) ..+ WRITE_BITS] = (Unsigned(retiring) << VALID) | payload
    // Rename wins over the walk write in the same lane.
    speculative#[(lane*WRITE_BITS)
      ..+ WRITE_BITS] = if incoming#[VALID] != 0 { incoming } else { (Unsigned(walking) << VALID) | payload }
  }
  for lane in 0 ..< DIFF_LANES {
    const info = differential.info#[(lane*COMMIT_BITS) ..+ COMMIT_BITS]
    const address = if SINGLE { 0 } else { info#[14 ..+ ADDRESS_BITS] }
    const enabled = differential.isCommit != 0 and differential.commitValid#[lane] != 0 and info#[ENABLE_BIT] != 0
    diff_writes#[(lane*WRITE_BITS) ..+ WRITE_BITS] = (Unsigned(enabled) << VALID) | (address << DATA_BITS) | info#[6 ..+ DATA_BITS]
  }
  spec = speculative
  arch = architectural
  diff = diff_writes
}

