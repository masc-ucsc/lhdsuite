    io_vecReadPorts_3_1_addr, io_vecReadPorts_3_2_addr, io_vecReadPorts_4_0_addr, io_vecReadPorts_4_1_addr, io_vecReadPorts_4_2_addr,
    io_vecReadPorts_5_0_addr, io_vecReadPorts_5_1_addr, io_vecReadPorts_5_2_addr, io_vecReadPorts_6_0_addr, io_vecReadPorts_6_1_addr,
    io_vecReadPorts_6_2_addr, io_vecReadPorts_7_0_addr, io_vecReadPorts_7_1_addr, io_vecReadPorts_7_2_addr
  )#[..]

  // v0/vl each have one entry and therefore carry no address bits.
  // Their read holds have no effect: the sole logical address is always zero.
  const v0_rename_data:U64 = (io_v0RenamePorts_0_data, io_v0RenamePorts_1_data, io_v0RenamePorts_2_data, io_v0RenamePorts_3_data, io_v0RenamePorts_4_data,
                              io_v0RenamePorts_5_data, io_v0RenamePorts_6_data, io_v0RenamePorts_7_data)#[..]
  const v0_rename_enable:U8 = (io_v0RenamePorts_0_wen, io_v0RenamePorts_1_wen, io_v0RenamePorts_2_wen, io_v0RenamePorts_3_wen, io_v0RenamePorts_4_wen,
                               io_v0RenamePorts_5_wen, io_v0RenamePorts_6_wen, io_v0RenamePorts_7_wen)#[..]
  mut v0_rename:U72        = 0
  const vl_rename_data:U64 = (io_vlRenamePorts_0_data, io_vlRenamePorts_1_data, io_vlRenamePorts_2_data, io_vlRenamePorts_3_data, io_vlRenamePorts_4_data,
                              io_vlRenamePorts_5_data, io_vlRenamePorts_6_data, io_vlRenamePorts_7_data)#[..]
  const vl_rename_enable:U8 = (io_vlRenamePorts_0_wen, io_vlRenamePorts_1_wen, io_vlRenamePorts_2_wen, io_vlRenamePorts_3_wen, io_vlRenamePorts_4_wen,
                               io_vlRenamePorts_5_wen, io_vlRenamePorts_6_wen, io_vlRenamePorts_7_wen)#[..]
  mut vl_rename:U72 = 0
  mut vl_spec:U72   = 0
  mut vl_arch:U72   = 0
  mut vl_diff:U72   = 0
  for lane in 0 ..< LANES {
    v0_rename#[(lane*9) ..+ 9] = (v0_rename_enable#[lane] << 8) | v0_rename_data#[(lane*DATA_BITS) ..+ DATA_BITS]
    vl_rename#[(lane*9) ..+ 9] = (vl_rename_enable#[lane] << 8) | vl_rename_data#[(lane*DATA_BITS) ..+ DATA_BITS]
    const pdest                = io_vlCommits.pdestVl#[(lane*5) ..+ 5]
    const walking              = io_vlCommits.isWalk != 0 and io_vlCommits.walkValid#[lane] != 0
    const retiring             = io_vlCommits.isCommit != 0 and io_vlCommits.commitValid#[lane] != 0
    vl_spec#[(lane*9) ..+ 9]   = if vl_rename_enable#[lane] != 0 { vl_rename#[(lane*9) ..+ 9] }
      else { (Unsigned(walking) << 8) | pdest }
    vl_arch#[(lane*9) ..+ 9]   = (Unsigned(retiring) << 8) | pdest
    // VL's differential channel has eight lanes and no isCommit qualifier.
    vl_diff#[(lane*9) ..+ 9] = (io_diffVlCommits.commitValid#[lane] << 8) | io_diffVlCommits.pdestVl#[(lane*5) ..+ 5]
  }

  const int_writes = commit_writes<ADDRESS_BITS=5,ENABLE_BIT=RF_WEN,SINGLE=false>(
    rename=io_intRenamePorts, commits=io_rabCommits, differential=io_diffCommits
  )
  const fp_writes = commit_writes<ADDRESS_BITS=6,ENABLE_BIT=FP_WEN,SINGLE=false>(
    rename=io_fpRenamePorts, commits=io_rabCommits, differential=io_diffCommits
  )
  const vec_writes = commit_writes<ADDRESS_BITS=6,ENABLE_BIT=VEC_WEN,SINGLE=false>(
    rename=io_vecRenamePorts, commits=io_rabCommits, differential=io_diffCommits
  )
  const v0_writes = commit_writes<ADDRESS_BITS=0,ENABLE_BIT=V0_WEN,SINGLE=true>(
    rename=v0_rename, commits=io_rabCommits, differential=io_diffCommits
  )

  const int_rat = table<ENTRIES=32,ADDRESS_BITS=5,READ_PORTS=16,IDENTITY_RESET=false,DIFF_FIRST=0,DIFF_COUNT=32>(
    clock=clock, reset=reset, redirect=io_redirect, snpt=io_snpt, read_hold=int_hold, read_addr=int_addr, spec_writes=int_writes.spec,
    arch_writes=int_writes.arch, diff_writes=int_writes.diff
  )

  const fp_rat = table<ENTRIES=34,ADDRESS_BITS=6,READ_PORTS=24,IDENTITY_RESET=true,DIFF_FIRST=0,DIFF_COUNT=32>(
    clock=clock, reset=reset, redirect=io_redirect, snpt=io_snpt, read_hold=fp_hold, read_addr=fp_addr, spec_writes=fp_writes.spec, arch_writes=fp_writes.arch,
    diff_writes=fp_writes.diff
  )

  const vec_rat = table<ENTRIES=47,ADDRESS_BITS=6,READ_PORTS=24,IDENTITY_RESET=true,DIFF_FIRST=1,DIFF_COUNT=31>(
    clock=clock, reset=reset, redirect=io_redirect, snpt=io_snpt, read_hold=vec_hold, read_addr=vec_addr, spec_writes=vec_writes.spec,
    arch_writes=vec_writes.arch, diff_writes=vec_writes.diff
  )

  const v0_rat = table<ENTRIES=1,ADDRESS_BITS=0,READ_PORTS=8,IDENTITY_RESET=false,DIFF_FIRST=0,DIFF_COUNT=1>(
    clock=clock, reset=reset, redirect=io_redirect, snpt=io_snpt, read_hold=U8(0), read_addr=U8(0), spec_writes=v0_writes.spec, arch_writes=v0_writes.arch,
    diff_writes=v0_writes.diff
  )

  const vl_rat = table<ENTRIES=1,ADDRESS_BITS=0,READ_PORTS=8,IDENTITY_RESET=false,DIFF_FIRST=0,DIFF_COUNT=1,DIFF_PORTS=LANES>(
    clock=clock, reset=reset, redirect=io_redirect, snpt=io_snpt, read_hold=U8(0), read_addr=U8(0), spec_writes=vl_spec, arch_writes=vl_arch,
    diff_writes=vl_diff
  )

  // Scalar assignments exist only at the required external read-port boundary.
  io_intReadPorts_0_0_data = int_rat.read_data#[(0*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_0_1_data = int_rat.read_data#[(1*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_1_0_data = int_rat.read_data#[(2*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_1_1_data = int_rat.read_data#[(3*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_2_0_data = int_rat.read_data#[(4*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_2_1_data = int_rat.read_data#[(5*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_3_0_data = int_rat.read_data#[(6*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_3_1_data = int_rat.read_data#[(7*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_4_0_data = int_rat.read_data#[(8*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_4_1_data = int_rat.read_data#[(9*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_5_0_data = int_rat.read_data#[(10*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_5_1_data = int_rat.read_data#[(11*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_6_0_data = int_rat.read_data#[(12*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_6_1_data = int_rat.read_data#[(13*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_7_0_data = int_rat.read_data#[(14*DATA_BITS) ..+ DATA_BITS]
  io_intReadPorts_7_1_data = int_rat.read_data#[(15*DATA_BITS) ..+ DATA_BITS]
  io_int_old_pdest         = int_rat.old_data

  io_fpReadPorts_0_0_data = fp_rat.read_data#[(0*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_0_1_data = fp_rat.read_data#[(1*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_0_2_data = fp_rat.read_data#[(2*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_1_0_data = fp_rat.read_data#[(3*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_1_1_data = fp_rat.read_data#[(4*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_1_2_data = fp_rat.read_data#[(5*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_2_0_data = fp_rat.read_data#[(6*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_2_1_data = fp_rat.read_data#[(7*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_2_2_data = fp_rat.read_data#[(8*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_3_0_data = fp_rat.read_data#[(9*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_3_1_data = fp_rat.read_data#[(10*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_3_2_data = fp_rat.read_data#[(11*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_4_0_data = fp_rat.read_data#[(12*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_4_1_data = fp_rat.read_data#[(13*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_4_2_data = fp_rat.read_data#[(14*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_5_0_data = fp_rat.read_data#[(15*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_5_1_data = fp_rat.read_data#[(16*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_5_2_data = fp_rat.read_data#[(17*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_6_0_data = fp_rat.read_data#[(18*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_6_1_data = fp_rat.read_data#[(19*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_6_2_data = fp_rat.read_data#[(20*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_7_0_data = fp_rat.read_data#[(21*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_7_1_data = fp_rat.read_data#[(22*DATA_BITS) ..+ DATA_BITS]
  io_fpReadPorts_7_2_data = fp_rat.read_data#[(23*DATA_BITS) ..+ DATA_BITS]
  io_fp_old_pdest         = fp_rat.old_data

  io_vecReadPorts_0_0_data = vec_rat.read_data#[(0*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_0_1_data = vec_rat.read_data#[(1*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_0_2_data = vec_rat.read_data#[(2*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_1_0_data = vec_rat.read_data#[(3*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_1_1_data = vec_rat.read_data#[(4*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_1_2_data = vec_rat.read_data#[(5*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_2_0_data = vec_rat.read_data#[(6*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_2_1_data = vec_rat.read_data#[(7*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_2_2_data = vec_rat.read_data#[(8*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_3_0_data = vec_rat.read_data#[(9*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_3_1_data = vec_rat.read_data#[(10*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_3_2_data = vec_rat.read_data#[(11*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_4_0_data = vec_rat.read_data#[(12*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_4_1_data = vec_rat.read_data#[(13*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_4_2_data = vec_rat.read_data#[(14*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_5_0_data = vec_rat.read_data#[(15*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_5_1_data = vec_rat.read_data#[(16*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_5_2_data = vec_rat.read_data#[(17*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_6_0_data = vec_rat.read_data#[(18*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_6_1_data = vec_rat.read_data#[(19*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_6_2_data = vec_rat.read_data#[(20*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_7_0_data = vec_rat.read_data#[(21*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_7_1_data = vec_rat.read_data#[(22*DATA_BITS) ..+ DATA_BITS]
  io_vecReadPorts_7_2_data = vec_rat.read_data#[(23*DATA_BITS) ..+ DATA_BITS]
  io_vec_old_pdest         = vec_rat.old_data

  io_v0ReadPorts_0_data = v0_rat.read_data#[(0*DATA_BITS) ..+ DATA_BITS]
  io_v0ReadPorts_1_data = v0_rat.read_data#[(1*DATA_BITS) ..+ DATA_BITS]
  io_v0ReadPorts_2_data = v0_rat.read_data#[(2*DATA_BITS) ..+ DATA_BITS]
  io_v0ReadPorts_3_data = v0_rat.read_data#[(3*DATA_BITS) ..+ DATA_BITS]
  io_v0ReadPorts_4_data = v0_rat.read_data#[(4*DATA_BITS) ..+ DATA_BITS]
  io_v0ReadPorts_5_data = v0_rat.read_data#[(5*DATA_BITS) ..+ DATA_BITS]
  io_v0ReadPorts_6_data = v0_rat.read_data#[(6*DATA_BITS) ..+ DATA_BITS]
  io_v0ReadPorts_7_data = v0_rat.read_data#[(7*DATA_BITS) ..+ DATA_BITS]
  io_v0_old_pdest       = v0_rat.old_data

  io_vlReadPorts_0_data = vl_rat.read_data#[(0*DATA_BITS) ..+ DATA_BITS]
  io_vlReadPorts_1_data = vl_rat.read_data#[(1*DATA_BITS) ..+ DATA_BITS]
  io_vlReadPorts_2_data = vl_rat.read_data#[(2*DATA_BITS) ..+ DATA_BITS]
  io_vlReadPorts_3_data = vl_rat.read_data#[(3*DATA_BITS) ..+ DATA_BITS]
  io_vlReadPorts_4_data = vl_rat.read_data#[(4*DATA_BITS) ..+ DATA_BITS]
  io_vlReadPorts_5_data = vl_rat.read_data#[(5*DATA_BITS) ..+ DATA_BITS]
  io_vlReadPorts_6_data = vl_rat.read_data#[(6*DATA_BITS) ..+ DATA_BITS]
  io_vlReadPorts_7_data = vl_rat.read_data#[(7*DATA_BITS) ..+ DATA_BITS]
  io_vl_old_pdest       = vl_rat.old_data

  io_int_need_free = int_rat.free
  io_diff_vl_rat   = vl_rat.diff_data

  // The generated DummyDPICWrapper_Arch*RenameTable bodies are empty combs
  // with no outputs or effects. Their private delay chains are consequently
  // unobservable; the externally visible differential VL mapping stays above.
}
