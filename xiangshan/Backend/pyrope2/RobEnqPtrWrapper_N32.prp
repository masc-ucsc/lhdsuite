// Public 32-entry ROB interface; both sizes use the same pointer update.
const advance = import("enqueue_pointers.advance")

pub mod RobEnqPtrWrapper::[timecheck=false](
  clock:Clock,
  reset:U1,
  io_redirect:(valid:U1, bits:(ftqIdx:(flag:U1, value:U6), canTrain:U1, pc:U50, taken:U1, ftqOffset:U5, isRVC:U1, attribute_0:(branchType:U2, rasAction:U2), target:U50, level:U1, backendIGPF:U1, backendIPF:U1, backendIAF:U1, robIdx:(flag:U1, value:U5), interrupt:U1, isMisPred:U1, fullTarget:U64, stFtqIdx:(flag:U1, value:U6), stFtqOffset:U5, stIsRVC:U1, debug_runahead_checkpoint_id:U64, debugIsCtrl:U1, debugIsMemVio:U1)),
  io_allowEnqueue:U1,
  io_hasBlockBackward:U1,
  io_enq:U8
) -> (io_out:U48@[]) {
  comptime const PTR_BITS = 6
  comptime const RESET_POINTERS = (1 << PTR_BITS) | (2 << (2 * PTR_BITS)) |
    (3 << (3 * PTR_BITS)) | (4 << (4 * PTR_BITS)) | (5 << (5 * PTR_BITS)) |
    (6 << (6 * PTR_BITS)) | (7 << (7 * PTR_BITS))
  reg enqPtrVec:U48:[reset_pin=reset, async=true] = RESET_POINTERS
  const target:U6 = (io_redirect.bits.robIdx.flag << (PTR_BITS - 1)) | io_redirect.bits.robIdx.value
  const can_accept:Bool = (io_allowEnqueue != 0) and (io_hasBlockBackward == 0)
  const count:U4 = if can_accept { io_enq#+[..] } else { 0 }
  enqPtrVec = advance<PTR_BITS=PTR_BITS, CAPACITY=32>(current=enqPtrVec, target=target,
    redirect=io_redirect.valid != 0, skip_target=io_redirect.bits.level == 0, dispatch_count=count)
  io_out = enqPtrVec
}
