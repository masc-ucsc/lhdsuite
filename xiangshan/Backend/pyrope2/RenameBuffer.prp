// Rename allocation buffer, matching the checked-in RenameBuffer.sv:
// Rab.scala, RabSize=352, RenameWidth=RabCommitWidth=8, MaxUopSize=65.
const SnapshotGenerator           = import("SnapshotGenerator.SnapshotGenerator")
comptime const DEPTH              = 352
comptime const RENAME_WIDTH       = 8
comptime const COMMIT_WIDTH       = 8
comptime const DEBUG_WIDTH        = COMMIT_WIDTH*65
comptime const ADDRESS_BITS       = 9
comptime const ADDRESS_SPACE      = 512
comptime const POINTER_BITS       = ADDRESS_BITS + 1
comptime const ENTRY_BITS         = 20
comptime const REQUEST_BITS       = 510
comptime const MAP_BITS           = 14
comptime const STATE_IDLE         = 0
comptime const STATE_SPECIAL_WALK = 1
comptime const STATE_WALK         = 2
// Packed external request and commit-entry layouts, low lane first.
comptime const REQUEST_VALID  = 509
comptime const REQUEST_LDEST  = 457
comptime const REQUEST_PDEST  = 66
comptime const REQUEST_RF_WEN = 411
comptime const REQUEST_V0_WEN = 408
comptime const REQUEST_VL_WEN = 407
comptime const REQUEST_MOVE   = 143
comptime const LDEST          = 14
comptime const PDEST          = 6
comptime const VL_WEN         = 1

comb advance_pointer(pointer:u10, amount:u10) -> (next:u10) {
  const total:u10  = (pointer#[0 ..< ADDRESS_BITS] + amount)#[0 ..= 9]
  const crossed    = total >= DEPTH
  const address:u9 = (if crossed { total - DEPTH } else { total })#[0 ..< ADDRESS_BITS]
  next             = ((pointer#[ADDRESS_BITS] ^ unsigned(crossed)) << ADDRESS_BITS) | address
}

comb rotate_pointer(bits:u352, amount:u4) -> (next:u352) {
  // The RTL's padded lookup returns the original word beyond lane eight.
  next = if amount <= RENAME_WIDTH { ((bits << amount) | (bits >> (DEPTH - amount)))#[0 ..< DEPTH] } else { bits }
}

pub mod RenameBuffer::[timecheck = false](
  clock:u1,
  reset:u1,
  io_redirect_valid:u1,
  io_req:u4080,
  io_fromRob_walkSize:u9,
  io_fromRob_walkEnd:u1,
  io_fromRob_commitSize:u9,
  io_fromRob_vecLoadExcp:(valid:u1, bits:(isStrided:u1, isVlm:u1)),
  io_snpt:(snptEnq:u1, snptDeq:u1, useSnpt:u1, snptSelect:u2, flushVec:u4)
) -> (
  io_canEnq:u1@[],
  io_canEnqForDispatch:u1@[],
  io_commits:(isCommit:u1, commitValid:u8, isWalk:u1, walkValid:u8, info:u160)@[],
  io_diffCommits:(isCommit:u1, commitValid:u520, info:u10400)@[],
  io_status:(walkEnd:u1, commitEnd:u1)@[],
  io_toVecExcpMod:(logicPhyRegMap:u112)@[]
) {
  // State names retain automatic correspondence with the elaborated RTL.
  reg enqPtrVec:[RENAME_WIDTH]u10:[ordering = "old", reset_pin = ref reset, async = true] = (0, 1, 2, 3, 4, 5, 6, 7)
  reg deqPtrVec:[COMMIT_WIDTH]u10:[ordering = "old", reset_pin = ref reset, async = true] = (0, 1, 2, 3, 4, 5, 6, 7)
  reg enqPtrOH:u352:[reset_pin = ref reset, async = true] = 1
  reg deqPtrOH:u352:[reset_pin = ref reset, async = true] = 1
  reg walkPtr:u10 = nil
  reg diffPtr:u10:[reset_pin = ref reset, async = true] = 0
  reg renameBuffer:[DEPTH]u20:[ordering = "old"] = nil
  const entries_word:u7040 = renameBuffer#[..]

  reg state:u2:[reset_pin = ref reset, async = true]           = STATE_IDLE
  reg robWalkEndReg:u1:[reset_pin = ref reset, async = true]   = 0
  reg commitSize:u9:[reset_pin = ref reset, async = true]      = 0
  reg walkSize:u9:[reset_pin = ref reset, async = true]        = 0
  reg specialWalkSize:u9:[reset_pin = ref reset, async = true] = 0
  const idle = state == STATE_IDLE
  const special_walk = state == STATE_SPECIAL_WALK
  const walking = state == STATE_WALK
  const redirect = io_redirect_valid != 0
  const use_snapshot = io_snpt.useSnpt != 0
  const committing = idle or special_walk

  // Allocation uses the count of earlier accepted requests, not lane number.
  mut accepted:u8                = 0
  mut requests:[RENAME_WIDTH]u20 = 0
  for lane in 0 ..< RENAME_WIDTH {
    const request:u510 = io_req#[(lane*REQUEST_BITS) ..+ REQUEST_BITS]
    accepted#[lane]    = unsigned(request#[REQUEST_VALID] != 0 and request#|[REQUEST_V0_WEN ..= REQUEST_RF_WEN] != 0)
    requests[lane]     = (request#[REQUEST_LDEST ..+ 6] << LDEST)
      | (request#[REQUEST_PDEST ..+ 8] << PDEST)
      | (request#[REQUEST_VL_WEN ..+ 5] << VL_WEN)
      | request#[REQUEST_MOVE]
  }
  const enqueue_count:u4    = accepted#+[..]
  mut allocation_slots:u72  = 0
  mut preceding_requests:u3 = 0
  for lane in 0 ..< RENAME_WIDTH {
    allocation_slots#[(lane*ADDRESS_BITS) ..+ ADDRESS_BITS] = enqPtrVec[preceding_requests]#[0 ..< ADDRESS_BITS]
    wrap preceding_requests += accepted#[lane]
  }
  // All reads see old state. Later request lanes have write priority.
  for write_index in 0 ..< DEPTH {
    const entry        = DEPTH - 1 - write_index
    mut next_entry:u20 = renameBuffer[entry]
    for lane in 0 ..< RENAME_WIDTH {
      if accepted#[lane] != 0 and allocation_slots#[(lane*ADDRESS_BITS) ..+ ADDRESS_BITS] == entry {
        next_entry = requests[lane]
      }
    }
    renameBuffer[entry] = next_entry
  }

  // Commit uses the registered one-hot pointer; recovery uses the binary
  // walk pointer. Masked OR preserves multi-hot and out-of-range behavior.
  mut commit_info:u160 = 0
  mut commit_valid:u8  = 0
  mut walk_valid:u8    = 0
  for lane in 0 ..< COMMIT_WIDTH {
    mut commit_entry:u20 = 0
    mut walk_entry:u20   = 0
    for slot in 0 ..< DEPTH {
      const source_slot = if slot >= lane { slot - lane } else { slot + DEPTH - lane }
      const entry:u20   = entries_word#[(slot*ENTRY_BITS) ..+ ENTRY_BITS]
      if deqPtrOH#[source_slot] != 0 { commit_entry = commit_entry | entry }
      if walkPtr#[0 ..< ADDRESS_BITS] == source_slot { walk_entry = walk_entry | entry }
    }
    commit_info#[(lane*ENTRY_BITS) ..+ ENTRY_BITS] = if committing { commit_entry } else { walk_entry }
    commit_valid#[lane] = unsigned((idle and lane < commitSize) or (special_walk and lane < specialWalkSize))
    walk_valid#[lane] = unsigned((walking and lane < walkSize) or (special_walk and lane < specialWalkSize))
  }
  io_commits = (const isCommit=unsigned(committing), const commitValid=commit_valid, const isWalk=unsigned(walking or special_walk),
                const walkValid=walk_valid, const info=commit_info)
  mut commit_number:u4 = 0
  mut walk_number:u4   = 0
  for lane in 0 ..< COMMIT_WIDTH {
    if commit_valid#[0] != 0 and commit_valid#[lane] != 0 { commit_number = lane + 1 }
    if walk_valid#[0] != 0 and walk_valid#[lane] != 0 { walk_number = lane + 1 }
  }
  const commit_count:u4     = if idle { commit_number } else { 0 }
  const walk_count:u4       = if walking { walk_number } else { 0 }
  const special_count:u4    = if special_walk { walk_number } else { 0 }
  const commit_size_next:u9 = (commitSize + io_fromRob_commitSize - commit_count)#[0 ..= 8]
  const walk_size_next:u9   = (walkSize + io_fromRob_walkSize - walk_count)#[0 ..= 8]
  const new_special_size:u9 = if redirect and not use_snapshot { commit_size_next } else { 0 }
  wrap specialWalkSize = specialWalkSize + new_special_size - special_count
  commitSize      = if redirect and not use_snapshot { 0 } else { commit_size_next }
  walkSize        = if redirect { 0 } else { walk_size_next }
  io_status       = (const walkEnd=unsigned(walk_size_next == 0), const commitEnd=unsigned(commit_size_next == 0))

  const special_end   = specialWalkSize <= COMMIT_WIDTH
  const walk_end      = (robWalkEndReg != 0 or (io_fromRob_walkEnd != 0 and io_fromRob_walkSize == 0)) and walkSize <= COMMIT_WIDTH
  const next_state:u2 = if redirect { if use_snapshot { STATE_WALK } else { STATE_SPECIAL_WALK } }
    elif idle { STATE_IDLE }
    elif special_walk and special_end { STATE_WALK }
    elif walking and walk_end { STATE_IDLE }
    else { state }
  state               = next_state
  robWalkEndReg       = unsigned(not redirect and (io_fromRob_walkEnd != 0 or robWalkEndReg != 0))

  mut walkPtrSnapshots_snapshotGen = SnapshotGenerator::[name=walkPtrSnapshots_snapshotGen](
    clock=clock, reset=reset, io_enq=io_snpt.snptEnq, io_enqData=(const flag=enqPtrVec[0]#[ADDRESS_BITS], const value=enqPtrVec[0]#[0
      ..< ADDRESS_BITS]), io_deq=io_snpt.snptDeq, io_redirect=io_redirect_valid, io_flushVec=io_snpt.flushVec
  )
  const snapshot:u10       = (walkPtrSnapshots_snapshotGen.io_snapshots >> (io_snpt.snptSelect*POINTER_BITS))#[0 ..< POINTER_BITS]
  const dequeue_steps:u4   = if idle { commit_count } elif special_walk { special_count } else { 0 }
  const dequeue_base:u10   = advance_pointer(pointer=deqPtrVec[0], amount=dequeue_steps)
  mut dequeue_pointers:u80 = 0
  for lane in 0 ..< COMMIT_WIDTH {
    dequeue_pointers#[(lane*POINTER_BITS) ..+ POINTER_BITS] = advance_pointer(pointer=dequeue_base, amount=lane)
  }
  deqPtrVec                = dequeue_pointers
  deqPtrOH = rotate_pointer(bits=deqPtrOH, amount=dequeue_steps)
  const walk_next:u10      = if idle and next_state == STATE_WALK { snapshot }
    elif special_walk and next_state == STATE_WALK { dequeue_pointers#[0 ..< POINTER_BITS] }
    elif walking and use_snapshot and redirect { snapshot }
    elif walking { advance_pointer(pointer=walkPtr, amount=walk_count) }
    else { walkPtr }
  walkPtr = walk_next
  const recovery_done      = walking and next_state == STATE_IDLE
  const enqueue_base:u10   = if recovery_done { walk_next } else { advance_pointer(pointer=enqPtrVec[0], amount=enqueue_count) }
  mut enqueue_pointers:u80 = 0
  for lane in 0 ..< RENAME_WIDTH {
    enqueue_pointers#[(lane*POINTER_BITS) ..+ POINTER_BITS] = advance_pointer(pointer=enqueue_base, amount=lane)
  }
  enqPtrVec = enqueue_pointers
  const rotated_enqueue:u352 = rotate_pointer(bits=enqPtrOH, amount=enqueue_count)
  enqPtrOH = if recovery_done { (1 << walk_next#[0 ..< ADDRESS_BITS])#[0 ..< DEPTH] } else { rotated_enqueue }

  // Queue occupancy and enqueue credit are nine-bit RTL arithmetic.
  const lap_distance = if enqPtrVec[0]#[ADDRESS_BITS] == deqPtrVec[0]#[ADDRESS_BITS] { 0 } else { DEPTH }
  const occupied:u9 = (enqPtrVec[0]#[0 ..< ADDRESS_BITS] - deqPtrVec[0]#[0 ..< ADDRESS_BITS] + lap_distance)#[0 ..= 8]
  const after_enqueue:u9 = (occupied + enqueue_count)#[0 ..= 8]
  reg allowEnqueue_last_REG:u1:[reset_pin = ref reset, async = true]            = 1
  reg allowEnqueueForDispatch_last_REG:u1:[reset_pin = ref reset, async = true] = 1
  allowEnqueue_last_REG = unsigned(after_enqueue <= DEPTH - RENAME_WIDTH)
  allowEnqueueForDispatch_last_REG = unsigned(after_enqueue <= DEPTH - 2*RENAME_WIDTH)
  io_canEnq = allowEnqueue_last_REG & unsigned(idle)
  io_canEnqForDispatch = allowEnqueueForDispatch_last_REG & unsigned(idle)

  // Exception recovery captures logical/physical mappings one cycle later.
  reg vecLoadExcp:u3 = nil
  reg io_toVecExcpMod_logicPhyRegMap_valid_REG:[COMMIT_WIDTH]u1   = nil
  reg io_toVecExcpMod_logicPhyRegMap_bits_lreg_r:[COMMIT_WIDTH]u6 = nil
  reg io_toVecExcpMod_logicPhyRegMap_bits_preg_r:[COMMIT_WIDTH]u8 = nil
  mut exception_map:u112 = 0
  for lane in 0 ..< COMMIT_WIDTH {
    // The public RTL map exposes seven of the eight stored physical bits.
    exception_map#[(lane*MAP_BITS)
      ..+ MAP_BITS] = (io_toVecExcpMod_logicPhyRegMap_valid_REG[lane] << 13)
      | (io_toVecExcpMod_logicPhyRegMap_bits_lreg_r[lane] << 7)
      | io_toVecExcpMod_logicPhyRegMap_bits_preg_r[lane]#[0 ..= 6]
    const map_valid = special_walk and vecLoadExcp#[2] != 0 and commit_valid#[lane] != 0
    io_toVecExcpMod_logicPhyRegMap_valid_REG[lane] = unsigned(map_valid)
    if map_valid {
      io_toVecExcpMod_logicPhyRegMap_bits_lreg_r[lane] = commit_info#[(lane*ENTRY_BITS + LDEST) ..+ 6]
      io_toVecExcpMod_logicPhyRegMap_bits_preg_r[lane] = commit_info#[(lane*ENTRY_BITS + PDEST) ..+ 8]
    }
  }
  io_toVecExcpMod.logicPhyRegMap = exception_map
  if redirect {
    if not use_snapshot {
      vecLoadExcp = (io_fromRob_vecLoadExcp.valid << 2)
        | (io_fromRob_vecLoadExcp.bits.isStrided << 1)
        | io_fromRob_vecLoadExcp.bits.isVlm
    }
  }
  elif special_walk and special_end {
    vecLoadExcp = vecLoadExcp#[0 ..= 1]
  }

  // Debug has COMMIT_WIDTH * MaxUopSize (65) lanes. The elaborated pointer
  // subtracts DEPTH once and then keeps nine address bits, even past one lap.
  // Padding reproduces the RTL's entry-zero result for addresses >= DEPTH.
  mut padded_entries:u10240   = 0
  padded_entries#[0 ..= 7039] = entries_word
  for slot in DEPTH ..< ADDRESS_SPACE {
    padded_entries#[(slot*ENTRY_BITS) ..+ ENTRY_BITS] = entries_word#[0 ..< ENTRY_BITS]
  }
  mut debug_info:u10400 = 0
  mut debug_valid:u520  = 0
  for lane in 0 ..< DEBUG_WIDTH {
    const total = diffPtr#[0 ..< ADDRESS_BITS] + lane
    const address:u9 = (if total >= DEPTH { total - DEPTH } else { total })#[0 ..< ADDRESS_BITS]
    debug_info#[(lane*ENTRY_BITS) ..+ ENTRY_BITS] = (padded_entries >> (address*ENTRY_BITS))#[0 ..< ENTRY_BITS]
    debug_valid#[lane] = unsigned(lane < io_fromRob_commitSize)
  }
  io_diffCommits = (const isCommit=1, const commitValid=debug_valid, const info=debug_info)
  diffPtr        = advance_pointer(pointer=diffPtr, amount=io_fromRob_commitSize)
}
