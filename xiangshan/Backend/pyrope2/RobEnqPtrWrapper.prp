// Public 352-entry ROB interface, matching the checked-in Backend RTL.
const advance = import("enqueue_pointers.advance")

pub mod RobEnqPtrWrapper::[timecheck=false](
  clock:u1,
  reset:u1,
  io_redirect:(valid:u1, bits:(ftqIdx:(flag:u1, value:u6), pc:u50, taken:u1, ftqOffset:u5, isRVC:u1, attribute_0:(branchType:u2, rasAction:u2), target:u50, level:u1, backendIGPF:u1, backendIPF:u1, backendIAF:u1, robIdx:(flag:u1, value:u9), interrupt:u1, isMisPred:u1, fullTarget:u64, stFtqIdx:(flag:u1, value:u6), stFtqOffset:u5, stIsRVC:u1, debug_runahead_checkpoint_id:u64, debugIsCtrl:u1, debugIsMemVio:u1)),
  io_allowEnqueue:u1,
  io_hasBlockBackward:u1,
  io_enq:u8
) -> (io_out:u80@[]) {
  comptime const PTR_BITS = 10
  comptime const RESET_POINTERS = (1 << PTR_BITS) | (2 << (2 * PTR_BITS)) |
    (3 << (3 * PTR_BITS)) | (4 << (4 * PTR_BITS)) | (5 << (5 * PTR_BITS)) |
    (6 << (6 * PTR_BITS)) | (7 << (7 * PTR_BITS))
  reg enqPtrVec:u80:[reset_pin=ref reset, async=true] = RESET_POINTERS
  const target:u10 = (io_redirect.bits.robIdx.flag << (PTR_BITS - 1)) | io_redirect.bits.robIdx.value
  const can_accept:bool = (io_allowEnqueue != 0) and (io_hasBlockBackward == 0)
  const count:u4 = if can_accept { io_enq#+[..] } else { 0 }
  enqPtrVec = advance<PTR_BITS=PTR_BITS, CAPACITY=352>(current=enqPtrVec, target=target,
    redirect=io_redirect.valid != 0, skip_target=io_redirect.bits.level == 0, dispatch_count=count)
  io_out = enqPtrVec
}
