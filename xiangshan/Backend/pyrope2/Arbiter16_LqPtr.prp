// Loop-form Pyrope for XiangShan Arbiter16_LqPtr.
// Reference: XiangShan/build/rtl_rob16/Arbiter16_LqPtr.sv (241 SV lines).
// Design: 16-input priority arbiter over ready/valid/{flag:u1, value:u7} slots.
// Index 0 = highest priority. When no input is valid, chosen=15 and bits=bits[15].
//
// firtool unrolled three per-slot loops that we re-roll here:
//   1. Priority mux chain (indices 14 -> 0, taking bits from the highest-priority
//      valid input, defaulting to index 15).
//   2. Cumulative-OR grant chain (indices 0 -> 15, grant_j = ~any_valid[0..j-1]).
//   3. Ready signal formation (indices 0 -> 15, ready_j = grant_j & io_out_ready).

pub mod Arbiter16_LqPtr::[timecheck=false](
  io_in_0_valid:U1,  io_in_0_bits:(flag:U1, value:U7),
  io_in_1_valid:U1,  io_in_1_bits:(flag:U1, value:U7),
  io_in_2_valid:U1,  io_in_2_bits:(flag:U1, value:U7),
  io_in_3_valid:U1,  io_in_3_bits:(flag:U1, value:U7),
  io_in_4_valid:U1,  io_in_4_bits:(flag:U1, value:U7),
  io_in_5_valid:U1,  io_in_5_bits:(flag:U1, value:U7),
  io_in_6_valid:U1,  io_in_6_bits:(flag:U1, value:U7),
  io_in_7_valid:U1,  io_in_7_bits:(flag:U1, value:U7),
  io_in_8_valid:U1,  io_in_8_bits:(flag:U1, value:U7),
  io_in_9_valid:U1,  io_in_9_bits:(flag:U1, value:U7),
  io_in_10_valid:U1, io_in_10_bits:(flag:U1, value:U7),
  io_in_11_valid:U1, io_in_11_bits:(flag:U1, value:U7),
  io_in_12_valid:U1, io_in_12_bits:(flag:U1, value:U7),
  io_in_13_valid:U1, io_in_13_bits:(flag:U1, value:U7),
  io_in_14_valid:U1, io_in_14_bits:(flag:U1, value:U7),
  io_in_15_valid:U1, io_in_15_bits:(flag:U1, value:U7),
  io_out_ready:U1
) -> (
  io_in_0_ready:U1@[],  io_in_1_ready:U1@[],  io_in_2_ready:U1@[],  io_in_3_ready:U1@[],
  io_in_4_ready:U1@[],  io_in_5_ready:U1@[],  io_in_6_ready:U1@[],  io_in_7_ready:U1@[],
  io_in_8_ready:U1@[],  io_in_9_ready:U1@[],  io_in_10_ready:U1@[], io_in_11_ready:U1@[],
  io_in_12_ready:U1@[], io_in_13_ready:U1@[], io_in_14_ready:U1@[], io_in_15_ready:U1@[],
  io_out_valid:U1@[], io_out_bits:(flag:U1, value:U7)@[], io_chosen:U4@[]
) {
  // Ordered lanes make bit order explicit: lane zero occupies the low bits.
  const valids:U16 = (
    io_in_0_valid, io_in_1_valid, io_in_2_valid, io_in_3_valid,
    io_in_4_valid, io_in_5_valid, io_in_6_valid, io_in_7_valid,
    io_in_8_valid, io_in_9_valid, io_in_10_valid, io_in_11_valid,
    io_in_12_valid, io_in_13_valid, io_in_14_valid, io_in_15_valid
  )#[..]
  const flags:U16 = (
    io_in_0_bits.flag, io_in_1_bits.flag, io_in_2_bits.flag, io_in_3_bits.flag,
    io_in_4_bits.flag, io_in_5_bits.flag, io_in_6_bits.flag, io_in_7_bits.flag,
    io_in_8_bits.flag, io_in_9_bits.flag, io_in_10_bits.flag, io_in_11_bits.flag,
    io_in_12_bits.flag, io_in_13_bits.flag, io_in_14_bits.flag, io_in_15_bits.flag
  )#[..]
  const values:U112 = (
    io_in_0_bits.value, io_in_1_bits.value, io_in_2_bits.value, io_in_3_bits.value,
    io_in_4_bits.value, io_in_5_bits.value, io_in_6_bits.value, io_in_7_bits.value,
    io_in_8_bits.value, io_in_9_bits.value, io_in_10_bits.value, io_in_11_bits.value,
    io_in_12_bits.value, io_in_13_bits.value, io_in_14_bits.value, io_in_15_bits.value
  )#[..]

  // Priority mux, default = index 15 (lowest priority when nothing else is valid).
  // Iterate j from 14 down to 0; whenever slot j is valid, take it (overriding any
  // higher-indexed choice we had so far).
  mut chosen:U4    = 15
  mut sel_flag:U1  = (flags  >> 15) & 1
  mut sel_value:U7 = (values >> 105) & 0x7f
  for i_rev in 0..<15 {
    const j:U4       = (14 - i_rev)#[0..=3]
    const v_j:U1     = (valids >> j) & 1
    const f_j:U1     = (flags  >> j) & 1
    const val_j:U7   = (values >> (j*7)) & 0x7f
    chosen    = if v_j != 0 { j }     else { chosen }
    sel_flag  = if v_j != 0 { f_j }   else { sel_flag }
    sel_value = if v_j != 0 { val_j } else { sel_value }
  }

  // Grant / ready mask: grant_j = ~(any valid at index < j). ready_j = grant_j & io_out_ready.
  // Full-width OR accumulator (no bit-slice write to a mut, to dodge encoder gaps).
  mut earlier_valid:Bool = false
  mut ready_mask:U16 = 0
  for j in 0..<16 {
    const r:U1 = Unsigned(not earlier_valid and (io_out_ready != 0))
    ready_mask = ready_mask | (r << j)
    earlier_valid = earlier_valid or (valids#[j] != 0)
  }

  const any_valid:U1 = if valids != 0 { 1 } else { 0 }

  io_in_0_ready  = ready_mask#[0]
  io_in_1_ready  = ready_mask#[1]
  io_in_2_ready  = ready_mask#[2]
  io_in_3_ready  = ready_mask#[3]
  io_in_4_ready  = ready_mask#[4]
  io_in_5_ready  = ready_mask#[5]
  io_in_6_ready  = ready_mask#[6]
  io_in_7_ready  = ready_mask#[7]
  io_in_8_ready  = ready_mask#[8]
  io_in_9_ready  = ready_mask#[9]
  io_in_10_ready = ready_mask#[10]
  io_in_11_ready = ready_mask#[11]
  io_in_12_ready = ready_mask#[12]
  io_in_13_ready = ready_mask#[13]
  io_in_14_ready = ready_mask#[14]
  io_in_15_ready = ready_mask#[15]

  io_out_valid      = any_valid
  io_out_bits.flag  = sel_flag
  io_out_bits.value = sel_value
  io_chosen         = chosen
}
