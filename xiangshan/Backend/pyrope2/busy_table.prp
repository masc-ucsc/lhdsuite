// BusyTable.scala: ready bits and three two-cycle load-dependency histories.
pub comb dependency_shift(dependency:U6) -> (shifted:U6) { shifted = (dependency << 1) & 0x2a }
pub comb dependency_cancel(dependency:U6, cancel:U6) -> (cancelled:Bool) {
  // Cancel lanes are ordered opposite to the two history-age bits.
  const reversed:U6 = ((cancel & 0x15) << 1) | ((cancel >> 1) & 0x15)
  cancelled         = (dependency & reversed) != 0
}

pub mod busy_table<PREGS, READ_PORTS=16, WRITE_PORTS=9, WAKE_PORTS=9, ZERO_READY=true>::[timecheck = false](
  clock:Clock,
  reset:U1,
  allocations:U72,
  writebacks,
  wake_valid,
  wake_dest,
  wake_dependency,
  wake_shifted,
  cancel:U6,
  addresses
) -> (ready@[], dependency@[]) {
  comptime const ALLOC_PORTS = 8
  comptime const REQUEST_BITS = 9
  comptime const DEPENDENCY_BITS = 6
  reg busy:Unsigned(bits=PREGS):[reset_pin=reset, async = true] = 0
  reg loadDependency:Unsigned(bits=PREGS * DEPENDENCY_BITS):[reset_pin=reset, async = true] = 0
  mut allocation_mask:Unsigned(bits=PREGS) = 0
  mut writeback_mask:Unsigned(bits=PREGS) = 0
  for lane in 0 ..< ALLOC_PORTS {
    const allocation = allocations#[(lane*REQUEST_BITS) ..+ REQUEST_BITS]
    if allocation#[8] != 0 { allocation_mask = allocation_mask | ((1 << allocation#[0 ..= 7])#[0 ..< PREGS]) }
  }
  for lane in 0 ..< WRITE_PORTS {
    const writeback = writebacks#[(lane*REQUEST_BITS) ..+ REQUEST_BITS]
    if writeback#[8] != 0 { writeback_mask = writeback_mask | ((1 << writeback#[0 ..= 7])#[0 ..< PREGS]) }
  }
  mut eligible:Unsigned(bits=WAKE_PORTS) = 0
  for lane in 0 ..< WAKE_PORTS {
    eligible#[lane] = Unsigned(wake_valid#[lane] != 0
      and not dependency_cancel(
        dependency=wake_dependency#[(lane*DEPENDENCY_BITS) ..+ DEPENDENCY_BITS], cancel=cancel
      ))
  }
  for preg in 0 ..< PREGS {
    const old_dependency:U6    = loadDependency#[(preg*DEPENDENCY_BITS) ..+ DEPENDENCY_BITS]
    mut awakened:Bool          = false
    mut incoming_dependency:U6 = 0
    // Mux1H is an OR even if multiple wakes name the same destination.
    for lane in 0 ..< WAKE_PORTS {
      if eligible#[lane] != 0 and wake_dest#[(lane*8) ..+ 8] == preg {
        awakened            = true
        incoming_dependency = incoming_dependency | wake_shifted#[(lane*DEPENDENCY_BITS) ..+ DEPENDENCY_BITS]
      }
    }
    if awakened { loadDependency#[(preg*DEPENDENCY_BITS) ..+ DEPENDENCY_BITS] = incoming_dependency }
    elif old_dependency != 0 { loadDependency#[(preg*DEPENDENCY_BITS) ..+ DEPENDENCY_BITS] = dependency_shift(old_dependency) }
    const cancelled = dependency_cancel(dependency=old_dependency, cancel=cancel)
    if awakened or writeback_mask#[preg] != 0 { busy#[preg] = 0 }
    elif allocation_mask#[preg] != 0 or cancelled { busy#[preg] = if ZERO_READY and preg == 0 { 0 } else { 1 } }
  }
  ready      = 0
  dependency = 0
  for port in 0 ..< READ_PORTS {
    const address       = addresses#[(port*8) ..+ 8]
    mut allocating:Bool = false
    for lane in 0 ..< ALLOC_PORTS {
      const allocation = allocations#[(lane*REQUEST_BITS) ..+ REQUEST_BITS]
      if allocation#[8] != 0 and allocation#[0 ..= 7] == address { allocating = true }
    }
    // Packed shifts preserve zero padding for the integer table's 224..255.
    ready#[port] = Unsigned(busy#[address] == 0 and not allocating)
    dependency#[(port*DEPENDENCY_BITS) ..+ DEPENDENCY_BITS] = (loadDependency >> (address*DEPENDENCY_BITS))#[0 ..< DEPENDENCY_BITS]
  }
}
