pub mod regfile_32x20::[timecheck=false](R0_addr:U5, R0_en:U1, R0_clk:Clock, R1_addr:U5, R1_en:U1, R1_clk:Clock, R2_addr:U5, R2_en:U1, R2_clk:Clock, W0_addr:U5, W0_en:U1, W0_clk:Clock, W0_data:U20) -> (R0_data:U20@[], R1_data:U20@[], R2_data:U20@[]) {
  reg Memory:[32]U20:[ordering="old", __store_clock_pin=W0_clk, __store_posclk=true]
  if (W0_en & 1 & 1) != 0 {
    Memory[W0_addr] = W0_data
  }
  mut _mux_1:U20 = if R0_en != 0 { Memory[R0_addr] } else { 0ub????????????????????#[0..<20] }
  mut _mux_2:U20 = if R1_en != 0 { Memory[R1_addr] } else { 0ub????????????????????#[0..<20] }
  mut _mux_3:U20 = if R2_en != 0 { Memory[R2_addr] } else { 0ub????????????????????#[0..<20] }
  R0_data = _mux_1
  R1_data = _mux_2
  R2_data = _mux_3
}
