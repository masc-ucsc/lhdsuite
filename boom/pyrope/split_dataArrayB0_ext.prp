pub mod split_dataArrayB0_ext::[timecheck=false](RW0_addr:U9, RW0_clk:Clock, RW0_wdata:U64, RW0_en:U1, RW0_wmode:U1, RW0_wmask:U1) -> (RW0_rdata:U64@[]) {
  reg ram:[512]U64:[ordering="old", __store_clock_pin=RW0_clk, __store_posclk=true]
  reg ram_RW_0_r_en_pipe_0:U1:[clock_pin=RW0_clk]
  reg ram_RW_0_r_addr_pipe_0:U9:[clock_pin=RW0_clk]
  const RW0_rdata__w1 = ram[ram_RW_0_r_addr_pipe_0]
  if ((RW0_en & RW0_wmode & 1) & RW0_wmask & 1) != 0 {
    ram[RW0_addr] = RW0_wdata
  }
  ram_RW_0_r_en_pipe_0 = RW0_en & (~RW0_wmode) & 1
  if (RW0_en & (~RW0_wmode) & 1) != 0 {
    ram_RW_0_r_addr_pipe_0 = RW0_addr
  }
  RW0_rdata = RW0_rdata__w1
}
