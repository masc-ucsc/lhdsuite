  mut mem_0_1 = split_dataArrayB0_ext::[name=mem_0_1](RW0_addr = mem_0_1_RW0_addr__w1, RW0_clk = mem_0_1_RW0_clk__w1, RW0_wdata = mem_0_1_RW0_wdata__w1, RW0_en = mem_0_1_RW0_en__w1, RW0_wmode = mem_0_1_RW0_wmode__w1, RW0_wmask = RW0_wmask.e1)
  mut mem_0_2 = split_dataArrayB0_ext::[name=mem_0_2](RW0_addr = mem_0_2_RW0_addr__w1, RW0_clk = mem_0_2_RW0_clk__w1, RW0_wdata = mem_0_2_RW0_wdata__w1, RW0_en = mem_0_2_RW0_en__w1, RW0_wmode = mem_0_2_RW0_wmode__w1, RW0_wmask = RW0_wmask.e2)
