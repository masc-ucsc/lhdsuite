pub mod dataArrayB0_ext::[timecheck=false](RW0_addr:U9, RW0_clk:Clock, RW0_wdata:U256, RW0_en:U1, RW0_wmode:U1, RW0_wmask:(e3:U1, e2:U1, e1:U1, e0:U1)) -> (RW0_rdata:U256@[]) {
  const mem_0_1_RW0_addr__w1 = RW0_addr
  const mem_0_1_RW0_clk__w1 = RW0_clk
