const tag_array_ext_t = import("tag_array_ext.tag_array_ext")

pub mod tag_array::[timecheck=false](RW0_addr:U6, RW0_en:U1, RW0_clk:Clock, RW0_wmode:U1, RW0_wdata:U88, RW0_wmask:U4) -> (RW0_rdata:U88@[]) {
  mut tag_array_ext = tag_array_ext_t::[name=tag_array_ext](RW0_addr = RW0_addr, RW0_clk = RW0_clk, RW0_wdata = RW0_wdata, RW0_en = RW0_en, RW0_wmode = RW0_wmode, `RW0_wmask.e3` = RW0_wmask#[3..<4], `RW0_wmask.e2` = RW0_wmask#[2..<3], `RW0_wmask.e1` = RW0_wmask#[1..<2], `RW0_wmask.e0` = RW0_wmask & 1)
  RW0_rdata = tag_array_ext
}
