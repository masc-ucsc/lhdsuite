pub mod MaxPeriodFibonacciLFSR_3::[timecheck=false](`clock`:Clock, `reset`:U1) -> (io_out_0:U1@[], io_out_1:U1@[], io_out_2:U1@[], io_out_3:U1@[], io_out_4:U1@[], io_out_5:U1@[]) {
  reg state_0:U1:[initial=1, reset_pin=`reset`, async=false]
  reg state_1:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_2:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_3:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_4:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_5:U1:[initial=0, reset_pin=`reset`, async=false]
  if not (`reset` != 0) {
    state_0 = (state_4 ^ state_5) & 1
    state_1 = state_0
    state_2 = state_1
    state_3 = state_2
    state_4 = state_3
    state_5 = state_4
  }
  io_out_0 = state_0
  io_out_1 = state_1
  io_out_2 = state_2
  io_out_3 = state_3
  io_out_4 = state_4
  io_out_5 = state_5
}
