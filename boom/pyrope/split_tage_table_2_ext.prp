pub mod split_tage_table_2_ext::[timecheck=false](R0_addr:U7, R0_clk:Clock, R0_en:U1, W0_addr:U7, W0_clk:Clock, W0_data:U11, W0_en:U1, W0_mask:U1) -> (R0_data:U11@[]) {
  reg ram:[128]U11:[ordering="old", __store_clock_pin=W0_clk, __store_posclk=true]
  reg ram_R_0_en_pipe_0:U1:[clock_pin=R0_clk]
  reg ram_R_0_addr_pipe_0:U7:[clock_pin=R0_clk]
  const R0_data__w1 = ram[ram_R_0_addr_pipe_0]
  if (W0_en & W0_mask & 1) != 0 {
    ram[W0_addr] = W0_data
  }
  ram_R_0_en_pipe_0 = R0_en
  if R0_en != 0 {
    ram_R_0_addr_pipe_0 = R0_addr
  }
  R0_data = R0_data__w1
}
