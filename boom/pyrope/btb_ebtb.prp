const btb_ebtb_ext_t = import("btb_ebtb_ext.btb_ebtb_ext")

pub mod btb_ebtb::[timecheck=false](R0_addr:U7, R0_en:U1, R0_clk:Clock, W0_addr:U7, W0_en:U1, W0_clk:Clock, W0_data:U40) -> (R0_data:U40@[]) {
  mut btb_ebtb_ext = btb_ebtb_ext_t::[name=btb_ebtb_ext](R0_addr = R0_addr, R0_clk = R0_clk, R0_en = R0_en, W0_addr = W0_addr, W0_clk = W0_clk, W0_data = W0_data, W0_en = W0_en)
  R0_data = btb_ebtb_ext
}
