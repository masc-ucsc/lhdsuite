pub comb Arbiter2_BranchPredictionUpdate::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_is_mispredict_update:U1, io_in_0_bits_is_repair_update:U1, io_in_0_bits_pc:U40, io_in_0_bits_br_mask:U4, io_in_0_bits_cfi_idx_valid:U1, io_in_0_bits_cfi_idx_bits:U2, io_in_0_bits_cfi_taken:U1, io_in_0_bits_cfi_mispredicted:U1, io_in_0_bits_cfi_is_br:U1, io_in_0_bits_cfi_is_jal:U1, io_in_0_bits_ghist_old_history:U64, io_in_0_bits_target:U40, io_in_0_bits_meta_0:U120, io_in_1_valid:U1, io_in_1_bits_is_mispredict_update:U1, io_in_1_bits_is_repair_update:U1, io_in_1_bits_btb_mispredicts:U4, io_in_1_bits_pc:U40, io_in_1_bits_br_mask:U4, io_in_1_bits_cfi_idx_valid:U1, io_in_1_bits_cfi_idx_bits:U2, io_in_1_bits_cfi_taken:U1, io_in_1_bits_cfi_mispredicted:U1, io_in_1_bits_cfi_is_br:U1, io_in_1_bits_cfi_is_jal:U1, io_in_1_bits_cfi_is_jalr:U1, io_in_1_bits_ghist_old_history:U64, io_in_1_bits_target:U40, io_in_1_bits_meta_0:U120) -> (io_in_1_ready:U1, io_out_valid:U1, io_out_bits_is_mispredict_update:U1, io_out_bits_is_repair_update:U1, io_out_bits_btb_mispredicts:U4, io_out_bits_pc:U40, io_out_bits_br_mask:U4, io_out_bits_cfi_idx_valid:U1, io_out_bits_cfi_idx_bits:U2, io_out_bits_cfi_taken:U1, io_out_bits_cfi_mispredicted:U1, io_out_bits_cfi_is_br:U1, io_out_bits_cfi_is_jal:U1, io_out_bits_cfi_is_jalr:U1, io_out_bits_ghist_old_history:U64, io_out_bits_target:U40, io_out_bits_meta_0:U120) {
  mut _mux_1:U1 = if io_in_0_valid != 0 { io_in_0_bits_is_mispredict_update & 1 } else { io_in_1_bits_is_mispredict_update & 1 }
