const split_bim_col_0_ext = import("split_bim_col_0_ext.split_bim_col_0_ext")

pub mod bim_col_0_ext::[timecheck=false](RW0_addr:U8, RW0_clk:Clock, RW0_wdata:U8, RW0_en:U1, RW0_wmode:U1, RW0_wmask:(e3:U1, e2:U1, e1:U1, e0:U1)) -> (RW0_rdata:U8@[]) {
  const mem_0_1_RW0_addr__w1 = RW0_addr
  const mem_0_1_RW0_clk__w1 = RW0_clk
  const mem_0_1_RW0_wdata__w1 = RW0_wdata#[2..<4]
  const mem_0_1_RW0_en__w1 = RW0_en
  const mem_0_1_RW0_wmode__w1 = RW0_wmode
  const mem_0_2_RW0_addr__w1 = RW0_addr
  const mem_0_2_RW0_clk__w1 = RW0_clk
  const mem_0_2_RW0_wdata__w1 = RW0_wdata#[4..<6]
  const mem_0_2_RW0_en__w1 = RW0_en
  const mem_0_2_RW0_wmode__w1 = RW0_wmode
  const mem_0_3_RW0_addr__w1 = RW0_addr
  const mem_0_3_RW0_clk__w1 = RW0_clk
  const mem_0_3_RW0_wdata__w1 = RW0_wdata#[6..<8]
  const mem_0_3_RW0_en__w1 = RW0_en
  const mem_0_3_RW0_wmode__w1 = RW0_wmode
  mut mem_0_0 = split_bim_col_0_ext::[name=mem_0_0](RW0_addr = RW0_addr, RW0_clk = RW0_clk, RW0_wdata = RW0_wdata#[0..<2], RW0_en = RW0_en, RW0_wmode = RW0_wmode, RW0_wmask = RW0_wmask.e0)
  mut mem_0_1 = split_bim_col_0_ext::[name=mem_0_1](RW0_addr = mem_0_1_RW0_addr__w1, RW0_clk = mem_0_1_RW0_clk__w1, RW0_wdata = mem_0_1_RW0_wdata__w1, RW0_en = mem_0_1_RW0_en__w1, RW0_wmode = mem_0_1_RW0_wmode__w1, RW0_wmask = RW0_wmask.e1)
  mut mem_0_2 = split_bim_col_0_ext::[name=mem_0_2](RW0_addr = mem_0_2_RW0_addr__w1, RW0_clk = mem_0_2_RW0_clk__w1, RW0_wdata = mem_0_2_RW0_wdata__w1, RW0_en = mem_0_2_RW0_en__w1, RW0_wmode = mem_0_2_RW0_wmode__w1, RW0_wmask = RW0_wmask.e2)
  mut mem_0_3 = split_bim_col_0_ext::[name=mem_0_3](RW0_addr = mem_0_3_RW0_addr__w1, RW0_clk = mem_0_3_RW0_clk__w1, RW0_wdata = mem_0_3_RW0_wdata__w1, RW0_en = mem_0_3_RW0_en__w1, RW0_wmode = mem_0_3_RW0_wmode__w1, RW0_wmask = RW0_wmask.e3)
  RW0_rdata = (mem_0_3#[0..<2] << 6) | ((mem_0_2#[0..<2] << 4) | (mem_0_1#[0..<2] << 2) | mem_0_0#[0..<2])#[0..<6]
}
