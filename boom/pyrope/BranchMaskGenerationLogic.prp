pub mod BranchMaskGenerationLogic::[timecheck=false](`clock`:Clock, `reset`:U1, io_is_branch_0:U1, io_will_fire_0:U1, io_brupdate_b1_resolve_mask:U8, io_brupdate_b2_uop_br_mask:U8, io_brupdate_b2_mispredict:U1, io_flush_pipeline:U1) -> (io_br_tag_0:U3@[], io_br_mask_0:U8@[], io_is_full_0:U1@[]) {
  mut _mux_10:U8 = 0
  mut _mux_2:U8 = 0
  mut _mux_3:U8 = 0
  mut _mux_4:U8 = 0
  mut _mux_5:U8 = 0
  mut _mux_6:U8 = 0
  mut _mux_7:U8 = 0
  mut _mux_8:U8 = 0
  mut _mux_9:U8 = 0
  mut _rep_1:U8 = 0
  reg branch_mask:U8:[initial=0, reset_pin=`reset`, async=false]
  if not (`reset` != 0) {
    _rep_1 = if (io_will_fire_0 & 1) != 0 { 0xff } else { 0 }
    _mux_2 = if branch_mask#[6..<7] != 0 { (~branch_mask#[7..<8]) << 7 } else { 0x40 }
    _mux_3 = if branch_mask#[5..<6] != 0 { _mux_2#[0..<8] } else { 32 }
    _mux_4 = if branch_mask#[4..<5] != 0 { _mux_3#[0..<8] } else { 16 }
    _mux_5 = if branch_mask#[3..<4] != 0 { _mux_4#[0..<8] } else { 8 }
    _mux_6 = if branch_mask#[2..<3] != 0 { _mux_5#[0..<8] } else { 4 }
    _mux_7 = if branch_mask#[1..<2] != 0 { _mux_6#[0..<8] } else { 2 }
    _mux_8 = if (branch_mask & 1) != 0 { _mux_7#[0..<8] } else { 1 }
    _mux_9 = if io_brupdate_b2_mispredict != 0 { io_brupdate_b2_uop_br_mask#[0..<8] } else { 0xff }
    _mux_10 = if io_flush_pipeline != 0 { 0 } else { ((((_rep_1 & _mux_8)#[0..<8] | branch_mask)#[0..<8] & (~io_brupdate_b1_resolve_mask))#[0..<8] & _mux_9)#[0..<8] }
    branch_mask = _mux_10
  }
  mut _rep_11:U3 = if (~branch_mask#[7..<8]) != 0 { 7 } else { 0 }
  mut _mux_12:U3 = if branch_mask#[6..<7] != 0 { _rep_11#[0..<3] } else { 6 }
  mut _mux_13:U3 = if branch_mask#[5..<6] != 0 { _mux_12#[0..<3] } else { 5 }
  mut _mux_14:U3 = if branch_mask#[4..<5] != 0 { _mux_13#[0..<3] } else { 4 }
  mut _mux_15:U3 = if branch_mask#[3..<4] != 0 { _mux_14#[0..<3] } else { 3 }
  mut _mux_16:U3 = if branch_mask#[2..<3] != 0 { _mux_15#[0..<3] } else { 2 }
  mut _mux_17:U3 = if branch_mask#[1..<2] != 0 { _mux_16#[0..<3] } else { 1 }
  mut _mux_18:U3 = if (branch_mask & 1) != 0 { _mux_17#[0..<3] } else { 0 }
  mut _b2i_19 = if branch_mask == 0xff { 1 } else { 0 }
  io_br_tag_0 = _mux_18
  io_br_mask_0 = (branch_mask & (~io_brupdate_b1_resolve_mask))#[0..<8]
  io_is_full_0 = _b2i_19 & io_is_branch_0 & 1
}
