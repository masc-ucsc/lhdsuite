pub mod BranchKillablePipeline::[timecheck=false](`clock`:Clock, `reset`:U1, io_req_valid:U1, io_req_bits_uop_br_mask:U8, io_req_bits_uop_rob_idx:U5, io_req_bits_uop_pdst:U6, io_req_bits_uop_dst_rtype:U2, io_flush:U1, io_brupdate_b1_resolve_mask:U8, io_brupdate_b1_mispredict_mask:U8) -> (io_resp_2_valid:U1@[], io_resp_2_bits_uop_br_mask:U8@[], io_resp_2_bits_uop_rob_idx:U5@[], io_resp_2_bits_uop_pdst:U6@[], io_resp_2_bits_uop_dst_rtype:U2@[]) {
  reg uops_0_valid:U1
  reg uops_0_bits_uop_br_mask:U8
  reg uops_0_bits_uop_rob_idx:U5
  reg uops_0_bits_uop_pdst:U6
  reg uops_0_bits_uop_dst_rtype:U2
  reg uops_1_valid:U1
  reg uops_1_bits_uop_br_mask:U8
  reg uops_1_bits_uop_rob_idx:U5
  reg uops_1_bits_uop_pdst:U6
  reg uops_1_bits_uop_dst_rtype:U2
  reg uops_2_valid:U1
  reg uops_2_bits_uop_br_mask:U8
  reg uops_2_bits_uop_rob_idx:U5
  reg uops_2_bits_uop_pdst:U6
  reg uops_2_bits_uop_dst_rtype:U2
  if `reset` != 0 {
    uops_0_valid = 0
    uops_1_valid = 0
    uops_2_valid = 0
  } else {
    uops_0_valid = io_req_valid & (~((U1((io_brupdate_b1_mispredict_mask & io_req_bits_uop_br_mask)#[0..<8] != 0) | io_flush) & 1)#[0]) & 1
    uops_1_valid = uops_0_valid & (~((U1((io_brupdate_b1_mispredict_mask & uops_0_bits_uop_br_mask)#[0..<8] != 0) | io_flush) & 1)#[0]) & 1
    uops_2_valid = uops_1_valid & (~((U1((io_brupdate_b1_mispredict_mask & uops_1_bits_uop_br_mask)#[0..<8] != 0) | io_flush) & 1)#[0]) & 1
  }
  uops_0_bits_uop_br_mask = (io_req_bits_uop_br_mask & (~io_brupdate_b1_resolve_mask))#[0..<8]
  uops_0_bits_uop_rob_idx = io_req_bits_uop_rob_idx
  uops_0_bits_uop_pdst = io_req_bits_uop_pdst
  uops_0_bits_uop_dst_rtype = io_req_bits_uop_dst_rtype
  uops_1_bits_uop_br_mask = (uops_0_bits_uop_br_mask & (~io_brupdate_b1_resolve_mask))#[0..<8]
  uops_1_bits_uop_rob_idx = uops_0_bits_uop_rob_idx
  uops_1_bits_uop_pdst = uops_0_bits_uop_pdst
  uops_1_bits_uop_dst_rtype = uops_0_bits_uop_dst_rtype
  uops_2_bits_uop_br_mask = (uops_1_bits_uop_br_mask & (~io_brupdate_b1_resolve_mask))#[0..<8]
  uops_2_bits_uop_rob_idx = uops_1_bits_uop_rob_idx
  uops_2_bits_uop_pdst = uops_1_bits_uop_pdst
  uops_2_bits_uop_dst_rtype = uops_1_bits_uop_dst_rtype
  io_resp_2_valid = uops_2_valid
  io_resp_2_bits_uop_br_mask = uops_2_bits_uop_br_mask
  io_resp_2_bits_uop_rob_idx = uops_2_bits_uop_rob_idx
  io_resp_2_bits_uop_pdst = uops_2_bits_uop_pdst
  io_resp_2_bits_uop_dst_rtype = uops_2_bits_uop_dst_rtype
}
