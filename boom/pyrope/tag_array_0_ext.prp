const split_tag_array_0_ext = import("split_tag_array_0_ext.split_tag_array_0_ext")

pub mod tag_array_0_ext::[timecheck=false](RW0_addr:U6, RW0_clk:Clock, RW0_wdata:U80, RW0_en:U1, RW0_wmode:U1, RW0_wmask:(e3:U1, e2:U1, e1:U1, e0:U1)) -> (RW0_rdata:U80@[]) {
  const mem_0_1_RW0_addr__w1 = RW0_addr
  const mem_0_1_RW0_clk__w1 = RW0_clk
  const mem_0_1_RW0_wdata__w1 = RW0_wdata#[20..<40]
  const mem_0_1_RW0_en__w1 = RW0_en
  const mem_0_1_RW0_wmode__w1 = RW0_wmode
  const mem_0_2_RW0_addr__w1 = RW0_addr
  const mem_0_2_RW0_clk__w1 = RW0_clk
  const mem_0_2_RW0_wdata__w1 = RW0_wdata#[40..<60]
  const mem_0_2_RW0_en__w1 = RW0_en
  const mem_0_2_RW0_wmode__w1 = RW0_wmode
  const mem_0_3_RW0_addr__w1 = RW0_addr
  const mem_0_3_RW0_clk__w1 = RW0_clk
  const mem_0_3_RW0_wdata__w1 = RW0_wdata#[60..<0x50]
  const mem_0_3_RW0_en__w1 = RW0_en
  const mem_0_3_RW0_wmode__w1 = RW0_wmode
  mut mem_0_0 = split_tag_array_0_ext::[name=mem_0_0](RW0_addr = RW0_addr, RW0_clk = RW0_clk, RW0_wdata = RW0_wdata#[0..<20], RW0_en = RW0_en, RW0_wmode = RW0_wmode, RW0_wmask = RW0_wmask.e0)
  mut mem_0_1 = split_tag_array_0_ext::[name=mem_0_1](RW0_addr = mem_0_1_RW0_addr__w1, RW0_clk = mem_0_1_RW0_clk__w1, RW0_wdata = mem_0_1_RW0_wdata__w1, RW0_en = mem_0_1_RW0_en__w1, RW0_wmode = mem_0_1_RW0_wmode__w1, RW0_wmask = RW0_wmask.e1)
  mut mem_0_2 = split_tag_array_0_ext::[name=mem_0_2](RW0_addr = mem_0_2_RW0_addr__w1, RW0_clk = mem_0_2_RW0_clk__w1, RW0_wdata = mem_0_2_RW0_wdata__w1, RW0_en = mem_0_2_RW0_en__w1, RW0_wmode = mem_0_2_RW0_wmode__w1, RW0_wmask = RW0_wmask.e2)
  mut mem_0_3 = split_tag_array_0_ext::[name=mem_0_3](RW0_addr = mem_0_3_RW0_addr__w1, RW0_clk = mem_0_3_RW0_clk__w1, RW0_wdata = mem_0_3_RW0_wdata__w1, RW0_en = mem_0_3_RW0_en__w1, RW0_wmode = mem_0_3_RW0_wmode__w1, RW0_wmask = RW0_wmask.e3)
  RW0_rdata = (mem_0_3#[0..<20] << 60) | ((mem_0_2#[0..<20] << 40) | (mem_0_1#[0..<20] << 20) | mem_0_0#[0..<20])#[0..<60]
}
