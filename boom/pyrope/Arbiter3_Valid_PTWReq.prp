pub comb Arbiter3_Valid_PTWReq::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_valid:U1, io_in_0_bits_bits_addr:U27, io_in_1_valid:U1, io_in_1_bits_bits_addr:U27, io_in_1_bits_bits_need_gpa:U1, io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_valid:U1, io_out_bits_bits_addr:U27, io_out_bits_bits_need_gpa:U1, io_chosen:U2) {
  mut _mux_1:U1 = if io_in_0_valid != 0 { io_in_0_bits_valid & 1 } else { io_in_1_valid & 1 }
  mut _mux_2:U27 = if io_in_1_valid != 0 { io_in_1_bits_bits_addr#[0..<27] } else { 0 }
  mut _mux_3:U27 = if io_in_0_valid != 0 { io_in_0_bits_bits_addr#[0..<27] } else { _mux_2#[0..<27] }
  mut _mux_4:U2 = if io_in_1_valid != 0 { 1 } else { 2 }
  mut _mux_5:U2 = if io_in_0_valid != 0 { 0 } else { _mux_4#[0..<2] }
  io_in_0_ready = io_out_ready
  io_in_1_ready = (~io_in_0_valid) & io_out_ready & 1
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_valid = _mux_1
  io_out_bits_bits_addr = _mux_3
  io_out_bits_bits_need_gpa = (~io_in_0_valid) & io_in_1_valid & 1 & io_in_1_bits_bits_need_gpa & 1
  io_chosen = _mux_5
}
