const RenameFreeList_2 = import("RenameFreeList_2.RenameFreeList_2")

pub mod ImmRenameStage::[timecheck=false](clock:Clock, reset:u1, io_kill:u1, io_dec_fire_0:u1, io_dec_uops_0_iq_type_0:u1, io_dec_uops_0_iq_type_1:u1, io_dec_uops_0_iq_type_2:u1, io_dec_uops_0_br_tag:u3, io_dec_uops_0_br_type:u4, io_dec_uops_0_is_sfb:u1, io_dec_uops_0_imm_rename:u1, io_dec_uops_0_imm_sel:u3, io_dec_uops_0_pimm:u5, io_dec_uops_0_lrs1:u6, io_dec_uops_0_lrs2:u6, io_dec_uops_0_lrs1_rtype:u2, io_dec_uops_0_lrs2_rtype:u2, io_brupdate_b2_uop_br_tag:u3, io_brupdate_b2_mispredict:u1, io_dis_fire_0:u1, io_dis_ready:u1, io_wakeups_0_valid:u1, io_wakeups_0_bits_uop_pimm:u5, io_wakeups_1_valid:u1, io_wakeups_1_bits_uop_pimm:u5, io_wakeups_2_valid:u1, io_wakeups_2_bits_uop_pimm:u5, io_wakeups_3_valid:u1, io_wakeups_3_bits_uop_pimm:u5, io_rollback:u1) -> (io_ren_stalls_0:u1@[], io_ren2_uops_0_imm_sel:u3@[], io_ren2_uops_0_pimm:u5@[]) {
  reg r_uop_imm_rename:u1
  reg r_valid:u1
  reg r_uop_br_tag:u3
  reg r_uop_br_type:u4
  reg r_uop_is_sfb:u1
  reg r_uop_imm_sel:u3
  reg r_uop_pimm:u5

  const freelist_io_reqs_0:u1 = io_dis_fire_0 & r_uop_imm_rename

  if reset != 0 {
    r_valid = 0
  } else {
    const next_valid:u1 = if io_dis_ready != 0 { io_dec_fire_0 } else { r_valid & unsigned(io_dis_fire_0 == 0) }
    r_valid = unsigned(io_kill == 0) & next_valid
  }

  if (io_kill == 0) and (io_dis_ready != 0) {
    r_uop_br_tag = io_dec_uops_0_br_tag
    r_uop_br_type = io_dec_uops_0_br_type
    r_uop_is_sfb = io_dec_uops_0_is_sfb
    r_uop_imm_rename = io_dec_uops_0_imm_rename
    r_uop_imm_sel = io_dec_uops_0_imm_sel
    r_uop_pimm = io_dec_uops_0_pimm
  }

  const br_type_is_branch:u1 = unsigned((r_uop_br_type != 0) and (r_uop_br_type <= 6))
  const ren_br_tags_1_valid:u1 = io_dis_fire_0 & ((br_type_is_branch & unsigned(r_uop_is_sfb == 0)) | unsigned(r_uop_br_type == 8))

  mut freelist = RenameFreeList_2::[name=freelist](clock = clock, reset = reset, io_reqs_0 = freelist_io_reqs_0, io_dealloc_0_valid = io_wakeups_0_valid, io_dealloc_0_bits = io_wakeups_0_bits_uop_pimm, io_dealloc_1_valid = io_wakeups_1_valid, io_dealloc_1_bits = io_wakeups_1_bits_uop_pimm, io_dealloc_2_valid = io_wakeups_2_valid, io_dealloc_2_bits = io_wakeups_2_bits_uop_pimm, io_dealloc_3_valid = io_wakeups_3_valid, io_dealloc_3_bits = io_wakeups_3_bits_uop_pimm, io_ren_br_tags_1_valid = ren_br_tags_1_valid, io_ren_br_tags_1_bits = r_uop_br_tag, io_brupdate_b2_uop_br_tag = io_brupdate_b2_uop_br_tag, io_brupdate_b2_mispredict = io_brupdate_b2_mispredict, io_rollback = io_rollback)

  const pimm_out:u5 = if r_uop_imm_rename != 0 { freelist.io_alloc_pregs_0_bits } else { r_uop_pimm }

  io_ren_stalls_0 = r_uop_imm_rename & unsigned(freelist.io_alloc_pregs_0_valid == 0)
  io_ren2_uops_0_imm_sel = r_uop_imm_sel
  io_ren2_uops_0_pimm = pimm_out
}
