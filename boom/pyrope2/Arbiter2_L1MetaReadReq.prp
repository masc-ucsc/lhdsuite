pub comb Arbiter2_L1MetaReadReq::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_idx:U6, io_in_0_bits_way_en:U4, io_in_0_bits_tag:U20, io_in_1_valid:U1, io_in_1_bits_idx:U6, io_in_1_bits_way_en:U4, io_in_1_bits_tag:U20, io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_idx:U6, io_out_bits_way_en:U4, io_out_bits_tag:U20) {
  mut _mux_1:U6 = if io_in_0_valid != 0 { io_in_0_bits_idx#[0..<6] } else { io_in_1_bits_idx#[0..<6] }
  mut _mux_2:U4 = if io_in_0_valid != 0 { io_in_0_bits_way_en#[0..<4] } else { io_in_1_bits_way_en#[0..<4] }
  mut _mux_3:U20 = if io_in_0_valid != 0 { io_in_0_bits_tag#[0..<20] } else { io_in_1_bits_tag#[0..<20] }
  io_in_0_ready = io_out_ready
  io_in_1_ready = (~io_in_0_valid) & io_out_ready & 1
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_idx = _mux_1
  io_out_bits_way_en = _mux_2
  io_out_bits_tag = _mux_3
}
