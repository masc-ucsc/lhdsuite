pub mod BranchMaskGenerationLogic::[timecheck=false](clock:u1, reset:u1, io_is_branch_0:u1, io_will_fire_0:u1, io_brupdate_b1_resolve_mask:u8, io_brupdate_b2_uop_br_mask:u8, io_brupdate_b2_mispredict:u1, io_flush_pipeline:u1) -> (io_br_tag_0:u3@[], io_br_mask_0:u8@[], io_is_full_0:u1@[]) {
  mut _mux_10:u8 = 0
  mut _mux_2:u8 = 0
  mut _mux_3:u8 = 0
  mut _mux_4:u8 = 0
  mut _mux_5:u8 = 0
  mut _mux_6:u8 = 0
  mut _mux_7:u8 = 0
  mut _mux_8:u8 = 0
  mut _mux_9:u8 = 0
  mut _rep_1:u8 = 0
  reg branch_mask:u8:[initial=0, reset_pin=ref reset, async=false]
  if not (reset != 0) {
    _rep_1 = if (io_will_fire_0 & 1) != 0 { 0xff } else { 0 }
    _mux_2 = if ((branch_mask >> 6) & 1) != 0 { ((~((branch_mask >> 7) & 1)) & 1) << 7 } else { 0x40 }
    _mux_3 = if ((branch_mask >> 5) & 1) != 0 { _mux_2 } else { 32 }
    _mux_4 = if ((branch_mask >> 4) & 1) != 0 { _mux_3 } else { 16 }
    _mux_5 = if ((branch_mask >> 3) & 1) != 0 { _mux_4 } else { 8 }
    _mux_6 = if ((branch_mask >> 2) & 1) != 0 { _mux_5 } else { 4 }
    _mux_7 = if ((branch_mask >> 1) & 1) != 0 { _mux_6 } else { 2 }
    _mux_8 = if (branch_mask & 1) != 0 { _mux_7 } else { 1 }
    _mux_9 = if io_brupdate_b2_mispredict != 0 { io_brupdate_b2_uop_br_mask } else { 0xff }
    _mux_10 = if io_flush_pipeline != 0 { 0 } else { (((_rep_1 & _mux_8) | branch_mask) & (~io_brupdate_b1_resolve_mask)#[0..=7]) & _mux_9 }
    branch_mask = _mux_10
  }
  mut _rep_11:u3 = if ((~((branch_mask >> 7) & 1)) & 1) != 0 { 7 } else { 0 }
  mut _mux_12:u3 = if ((branch_mask >> 6) & 1) != 0 { _rep_11 } else { 6 }
  mut _mux_13:u3 = if ((branch_mask >> 5) & 1) != 0 { _mux_12 } else { 5 }
  mut _mux_14:u3 = if ((branch_mask >> 4) & 1) != 0 { _mux_13 } else { 4 }
  mut _mux_15:u3 = if ((branch_mask >> 3) & 1) != 0 { _mux_14 } else { 3 }
  mut _mux_16:u3 = if ((branch_mask >> 2) & 1) != 0 { _mux_15 } else { 2 }
  mut _mux_17:u3 = if ((branch_mask >> 1) & 1) != 0 { _mux_16 } else { 1 }
  mut _mux_18:u3 = if (branch_mask & 1) != 0 { _mux_17 } else { 0 }
  mut _b2i_19 = if branch_mask == 0xff { 1 } else { 0 }
  io_br_tag_0 = _mux_18
  io_br_mask_0 = branch_mask & (~io_brupdate_b1_resolve_mask)#[0..=7]
  io_is_full_0 = _b2i_19 & io_is_branch_0 & 1
}
