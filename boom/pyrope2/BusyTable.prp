// pyroD - fold the per-prs match computation into a single any_match bit
// per output. The wakeup-1/2 match terms were only ever used in the OR, so
// inline them. The wakeup-0 match term still needs a name because the
// override expression reuses it.
// Port names and reg names still unchanged (state-cut-pair with .sv).

pub mod RenameBusyTable::[timecheck=false](
  clock:Clock, reset:u1,
  io_ren_uops_0_pdst:u6,
  io_ren_uops_0_prs1:u6,
  io_ren_uops_0_prs2:u6,
  io_rebusy_reqs_0:u1,
  io_wakeups_0_valid:u1,
  io_wakeups_0_bits_uop_pdst:u6,
  io_wakeups_0_bits_rebusy:u1,
  io_wakeups_1_valid:u1,
  io_wakeups_1_bits_uop_pdst:u6,
  io_wakeups_2_valid:u1,
  io_wakeups_2_bits_uop_pdst:u6,
  io_child_rebusys:u1
) -> (
  io_busy_resps_0_prs1_busy:u1@[],
  io_busy_resps_0_prs2_busy:u1@[]
) {

  reg busy_table:u52:[reset_pin=reset, async=true] = 0

  reg wakeups_wu_valid_REG         :u1
  reg wakeups_wu_bits_REG_uop_pdst :u6
  reg wakeups_wu_bits_REG_rebusy   :u1
  reg wakeups_wu_valid_REG_2       :u1
  reg wakeups_wu_bits_REG_1_uop_pdst:u6
  reg wakeups_wu_valid_REG_4       :u1
  reg wakeups_wu_bits_REG_2_uop_pdst:u6

  wakeups_wu_valid_REG          = io_wakeups_0_valid
  wakeups_wu_bits_REG_uop_pdst  = io_wakeups_0_bits_uop_pdst
  wakeups_wu_bits_REG_rebusy    = io_wakeups_0_bits_rebusy
  wakeups_wu_valid_REG_2        = io_wakeups_1_valid
  wakeups_wu_bits_REG_1_uop_pdst = io_wakeups_1_bits_uop_pdst
  wakeups_wu_valid_REG_4        = io_wakeups_2_valid
  wakeups_wu_bits_REG_2_uop_pdst = io_wakeups_2_bits_uop_pdst

  const wakeups_2_valid:u1 = wakeups_wu_valid_REG_4 & (~io_child_rebusys)

  // u1 → u52 broadcast mask (common factor extracted).
  const all1:u52 = 0xFFFFFFFFFFFFF
  const one52:u52 = 1

  // UIntToOH(pdst) for each read port.
  const oh_wk0:u52 = one52 << wakeups_wu_bits_REG_uop_pdst
  const oh_wk1:u52 = one52 << wakeups_wu_bits_REG_1_uop_pdst
  const oh_wk2:u52 = one52 << wakeups_wu_bits_REG_2_uop_pdst
  const oh_ren:u52 = one52 << io_ren_uops_0_pdst

  // Per-wakeup conditions (reused by both busy_table update and output logic).
  const w0_rebusy_hit:u1 = wakeups_wu_valid_REG & wakeups_wu_bits_REG_rebusy
  const w0_unbusy_hit:u1 = wakeups_wu_valid_REG & (~wakeups_wu_bits_REG_rebusy)

  // Broadcast each u1 condition to a u52 mask once.
  const bcast_w0_unbusy:u52 = if w0_unbusy_hit      != 0 { all1 } else { 0 }
  const bcast_w1_unbusy:u52 = if wakeups_wu_valid_REG_2 != 0 { all1 } else { 0 }
  const bcast_w2_unbusy:u52 = if wakeups_2_valid    != 0 { all1 } else { 0 }
  const bcast_w0_rebusy:u52 = if w0_rebusy_hit      != 0 { all1 } else { 0 }
  const bcast_ren_rebusy:u52 = if io_rebusy_reqs_0  != 0 { all1 } else { 0 }

  const unbusy_mask:u52 = (oh_wk0 & bcast_w0_unbusy)
                        | (oh_wk1 & bcast_w1_unbusy)
                        | (oh_wk2 & bcast_w2_unbusy)

  busy_table = (busy_table & (~unbusy_mask)) | (oh_ren & bcast_ren_rebusy) | (oh_wk0 & bcast_w0_rebusy)

  // Base read: busy_table[prs] via shift-and-mask.
  const prs1_base:u1 = ((busy_table >> io_ren_uops_0_prs1) & 1)
  const prs2_base:u1 = ((busy_table >> io_ren_uops_0_prs2) & 1)

  // Only wakeup-0 match term needs a name — reused in the override.
  const prs1_match_0:u1 = wakeups_wu_valid_REG & (if wakeups_wu_bits_REG_uop_pdst == io_ren_uops_0_prs1 { 1 } else { 0 })
  const prs2_match_0:u1 = wakeups_wu_valid_REG & (if wakeups_wu_bits_REG_uop_pdst == io_ren_uops_0_prs2 { 1 } else { 0 })

  // any_match = wk0_match | wk1_match | wk2_match. wakeup-1 and wakeup-2 match
  // terms inlined (not needed elsewhere).
  const prs1_any:u1 = prs1_match_0
                    | (wakeups_wu_valid_REG_2 & (if wakeups_wu_bits_REG_1_uop_pdst == io_ren_uops_0_prs1 { 1 } else { 0 }))
                    | (wakeups_2_valid        & (if wakeups_wu_bits_REG_2_uop_pdst == io_ren_uops_0_prs1 { 1 } else { 0 }))
  const prs2_any:u1 = prs2_match_0
                    | (wakeups_wu_valid_REG_2 & (if wakeups_wu_bits_REG_1_uop_pdst == io_ren_uops_0_prs2 { 1 } else { 0 }))
                    | (wakeups_2_valid        & (if wakeups_wu_bits_REG_2_uop_pdst == io_ren_uops_0_prs2 { 1 } else { 0 }))

  // Output: if any wakeup matches this prs, forward (prs==wk0_pdst AND wk0 is valid+rebusy);
  // else read bit from busy_table. Mux1H reduces to the wk0 term because wakeups 1/2 rebusy = 0.
  io_busy_resps_0_prs1_busy = if prs1_any != 0 { prs1_match_0 & w0_rebusy_hit } else { prs1_base }
  io_busy_resps_0_prs2_busy = if prs2_any != 0 { prs2_match_0 & w0_rebusy_hit } else { prs2_base }
}
