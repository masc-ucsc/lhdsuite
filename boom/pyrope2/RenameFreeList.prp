// Parametric RenameFreeList.
//
// Defaults match SmallBoomV4Config (nIntPhysRegs=52, PregT=u6,
// FreeListT=u52, maxBrCount=8, BrTagT=u3). At those defaults this LECs
// against the auto-emitted RenameFreeList.sv.
//
// Three unrolled axes from the firtool emission were folded first (steps
// v1/v2 of this port):
//   - 8 scalar `br_alloc_lists_0..7` → `br_alloc_lists:[maxBrCount]FreeListT`
//   - 52-way `_mux_1..=51` priority chain → `for k in 0..<nIntPhysRegs-1`
//   - 6-way one-hot→binary tree reduce → `for i in 0..<nIntPhysRegs` scan
//
// The MegaBoomV4Config dial would be <nIntPhysRegs=144, PregT=u8,
// FreeListT=u144, maxBrCount=20, BrTagT=u5>. This commit does NOT include
// a specialization caller or MegaBoom LEC — the Mega SV collateral has
// not been generated yet (see /tmp/boom/param for scratch artifacts).

pub mod RenameFreeList<nIntPhysRegs=52, PregT=u6, FreeListT=u52, maxBrCount=8, BrTagT=u3>::[timecheck=false](
  clock:u1,
  reset:u1,
  io_reqs_0:u1,
  io_despec_0_valid:u1,
  io_despec_0_bits:PregT,
  io_dealloc_0_valid:u1,
  io_dealloc_0_bits:PregT,
  io_ren_br_tags_1_valid:u1,
  io_ren_br_tags_1_bits:BrTagT,
  io_brupdate_b2_uop_br_tag:BrTagT,
  io_brupdate_b2_mispredict:u1,
  io_rollback:u1
) -> (
  io_alloc_pregs_0_valid:u1@[],
  io_alloc_pregs_0_bits:PregT@[],
  io_debug_freelist:FreeListT@[]
) {
  // Comptime masks and shift amounts.
  comptime const ALL_ONES  = (1 << nIntPhysRegs) - 1
  comptime const TOP_BIT   = nIntPhysRegs - 1
  comptime const HI_SLICE  = nIntPhysRegs - 1  // inclusive end of a FreeListT slice

  // Initial free_list: 32 architectural registers (bits 0..31) are
  // pre-mapped and NOT free; physical registers 32..nIntPhysRegs-1 start
  // free (bits 32..TOP_BIT = 1). For SmallBoomV4 (52) this is
  // 0xfffff00000000; for MegaBoomV4 (144) it would be
  // 0xffffffffffffffffffffffffffffff00000000. Caller MUST pass
  // nIntPhysRegs >= 32 (BOOM has 32 integer architectural regs).
  comptime const FREE_INIT = ((1 << (nIntPhysRegs - 32)) - 1) << 32

  mut _rep_58:FreeListT = 0
  mut _rep_59:FreeListT = 0
  reg r_sel:PregT
  reg free_list:FreeListT
  reg spec_alloc_list:FreeListT
  reg br_alloc_lists:[maxBrCount]FreeListT
  reg com_deallocs_REG_0_valid:u1
  reg com_deallocs_REG_0_bits:PregT
  reg r_valid:u1

  // Priority-encode free_list's lowest set bit into a one-hot sels_0__w1
  // (bit 0 = highest priority, bit nIntPhysRegs-1 = lowest).
  mut sel:FreeListT = ((free_list >> TOP_BIT) & 1) << TOP_BIT
  for k in 0..<TOP_BIT {
    const idx = TOP_BIT - 1 - k
    sel = if ((free_list >> idx) & 1) != 0 { (1 << idx)#[0..=HI_SLICE] } else { sel }
  }
  const sels_0__w1 = sel

  const _io_debug_freelist_T__w1 = (1 << r_sel)#[0..=63]
  mut _rep_52:FreeListT = if (io_brupdate_b2_mispredict & 1) != 0 { ALL_ONES } else { 0 }
  const br_deallocs__w1 = br_alloc_lists[io_brupdate_b2_uop_br_tag] & _rep_52
  mut _rep_53:FreeListT = if (com_deallocs_REG_0_valid & 1) != 0 { ALL_ONES } else { 0 }
  mut _rep_54:FreeListT = if (io_rollback & 1) != 0 { ALL_ONES } else { 0 }
  const dealloc_mask__w1 = (((1 << com_deallocs_REG_0_bits)#[0..=63]#[0..=HI_SLICE] & _rep_53) | br_deallocs__w1) | (spec_alloc_list & _rep_54)
  const sel_fire_0__w1 = (((~r_valid) & 1) | io_reqs_0) & 1 & unsigned(sels_0__w1 != 0) & 1
  mut _rep_56:FreeListT = if (r_valid & 1) != 0 { ALL_ONES } else { 0 }
  const io_debug_freelist_0__w1 = free_list | (_io_debug_freelist_T__w1#[0..=HI_SLICE] & _rep_56)

  mut _rep_57:FreeListT = if (io_reqs_0 & 1) != 0 { ALL_ONES } else { 0 }
  const alloc_masks_0__w1 = _io_debug_freelist_T__w1#[0..=HI_SLICE] & _rep_57

  // One-hot → binary index on nIntPhysRegs-wide sels_0__w1. Equivalent to
  // the firtool 5-level log2-tree reduce (nIntPhysRegs == 52 branches),
  // folded into a scan loop that parameters cleanly on any nIntPhysRegs.
  mut r_sel_val:PregT = 0
  for i in 0..<nIntPhysRegs {
    if ((sels_0__w1 >> i) & 1) != 0 {
      r_sel_val = i
    }
  }

  if reset != 0 {
    free_list = FREE_INIT
    spec_alloc_list = 0
    r_valid = 0
  } else {
    _rep_58 = if (sel_fire_0__w1 & 1) != 0 { ALL_ONES } else { 0 }
    free_list = (free_list & (~(sels_0__w1 & _rep_58))#[0..=HI_SLICE]) | dealloc_mask__w1
    _rep_59 = if (io_despec_0_valid & 1) != 0 { ALL_ONES } else { 0 }
    spec_alloc_list = ((spec_alloc_list | alloc_masks_0__w1) & (~dealloc_mask__w1)#[0..=HI_SLICE]) & (~((1 << io_despec_0_bits)#[0..=63]#[0..=HI_SLICE] & _rep_59))#[0..=HI_SLICE]
    r_valid = unsigned((((r_valid & (~io_reqs_0) & 1 & 1) << nIntPhysRegs) | sels_0__w1) != 0)
  }

  for i in 0..<maxBrCount {
    br_alloc_lists[i] = if (unsigned(io_ren_br_tags_1_bits == i) & io_ren_br_tags_1_valid & 1) != 0 { 0 } else { (br_alloc_lists[i] & (~br_deallocs__w1)#[0..=HI_SLICE]) | alloc_masks_0__w1 }
  }
  com_deallocs_REG_0_valid = io_dealloc_0_valid
  com_deallocs_REG_0_bits = io_dealloc_0_bits
  if sel_fire_0__w1 != 0 {
    r_sel = r_sel_val
  }
  io_alloc_pregs_0_valid = r_valid
  io_alloc_pregs_0_bits = r_sel
  io_debug_freelist = io_debug_freelist_0__w1
}
