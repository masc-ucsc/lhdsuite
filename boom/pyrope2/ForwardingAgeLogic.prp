// pyroD — drop redundant `#[N] != 0` (bit-index already yields U1).
// Same mux-chain shape as pyroC; purely surface cleanup.

pub mod ForwardingAgeLogic::[timecheck=false](clock:Clock, io_matches:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), io_youngest:U3) -> (io_found:U1@[], io_found_idx:U3@[]) {
  const io_matches_v:U8 = (io_matches.e7 << 7) | (io_matches.e6 << 6) | (io_matches.e5 << 5) | (io_matches.e4 << 4) | (io_matches.e3 << 3) | (io_matches.e2 << 2) | (io_matches.e1 << 1) | io_matches.e0
  reg found_match:U1
  reg found_idx:U3

  const one8:U8 = 1
  const matches_below:U8 = io_matches_v & ((one8 << io_youngest) - one8)

  found_match = if io_matches_v != 0 { 1 } else { 0 }

  mut _mux_7:U3  = if io_matches_v#[2] == 1 { 2 } else { io_matches_v#[1] }
  mut _mux_8:U3  = if io_matches_v#[3] == 1 { 3 } else { _mux_7 }
  mut _mux_9:U3  = if io_matches_v#[4] == 1 { 4 } else { _mux_8 }
  mut _mux_10:U3 = if io_matches_v#[5] == 1 { 5 } else { _mux_9 }
  mut _mux_11:U3 = if io_matches_v#[6] == 1 { 6 } else { _mux_10 }
  mut _mux_12:U3 = if io_matches_v#[7] == 1 { 7 } else { _mux_11 }
  mut _mux_13:U3 = if matches_below#[0] == 1 { 0 } else { _mux_12 }
  mut _mux_14:U3 = if matches_below#[1] == 1 { 1 } else { _mux_13 }
  mut _mux_15:U3 = if matches_below#[2] == 1 { 2 } else { _mux_14 }
  mut _mux_16:U3 = if matches_below#[3] == 1 { 3 } else { _mux_15 }
  mut _mux_17:U3 = if matches_below#[4] == 1 { 4 } else { _mux_16 }
  mut _mux_18:U3 = if matches_below#[5] == 1 { 5 } else { _mux_17 }
  mut _mux_19:U3 = if matches_below#[6] == 1 { 6 } else { _mux_18 }
  mut _mux_20:U3 = if matches_below#[7] == 1 { 7 } else { _mux_19 }
  found_idx = _mux_20

  io_found = found_match
  io_found_idx = found_idx
}
