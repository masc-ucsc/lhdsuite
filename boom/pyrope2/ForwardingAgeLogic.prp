// pyroD — drop redundant `#[N] != 0` (bit-index already yields u1).
// Same mux-chain shape as pyroC; purely surface cleanup.

pub mod ForwardingAgeLogic::[timecheck=false](clock:Clock, io_matches:u8, io_youngest:u3) -> (io_found:u1@[], io_found_idx:u3@[]) {
  reg found_match:u1
  reg found_idx:u3

  const one8:u8 = 1
  const matches_below:u8 = io_matches & ((one8 << io_youngest) - one8)

  found_match = if io_matches != 0 { 1 } else { 0 }

  mut _mux_7:u3  = if io_matches#[2] == 1 { 2 } else { io_matches#[1] }
  mut _mux_8:u3  = if io_matches#[3] == 1 { 3 } else { _mux_7 }
  mut _mux_9:u3  = if io_matches#[4] == 1 { 4 } else { _mux_8 }
  mut _mux_10:u3 = if io_matches#[5] == 1 { 5 } else { _mux_9 }
  mut _mux_11:u3 = if io_matches#[6] == 1 { 6 } else { _mux_10 }
  mut _mux_12:u3 = if io_matches#[7] == 1 { 7 } else { _mux_11 }
  mut _mux_13:u3 = if matches_below#[0] == 1 { 0 } else { _mux_12 }
  mut _mux_14:u3 = if matches_below#[1] == 1 { 1 } else { _mux_13 }
  mut _mux_15:u3 = if matches_below#[2] == 1 { 2 } else { _mux_14 }
  mut _mux_16:u3 = if matches_below#[3] == 1 { 3 } else { _mux_15 }
  mut _mux_17:u3 = if matches_below#[4] == 1 { 4 } else { _mux_16 }
  mut _mux_18:u3 = if matches_below#[5] == 1 { 5 } else { _mux_17 }
  mut _mux_19:u3 = if matches_below#[6] == 1 { 6 } else { _mux_18 }
  mut _mux_20:u3 = if matches_below#[7] == 1 { 7 } else { _mux_19 }
  found_idx = _mux_20

  io_found = found_match
  io_found_idx = found_idx
}
