pub comb Arbiter3_UInt4::[timecheck=false](io_in_0_valid:U1, io_in_0_bits:U4, io_in_1_valid:U1, io_in_1_bits:U4, io_in_2_bits:U4) -> (io_in_2_ready:U1, io_out_bits:U4) {
  mut _mux_1:U4 = if io_in_1_valid != 0 { io_in_1_bits#[0..<4] } else { io_in_2_bits#[0..<4] }
  mut _mux_2:U4 = if io_in_0_valid != 0 { io_in_0_bits#[0..<4] } else { _mux_1#[0..<4] }
  io_in_2_ready = ~((io_in_0_valid | io_in_1_valid) & 1)#[0]
  io_out_bits = _mux_2
}
