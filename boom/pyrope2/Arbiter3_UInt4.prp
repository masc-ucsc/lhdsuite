pub comb Arbiter3_UInt4::[timecheck=false](io_in_0_valid:u1, io_in_0_bits:u4, io_in_1_valid:u1, io_in_1_bits:u4, io_in_2_bits:u4) -> (io_in_2_ready:u1, io_out_bits:u4) {
  mut _mux_1:u4 = if io_in_1_valid != 0 { io_in_1_bits } else { io_in_2_bits }
  mut _mux_2:u4 = if io_in_0_valid != 0 { io_in_0_bits } else { _mux_1 }
  io_in_2_ready = (~((io_in_0_valid | io_in_1_valid) & 1)) & 1
  io_out_bits = _mux_2
}
