pub mod MaxPeriodFibonacciLFSR_3::[timecheck=false](clock:u1, reset:u1) -> (io_out_0:u1@[], io_out_1:u1@[], io_out_2:u1@[], io_out_3:u1@[], io_out_4:u1@[], io_out_5:u1@[]) {
  reg state_0:u1:[initial=1, reset_pin=ref reset, async=false]
  reg state_1:u1:[initial=0, reset_pin=ref reset, async=false]
  reg state_2:u1:[initial=0, reset_pin=ref reset, async=false]
  reg state_3:u1:[initial=0, reset_pin=ref reset, async=false]
  reg state_4:u1:[initial=0, reset_pin=ref reset, async=false]
  reg state_5:u1:[initial=0, reset_pin=ref reset, async=false]
  if not (reset != 0) {
    state_0 = (state_4 ^ state_5) & 1
    state_1 = state_0
    state_2 = state_1
    state_3 = state_2
    state_4 = state_3
    state_5 = state_4
  }
  io_out_0 = state_0
  io_out_1 = state_1
  io_out_2 = state_2
  io_out_3 = state_3
  io_out_4 = state_4
  io_out_5 = state_5
}
