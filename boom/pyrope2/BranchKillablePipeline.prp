pub mod BranchKillablePipeline::[timecheck=false](clock:u1, reset:u1, io_req_valid:u1, io_req_bits_uop_br_mask:u8, io_req_bits_uop_rob_idx:u5, io_req_bits_uop_pdst:u6, io_req_bits_uop_dst_rtype:u2, io_flush:u1, io_brupdate_b1_resolve_mask:u8, io_brupdate_b1_mispredict_mask:u8) -> (io_resp_2_valid:u1@[], io_resp_2_bits_uop_br_mask:u8@[], io_resp_2_bits_uop_rob_idx:u5@[], io_resp_2_bits_uop_pdst:u6@[], io_resp_2_bits_uop_dst_rtype:u2@[]) {
  reg uops_0_valid:u1
  reg uops_0_bits_uop_br_mask:u8
  reg uops_0_bits_uop_rob_idx:u5
  reg uops_0_bits_uop_pdst:u6
  reg uops_0_bits_uop_dst_rtype:u2
  reg uops_1_valid:u1
  reg uops_1_bits_uop_br_mask:u8
  reg uops_1_bits_uop_rob_idx:u5
  reg uops_1_bits_uop_pdst:u6
  reg uops_1_bits_uop_dst_rtype:u2
  reg uops_2_valid:u1
  reg uops_2_bits_uop_br_mask:u8
  reg uops_2_bits_uop_rob_idx:u5
  reg uops_2_bits_uop_pdst:u6
  reg uops_2_bits_uop_dst_rtype:u2
  if reset != 0 {
    uops_0_valid = 0
    uops_1_valid = 0
    uops_2_valid = 0
  } else {
    uops_0_valid = io_req_valid & (~((unsigned((io_brupdate_b1_mispredict_mask & io_req_bits_uop_br_mask) != 0) | io_flush) & 1)) & 1 & 1
    uops_1_valid = uops_0_valid & (~((unsigned((io_brupdate_b1_mispredict_mask & uops_0_bits_uop_br_mask) != 0) | io_flush) & 1)) & 1 & 1
    uops_2_valid = uops_1_valid & (~((unsigned((io_brupdate_b1_mispredict_mask & uops_1_bits_uop_br_mask) != 0) | io_flush) & 1)) & 1 & 1
  }
  uops_0_bits_uop_br_mask = io_req_bits_uop_br_mask & (~io_brupdate_b1_resolve_mask)#[0..=7]
  uops_0_bits_uop_rob_idx = io_req_bits_uop_rob_idx
  uops_0_bits_uop_pdst = io_req_bits_uop_pdst
  uops_0_bits_uop_dst_rtype = io_req_bits_uop_dst_rtype
  uops_1_bits_uop_br_mask = uops_0_bits_uop_br_mask & (~io_brupdate_b1_resolve_mask)#[0..=7]
  uops_1_bits_uop_rob_idx = uops_0_bits_uop_rob_idx
  uops_1_bits_uop_pdst = uops_0_bits_uop_pdst
  uops_1_bits_uop_dst_rtype = uops_0_bits_uop_dst_rtype
  uops_2_bits_uop_br_mask = uops_1_bits_uop_br_mask & (~io_brupdate_b1_resolve_mask)#[0..=7]
  uops_2_bits_uop_rob_idx = uops_1_bits_uop_rob_idx
  uops_2_bits_uop_pdst = uops_1_bits_uop_pdst
  uops_2_bits_uop_dst_rtype = uops_1_bits_uop_dst_rtype
  io_resp_2_valid = uops_2_valid
  io_resp_2_bits_uop_br_mask = uops_2_bits_uop_br_mask
  io_resp_2_bits_uop_rob_idx = uops_2_bits_uop_rob_idx
  io_resp_2_bits_uop_pdst = uops_2_bits_uop_pdst
  io_resp_2_bits_uop_dst_rtype = uops_2_bits_uop_dst_rtype
}
