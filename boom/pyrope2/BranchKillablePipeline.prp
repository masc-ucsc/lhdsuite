// pyroB — Clock type + collapse `& 1 & 1` tail noise after bool-reduced exprs.
// Each `(~X & 1) & 1` and `~X & 1 & 1` noise strip is a u1 identity.

pub mod BranchKillablePipeline::[timecheck=false](clock:Clock, reset:u1, io_req_valid:u1, io_req_bits_uop_br_mask:u8, io_req_bits_uop_rob_idx:u5, io_req_bits_uop_pdst:u6, io_req_bits_uop_dst_rtype:u2, io_flush:u1, io_brupdate_b1_resolve_mask:u8, io_brupdate_b1_mispredict_mask:u8) -> (io_resp_2_valid:u1@[], io_resp_2_bits_uop_br_mask:u8@[], io_resp_2_bits_uop_rob_idx:u5@[], io_resp_2_bits_uop_pdst:u6@[], io_resp_2_bits_uop_dst_rtype:u2@[]) {
  reg uops_valid:[3]u1:[ordering="old"]
  reg uops_bits_uop_br_mask:[3]u8:[ordering="old"]
  reg uops_bits_uop_rob_idx:[3]u5:[ordering="old"]
  reg uops_bits_uop_pdst:[3]u6:[ordering="old"]
  reg uops_bits_uop_dst_rtype:[3]u2:[ordering="old"]

  const resolve_mask_inv:u8 = (~io_brupdate_b1_resolve_mask)#[0..=7]

  if reset != 0 {
    uops_valid[0] = 0
    uops_valid[1] = 0
    uops_valid[2] = 0
  } else {
    uops_valid[0] = io_req_valid & unsigned(((io_brupdate_b1_mispredict_mask & io_req_bits_uop_br_mask) == 0) and (io_flush == 0))
    uops_valid[1] = uops_valid[0] & unsigned(((io_brupdate_b1_mispredict_mask & uops_bits_uop_br_mask[0]) == 0) and (io_flush == 0))
    uops_valid[2] = uops_valid[1] & unsigned(((io_brupdate_b1_mispredict_mask & uops_bits_uop_br_mask[1]) == 0) and (io_flush == 0))
  }

  uops_bits_uop_br_mask[0] = io_req_bits_uop_br_mask & resolve_mask_inv
  uops_bits_uop_rob_idx[0] = io_req_bits_uop_rob_idx
  uops_bits_uop_pdst[0] = io_req_bits_uop_pdst
  uops_bits_uop_dst_rtype[0] = io_req_bits_uop_dst_rtype
  uops_bits_uop_br_mask[1] = uops_bits_uop_br_mask[0] & resolve_mask_inv
  uops_bits_uop_rob_idx[1] = uops_bits_uop_rob_idx[0]
  uops_bits_uop_pdst[1] = uops_bits_uop_pdst[0]
  uops_bits_uop_dst_rtype[1] = uops_bits_uop_dst_rtype[0]
  uops_bits_uop_br_mask[2] = uops_bits_uop_br_mask[1] & resolve_mask_inv
  uops_bits_uop_rob_idx[2] = uops_bits_uop_rob_idx[1]
  uops_bits_uop_pdst[2] = uops_bits_uop_pdst[1]
  uops_bits_uop_dst_rtype[2] = uops_bits_uop_dst_rtype[1]

  io_resp_2_valid = uops_valid[2]
  io_resp_2_bits_uop_br_mask = uops_bits_uop_br_mask[2]
  io_resp_2_bits_uop_rob_idx = uops_bits_uop_rob_idx[2]
  io_resp_2_bits_uop_pdst = uops_bits_uop_pdst[2]
  io_resp_2_bits_uop_dst_rtype = uops_bits_uop_dst_rtype[2]
}
