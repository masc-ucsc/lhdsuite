// The eight-entry, single-dispatch queues of the SmallBoomV4 translation.
pub const fast = (const dispatchWidth=1, const numSlowEntries=0)
pub const halfSlow = (const dispatchWidth=1, const numSlowEntries=4)
pub const small = (const coreWidth=1, const fp=fast, const mem=fast, const unq=fast, const alu=fast)
pub const mixedQueues = (const coreWidth=1, const fp=fast, const mem=halfSlow, const unq=fast, const alu=halfSlow)
