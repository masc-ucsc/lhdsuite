pub mod PipelinedMultiplier::[timecheck=false](clock:u1, reset:u1, io_req_valid:u1, io_req_bits_fn:u5, io_req_bits_dw:u1, io_req_bits_in1:u64, io_req_bits_in2:u64) -> (io_resp_bits_data:u64@[]) {
  mut _mux_5:u64 = 0
  mut _mux_6:u64 = 0
  reg in_pipe_v:u1
  reg in_pipe_b_fn:u5
  reg in_pipe_b_dw:u1
  reg in_pipe_b_in1:u64
  reg in_pipe_b_in2:u64
  reg io_resp_bits_data_pipe_v:u1
  reg io_resp_bits_data_pipe_b:u64
  reg io_resp_bits_data_pipe_pipe_b:u64
  const decoded_invInputs__w1 = (~in_pipe_b_fn#[0..=1])#[0..=1]
  mut _b2i_2 = if ((((decoded_invInputs__w1 >> 1) & 1) << 1) | (unsigned((((decoded_invInputs__w1 & 1) << 1) | ((in_pipe_b_fn >> 1) & 1)) == 3) & 1)) != 0 { 1 } else { 0 }
  mut _rep_3:u64 = if (_b2i_2 & (in_pipe_b_in1 >> 63) & 1 & 1) != 0 { 0xffffffffffffffff } else { 0 }
  mut _rep_4:u64 = if ((decoded_invInputs__w1 >> 1) & 1 & (in_pipe_b_in2 >> 63) & 1 & 1) != 0 { 0xffffffffffffffff } else { 0 }
  const prod__w1 = (((_rep_3 << 64) | in_pipe_b_in1) * ((_rep_4 << 64) | in_pipe_b_in2))#[0..=127]
  if reset != 0 {
    in_pipe_v = 0
    io_resp_bits_data_pipe_v = 0
  } else {
    in_pipe_v = io_req_valid
    io_resp_bits_data_pipe_v = in_pipe_v
  }
  if io_req_valid != 0 {
    in_pipe_b_fn = io_req_bits_fn
    in_pipe_b_dw = io_req_bits_dw
    in_pipe_b_in1 = io_req_bits_in1
    in_pipe_b_in2 = io_req_bits_in2
  }
  if in_pipe_v != 0 {
    _mux_5 = if in_pipe_b_dw != 0 { prod__w1#[0..=63] } else { prod__w1#[0..=31]#sext[0..=31]#[0..=63] }
    _mux_6 = if (((in_pipe_b_fn & 1) << 1) | ((in_pipe_b_fn >> 1) & 1)) != 0 { prod__w1#[64..=127] } else { _mux_5 }
    io_resp_bits_data_pipe_b = _mux_6
  }
  if io_resp_bits_data_pipe_v != 0 {
    io_resp_bits_data_pipe_pipe_b = io_resp_bits_data_pipe_b
  }
  io_resp_bits_data = io_resp_bits_data_pipe_pipe_b
}
