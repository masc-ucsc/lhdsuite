pub comb Arbiter2_L1DataWriteReq::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_way_en:U4, io_in_0_bits_addr:U12, io_in_0_bits_data:U64, io_in_1_valid:U1, io_in_1_bits_way_en:U4, io_in_1_bits_addr:U12, io_in_1_bits_data:U64, io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_way_en:U4, io_out_bits_addr:U12, io_out_bits_data:U64) {
  mut _mux_1:U4 = if io_in_0_valid != 0 { io_in_0_bits_way_en#[0..<4] } else { io_in_1_bits_way_en#[0..<4] }
  mut _mux_2:U12 = if io_in_0_valid != 0 { io_in_0_bits_addr#[0..<12] } else { io_in_1_bits_addr#[0..<12] }
  mut _mux_3:U64 = if io_in_0_valid != 0 { io_in_0_bits_data#[0..<0x40] } else { io_in_1_bits_data#[0..<0x40] }
  io_in_0_ready = io_out_ready
  io_in_1_ready = (~io_in_0_valid) & io_out_ready & 1
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_way_en = _mux_1
  io_out_bits_addr = _mux_2
  io_out_bits_data = _mux_3
}
