const regfile_32x20 = import("regfile_32x20.regfile_32x20")

pub mod FullyPortedRF_3::[timecheck=false](clock:u1, io_arb_read_reqs_0_bits:u5, io_arb_read_reqs_2_bits:u5, io_arb_read_reqs_3_bits:u5, io_write_ports_0_valid:u1, io_write_ports_0_bits_addr:u6, io_write_ports_0_bits_data:u20) -> (io_rrd_read_resps_0:u20@[], io_rrd_read_resps_2:u20@[], io_rrd_read_resps_3:u20@[]) {
  reg io_rrd_read_resps_0_REG:u5
  reg io_rrd_read_resps_2_REG:u5
  reg io_rrd_read_resps_3_REG:u5
  io_rrd_read_resps_0_REG = io_arb_read_reqs_0_bits
  io_rrd_read_resps_2_REG = io_arb_read_reqs_2_bits
  io_rrd_read_resps_3_REG = io_arb_read_reqs_3_bits
  mut regfile_ext = regfile_32x20::[name=regfile_ext](R0_addr = io_rrd_read_resps_3_REG, R0_en = 1, R0_clk = clock, R1_addr = io_rrd_read_resps_2_REG, R1_en = 1, R1_clk = clock, R2_addr = io_rrd_read_resps_0_REG, R2_en = 1, R2_clk = clock, W0_addr = io_write_ports_0_bits_addr#[0..=4], W0_en = io_write_ports_0_valid, W0_clk = clock, W0_data = io_write_ports_0_bits_data)
  io_rrd_read_resps_0 = regfile_ext.R2_data
  io_rrd_read_resps_2 = regfile_ext.R1_data
  io_rrd_read_resps_3 = regfile_ext.R0_data
