// pyroD — adopt Clock type on clock port to match int-side pyroD convention.
// LEC PROVEN-full vs chipyard SmallBoomV4 RenameBusyTable_1.sv (engine=ind).
// Starts from Oct 21 auto-emit (be74a0f): 30 lines of firtool-dense pyroA
// (mut sentinels, & 1 noise, compiler-generated T_N names, explicit
// if reset {...} else {...}). Cleaned step-wise to a shape mirroring the
// int-side RenameBusyTable (committed BusyTable.prp from Oct 16).

pub mod RenameBusyTable_1::[timecheck=false](
  clock:Clock, reset:u1,
  io_ren_uops_0_pdst:u6,
  io_ren_uops_0_prs1:u6,
  io_ren_uops_0_prs2:u6,
  io_ren_uops_0_prs3:u6,
  io_rebusy_reqs_0:u1,
  io_wakeups_0_valid:u1,
  io_wakeups_0_bits_uop_pdst:u6,
  io_wakeups_1_valid:u1,
  io_wakeups_1_bits_uop_pdst:u6
) -> (
  io_busy_resps_0_prs1_busy:u1@[],
  io_busy_resps_0_prs2_busy:u1@[],
  io_busy_resps_0_prs3_busy:u1@[]
) {

  reg busy_table:u48:[reset_pin=reset, async=true] = 0

  reg wakeups_wu_valid_REG         :u1
  reg wakeups_wu_bits_REG_uop_pdst :u6
  reg wakeups_wu_valid_REG_2       :u1
  reg wakeups_wu_bits_REG_1_uop_pdst:u6

  wakeups_wu_valid_REG           = io_wakeups_0_valid
  wakeups_wu_bits_REG_uop_pdst   = io_wakeups_0_bits_uop_pdst
  wakeups_wu_valid_REG_2         = io_wakeups_1_valid
  wakeups_wu_bits_REG_1_uop_pdst = io_wakeups_1_bits_uop_pdst

  const all1 :u48 = 0xFFFFFFFFFFFF
  const one48:u48 = 1

  const oh_wk0:u48 = (one48 << wakeups_wu_bits_REG_uop_pdst)
  const oh_wk1:u48 = (one48 << wakeups_wu_bits_REG_1_uop_pdst)
  const oh_ren:u48 = (one48 << io_ren_uops_0_pdst)

  const bcast_w0:u48         = if wakeups_wu_valid_REG   != 0 { all1 } else { 0 }
  const bcast_w1:u48         = if wakeups_wu_valid_REG_2 != 0 { all1 } else { 0 }
  const bcast_ren_rebusy:u48 = if io_rebusy_reqs_0       != 0 { all1 } else { 0 }

  const unbusy_mask:u48 = (oh_wk0 & bcast_w0) | (oh_wk1 & bcast_w1)

  busy_table = (busy_table & (~unbusy_mask)) | (oh_ren & bcast_ren_rebusy)

  const prs1_base:u1 = ((busy_table >> io_ren_uops_0_prs1) & 1)
  const prs2_base:u1 = ((busy_table >> io_ren_uops_0_prs2) & 1)
  const prs3_base:u1 = ((busy_table >> io_ren_uops_0_prs3) & 1)

  const prs1_any:u1 = (wakeups_wu_valid_REG   & (if wakeups_wu_bits_REG_uop_pdst   == io_ren_uops_0_prs1 { 1 } else { 0 }))
                    | (wakeups_wu_valid_REG_2 & (if wakeups_wu_bits_REG_1_uop_pdst == io_ren_uops_0_prs1 { 1 } else { 0 }))
  const prs2_any:u1 = (wakeups_wu_valid_REG   & (if wakeups_wu_bits_REG_uop_pdst   == io_ren_uops_0_prs2 { 1 } else { 0 }))
                    | (wakeups_wu_valid_REG_2 & (if wakeups_wu_bits_REG_1_uop_pdst == io_ren_uops_0_prs2 { 1 } else { 0 }))
  const prs3_any:u1 = (wakeups_wu_valid_REG   & (if wakeups_wu_bits_REG_uop_pdst   == io_ren_uops_0_prs3 { 1 } else { 0 }))
                    | (wakeups_wu_valid_REG_2 & (if wakeups_wu_bits_REG_1_uop_pdst == io_ren_uops_0_prs3 { 1 } else { 0 }))

  io_busy_resps_0_prs1_busy = (~prs1_any) & prs1_base
  io_busy_resps_0_prs2_busy = (~prs2_any) & prs2_base
  io_busy_resps_0_prs3_busy = (~prs3_any) & prs3_base
}
