pub mod BoomProbeUnit::[timecheck=false](clock:Clock, reset:u1, io_req_valid:u1, io_req_bits_param:u2, io_req_bits_size:u4, io_req_bits_source:u2, io_req_bits_address:u32, io_rep_ready:u1, io_meta_read_ready:u1, io_meta_write_ready:u1, io_wb_req_ready:u1, io_way_en:u4, io_wb_rdy:u1, io_mshr_rdy:u1, io_block_state_state:u2, io_lsu_release_ready:u1) -> (io_req_ready:u1@[], io_rep_valid:u1@[], io_rep_bits_param:u3@[], io_rep_bits_size:u4@[], io_rep_bits_source:u2@[], io_rep_bits_address:u32@[], io_meta_read_valid:u1@[], io_meta_read_bits_idx:u6@[], io_meta_read_bits_tag:u20@[], io_meta_write_valid:u1@[], io_meta_write_bits_idx:u6@[], io_meta_write_bits_way_en:u4@[], io_meta_write_bits_data_coh_state:u2@[], io_meta_write_bits_data_tag:u20@[], io_wb_req_valid:u1@[], io_wb_req_bits_tag:u20@[], io_wb_req_bits_idx:u6@[], io_wb_req_bits_source:u2@[], io_wb_req_bits_param:u3@[], io_wb_req_bits_way_en:u4@[], io_mshr_wb_rdy:u1@[], io_lsu_release_valid:u1@[], io_lsu_release_bits_address:u32@[], io_state_valid:u1@[], io_state_bits:u40@[]) {
  reg state:u4
  reg req_param:u2
  reg req_size:u4
  reg req_source:u2
  reg req_address:u32
  reg way_en:u4
  reg old_coh_state:u2

  const zero2:u2 = 0
  const r_T:u4 = (req_param << 2) | (if way_en != 0 { old_coh_state } else { zero2 })
  const r_eq_0:u1 = unsigned(r_T == 0)
  const r_eq_1:u1 = unsigned(r_T == 1)
  const r_eq_2:u1 = unsigned(r_T == 2)
  const r_eq_3:u1 = unsigned(r_T == 3)
  const r_eq_4:u1 = unsigned(r_T == 4)
  const r_eq_5:u1 = unsigned(r_T == 5)
  const r_eq_6:u1 = unsigned(r_T == 6)
  const r_eq_7:u1 = unsigned(r_T == 7)
  const r_eq_8:u1 = unsigned(r_T == 8)
  const r_eq_9:u1 = unsigned(r_T == 9)
  const r_eq_10:u1 = unsigned(r_T == 10)
  const r_eq_11:u1 = unsigned(r_T == 11)
  const r_eq_2or3:u1 = r_eq_3 | r_eq_2

  mut rp:u3 = if r_eq_8 != 0 { 5 } else { 0 }
  rp = if r_eq_9 != 0 { 2 } else { rp }
  rp = if (r_eq_11 | r_eq_10) != 0 { 1 } else { rp }
  rp = if r_eq_4 != 0 { 5 } else { rp }
  rp = if r_eq_5 != 0 { 4 } else { rp }
  rp = if (r_eq_7 | r_eq_6) != 0 { 0 } else { rp }
  rp = if r_eq_0 != 0 { 5 } else { rp }
  rp = if r_eq_1 != 0 { 4 } else { rp }
  rp = if r_eq_2or3 != 0 { 3 } else { rp }
  const report_param:u3 = rp

  const s_eq_0:u1 = unsigned(state == 0)
  const s_eq_1:u1 = unsigned(state == 1)
  const s_eq_5:u1 = unsigned(state == 5)
  const s_eq_6:u1 = unsigned(state == 6)
  const s_eq_7:u1 = unsigned(state == 7)
  const s_eq_9:u1 = unsigned(state == 9)

  const io_req_ready_internal:u1 = s_eq_0
  const io_rep_valid_internal:u1 = s_eq_6
  const io_meta_read_valid_internal:u1 = s_eq_1
  const io_meta_write_valid_internal:u1 = s_eq_9
  const io_wb_req_valid_internal:u1 = s_eq_7
  const io_lsu_release_valid_internal:u1 = s_eq_5

  const req_fire:u1 = io_req_ready_internal & io_req_valid

  const mux_27:u4 = if (io_meta_write_ready & io_meta_write_valid_internal) != 0 { 10 } else { state }
  const mux_28:u4 = if io_wb_req_ready != 0 { 9 } else { state }
  const mux_29:u4 = if (io_wb_req_ready & io_wb_req_valid_internal) != 0 { 8 } else { state }
  const mux_30:u4 = if way_en != 0 { 9 } else { 0 }
  const mux_31:u4 = if io_rep_ready != 0 { mux_30 } else { state }
  const mux_32:u4 = if (io_lsu_release_ready & io_lsu_release_valid_internal) != 0 { 6 } else { state }
  const mux_34:u4 = if (io_mshr_rdy & io_wb_rdy) != 0 { 4 } else { 1 }
  const mux_35:u4 = if (io_meta_read_ready & io_meta_read_valid_internal) != 0 { 2 } else { state }
  const mux_36:u4 = if req_fire != 0 { 1 } else { state }
  const way_present:u1 = unsigned(way_en != 0)
  const probe_want_report:u1 = r_eq_3 | (unsigned((((r_eq_2 | r_eq_1) | r_eq_0) == 0)) & (r_eq_7 | (unsigned((((r_eq_6 | r_eq_5) | r_eq_4) == 0)) & r_eq_11)))
  const probe_mid:u4 = (1 << 2) | ((way_present & probe_want_report) << 1) | 1

  const next_state_packed:u64 = (state << 60) | (state << 56) | (state << 52) | (state << 48) | (state << 44) | (mux_27 << 36) | (mux_28 << 32) | (mux_29 << 28) | (mux_31 << 24) | (mux_32 << 20) | (probe_mid << 16) | (mux_34 << 12) | (3 << 8) | (mux_35 << 4) | mux_36
  state = if reset != 0 { 0 } else { ((next_state_packed << 4) >> ((state * 4) + 4))#[0..=3] }

  if req_fire != 0 {
    req_param = io_req_bits_param
    req_size = io_req_bits_size
    req_source = io_req_bits_source
    req_address = io_req_bits_address
  }

  const s_eq_2:u1 = unsigned(state == 2)
  const s_ne_3:u1 = unsigned(state != 3)
  if (io_req_ready_internal | io_meta_read_valid_internal | s_eq_2 | s_ne_3) == 0 {
    way_en = io_way_en
    old_coh_state = io_block_state_state
  }

  mut coh_next:u2 = if r_eq_0 != 0 { 0 } else { (r_eq_7 | r_eq_6) | r_eq_5 }
  coh_next = if r_eq_1 != 0 { 1 } else { coh_next }
  coh_next = if r_eq_2or3 != 0 { 2 } else { coh_next }

  const s_eq_8:u1 = unsigned(state == 8)
  const s_eq_10:u1 = unsigned(state == 10)
  const s_ne_0:u1 = unsigned(state != 0)

  io_req_ready = io_req_ready_internal
  io_rep_valid = io_rep_valid_internal
  io_rep_bits_param = report_param
  io_rep_bits_size = req_size
  io_rep_bits_source = req_source
  io_rep_bits_address = req_address
  io_meta_read_valid = io_meta_read_valid_internal
  io_meta_read_bits_idx = req_address#[6..=11]
  io_meta_read_bits_tag = req_address#[12..=31]
  io_meta_write_valid = io_meta_write_valid_internal
  io_meta_write_bits_idx = req_address#[6..=11]
  io_meta_write_bits_way_en = way_en
  io_meta_write_bits_data_coh_state = coh_next
  io_meta_write_bits_data_tag = req_address#[12..=31]
  io_wb_req_valid = io_wb_req_valid_internal
  io_wb_req_bits_tag = req_address#[12..=31]
  io_wb_req_bits_idx = req_address#[6..=11]
  io_wb_req_bits_source = req_source
  io_wb_req_bits_param = report_param
  io_wb_req_bits_way_en = way_en
  io_mshr_wb_rdy = unsigned((io_rep_valid_internal | io_wb_req_valid_internal | s_eq_8 | io_meta_write_valid_internal | s_eq_10) == 0)
  io_lsu_release_valid = io_lsu_release_valid_internal
  io_lsu_release_bits_address = req_address
  io_state_valid = s_ne_0
  io_state_bits = req_address
}
