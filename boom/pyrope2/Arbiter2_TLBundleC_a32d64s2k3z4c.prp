pub comb Arbiter2_TLBundleC_a32d64s2k3z4c::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_address:U32, io_in_1_valid:U1, io_in_1_bits_address:U32, io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_address:U32) {
  mut _mux_1:U32 = if io_in_0_valid != 0 { io_in_0_bits_address#[0..<32] } else { io_in_1_bits_address#[0..<32] }
  io_in_0_ready = io_out_ready
  io_in_1_ready = (~io_in_0_valid) & io_out_ready & 1
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_address = _mux_1
}
