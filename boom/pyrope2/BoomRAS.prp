// Parametric BoomRAS.
//
// Defaults match SmallBoomV4Config (nRasEntries=32, IdxT=u5, AddrT=u40); at
// those defaults this LECs structurally against the previously PROVEN hand
// pyroD at boom/pyrope2/BoomRAS.prp. Changing <nRasEntries, IdxT, AddrT>
// parametrizes the stack depth and address width — matching the Chisel
// BoomRAS at generators/boom/.../ifu/bpd/ras.scala, which takes nRasEntries
// and vaddrBitsExtended via BoomCoreParams. The caller picks IdxT width
// consistently (std.clog2(nRasEntries) bits) — Pyrope today requires the
// width type on input ports to be a literal type expression, not a
// function call like Unsigned(bits=std.clog2(N)).

pub mod BoomRAS<nRasEntries=32, IdxT=u5, AddrT=u40>::[timecheck=false](
  clock:Clock,
  io_read_idx:IdxT,
  io_write_valid:u1,
  io_write_idx:IdxT,
  io_write_addr:AddrT
) -> (
  io_read_addr:AddrT@[]
) {

  reg ras:[nRasEntries]AddrT

  reg io_read_addr_REG  :u1
  reg io_read_addr_REG_1:AddrT
  reg io_read_addr_REG_2:AddrT

  io_read_addr_REG   = if io_write_valid != 0 and io_write_idx == io_read_idx { 1 } else { 0 }
  io_read_addr_REG_1 = io_write_addr
  io_read_addr_REG_2 = ras[io_read_idx]

  io_read_addr = if io_read_addr_REG != 0 { io_read_addr_REG_1 } else { io_read_addr_REG_2 }

  if io_write_valid != 0 { ras[io_write_idx] = io_write_addr }
}
