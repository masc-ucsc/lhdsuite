// Hand pyroD of riscv-boom v4 ifu/bpd/ras.scala (SmallBoomV4Config:
// nRasEntries=32, vaddrBitsExtended=40). LEC PROVEN-full vs SmallBoomV4
// gen-collateral `BoomRAS.sv` (engine=ind, solver=cvc5, 518 ms).
//
// Previous pyroA (commit 5f035e3) held 32 scalar `reg ras_0..ras_31:u40`
// name-for-name against the .sv on the assumption that tier-2 state
// pairing could not pair `reg ras:[32]u40` with those scalars. The
// pairing step does still fail (`kind/init mismatch`), but the inductive
// engine proves equivalence via flop-cut miter + abc regardless, so the
// array form is LEC-safe.
//
// Reset: no reset port — SmallBoomV4 regs init via Verilog randomize
// macros, pyroD matches with `reg x:u40 = 0` and no `reset_pin=` attr.

pub mod BoomRAS::[timecheck=false](
  clock:Clock,
  io_read_idx:u5,
  io_write_valid:u1,
  io_write_idx:u5,
  io_write_addr:u40
) -> (
  io_read_addr:u40@[]
) {

  reg ras:[32]u40

  reg io_read_addr_REG  :u1
  reg io_read_addr_REG_1:u40
  reg io_read_addr_REG_2:u40

  io_read_addr_REG   = if io_write_valid != 0 and io_write_idx == io_read_idx { 1 } else { 0 }
  io_read_addr_REG_1 = io_write_addr
  io_read_addr_REG_2 = ras[io_read_idx]

  io_read_addr = if io_read_addr_REG != 0 { io_read_addr_REG_1 } else { io_read_addr_REG_2 }

  if io_write_valid != 0 { ras[io_write_idx] = io_write_addr }
}
