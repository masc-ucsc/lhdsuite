pub comb Arbiter2_WritebackReq::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_tag:U20, io_in_0_bits_idx:U6, io_in_0_bits_source:U2, io_in_0_bits_param:U3, io_in_0_bits_way_en:U4, io_in_0_bits_voluntary:U1, io_in_1_valid:U1, io_in_1_bits_tag:U20, io_in_1_bits_idx:U6, io_in_1_bits_source:U2, io_in_1_bits_param:U3, io_in_1_bits_way_en:U4, io_in_1_bits_voluntary:U1, io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_tag:U20, io_out_bits_idx:U6, io_out_bits_source:U2, io_out_bits_param:U3, io_out_bits_way_en:U4, io_out_bits_voluntary:U1) {
  mut _mux_1:U20 = if io_in_0_valid != 0 { io_in_0_bits_tag#[0..<20] } else { io_in_1_bits_tag#[0..<20] }
  mut _mux_2:U6 = if io_in_0_valid != 0 { io_in_0_bits_idx#[0..<6] } else { io_in_1_bits_idx#[0..<6] }
  mut _mux_3:U2 = if io_in_0_valid != 0 { io_in_0_bits_source#[0..<2] } else { io_in_1_bits_source#[0..<2] }
  mut _mux_4:U3 = if io_in_0_valid != 0 { io_in_0_bits_param#[0..<3] } else { io_in_1_bits_param#[0..<3] }
  mut _mux_5:U4 = if io_in_0_valid != 0 { io_in_0_bits_way_en#[0..<4] } else { io_in_1_bits_way_en#[0..<4] }
  mut _mux_6:U1 = if io_in_0_valid != 0 { io_in_0_bits_voluntary & 1 } else { io_in_1_bits_voluntary & 1 }
  io_in_0_ready = io_out_ready
  io_in_1_ready = (~io_in_0_valid) & io_out_ready & 1
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_tag = _mux_1
  io_out_bits_idx = _mux_2
  io_out_bits_source = _mux_3
  io_out_bits_param = _mux_4
  io_out_bits_way_en = _mux_5
  io_out_bits_voluntary = _mux_6
}
