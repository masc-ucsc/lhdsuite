  io_map_resps_0_stale_pdst = if   ldst_idx == 0 { map_table_0 }
                              elif ldst_idx ==  1 { map_table_1 }
                              elif ldst_idx ==  2 { map_table_2 }
                              elif ldst_idx ==  3 { map_table_3 }
                              elif ldst_idx ==  4 { map_table_4 }
