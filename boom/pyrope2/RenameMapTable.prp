  // ========= one-hot ldst decoders =========
  wire remap_hit_0 :u1 = if io_remap_reqs_0_valid != 0 and io_remap_reqs_0_ldst == 0 { 1 } else { 0 }
  wire remap_hit_1 :u1 = if io_remap_reqs_0_valid != 0 and io_remap_reqs_0_ldst == 1 { 1 } else { 0 }
  wire remap_hit_2 :u1 = if io_remap_reqs_0_valid != 0 and io_remap_reqs_0_ldst == 2 { 1 } else { 0 }
