  // ========= READ: 32-way muxes for prs1 / prs2 / stale_pdst =========
  // firtool indexes by lrs[4:0] (only 32 slots).  Slice to u5 so the
  // u6 'high' bit doesn't drop us into the catch-all 'else'.
  wire lrs1_idx:u5 = io_map_reqs_0_lrs1#[0..=4]
  wire lrs2_idx:u5 = io_map_reqs_0_lrs2#[0..=4]
  wire ldst_idx:u5 = io_map_reqs_0_ldst#[0..=4]
  io_map_resps_0_prs1       = if   lrs1_idx == 0 { map_table_0 }
