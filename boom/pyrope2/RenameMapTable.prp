                              elif lrs1_idx == 19 { map_table_19 }
                              elif lrs1_idx == 20 { map_table_20 }
                              elif lrs1_idx == 21 { map_table_21 }
                              elif lrs1_idx == 22 { map_table_22 }
                              elif lrs1_idx == 23 { map_table_23 }
