pub mod regfile_48x65::[timecheck=false](R0_addr:u6, R0_en:u1, R0_clk:u1, R1_addr:u6, R1_en:u1, R1_clk:u1, R2_addr:u6, R2_en:u1, R2_clk:u1, W0_addr:u6, W0_en:u1, W0_clk:u1, W0_data:u65, W1_addr:u6, W1_en:u1, W1_clk:u1, W1_data:u65) -> (R0_data:u65@[], R1_data:u65@[], R2_data:u65@[]) {
