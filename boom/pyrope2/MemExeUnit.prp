// pyroB — Clock type, factor shared `resolve_mask_inv`, dedupe `_b2i_5 == _b2i_9`,
// collapse `& (~(X | io_kill) & 1) & 1 & 1` noise into clean boolean form,
// drop `_io_squash_iss_output__w1` indirection where it's only read once.
// Mux-chain shape preserved.

pub mod MemExeUnit::[timecheck=false](clock:Clock, reset:u1, io_kill:u1, io_brupdate_b1_resolve_mask:u8, io_brupdate_b1_mispredict_mask:u8, io_iss_uop_valid:u1, io_iss_uop_bits_fu_code_1:u1, io_iss_uop_bits_fu_code_2:u1, io_iss_uop_bits_iw_p1_bypass_hint:u1, io_iss_uop_bits_br_mask:u8, io_iss_uop_bits_imm_sel:u3, io_iss_uop_bits_pimm:u5, io_iss_uop_bits_stq_idx:u4, io_iss_uop_bits_prs1:u6, io_iss_uop_bits_lrs1_rtype:u2, io_arb_irf_reqs_0_ready:u1, io_arb_rebusys_0_valid:u1, io_arb_rebusys_0_bits_uop_pdst:u6, io_arb_rebusys_0_bits_rebusy:u1, io_rrd_irf_resps_0:u64, io_rrd_irf_bypasses_0_valid:u1, io_rrd_irf_bypasses_0_bits_uop_pdst:u6, io_rrd_irf_bypasses_0_bits_data:u64, io_rrd_irf_bypasses_1_valid:u1, io_rrd_irf_bypasses_1_bits_uop_pdst:u6, io_rrd_irf_bypasses_1_bits_data:u64) -> (io_arb_irf_reqs_0_valid:u1@[], io_arb_irf_reqs_0_bits:u6@[], io_rrd_immrf_wakeup_valid:u1@[], io_rrd_immrf_wakeup_bits_uop_pimm:u5@[], io_squash_iss:u1@[], io_dgen_valid:u1@[], io_dgen_bits_uop_stq_idx:u4@[], io_dgen_bits_data:u64@[]) {
  reg arb_uop_valid:u1
  reg arb_uop_bits_fu_code_1:u1
  reg arb_uop_bits_fu_code_2:u1
  reg arb_uop_bits_iw_p1_bypass_hint:u1
  reg arb_uop_bits_br_mask:u8
  reg arb_uop_bits_imm_sel:u3
  reg arb_uop_bits_pimm:u5
  reg arb_uop_bits_stq_idx:u4
  reg arb_uop_bits_prs1:u6
  reg arb_uop_bits_lrs1_rtype:u2
  reg rrd_uop_valid:u1
  reg rrd_uop_bits_fu_code_1:u1
  reg rrd_uop_bits_fu_code_2:u1
  reg rrd_uop_bits_br_mask:u8
  reg rrd_uop_bits_imm_sel:u3
  reg rrd_uop_bits_pimm:u5
  reg rrd_uop_bits_stq_idx:u4
  reg rrd_uop_bits_prs1:u6
  reg rrd_uop_bits_lrs1_rtype:u2
  reg exe_uop_valid:u1
  reg exe_uop_bits_fu_code_2:u1
  reg exe_uop_bits_stq_idx:u4
  reg exe_rs1_data:u64

  const resolve_mask_inv:u8 = (~io_brupdate_b1_resolve_mask)#[0..=7]
  const arb_rtype_is_int:u1 = unsigned(arb_uop_bits_lrs1_rtype == 0)
  const arb_will_replay:u1 = unsigned((io_brupdate_b1_mispredict_mask & arb_uop_bits_br_mask) != 0)

  const io_arb_irf_reqs_0_valid_internal:u1 = arb_uop_valid & arb_rtype_is_int & unsigned(arb_uop_bits_iw_p1_bypass_hint == 0)
  const squash_iss_internal:u1 = io_arb_irf_reqs_0_valid_internal & unsigned(io_arb_irf_reqs_0_ready == 0)
  const arb_rebusied:u1 = arb_rtype_is_int & io_arb_rebusys_0_valid & io_arb_rebusys_0_bits_rebusy & unsigned(io_arb_rebusys_0_bits_uop_pdst == arb_uop_bits_prs1)
  const stay_in_arb:u1 = squash_iss_internal | arb_rebusied

  const hits_0:u1 = io_rrd_irf_bypasses_0_valid & unsigned(rrd_uop_bits_prs1 == io_rrd_irf_bypasses_0_bits_uop_pdst)
  const hits_1:u1 = io_rrd_irf_bypasses_1_valid & unsigned(rrd_uop_bits_prs1 == io_rrd_irf_bypasses_1_bits_uop_pdst)

  arb_uop_valid = if stay_in_arb != 0 {
    arb_uop_valid & unsigned((arb_will_replay | io_kill) == 0) & unsigned(arb_rebusied == 0)
  } else {
    io_iss_uop_valid & unsigned(((io_brupdate_b1_mispredict_mask & io_iss_uop_bits_br_mask) == 0) and (io_kill == 0))
  }

  if stay_in_arb == 0 {
    arb_uop_bits_fu_code_1 = io_iss_uop_bits_fu_code_1
    arb_uop_bits_fu_code_2 = io_iss_uop_bits_fu_code_2
    arb_uop_bits_imm_sel = io_iss_uop_bits_imm_sel
    arb_uop_bits_pimm = io_iss_uop_bits_pimm
    arb_uop_bits_stq_idx = io_iss_uop_bits_stq_idx
    arb_uop_bits_prs1 = io_iss_uop_bits_prs1
    arb_uop_bits_lrs1_rtype = io_iss_uop_bits_lrs1_rtype
  }
  arb_uop_bits_iw_p1_bypass_hint = unsigned(stay_in_arb == 0) & io_iss_uop_bits_iw_p1_bypass_hint
  arb_uop_bits_br_mask = if stay_in_arb != 0 { arb_uop_bits_br_mask & resolve_mask_inv } else { io_iss_uop_bits_br_mask & resolve_mask_inv }

  rrd_uop_valid = unsigned(stay_in_arb == 0) & arb_uop_valid & unsigned((arb_will_replay | io_kill) == 0)
  rrd_uop_bits_fu_code_1 = arb_uop_bits_fu_code_1
  rrd_uop_bits_fu_code_2 = arb_uop_bits_fu_code_2
  rrd_uop_bits_br_mask = arb_uop_bits_br_mask & resolve_mask_inv
  rrd_uop_bits_imm_sel = arb_uop_bits_imm_sel
  rrd_uop_bits_pimm = arb_uop_bits_pimm
  rrd_uop_bits_stq_idx = arb_uop_bits_stq_idx
  rrd_uop_bits_prs1 = arb_uop_bits_prs1
  rrd_uop_bits_lrs1_rtype = arb_uop_bits_lrs1_rtype

  const rrd_will_replay:u1 = unsigned((io_brupdate_b1_mispredict_mask & rrd_uop_bits_br_mask) != 0)
  exe_uop_valid = rrd_uop_valid & unsigned((rrd_will_replay | io_kill) == 0)
  exe_uop_bits_fu_code_2 = rrd_uop_bits_fu_code_2
  exe_uop_bits_stq_idx = rrd_uop_bits_stq_idx

  const bypass_hit:u1 = hits_0 | hits_1
  const bypass_data:u64 = (if hits_0 != 0 { io_rrd_irf_bypasses_0_bits_data } else { 0 }) | (if hits_1 != 0 { io_rrd_irf_bypasses_1_bits_data } else { 0 })
  const rs1_from_bypass_or_rf:u64 = if bypass_hit != 0 { bypass_data } else { io_rrd_irf_resps_0 }
  exe_rs1_data = if rrd_uop_bits_lrs1_rtype == 3 { 0 } else { rs1_from_bypass_or_rf }

  io_arb_irf_reqs_0_valid = io_arb_irf_reqs_0_valid_internal
  io_arb_irf_reqs_0_bits = arb_uop_bits_prs1
  io_rrd_immrf_wakeup_valid = rrd_uop_valid & unsigned((rrd_uop_bits_imm_sel != 6) and (rrd_uop_bits_imm_sel != 5))
  io_rrd_immrf_wakeup_bits_uop_pimm = rrd_uop_bits_pimm
  io_squash_iss = squash_iss_internal
  io_dgen_valid = exe_uop_valid & exe_uop_bits_fu_code_2
  io_dgen_bits_uop_stq_idx = exe_uop_bits_stq_idx
  io_dgen_bits_data = exe_rs1_data
}
