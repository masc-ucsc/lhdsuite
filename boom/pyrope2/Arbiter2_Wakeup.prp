pub comb Arbiter2_Wakeup::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_uop_pdst:U6, io_in_0_bits_uop_dst_rtype:U2, io_in_0_bits_bypassable:U1, io_in_0_bits_rebusy:U1, io_in_1_valid:U1, io_in_1_bits_uop_pdst:U6, io_in_1_bits_uop_dst_rtype:U2) -> (io_in_1_ready:U1, io_out_valid:U1, io_out_bits_uop_pdst:U6, io_out_bits_uop_dst_rtype:U2, io_out_bits_bypassable:U1, io_out_bits_rebusy:U1) {
  mut _mux_1:U6 = if io_in_0_valid != 0 { io_in_0_bits_uop_pdst#[0..<6] } else { io_in_1_bits_uop_pdst#[0..<6] }
  mut _mux_2:U2 = if io_in_0_valid != 0 { io_in_0_bits_uop_dst_rtype#[0..<2] } else { io_in_1_bits_uop_dst_rtype#[0..<2] }
  io_in_1_ready = ~io_in_0_valid
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_uop_pdst = _mux_1
  io_out_bits_uop_dst_rtype = _mux_2
  io_out_bits_bypassable = ((~io_in_0_valid) | io_in_0_bits_bypassable) & 1
  io_out_bits_rebusy = io_in_0_valid & io_in_0_bits_rebusy & 1
}
