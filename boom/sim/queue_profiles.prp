const queue = import("../pyrope2/IssueUnitCollapsing_1.IssueUnitCollapsing_1")
const configs = import("../pyrope2/BoomConfig")
comptime const fast = configs.fast
comptime const mixed = configs.halfSlow
mod trial<Q>(clk:Clock, rst:Reset, submit:U1, enable:U1) -> (ready:U1@[0]) {
  const q = queue<Q>(
    `clock`=clk, `reset`=rst, io_dis_uops_0_valid=submit,
    io_dis_uops_0_bits_fu_code_1=1, io_dis_uops_0_bits_fu_code_2=0, io_dis_uops_0_bits_iw_p1_speculative_child=0,
    io_dis_uops_0_bits_iw_p2_speculative_child=0, io_dis_uops_0_bits_br_mask=0, io_dis_uops_0_bits_is_fence=0,
    io_dis_uops_0_bits_is_fencei=0, io_dis_uops_0_bits_imm_sel=0, io_dis_uops_0_bits_pimm=0,
    io_dis_uops_0_bits_ldq_idx=0, io_dis_uops_0_bits_stq_idx=0, io_dis_uops_0_bits_pdst=0,
    io_dis_uops_0_bits_prs1=0, io_dis_uops_0_bits_prs2=0, io_dis_uops_0_bits_prs1_busy=0,
    io_dis_uops_0_bits_prs2_busy=0, io_dis_uops_0_bits_ppred_busy=0, io_dis_uops_0_bits_exception=0,
    io_dis_uops_0_bits_uses_ldq=0, io_dis_uops_0_bits_uses_stq=0, io_dis_uops_0_bits_dst_rtype=0,
    io_dis_uops_0_bits_lrs1_rtype=0, io_dis_uops_0_bits_lrs2_rtype=0, io_dis_uops_0_bits_fp_val=0,
    io_wakeup_ports_0_valid=0, io_wakeup_ports_0_bits_uop_pdst=0, io_wakeup_ports_0_bits_bypassable=0,
    io_wakeup_ports_0_bits_rebusy=0, io_wakeup_ports_1_valid=0, io_wakeup_ports_1_bits_uop_pdst=0,
    io_wakeup_ports_2_valid=0, io_wakeup_ports_2_bits_uop_pdst=0, io_child_rebusys=0,
    io_fu_types_1_1=enable, io_brupdate_b1_resolve_mask=0, io_brupdate_b1_mispredict_mask=0,
    io_flush_pipeline=0, io_squash_grant=0)
  ready = q.io_dis_uops_0_ready
}
pub mod queue_profiles(clk:Clock, rst:Reset, submit:U1, enable:U1) -> (allFast:U1@[0], halfFast:U1@[0]) {
  allFast = trial<fast>(clk=clk,rst=rst,submit=submit,enable=enable)
  halfFast = trial<mixed>(clk=clk,rst=rst,submit=submit,enable=enable)
}
test queue_profiles.ready {
  mut d = queue_profiles
  tick 20 {
    d.rst = clock < 2
    d.submit = U1(clock >= 4 and clock <= 7)
    d.enable = U1(clock >= 10)
    step
    if clock > 1 {
      assert(d.allFast == 1, "the eight fast slots absorb the burst")
      assert(d.halfFast == U1(clock < 7 or clock > 8), "four fast slots backpressure until the tail compacts")
    }
  }
}
