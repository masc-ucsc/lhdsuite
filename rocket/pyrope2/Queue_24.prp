    maybe_full = 0
  } else {
    _b2i_3 = if do_enq__w1 == do_deq__w1 { 1 } else { 0 }
    if ((~_b2i_3) & 1) != 0 {
      maybe_full = do_enq__w1
    }
  }
  io_enq_ready = io_enq_ready_0__w1
