pub mod Queue_24::[timecheck=false](clock:u1, reset:u1, io_enq_valid:u1, io_enq_bits_id:u1, io_enq_bits_resp:u2, io_deq_ready:u1) -> (io_enq_ready:u1@[], io_deq_valid:u1@[], io_deq_bits_id:u1@[], io_deq_bits_resp:u2@[]) {
  mut _b2i_3 = 0
  reg ram:u3
  reg maybe_full:u1
