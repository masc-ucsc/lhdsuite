pub mod ram_8x9::[timecheck=false](R0_addr:u3, R0_en:u1, R0_clk:u1, W0_addr:u3, W0_en:u1, W0_clk:u1, W0_data:u9) -> (R0_data:u9@[]) {
  reg Memory:[8]u9:[ordering="old", __store_clock_pin=ref W0_clk, __store_posclk=true]
  if (W0_en & 1 & 1) != 0 {
    Memory[W0_addr] = W0_data
  }
  mut _mux_1:u9 = if R0_en != 0 { Memory[R0_addr] } else { 0ub?????????#[0..=8] }
  R0_data = _mux_1
}
