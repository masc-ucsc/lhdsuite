// Both formats return the signed, byte-scaled displacement in 13 bits.
pub comb offset(inst:U32) -> (imm:U13) {
  imm = (inst#[31] << 12) | (inst#[7] << 11) | (inst#[25..<31] << 5) | (inst#[8..<12] << 1)
}

pub comb compressedOffset(half:U16) -> (imm:U13) {
  const b = (half#[12] << 8) | (half#[5..<7] << 6) | (half#[2] << 5) | (half#[10..<12] << 3) | (half#[3..<5] << 1)
  imm = b#sext[0..<9]#[0..<13]
}

// Walk the two possible instruction endings in program order. A jump cuts
// off the scan. A 32-bit branch ending in slot zero starts in the prior word.
pub comb packet<C>(pc:Unsigned(bits=C.xLen), data:U32, previous:U16, partial:Bool)
    -> (branch:Bool, slot:U1, target:Unsigned(bits=C.xLen)) {
  const base = (pc >> 2) << 2
  const low = data#[0..<16]
  const lowStart = pc#[1] == 0 and !partial
  mut stopped = false
  branch = false
  slot = 0
  target = 0
  for i in 0..<2 {
    const half = data#[(i*16)..+16]
    const prefix = if i == 0 { previous } else { low }
    const full = if i == 0 { partial and pc#[1] == 0 } else { lowStart and low#[0..<2] == 3 }
    const starts = if i == 0 { lowStart } else { !lowStart or low#[0..<2] != 3 }
    const short = C.useCompressed and starts and half#[0..<2] != 3
    const inst = (half << 16) | prefix
    const op = inst#[0..<7]
    const conditional = (full and op == 0x63 and inst#[13..<15] != 1) or
                        (short and half#[0..<2] == 1 and half#[14..<16] == 3)
    if !stopped and conditional {
      branch = true
      slot = i
      const imm = if full { offset(inst=inst) } else { compressedOffset(half=half) }
      wrap target = base + 2*i - (if full { 2 } else { 0 }) + imm#sext[0..<13]
    }
    const cj = half#[0..<2] == 1 and (half#[13..<16] == 5 or (C.xLen == 32 and half#[13..<16] == 1))
    const jr = half#[0..<2] == 2 and half#[13..<16] == 4 and half#[2..<7] == 0
    stopped = stopped or conditional or (full and (op == 0x6f or op == 0x67)) or (short and (cj or jr))
  }
}
