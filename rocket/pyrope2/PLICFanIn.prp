pub comb PLICFanIn::[timecheck=false](io_prio_0:u2, io_prio_1:u2, io_ip:u2) -> (io_dev:u2, io_max:u2) {
  const io_ip_0__w1 = io_ip
  const effectivePriority_1__w1 = ((io_ip_0__w1 & 1) << 2) | io_prio_0
  const effectivePriority_2__w1 = (((io_ip_0__w1 >> 1) & 1) << 2) | io_prio_1
  const _GEN__w1 = unsigned(effectivePriority_1__w1 < 5)
  mut _mux_2:u3 = if _GEN__w1 != 0 { 4 } else { effectivePriority_1__w1 }
  const _GEN_0__w1 = _mux_2
  mut _b2i_3 = if _GEN_0__w1 >= effectivePriority_2__w1 { 1 } else { 0 }
  const _GEN_1__w1 = _b2i_3
  mut _mux_4:u3 = if _GEN_1__w1 != 0 { _GEN_0__w1 } else { effectivePriority_2__w1 }
  mut _mux_5:u2 = if _GEN_1__w1 != 0 { ((~_GEN__w1) & 1) } else { 2 }
  io_dev = _mux_5
  io_max = _mux_4#[0..=1]
}
