pub mod LevelGateway::[timecheck=false](clock:u1, reset:u1, io_interrupt:u1, io_plic_ready:u1, io_plic_complete:u1) -> (io_plic_valid:u1@[]) {
  reg inFlight:u1:[initial=0, reset_pin=ref reset, async=false]
  const io_interrupt_0__w1 = io_interrupt
  const io_plic_valid_0__w1 = io_interrupt_0__w1 & (~inFlight) & 1 & 1
  if not (reset != 0) {
    inFlight = (~io_plic_complete) & 1 & ((io_interrupt_0__w1 & io_plic_ready & 1) | inFlight) & 1 & 1
  }
  io_plic_valid = io_plic_valid_0__w1
}
