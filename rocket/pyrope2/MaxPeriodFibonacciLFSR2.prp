// 16-bit Fibonacci LFSR: shift toward bit 15, feeding taps 15/13/12/10 into bit 0.
// Keep the original module name and ports so this file can replace the original.
pub mod MaxPeriodFibonacciLFSR(
  io_increment:u1
) -> (
  io_out_0:u1@[], io_out_1:u1@[], io_out_2:u1@[], io_out_3:u1@[],
  io_out_4:u1@[], io_out_5:u1@[], io_out_6:u1@[], io_out_7:u1@[],
  io_out_8:u1@[], io_out_9:u1@[], io_out_10:u1@[], io_out_11:u1@[],
  io_out_12:u1@[], io_out_13:u1@[], io_out_14:u1@[], io_out_15:u1@[]
) {
  reg state:u16= 1

  io_out_0 = state#[0]
  io_out_1 = state#[1]
  io_out_2 = state#[2]
  io_out_3 = state#[3]
  io_out_4 = state#[4]
  io_out_5 = state#[5]
  io_out_6 = state#[6]
  io_out_7 = state#[7]
  io_out_8 = state#[8]
  io_out_9 = state#[9]
  io_out_10 = state#[10]
  io_out_11 = state#[11]
  io_out_12 = state#[12]
  io_out_13 = state#[13]
  io_out_14 = state#[14]
  io_out_15 = state#[15]

  if io_increment != 0 {
    const feedback:u1 = state#[15] ^ state#[13] ^ state#[12] ^ state#[10]
    state#[1..=15] = state#[0..=14]
    state#[0] = feedback
  }
}
