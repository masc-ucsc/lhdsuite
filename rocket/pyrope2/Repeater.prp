// Hold an accepted beat while the downstream consumer asks for repetitions.
pub mod Repeater<T>(clk:Clock, rst:Reset, again:U1, offer:U1, payload:T, take:U1)
    -> (ready:U1@[], valid:U1@[], full:U1@[], head:T@[]) {
  reg held:U1 = 0
  reg saved:T = nil
  full = held
  ready = take & ~held
  valid = offer | held
  head = if held != 0 { saved } else { payload }
  if ready != 0 and offer != 0 and again != 0 { saved = payload }
  if take != 0 and valid != 0 { held = again }
}
