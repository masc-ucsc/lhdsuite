pub comb DMIToTL::[timecheck=false](auto_out_a_ready:u1, auto_out_d_valid:u1, auto_out_d_bits_opcode:u4, auto_out_d_bits_param:u2, auto_out_d_bits_size:u2, auto_out_d_bits_sink:u1, auto_out_d_bits_denied:u1, auto_out_d_bits_data:u32, auto_out_d_bits_corrupt:u1, io_dmi_req_valid:u1, io_dmi_req_bits_addr:u7, io_dmi_req_bits_data:u32, io_dmi_req_bits_op:u2, io_dmi_resp_ready:u1) -> (auto_out_a_valid:u1, auto_out_a_bits_opcode:u4, auto_out_a_bits_address:u9, auto_out_a_bits_data:u32, auto_out_d_ready:u1, io_dmi_req_ready:u1, io_dmi_resp_valid:u1, io_dmi_resp_bits_data:u32, io_dmi_resp_bits_resp:u2) {
  const io_dmi_req_bits_op_0__w1 = io_dmi_req_bits_op
  const addr__w1 = io_dmi_req_bits_addr << 2
  const gbits_a_mask_bit__w1 = (addr__w1 >> 1) & 1
  const pfbits_a_mask_bit__w1 = (addr__w1 >> 1) & 1
  const gbits_a_mask_eq_1__w1 = gbits_a_mask_bit__w1
  const gbits_a_mask_eq__w1 = (~gbits_a_mask_bit__w1) & 1
  const gbits_a_mask_bit_1__w1 = addr__w1 & 1
  const pfbits_a_mask_bit_1__w1 = addr__w1 & 1
  const gbits_a_mask_nbit_1__w1 = (~gbits_a_mask_bit_1__w1) & 1
  const pfbits_a_mask_eq_1__w1 = pfbits_a_mask_bit__w1
  const pfbits_a_mask_eq__w1 = (~pfbits_a_mask_bit__w1) & 1
  const pfbits_a_mask_nbit_1__w1 = (~pfbits_a_mask_bit_1__w1) & 1
  const _GEN__w1 = unsigned(io_dmi_req_bits_op_0__w1 == 2)
  const _GEN_0__w1 = unsigned(io_dmi_req_bits_op_0__w1 == 1)
  mut _mux_3:u4 = if _GEN__w1 != 0 { 0 } else { (_GEN_0__w1 & 1) << 2 }
  mut _mux_4:u9 = if _GEN_0__w1 != 0 { addr__w1 } else { 0x48 }
  mut _mux_5:u9 = if _GEN__w1 != 0 { addr__w1 } else { _mux_4 }
  mut _mux_6:u32 = if _GEN__w1 != 0 { io_dmi_req_bits_data } else { 0 }
  auto_out_a_valid = io_dmi_req_valid
