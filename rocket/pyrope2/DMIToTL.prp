  auto_out_d_ready = io_dmi_resp_ready
  io_dmi_req_ready = auto_out_a_ready
  io_dmi_resp_valid = auto_out_d_valid
  io_dmi_resp_bits_data = auto_out_d_bits_data
  io_dmi_resp_bits_resp = ((auto_out_d_bits_corrupt | auto_out_d_bits_denied) & 1)
}
