const defaultConfig = import("RocketConfig.selected")
// The low tag bit selects a client at response time. Pipeline ownership selects
// the stage-one store data and routes nacks two cycles after a request.
pub mod HellaCacheArbiter<C=defaultConfig>::[timecheck=false](accAddress:U32=0, accData:Unsigned(bits=C.dLen)=0, accPrivilege:U2=0, accSize:U2=0, accValid:Bool=false, accWrite:Bool=false, cacheLoadError:Bool, cacheNack:Bool, cacheReady:Bool, cacheResponseError:Bool, cacheStageError:Bool=false, cacheTag:U7, cacheValid:Bool, clk:Clock, cpuAddress:Unsigned(bits=C.dLen), cpuCommand:U5, cpuData:Unsigned(bits=C.dLen), cpuKill:Bool, cpuPrivilege:U2, cpuSigned:Bool, cpuSize:U2, cpuTag:U7, cpuValid:Bool, cpuVirtual:Bool, rst:Reset, slaveAddress:U32, slaveCommand:U5, slaveData:Unsigned(bits=C.dLen), slaveKill:Bool, slaveMask:Unsigned(bits=C.dLen/8), slaveSize:U2, slaveValid:Bool, walkAddress:U32=0, walkRead:Bool=false) -> (accDone:Bool@[], accError:Bool@[], accReady:Bool@[], cpuNack:Bool@[], cpuReady:Bool@[], cpuResponse:Bool@[], cpuResponseTag:U7@[], cpuStage2:Bool@[], request:(address:Unsigned(bits=C.dLen), command:U5, storeData:Unsigned(bits=C.dLen), virtual:Bool, isSigned:Bool, kill:Bool, storeMask:Unsigned(bits=C.dLen/8), physical:Bool, privilege:U2, size:U2, skipException:Bool, tag:U7, valid:Bool)@[], slaveNack:Bool@[], slaveReady:Bool@[], slaveResponse:Bool@[], walkDone:Bool@[], walkError:Bool@[], walkReady:Bool@[]) {
  reg s1CPU:Bool = nil
  reg s2CPU:Bool = nil
  reg s1Walk:Bool = nil
  reg s2Walk:Bool = nil
  mut wantWalk:Bool = false
  mut pteAddress:U32 = 0
  walkReady = false
  walkDone = false
  walkError = false
  if C.useVM {
    // Retain only nacked requests. An accepted uncached read can return
    // later, while other clients continue to use the request pipeline.
    reg retry:Bool = false
    reg savedAddress:U32 = nil
    wantWalk = retry or walkRead
    pteAddress = if retry { savedAddress } else { walkAddress }
    walkReady = !retry and cacheReady
    if wantWalk and cacheReady {
      savedAddress = pteAddress
      retry = false
    }
    if s2Walk and cacheNack {
      retry = true
    }
    walkError = (s2Walk and cacheLoadError) or (cacheValid and cacheTag == 3 and cacheResponseError)
    walkDone = walkError or (cacheValid and cacheTag == 3)
  }
  mut accelerator = false
  mut accS1 = false
  mut accS2 = false
  mut accPA:U32 = 0
  mut accOp:U5 = 0
  mut accWidth:U2 = 0
  mut accMode:U2 = 0
  mut accWord:Unsigned(bits=C.dLen) = 0
  accReady = false
  accDone = false
  accError = false
  if C.vLen != 0 or C.roccOpcodes != 0 {
    reg active:Bool = false
    reg pending:Bool = false
    reg preferCPU:Bool = false
    reg stage1:Bool = false
    reg stage2:Bool = false
    reg saved:(addr:U32, write:Bool, size:U2, privilege:U2, data:Unsigned(bits=C.dLen)) = nil
    accReady = !active and !rst
    if accValid and accReady {
      saved = (addr=accAddress, data=accData, privilege=accPrivilege, size=accSize, write=accWrite)
      active = true
      pending = true
    }
    accelerator = pending and !wantWalk and (!preferCPU or !cpuValid)
    accPA = saved.addr
    accOp = U5(saved.write)
    accWidth = saved.size
    accMode = saved.privilege
    accWord = saved.data
    stage1 = accelerator and cacheReady
    stage2 = stage1
    accS1 = stage1
    accS2 = stage2
    if accelerator and cacheReady {
      pending = false
      preferCPU = true
    }
    if !accelerator and !wantWalk and cpuValid and cacheReady {
      preferCPU = false
    }
    if stage2 and cacheNack {
      pending = true
    }
    const returned = cacheValid and cacheTag == 5
    accError = (stage2 and cacheStageError) or (returned and cacheResponseError)
    accDone = accError or returned
    if accDone {
      active = false
      pending = false
    }
  }
  const cpu = cpuValid and !wantWalk and !accelerator
  const slave = !cpu and !wantWalk and !accelerator
  s1CPU = cpu and cacheReady
  s2CPU = s1CPU
  s1Walk = wantWalk and cacheReady
  s2Walk = s1Walk
  cpuReady = !wantWalk and !accelerator and cacheReady
  slaveReady = slave and cacheReady
  request.valid = wantWalk or accelerator or cpu or slaveValid
  request.address = if wantWalk { pteAddress } elif accelerator { accPA } elif cpu { cpuAddress } else { slaveAddress }
  request.tag = if wantWalk { 3 } elif accelerator { 5 } elif cpu { cpuTag#[0..<6] << 1 } else { 1 }
  request.command = if wantWalk { 0 } elif accelerator { accOp } elif cpu { cpuCommand } else { slaveCommand }
  request.size = if wantWalk { std.clog2(C.xLen/8) } elif accelerator { accWidth } elif cpu { cpuSize } else { slaveSize }
  request.isSigned = cpu and cpuSigned
  request.privilege = if wantWalk { 1 } elif accelerator { accMode } elif cpu { cpuPrivilege } else { 0 }
  request.virtual = cpu and cpuVirtual
  request.physical = !cpu
  request.skipException = slave
  request.kill = if s1Walk or accS1 { false } elif s1CPU { cpuKill } else { slaveKill }
  request.storeData = if accS1 { accWord } elif s1CPU { cpuData } else { slaveData }
  request.storeMask = if s1CPU { 0 } else { slaveMask }
  cpuStage2 = s2CPU
  cpuNack = s2CPU and cacheNack
  slaveNack = (!s2CPU and !s2Walk and !accS2) and cacheNack
  cpuResponse = cacheTag#[0] == 0 and cacheValid
  slaveResponse = cacheTag == 1 and cacheValid
  cpuResponseTag = cacheTag >> 1
}
