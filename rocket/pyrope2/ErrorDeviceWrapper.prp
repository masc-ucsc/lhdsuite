const TLBuffer = import("TLBuffer.TLBuffer")
const TLError = import("TLError.TLError")

type Request = (opcode:U4, param:U3, size:U4, source:U5, address:U14, mask:U4, data:U32, corrupt:U1)
type Response = (opcode:U4, param:U2, size:U4, source:U5, sink:U1, denied:U1, data:U32, corrupt:U1)

pub mod ErrorDeviceWrapper::[timecheck=false](clock:u1, reset:u1, auto_buffer_in_a_valid:u1, auto_buffer_in_a_bits_opcode:u4, auto_buffer_in_a_bits_param:u3, auto_buffer_in_a_bits_size:u4, auto_buffer_in_a_bits_source:u5, auto_buffer_in_a_bits_address:u14, auto_buffer_in_a_bits_mask:u4, auto_buffer_in_a_bits_data:u32, auto_buffer_in_a_bits_corrupt:u1, auto_buffer_in_d_ready:u1) -> (auto_buffer_in_a_ready:u1@[], auto_buffer_in_d_valid:u1@[], auto_buffer_in_d_bits_opcode:u4@[], auto_buffer_in_d_bits_param:u2@[], auto_buffer_in_d_bits_size:u4@[], auto_buffer_in_d_bits_source:u5@[], auto_buffer_in_d_bits_sink:u1@[], auto_buffer_in_d_bits_denied:u1@[], auto_buffer_in_d_bits_data:u32@[], auto_buffer_in_d_bits_corrupt:u1@[]) {
  wire _buffer_auto_out_a_valid:u1
  wire _buffer_auto_out_a_bits_opcode:u4
  wire _buffer_auto_out_a_bits_param:u3
  wire _buffer_auto_out_a_bits_size:u4
  wire _buffer_auto_out_a_bits_source:u5
  wire _buffer_auto_out_a_bits_address:u14
  wire _buffer_auto_out_a_bits_mask:u4
  wire _buffer_auto_out_a_bits_data:u32
  wire _buffer_auto_out_a_bits_corrupt:u1
  wire _buffer_auto_out_d_ready:u1
  mut error = TLError::[name=error](clock = clock, reset = reset, auto_in_a_valid = _buffer_auto_out_a_valid, auto_in_a_bits_opcode = _buffer_auto_out_a_bits_opcode, auto_in_a_bits_param = _buffer_auto_out_a_bits_param, auto_in_a_bits_size = _buffer_auto_out_a_bits_size, auto_in_a_bits_source = _buffer_auto_out_a_bits_source, auto_in_a_bits_address = _buffer_auto_out_a_bits_address, auto_in_a_bits_mask = _buffer_auto_out_a_bits_mask, auto_in_a_bits_data = _buffer_auto_out_a_bits_data, auto_in_a_bits_corrupt = _buffer_auto_out_a_bits_corrupt, auto_in_d_ready = _buffer_auto_out_d_ready)
  const buffer = TLBuffer<A=Request, D=Response>(clk=clock, rst=reset,
      aValid=auto_buffer_in_a_valid, aReady=error.auto_in_a_ready, dValid=error.auto_in_d_valid,
      dReady=auto_buffer_in_d_ready,
      request=(opcode=auto_buffer_in_a_bits_opcode, param=auto_buffer_in_a_bits_param, size=auto_buffer_in_a_bits_size,
      source=auto_buffer_in_a_bits_source, address=auto_buffer_in_a_bits_address,
      mask=auto_buffer_in_a_bits_mask, data=auto_buffer_in_a_bits_data, corrupt=auto_buffer_in_a_bits_corrupt),
      response=(opcode=error.auto_in_d_bits_opcode, param=0, size=error.auto_in_d_bits_size,
      source=error.auto_in_d_bits_source, sink=0, denied=1, data=0, corrupt=error.auto_in_d_bits_corrupt))
  _buffer_auto_out_a_valid = buffer.outValid
  _buffer_auto_out_a_bits_opcode = buffer.outA.opcode
  _buffer_auto_out_a_bits_param = buffer.outA.param
  _buffer_auto_out_a_bits_size = buffer.outA.size
  _buffer_auto_out_a_bits_source = buffer.outA.source
  _buffer_auto_out_a_bits_address = buffer.outA.address
  _buffer_auto_out_a_bits_mask = buffer.outA.mask
  _buffer_auto_out_a_bits_data = buffer.outA.data
  _buffer_auto_out_a_bits_corrupt = buffer.outA.corrupt
  _buffer_auto_out_d_ready = buffer.outReady
  auto_buffer_in_a_ready = buffer.inReady
  auto_buffer_in_d_valid = buffer.inValid
  auto_buffer_in_d_bits_opcode = buffer.inD.opcode
  auto_buffer_in_d_bits_param = buffer.inD.param
  auto_buffer_in_d_bits_size = buffer.inD.size
  auto_buffer_in_d_bits_source = buffer.inD.source
  auto_buffer_in_d_bits_sink = buffer.inD.sink
  auto_buffer_in_d_bits_denied = buffer.inD.denied
  auto_buffer_in_d_bits_data = buffer.inD.data
  auto_buffer_in_d_bits_corrupt = buffer.inD.corrupt
}
