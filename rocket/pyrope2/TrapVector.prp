// Rocket aligns a vectored table to one four-byte slot per XLEN bit.
pub comb vector<W>(interrupt:Bool, number:U8, tvec:Unsigned(bits=W)) -> (readback:Unsigned(bits=W), target:Unsigned(bits=W)) {
  const vectored = tvec#[0] != 0
  const base = tvec & (if vectored { (1 << W) - 4*W } else { (1 << W) - 4 })
  readback = base | tvec#[0]
  target = base | (if vectored and interrupt and number < W { number << 2 } else { 0 })
}
