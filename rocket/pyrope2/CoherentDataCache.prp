const metadata = import("ClientMetadata")
const decode = import("CacheAccess.command")
const amo = import("AMOALU.AMOALU")
const refill = import("CacheRefill.CacheRefill")
const writeback = import("CacheWriteback.CacheWriteback")

// Physically indexed, blocking cache for aligned data beats. The caller
// supplies lane-aligned data, byte strobes, and a HellaCache command. AMOs
// return the previous beat; SC returns zero on success and one on failure. TileLink block
// messages use size 6 (64 bytes); A is AcquireBlock with all lanes enabled.
pub mod CoherentDataCache<W=32, SETS=64, WAYS=4, SOURCE=1, SINK_BITS=4, ATOMICS=true, LRSC_CYCLES=80>(clk:Clock, rst:Reset,
    request:Bool, address:U32, command:U5, mask:Unsigned(bits=W/8), data:Unsigned(bits=W), responseReady:Bool,
    aReady:Bool, bValid:Bool, bAddress:U32, bParam:U2, bSource:U5, cReady:Bool,
    dValid:Bool, dOpcode:U3, dParam:U2, dSource:U5, dSink:Unsigned(bits=SINK_BITS),
    dData:Unsigned(bits=W), dDenied:Bool, dCorrupt:Bool, eReady:Bool)
    -> (ready:Bool@[], response:Bool@[], result:Unsigned(bits=W)@[], error:Bool@[],
        aValid:Bool@[], aAddress:U32@[], aParam:U2@[], aSource:U5@[], bReady:Bool@[],
        cLast:Bool@[], cValid:Bool@[], cAddress:U32@[], cOpcode:U3@[], cParam:U3@[], cSource:U5@[],
        cData:Unsigned(bits=W)@[], cCorrupt:Bool@[], dReady:Bool@[], eValid:Bool@[], eSink:Unsigned(bits=SINK_BITS)@[]) {
  cassert(W == 32 or W == 64)
  cassert(SETS > 0 and SETS == 1 << std.clog2(SETS))
  cassert(WAYS > 0 and WAYS == 1 << std.clog2(WAYS))
  comptime const slots = SETS * WAYS
  comptime const beats = 512 / W
  comptime const lanes = W / 8
  type Slot = Unsigned(max=slots-1)
  type Row = Unsigned(max=slots*beats-1)
  type Word = Unsigned(bits=W)
  comptime const idle = 0
  comptime const lookup = 1
  comptime const releasing = 2
  comptime const acquire = 3
  comptime const waiting = 4
  comptime const answer = 5

  reg phase:U3 = 0
  reg reqAddr:U32 = nil
  reg cmd:U5 = nil
  reg strobes:Unsigned(bits=lanes) = nil
  reg operand:Word = nil
  reg value:Word = nil
  reg fault:Bool = nil
  reg target:Slot = nil
  reg oldState:U2 = nil
  reg awaitingReleaseAck:Bool = false
  reg replayGrant:Bool = false
  reg probing:Bool = false
  reg probeSlot:Slot = nil
  reg inGrant:Bool = false
  reg present:Unsigned(bits=slots) = 0
  reg tags:[slots]U26:[ordering="old"] = nil
  reg permissions:[slots]U2:[ordering="old"] = nil
  reg words:[slots*beats]Word:[ordering="old", wensize=lanes] = nil
  reg poison:[slots*beats]U1:[ordering="old"] = nil
  reg readRow:Row = nil

  const op = decode(cmd=cmd)
  const store = op.write != 0
  const lr = ATOMICS and cmd == 6
  const sc = ATOMICS and cmd == 7
  const atomic = ATOMICS and op.amo != 0
  wire startReservation:Bool = nil
  wire probeAccepted:Bool = nil
  mut reserved = false
  mut protect = false
  if ATOMICS {
    cassert(LRSC_CYCLES > 4)
    reg count:Unsigned(max=LRSC_CYCLES-1) = 0
    reg line:U26 = nil
    protect = count > 3
    reserved = protect and line == reqAddr >> 6
    if count > 0 { wrap count -= 1 }
    // A subsequent access consumes the reservation; leave a brief probe window.
    if phase == lookup and !probing and protect { count = 3 }
    if startReservation and count == 0 { count = LRSC_CYCLES-1; line = reqAddr >> 6 }
    if rst or probeAccepted { count = 0 }
  }
  // A probe is serviced before a new lookup, or before the first grant
  // beat. After that beat, all refill writes finish before probing resumes.
  const otherSet = ((bAddress >> 6) % SETS) != ((reqAddr >> 6) % SETS)
  const canProbe = !rst and !protect and !probing and !inGrant and !replayGrant and phase != acquire and
      (phase != releasing or (awaitingReleaseAck and otherSet))
  const offerProbe = canProbe and bValid
  const block = (if offerProbe { bAddress } else { reqAddr }) >> 6
  const set = block % SETS
  mut victim:Slot = set * WAYS
  if WAYS > 1 {
    reg nextWay:[SETS]Unsigned(bits=std.clog2(WAYS)):[ordering="old"] = 0
    victim = set * WAYS + nextWay[set]
    if phase == acquire and !probing { nextWay[set] = (target + 1) % WAYS }
  }
  mut found = false
  mut selected:Slot = victim
  for way in 0..<WAYS {
    const slot = set * WAYS + way
    if present#[slot] == 0 and !found { selected = slot }
    elif present#[slot] != 0 and tags[slot] == block { selected = slot; found = true }
  }
  const state = if found { permissions[selected] } else { metadata.invalid }
  const hit = metadata.access(state=state, write=store, writeIntent=lr)
  const access = phase == lookup and !probing and !offerProbe
  const row = selected * beats + ((reqAddr / lanes) % beats)
  const bad = poison[row] != 0 and (atomic or !store or strobes != (1 << lanes)-1)
  startReservation = access and hit.hit and lr and !bad
  const evict = access and (!sc or reserved) and !found and present#[selected] != 0
  const owner = if offerProbe { state } else { permissions[selected] }
  const wb = writeback<W=W,SOURCE=SOURCE>(clk=clk, rst=rst, probeValid=offerProbe, probeAddress=bAddress,
      probeCap=bParam, probeSource=bSource, releaseValid=evict, releaseAddress=tags[selected] << 6, lineState=owner,
      readReady=true, readData=words[readRow], readCorrupt=poison[readRow] != 0, cReady=cReady,
      ackValid=dValid and dOpcode == 6 and dSource == SOURCE)
  cLast = wb.update
  bReady = canProbe and wb.probeReady
  probeAccepted = offerProbe and wb.probeReady
  if probeAccepted { probing = true; probeSlot = selected }
  const ownerSlot = if probing { probeSlot } else { target }
  if wb.readValid { readRow = ownerSlot * beats + wb.readBeat }
  if wb.update {
    if probing { probing = false } else { awaitingReleaseAck = true }
    // NtoN reports a probe miss; the indexed slot can contain another tag.
    if wb.cParam != 5 {
      present#[ownerSlot] = U1(wb.newState != metadata.invalid)
      permissions[ownerSlot] = wb.newState
    }
  }
  cValid = wb.cValid
  cAddress = wb.lineAddress
  cOpcode = wb.cOpcode
  cParam = wb.cParam
  cSource = wb.cSource
  cData = wb.cData
  cCorrupt = wb.cCorrupt

  const allowGrant = !probing and !offerProbe
  const f = refill<W=W,SOURCE=SOURCE,SINK_BITS=SINK_BITS>(clk=clk, rst=rst, request=phase == acquire,
      address=reqAddr, state=oldState, write=false, writeIntent=store or lr, aReady=aReady,
      dValid=dValid and allowGrant, dOpcode=dOpcode, dSource=dSource, dSink=dSink, dCap=dParam,
      dData=dData, dDenied=dDenied, dCorrupt=dCorrupt, eReady=eReady, ramReady=true)
  aValid = f.aValid
  aAddress = f.lineAddress
  aParam = f.aParam
  aSource = f.aSource
  dReady = if dOpcode == 6 { wb.ackReady and dSource == SOURCE } else { allowGrant and f.dReady }
  eValid = f.eValid
  eSink = f.eSink
  if dValid and dReady and dOpcode == 5 { inGrant = !f.done }
  if f.fill {
    const fillRow = target * beats + f.fillBeat
    words[fillRow] = f.fillData
    poison[fillRow] = U1(f.fillCorrupt)
  }
  if f.install { tags[target] = reqAddr >> 6; permissions[target] = f.newState; present#[target] = 1 }

  ready = !rst and phase == idle
  response = phase == answer
  result = value
  error = fault
  if ready and request {
    reqAddr = address
    cmd = command
    operand = data
    strobes = mask
    const next = decode(cmd=command)
    if command == 0 or command == 1 or command == 17 or (ATOMICS and (next.lrsc != 0 or next.amo != 0)) {
      phase = lookup
    } else { phase = answer; value = 0; fault = true }
  }
  if access {
    replayGrant = false
    if sc and !reserved {
      value = 1
      fault = false
      phase = answer
    } elif hit.hit {
      const previous = words[row]
      value = if sc { 0 } else { previous }
      fault = bad
      if store and !bad {
        mut word = operand
        if atomic { word = amo<W>(io_mask=strobes, io_cmd=cmd, io_lhs=previous, io_rhs=operand) }
        for lane in 0..<lanes {
          if strobes#[lane] != 0 { words[row]#[(8*lane)..<(8*lane+8)] = word#[(8*lane)..<(8*lane+8)] }
        }
        permissions[selected] = hit.next
        poison[row] = 0
      }
      phase = answer
    } elif !evict or wb.releaseReady {
      target = selected
      oldState = state
      phase = if evict { releasing } else { acquire }
    }
  }
  if phase == releasing and wb.releaseDone { phase = acquire; awaitingReleaseAck = false }
  if phase == acquire and f.ready { phase = waiting }
  if f.done {
    if f.error { fault = true; value = 0; phase = answer } else { phase = lookup; replayGrant = true }
  }
  if response and responseReady { phase = idle }
  if rst { phase = idle; present = 0; probing = false; inGrant = false; replayGrant = false; awaitingReleaseAck = false }
}
