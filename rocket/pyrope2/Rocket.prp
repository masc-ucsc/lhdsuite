comb hazards(busyRegs:U32, exRd:U5, hazardEnabled:[3]Bool, hazardRegs:[3]U5, lateRd:U5, lateWrite:Bool, memRd:U5, wbRd:U5) -> (matchEX:Bool, matchMEM:Bool, matchWB:Bool, scoreboardHazard:Bool) {
  scoreboardHazard = false
  matchEX = false
  matchMEM = false
  matchWB = false
  for i in 0..<3 {
    const r = hazardRegs[i]
    if hazardEnabled[i] and r != 0 {
      scoreboardHazard = scoreboardHazard or (busyRegs#[r] != 0 and !(lateWrite and lateRd == r))
      matchEX = matchEX or exRd == r
      matchMEM = matchMEM or memRd == r
      matchWB = matchWB or wbRd == r
    }
  }
}

