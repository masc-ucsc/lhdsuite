  // A store reads in EX; wait for older FP writes. Serialize around loads
  // so a delayed DCache response cannot be overtaken by another FP write.
  const loadAhead = (exStage.valid and exWB.fp and exWB.mem) or (memStage.valid and memWB.fp and memWB.mem) or (wbStage.valid and wbControl.fp and wbControl.mem)
  const storeID = ibuf.inst#[0..<7] == 0x27
  const writerAhead = (exStage.valid and exWB.fp) or (memStage.valid and memWB.fp)
  const fpWait = enableFP and decode.fp and (outstandingFP or loadAhead or (storeID and writerAhead))
  const writeData = if dataResponse and responseInt != 0 { dmemResponse.respData#[0..<C.xLen] }
    elif takeRoCC { roccData }
    elif takeVector { vectorData }
    elif lateWrite { divData }
    elif wbControl.fp { fpResult }
    elif wbControl.csr != 0 { csr.io_rw_rdata }
    else { wbStage.wdata }
  comptime const regBits = if C.useRVE { 4 } else { 5 }
  const rf = RegFile<RegBits=regBits, XLEN=C.xLen>(clk=pipeClock, rs1=id_raddr1#[0..<regBits], rs2=id_raddr2#[0..<regBits], rd=writeRd#[0..<regBits], write=writeRF, data=writeData)
  const operands:[2]Unsigned(bits=C.xLen) = [rf.a, rf.b]
  const hazardRegs:[3]U5 = [id_raddr1, id_raddr2, id_waddr]
  const hazardEnabled:[3]Bool = [decode.rxs1, decode.rxs2, decode.wxd]
  const dependency = hazards(busyRegs=busyRegs#[0..<32], exRd, hazardEnabled, hazardRegs, lateRd, lateWrite, memRd, wbRd)
  const slowLoad = if !C.fastLoadWord { true } elif C.fastLoadByte { false } else { memStage.slow_bypass }
  const exCannotBypass = exWB.rocc or exWB.vector or exWB.csr != 0 or exOp.jalr or exWB.mem or exOp.mul or exWB.div or exWB.fp
  const memCannotBypass = memWB.rocc or memWB.vector or memWB.csr != 0 or (memWB.mem and slowLoad) or memOp.mul or memWB.div or memWB.fp
  const hazardEX = exStage.valid and exWB.wxd and dependency.matchEX and exCannotBypass
  const hazardMEM = memStage.valid and memWB.wxd and dependency.matchMEM and memCannotBypass
  const hazardWB = wbStage.valid and wbControl.wxd and dependency.matchWB and lateResult
  const loadUse = memStage.valid and memWB.wxd and dependency.matchMEM and memWB.mem
  const pipelineBusy = exStage.valid or memStage.valid or wbStage.valid
  const divideBusy = divideRequest or (!divRequestReady and (!divResponseValid or wbWrites))
  const dataHazard = hazardEX or hazardMEM or hazardWB or dependency.scoreboardHazard
  const dBlocked = cacheBlocked and !dmemResponse.perfGrant
  const stallID = fpWait or dataHazard or (csr.io_singleStep != 0 and pipelineBusy) or (decode.div and divideBusy) or (decode.mem and dBlocked) or waitFence or csr.io_csr_stall != 0 or paused
  decodeReady = active and !stallID
  const killID = !ibuf.valid or ibuf.replay or redirectPipe or stallID or csr.interrupt
  const resumePC = if replayWB { wbStage.address } else { nextPC }
  const redirectPC = if wbException or csr.io_eret != 0 { csr.io_evec } else { resumePC }
  const resolved = memStage.valid and !memStage.exception and !redirectWB
  const flushMEM = memStage.valid and memStage.flush_pipe
  const advanceEX = exPCValid and !flushMEM
  if C.haveBasicCounters and C.nPerfCounters > 0 {
    perfID = performance.classify<C>(inst=ibuf.inst, mem=decode.mem, fp=decode.fp, amo=decode.amo, csr=decode.csr, wxd=decode.wxd, branch=decode.branch, jal=decode.jal, jalr=decode.jalr, mulDiv=decode.mul or decode.div)
    perfAdvance = (U1(memPCValid) << 2) | (U1(exPCValid) << 1) | U1(!killID)
    reg lastResponse:Bool:[clock_pin=pipeClock] = nil
    const iBlocked = !imemResponse.respValid and !lastResponse
    lastResponse = imemResponse.respValid
    mut prediction:Bool = false
    if C.btbEntries > 0 {
      reg exTaken:Bool:[clock_pin=pipeClock] = nil
      reg predicted:Bool:[clock_pin=pipeClock] = nil
      if !killID {
        exTaken = ibuf.predictedTaken
      }
      if advanceEX {
        predicted = exTaken
      }
      prediction = predicted
    }
    const wrongDirection = memOp.branch and memTaken != prediction
    const redirectMEM = memStage.valid and !memStage.exception and redirect
    const loadWait = (hazardEX and exWB.mem) or (hazardMEM and memWB.mem) or (hazardWB and wbControl.mem)
    const csrWait = (hazardEX and exWB.csr != 0) or (hazardMEM and memWB.csr != 0) or (hazardWB and wbControl.csr != 0)
    mut stalls:U11 = 0
    stalls#[0] = U1(loadWait)
    stalls#[1] = U1(dependency.scoreboardHazard)
    stalls#[2] = U1(csrWait)
    stalls#[3] = U1(iBlocked)
    stalls#[4] = U1(decode.mem and dBlocked)
    stalls#[5] = U1(redirectMEM and wrongDirection)
    stalls#[6] = U1(redirectMEM and controlFlow and !wrongDirection and !iBlocked)
    stalls#[7] = U1(wbStage.flush_pipe)
    stalls#[8] = U1(replayWB)
    if C.useMulDiv {
      stalls#[9] = U1((hazardEX and (exWB.div or exOp.mul)) or (hazardMEM and (memWB.div or memOp.mul)) or (hazardWB and wbControl.div))
    }
    if C.fLen > 0 {
      stalls#[(if C.useMulDiv { 10 } else { 9 })] = U1(fpWait or (hazardEX and exWB.fp) or (hazardMEM and memWB.fp) or (hazardWB and wbControl.fp))
    }
    perfPipe = stalls
  } else {
    perfID = 0
    perfPipe = 0
    perfAdvance = 0
  }
  const debugJump = exOp.jalr and csr.io_status_debug != 0
  const endPause = csr.io_time#[0..<5] == 0 or csr.io_inhibit_cycle != 0 or redirectPipe
  const startPause = !killID and decode.fence and ibuf.inst#[20..<24] == 0
  paused = running and !endPause and (startPause or paused)
  fetchMayRequest = exPCValid or memPCValid or csr.io_customCSRs_0_value#[1] != 0
  if !killID {
    exWB.rocc = decode.rocc
    exWB.vector = decode.vector
    exWB.fp = decode.fp
    exOp.branch = decode.branch
    exOp.jal = decode.jal
    exOp.jalr = decode.jalr
    exALU.rxs2 = decode.rxs2
    exALU.sel_alu2 = if decodeTrap { U1(secondFetchTrap and !firstFetchTrap) } else { decode.sel_alu2 }
    exALU.sel_alu1 = if !decodeTrap { decode.sel_alu1 } elif fetchTrap { 2 } else { 1 }
    exALU.sel_imm = decode.sel_imm
    exALU.alu_dw = U1(decodeTrap or decode.alu_dw != 0)
    exALU.alu_fn = if decodeTrap { 0 } else { decode.alu_fn }
    exWB.mem = decode.mem
    exOp.mem_cmd = if decode.mem_cmd == 20 and virtualMode { 21 } else { decode.mem_cmd }
    exOp.mul = decode.mul and !decodeTrap
    exWB.div = decode.div and !decodeTrap
    exWB.wxd = decode.wxd
    exWB.csr = csrOp.effective
    exWB.fence_i = decode.fence_i
    exStage.rvc = (decodeTrap and secondFetchTrap) or ibuf.rvc
    exStage.flush_pipe = decode.fence_i or csrOp.system or (csrOp.access and !csrOp.readOnly and csr.io_decode_0_write_flush != 0)
    exStage.load_use = loadUse
    exStage.mem_size = match decode.mem_cmd {
      in (5, 20, 21, 22) { (U1(id_raddr2 != 0) << 1) | U1(id_raddr1 != 0) }
      else { ibuf.inst#[12..<14] }
    }
    // Each operand saves either its register value or a two-bit forwarding selector.
    for i in 0..<2 {
      const src = hazardRegs[i]
      const fromEX = exWrites and exRd == src
      const fromMEM = memWrites and memRd == src
      const forward = src == 0 or fromEX or fromMEM
      const select:U2 = if src == 0 { 0 } elif fromEX { 1 } elif fromMEM and !memWB.mem { 2 } else { 3 }
      const readRF = hazardEnabled[i] and !forward
      const trapInst = i == 0 and (illegalInstruction or virtualInstruction)
      ex_bypass[i] = forward and !trapInst
      ex_lsb[i] = if trapInst { rawInstruction#[0..<2] } elif readRF { operands[i]#[0..<2] } else { select }
      if trapInst {
        ex_msb[i] = rawInstruction#[2..<32]
      } elif readRF {
        ex_msb[i] = operands[i]#[2..<C.xLen]
      }
    }
  }

  if memPCValid {
    wbControl = memWB
    wbStage.cause = memCause
    wbStage.address = memStage.address
    wbStage.hls_or_dv = memStage.hls_or_dv
    wbStage.instruction = memStage.instruction
    wbStage.raw_inst = memStage.raw_inst
    wbStage.wdata = wbData
    wbStage.watch = memStage.watch | (if memStage.load { csr.watchLoad } else { 0 }) | (if memStage.store { csr.watchStore } else { 0 })
  }
  exStage.xcpt_interrupt = running and !redirectPipe and ibuf.valid and csr.interrupt
  exStage.valid = running and !killID
  if !killID or csr.interrupt or ibuf.replay {
    exStage.cause = decodeCause
    exStage.address = ibuf.pc
    exStage.instruction = ibuf.inst
    exStage.raw_inst = ibuf.raw
    exStage.watch = csr.watchFetch
  }
  exStage.exception = running and !killID and decodeTrap
  exStage.replay = running and !redirectPipe and ibuf.valid and ibuf.replay
  memStage.xcpt_interrupt = running and !redirectPipe and exStage.xcpt_interrupt
  memStage.valid = running and !killEX

  branchIndex = 0
  if C.bhtEntries > 0 {
    reg exIndex:Unsigned(bits=C.bhtIndexBits):[clock_pin=pipeClock] = nil
    reg memIndex:Unsigned(bits=C.bhtIndexBits):[clock_pin=pipeClock] = nil
    if !killID {
      exIndex = ibuf.prediction
    }
    if advanceEX {
      memIndex = exIndex
    }
    branchIndex = memIndex
  }
  memStage.exception = running and !killEX and executeTrap
  memStage.replay = running and !redirectPipe and replayEX
  if advanceEX {
    memOp = exOp
    memWB = exWB
    if debugJump {
      memWB.fence_i = true
    }
    memStage.rvc = exStage.rvc
    memStage.watch = exStage.watch
    memTaken = alu.io_cmp_out != 0
    memStage.flush_pipe = debugJump or exStage.flush_pipe
    memStage.cause = exStage.cause
    memStage.slow_bypass = slowBypassEX
    const access = cacheCommand(cmd=exOp.mem_cmd)
    memStage.load = exWB.mem and access.read
    memStage.store = exWB.mem and access.write
    memStage.address = exStage.address
    memStage.instruction = exStage.instruction
    memStage.hls_or_dv = csr.io_status_dv != 0
    memStage.raw_inst = exStage.raw_inst
    memStage.wdata = alu.io_out
  }
  if advanceEX and (exALU.rxs2 or exWB.fp) and exWB.mem {
    // StoreGen repeats the low transfer unit across every bus lane.
    const mask = (1 << exStage.mem_size) - 1
    const source = if exWB.fp { fpStore } else { ex_rs[1] }
    mut storeData:Unsigned(bits=C.dLen) = 0
    for lane in 0..<(C.dLen/8) {
      const start = (lane & mask) << 3
      storeData#[(lane*8)..+8] = source#[start..+8]
    }
    memStage.rs2 = storeData
  }
  wbStage.valid = running and !killMEM
  wbStage.exception = running and memException and !redirectWB
  wbStage.replay = running and replayMEM and !redirectWB
  wbStage.flush_pipe = running and !killMEM and memStage.flush_pipe
  acceptedDiv = divRequestReady and divideRequest
  cacheBlocked = !dmemResponse.reqReady and !dmemResponse.perfGrant and (cacheBlocked or dataRequest or dmemResponse.s2Nack)
  retireProgress = wbStage.valid and !replayWB
  fencePending = (!killID and needsFence) or (memoryBusy and fencePending)
  const reserve = lateResult and wbWrite
  if lateWrite or reserve {
    const clear:U32 = if lateWrite { (1 << lateRd)#[0..<32] } else { 0 }
    const set:U32 = if reserve { (1 << wbRd)#[0..<32] } else { 0 }
    pendingWrites = (busyRegs & ~clear) | set
  }
  const issueDiv = divideRequest
  const killDiv = killMemory and acceptedDiv
  mut runDiv = C.useMulDiv
  if C.useMulDiv and C.mulDivClockGate {
    reg inFlight:Bool:[clock_pin=pipeClock] = false
    if issueDiv and divRequestReady {
      inFlight = true
    } elif killDiv or (divResponseValid and divReady) {
      inFlight = false
    }
    runDiv = issueDiv or inFlight or reset
  }
  if runDiv {
    const div = arithmetic.MulDiv<C=C, DIVIDE_ONLY=C.pipelinedMul>(clock=pipeClock, io_req_valid=U1(issueDiv), io_req_bits_fn=exALU.alu_fn#[0..<4], io_req_bits_dw=exALU.alu_dw, io_req_bits_in1=ex_rs[0], io_req_bits_in2=ex_rs[1], io_req_bits_tag=exRd, io_kill=U1(killDiv), io_resp_ready=U1(divReady))
    divRequestReady = div.io_req_ready != 0
    divResponseValid = div.io_resp_valid != 0
    divData = div.io_resp_bits_data
    divResponseRd = div.io_resp_bits_tag
  } else {
    divRequestReady = true
    divResponseValid = false
    divData = 0
    divResponseRd = 0
  }
  io_imem_might_request = U1(fetchMayRequest)
  imem.valid = redirectPipe
  imem.pc = redirectPC
  imem.speculative = !redirectWB
  imem.respReady = ibuf.fetchReady
  if C.clockGate {
    reg keepAwake:Bool = nil
    const inPipeline = exPCValid or memPCValid or wbStage.valid or wbStage.replay or wbStage.exception
    const pending = busyRegs != 0 or !divRequestReady
    const canDecode = csr.io_csr_stall == 0 and !paused
    const response = dmemResponse.respValid or dmemResponse.replayNext
    const wake = (canDecode and (imemResponse.respValid or ibuf.valid)) or response or (C.roccOpcodes != 0 and roccResp) or (C.vLen != 0 and vectorResp) or csr.interrupt
    keepAwake = reset or forceCoreClock or inPipeline or pending or wake
    active = reset or keepAwake or wake
  } else {
    active = true
  }
  staticPrediction = csr.staticPrediction
  flushBTB = csr.flushBTB
  rasAction = 0
  if C.nRAS > 0 and resolved and misalignedPC == 0 {
    const rd = memStage.instruction#[7..<12]
    const rs = memStage.instruction#[15..<20]
    const link = rd == 1 or rd == 5
    const push = link and (memOp.jal or memOp.jalr)
    const pop = memOp.jalr and (rs == 1 or rs == 5) and rd != rs
    rasAction = (U1(pop) << 1) | U1(push)
  }
  imem.btbUpdateValid = memStage.valid and !redirectWB and wrongNextPC and (!controlFlow or transferTaken)
  imem.btbUpdateTarget = redirectPC
  imem.btbUpdateIsValid = controlFlow
  imem.btbUpdateBrPc = if memStage.rvc { memStage.address } else { (memStage.address + 2)#[0..<C.xLen] }
  imem.bhtUpdateValid = resolved
  imem.bhtUpdateBranch = memOp.branch
  imem.bhtUpdateTaken = memTaken
  imem.flushIcache = wbStage.valid and wbControl.fence_i and !dmemResponse.s2Nack
  imem.progress = retireProgress
  dmem.valid = dataRequest
  dmem.address = alu.io_adder_out
  dmem.tag = (exRd << 1) | U1(exWB.fp)
  dmem.command = exOp.mem_cmd
  dmem.size = exStage.mem_size
  dmem.isSigned = exStage.instruction#[14] == 0
  dmem.virtual = csr.io_status_dv != 0
  dmem.kill = killMemory or memBreak
  dmem.storeData = memStage.rs2
  io_dmem_keep_clock_enabled = U1(ibuf.valid and decode.mem and csr.io_csr_stall == 0)
  io_ptw_status_prv = csr.io_status_prv
  satp = csr.satp
  sum = csr.sum
  mxr = csr.mxr
  dmem.privilege = csr.io_status_dprv
  io_ptw_status_debug = csr.io_status_debug
  io_ptw_status_cease = csr.io_status_cease
  io_ptw_status_wfi = csr.io_status_wfi
  io_ptw_status_isa = csr.io_status_isa
  io_ptw_status_dv = csr.io_status_dv
  io_ptw_status_v = U1(virtualMode)
  io_ptw_status_mpv = csr.io_status_mpv
  io_ptw_status_gva = csr.io_status_gva
  io_ptw_status_mpp = csr.io_status_mpp
  io_ptw_status_mpie = csr.io_status_mpie
  io_ptw_status_mie = csr.io_status_mie
  pmpTable = csr.pmpTable
  io_ptw_customCSRs_csrs_0_value = csr.io_customCSRs_0_value
  ingress = (cause=0, ctx=0, iaddr=0, ilastsize=0, iretire=0, itype=0, priv=0, time=0, tval=0)
  if C.enableTraceCoreIngress {
    // Capture the resolved MEM control flow alongside the retiring PC, including compressed jumps.
    reg flow:U4:[clock_pin=pipeClock] = nil
    if memPCValid {
      flow = if memOp.branch { 4 | U1(memTaken) } elif memOp.jal { 15 } elif memOp.jalr { 14 } else { 0 }
    }
    const kind = if csr.io_trace_0_exception != 0 { if csr.io_trace_0_interrupt != 0 { 2 } else { 1 } } elif csr.io_eret != 0 { 13 } else { flow }
    const asidBit = if C.xLen == 32 { 22 } else { 44 }
    ingress = (cause=(wbCause#[31] << (C.xLen - 1)) | wbCause#[0..<31], ctx=(csr.satp >> asidBit) & ((1 << C.asIdBits) - 1), iaddr=wbStage.address, ilastsize=csr.io_trace_0_valid & U1(wbStage.raw_inst#[0..<2] == 3), iretire=csr.io_trace_0_valid, itype=kind, priv=csr.io_trace_0_priv, time=csr.io_time#[0..<C.xLen], tval=trapValue)
  }
  trace.valid = csr.io_trace_0_valid
  trace.iaddr = csr.io_trace_0_iaddr
  trace.insn = csr.io_trace_0_insn
  trace.priv = csr.io_trace_0_priv
  trace.exception = csr.io_trace_0_exception
  trace.interrupt = csr.io_trace_0_interrupt
  trace.cause = csr.io_trace_0_cause
  trace.tval = csr.io_trace_0_tval
  io_trace_time = csr.io_time
  watchValid = if C.nBreakpoints > 0 { wbStage.watch } else { 0 }
  watchAction = csr.watchAction
  io_wfi = csr.io_status_wfi
}
