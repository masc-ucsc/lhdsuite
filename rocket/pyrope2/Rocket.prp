const performance = import("Performance")
const protection = import("PhysicalProtection")
const branchOffset = import("BranchDecode.offset")
const cacheCommand = import("CacheAccess.command")
const floating = import("FPU")
const configs = import("RocketConfig")
comptime const tiny = configs.tiny
const IDecode = import("IDecode.IDecode")
const ALU = import("ALU.ALU")
const CSRFile = import("CSRFile.CSRFile")
const IBuf = import("IBuf.IBuf")
const arithmetic = import("MulDiv")
const PlusArgTimeout_t = import("PlusArgTimeout.PlusArgTimeout")
const RegFile = import("RegFile.RegFile")

type WritebackControl = (fp:U1, mem:U1, div:U1, wxd:U1, csr:U3, fence_i:U1)
type MemoryOp = (branch:U1, jal:U1, jalr:U1, mem_cmd:U5, mul:U1)

pub mod Rocket<C=tiny>::[timecheck=false](
    `clock`:Clock, `reset`:U1, io_hartid:U1, io_interrupts_debug:U1, io_interrupts_mtip:U1, io_interrupts_msip:U1,
    io_interrupts_meip:U1, io_interrupts_seip:U1=0, localInterrupts:Unsigned(bits=C.localIRQBits)=0,
    fetchIndex:Unsigned(bits=C.bhtIndexBits)=0, io_imem_resp_valid:U1, io_imem_resp_bits_btb_taken:U1,
    io_imem_resp_bits_btb_bridx:U1, io_imem_resp_bits_pc:Unsigned(bits=C.xLen), io_imem_resp_bits_data:U32,
    io_imem_resp_bits_mask:U2, io_imem_resp_bits_xcpt_pf_inst:U1, io_imem_resp_bits_xcpt_gf_inst:U1,
    io_imem_resp_bits_xcpt_ae_inst:U1, io_imem_resp_bits_replay:U1, io_imem_gpa_valid:U1, io_imem_gpa_bits:U32,
    io_imem_npc:Unsigned(bits=C.xLen), io_imem_perf_acquire:U1, io_dmem_req_ready:U1, io_dmem_s2_nack:U1,
    io_dmem_resp_valid:U1, io_dmem_resp_bits_tag:U7, io_dmem_resp_bits_data:Unsigned(bits=C.dLen),
    io_dmem_resp_bits_replay:U1, io_dmem_resp_bits_has_data:U1,
    io_dmem_resp_bits_data_word_bypass:Unsigned(bits=C.dLen), io_dmem_replay_next:U1, io_dmem_s2_xcpt_ma_ld:U1,
    io_dmem_s2_xcpt_ma_st:U1, io_dmem_s2_xcpt_pf_ld:U1, io_dmem_s2_xcpt_pf_st:U1, io_dmem_s2_xcpt_ae_ld:U1,
    io_dmem_s2_xcpt_ae_st:U1, io_dmem_ordered:U1, io_dmem_perf_grant:U1, io_ptw_perf_pte_miss:U1,
    io_ptw_perf_pte_hit:U1, dataAcquire:U1=0, dataRelease:U1=0, iTLBMiss:U1=0, dTLBMiss:U1=0, l2TLBMiss:U1=0
) -> (
    staticPrediction:Bool@[], flushBTB:Bool@[], rasAction:U2@[], branchIndex:Unsigned(bits=C.bhtIndexBits)@[],
    io_imem_might_request:U1@[], io_imem_req_valid:U1@[], io_imem_req_bits_pc:Unsigned(bits=C.xLen)@[],
    io_imem_req_bits_speculative:U1@[], flushTLB:Bool@[], io_imem_resp_ready:U1@[], io_imem_btb_update_valid:U1@[],
    io_imem_btb_update_bits_target:Unsigned(bits=C.xLen)@[], io_imem_btb_update_bits_isValid:U1@[],
    io_imem_btb_update_bits_br_pc:Unsigned(bits=C.xLen)@[], io_imem_bht_update_valid:U1@[],
    io_imem_bht_update_bits_branch:U1@[], io_imem_bht_update_bits_taken:U1@[], io_imem_flush_icache:U1@[],
    io_imem_progress:U1@[], io_dmem_req_valid:U1@[], io_dmem_req_bits_addr:Unsigned(bits=C.xLen)@[],
    io_dmem_req_bits_tag:U7@[], io_dmem_req_bits_cmd:U5@[], io_dmem_req_bits_size:U2@[],
    io_dmem_req_bits_signed:U1@[], io_dmem_req_bits_dv:U1@[], io_dmem_s1_kill:U1@[],
    io_dmem_s1_data_data:Unsigned(bits=C.dLen)@[], io_dmem_keep_clock_enabled:U1@[], io_ptw_status_prv:U2@[],
    io_dmem_req_bits_dprv:U2@[], satp:Unsigned(bits=C.xLen)@[], sum:Bool@[], mxr:Bool@[],
    io_ptw_status_debug:U1@[], io_ptw_status_cease:U1@[], io_ptw_status_wfi:U1@[], io_ptw_status_isa:U32@[],
    io_ptw_status_dv:U1@[], io_ptw_status_v:U1@[], io_ptw_status_mpv:U1@[], io_ptw_status_gva:U1@[],
    io_ptw_status_mpp:U2@[], io_ptw_status_mpie:U1@[], io_ptw_status_mie:U1@[], pmpTable:protection.Entries@[],
    io_ptw_customCSRs_csrs_0_value:U32@[], io_trace_insns_0_valid:U1@[],
    io_trace_insns_0_iaddr:Unsigned(bits=C.xLen)@[], io_trace_insns_0_insn:U32@[], io_trace_insns_0_priv:U3@[],
    io_trace_insns_0_exception:U1@[], io_trace_insns_0_interrupt:U1@[],
    io_trace_insns_0_cause:Unsigned(bits=C.xLen)@[], io_trace_insns_0_tval:Unsigned(bits=C.xLen)@[],
    ingress:(iretire:U1, iaddr:Unsigned(bits=C.xLen), itype:U4, ilastsize:U1, priv:U4,
        ctx:Unsigned(bits=C.xLen), tval:Unsigned(bits=C.xLen), cause:Unsigned(bits=C.xLen), time:Unsigned(bits=C.xLen))@[],
    io_trace_time:U64@[], watchValid:Unsigned(bits=C.triggerSlots)@[], watchAction:Unsigned(bits=3*C.triggerSlots)@[], io_wfi:U1@[]
) {
  const running:U1 = ~`reset`
  wire active:Bool = nil
  wire pipeClock:Clock = nil
  if C.clockGate { pipeClock = Clock(clock_pin=`clock`, enable=active) }
  else { pipeClock = `clock` }
  reg paused:U1
  reg fetchMayRequest:U1
  reg exALU:(rxs2:U1, sel_alu2:U2, sel_alu1:U2, sel_imm:U3, alu_dw:U1, alu_fn:U6):[clock_pin=pipeClock] = nil
  reg exOp:MemoryOp:[clock_pin=pipeClock] = nil
  reg memOp:MemoryOp:[clock_pin=pipeClock] = nil
  reg exWB:WritebackControl:[clock_pin=pipeClock] = nil
  reg memWB:WritebackControl:[clock_pin=pipeClock] = nil
  reg wbControl:WritebackControl:[clock_pin=pipeClock] = nil
  reg exStage:(xcpt_interrupt:U1, valid:U1, rvc:U1, exception:U1, flush_pipe:U1, load_use:U1, cause:U32,
      replay:U1, address:Unsigned(bits=C.xLen), mem_size:U2, instruction:U32, raw_inst:U32,
      watch:Unsigned(bits=C.triggerSlots)):[clock_pin=pipeClock] = nil
  reg memStage:(xcpt_interrupt:U1, valid:U1, rvc:U1, exception:U1, replay:U1, flush_pipe:U1, cause:U32,
      slow_bypass:U1, load:U1, store:U1, address:Unsigned(bits=C.xLen), instruction:U32,
      hls_or_dv:U1, raw_inst:U32, wdata:Unsigned(bits=C.xLen), rs2:Unsigned(bits=C.dLen),
      watch:Unsigned(bits=C.triggerSlots)):[clock_pin=pipeClock] = nil
  reg memTaken:U1:[clock_pin=pipeClock]
  reg wbStage:(valid:U1, exception:U1, replay:U1, flush_pipe:U1, cause:U32, address:Unsigned(bits=C.xLen),
      hls_or_dv:U1, instruction:U32, raw_inst:U32, wdata:Unsigned(bits=C.xLen), watch:Unsigned(bits=C.triggerSlots)):[clock_pin=pipeClock] = nil
  reg fencePending:U1:[clock_pin=pipeClock]
  reg ex_bypass:[2]U1:[clock_pin=pipeClock] = nil
  reg ex_lsb:[2]U2:[clock_pin=pipeClock] = nil
  reg ex_msb:[2]Unsigned(bits=C.xLen - 2):[clock_pin=pipeClock] = nil
  reg acceptedDiv:U1:[clock_pin=pipeClock]
  reg pendingWrites:U32:[clock_pin=pipeClock]
  reg cacheBlocked:U1:[clock_pin=pipeClock]
  reg retireProgress:U1:[clock_pin=pipeClock]
  wire divRequestReady:U1 = nil
  wire divResponseValid:U1 = nil
  wire divResponseRd:U5 = nil
  wire virtualMode:U1 = nil
  wire flushFetch:U1 = nil
  wire decodeReady:U1 = nil
  const fetchFault = (io_imem_resp_bits_xcpt_pf_inst << 2) | (io_imem_resp_bits_xcpt_gf_inst << 1) | io_imem_resp_bits_xcpt_ae_inst
  const ibuf = IBuf<C>(clk=pipeClock, rst=`reset` != 0, kill=flushFetch, ready=decodeReady, fetchValid=io_imem_resp_valid,
      fetchPC=io_imem_resp_bits_pc, fetchData=io_imem_resp_bits_data, fetchFault=fetchFault, fetchReplay=io_imem_resp_bits_replay,
      index=fetchIndex, taken=io_imem_resp_bits_btb_taken, branchSlot=io_imem_resp_bits_btb_bridx)
  wire redirectWB:U1 = nil
  const id_raddr1 = ibuf.inst#[15..<20]
  const id_raddr2 = ibuf.inst#[20..<25]
  wire divData:Unsigned(bits=C.xLen) = nil
  const id_waddr = ibuf.inst#[7..<12]
  const exRd = exStage.instruction#[7..<12]
  const memRd = memStage.instruction#[7..<12]
  const wbRd = wbStage.instruction#[7..<12]
  const exWrites = exStage.valid & exWB.wxd & 1
  const memWrites = memStage.valid & memWB.wxd & 1
  cassert(!C.fastLoadByte or C.fastLoadWord)
  const loadBypass = if C.fastLoadByte { io_dmem_resp_bits_data#[0..<C.xLen] }
      elif C.fastLoadWord { io_dmem_resp_bits_data_word_bypass#[0..<C.xLen] } else { wbStage.wdata }
  const bypass:[4]Unsigned(bits=C.xLen) = [0, memStage.wdata, wbStage.wdata, loadBypass]
  mut ex_rs:[2]Unsigned(bits=C.xLen) = nil
  for i in 0..<2 {
    ex_rs[i] = if ex_bypass[i] != 0 { bypass[ex_lsb[i]] } else { (ex_msb[i] << 2) | ex_lsb[i] }
  }
  // RV immediates share bit 31 as the sign bit. Z immediates are unsigned.
  const inst = exStage.instruction
  const form = exALU.sel_imm
  mut imm:U32 = 0
  imm#[31] = U1(form != 5) & inst#[31]
  imm#[20..<31] = if form == 2 { inst#[20..<31] } elif imm#[31] != 0 { 0x7ff } else { 0 }
  imm#[12..<20] = if form == 2 or form == 3 { inst#[12..<20] } elif imm#[31] != 0 { 0xff } else { 0 }
  imm#[11] = match form {
    in (2, 5) { 0 } == 3 { inst#[20] } == 1 { inst#[7] } else { imm#[31] }
  }
  imm#[5..<11] = if form == 2 or form == 5 { 0 } else { inst#[25..<31] }
  imm#[1..<5] = match form {
    == 2 { 0 } in (0, 1) { inst#[8..<12] } == 5 { inst#[16..<20] } else { inst#[21..<25] }
  }
  imm#[0] = match form {
    == 0 { inst#[7] } == 4 { inst#[20] } == 5 { inst#[15] } else { 0 }
  }
  const signedImm:Unsigned(bits=C.xLen) = imm#sext[0..<32]#[0..<C.xLen]
  const alu1 = match exALU.sel_alu1 {
    == 1 { ex_rs[0] } == 2 { exStage.address } else { 0 }
  }
  const alu2 = match exALU.sel_alu2 {
    == 1 { if exStage.rvc != 0 { 2 } else { 4 } }
    == 2 { ex_rs[1] } == 3 { signedImm } else { 0 }
  }
  const divideRequest = exStage.valid & exWB.div & 1
  const exPCValid = exStage.valid | exStage.replay | exStage.xcpt_interrupt
  const loadMiss = wbControl.mem & (~io_dmem_resp_valid#[0]) & 1
  const slowBypassEX = U1(exOp.mem_cmd == 7 or exStage.mem_size < 2)
  const executeTrap = (exStage.xcpt_interrupt | exStage.exception) & 1
  const memPCValid = memStage.valid | memStage.replay | memStage.xcpt_interrupt
  const branchTaken = memOp.branch & memTaken
  const instB = branchOffset(inst=memStage.instruction)
  const instJ = (memStage.instruction#[31] << 20) | (memStage.instruction#[12..<20] << 12) |
      (memStage.instruction#[20] << 11) | (memStage.instruction#[21..<31] << 1)
  const displacement:Unsigned(bits=C.xLen) = if branchTaken != 0 { instB#sext[0..<13]#[0..<C.xLen] }
      elif memOp.jal != 0 { instJ#sext[0..<21]#[0..<C.xLen] } elif memStage.rvc != 0 { 2 } else { 4 }
  const pcRelativeTarget = (memStage.address + displacement)#[0..<C.xLen]
  const rawTarget = if memOp.jalr != 0 { memStage.wdata } else { pcRelativeTarget }
  const nextPC = rawTarget#[1..<C.xLen] << 1
  const controlFlow = memOp.branch | memOp.jalr | memOp.jal
  const transferTaken = branchTaken | memOp.jalr | memOp.jal
  const replayPort = memWrites & io_dmem_replay_next & 1
  const replayMEM = (replayPort | memStage.replay) & 1
  const wbMemory = wbStage.valid & wbControl.mem
  const dataFault = io_dmem_s2_xcpt_pf_st | io_dmem_s2_xcpt_pf_ld | io_dmem_s2_xcpt_ae_st |
      io_dmem_s2_xcpt_ae_ld | io_dmem_s2_xcpt_ma_st | io_dmem_s2_xcpt_ma_ld
  const wbException:U1 = wbStage.exception | (wbMemory & dataFault)
  const wbCause:U32 = if wbStage.exception != 0 { wbStage.cause }
      elif (wbMemory & io_dmem_s2_xcpt_pf_st) != 0 { 15 } elif (wbMemory & io_dmem_s2_xcpt_pf_ld) != 0 { 13 }
      elif (wbMemory & io_dmem_s2_xcpt_ae_st) != 0 { 7 } elif (wbMemory & io_dmem_s2_xcpt_ae_ld) != 0 { 5 }
      elif (wbMemory & io_dmem_s2_xcpt_ma_st) != 0 { 6 } else { 4 }
  const wbWrites:U1 = wbStage.valid & wbControl.wxd & 1
  const lateResult = wbControl.div | loadMiss
  const replayWB:U1 = (io_dmem_s2_nack | wbStage.replay) & 1
  const responseFP = io_dmem_resp_bits_tag#[0]
  const responseInt = ~responseFP#[0]
  const responseRd = io_dmem_resp_bits_tag#[1..<6]
  const dataResponse = io_dmem_resp_valid & io_dmem_resp_bits_has_data
  const replayLoad:U1 = dataResponse & io_dmem_resp_bits_replay & responseInt
  const divReady = ~replayLoad & ~wbWrites
  const retire = wbStage.valid & ~replayWB & ~wbException
  const wbWrite = retire & wbControl.wxd & 1

  const dataTrap = ~wbStage.exception
  const addressTrap = dataTrap | U1(wbStage.cause in (1, 3, 12, 20))
  const trapValue = if wbException != 0 and (addressTrap != 0 or wbStage.cause == 2) { wbStage.wdata } else { 0 }
  const guestAddress = if wbStage.exception != 0 and wbStage.cause == 20 { io_imem_gpa_bits } else { 0 }
  const instruction = if wbStage.raw_inst#[0..<2] == 3 { wbStage.instruction#[16..<32] << 16 } else { 0 }
  wire retireFPFlags:U5 = nil
  wire perfID:U18 = nil
  wire perfPipe:U11 = nil
  wire perfAdvance:U3 = nil
  const csr = CSRFile<C>(`clock`=pipeClock, `reset`=`reset`, io_ungated_clock=`clock`, fpFlags=retireFPFlags,
      perfID=perfID, perfPipe=perfPipe, perfAdvance=perfAdvance,
      perfMem=(l2TLBMiss << 5) | (dTLBMiss << 4) | (iTLBMiss << 3) | (dataRelease << 2) | (dataAcquire << 1) | io_imem_perf_acquire,
      io_hartid=io_hartid, io_interrupts_debug=io_interrupts_debug, io_interrupts_mtip=io_interrupts_mtip,
      io_interrupts_msip=io_interrupts_msip, io_interrupts_meip=io_interrupts_meip, io_interrupts_seip=io_interrupts_seip,
      localInterrupts=localInterrupts, io_decode_0_inst=ibuf.inst, io_pc=wbStage.address, io_retire=retire,
      io_rw_addr=wbStage.instruction#[20..<32], io_rw_cmd=wbControl.csr & ((wbStage.valid << 2) | 3), io_rw_wdata=wbStage.wdata,
      io_exception=wbException, io_cause=wbCause, io_tval=trapValue, io_htval=guestAddress,
      io_gva=wbException & ((addressTrap & virtualMode) | (dataTrap & wbStage.hls_or_dv)),
      triggerPC=ibuf.pc, triggerEA=memStage.wdata, io_inst_0=instruction | wbStage.raw_inst#[0..<16])
  virtualMode = csr.io_status_v
  const busyRegs = pendingWrites#[1..<32] << 1
  flushTLB = C.useVM and wbStage.valid != 0 and wbStage.exception == 0 and (wbStage.instruction & 0xfe007fff) == 0x12000073
  const dataRequest = exStage.valid & exWB.mem & 1
  const alu = ALU<C>(io_dw=exALU.alu_dw, io_fn=exALU.alu_fn, io_in1=alu1, io_in2=alu2)
  const memoryBusy = ((~io_dmem_ordered#[0]) | dataRequest) & 1
  const wrongNextPC = if exPCValid != 0 { U1(nextPC != exStage.address) } else {
    U1((ibuf.valid | io_imem_resp_valid) == 0 or nextPC != ibuf.pc)
  }
  const redirect = if C.btbEntries > 0 { wrongNextPC } else { transferTaken }
  const redirectPipe:U1 = redirectWB | (memStage.valid & ~memStage.exception & redirect)
  flushFetch = redirectPipe
  const firstFetchTrap = csr.triggerTrap#[2] != 0 or ibuf.firstFault != 0
  const secondFetchTrap = ibuf.secondFault != 0
  const fetchTrap = firstFetchTrap or secondFetchTrap
  // Exception packets can carry stale I-cache data. Decode no operation for them.
  const decode = IDecode<C>(inst=if fetchTrap { 0 } else { ibuf.inst })
  const csrAccess = U1(decode.csr == 5 or decode.csr == 6 or decode.csr == 7)
  const systemInstruction = U1(decode.csr == 4)
  const csrReadOnly = U1((decode.csr == 6 or decode.csr == 7) and id_raddr1 == 0)
  const csrCommand = if (systemInstruction & decode.mem) != 0 { 0 }
      elif csrReadOnly != 0 { 2 } else { decode.csr }
  const badReg = if C.useRVE {
    (decode.rxs1 & id_raddr1#[4]) | (decode.rxs2 & id_raddr2#[4]) | (decode.wxd & id_waddr#[4])
  } else { 0 }
  const csrWrite = ~csrReadOnly & csr.io_decode_0_write_illegal
  const system = ~ibuf.rvc & systemInstruction
  const badFP = decode.fp != 0 and (!csr.fpEnabled or (decode.fpDouble != 0 and csr.io_status_isa#[3] == 0) or
      (decode.fpRound != 0 and ibuf.inst#[12..<15] == 7 and csr.io_fcsr_rm > 4))
  const illegalInstruction = U1(badFP) | ~decode.legal | badReg | ((decode.mul | decode.div) & ~csr.io_status_isa#[12]) |
      (decode.amo & ~csr.io_status_isa#[0]) | (ibuf.rvc & ~csr.io_status_isa#[2]) |
      (csrAccess & (csr.io_decode_0_read_illegal | csrWrite)) | (system & csr.io_decode_0_system_illegal)
  const virtualInstruction = decode.legal & ((csrAccess & ~csrWrite & csr.io_decode_0_virtual_access_illegal) |
      (system & csr.io_decode_0_virtual_system_illegal))
  const needsFence = decode.fence | (decode.amo & ibuf.inst#[26])
  const waitFence = memoryBusy & ((decode.amo & ibuf.inst#[25]) | decode.fence_i | (fencePending & decode.mem))
  const decodeTrap:U1 = csr.io_interrupt | csr.triggerDebug#[2] | U1(fetchTrap) | virtualInstruction | illegalInstruction
  const fault = if ibuf.firstFault != 0 { ibuf.firstFault } else { ibuf.secondFault }
  const decodeCause:U32 = if csr.io_interrupt != 0 { csr.io_interrupt_cause#[0..<32] }
      elif csr.triggerDebug#[2] != 0 { 14 } elif csr.triggerTrap#[2] != 0 { 3 }
      elif fault#[2] != 0 { 12 } elif fault#[1] != 0 { 20 } elif fault#[0] != 0 { 1 }
      elif virtualInstruction != 0 { 22 } else { 2 }
  const rawInstruction:U32 = if ibuf.rvc != 0 { ibuf.raw#[0..<16] } else { ibuf.raw }
  const blockedEX = (exWB.mem & ~io_dmem_req_ready) | (exWB.div & ~divRequestReady) | (loadMiss & exStage.load_use)
  const replayEX = exStage.replay | (exStage.valid & blockedEX)
  const killEX:U1 = redirectPipe | replayEX | ~exStage.valid
  const misalignedPC = (~csr.io_status_isa#[2..<3]) & nextPC#[1..<2] & 1
  mut wbData = if memStage.exception == 0 and (memOp.jalr ^ misalignedPC) != 0 { pcRelativeTarget } else { memStage.wdata }
  if C.pipelinedMul {
    const issue = (exStage.valid & exOp.mul) != 0
    const write = (memStage.valid & memOp.mul) != 0 and memStage.exception == 0
    if !C.mulDivClockGate or issue or write {
      const product = arithmetic.pipelined<C.xLen>(clk=pipeClock, issue=issue, fn=exALU.alu_fn#[0..<2],
          word=exALU.alu_dw == 0, a=ex_rs[0], b=ex_rs[1])
      if write { wbData = product }
    }
  }

  const debugBreak = (memStage.load & csr.triggerDebug#[0]) | (memStage.store & csr.triggerDebug#[1])
  const memBreak = debugBreak | (memStage.load & csr.triggerTrap#[0]) | (memStage.store & csr.triggerTrap#[1])
  const earlierTrap = memStage.xcpt_interrupt | memStage.exception
  const memException = earlierTrap | (memStage.valid & (misalignedPC | memBreak))
  const memCause:U32 = if earlierTrap != 0 { memStage.cause } elif (memStage.valid & misalignedPC) != 0 { 0 }
      elif debugBreak != 0 { 14 } else { 3 }
  const killMemory = replayPort | redirectWB | memStage.exception | ~memStage.valid
  const killMEM:U1 = killMemory | memException
  redirectWB = replayWB | wbException | csr.io_eret | wbStage.flush_pipe
  const lateRd = if replayLoad != 0 { responseRd } else { divResponseRd }
  const lateWrite = replayLoad | (divReady & divResponseValid)
  const writeRF = wbWrite | lateWrite
  const writeRd = if lateWrite != 0 { lateRd } else { wbRd }
  mut fpResult:Unsigned(bits=C.xLen) = 0
  mut fpStore:Unsigned(bits=C.dLen) = 0
  mut outstandingFP = false
  mut fpFlags:U5 = 0
  const fpResponse = (dataResponse & responseFP) != 0
  // ID observes the load scoreboard, EX reads store data, and WB commits.
  const fpActive = ((ibuf.valid & decode.fp) | (exStage.valid & exWB.fp) | (wbStage.valid & wbControl.fp)) != 0 or fpResponse
  const forceCoreClock = C.clockGate and csr.io_customCSRs_0_value#[2] != 0
  const enableFP = C.fLen > 0 and (!C.fpuClockGate or forceCoreClock or fpActive)
  if enableFP {
    (fpResult=intResult, fpStore=storeData, fpFlags=flags, outstandingFP=pending) =
        floating.FPU<C>(clk=pipeClock, rst=`reset` != 0, inst=wbStage.instruction, commit=(wbControl.fp & retire) != 0,
        x=wbStage.wdata, frm=csr.io_fcsr_rm, storeRs=exStage.instruction#[20..<25], response=fpResponse,
        tag=responseRd, loadData=io_dmem_resp_bits_data)
  }
  retireFPFlags = fpFlags
  // A store reads in EX; wait for older FP writes. Serialize around loads
  // so a delayed DCache response cannot be overtaken by another FP write.
  const loadAhead = (exStage.valid & exWB.fp & exWB.mem) | (memStage.valid & memWB.fp & memWB.mem) | (wbStage.valid & wbControl.fp & wbControl.mem)
  const storeID = ibuf.inst#[0..<7] == 0x27
  const writerAhead = (exStage.valid & exWB.fp) | (memStage.valid & memWB.fp)
  const fpWait = enableFP and decode.fp != 0 and (outstandingFP or loadAhead != 0 or (storeID and writerAhead != 0))
  const writeData = if dataResponse != 0 and responseInt != 0 { io_dmem_resp_bits_data#[0..<C.xLen] }
      elif lateWrite != 0 { divData } elif wbControl.fp != 0 { fpResult } elif wbControl.csr != 0 { csr.io_rw_rdata } else { wbStage.wdata }
  comptime const regBits = if C.useRVE { 4 } else { 5 }
  const rf = RegFile<XLEN=C.xLen, RegBits=regBits>(clk=pipeClock, rs1=id_raddr1#[0..<regBits],
      rs2=id_raddr2#[0..<regBits], rd=writeRd#[0..<regBits], write=writeRF != 0, data=writeData)
  const operands:[2]Unsigned(bits=C.xLen) = [rf.a, rf.b]
  const hazardRegs:[3]U5 = [id_raddr1, id_raddr2, id_waddr]
  const hazardEnabled:[3]U1 = [decode.rxs1, decode.rxs2, decode.wxd]
  mut scoreboardHazard:U1 = 0
  mut matchEX:U1 = 0
  mut matchMEM:U1 = 0
  mut matchWB:U1 = 0
  for i in 0..<3 {
    const r = hazardRegs[i]
    if hazardEnabled[i] != 0 and r != 0 {
      scoreboardHazard |= U1(busyRegs#[r] != 0 and !(lateWrite != 0 and lateRd == r))
      matchEX |= U1(exRd == r)
      matchMEM |= U1(memRd == r)
      matchWB |= U1(wbRd == r)
    }
  }
  const slowLoad = if !C.fastLoadWord { 1 } elif C.fastLoadByte { 0 } else { memStage.slow_bypass }
  const exCannotBypass = U1(exWB.csr != 0) | exOp.jalr | exWB.mem | exOp.mul | exWB.div | exWB.fp
  const memCannotBypass = U1(memWB.csr != 0) | (memWB.mem & slowLoad) | memOp.mul | memWB.div | memWB.fp
  const hazardEX = exStage.valid & exWB.wxd & matchEX & exCannotBypass
  const hazardMEM = memStage.valid & memWB.wxd & matchMEM & memCannotBypass
  const hazardWB = wbStage.valid & wbControl.wxd & matchWB & lateResult
  const loadUse = memStage.valid & memWB.wxd & matchMEM & memWB.mem
  const pipelineBusy = exStage.valid | memStage.valid | wbStage.valid
  const divideBusy = divideRequest | U1(divRequestReady == 0 and (divResponseValid == 0 or wbWrites != 0))
  const dataHazard = hazardEX | hazardMEM | hazardWB | scoreboardHazard
  const dBlocked = cacheBlocked & ~io_dmem_perf_grant
  const stallID = U1(fpWait) | dataHazard | (csr.io_singleStep & pipelineBusy) | (decode.div & divideBusy) |
      (decode.mem & dBlocked) | waitFence | csr.io_csr_stall | paused
  decodeReady = U1(active) & ~stallID#[0]
  const killID:U1 = U1(ibuf.valid == 0) | ibuf.replay | redirectPipe | stallID | csr.io_interrupt
  const resumePC = if replayWB != 0 { wbStage.address } else { nextPC }
  const redirectPC = if (wbException | csr.io_eret) != 0 { csr.io_evec } else { resumePC }
  const resolved = memStage.valid & ~memStage.exception & ~redirectWB
  const flushMEM = memStage.valid & memStage.flush_pipe
  const advanceEX = exPCValid != 0 and flushMEM == 0
  if C.haveBasicCounters and C.nPerfCounters > 0 {
    perfID = performance.classify<C>(inst=ibuf.inst, mem=decode.mem, fp=decode.fp, amo=decode.amo, csr=decode.csr,
        wxd=decode.wxd, branch=decode.branch, jal=decode.jal, jalr=decode.jalr, mulDiv=decode.mul | decode.div)
    perfAdvance = (memPCValid << 2) | (exPCValid << 1) | ~killID
    reg lastResponse:U1:[clock_pin=pipeClock] = nil
    const iBlocked:U1 = ~(io_imem_resp_valid | lastResponse)#[0]
    lastResponse = io_imem_resp_valid
    mut prediction:U1 = 0
    if C.btbEntries > 0 {
      reg exTaken:U1:[clock_pin=pipeClock] = nil
      reg predicted:U1:[clock_pin=pipeClock] = nil
      if killID == 0 { exTaken = ibuf.predictedTaken }
      if advanceEX { predicted = exTaken }
      prediction = predicted
    }
    const wrongDirection:U1 = memOp.branch & (memTaken ^ prediction)
    const redirectMEM = memStage.valid & ~memStage.exception & redirect
    const loadWait = (hazardEX & exWB.mem) | (hazardMEM & memWB.mem) | (hazardWB & wbControl.mem)
    const csrWait = (hazardEX & U1(exWB.csr != 0)) | (hazardMEM & U1(memWB.csr != 0)) | (hazardWB & U1(wbControl.csr != 0))
    mut stalls:U11 = (replayWB << 8) | (wbStage.flush_pipe << 7) | ((redirectMEM & controlFlow & ~wrongDirection & ~iBlocked) << 6) |
        ((redirectMEM & wrongDirection) << 5) | ((decode.mem & dBlocked) << 4) | (iBlocked << 3) |
        (csrWait << 2) | (scoreboardHazard << 1) | loadWait
    if C.useMulDiv {
      stalls#[9] = (hazardEX & (exWB.div | exOp.mul)) | (hazardMEM & (memWB.div | memOp.mul)) | (hazardWB & wbControl.div)
    }
    if C.fLen > 0 {
      stalls#[(if C.useMulDiv { 10 } else { 9 })] = U1(fpWait) | (hazardEX & exWB.fp) | (hazardMEM & memWB.fp) | (hazardWB & wbControl.fp)
    }
    perfPipe = stalls
  } else {
    perfID = 0
    perfPipe = 0
    perfAdvance = 0
  }
  const debugJump = exOp.jalr & csr.io_status_debug & 1
  const endPause = U1(csr.io_time#[0..<5] == 0) | csr.io_inhibit_cycle | redirectPipe
  const startPause = ~killID & decode.fence & U1(ibuf.inst#[20..<24] == 0)
  paused = running & U1(endPause == 0) & (startPause | paused)
  fetchMayRequest = exPCValid | memPCValid | csr.io_customCSRs_0_value#[1]
  if killID == 0 {
    exWB.fp = decode.fp
    exOp.branch = decode.branch
    exOp.jal = decode.jal
    exOp.jalr = decode.jalr
    exALU.rxs2 = decode.rxs2
    exALU.sel_alu2 = if decodeTrap != 0 { U1(secondFetchTrap and !firstFetchTrap) } else { decode.sel_alu2 }
    exALU.sel_alu1 = if decodeTrap == 0 { decode.sel_alu1 } elif fetchTrap { 2 } else { 1 }
    exALU.sel_imm = decode.sel_imm
    exALU.alu_dw = ((decodeTrap | decode.alu_dw) & 1)
    exALU.alu_fn = if decodeTrap != 0 { 0 } else { decode.alu_fn }
    exWB.mem = decode.mem
    exOp.mem_cmd = if decode.mem_cmd == 20 and virtualMode != 0 { 21 } else { decode.mem_cmd }
    exOp.mul = decode.mul & ~decodeTrap
    exWB.div = decode.div & ~decodeTrap
    exWB.wxd = decode.wxd
    exWB.csr = csrCommand
    exWB.fence_i = decode.fence_i
    exStage.rvc = (decodeTrap & U1(secondFetchTrap)) | ibuf.rvc
    exStage.flush_pipe = decode.fence_i | systemInstruction | (csrAccess & ~csrReadOnly & csr.io_decode_0_write_flush)
    exStage.load_use = loadUse
    exStage.mem_size = match decode.mem_cmd {
      in (5,20,21,22) { (U1(id_raddr2 != 0) << 1) | U1(id_raddr1 != 0) }
      else { ibuf.inst#[12..<14] }
    }
    // Each operand saves either its register value or a two-bit forwarding selector.
    for i in 0..<2 {
      const src = hazardRegs[i]
      const fromEX = exWrites != 0 and exRd == src
      const fromMEM = memWrites != 0 and memRd == src
      const forward = src == 0 or fromEX or fromMEM
      const select:U2 = if src == 0 { 0 } elif fromEX { 1 } elif fromMEM and memWB.mem == 0 { 2 } else { 3 }
      const readRF = hazardEnabled[i] != 0 and !forward
      const trapInst = i == 0 and (illegalInstruction | virtualInstruction) != 0
      ex_bypass[i] = U1(forward and !trapInst)
      ex_lsb[i] = if trapInst { rawInstruction#[0..<2] } elif readRF { operands[i]#[0..<2] } else { select }
      if trapInst { ex_msb[i] = rawInstruction#[2..<32] }
      elif readRF { ex_msb[i] = operands[i]#[2..<C.xLen] }
    }
  }

  if memPCValid != 0 {
    wbControl = memWB
    wbStage.cause = memCause
    wbStage.address = memStage.address
    wbStage.hls_or_dv = memStage.hls_or_dv
    wbStage.instruction = memStage.instruction
    wbStage.raw_inst = memStage.raw_inst
    wbStage.wdata = wbData
    wbStage.watch = memStage.watch | (if memStage.load != 0 { csr.watchLoad } else { 0 }) | (if memStage.store != 0 { csr.watchStore } else { 0 })
  }
  exStage.xcpt_interrupt = running & ~redirectPipe & ibuf.valid & csr.io_interrupt
  exStage.valid = running & ~killID
  if (~killID | csr.io_interrupt | ibuf.replay) != 0 {
    exStage.cause = decodeCause
    exStage.address = ibuf.pc
    exStage.instruction = ibuf.inst
    exStage.raw_inst = ibuf.raw
    exStage.watch = csr.watchFetch
  }
  exStage.exception = running & ~killID & decodeTrap
  exStage.replay = running & ~redirectPipe & ibuf.valid & ibuf.replay
  memStage.xcpt_interrupt = running & ~redirectPipe & exStage.xcpt_interrupt
  memStage.valid = running & ~killEX

  branchIndex = 0
  if C.bhtEntries > 0 {
    reg exIndex:Unsigned(bits=C.bhtIndexBits):[clock_pin=pipeClock] = nil
    reg memIndex:Unsigned(bits=C.bhtIndexBits):[clock_pin=pipeClock] = nil
    if killID == 0 { exIndex = ibuf.prediction }
    if advanceEX { memIndex = exIndex }
    branchIndex = memIndex
  }
  memStage.exception = running & ~killEX & executeTrap
  memStage.replay = running & ~redirectPipe & replayEX
  if advanceEX {
    memOp = exOp
    memWB = exWB
    if debugJump != 0 { memWB.fence_i = 1 }
    memStage.rvc = exStage.rvc
    memStage.watch = exStage.watch
    memTaken = alu.io_cmp_out
    memStage.flush_pipe = (debugJump | exStage.flush_pipe) & 1
    memStage.cause = exStage.cause
    memStage.slow_bypass = slowBypassEX
    const access = cacheCommand(cmd=exOp.mem_cmd)
    memStage.load = exWB.mem & access.read
    memStage.store = exWB.mem & access.write
    memStage.address = exStage.address
    memStage.instruction = exStage.instruction
    memStage.hls_or_dv = csr.io_status_dv
    memStage.raw_inst = exStage.raw_inst
    memStage.wdata = alu.io_out
  }
  if advanceEX and (exALU.rxs2 | exWB.fp) != 0 and exWB.mem != 0 {
    // StoreGen repeats the low transfer unit across every bus lane.
    const mask = (1 << exStage.mem_size) - 1
    const source = if exWB.fp != 0 { fpStore } else { ex_rs[1] }
    mut storeData:Unsigned(bits=C.dLen) = 0
    for lane in 0..<(C.dLen / 8) {
      const start = (lane & mask) << 3
      storeData#[(lane * 8)..+8] = source#[start..+8]
    }
    memStage.rs2 = storeData
  }
  wbStage.valid = running & ~killMEM
  wbStage.exception = running & memException & ~redirectWB
  wbStage.replay = running & replayMEM & ~redirectWB
  wbStage.flush_pipe = running & ~killMEM & memStage.flush_pipe
  acceptedDiv = divRequestReady & divideRequest
  cacheBlocked = ~io_dmem_req_ready & ~io_dmem_perf_grant & (cacheBlocked | dataRequest | io_dmem_s2_nack)
  retireProgress = wbStage.valid & ~replayWB
  if `reset` != 0 {
    fencePending = 0
    pendingWrites = 0
  } else {
    fencePending = (~killID & needsFence) | (memoryBusy & fencePending)
    const reserve = lateResult & wbWrite
    if (lateWrite | reserve) != 0 {
      const clear:U32 = if lateWrite != 0 { (1 << lateRd)#[0..<32] } else { 0 }
      const set:U32 = if reserve != 0 { (1 << wbRd)#[0..<32] } else { 0 }
      pendingWrites = (busyRegs & ~clear) | set
    }
  }
  const issueDiv = divideRequest != 0
  const killDiv = (killMemory & acceptedDiv) != 0
  mut runDiv = C.useMulDiv
  if C.useMulDiv and C.mulDivClockGate {
    reg inFlight:Bool:[clock_pin=pipeClock] = nil
    if `reset` != 0 { inFlight = false }
    elif issueDiv and divRequestReady != 0 { inFlight = true }
    elif killDiv or (divResponseValid & divReady) != 0 { inFlight = false }
    runDiv = issueDiv or inFlight or `reset` != 0
  }
  if runDiv {
    const div = arithmetic.MulDiv<C=C,DIVIDE_ONLY=C.pipelinedMul>(`clock`=pipeClock, `reset`=`reset`, io_req_valid=U1(issueDiv),
        io_req_bits_fn=exALU.alu_fn#[0..<4], io_req_bits_dw=exALU.alu_dw,
        io_req_bits_in1=ex_rs[0], io_req_bits_in2=ex_rs[1], io_req_bits_tag=exRd,
        io_kill=U1(killDiv), io_resp_ready=divReady)
    divRequestReady = div.io_req_ready
    divResponseValid = div.io_resp_valid
    divData = div.io_resp_bits_data
    divResponseRd = div.io_resp_bits_tag
  } else {
    divRequestReady = 1
    divResponseValid = 0
    divData = 0
    divResponseRd = 0
  }
  PlusArgTimeout_t::[name=PlusArgTimeout](`clock` = pipeClock, `reset` = `reset`, io_count = csr.io_time#[0..<32])
  io_imem_might_request = fetchMayRequest
  io_imem_req_valid = redirectPipe
  io_imem_req_bits_pc = redirectPC
  io_imem_req_bits_speculative = ~redirectWB
  io_imem_resp_ready = ibuf.fetchReady
  if C.clockGate {
    reg keepAwake:Bool = nil
    const inPipeline = (exPCValid | memPCValid | wbStage.valid | wbStage.replay | wbStage.exception) != 0
    const pending = busyRegs != 0 or divRequestReady == 0
    const canDecode = csr.io_csr_stall == 0 and paused == 0
    const response = io_dmem_resp_valid != 0 or io_dmem_replay_next != 0
    const wake = (canDecode and (io_imem_resp_valid != 0 or ibuf.valid != 0)) or response or csr.io_interrupt != 0
    keepAwake = `reset` != 0 or forceCoreClock or inPipeline or pending or wake
    active = `reset` != 0 or keepAwake or wake
  } else { active = true }
  staticPrediction = csr.staticPrediction
  flushBTB = csr.flushBTB
  rasAction = 0
  if C.nRAS > 0 and resolved != 0 and misalignedPC == 0 {
    const rd = memStage.instruction#[7..<12]
    const rs = memStage.instruction#[15..<20]
    const link = rd == 1 or rd == 5
    const push = link and (memOp.jal != 0 or memOp.jalr != 0)
    const pop = memOp.jalr != 0 and (rs == 1 or rs == 5) and rd != rs
    rasAction = (U1(pop) << 1) | U1(push)
  }
  io_imem_btb_update_valid = memStage.valid & ~redirectWB & wrongNextPC & (~controlFlow | transferTaken)
  io_imem_btb_update_bits_target = redirectPC
  io_imem_btb_update_bits_isValid = controlFlow
  io_imem_btb_update_bits_br_pc = if memStage.rvc != 0 { memStage.address } else { (memStage.address+2)#[0..<C.xLen] }
  io_imem_bht_update_valid = resolved
  io_imem_bht_update_bits_branch = memOp.branch
  io_imem_bht_update_bits_taken = memTaken
  io_imem_flush_icache = wbStage.valid & wbControl.fence_i & ~io_dmem_s2_nack
  io_imem_progress = retireProgress
  io_dmem_req_valid = dataRequest
  io_dmem_req_bits_addr = alu.io_adder_out
  io_dmem_req_bits_tag = (exRd << 1) | exWB.fp
  io_dmem_req_bits_cmd = exOp.mem_cmd
  io_dmem_req_bits_size = exStage.mem_size
  io_dmem_req_bits_signed = ~exStage.instruction#[14]
  io_dmem_req_bits_dv = csr.io_status_dv
  io_dmem_s1_kill = killMemory | memBreak
  io_dmem_s1_data_data = memStage.rs2
  io_dmem_keep_clock_enabled = ibuf.valid & decode.mem & ~csr.io_csr_stall
  io_ptw_status_prv = csr.io_status_prv
  satp = csr.satp
  sum = csr.sum
  mxr = csr.mxr
  io_dmem_req_bits_dprv = csr.io_status_dprv
  io_ptw_status_debug = csr.io_status_debug
  io_ptw_status_cease = csr.io_status_cease
  io_ptw_status_wfi = csr.io_status_wfi
  io_ptw_status_isa = csr.io_status_isa
  io_ptw_status_dv = csr.io_status_dv
  io_ptw_status_v = virtualMode
  io_ptw_status_mpv = csr.io_status_mpv
  io_ptw_status_gva = csr.io_status_gva
  io_ptw_status_mpp = csr.io_status_mpp
  io_ptw_status_mpie = csr.io_status_mpie
  io_ptw_status_mie = csr.io_status_mie
  pmpTable = csr.pmpTable
  io_ptw_customCSRs_csrs_0_value = csr.io_customCSRs_0_value
  ingress = (iretire=0, iaddr=0, itype=0, ilastsize=0, priv=0, ctx=0, tval=0, cause=0, time=0)
  if C.enableTraceCoreIngress {
    // Capture the resolved MEM control flow alongside the retiring PC, including compressed jumps.
    reg flow:U4:[clock_pin=pipeClock] = nil
    if memPCValid != 0 {
      flow = if memOp.branch != 0 { 4 | memTaken } elif memOp.jal != 0 { 15 } elif memOp.jalr != 0 { 14 } else { 0 }
    }
    const kind = if csr.io_trace_0_exception != 0 { if csr.io_trace_0_interrupt != 0 { 2 } else { 1 } }
        elif csr.io_eret != 0 { 13 } else { flow }
    const asidBit = if C.xLen == 32 { 22 } else { 44 }
    ingress = (iretire=csr.io_trace_0_valid, iaddr=wbStage.address, itype=kind,
        ilastsize=csr.io_trace_0_valid & U1(wbStage.raw_inst#[0..<2] == 3), priv=csr.io_trace_0_priv,
        ctx=(csr.satp >> asidBit) & ((1 << C.asIdBits)-1), tval=trapValue,
        cause=(wbCause#[31] << (C.xLen-1)) | wbCause#[0..<31], time=csr.io_time#[0..<C.xLen])
  }
  io_trace_insns_0_valid = csr.io_trace_0_valid
  io_trace_insns_0_iaddr = csr.io_trace_0_iaddr
  io_trace_insns_0_insn = csr.io_trace_0_insn
  io_trace_insns_0_priv = csr.io_trace_0_priv
  io_trace_insns_0_exception = csr.io_trace_0_exception
  io_trace_insns_0_interrupt = csr.io_trace_0_interrupt
  io_trace_insns_0_cause = csr.io_trace_0_cause
  io_trace_insns_0_tval = csr.io_trace_0_tval
  io_trace_time = csr.io_time
  watchValid = if C.nBreakpoints > 0 { wbStage.watch } else { 0 }
  watchAction = csr.watchAction
  io_wfi = csr.io_status_wfi
}
