const itlb = import("TileTranslation.port")
const tiny = import("RocketConfig.tiny")
const predecode = import("BranchDecode.packet")
const BranchPredictor = import("BranchPredictor.BranchPredictor")
const ICache = import("ICache.ICache")
const ShiftQueue = import("ShiftQueue.ShiftQueue")
const attributes = import("PhysicalMap.attributes")

pub mod Frontend<C=tiny>::[timecheck=false](`clock`:Clock, `reset`:U1, auto_icache_master_out_a_ready:U1, auto_icache_master_out_d_valid:U1, auto_icache_master_out_d_bits_opcode:U4, auto_icache_master_out_d_bits_data:Unsigned(bits=C.dLen), auto_icache_master_out_d_bits_corrupt:U1, staticPrediction:Bool=false, flushBTB:Bool=false, rasAction:U2=0, branchIndex:Unsigned(bits=C.bhtIndexBits)=0, io_cpu_req_valid:U1, io_cpu_req_bits_pc:Unsigned(bits=C.xLen), io_cpu_req_bits_speculative:U1, io_cpu_resp_ready:U1, io_cpu_btb_update_valid:U1, io_cpu_btb_update_bits_target:Unsigned(bits=C.xLen), io_cpu_btb_update_bits_isValid:U1, io_cpu_btb_update_bits_br_pc:Unsigned(bits=C.xLen), io_cpu_bht_update_valid:U1, io_cpu_bht_update_bits_branch:U1, io_cpu_bht_update_bits_taken:U1, io_cpu_flush_icache:U1, io_cpu_progress:U1, privilege:U2, satp:Unsigned(bits=C.xLen)=0, flush:Bool=false,
    grant:Bool=true, leaf:U28=0, walkReady:Bool=false, walkDone:Bool=false, walkError:Bool=false, walkData:Unsigned(bits=C.xLen)=0, io_ptw_status_debug:U1, pmpExecute:U1, prefetchEnable:Bool=false) -> (hint:Bool@[], pmpAddress:U32@[], needsClock:Bool@[], fetchIndex:Unsigned(bits=C.bhtIndexBits)@[], tlbMiss:Bool@[], probe:Bool@[], key:Unsigned(bits=C.tlbKeyBits)@[], walkComplete:Bool@[], walkLeaf:U28@[], walkRead:Bool@[], walkPointer:Bool@[], walkAddress:U32@[], auto_icache_master_out_a_valid:U1@[], auto_icache_master_out_a_bits_address:U32@[], auto_icache_master_out_a_bits_user_amba_prot_readalloc:U1@[], auto_icache_master_out_a_bits_user_amba_prot_writealloc:U1@[], io_cpu_resp_valid:U1@[], io_cpu_resp_bits_btb_taken:U1@[], io_cpu_resp_bits_btb_bridx:U1@[], io_cpu_resp_bits_pc:Unsigned(bits=C.xLen)@[], io_cpu_resp_bits_data:U32@[], io_cpu_resp_bits_mask:U2@[], io_cpu_resp_bits_xcpt_pf_inst:U1@[], io_cpu_resp_bits_xcpt_gf_inst:U1@[], io_cpu_resp_bits_xcpt_ae_inst:U1@[], io_cpu_resp_bits_replay:U1@[], io_cpu_gpa_valid:U1@[], io_cpu_gpa_bits:U32@[], io_cpu_npc:Unsigned(bits=C.xLen)@[], io_cpu_perf_acquire:U1@[]) {
  reg s1_valid:U1
  reg s2_valid:U1
  reg s1_pc:Unsigned(bits=C.xLen)
  reg s1_speculative:U1
  reg s2_pc:Unsigned(bits=C.xLen)
  reg s2_tlb_resp_pf_inst:U1
  reg s2_tlb_resp_ae_inst:U1
  reg s2_speculative:U1
  reg s2_replay_REG:U1
  reg recent_progress_counter:U2
  reg fq_io_enq_valid_REG:U1
  reg gpa_valid:U1
  wire _fq_io_enq_valid_T_6:U1 = nil
  wire _tlb_io_resp_pf_inst:U1 = nil
  wire _tlb_io_resp_ae_inst:U1 = nil
  wire _fq_io_enq_ready:U1 = nil
  wire queued:U3 = nil
  wire _icache_io_resp_valid:U1 = nil
  mut gpa:U32 = 0
  const io_cpu_req_valid_0__w1 = io_cpu_req_valid
  wire repairPacket:U1 = nil
  wire icacheFault:U1 = nil
  wire fetchData:U32 = nil
  const s2_redirect__w1 = io_cpu_req_valid | repairPacket
  const s2_xcpt__w1 = (s2_tlb_resp_ae_inst | s2_tlb_resp_pf_inst) & 1
  const s0_speculative__w1 = (s1_speculative | (s2_valid & (~s2_speculative) & 1)) & 1
  mut _b2i_1 = if recent_progress_counter != 0 { 1 } else { 0 }
  const s2_kill_speculative_tlb_refill__w1 = s2_speculative & (~_b2i_1#[0]) & 1
  const killSpeculative = s2_speculative | s2_xcpt__w1
  const _fq_io_enq_bits_mask_T_1__w1 = (3 << s2_pc#[1..<2])#[0..<3]
  gpa = 0sb?
  const io_cpu_gpa_valid__w1 = gpa_valid
  // The queue reserves space for both in-flight fetches. With three free
  // slots, admission is independent of either pipeline valid bit.
  const fetchRoom = queued < 3 or (queued < 4 and (s1_valid & s2_valid) == 0) or
                    (queued < 5 and (s1_valid | s2_valid) == 0)
  const s0_valid__w1 = s2_redirect__w1 | U1(fetchRoom)
  const s2_replay__w1 = ((s2_valid & (~(_fq_io_enq_ready & _fq_io_enq_valid_T_6 & 1)#[0]) & 1) | s2_replay_REG) & 1
  mut nextFetch:Unsigned(bits=C.xLen) = ((s1_pc & ((1 << C.xLen)-4)) + 4)#[0..<C.xLen]
  mut predictedTaken:U1 = 0
  mut predictedSlot:U1 = 0
  mut repair:U1 = 0
  mut repairPC:Unsigned(bits=C.xLen) = ((s2_pc & ((1 << C.xLen)-4)) + 4)#[0..<C.xLen]
  mut packetIndex:Unsigned(bits=C.bhtIndexBits) = 0
  if C.btbEntries > 0 {
    wire learn:Bool = nil
    wire learnedPC:Unsigned(bits=C.xLen) = nil
    wire learnedTarget:Unsigned(bits=C.xLen) = nil
    wire fetchAction:U2 = nil
    wire advance:Bool = nil
    reg takenS2:U1
    reg slotS2:U1
    const link = ((s2_pc & ((1 << C.xLen)-4)) + ((slotS2+1) << 1))#[0..<C.xLen]
    const btb = BranchPredictor<C>(forceTaken=staticPrediction, invalidate=flushBTB, learn=learn,
        learnedPC=learnedPC, learnedTarget=learnedTarget, `clock`=`clock`, clear=`reset` | io_cpu_flush_icache, pc=s1_pc,
        replace=io_cpu_btb_update_valid, install=io_cpu_btb_update_bits_isValid, branchPC=io_cpu_btb_update_bits_br_pc,
        destination=io_cpu_btb_update_bits_target, rasAction=rasAction, fetchAction=fetchAction, fetchLink=link,
        branchIndex=branchIndex, advance=advance, direction=takenS2, restore=s2_redirect__w1 != 0,
        resolve=io_cpu_bht_update_valid & io_cpu_bht_update_bits_branch, taken=io_cpu_bht_update_bits_taken)
    if btb.predict != 0 { nextFetch = btb.target }
    if s2_replay__w1 == 0 {
      takenS2 = btb.predict
      slotS2 = btb.slot
    }
    // A jump into a different halfword can give the same fetch word a different
    // instruction boundary. Never truncate a 32-bit instruction after its first half.
    reg partial:U1
    const lowStarts = s2_pc#[1] == 0 and partial == 0
    const highStarts = !lowStarts or fetchData#[0..<2] != 3
    const highPartial = highStarts and fetchData#[16..<18] == 3
    const split = if slotS2 != 0 { highPartial } else { lowStarts and fetchData#[0..<2] == 3 }
    const accepted = _fq_io_enq_ready & _fq_io_enq_valid_T_6
    const acceptPrediction = accepted != 0 and !split and s2_xcpt__w1 == 0 and s2_redirect__w1 == 0
    if C.nRAS > 0 {
      reg actionS2:U2 = nil
      if s2_replay__w1 == 0 { actionS2 = btb.action }
      fetchAction = if acceptPrediction and takenS2 != 0 { actionS2 } else { 0 }
    } else { fetchAction = 0 }
    if C.bhtEntries > 0 {
      reg indexS2:Unsigned(bits=C.bhtIndexBits) = nil
      reg branchS2:Bool = nil
      if s2_replay__w1 == 0 { indexS2 = btb.index; branchS2 = btb.branch }
      packetIndex = indexS2
      advance = acceptPrediction and branchS2
    } else { advance = false }
    repair = accepted & takenS2 & U1(split)
    predictedTaken = takenS2 & ~U1(split)
    predictedSlot = slotS2
    if C.branchPredictionModeCSR {
      reg previous:U16 = nil
      if accepted != 0 { previous = fetchData#[16..<32] }
      const decoded = predecode<C>(pc=s2_pc, data=fetchData, previous=previous, partial=partial != 0)
      const usable = staticPrediction and accepted != 0 and _icache_io_resp_valid != 0 and s2_xcpt__w1 == 0 and
                     icacheFault == 0 and !flushBTB
      const takeLate = usable and decoded.branch and (predictedTaken == 0 or decoded.slot < slotS2)
      learn = takeLate and io_cpu_req_valid == 0
      learnedPC = ((s2_pc >> 2) << 2) | (decoded.slot << 1)
      learnedTarget = decoded.target
      if takeLate { repair = 1; repairPC = decoded.target; predictedTaken = 1; predictedSlot = decoded.slot }
    } else { learn = false; learnedPC = 0; learnedTarget = 0 }
    if `reset` != 0 or io_cpu_req_valid != 0 { partial = 0 }
    elif accepted != 0 { partial = U1(highPartial) & ~predictedTaken }
  }
  repairPacket = repair
  const fetchPC = if repair != 0 { repairPC }
      elif s2_replay__w1 != 0 { s2_pc } else { nextFetch }
  reg s2Miss:U1
  _fq_io_enq_valid_T_6 = ~s2Miss & fq_io_enq_valid_REG & s2_valid & 1 & (_icache_io_resp_valid | killSpeculative) & 1 & 1
  const selectedPC = if io_cpu_req_valid != 0 { io_cpu_req_bits_pc } else { fetchPC }
  const io_cpu_npc_0__w1 = selectedPC#[1..<C.xLen] << 1
  s1_valid = s0_valid__w1
  s1_pc = io_cpu_npc_0__w1
  if io_cpu_req_valid_0__w1 != 0 {
    s1_speculative = io_cpu_req_bits_speculative
  } else {
    s1_speculative = if s2_replay__w1 != 0 { s2_speculative } else { s0_speculative__w1 }
  }
  if not (s2_replay__w1 != 0) {
    s2_tlb_resp_pf_inst = _tlb_io_resp_pf_inst
    s2_tlb_resp_ae_inst = _tlb_io_resp_ae_inst
  }
  fq_io_enq_valid_REG = s1_valid
  gpa_valid = (~io_cpu_req_valid_0__w1#[0]) & gpa_valid & 1
  if `reset` != 0 {
    s2_valid = 0
    s2_pc = 0x10040
    s2_speculative = 0
    s2_replay_REG = 1
    recent_progress_counter = 3
  } else {
    s2_valid = (~s2_replay__w1#[0]) & (~s2_redirect__w1#[0]) & 1
    if not (s2_replay__w1 != 0) {
      s2_pc = s1_pc
      s2_speculative = s1_speculative
    }
    s2_replay_REG = s2_replay__w1 & (~s0_valid__w1#[0]) & 1
    if io_cpu_progress != 0 {
      recent_progress_counter = 3
    }
  }
  mut physicalPC:U32 = s1_pc#[0..<32]
  mut waiting:U1 = 0
  mut fetchPageFault:U1 = 0
  mut fetchAccessFault = U1((s1_pc >> 32) != 0)
  tlbMiss = false
  probe = false
  key = 0
  walkComplete = false
  walkLeaf = 0
  walkPointer = false
  walkRead = false
  walkAddress = 0
  if C.useVM {
    const lookup = s1_valid != 0 and s2_redirect__w1 == 0 and s2_replay__w1 == 0
    const t = itlb<C=C, FETCH=true>(clk=`clock`, rst=`reset` != 0,
        request=lookup, accepted=lookup, va=s1_pc, satp=satp,
        privilege=privilege, store=false, sum=false, mxr=false, flush=flush,
        grant=grant, leaf=leaf, readReady=walkReady, readDone=walkDone, readError=walkError, readData=walkData)
    waiting = U1(!t.resolved)
    physicalPC = t.address
    fetchPageFault = U1(t.pf)
    fetchAccessFault = U1(t.ae)
    probe = t.probe
    key = t.key
    walkComplete = t.walkDone
    walkLeaf = t.walkLeaf
    tlbMiss = t.miss
    walkPointer = t.cachePointer
    walkRead = t.read
    walkAddress = t.readAddress
  }
  if s2_replay__w1 == 0 { s2Miss = waiting }
  const icache = ICache<C>(clk=`clock`, rst=(`reset` != 0), fetch=s0_valid__w1, vaddr=io_cpu_npc_0__w1#[0..<32],
      paddr=physicalPC, killS1=s2_redirect__w1 | s2_replay__w1 | waiting, killS2=killSpeculative,
      invalidate=io_cpu_flush_icache, aReady=auto_icache_master_out_a_ready, dValid=auto_icache_master_out_d_valid,
      dOpcode=auto_icache_master_out_d_bits_opcode, dData=auto_icache_master_out_d_bits_data,
      dCorrupt=auto_icache_master_out_d_bits_corrupt, prefetchAllowed=prefetchEnable and
          (physicalPC >= 0x80000000 or (physicalPC >= 0x10000 and physicalPC < 0x20000)))
  hint = icache.hint
  icacheFault = icache.accessFault
  fetchData = icache.data
  _icache_io_resp_valid = icache.valid
  mut fq = ShiftQueue<W=C.xLen,I=C.bhtIndexBits,useHistory=(C.bhtEntries > 0)>(index=packetIndex, `clock` = `clock`, `reset` = (`reset` | io_cpu_req_valid_0__w1) & 1, io_enq_valid = _fq_io_enq_valid_T_6, io_enq_bits_btb_taken = predictedTaken, io_enq_bits_btb_bridx = predictedSlot, io_enq_bits_pc = s2_pc, io_enq_bits_data = icache.data, io_enq_bits_mask = _fq_io_enq_bits_mask_T_1__w1#[0..<2], io_enq_bits_xcpt_pf_inst = s2_tlb_resp_pf_inst, io_enq_bits_xcpt_ae_inst = ((_icache_io_resp_valid & icache.accessFault & 1) | s2_tlb_resp_ae_inst) & 1, io_enq_bits_replay = killSpeculative & (~_icache_io_resp_valid) & 1 & (~s2_xcpt__w1#[0]) & 1, io_deq_ready = io_cpu_resp_ready)
  _fq_io_enq_ready = fq.io_enq_ready
  needsClock = (s1_valid | s2_valid) != 0 or fq.occupancy < 5 or icache.busy or walkRead or (C.nL2TLBEntries > 0 and (probe or walkComplete))
  queued = fq.occupancy
  pmpAddress = physicalPC
  const region = attributes<SETS=C.dcacheSets,BLOCK=C.dcacheBlockBytes,SCRATCH=C.useDataScratchpad>(address=physicalPC, debug=io_ptw_status_debug)
  _tlb_io_resp_pf_inst = fetchPageFault
  _tlb_io_resp_ae_inst = fetchAccessFault | (~(region.execute & pmpExecute) & ~fetchPageFault)
  auto_icache_master_out_a_valid = icache.aValid
  auto_icache_master_out_a_bits_address = icache.aAddress
  auto_icache_master_out_a_bits_user_amba_prot_readalloc = 0
  auto_icache_master_out_a_bits_user_amba_prot_writealloc = 0
  fetchIndex = fq.prediction
  io_cpu_resp_valid = fq.io_deq_valid
  io_cpu_resp_bits_btb_taken = fq.io_deq_bits_btb_taken
  io_cpu_resp_bits_btb_bridx = fq.io_deq_bits_btb_bridx
  io_cpu_resp_bits_pc = fq.io_deq_bits_pc
  io_cpu_resp_bits_data = fq.io_deq_bits_data
  io_cpu_resp_bits_mask = fq.io_deq_bits_mask
  io_cpu_resp_bits_xcpt_pf_inst = fq.io_deq_bits_xcpt_pf_inst
  io_cpu_resp_bits_xcpt_gf_inst = fq.io_deq_bits_xcpt_gf_inst
  io_cpu_resp_bits_xcpt_ae_inst = fq.io_deq_bits_xcpt_ae_inst
  io_cpu_resp_bits_replay = fq.io_deq_bits_replay
  io_cpu_gpa_valid = io_cpu_gpa_valid__w1
  io_cpu_gpa_bits = gpa
  io_cpu_npc = io_cpu_npc_0__w1
  io_cpu_perf_acquire = icache.acquired
}
