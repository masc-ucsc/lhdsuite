const itlb = import("TileTranslation.port")
const tiny = import("RocketConfig.tiny")
const predecode = import("BranchDecode.packet")
const BranchPredictor = import("BranchPredictor.BranchPredictor")
const ICache = import("ICache.ICache")
const ShiftQueue = import("ShiftQueue.ShiftQueue")
const attributes = import("PhysicalMap.attributes")

pub mod Frontend<C=tiny>::[timecheck=false](auto_icache_master_out_a_ready:U1, auto_icache_master_out_d_bits_corrupt:U1, auto_icache_master_out_d_bits_data:Unsigned(bits=C.dLen), auto_icache_master_out_d_bits_opcode:U4, auto_icache_master_out_d_valid:U1, branchIndex:Unsigned(bits=C.bhtIndexBits)=0, clock:Clock, flush:Bool=false, flushBTB:Bool=false, grant:Bool=true, imem:(bhtUpdateBranch:Bool, bhtUpdateTaken:Bool, bhtUpdateValid:Bool, btbUpdateBrPc:Unsigned(bits=C.xLen), btbUpdateIsValid:Bool, btbUpdateTarget:Unsigned(bits=C.xLen), btbUpdateValid:Bool, flushIcache:Bool, progress:Bool, pc:Unsigned(bits=C.xLen), speculative:Bool, valid:Bool, respReady:Bool), io_ptw_status_debug:U1, leaf:U28=0, pmpExecute:U1, prefetchEnable:Bool=false, privilege:U2, rasAction:U2=0, reset:Reset, satp:Unsigned(bits=C.xLen)=0, staticPrediction:Bool=false, walkData:Unsigned(bits=C.xLen)=0, walkDone:Bool=false, walkError:Bool=false, walkReady:Bool=false) -> (fetchA:(address:U32, readalloc:U1, writealloc:U1, valid:U1)@[], fetchIndex:Unsigned(bits=C.bhtIndexBits)@[], hint:Bool@[], imemResponse:(gpaBits:U32, gpaValid:Bool, npc:Unsigned(bits=C.xLen), perfAcquire:Bool, respBtbBridx:U1, respBtbTaken:Bool, respData:U32, respMask:U2, respPc:Unsigned(bits=C.xLen), respReplay:Bool, respXcptAeInst:Bool, respXcptGfInst:Bool, respXcptPfInst:Bool, respValid:Bool)@[], key:Unsigned(bits=C.tlbKeyBits)@[], needsClock:Bool@[], pmpAddress:U32@[], probe:Bool@[], tlbMiss:Bool@[], walkAddress:U32@[], walkComplete:Bool@[], walkLeaf:U28@[], walkPointer:Bool@[], walkRead:Bool@[]) {
  reg s1Valid:Bool = nil
  reg s2Valid:Bool = false
  reg s1PC:Unsigned(bits=C.xLen) = nil
  reg s1Speculative:Bool = nil
  reg s2PC:Unsigned(bits=C.xLen) = 0x10040
  reg s2PageFault:Bool = nil
  reg s2AccessFault:Bool = nil
  reg s2Speculative:Bool = false
  reg replayPending:Bool = true
  reg s2Requested:Bool = nil
  reg gpaValid:Bool = nil
  wire offerPacket:Bool = nil
  wire pageFault:Bool = nil
  wire accessFault:Bool = nil
  wire queueReady:Bool = nil
  wire queued:U3 = nil
  wire cacheValid:Bool = nil
  wire repairPacket:Bool = nil
  wire icacheFault:Bool = nil
  wire fetchData:U32 = nil
  const redirect = imem.valid or repairPacket
  const fetchFault = s2AccessFault or s2PageFault
  const nextSpeculative = s1Speculative or (s2Valid and !s2Speculative)
  const killSpeculative = s2Speculative or fetchFault
  const fetchMask = (3 << s2PC#[1..<2])#[0..<3]
  // The queue reserves space for both in-flight fetches. With three free
  // slots, admission is independent of either pipeline valid bit.
  const fetchRoom = queued < 3 or (queued < 4 and !(s1Valid and s2Valid)) or (queued < 5 and !(s1Valid or s2Valid))
  const fetchValid = redirect or fetchRoom
  const replay = (s2Valid and !(queueReady and offerPacket)) or replayPending
  mut nextFetch:Unsigned(bits=C.xLen) = ((s1PC & ((1 << C.xLen) - 4)) + 4)#[0..<C.xLen]
  mut predictedTaken:Bool = false
  mut predictedSlot:U1 = 0
  mut repair:Bool = false
  mut repairPC:Unsigned(bits=C.xLen) = ((s2PC & ((1 << C.xLen) - 4)) + 4)#[0..<C.xLen]
  mut packetIndex:Unsigned(bits=C.bhtIndexBits) = 0
  if C.btbEntries > 0 {
    wire learn:Bool = nil
    wire learnedPC:Unsigned(bits=C.xLen) = nil
    wire learnedTarget:Unsigned(bits=C.xLen) = nil
    wire fetchAction:U2 = nil
    wire advance:Bool = nil
    reg takenS2:Bool = nil
    reg slotS2:U1 = nil
    const link = ((s2PC & ((1 << C.xLen) - 4)) + ((slotS2 + 1) << 1))#[0..<C.xLen]
    const btb = BranchPredictor<C>(forceTaken=staticPrediction, invalidate=flushBTB, learn=learn, learnedPC=learnedPC, learnedTarget=learnedTarget, clear=U1(reset or imem.flushIcache), pc=s1PC, replace=U1(imem.btbUpdateValid), install=U1(imem.btbUpdateIsValid), branchPC=imem.btbUpdateBrPc, destination=imem.btbUpdateTarget, rasAction=rasAction, fetchAction=fetchAction, fetchLink=link, branchIndex=branchIndex, advance=advance, direction=U1(takenS2), restore=redirect, resolve=U1(imem.bhtUpdateValid and imem.bhtUpdateBranch), taken=U1(imem.bhtUpdateTaken))
    if btb.predict != 0 {
      nextFetch = btb.target
    }
    if !replay {
      takenS2 = btb.predict != 0
      slotS2 = btb.slot
    }
    // A jump into a different halfword can give the same fetch word a different
    // instruction boundary. Never truncate a 32-bit instruction after its first half.
    reg partial:Bool = nil
    const lowStarts = s2PC#[1] == 0 and !partial
    const highStarts = !lowStarts or fetchData#[0..<2] != 3
    const highPartial = highStarts and fetchData#[16..<18] == 3
    const split = if slotS2 != 0 { highPartial } else { lowStarts and fetchData#[0..<2] == 3 }
    const accepted = queueReady and offerPacket
    const acceptPrediction = accepted and !split and !fetchFault and !redirect
    if C.nRAS > 0 {
      reg actionS2:U2 = nil
      if !replay {
        actionS2 = btb.action
      }
      fetchAction = if acceptPrediction and takenS2 { actionS2 } else { 0 }
    } else {
      fetchAction = 0
    }
    if C.bhtEntries > 0 {
      reg indexS2:Unsigned(bits=C.bhtIndexBits) = nil
      reg branchS2:Bool = nil
      if !replay {
        indexS2 = btb.index
        branchS2 = btb.branch
      }
      packetIndex = indexS2
      advance = acceptPrediction and branchS2
    } else {
      advance = false
    }
    repair = accepted and takenS2 and split
    predictedTaken = takenS2 and !split
    predictedSlot = slotS2
    if C.branchPredictionModeCSR {
      reg previous:U16 = nil
      if accepted {
        previous = fetchData#[16..<32]
      }
      const decoded = predecode<C>(pc=s2PC, data=fetchData, previous=previous, partial=partial)
      const usable = staticPrediction and accepted and cacheValid and !fetchFault and !icacheFault and !flushBTB
      const takeLate = usable and decoded.branch and (!predictedTaken or decoded.slot < slotS2)
      learn = takeLate and !imem.valid
      learnedPC = ((s2PC >> 2) << 2) | (decoded.slot << 1)
      learnedTarget = decoded.target
      if takeLate {
        repair = true
        repairPC = decoded.target
        predictedTaken = true
        predictedSlot = decoded.slot
      }
    } else {
      learn = false
      learnedPC = 0
      learnedTarget = 0
    }
    if reset or imem.valid {
      partial = false
    } elif accepted {
      partial = highPartial and !predictedTaken
    }
  }
  repairPacket = repair
  const fetchPC = if repair { repairPC } elif replay { s2PC } else { nextFetch }
  reg s2Miss:Bool = nil
  offerPacket = !s2Miss and s2Requested and s2Valid and (cacheValid or killSpeculative)
  const selectedPC = if imem.valid { imem.pc } else { fetchPC }
  const nextPC = selectedPC#[1..<C.xLen] << 1
  s1Valid = fetchValid
  s1PC = nextPC
  if imem.valid {
    s1Speculative = imem.speculative
  } else {
    s1Speculative = if replay { s2Speculative } else { nextSpeculative }
  }
  if !replay {
    s2PageFault = pageFault
    s2AccessFault = accessFault
  }
  s2Requested = s1Valid
  gpaValid = !imem.valid and gpaValid
  s2Valid = !replay and !redirect
  if !replay {
    s2PC = s1PC
    s2Speculative = s1Speculative
  }
  replayPending = replay and !fetchValid

  mut physicalPC:U32 = s1PC#[0..<32]
  mut waiting:Bool = false
  mut fetchPageFault:Bool = false
  mut fetchAccessFault = (s1PC >> 32) != 0
  tlbMiss = false
  probe = false
  key = 0
  walkComplete = false
  walkLeaf = 0
  walkPointer = false
  walkRead = false
  walkAddress = 0
  if C.useVM {
    const lookup = s1Valid and !redirect and !replay
    const t = itlb<C=C, FETCH=true>(request=lookup, accepted=lookup, va=s1PC, satp=satp, privilege=privilege, store=false, sum=false, mxr=false, flush=flush, grant=grant, leaf=leaf, readReady=walkReady, readDone=walkDone, readError=walkError, readData=walkData)
    waiting = !t.resolved
    physicalPC = t.address
    fetchPageFault = t.pf
    fetchAccessFault = t.ae
    probe = t.probe
    key = t.key
    walkComplete = t.walkDone
    walkLeaf = t.walkLeaf
    tlbMiss = t.miss
    walkPointer = t.cachePointer
    walkRead = t.read
    walkAddress = t.readAddress
  }
  if !replay {
    s2Miss = waiting
  }
  const icache = ICache<C>(fetch=U1(fetchValid), vaddr=nextPC#[0..<32], paddr=physicalPC, killS1=U1(redirect or replay or waiting), killS2=U1(killSpeculative), invalidate=U1(imem.flushIcache), aReady=auto_icache_master_out_a_ready, dValid=auto_icache_master_out_d_valid, dOpcode=auto_icache_master_out_d_bits_opcode, dData=auto_icache_master_out_d_bits_data, dCorrupt=auto_icache_master_out_d_bits_corrupt, prefetchAllowed=prefetchEnable and (physicalPC >= 0x80000000 or (physicalPC >= 0x10000 and physicalPC < 0x20000)))
  hint = icache.hint
  icacheFault = icache.accessFault != 0
  fetchData = icache.data
  cacheValid = icache.valid != 0
  type FetchPacket = (taken:Bool, branchSlot:U1, pc:Unsigned(bits=C.xLen), data:U32, mask:U2, pageFault:Bool, accessFault:Bool, replay:Bool, index:Unsigned(bits=C.bhtIndexBits))
  const fq = ShiftQueue<FetchPacket>(reset=reset or imem.valid, offer=offerPacket, take=imem.respReady, packet=(accessFault=(cacheValid and icacheFault) or s2AccessFault, branchSlot=predictedSlot, data=icache.data, index=packetIndex, mask=fetchMask#[0..<2], pageFault=s2PageFault, pc=s2PC, replay=killSpeculative and !cacheValid and !fetchFault, taken=predictedTaken))
  queueReady = fq.ready
  needsClock = s1Valid or s2Valid or fq.occupancy < 5 or icache.busy or walkRead or (C.nL2TLBEntries > 0 and (probe or walkComplete))
  queued = fq.occupancy
  pmpAddress = physicalPC
  const region = attributes<BLOCK=C.dcacheBlockBytes, SCRATCH=C.useDataScratchpad, SETS=C.dcacheSets>(address=physicalPC, debug=io_ptw_status_debug)
  pageFault = fetchPageFault
  accessFault = fetchAccessFault or ((region.execute & pmpExecute) == 0 and !fetchPageFault)
  fetchA.valid = icache.aValid
  fetchA.address = icache.aAddress
  fetchA.readalloc = 0
  fetchA.writealloc = 0
  fetchIndex = fq.head.index
  imemResponse.respValid = fq.valid
  imemResponse.respBtbTaken = fq.head.taken
  imemResponse.respBtbBridx = fq.head.branchSlot
  imemResponse.respPc = fq.head.pc
  imemResponse.respData = fq.head.data
  imemResponse.respMask = fq.head.mask
  imemResponse.respXcptPfInst = fq.head.pageFault
  imemResponse.respXcptGfInst = false
  imemResponse.respXcptAeInst = fq.head.accessFault
  imemResponse.respReplay = fq.head.replay
  imemResponse.gpaValid = gpaValid
  imemResponse.gpaBits = 0sb?
  imemResponse.npc = nextPC
  imemResponse.perfAcquire = icache.acquired != 0
}
