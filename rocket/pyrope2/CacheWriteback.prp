const metadata = import("ClientMetadata")

// One C-channel message owns the line and SRAM read port through its last beat.
// The SRAM returns a granted read on the next cycle and holds its output until
// another read. A following probe can run while a voluntary release awaits D.
pub mod CacheWriteback<W=32, SOURCE=1>(clk:Clock, rst:Reset,
    probeValid:Bool, probeAddress:U32, probeCap:U2, probeSource:U5,
    releaseValid:Bool, releaseAddress:U32, lineState:U2,
    readReady:Bool, readData:Unsigned(bits=W), readCorrupt:Bool=false, cReady:Bool, ackValid:Bool)
    -> (probeReady:Bool@[], releaseReady:Bool@[], lineAddress:U32@[],
        readValid:Bool@[], readBeat:Unsigned(bits=std.clog2(512/W))@[],
        cValid:Bool@[], cOpcode:U3@[], cParam:U3@[], cSource:U5@[], cData:Unsigned(bits=W)@[], cCorrupt:Bool@[],
        update:Bool@[], newState:U2@[], ackReady:Bool@[], releaseDone:Bool@[]) {
  cassert(W == 32 or W == 64)
  comptime const beats = 512 / W
  reg active:Bool = false
  reg voluntary:Bool = nil
  reg address:U32 = nil
  reg source:U5 = nil
  reg report:U3 = nil
  reg after:U2 = nil
  reg withData:Bool = nil
  reg beat:Unsigned(bits=std.clog2(beats)) = nil
  reg primed:Bool = false
  reg waitAck:Bool = false

  probeReady = !rst and !active
  releaseReady = probeReady and !probeValid and !waitAck
  const probe = probeValid and probeReady
  const release = releaseValid and releaseReady
  const selected = if probeValid { probeAddress } else { releaseAddress }
  lineAddress = if active { address } else { (selected >> 6) << 6 }
  const transition = metadata.shrink(state=lineState, cap=(if probe { probeCap } else { 2 }))
  const emptyRelease = release and lineState == metadata.invalid
  if probe or (release and !emptyRelease) {
    active = true
    voluntary = release
    address = lineAddress
    source = if probe { probeSource } else { SOURCE }
    report = transition.report
    after = transition.next
    withData = transition.data
    beat = 0
    primed = false
  }

  cValid = active and (!withData or primed)
  cOpcode = (if voluntary { 6 } else { 4 }) | U1(withData)
  cParam = report
  cSource = source
  cData = if withData { readData } else { 0 }
  cCorrupt = withData and readCorrupt
  const sent = cValid and cReady
  const last = !withData or beat == beats-1
  update = sent and last
  newState = after

  readValid = active and withData and (!primed or (sent and !last))
  wrap readBeat = if primed { beat + 1 } else { beat }
  if sent {
    if last { active = false } else { wrap beat += 1 }
    primed = false
  }
  if readValid and readReady { primed = true }

  const released = update and voluntary
  ackReady = waitAck or released
  releaseDone = emptyRelease or (ackReady and ackValid)
  if released { waitAck = true }
  if ackValid and ackReady { waitAck = false }
  if rst { active = false; primed = false; waitAck = false }
}
