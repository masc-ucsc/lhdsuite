const defaultConfig = import("RocketConfig.selected")
const trapVector = import("TrapVector.vector")
// Bare supervisor mode. The supervisor interrupt CSRs are views of mie/mip
// restricted by mideleg. The machine status CSR also exposes sstatus.
pub comb exists(addr:U12) -> (present:Bool) {
  present = match addr {
    in (0x100, 0x104, 0x105, 0x106, 0x10a, 0x140, 0x141, 0x142, 0x143, 0x144, 0x180, 0x302, 0x303) { true }
    else { false }
  }
}
pub mod SupervisorCSR<C=defaultConfig>(cause:Unsigned(bits=C.xLen), clk:Clock, cmd:U3, compressed:U1, csr:U12, localPending:Unsigned(bits=C.xLen)=0, operand:Unsigned(bits=C.xLen), pc:Unsigned(bits=C.xLen), prv:U2, rst:Reset, seip:U1, sret:Bool, trap:Bool, tval:Unsigned(bits=C.xLen), writeData:Unsigned(bits=C.xLen)) -> (counters:Unsigned(bits=C.counterBits)@[], delegated:Bool@[], enabled:Unsigned(bits=C.xLen)@[], flags:U32@[], ideleg:Unsigned(bits=C.xLen)@[], pending:U12@[], rdata:Unsigned(bits=C.xLen)@[], returnPC:Unsigned(bits=C.xLen)@[], satp:Unsigned(bits=C.xLen)@[], sie:U1@[], spp:U1@[], status:Unsigned(bits=C.xLen)@[], vector:Unsigned(bits=C.xLen)@[]) {
  reg scratch:Unsigned(bits=C.xLen) = nil
  reg epc:Unsigned(bits=C.xLen) = nil
  reg scause:Unsigned(bits=C.xLen) = nil
  reg badAddress:Unsigned(bits=C.xLen) = nil
  reg tvec:Unsigned(bits=C.xLen) = 0
  reg edeleg:U16 = 0
  reg interruptDeleg:Unsigned(bits=C.xLen) = 0
  reg ip:U12 = 0
  reg ie:Unsigned(bits=C.xLen) = 0
  reg previous:U1 = 0
  reg interruptEnable:U1 = 0
  reg previousIE:U1 = 0
  reg restrictions:U2 = 0 // TW, TSR
  reg fiom:U1 = 0
  reg counterEnable:Unsigned(bits=C.counterBits) = 0
  const supervisorIRQs = 0x222
  comptime const delegable = (U1((C.roccOpcodes != 0)) << 13) | 0x222 | (((1 << C.nLocalInterrupts) - 1) << 16)
  const num = cause#[0..<8]
  spp = previous
  sie = interruptEnable
  satp = 0
  mut pageStatus:U32 = 0
  mut tvm:U1 = 0
  if C.useVM {
    comptime const modeBit = if C.xLen == 32 { 31 } else { 60 }
    comptime const baseMode = if C.xLen == 32 { 1 } else { 8 }
    comptime const modeMask = baseMode | ((1 << std.clog2(C.extraPgLevels + 1)) - 1)
    comptime const asidBit = if C.xLen == 32 { 22 } else { 44 }
    comptime const writable = (modeMask << modeBit) | (((1 << C.asIdBits) - 1) << asidBit) | 0xfffff
    reg addressSpace:Unsigned(bits=C.xLen) = 0
    reg memoryPrivilege:U2 = 0 // SUM, MXR
    reg trapVM:U1 = 0
    if csr == 0x180 and cmd >= 5 {
      const selected = writeData >> modeBit
      if selected == 0 or (selected >= baseMode and selected <= baseMode + C.extraPgLevels) {
        addressSpace = writeData & writable
      }
    }
    if (csr == 0x100 or csr == 0x300) and cmd >= 5 {
      memoryPrivilege = writeData#[18..<20]
    }
    if csr == 0x300 and cmd >= 5 {
      trapVM = writeData#[20]
    }
    satp = addressSpace
    pageStatus = memoryPrivilege << 18
    tvm = trapVM
  }
  flags = (restrictions << 21) | (tvm << 20)
  counters = counterEnable
  status = pageStatus | (if C.xLen == 64 { 2 << 32 } else { 0 }) | (previous << 8) | (previousIE << 5) | (interruptEnable << 1)
  pending = ip | (seip << 9)
  enabled = ie
  ideleg = interruptDeleg
  const interrupt = cause#[C.xLen - 1] != 0
  delegated = prv <= 1 and (if interrupt { (interruptDeleg >> num)#[0] != 0 } else { (edeleg >> num)#[0] != 0 })
  const tv = trapVector<C.xLen>(tvec=tvec, interrupt=interrupt, number=num)
  vector = tv.target
  returnPC = epc & (((1 << C.xLen) - 4) | (compressed << 1))
  rdata = match csr {
    == 0x100 { status }
    == 0x104 { ie & interruptDeleg }
    == 0x105 { tv.readback }
    == 0x10a { fiom }
    == 0x106 { counterEnable }
    == 0x140 { scratch }
    == 0x141 { returnPC }
    == 0x180 { satp }
    == 0x142 { scause }
    == 0x143 { badAddress }
    == 0x144 { (localPending | pending) & interruptDeleg }
    == 0x302 { edeleg }
    == 0x303 { interruptDeleg }
    else { 0 }
  }
  if cmd >= 5 {
    if csr == 0x300 {
      restrictions = writeData#[21..<23]
    }
    if csr == 0x100 or csr == 0x300 {
      previous = writeData#[8]
      previousIE = writeData#[5]
      interruptEnable = writeData#[1]
    }
    if csr == 0x302 {
      edeleg = writeData#[0..<16] & 0xb15d
    }
    if csr == 0x303 {
      interruptDeleg = writeData & delegable
    }
    if csr == 0x304 {
      ie = writeData & delegable
    }
    if csr == 0x104 {
      ie = (ie & ~interruptDeleg) | (writeData & interruptDeleg)
    }
    if csr == 0x344 {
      // CSRRS/CSRRC operate on the stored SEIP bit before OR'ing in the external line.
      ip = match cmd {
        == 6 { ip | (operand#[0..<12] & supervisorIRQs) }
        == 7 { ip & ~(operand#[0..<12] & U12(supervisorIRQs)) }
        else { operand#[0..<12] & supervisorIRQs }
      }
    }
    if csr == 0x144 and interruptDeleg#[1] != 0 {
      ip#[1] = writeData#[1]
    }
    if csr == 0x105 {
      tvec = writeData
    }
    if csr == 0x10a {
      fiom = writeData#[0]
    }
    if csr == 0x106 {
      counterEnable = writeData#[0..<C.counterBits]
    }
    if csr == 0x140 {
      scratch = writeData
    }
    if csr == 0x141 {
      epc = writeData#[1..<C.xLen] << 1
    }
    if csr == 0x142 {
      scause = writeData & ((1 << (C.xLen - 1)) | 0x1f)
    }
    if csr == 0x143 {
      badAddress = writeData
    }
  }
  if trap and delegated {
    epc = pc#[1..<C.xLen] << 1
    scause = cause
    badAddress = tval
    previous = prv#[0]
    previousIE = interruptEnable
    interruptEnable = 0
  } elif sret {
    previous = 0
    interruptEnable = previousIE
    previousIE = 1
  }
}
