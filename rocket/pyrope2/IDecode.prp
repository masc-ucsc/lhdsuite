const instructionCommand = import("CacheAccess.instructionCommand")
const branchOffset = import("BranchDecode.offset")
const jumpOffset = import("BranchDecode.jumpOffset")
// Integer pipeline controls shared by RV32 and RV64. The instruction is
// already expanded to its 32-bit encoding when it reaches decode.
const floating = import("FPU")
const BitOps = import("BitOps")

enum CsrCmd:U3 = (none=0, read=2, system=4, write=5, setBits=6, clearBits=7)

enum ImmForm:U3 = (store=0, branch=1, upper=2, jump=3, immediate=4, csr=5)

// RV immediates share instruction bit 31 as the sign bit. Z is unsigned.
pub comb immediate<C>(inst:U32, form:ImmForm) -> (value:Unsigned(bits=C.xLen)) {
  const s:U12 = (inst#[25..<32] << 5) | inst#[7..<12]
  const b = branchOffset(inst)
  const j = jumpOffset(inst)
  value = match form {
    == ImmForm.store { s#sext[0..<12]#[0..<C.xLen] }
    == ImmForm.branch { b#sext[0..<13]#[0..<C.xLen] }
    == ImmForm.upper { (inst & 0xfffff000)#sext[0..<32]#[0..<C.xLen] }
    == ImmForm.jump { j#sext[0..<21]#[0..<C.xLen] }
    == ImmForm.immediate { inst#sext[20..<32]#[0..<C.xLen] }
    == ImmForm.csr { inst#[15..<20] }
    else { (inst#[20..<32] & 0xffe)#sext[0..<12]#[0..<C.xLen] }
  }
}

pub comb csrControl(cmd:CsrCmd, memory:Bool, zeroSource:Bool) -> (access:Bool, effective:U3, readOnly:Bool, system:Bool) {
  system = cmd == CsrCmd.system
  access = cmd == CsrCmd.write or cmd == CsrCmd.setBits or cmd == CsrCmd.clearBits
  readOnly = zeroSource and (cmd == CsrCmd.setBits or cmd == CsrCmd.clearBits)
  effective = if system and memory { U3(CsrCmd.none) } elif readOnly { U3(CsrCmd.read) } else { cmd }
}

pub comb IDecode<C>(inst:U32, vectorDecode:U4=0) -> (alu_dw:U1, alu_fn:U6, amo:Bool, branch:Bool, csr:U3, div:Bool, fence:Bool, fence_i:Bool, fp:Bool, fpDouble:Bool, fpRound:Bool, jal:Bool, jalr:Bool, legal:Bool, mem:Bool, mem_cmd:U5, mul:Bool, rocc:Bool, rxs1:Bool, rxs2:Bool, sel_alu1:U2, sel_alu2:U2, sel_imm:ImmForm, vector:Bool, wxd:Bool) {
  const opcode = inst#[0..<7]
  const funct3 = inst#[12..<15]
  const funct7 = inst#[25..<32]
  const custom = (opcode & 0x1f) == 0x0b
  rocc = custom and (C.roccOpcodes & (1 << opcode#[5..<7])) != 0
  const vectorMemory = (opcode == 7 or opcode == 0x27) and (funct3 == 0 or funct3 >= 5)
  vector = C.vLen > 0 and (opcode == 0x57 or vectorMemory) and vectorDecode#[3] != 0
  const is64 = C.xLen == 64
  const opImm = opcode == 0x13 or (is64 and opcode == 0x1b)
  const opReg = opcode == 0x33 or (is64 and opcode == 0x3b)
  const wordOp = opcode == 0x1b or opcode == 0x3b
  const isShift = funct3 == 1 or funct3 == 5
  const shiftCode = if is64 and !wordOp { funct7 & 0x7e } else { funct7 }
  const immValid = !isShift or shiftCode == 0 or (funct3 == 5 and shiftCode == 0x20)
  const regValid = funct7 == 0 or (funct7 == 0x20 and (funct3 == 0 or funct3 == 5))
  const mulDiv = C.useMulDiv and opReg and funct7 == 1 and (!wordOp or funct3 == 0 or funct3 >= 4)
  const integer = ((opImm and immValid) or (opReg and regValid)) and (!wordOp or funct3 == 0 or isShift)
  const load = opcode == 3 and (funct3 < 3 or funct3 == 4 or funct3 == 5 or (is64 and (funct3 == 3 or funct3 == 6)))
  const store = opcode == 0x23 and (funct3 < 3 or (is64 and funct3 == 3))
  const atomOp = inst#[27..<32]
  const atomic = C.useAtomics and opcode == 0x2f and (funct3 == 2 or (is64 and funct3 == 3)) and (atomOp == 0 or atomOp == 1 or (atomOp == 2 and inst#[20..<25] == 0) or atomOp == 3 or atomOp == 4 or atomOp == 8 or atomOp == 12 or atomOp == 16 or atomOp == 20 or atomOp == 24 or atomOp == 28)
  const jump = opcode == 0x6f
  const indirect = opcode == 0x67 and funct3 == 0
  const cond = opcode == 0x63 and (funct3 < 2 or funct3 >= 4)
  const lui = opcode == 0x37
  const auipc = opcode == 0x17
  const csrOp = opcode == 0x73 and funct3 != 0 and funct3 != 4
  const machineSystem = match inst {
    in (0x73, 0x100073, 0x30200073, 0x10500073) { true }
    == 0x7b200073 { C.useDebug }
    == 0x30500073 { C.haveCease }
    else { false }
  }
  const sfence = C.useVM and (inst & 0xfe007fff) == 0x12000073
  const lineFlush = !C.useVM or C.dcacheSets*C.dcacheBlockBytes <= 4096
  const flush = C.haveCFlush and (inst & 0xffd07fff) == 0xfc000073 and (lineFlush or inst#[15..<20] == 0)
  const system = flush or sfence or machineSystem or (C.useSupervisor and inst == 0x10200073)
  mut extFn:U6 = 0
  mut unaryImm = false
  mut fullWidth = false
  if C.useConditionalZero or C.useZba or C.useZbb or C.useZbs {
    const ext = BitOps.decode<C>(inst=inst)
    extFn = ext.fn
    unaryImm = ext.unaryImm
    fullWidth = ext.fullWidth
  }
  mut fpLoad = false
  mut fpStore = false
  mut fromX = false
  mut toX = false
  fp = false
  fpRound = false
  fpDouble = false
  if C.fLen > 0 {
    const f = floating.decode<C>(inst=inst)
    fp = f.valid
    fpRound = f.round
    fpDouble = f.double
    fpLoad = f.load
    fpStore = f.store
    fromX = f.fromX
    toX = f.toX
  }
  const fenceOp = opcode == 0xf and funct3 <= 1
  legal = rocc or vector or fp or extFn != 0 or integer or mulDiv or load or store or atomic or jump or indirect or cond or lui or auipc or csrOp or system or fenceOp
  jal = jump
  jalr = indirect
  branch = cond
  rxs1 = (rocc and inst#[13] != 0) or (vector and vectorDecode#[1] != 0) or fpLoad or fpStore or fromX or flush or sfence or opReg or opImm or load or store or atomic or indirect or cond or (csrOp and funct3 < 4)
  rxs2 = (rocc and inst#[12] != 0) or (vector and vectorDecode#[0] != 0) or sfence or (opReg and !unaryImm) or store or atomic or cond
  wxd = (rocc and inst#[14] != 0) or (vector and vectorDecode#[2] != 0) or toX or opReg or opImm or load or atomic or jump or indirect or lui or auipc or csrOp
  mul = mulDiv and C.pipelinedMul and funct3 < 4
  div = mulDiv and !mul
  sel_alu1 = if jump or auipc { 2 } else { U1(rxs1) }
  sel_alu2 = if (opReg and !unaryImm) or cond { 2 } elif jump { 1 } elif flush or fromX or atomic or (csrOp and funct3 < 4) { 0 } else { 3 }
  sel_imm = if lui or auipc { ImmForm.upper }
    elif cond { ImmForm.branch }
    elif jump { ImmForm.jump }
    elif fpStore or store { ImmForm.store }
    elif csrOp { ImmForm.csr }
    else { ImmForm.immediate }
  alu_dw = U1(!wordOp or fullWidth)
  alu_fn = 0
  if cond {
    alu_fn = if funct3 < 2 { funct3 + 2 } else { funct3 + 8 }
  } elif mulDiv {
    alu_fn = funct3
  } elif extFn != 0 {
    alu_fn = extFn
  } elif opReg or opImm {
    alu_fn = match funct3 {
      == 0 { if opReg and funct7 == 0x20 { 10 } else { 0 } }
      == 2 { 12 }
      == 3 { 14 }
      == 5 { if inst#[30] != 0 { 11 } else { 5 } }
      else { funct3 }
    }
  }
  mem = flush or fpLoad or fpStore or load or store or atomic
  amo = atomic
  mem_cmd = instructionCommand(flush, store=fpStore or store, atomic, atomOp)
  csr = if system { U3(CsrCmd.system) } elif csrOp { funct3 | U3(CsrCmd.system) } else { U3(CsrCmd.none) }
  fence = fenceOp
  fence_i = fenceOp and funct3 == 1
}
