const rowArray = import("DCacheDataArray.DCacheDataArray")
const tiny = import("RocketConfig.tiny")

// A way reads its tag and data in parallel, with one cycle of SRAM latency.
mod way<C>(clk:Clock, clear:U1, read:U1, vaddr:U32, paddr:U32, fillAddr:U32, fillIndex:U32,
    beat:U8, fill:U1, last:U1, invalidated:U1, error:U1, wdata:Unsigned(bits=C.dLen))
    -> (hit:U1@[], fault:U1@[], data:Unsigned(bits=C.dLen)@[]) {
  comptime const sets = C.icacheSets
  comptime const indexEnd = 6 + std.clog2(sets)
  comptime const tagStart = if C.useVM and indexEnd > 12 { 12 } else { indexEnd }
  comptime const tagBits = 32 - tagStart
  reg tags:[sets]Unsigned(bits=tagBits+1):[ordering="old", __store_clock_pin=clk]
  reg present:Unsigned(bits=sets):[clock_pin=clk]
  reg previous:U32:[clock_pin=clk]
  previous = vaddr
  const set = fillIndex % sets
  if clear != 0 { present = 0 }
  elif fill != 0 { present#[set] = last & ~invalidated }
  if (fill & last) != 0 { tags[set] = (error << tagBits) | (fillAddr >> tagStart) }
  const lookup = (previous >> 6) % sets
  const tag = tags[lookup]
  hit = present#[lookup] & U1(tag#[0..<tagBits] == (paddr >> tagStart))
  fault = tag#[tagBits]
  const byteAddr = if fill != 0 { (set << 6) | (beat << std.clog2(C.dLen/8)) } else { vaddr }
  data = rowArray<W=C.dLen, CAPACITY=(sets*64)>(clk=clk, valid=read | fill,
      address=byteAddr#[0..<indexEnd], write=fill & ~invalidated, wdata=wdata, mask=(1 << (C.dLen/8))-1)
}

pub mod ICache<C=tiny>::[timecheck=false](clk:Clock, rst:Reset,
    fetch:U1, vaddr:U32, paddr:U32, killS1:U1, killS2:U1, invalidate:U1,
    aReady:U1, dValid:U1, dOpcode:U4, dData:Unsigned(bits=C.dLen), dCorrupt:U1)
    -> (busy:Bool@[], aValid:U1@[], aAddress:U32@[], acquired:U1@[],
        valid:U1@[], data:U32@[], accessFault:U1@[]) {
  comptime const beatsPerLine = 64 / (C.dLen / 8)
  reg s1Valid:U1
  reg s1Address:U32
  reg s2Valid:U1
  reg s2Hit:U1
  reg s2Data:U32
  reg s2Error:U1
  reg canRefill:U1
  reg filling:U1
  reg fillAddr:U32
  reg beat:U8
  reg fillError:U1
  reg invalidated:U1

  const miss = s2Valid & ~s2Hit & ~killS2
  const available = ~(miss | filling)
  const request = miss & canRefill
  const start = request & aReady
  const hasData = dValid & dOpcode#[0]
  const last = U1(beat == beatsPerLine-1)
  const read = fetch & ~hasData
  const error = dCorrupt | (U1(beat != 0) & fillError)

  // A way larger than one page uses virtual index bits above the page offset.
  // Hold those bits with the refill and compare the entire physical page tag.
  mut fillIndex:U32 = fillAddr >> 6
  if C.useVM and C.icacheSets > 64 {
    reg virtualSet:Unsigned(bits=std.clog2(C.icacheSets))
    if (s1Valid & available) != 0 { virtualSet = (s1Address >> 6) % C.icacheSets }
    fillIndex = virtualSet
  }
  mut chosen = 0
  if C.icacheWays > 1 {
    // Advance replacement for this set only after the line finishes.
    reg victim:[C.icacheSets]Unsigned(bits=std.clog2(C.icacheWays)):[ordering="old"] = 0
    const set = fillIndex % C.icacheSets
    chosen = victim[set]
    if (hasData & last) != 0 { victim[set] = (victim[set] + 1) % C.icacheWays }
  }
  mut hit:U1 = 0
  mut fault:U1 = 0
  mut word:Unsigned(bits=C.dLen) = 0
  for i in 0..<C.icacheWays {
    const w = way<C>(clk=clk, clear=U1(rst) | invalidate, read=read, vaddr=vaddr,
        paddr=paddr, fillAddr=fillAddr, fillIndex=fillIndex, beat=beat, fill=hasData & U1(chosen == i), last=last,
        invalidated=invalidated, error=error, wdata=dData)
    if w.hit != 0 {
      hit = 1
      word = w.data
      fault = w.fault
    }
  }
  if rst {
    s1Valid = 0
    s2Valid = 0
    filling = 0
    beat = 0
  } else {
    s1Valid = read
    s2Valid = s1Valid & ~killS1
    filling = (start | filling) & ~(hasData & last)
    if hasData != 0 { beat = if last != 0 { 0 } else { (beat+1)#[0..<8] } }
  }
  canRefill = available
  invalidated = filling & (invalidate | invalidated)
  if read != 0 { s1Address = vaddr }
  if (s1Valid & available) != 0 { fillAddr = paddr }
  if hasData != 0 { fillError = error }
  s2Hit = hit
  if s1Valid != 0 {
    s2Data = if C.dLen == 64 and s1Address#[2] != 0 { word#[32..<64] } else { word#[0..<32] }
    s2Error = fault
  }
  valid = s2Valid & s2Hit
  data = s2Data
  accessFault = s2Error
  busy = (filling | s1Valid | s2Valid | request) != 0
  aValid = request
  aAddress = fillAddr & 0xffffffc0
  acquired = start
}
