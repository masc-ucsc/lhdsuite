const encodeAtomic = import("CacheAccess.encodeAtomic")
const tiny = import("RocketConfig.tiny")
const cached = import("CacheBanks.CacheBanks")
const command = import("CacheAccess.command")
const attributes = import("PhysicalMap.attributes")
const dtim = import("PhysicalMap.dtim")
const byteMask = import("CacheAccess.byteMask")
const loadData = import("CacheAccess.loadData")
const AMOALU = import("AMOALU.AMOALU")
const DCacheDataArray = import("DCacheDataArray.DCacheDataArray")

// TileLink transfers carry one beat unless a data payload spans multiple beats.
mod lastBeat<W>(clk:Clock, hasData:Bool, rst:Reset, size:U4, transfer:Bool) -> (last:Bool@[]) {
  reg remaining:U10 = 0
  const extra:U10 = if hasData { ((1 << size) - 1)#[std.clog2(W/8)..<12] } else { 0 }
  last = remaining == 1 or extra == 0
  if transfer {
    if remaining == 0 {
      remaining = extra
    } else {
      wrap remaining -= 1
    }
  }
}

pub mod DCache<C=tiny>::[timecheck=false](auto_out_a_ready:U1, auto_out_d_bits_corrupt:U1=0, auto_out_d_bits_data:Unsigned(bits=C.dLen), auto_out_d_bits_denied:U1, auto_out_d_bits_opcode:U4, auto_out_d_bits_size:U4, auto_out_d_valid:U1, clock:Clock, io_ptw_status_debug:U1, memAReady:Bool=false, memBAddress:U32=0, memBParam:U2=0, memBSource:U5=0, memBValid:Bool=false, memCReady:Bool=false, memDCorrupt:Bool=false, memDData:Unsigned(bits=C.dLen)=0, memDDenied:Bool=false, memDOpcode:U3=0, memDParam:U2=0, memDSink:U4=0, memDSource:U5=0, memDValid:Bool=false, memEReady:Bool=false, pmpPermissions:U2, request:(address:Unsigned(bits=C.dLen), command:U5, privilege:U2, virtual:Bool, skipException:Bool, physical:Bool, isSigned:Bool, size:U2, tag:U7, valid:Bool, storeData:Unsigned(bits=C.dLen), storeMask:Unsigned(bits=C.dLen/8), kill:Bool), reset:Reset, translationAE:Bool=false, translationPF:Bool=false) -> (auto_out_d_ready:U1@[], dataA:(address:U32, data:Unsigned(bits=C.dLen), mask:Unsigned(bits=C.dLen/8), opcode:U4, param:U3, size:U4, bufferable:U1, modifiable:U1, privileged:U1, readalloc:U1, writealloc:U1, valid:U1)@[], memAAddress:U32@[], memAParam:U2@[], memASource:U5@[], memAValid:Bool@[], memBReady:Bool@[], memCAddress:U32@[], memCCorrupt:Bool@[], memCData:Unsigned(bits=C.dLen)@[], memCOpcode:U3@[], memCParam:U3@[], memCSource:U5@[], memCValid:Bool@[], memDReady:Bool@[], memESink:U4@[], memEValid:Bool@[], needsClock:Bool@[], pmpAddress:U32@[], pmpPrivilege:U2@[], pmpSize:U2@[], response:(ordered:Bool, perfAcquire:Bool, perfBlocked:Bool, perfCanAcceptLoadThenLoad:Bool, perfCanAcceptStoreThenLoad:Bool, perfCanAcceptStoreThenRMW:Bool, perfGrant:Bool, perfRelease:Bool, perfStoreBufferEmptyAfterLoad:Bool, perfStoreBufferEmptyAfterStore:Bool, replayNext:Bool, reqReady:Bool, respAddr:U32, respCmd:U5, respData:Unsigned(bits=C.dLen), respDataRaw:Unsigned(bits=C.dLen), respDataWordBypass:Unsigned(bits=C.dLen), respDprv:U2, respDv:Bool, respHasData:Bool, respMask:Unsigned(bits=C.dLen/8), respReplay:Bool, respSigned:Bool, respSize:U2, respStoreData:Unsigned(bits=C.dLen), respTag:U7, respError:Bool, respValid:Bool, s2Gpa:U32, s2Nack:Bool, s2NackCauseRaw:Bool, s2Paddr:U32, s2Uncached:Bool, s2XcptAeLd:Bool, s2XcptAeSt:Bool, s2XcptMaLd:Bool, s2XcptMaSt:Bool, s2XcptPfLd:Bool, s2XcptPfSt:Bool)@[]) {
  comptime const lanes = C.dLen/8
  comptime const capacity = C.dcacheSets*C.dcacheBlockBytes
  comptime const indexBits = std.clog2(capacity)
  comptime const offsetBits = std.clog2(lanes)
  type Word = Unsigned(bits=C.dLen)
  type Mask = Unsigned(bits=lanes)
  type Request = (address:U32, tag:U7, cmd:U5, size:U2, sign:Bool, physical:Bool)
  cassert(C.dLen == 32 or C.dLen == 64)
  reg s1PF:Bool = nil
  reg s1AE:Bool = nil
  reg s1AddressOutOfRange:Bool = nil
  reg s1Valid:Bool = false
  reg s1:Request = nil
  reg s1ReqDprv:U2 = nil
  reg s1ReqDv:Bool = nil
  reg s1ReqNoXcpt:Bool = nil

  // Device transactions retain one ordered slot. Coherent responses select
  // their saved CPU metadata by the bank that completed the request.
  reg outstanding:Bool = false
  reg deviceReq:Request = nil
  wire issued:Request = nil
  wire cacheBusy:Bool = nil

  reg s1DidRead:Bool = nil
  reg s2Valid:Bool = false
  reg s2NotNackedInS1:Bool = nil
  reg s2:Request = nil
  reg s2ReqDprv:U2 = nil
  reg s2ReqDv:Bool = nil
  reg s2ReqNoXcpt:Bool = nil

  reg s2TlbXcptGpa:U32 = nil
  reg s2TlbXcptPfLd:Bool = nil
  reg s2TlbXcptPfSt:Bool = nil
  reg s2TlbXcptAeLd:Bool = nil
  reg s2TlbXcptAeSt:Bool = nil
  reg s2TlbXcptMaLd:Bool = nil
  reg s2TlbXcptMaSt:Bool = nil
  reg s2UncachedRespAddr:U32 = nil

  reg s2Data:Word = nil
  reg scratchHit:Bool = nil
  reg pstore1Cmd:U5 = nil
  reg pstore1Addr:U32 = nil
  reg pstore1Data:Word = nil
  reg pstore1Mask:Mask = nil
  reg pstore1RmwR:Bool = nil
  reg pstore2Valid:Bool = false
  reg drainAfterMiss:Bool = nil
  reg pstore1Held:Bool = false
  reg pstore2Addr:U32 = nil
  reg pstore2Data:Word = nil
  reg pstore2Mask:Mask = nil
  reg priorReadHazard:Bool = nil
  reg blockUncachedGrant:Bool = nil
  reg reportFault:Bool = nil
  reg doUncachedResp:Bool = nil
  wire busValid:Bool = nil
  wire busOpcode:U4 = nil
  wire busDenied:Bool = nil
  wire busData:Word = nil
  wire requestReady:Bool = nil
  const s1Live = s1Valid and !request.kill
  const incoming = command(cmd=request.command)
  const stage1 = command(cmd=s1.cmd)
  const stage2 = command(cmd=s2.cmd)
  const s1Access = stage1.read or stage1.write
  const checkAddress = s1Access or (stage1.flushAll and s1.size#[0] != 0) or stage1.checkWrite
  const checkPermissions = s1Live and checkAddress
  const storeMask = byteMask<C.dLen>(addr=s1.address, size=s1.size)
  const storeWriteMask = if stage1.partial { request.storeMask } else { storeMask }
  const s2Access = stage2.read or stage2.write
  // Scratchpad hits complete locally. Coherent and uncached accesses use separate ports.
  const s2Store = s2Valid and stage2.write
  const s1Store = s1Valid and stage1.write
  const storePending = s2Store or pstore1Held
  const bothStores = storePending and pstore2Valid
  const forceDrain = bothStores and (s1Store or pstore1RmwR)
  const arrayRead = request.valid and (request.command != 1 and request.command != 3)
  const drainSlot = !arrayRead or drainAfterMiss
  const storeAddress = if pstore2Valid { pstore2Addr } else { pstore1Addr }
  const arrayWriteData = if pstore2Valid { pstore2Data } else { pstore1Data }
  const arrayMask = if pstore2Valid { pstore2Mask } else { pstore1Mask }
  const store1Conflict = pstore1Addr#[offsetBits..<indexBits] == s1.address#[offsetBits..<indexBits] and (pstore1Mask & storeMask) != 0
  const store2Conflict = pstore2Addr#[offsetBits..<indexBits] == s1.address#[offsetBits..<indexBits] and (pstore2Mask & storeMask) != 0
  const storeConflict = (storePending and store1Conflict) or (pstore2Valid and store2Conflict)
  const readHazard = stage1.read and storeConflict
  // A read/write command puts an atomic operand on A. Partial stores
  // keep their supplied strobes; other transfers derive them from size.
  const writeA = stage2.write
  const partialA = writeA and stage2.partial
  const rmwA = writeA and stage2.read and !partialA
  const maintenance = C.haveCFlush and stage2.flushAll
  const cachedAddress = !C.useDataScratchpad and (s2.address >= 0x80000000 or maintenance)
  const payloadA = cachedAddress or !rmwA or stage2.amo
  const atomic = encodeAtomic(cmd=s2.cmd)
  const requestOpcode:U4 = if !writeA { 4 } elif partialA { 1 } else { atomic.opcode }
  const requestSize:U4 = if payloadA { s2.size } else { 0 }
  wire busSize:U4 = nil
  wire busCorrupt:Bool = nil
  const load = loadData<C.dLen>(addr=s2.address, size=s2.size, sign=U1(s2.sign), data=s2Data)
  const pendingRMW = s2Store and pstore1RmwR
  const nextStoreLoad = !(s1Store and (pendingRMW or bothStores))
  response.perfStoreBufferEmptyAfterLoad = !(s1Store or storePending or pstore2Valid)
  response.perfStoreBufferEmptyAfterStore = !(s1Store or pendingRMW or bothStores)
  response.perfCanAcceptStoreThenLoad = nextStoreLoad
  response.perfCanAcceptStoreThenRMW = nextStoreLoad and !pstore2Valid
  response.perfCanAcceptLoadThenLoad = !(s1Store and (stage1.read or stage1.partial) and (storePending or pstore2Valid))
  mut storeResult:Word = pstore1Data
  if C.useDataScratchpad and C.useAtomics and !C.useAtomicsOnlyForIO and pstore1Cmd >= 8 and pstore1Cmd <= 15 {
    storeResult = AMOALU<C.dLen>(io_mask=pstore1Mask, io_cmd=pstore1Cmd, io_lhs=s2Data, io_rhs=pstore1Data)
  }
  response.s2NackCauseRaw = priorReadHazard
  response.s2Uncached = !scratchHit
  response.s2Paddr = s2.address
  response.respTag = s2.tag
  response.respCmd = s2.cmd
  response.respSize = s2.size
  response.respSigned = s2.sign
  response.respDprv = s2ReqDprv
  response.respDv = s2ReqDv
  response.respMask = 0
  response.respReplay = doUncachedResp
  response.respDataWordBypass = load.bypass
  response.respDataRaw = s2Data
  response.respStoreData = pstore1Data
  response.s2XcptMaLd = reportFault and s2TlbXcptMaLd
  response.s2XcptMaSt = reportFault and s2TlbXcptMaSt
  response.s2XcptPfLd = reportFault and s2TlbXcptPfLd
  response.s2XcptPfSt = reportFault and s2TlbXcptPfSt
  response.s2XcptAeLd = reportFault and s2TlbXcptAeLd
  response.s2XcptAeSt = reportFault and s2TlbXcptAeSt
  response.s2Gpa = s2TlbXcptGpa
  response.ordered = !((s1Valid and !s1ReqNoXcpt) or (s2Valid and !s2ReqNoXcpt) or outstanding or cacheBusy)
  response.perfBlocked = false
  // Translation precedes arbitration. All three clients use the same physical
  // map and PMP checks in stage one, including implicit supervisor PTE reads.
  const region = attributes<BLOCK=C.dcacheBlockBytes, IO_ONLY=C.useAtomicsOnlyForIO, SCRATCH=C.useDataScratchpad, SETS=C.dcacheSets>(address=s1.address, debug=io_ptw_status_debug)
  pmpAddress = s1.address
  pmpSize = s1.size
  pmpPrivilege = s1ReqDprv
  const needsWrite = stage1.write or stage1.flushAll or stage1.checkWrite
  const misaligned = (s1.address & ((1 << s1.size) - 1)) != 0
  const unsupported = (stage1.partial and region.partial == 0) or (stage1.amo and (!C.useAtomics or region.atomic == 0))
  const cachedRAM = !C.useDataScratchpad and s1.address >= 0x80000000
  const badLRSC = stage1.lrsc and (!C.useAtomics or C.useAtomicsOnlyForIO or !cachedRAM)
  const accessError = ((C.vLen != 0 or C.roccOpcodes != 0) and s1.tag == 5 and s1.size > std.clog2(lanes)) or badLRSC or (misaligned and region.effects != 0) or s1AE or s1AddressOutOfRange
  const loadError = stage1.read and (accessError or (region.read & pmpPermissions#[0]) == 0)
  const storeError = (needsWrite and (accessError or (region.write & pmpPermissions#[1]) == 0)) or unsupported
  const inScratchpad = C.useDataScratchpad and dtim<BLOCK=C.dcacheBlockBytes, SETS=C.dcacheSets>(address=s1.address)
  const fault = response.s2XcptMaLd or response.s2XcptMaSt or response.s2XcptPfLd or response.s2XcptPfSt or response.s2XcptAeLd or response.s2XcptAeSt
  const live = s2Valid and !fault
  const accepted = live and s2NotNackedInS1
  const dataHit = accepted and scratchHit and s2Access
  // Arbitration between a stage-two miss, a hit draining the store buffer,
  // and a late data response. An outstanding transfer occupies the miss slot.
  wire flushComplete:Bool = nil
  const finish = maintenance and flushComplete
  const miss = accepted and (s2Access or (maintenance and !finish)) and !scratchHit
  const issueA = miss and !outstanding and (cachedAddress or !cacheBusy)
  const fireA = issueA and requestReady
  const flush:Bool = accepted and stage2.checkWrite
  const handled:Bool = if maintenance { accepted and finish } else { fireA }
  const nack = live and !handled and !flush and !dataHit
  const storeHit = dataHit and stage2.write
  const buffered = storeHit or pstore1Held
  const drainable = (buffered and !pstore1RmwR) or pstore2Valid
  const drain = forceDrain or (drainable and drainSlot)
  const advanceStore = buffered and pstore2Valid == drain
  const acceptStage1 = !((s1Valid and readHazard) or nack)
  const returnsData = busOpcode#[0..<2] == 1 or ((C.vLen != 0 or C.roccOpcodes != 0) and issued.tag == 5)
  const stallD = returnsData and (blockUncachedGrant or s1Valid)
  const dataConflict = stallD and busValid
  const checkFault = checkPermissions and !s1ReqNoXcpt and acceptStage1
  const responseValid = dataHit or doUncachedResp
  mut mergedStore:Word = s2Data
  for i in 0..<lanes {
    const lo = i*8
    if pstore1Mask#[i] != 0 {
      mergedStore#[lo..<(lo + 8)] = storeResult#[lo..<(lo + 8)]
    }
  }
  const arrayBusy = drain or dataConflict
  const arrayAddress = if arrayBusy { storeAddress } else { request.address }
  const writeMask:Mask = if arrayBusy { arrayMask } else { ~Mask(0) }
  const arrayEnable = arrayBusy or arrayRead
  const advanceS1 = s1Valid and acceptStage1
  const busReady = !stallD
  mut data:Word = 0
  if C.useDataScratchpad {
    data = DCacheDataArray<CAPACITY=capacity, W=C.dLen>(valid=arrayEnable, address=arrayAddress#[0..<indexBits], write=drain, wdata=arrayWriteData, mask=writeMask)
  }
  dataA.bufferable = 0
  dataA.modifiable = 0
  dataA.readalloc = 0
  dataA.writealloc = 0
  dataA.privileged = U1(s2ReqDprv == 3)
  const fireD = busReady and busValid
  const lastD = lastBeat<C.dLen>(hasData=busOpcode#[0] != 0, size=busSize, transfer=fireD)
  const lastA = lastBeat<C.dLen>(hasData=requestOpcode#[2] == 0, size=requestSize, transfer=fireA)
  const uncachedTransfer = lastA and fireA
  const replayData = fireD and returnsData
  const resourceBusy = (arrayBusy and incoming.read) or dataConflict
  const cpuReady = acceptStage1 and !resourceBusy
  s1Valid = cpuReady and request.valid
  outstanding = ((fireA and (!cachedAddress)) or outstanding) and !(fireD and lastD and (!cacheBusy))
  s2Valid = s1Live and !stage1.fence
  pstore2Valid = (pstore2Valid and !drain) or advanceStore
  pstore1Held = buffered and pstore2Valid and !drain
  if request.valid {
    s1PF = translationPF
    s1AE = translationAE
    s1AddressOutOfRange = (request.address >> 32) != 0
    s1 = (address=request.address#[0..<32], cmd=request.command, physical=C.haveCFlush and request.physical, sign=request.isSigned, size=request.size, tag=request.tag)
    s1ReqDprv = request.privilege
    s1ReqDv = request.virtual
    s1ReqNoXcpt = request.skipException
    s1DidRead = !arrayBusy and request.valid and (incoming.read or incoming.partial)
  }

  if fireA and !cachedAddress {
    deviceReq = s2
  }
  s2NotNackedInS1 = acceptStage1
  if replayData {
    s2 = (address=(s1.address & ~U32(lanes - 1)) | issued.address#[0..<offsetBits], cmd=0, physical=issued.physical, sign=issued.sign, size=issued.size, tag=issued.tag)
    s2UncachedRespAddr = issued.address
  } elif advanceS1 {
    s2 = s1
  }
  if advanceS1 {
    s2ReqDprv = s1ReqDprv
    s2ReqDv = s1ReqDv
    s2ReqNoXcpt = s1ReqNoXcpt
    s2TlbXcptGpa = s1.address
    s2TlbXcptPfLd = s1PF and stage1.read
    s2TlbXcptPfSt = s1PF and (stage1.write or (C.haveCFlush and stage1.flushAll))
    s2TlbXcptAeLd = (!s1PF) and loadError
    s2TlbXcptAeSt = (!s1PF) and storeError
    s2TlbXcptMaLd = misaligned and stage1.read
    s2TlbXcptMaSt = misaligned and stage1.write
    scratchHit = inScratchpad
  }

  if replayData {
    s2Data = busData
  } elif s1Valid {
    s2Data = if s1DidRead { data } else { 0 }
  }
  if advanceS1 and stage1.write {
    pstore1Cmd = s1.cmd
    pstore1Addr = s1.address
    pstore1Data = request.storeData
    pstore1Mask = storeWriteMask
    pstore1RmwR = stage1.read or stage1.partial
  }
  drainAfterMiss = nack
  if advanceStore {
    pstore2Addr = pstore1Addr
    pstore2Data = mergedStore
    pstore2Mask = pstore1Mask
  }
  priorReadHazard = readHazard
  blockUncachedGrant = if dataConflict { drain } else { arrayEnable }

  reportFault = checkFault
  reg replayError:Bool = nil
  if replayData {
    replayError = busDenied or busCorrupt
  }
  response.respError = doUncachedResp and replayError
  doUncachedResp = replayData
  dataA.valid = U1(issueA and (!cachedAddress))
  dataA.opcode = requestOpcode
  dataA.param = if rmwA { atomic.param } else { 0 }
  dataA.size = requestSize
  dataA.address = if payloadA { s2.address } else { 0 }
  dataA.mask = if partialA { pstore1Mask } elif payloadA { byteMask<C.dLen>(addr=s2.address, size=s2.size) } else { 0 }
  dataA.data = if writeA and payloadA { pstore1Data } else { 0 }
  // A source identifies the saved request on a late coherent response.
  // Device accesses share one separate slot and drain coherent traffic.
  mut bankClock = false
  mut fromCache = false
  mut cachedReady = false
  mut cachedValid = false
  mut cachedError = false
  mut cachedData:Word = 0
  mut cachedSize:U4 = 0
  mut cachedOpcode:U4 = 0
  if !C.useDataScratchpad {
    comptime const banks = if C.nMSHRs > 0 { C.nMSHRs } else { 1 }
    reg requests:[banks]Request:[ordering="old"] = nil
    const issue = cachedAddress and issueA
    const c = cached<C=C, N=banks>(request=issue, address=s2.address, command=s2.cmd, flushSize=s2.size, mask=dataA.mask, data=dataA.data, responseReady=busReady, aReady=memAReady, bValid=memBValid, bAddress=memBAddress, bParam=memBParam, bSource=memBSource, cReady=memCReady, dValid=memDValid, dOpcode=memDOpcode, dParam=memDParam, dSource=memDSource, dSink=memDSink, dData=memDData, dDenied=memDDenied, dCorrupt=memDCorrupt, eReady=memEReady)
    if issue and c.ready {
      requests[c.issueBank%banks] = s2
    }
    const completed = requests[c.returnBank%banks]
    issued = if c.busy { completed } else { deviceReq }
    bankClock = c.needsClock
    cacheBusy = c.busy
    fromCache = c.busy
    cachedReady = c.ready
    cachedValid = c.response
    cachedError = c.error
    cachedSize = completed.size
    const completedOp = command(cmd=completed.cmd)
    cachedOpcode = U1(completedOp.read)
    cachedData = c.result
    if C.dLen == 64 and completedOp.sc and completed.size == 2 {
      cachedData = (c.result#[0] << 32) | c.result#[0]
    }
    response.perfAcquire = (uncachedTransfer and (!cachedAddress)) or (c.aValid and memAReady)
    response.perfRelease = c.cLast
    memAValid = c.aValid
    memAAddress = c.aAddress
    memAParam = c.aParam
    memASource = c.aSource
    memBReady = c.bReady
    memCValid = c.cValid
    memCAddress = c.cAddress
    memCOpcode = c.cOpcode
    memCParam = c.cParam
    memCSource = c.cSource
    memCData = c.cData
    memCCorrupt = c.cCorrupt
    memDReady = c.dReady
    memEValid = c.eValid
    memESink = c.eSink
  } else {
    issued = deviceReq
    cacheBusy = false
    memAValid = false
    memAAddress = 0
    memAParam = 0
    memASource = 0
    memBReady = false
    response.perfAcquire = uncachedTransfer
    response.perfRelease = false
    memCValid = false
    memCAddress = 0
    memCOpcode = 0
    memCParam = 0
    memCSource = 0
    memCData = 0
    memCCorrupt = false
    memDReady = false
    memEValid = false
    memESink = 0
  }
  if C.haveCFlush {
    // Keep the release receipt through speculative page walks. They share
    // the miss slot and can overwrite issued before the CPU replays.
    reg completed:Bool = false
    reg mode:U2 = nil
    reg line:Unsigned(bits=32 - std.clog2(C.dcacheBlockBytes)) = nil
    flushComplete = completed and mode == s2.size and (mode#[0] == 0 or line == s2.address >> std.clog2(C.dcacheBlockBytes))
    if fireD and fromCache and issued.cmd == 5 {
      completed = true
      mode = issued.size
      line = issued.address >> std.clog2(C.dcacheBlockBytes)
    }
    if (fireA and (!s2.physical or stage2.write)) or (accepted and finish) {
      completed = false
    }
  } else {
    flushComplete = false
  }
  requestReady = if cachedAddress { cachedReady } else { auto_out_a_ready != 0 }
  busValid = if fromCache { cachedValid } else { auto_out_d_valid != 0 }
  busOpcode = if fromCache { cachedOpcode } else { auto_out_d_bits_opcode }
  busDenied = if fromCache { cachedError } else { auto_out_d_bits_denied != 0 }
  busData = if fromCache { cachedData } else { auto_out_d_bits_data }
  busSize = if fromCache { cachedSize } else { auto_out_d_bits_size }
  busCorrupt = if fromCache { cachedError } else { auto_out_d_bits_corrupt != 0 }
  auto_out_d_ready = U1(busReady and (!fromCache))
  needsClock = request.valid or s1Valid or s2Valid or pstore1Held or pstore2Valid or doUncachedResp or outstanding or auto_out_d_valid != 0 or bankClock or memBValid or memDValid
  response.reqReady = cpuReady
  response.s2Nack = nack
  response.respValid = responseValid
  response.respAddr = if doUncachedResp { s2UncachedRespAddr } else { s2.address }
  response.respData = load.value
  response.respHasData = stage2.read
  response.replayNext = replayData
  response.perfGrant = busValid and lastD
}
