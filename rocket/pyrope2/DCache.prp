const cached = import("CoherentDataCache.CoherentDataCache")
const command = import("CacheAccess.command")
const attributes = import("PhysicalMap.attributes")
const dtim = import("PhysicalMap.dtim")
const byteMask = import("CacheAccess.byteMask")
const loadData = import("CacheAccess.loadData")
const AMOALU = import("AMOALU.AMOALU")
const DCacheDataArray = import("DCacheDataArray.DCacheDataArray")

// TileLink transfers carry one beat unless a data payload spans multiple beats.
mod lastBeat<W>(clk:Clock, rst:Reset, transfer:U1, hasData:U1, size:U4) -> (last:U1@[]) {
  reg remaining:U10 = 0
  const extra:U10 = if hasData != 0 { ((1 << size)-1)#[std.clog2(W/8)..<12] } else { 0 }
  last = U1(remaining == 1 or extra == 0)
  if transfer != 0 {
    if remaining == 0 { remaining = extra } else { wrap remaining -= 1 }
  }
}

pub mod DCache<W=32, ATOMICS=true, SETS=256, SCRATCH=true, WAYS=4, IO_ONLY=false, CFLUSH=false>::[timecheck=false](`clock`:Clock, `reset`:U1, auto_out_a_ready:U1, auto_out_d_valid:U1, auto_out_d_bits_opcode:U4, auto_out_d_bits_size:U4, auto_out_d_bits_corrupt:U1=0, auto_out_d_bits_denied:U1, auto_out_d_bits_data:Unsigned(bits=W), translationPF:Bool=false, translationAE:Bool=false, io_cpu_req_valid:U1, io_cpu_req_bits_addr:Unsigned(bits=W), io_cpu_req_bits_tag:U7, io_cpu_req_bits_cmd:U5, io_cpu_req_bits_size:U2, io_cpu_req_bits_signed:U1, io_cpu_req_bits_dprv:U2, io_cpu_req_bits_dv:U1, io_cpu_req_bits_phys:U1, io_cpu_req_bits_no_xcpt:U1, io_cpu_s1_kill:U1, io_cpu_s1_data_data:Unsigned(bits=W), io_cpu_s1_data_mask:Unsigned(bits=W/8), io_ptw_status_debug:U1, pmpPermissions:U2,
    memAReady:Bool=false, memBValid:Bool=false, memBAddress:U32=0, memBParam:U2=0,
    memBSource:U5=0, memCReady:Bool=false, memDValid:Bool=false, memDOpcode:U3=0,
    memDParam:U2=0, memDSource:U5=0, memDSink:U4=0, memDData:Unsigned(bits=W)=0,
    memDDenied:Bool=false, memDCorrupt:Bool=false, memEReady:Bool=false) -> (pmpAddress:U32@[], pmpSize:U2@[], pmpPrivilege:U2@[], auto_out_a_valid:U1@[], auto_out_a_bits_opcode:U4@[], auto_out_a_bits_param:U3@[], auto_out_a_bits_size:U4@[], auto_out_a_bits_address:U32@[], auto_out_a_bits_user_amba_prot_bufferable:U1@[], auto_out_a_bits_user_amba_prot_modifiable:U1@[], auto_out_a_bits_user_amba_prot_readalloc:U1@[], auto_out_a_bits_user_amba_prot_writealloc:U1@[], auto_out_a_bits_user_amba_prot_privileged:U1@[], auto_out_a_bits_mask:Unsigned(bits=W/8)@[], auto_out_a_bits_data:Unsigned(bits=W)@[], auto_out_d_ready:U1@[], io_cpu_req_ready:U1@[], io_cpu_s2_nack:U1@[], io_cpu_s2_nack_cause_raw:U1@[], io_cpu_s2_uncached:U1@[], io_cpu_s2_paddr:U32@[], io_cpu_resp_valid:U1@[], io_cpu_resp_error:U1@[], io_cpu_resp_bits_addr:U32@[], io_cpu_resp_bits_tag:U7@[], io_cpu_resp_bits_cmd:U5@[], io_cpu_resp_bits_size:U2@[], io_cpu_resp_bits_signed:U1@[], io_cpu_resp_bits_dprv:U2@[], io_cpu_resp_bits_dv:U1@[], io_cpu_resp_bits_data:Unsigned(bits=W)@[], io_cpu_resp_bits_mask:Unsigned(bits=W/8)@[], io_cpu_resp_bits_replay:U1@[], io_cpu_resp_bits_has_data:U1@[], io_cpu_resp_bits_data_word_bypass:Unsigned(bits=W)@[], io_cpu_resp_bits_data_raw:Unsigned(bits=W)@[], io_cpu_resp_bits_store_data:Unsigned(bits=W)@[], io_cpu_replay_next:U1@[], io_cpu_s2_xcpt_ma_ld:U1@[], io_cpu_s2_xcpt_ma_st:U1@[], io_cpu_s2_xcpt_pf_ld:U1@[], io_cpu_s2_xcpt_pf_st:U1@[], io_cpu_s2_xcpt_ae_ld:U1@[], io_cpu_s2_xcpt_ae_st:U1@[], io_cpu_s2_gpa:U32@[], io_cpu_ordered:U1@[], io_cpu_perf_release:U1@[], io_cpu_perf_acquire:U1@[], io_cpu_perf_grant:U1@[], io_cpu_perf_blocked:U1@[], io_cpu_perf_canAcceptStoreThenLoad:U1@[], io_cpu_perf_canAcceptStoreThenRMW:U1@[], io_cpu_perf_canAcceptLoadThenLoad:U1@[], io_cpu_perf_storeBufferEmptyAfterLoad:U1@[], io_cpu_perf_storeBufferEmptyAfterStore:U1@[],
    memAValid:Bool@[], memAAddress:U32@[], memAParam:U2@[], memASource:U5@[],
    memBReady:Bool@[], memCValid:Bool@[], memCAddress:U32@[], memCOpcode:U3@[],
    memCParam:U3@[], memCSource:U5@[], memCData:Unsigned(bits=W)@[], memCCorrupt:Bool@[],
    memDReady:Bool@[], memEValid:Bool@[], memESink:U4@[]) {
  comptime const lanes = W / 8
  comptime const capacity = SETS * 64
  comptime const indexBits = std.clog2(capacity)
  comptime const offsetBits = std.clog2(lanes)
  type Word = Unsigned(bits=W)
  type Mask = Unsigned(bits=lanes)
  type Request = (address:U32, tag:U7, cmd:U5, size:U2, sign:U1, physical:Bool)
  cassert(W == 32 or W == 64)
  reg s1PF:Bool
  reg s1AE:Bool
  reg s1AddressOutOfRange:Bool

  reg s1_valid:U1
  reg s1:Request = nil
  reg s1_req_dprv:U2
  reg s1_req_dv:U1

  reg s1_req_no_xcpt:U1

  reg outstanding:U1
  reg issued:Request = nil


  reg s1_did_read:U1
  reg s2_valid:U1
  reg s2_not_nacked_in_s1:U1
  reg s2:Request = nil
  reg s2_req_dprv:U2
  reg s2_req_dv:U1

  reg s2_req_no_xcpt:U1

  reg s2_tlb_xcpt_gpa:U32
  reg s2_tlb_xcpt_pf_ld:U1
  reg s2_tlb_xcpt_pf_st:U1
  reg s2_tlb_xcpt_ae_ld:U1
  reg s2_tlb_xcpt_ae_st:U1
  reg s2_tlb_xcpt_ma_ld:U1
  reg s2_tlb_xcpt_ma_st:U1

  reg s2_uncached_resp_addr:U32

  reg s2_data:Word
  reg scratchHit:U1
  reg pstore1_cmd:U5
  reg pstore1_addr:U32
  reg pstore1_data:Word

  reg pstore1_mask:Mask
  reg pstore1_rmw_r:U1
  reg pstore2_valid:U1
  reg drainAfterMiss:U1
  reg pstore1_held:U1
  reg pstore2_addr:U32

  reg pstore2Data:Word
  reg pstore2_storegen_mask:Mask
  reg priorReadHazard:U1
  reg blockUncachedGrant:U1

  reg reportFault:U1
  reg doUncachedResp:U1
  wire busValid:U1 = nil
  wire busOpcode:U4 = nil
  wire busDenied:U1 = nil
  wire busData:Word = nil
  wire requestReady:U1 = nil
  const s1Live = s1_valid & ~io_cpu_s1_kill
  const incoming = command(cmd=io_cpu_req_bits_cmd)
  const stage1 = command(cmd=s1.cmd)
  const stage2 = command(cmd=s2.cmd)
  const s1Access = stage1.read | stage1.write
  const s1Fence = U1(s1.cmd >= 20 and s1.cmd <= 22)
  const checkAddress = s1Access != 0 or (s1.cmd == 5 and s1.size#[0] != 0) or s1.cmd == 23
  const checkPermissions = s1Live & U1(checkAddress)
  const storeMask = byteMask<W>(addr=s1.address, size=s1.size)
  const storeWriteMask = if s1.cmd == 17 { io_cpu_s1_data_mask } else { storeMask }
  const s2Access = stage2.read | stage2.write
  // Scratchpad hits complete locally. Every other request uses the shared
  // miss slot, which selects either the coherent cache or the TileLink I/O port.
  const s2Store = s2_valid & stage2.write
  const s1Store = s1_valid & stage1.write
  const storePending = s2Store | pstore1_held
  const bothStores = storePending & pstore2_valid
  const forceDrain = bothStores & (s1Store | pstore1_rmw_r)
  const arrayRead = io_cpu_req_valid & U1(io_cpu_req_bits_cmd != 1 and io_cpu_req_bits_cmd != 3)
  const drainSlot = ~arrayRead | drainAfterMiss
  const storeAddress = if pstore2_valid != 0 { pstore2_addr } else { pstore1_addr }
  const arrayWriteData = if pstore2_valid != 0 { pstore2Data } else { pstore1_data }
  const arrayMask = if pstore2_valid != 0 { pstore2_storegen_mask } else { pstore1_mask }
  const store1Conflict = pstore1_addr#[offsetBits..<indexBits] == s1.address#[offsetBits..<indexBits] and (pstore1_mask & storeMask) != 0
  const store2Conflict = pstore2_addr#[offsetBits..<indexBits] == s1.address#[offsetBits..<indexBits] and (pstore2_storegen_mask & storeMask) != 0
  const storeConflict = (storePending & U1(store1Conflict)) | (pstore2_valid & U1(store2Conflict))
  const readHazard = stage1.read & storeConflict
  // A read/write command puts an atomic operand on A. Partial stores
  // keep their supplied strobes; other transfers derive them from size.
  const writeA = stage2.write != 0
  const partialA = writeA and stage2.partial != 0
  const rmwA = writeA and stage2.read != 0 and !partialA
  const maintenance = CFLUSH and s2.cmd == 5
  const cachedAddress = !SCRATCH and (s2.address >= 0x80000000 or maintenance)
  const payloadA = cachedAddress or !rmwA or stage2.amo != 0
  const atomicOpcode = match s2.cmd { in (4,9,10,11) { 3 } in (8,12,13,14,15) { 2 } else { 0 } }
  const atomicParam = match s2.cmd {
    in (4,15) { 3 } in (10,13) { 1 } in (11,14) { 2 } == 8 { 4 } else { 0 }
  }
  const requestOpcode:U4 = if !writeA { 4 } elif partialA { 1 } else { atomicOpcode }
  const requestSize:U4 = if payloadA { s2.size } else { 0 }
  wire busSize:U4 = nil
  wire busCorrupt:U1 = nil
  const load = loadData<W>(addr=s2.address, size=s2.size, sign=s2.sign, data=s2_data)
  const pendingRMW = s2Store & pstore1_rmw_r
  const nextStoreLoad = ~(s1Store & (pendingRMW | bothStores))#[0]
  io_cpu_perf_storeBufferEmptyAfterLoad = ~(s1Store | storePending | pstore2_valid)#[0]
  io_cpu_perf_storeBufferEmptyAfterStore = ~(s1Store | pendingRMW | bothStores)#[0]
  io_cpu_perf_canAcceptStoreThenLoad = nextStoreLoad
  io_cpu_perf_canAcceptStoreThenRMW = nextStoreLoad & ~pstore2_valid
  io_cpu_perf_canAcceptLoadThenLoad = ~(s1Store & (stage1.read | stage1.partial) & (storePending | pstore2_valid))#[0]
  mut storeResult:Word = pstore1_data
  if SCRATCH and ATOMICS and !IO_ONLY and pstore1_cmd >= 8 and pstore1_cmd <= 15 {
    storeResult = AMOALU<W>(io_mask=pstore1_mask, io_cmd=pstore1_cmd, io_lhs=s2_data, io_rhs=pstore1_data)
  }
  io_cpu_s2_nack_cause_raw = priorReadHazard
  io_cpu_s2_uncached = ~scratchHit
  io_cpu_s2_paddr = s2.address
  io_cpu_resp_bits_tag = s2.tag
  io_cpu_resp_bits_cmd = s2.cmd
  io_cpu_resp_bits_size = s2.size
  io_cpu_resp_bits_signed = s2.sign
  io_cpu_resp_bits_dprv = s2_req_dprv
  io_cpu_resp_bits_dv = s2_req_dv
  io_cpu_resp_bits_mask = 0
  io_cpu_resp_bits_replay = doUncachedResp
  io_cpu_resp_bits_data_word_bypass = load.bypass
  io_cpu_resp_bits_data_raw = s2_data
  io_cpu_resp_bits_store_data = pstore1_data
  io_cpu_s2_xcpt_ma_ld = reportFault & s2_tlb_xcpt_ma_ld
  io_cpu_s2_xcpt_ma_st = reportFault & s2_tlb_xcpt_ma_st
  io_cpu_s2_xcpt_pf_ld = reportFault & s2_tlb_xcpt_pf_ld
  io_cpu_s2_xcpt_pf_st = reportFault & s2_tlb_xcpt_pf_st
  io_cpu_s2_xcpt_ae_ld = reportFault & s2_tlb_xcpt_ae_ld
  io_cpu_s2_xcpt_ae_st = reportFault & s2_tlb_xcpt_ae_st
  io_cpu_s2_gpa = s2_tlb_xcpt_gpa
  io_cpu_ordered = ~((s1_valid & ~s1_req_no_xcpt) | (s2_valid & ~s2_req_no_xcpt) | outstanding)
  io_cpu_perf_blocked = 0
  // Translation precedes arbitration. All three clients use the same physical
  // map and PMP checks in stage one, including implicit supervisor PTE reads.
  const region = attributes<SETS=SETS,SCRATCH=SCRATCH,IO_ONLY=IO_ONLY>(address=s1.address, debug=io_ptw_status_debug)
  pmpAddress = s1.address
  pmpSize = s1.size
  pmpPrivilege = s1_req_dprv
  const needsWrite = stage1.write != 0 or s1.cmd == 5 or s1.cmd == 23
  const misaligned = (s1.address & ((1 << s1.size)-1)) != 0
  const unsupported = (stage1.partial != 0 and region.partial == 0) or (stage1.amo != 0 and (!ATOMICS or region.atomic == 0))
  const cachedRAM = !SCRATCH and s1.address >= 0x80000000
  const badLRSC = stage1.lrsc != 0 and (!ATOMICS or IO_ONLY or !cachedRAM)
  const accessError = badLRSC or (misaligned and region.effects != 0) or s1AE or s1AddressOutOfRange
  const loadError = stage1.read & U1(accessError or (region.read & pmpPermissions#[0]) == 0)
  const storeError = U1((needsWrite and (accessError or (region.write & pmpPermissions#[1]) == 0)) or unsupported)
  const inScratchpad = U1(SCRATCH and dtim<SETS>(address=s1.address))
  const fault = io_cpu_s2_xcpt_ma_ld | io_cpu_s2_xcpt_ma_st | io_cpu_s2_xcpt_pf_ld | io_cpu_s2_xcpt_pf_st |
      io_cpu_s2_xcpt_ae_ld | io_cpu_s2_xcpt_ae_st
  const live = s2_valid & ~fault
  const accepted = live & s2_not_nacked_in_s1
  const dataHit = accepted & scratchHit & s2Access
  // Arbitration between a stage-two miss, a hit draining the store buffer,
  // and a late data response. An outstanding transfer occupies the miss slot.
  wire flushComplete:Bool = nil
  const finish = maintenance and flushComplete
  const miss = accepted & (s2Access | U1(maintenance and !finish)) & ~scratchHit#[0]
  const issueA = miss & ~outstanding
  const fireA = issueA & requestReady
  const flush:U1 = accepted & U1(s2.cmd == 23)
  const handled:U1 = if maintenance { accepted & U1(finish) } else { fireA }
  const nack = live & ~handled & ~flush & ~dataHit#[0]
  const storeHit = dataHit & stage2.write
  const buffered = storeHit | pstore1_held
  const drainable = (buffered & ~pstore1_rmw_r#[0]) | pstore2_valid
  const drain = forceDrain | (drainable & drainSlot)
  const advanceStore = buffered & U1(pstore2_valid == drain)
  const acceptStage1 = ~((s1_valid & readHazard) | nack)#[0]
  const returnsData = U1(busOpcode#[0..<2] == 1)
  const stallD = returnsData & (blockUncachedGrant | s1_valid)
  const dataConflict = stallD & busValid
  const checkFault = checkPermissions & ~s1_req_no_xcpt & acceptStage1
  const responseValid = dataHit | doUncachedResp
  mut mergedStore:Word = s2_data
  for i in 0..<lanes {
    const lo = i * 8
    if pstore1_mask#[i] != 0 { mergedStore#[lo..<(lo+8)] = storeResult#[lo..<(lo+8)] }
  }
  const arrayBusy = drain | dataConflict
  const arrayAddress = if arrayBusy != 0 { storeAddress } else { io_cpu_req_bits_addr }
  const writeMask:Mask = if arrayBusy != 0 { arrayMask } else { ~Mask(0) }
  const arrayEnable = arrayBusy | arrayRead
  const advanceS1 = s1_valid & acceptStage1
  const busReady = ~stallD#[0]
  mut data:Word = 0
  if SCRATCH {
    data = DCacheDataArray<W=W, CAPACITY=capacity>(clk=`clock`, valid=arrayEnable, address=arrayAddress#[0..<indexBits],
        write=drain, wdata=arrayWriteData, mask=writeMask)
  }
  auto_out_a_bits_user_amba_prot_bufferable = 0
  auto_out_a_bits_user_amba_prot_modifiable = 0
  auto_out_a_bits_user_amba_prot_readalloc = 0
  auto_out_a_bits_user_amba_prot_writealloc = 0
  auto_out_a_bits_user_amba_prot_privileged = U1(s2_req_dprv == 3)
  const fireD = busReady & busValid
  const lastD = lastBeat<W>(clk=`clock`, rst=`reset` != 0, transfer=fireD, hasData=busOpcode#[0], size=busSize)
  const lastA = lastBeat<W>(clk=`clock`, rst=`reset` != 0, transfer=fireA, hasData=~requestOpcode#[2], size=requestSize)
  const uncachedTransfer = lastA & fireA
  const replayData = fireD & returnsData
  const resourceBusy = (arrayBusy & incoming.read) | dataConflict
  const cpuReady = acceptStage1 & ~resourceBusy#[0]
  if `reset` != 0 {
    s1_valid = 0
    outstanding = 0
    s2_valid = 0
    pstore2_valid = 0
    pstore1_held = 0
  } else {
    s1_valid = cpuReady & io_cpu_req_valid
    outstanding = (fireA | outstanding) & ~(fireD & lastD)#[0]
    s2_valid = s1Live & ~s1Fence
    pstore2_valid = (pstore2_valid & ~drain#[0]) | advanceStore
    pstore1_held = buffered & pstore2_valid & ~drain#[0]
  }
  if io_cpu_req_valid != 0 {
    s1PF = translationPF
    s1AE = translationAE
    s1AddressOutOfRange = (io_cpu_req_bits_addr >> 32) != 0
    s1 = (address=io_cpu_req_bits_addr#[0..<32], tag=io_cpu_req_bits_tag, cmd=io_cpu_req_bits_cmd,
          size=io_cpu_req_bits_size, sign=io_cpu_req_bits_signed, physical=CFLUSH and io_cpu_req_bits_phys != 0)
    s1_req_dprv = io_cpu_req_bits_dprv
    s1_req_dv = io_cpu_req_bits_dv
    s1_req_no_xcpt = io_cpu_req_bits_no_xcpt
    s1_did_read = ~arrayBusy#[0] & io_cpu_req_valid & (incoming.read | incoming.partial)
  }

  if fireA != 0 { issued = s2 }
  s2_not_nacked_in_s1 = acceptStage1
  if replayData != 0 {
    s2 = (address=(s1.address & ~U32(lanes-1)) | issued.address#[0..<offsetBits],
          cmd=0, tag=issued.tag, size=issued.size, sign=issued.sign, physical=issued.physical)
    s2_uncached_resp_addr = issued.address
  } elif advanceS1 != 0 { s2 = s1 }
  if advanceS1 != 0 {
    s2_req_dprv = s1_req_dprv
    s2_req_dv = s1_req_dv
    s2_req_no_xcpt = s1_req_no_xcpt
    s2_tlb_xcpt_gpa = s1.address
    s2_tlb_xcpt_pf_ld = U1(s1PF) & stage1.read
    s2_tlb_xcpt_pf_st = U1(s1PF and (stage1.write != 0 or (CFLUSH and s1.cmd == 5)))
    s2_tlb_xcpt_ae_ld = U1(!s1PF) & loadError
    s2_tlb_xcpt_ae_st = U1(!s1PF) & storeError
    s2_tlb_xcpt_ma_ld = U1(misaligned) & stage1.read
    s2_tlb_xcpt_ma_st = U1(misaligned) & stage1.write
    scratchHit = inScratchpad
  }


  if replayData != 0 { s2_data = busData }
  elif s1_valid != 0 { s2_data = if s1_did_read != 0 { data } else { 0 } }
  if advanceS1 != 0 and stage1.write != 0 {
    pstore1_cmd = s1.cmd
    pstore1_addr = s1.address
    pstore1_data = io_cpu_s1_data_data

    pstore1_mask = storeWriteMask
    pstore1_rmw_r = stage1.read | stage1.partial
  }
  drainAfterMiss = nack
  if advanceStore != 0 {
    pstore2_addr = pstore1_addr

    pstore2Data = mergedStore
    pstore2_storegen_mask = pstore1_mask
  }
  priorReadHazard = readHazard
  blockUncachedGrant = if dataConflict != 0 { drain } else { arrayEnable }

  reportFault = checkFault
  reg replayError:U1
  if replayData != 0 { replayError = busDenied | busCorrupt }
  io_cpu_resp_error = doUncachedResp & replayError
  doUncachedResp = replayData
  auto_out_a_valid = issueA & U1(!cachedAddress)
  auto_out_a_bits_opcode = requestOpcode
  auto_out_a_bits_param = if rmwA { atomicParam } else { 0 }
  auto_out_a_bits_size = requestSize
  auto_out_a_bits_address = if payloadA { s2.address } else { 0 }
  auto_out_a_bits_mask = if partialA { pstore1_mask } elif payloadA { byteMask<W>(addr=s2.address, size=s2.size) } else { 0 }
  auto_out_a_bits_data = if writeA and payloadA { pstore1_data } else { 0 }
  // Only one stage-two transaction can be outstanding. Save its return
  // shape when A fires, so later CPU requests cannot redirect its response.
  mut fromCache = false
  mut cachedReady = false
  mut cachedValid = false
  mut cachedError = false
  mut cachedData:Word = 0
  mut cachedSize:U4 = 0
  mut cachedOpcode:U4 = 0
  if !SCRATCH {
    reg pending:Bool:[initial=false, reset_pin=`reset`, async=false]
    reg expectsData:Bool = nil
    reg savedSize:U2 = nil
    reg conditional:Bool = nil
    const issue = cachedAddress and issueA != 0
    const c = cached<W=W,SETS=SETS,WAYS=WAYS,CFLUSH=CFLUSH,ATOMICS=(ATOMICS and !IO_ONLY)>(clk=`clock`,rst=`reset` != 0,
        request=issue,address=s2.address,command=s2.cmd,flushSize=s2.size,mask=auto_out_a_bits_mask,data=auto_out_a_bits_data,
        responseReady=busReady != 0,aReady=memAReady,bValid=memBValid,bAddress=memBAddress,bParam=memBParam,
        bSource=memBSource,cReady=memCReady,dValid=memDValid,dOpcode=memDOpcode,dParam=memDParam,dSource=memDSource,
        dSink=memDSink,dData=memDData,dDenied=memDDenied,dCorrupt=memDCorrupt,eReady=memEReady)
    if issue and c.ready {
      pending = true
      expectsData = stage2.read != 0
      savedSize = s2.size
      conditional = s2.cmd == 7
    }
    if `reset` != 0 or (c.response and busReady != 0) { pending = false }
    fromCache = pending
    cachedReady = c.ready
    cachedValid = c.response
    cachedError = c.error
    cachedSize = savedSize
    cachedOpcode = U1(expectsData)
    cachedData = c.result
    if W == 64 and conditional and savedSize == 2 { cachedData = (c.result#[0] << 32) | c.result#[0] }
    io_cpu_perf_acquire = (uncachedTransfer & U1(!cachedAddress)) | U1(c.aValid and memAReady)
    io_cpu_perf_release = U1(c.cLast)
    memAValid = c.aValid
    memAAddress = c.aAddress
    memAParam = c.aParam
    memASource = c.aSource
    memBReady = c.bReady
    memCValid = c.cValid
    memCAddress = c.cAddress
    memCOpcode = c.cOpcode
    memCParam = c.cParam
    memCSource = c.cSource
    memCData = c.cData
    memCCorrupt = c.cCorrupt
    memDReady = c.dReady
    memEValid = c.eValid
    memESink = c.eSink
  } else {
    memAValid = false
    memAAddress = 0
    memAParam = 0
    memASource = 0
    memBReady = false
    io_cpu_perf_acquire = uncachedTransfer
    io_cpu_perf_release = 0
    memCValid = false
    memCAddress = 0
    memCOpcode = 0
    memCParam = 0
    memCSource = 0
    memCData = 0
    memCCorrupt = false
    memDReady = false
    memEValid = false
    memESink = 0
  }
  if CFLUSH {
    // Keep the release receipt through speculative page walks. They share
    // the miss slot and can overwrite issued before the CPU replays.
    reg completed:Bool = nil
    reg mode:U2 = nil
    reg line:U26 = nil
    flushComplete = completed and mode == s2.size and (mode#[0] == 0 or line == s2.address >> 6)
    if fireD != 0 and fromCache and issued.cmd == 5 {
      completed = true; mode = issued.size; line = issued.address >> 6
    }
    if `reset` != 0 or (fireA != 0 and (!s2.physical or stage2.write != 0)) or (accepted != 0 and finish) { completed = false }
  } else { flushComplete = false }
  requestReady = if cachedAddress { U1(cachedReady) } else { auto_out_a_ready }
  busValid = if fromCache { U1(cachedValid) } else { auto_out_d_valid }
  busOpcode = if fromCache { cachedOpcode } else { auto_out_d_bits_opcode }
  busDenied = if fromCache { U1(cachedError) } else { auto_out_d_bits_denied }
  busData = if fromCache { cachedData } else { auto_out_d_bits_data }
  busSize = if fromCache { cachedSize } else { auto_out_d_bits_size }
  busCorrupt = if fromCache { U1(cachedError) } else { auto_out_d_bits_corrupt }
  auto_out_d_ready = busReady & U1(!fromCache)
  io_cpu_req_ready = cpuReady
  io_cpu_s2_nack = nack
  io_cpu_resp_valid = responseValid
  io_cpu_resp_bits_addr = if doUncachedResp != 0 { s2_uncached_resp_addr } else { s2.address }
  io_cpu_resp_bits_data = load.value
  io_cpu_resp_bits_has_data = stage2.read
  io_cpu_replay_next = replayData
  io_cpu_perf_grant = busValid & lastD & 1
}
