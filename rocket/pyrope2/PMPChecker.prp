const protection = import("PhysicalProtection")

// Lower-numbered entries have priority even when they only cover part of an access.
pub comb PMPChecker<N=8>(table:protection.Entries, privilege:U2, address:U32, size:U4) -> (permissions:U3) {
  cassert(N >= 0 and N <= 16)
  const machine = privilege > 1
  const accessMask:U32 = (1 << size) - 1
  const last = address | accessMask
  permissions = if N == 0 or machine { 7 } else { 0 }
  mut lower:U32 = 0
  mut matched = false
  for i in 0..<N {
    const cfg = table.cfg[i]
    const mode = cfg#[3..<5]
    const encoded = table.addr[i]
    const base:U32 = encoded << 2
    const mask = protection.addressMask(encoded=encoded, mode=mode)
    const powerOfTwo = mode#[1] != 0
    const touches = if powerOfTwo { ((address ^ base) & ~(mask | accessMask)#[0..<32]) == 0 }
        else { mode == 1 and lower < base and address < base and last >= lower }
    if touches and !matched {
      matched = true
      const fits = if powerOfTwo { (accessMask & ~mask) == 0 } else { address >= lower and last < base }
      permissions = if !fits { 0 } elif machine and cfg#[7] == 0 { 7 } else { cfg#[0..<3] }
    }
    lower = base
  }
}
