const NonSyncResetSynchronizerPrimitiveShiftReg_d3 = import("NonSyncResetSynchronizerPrimitiveShiftReg_d3.NonSyncResetSynchronizerPrimitiveShiftReg_d3")

pub mod SynchronizerShiftReg_w2_d3::[timecheck=false](clock:u1, io_d:u2) -> (io_q:u2@[]) {
  const io_d_0__w1 = io_d
  mut output_chain = NonSyncResetSynchronizerPrimitiveShiftReg_d3::[name=output_chain](clock = clock, io_d = io_d_0__w1 & 1)
  mut output_chain_1 = NonSyncResetSynchronizerPrimitiveShiftReg_d3::[name=output_chain_1](clock = clock, io_d = (io_d_0__w1 >> 1) & 1)
  io_q = ((output_chain_1 & 1) << 1) | (output_chain & 1)
}
