pub comb AMOALU::[timecheck=false](io_mask:U4, io_cmd:U5, io_lhs:U32, io_rhs:U32) -> (io_out_unmasked:U32) {
  const io_mask_0__w1 = io_mask
  const io_cmd_0__w1 = io_cmd
  const io_lhs_0__w1 = io_lhs
  const io_rhs_0__w1 = io_rhs
  const _logic_xor_T_1__w1 = U1(io_cmd_0__w1 == 10)
  const logic_and__w1 = (_logic_xor_T_1__w1 | U1(io_cmd_0__w1 == 11)) & 1
  const logic_xor__w1 = (U1(io_cmd_0__w1 == 9) | _logic_xor_T_1__w1) & 1
  mut _mux_10:U1 = if (~io_cmd_0__w1#[1..<2]) != 0 { io_lhs_0__w1#[31..<32] } else { io_rhs_0__w1#[31..<32] }
  mut _mux_11:U1 = if io_lhs_0__w1#[31..<32] == io_rhs_0__w1#[31..<32] { U1(io_lhs_0__w1 < io_rhs_0__w1) & 1 } else { _mux_10 & 1 }
  mut _mux_12:U1 = if _mux_11 != 0 { ((U1(io_cmd_0__w1 == 12) | U1(io_cmd_0__w1 == 14)) & 1) & 1 } else { ((U1(io_cmd_0__w1 == 13) | U1(io_cmd_0__w1 == 15)) & 1) & 1 }
  mut _mux_13:U32 = if _mux_12 != 0 { io_lhs_0__w1#[0..<32] } else { io_rhs_0__w1#[0..<32] }
  mut _mux_14:U32 = if logic_and__w1 != 0 { (io_lhs_0__w1 & io_rhs_0__w1)#[0..<32] } else { 0 }
  mut _mux_15:U32 = if logic_xor__w1 != 0 { (io_lhs_0__w1 ^ io_rhs_0__w1)#[0..<32] } else { 0 }
  mut _mux_16:U32 = if ((logic_and__w1 | logic_xor__w1) & 1) != 0 { (_mux_14 | _mux_15)#[0..<32]#[0..<32] } else { _mux_13#[0..<32] }
  mut _mux_17:U32 = if U1(io_cmd_0__w1 == 8) != 0 { (io_lhs_0__w1 + io_rhs_0__w1)#[0..<32]#[0..<32] } else { _mux_16#[0..<32] }
  const out__w1 = _mux_17
  mut _rep_18:U8 = if io_mask_0__w1#[1..<2] != 0 { 0xff } else { 0 }
  mut _rep_19:U8 = if (io_mask_0__w1 & 1) != 0 { 0xff } else { 0 }
  mut _rep_20:U8 = if io_mask_0__w1#[3..<4] != 0 { 0xff } else { 0 }
  mut _rep_21:U8 = if io_mask_0__w1#[2..<3] != 0 { 0xff } else { 0 }
  const wmask__w1 = (((_rep_20#[0..<8] << 8) | _rep_21#[0..<8])#[0..<16] << 16) | ((_rep_18#[0..<8] << 8) | _rep_19#[0..<8])#[0..<16]
  io_out_unmasked = out__w1
}
