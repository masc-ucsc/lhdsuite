pub mod Queue_5::[timecheck=false](clock:u1, reset:u1, io_enq_valid:u1, io_enq_bits_tl_state_size:u4, io_enq_bits_tl_state_source:u5, io_deq_ready:u1) -> (io_enq_ready:u1@[], io_deq_valid:u1@[], io_deq_bits_tl_state_size:u4@[], io_deq_bits_tl_state_source:u5@[]) {
  mut _b2i_1 = 0
  reg ram:u9
  reg maybe_full:u1
