  }
  io_enq_ready = io_enq_ready__w1
  io_deq_valid = io_deq_valid__w1
  io_deq_bits_tl_state_size = io_deq_bits_tl_state_size__w1
  io_deq_bits_tl_state_source = io_deq_bits_tl_state_source__w1
