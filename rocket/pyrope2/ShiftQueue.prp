pub mod ShiftQueue::[timecheck=false](`clock`:Clock, `reset`:U1, io_enq_valid:U1, io_enq_bits_btb_cfiType:U2, io_enq_bits_btb_mask:U2, io_enq_bits_btb_bridx:U1, io_enq_bits_btb_target:U32, io_enq_bits_btb_entry:U1, io_enq_bits_btb_bht_history:U8, io_enq_bits_btb_bht_value:U1, io_enq_bits_pc:U32, io_enq_bits_data:U32, io_enq_bits_mask:U2, io_enq_bits_xcpt_pf_inst:U1, io_enq_bits_xcpt_ae_inst:U1, io_enq_bits_replay:U1, io_deq_ready:U1) -> (io_enq_ready:U1@[], io_deq_valid:U1@[], io_deq_bits_btb_cfiType:U2@[], io_deq_bits_btb_taken:U1@[], io_deq_bits_btb_mask:U2@[], io_deq_bits_btb_bridx:U1@[], io_deq_bits_btb_target:U32@[], io_deq_bits_btb_entry:U1@[], io_deq_bits_btb_bht_history:U8@[], io_deq_bits_btb_bht_value:U1@[], io_deq_bits_pc:U32@[], io_deq_bits_data:U32@[], io_deq_bits_mask:U2@[], io_deq_bits_xcpt_pf_inst:U1@[], io_deq_bits_xcpt_gf_inst:U1@[], io_deq_bits_xcpt_ae_inst:U1@[], io_deq_bits_replay:U1@[], io_mask:U5@[]) {
  reg valid_4:U1
  reg valid_0:U1
  reg valid_1:U1
  reg valid_2:U1
  reg valid_3:U1
  reg elts_0_btb_cfiType:U2
  reg elts_0_btb_taken:U1
  reg elts_0_btb_mask:U2
  reg elts_0_btb_bridx:U1
  reg elts_0_btb_target:U32
  reg elts_0_btb_entry:U1
  reg elts_0_btb_bht_history:U8
  reg elts_0_btb_bht_value:U1
  reg elts_0_pc:U32
  reg elts_0_data:U32
  reg elts_0_mask:U2
  reg elts_0_xcpt_pf_inst:U1
  reg elts_0_xcpt_gf_inst:U1
  reg elts_0_xcpt_ae_inst:U1
  reg elts_0_replay:U1
  reg elts_1_btb_cfiType:U2
  reg elts_1_btb_taken:U1
  reg elts_1_btb_mask:U2
  reg elts_1_btb_bridx:U1
  reg elts_1_btb_target:U32
  reg elts_1_btb_entry:U1
  reg elts_1_btb_bht_history:U8
  reg elts_1_btb_bht_value:U1
  reg elts_1_pc:U32
  reg elts_1_data:U32
  reg elts_1_mask:U2
  reg elts_1_xcpt_pf_inst:U1
  reg elts_1_xcpt_gf_inst:U1
  reg elts_1_xcpt_ae_inst:U1
  reg elts_1_replay:U1
  reg elts_2_btb_cfiType:U2
  reg elts_2_btb_taken:U1
  reg elts_2_btb_mask:U2
  reg elts_2_btb_bridx:U1
  reg elts_2_btb_target:U32
  reg elts_2_btb_entry:U1
  reg elts_2_btb_bht_history:U8
  reg elts_2_btb_bht_value:U1
  reg elts_2_pc:U32
  reg elts_2_data:U32
  reg elts_2_mask:U2
  reg elts_2_xcpt_pf_inst:U1
  reg elts_2_xcpt_gf_inst:U1
  reg elts_2_xcpt_ae_inst:U1
  reg elts_2_replay:U1
  reg elts_3_btb_cfiType:U2
  reg elts_3_btb_taken:U1
  reg elts_3_btb_mask:U2
  reg elts_3_btb_bridx:U1
  reg elts_3_btb_target:U32
  reg elts_3_btb_entry:U1
  reg elts_3_btb_bht_history:U8
  reg elts_3_btb_bht_value:U1
  reg elts_3_pc:U32
  reg elts_3_data:U32
  reg elts_3_mask:U2
  reg elts_3_xcpt_pf_inst:U1
  reg elts_3_xcpt_gf_inst:U1
  reg elts_3_xcpt_ae_inst:U1
  reg elts_3_replay:U1
  reg elts_4_btb_cfiType:U2
  reg elts_4_btb_mask:U2
  reg elts_4_btb_bridx:U1
  reg elts_4_btb_target:U32
  reg elts_4_btb_entry:U1
  reg elts_4_btb_bht_history:U8
  reg elts_4_btb_bht_value:U1
  reg elts_4_pc:U32
  reg elts_4_data:U32
  reg elts_4_mask:U2
  reg elts_4_xcpt_pf_inst:U1
  reg elts_4_xcpt_gf_inst:U1
  reg elts_4_xcpt_ae_inst:U1
  reg elts_4_replay:U1
  // 5-entry shift queue, entry 0 = head. The registers stay scalar (elts_<e>_<f>); the per-entry
  // logic runs over arrays of their values and each register takes its slot of the result
  const valid:[5]U1 = (valid_0, valid_1, valid_2, valid_3, valid_4)
  const cfiType:[5]U2 = (elts_0_btb_cfiType, elts_1_btb_cfiType, elts_2_btb_cfiType, elts_3_btb_cfiType, elts_4_btb_cfiType)
  const btbMask:[5]U2 = (elts_0_btb_mask, elts_1_btb_mask, elts_2_btb_mask, elts_3_btb_mask, elts_4_btb_mask)
  const bridx:[5]U1 = (elts_0_btb_bridx, elts_1_btb_bridx, elts_2_btb_bridx, elts_3_btb_bridx, elts_4_btb_bridx)
  const target:[5]U32 = (elts_0_btb_target, elts_1_btb_target, elts_2_btb_target, elts_3_btb_target, elts_4_btb_target)
  const entry:[5]U1 = (elts_0_btb_entry, elts_1_btb_entry, elts_2_btb_entry, elts_3_btb_entry, elts_4_btb_entry)
  const bhtHistory:[5]U8 = (elts_0_btb_bht_history, elts_1_btb_bht_history, elts_2_btb_bht_history, elts_3_btb_bht_history, elts_4_btb_bht_history)
  const bhtValue:[5]U1 = (elts_0_btb_bht_value, elts_1_btb_bht_value, elts_2_btb_bht_value, elts_3_btb_bht_value, elts_4_btb_bht_value)
  const pc:[5]U32 = (elts_0_pc, elts_1_pc, elts_2_pc, elts_3_pc, elts_4_pc)
  const data:[5]U32 = (elts_0_data, elts_1_data, elts_2_data, elts_3_data, elts_4_data)
  const mask:[5]U2 = (elts_0_mask, elts_1_mask, elts_2_mask, elts_3_mask, elts_4_mask)
  const pfInst:[5]U1 = (elts_0_xcpt_pf_inst, elts_1_xcpt_pf_inst, elts_2_xcpt_pf_inst, elts_3_xcpt_pf_inst, elts_4_xcpt_pf_inst)
  const aeInst:[5]U1 = (elts_0_xcpt_ae_inst, elts_1_xcpt_ae_inst, elts_2_xcpt_ae_inst, elts_3_xcpt_ae_inst, elts_4_xcpt_ae_inst)
  const replay:[5]U1 = (elts_0_replay, elts_1_replay, elts_2_replay, elts_3_replay, elts_4_replay)
  const enqFire = (~valid_4) & io_enq_valid & 1
  // neighbours, with valid[5] = 0 past the tail and valid[-1] = 1 before the head
  mut vUp:[5]U1 = (0, 0, 0, 0, 0)
  mut vDn:[5]U1 = (1, 1, 1, 1, 1)
  for e in 0..<4 {
    vUp[e] = valid[e + 1]
    vDn[e + 1] = valid[e]
  }
  // entry e is written on dequeue when it shifts in (vUp) or takes the enq into the
  // slot that just freed; without dequeue only the first empty slot takes the enq
  mut wen:[5]U1 = (0, 0, 0, 0, 0)
  mut vDeq:[5]U1 = (0, 0, 0, 0, 0)
  mut vHold:[5]U1 = (0, 0, 0, 0, 0)
  for e in 0..<5 {
    vDeq[e] = (vUp[e] | (enqFire & valid[e])) & 1
    vHold[e] = ((enqFire & vDn[e]) | valid[e]) & 1
    wen[e] = if io_deq_ready != 0 { vDeq[e] } else { enqFire & vDn[e] & (~valid[e]) & 1 }
  }
  // write data: the next entry when it is valid, else the enq bits (entry 4 always the enq)
  mut cfiTypeN:[5]U2 = (0, 0, 0, 0, 0)
  mut btbMaskN:[5]U2 = (0, 0, 0, 0, 0)
  mut bridxN:[5]U1 = (0, 0, 0, 0, 0)
  mut targetN:[5]U32 = (0, 0, 0, 0, 0)
  mut entryN:[5]U1 = (0, 0, 0, 0, 0)
  mut bhtHistoryN:[5]U8 = (0, 0, 0, 0, 0)
  mut bhtValueN:[5]U1 = (0, 0, 0, 0, 0)
  mut pcN:[5]U32 = (0, 0, 0, 0, 0)
  mut dataN:[5]U32 = (0, 0, 0, 0, 0)
  mut maskN:[5]U2 = (0, 0, 0, 0, 0)
  mut pfInstN:[5]U1 = (0, 0, 0, 0, 0)
  mut aeInstN:[5]U1 = (0, 0, 0, 0, 0)
  mut replayN:[5]U1 = (0, 0, 0, 0, 0)
  for e in 0..<5 {
    cfiTypeN[e] = if vUp[e] != 0 { cfiType[(e + 1) % 5] } else { io_enq_bits_btb_cfiType }
    btbMaskN[e] = if vUp[e] != 0 { btbMask[(e + 1) % 5] } else { io_enq_bits_btb_mask }
    bridxN[e] = if vUp[e] != 0 { bridx[(e + 1) % 5] } else { io_enq_bits_btb_bridx }
    targetN[e] = if vUp[e] != 0 { target[(e + 1) % 5] } else { io_enq_bits_btb_target }
    entryN[e] = if vUp[e] != 0 { entry[(e + 1) % 5] } else { io_enq_bits_btb_entry }
    bhtHistoryN[e] = if vUp[e] != 0 { bhtHistory[(e + 1) % 5] } else { io_enq_bits_btb_bht_history }
    bhtValueN[e] = if vUp[e] != 0 { bhtValue[(e + 1) % 5] } else { io_enq_bits_btb_bht_value }
    pcN[e] = if vUp[e] != 0 { pc[(e + 1) % 5] } else { io_enq_bits_pc }
    dataN[e] = if vUp[e] != 0 { data[(e + 1) % 5] } else { io_enq_bits_data }
    maskN[e] = if vUp[e] != 0 { mask[(e + 1) % 5] } else { io_enq_bits_mask }
    pfInstN[e] = if vUp[e] != 0 { pfInst[(e + 1) % 5] } else { io_enq_bits_xcpt_pf_inst }
    aeInstN[e] = if vUp[e] != 0 { aeInst[(e + 1) % 5] } else { io_enq_bits_xcpt_ae_inst }
    replayN[e] = if vUp[e] != 0 { replay[(e + 1) % 5] } else { io_enq_bits_replay }
  }
  if `reset` != 0 {
    valid_0 = 0
    valid_1 = 0
    valid_2 = 0
    valid_3 = 0
    valid_4 = 0
  } elif io_deq_ready != 0 {
    valid_0 = vDeq[0]
    valid_1 = vDeq[1]
    valid_2 = vDeq[2]
    valid_3 = vDeq[3]
    valid_4 = vDeq[4]
  } else {
    valid_0 = vHold[0]
    valid_1 = vHold[1]
    valid_2 = vHold[2]
    valid_3 = vHold[3]
    valid_4 = vHold[4]
  }
  if wen[0] != 0 {
    elts_0_btb_cfiType = cfiTypeN[0]
    elts_0_btb_mask = btbMaskN[0]
    elts_0_btb_bridx = bridxN[0]
    elts_0_btb_target = targetN[0]
    elts_0_btb_entry = entryN[0]
    elts_0_btb_bht_history = bhtHistoryN[0]
    elts_0_btb_bht_value = bhtValueN[0]
    elts_0_pc = pcN[0]
    elts_0_data = dataN[0]
    elts_0_mask = maskN[0]
    elts_0_xcpt_pf_inst = pfInstN[0]
    elts_0_xcpt_ae_inst = aeInstN[0]
    elts_0_replay = replayN[0]
    elts_0_btb_taken = valid_1 & elts_1_btb_taken & 1
    elts_0_xcpt_gf_inst = valid_1 & elts_1_xcpt_gf_inst & 1
  }
  if wen[1] != 0 {
    elts_1_btb_cfiType = cfiTypeN[1]
    elts_1_btb_mask = btbMaskN[1]
    elts_1_btb_bridx = bridxN[1]
    elts_1_btb_target = targetN[1]
    elts_1_btb_entry = entryN[1]
    elts_1_btb_bht_history = bhtHistoryN[1]
    elts_1_btb_bht_value = bhtValueN[1]
    elts_1_pc = pcN[1]
    elts_1_data = dataN[1]
    elts_1_mask = maskN[1]
    elts_1_xcpt_pf_inst = pfInstN[1]
    elts_1_xcpt_ae_inst = aeInstN[1]
    elts_1_replay = replayN[1]
    elts_1_btb_taken = valid_2 & elts_2_btb_taken & 1
    elts_1_xcpt_gf_inst = valid_2 & elts_2_xcpt_gf_inst & 1
  }
  if wen[2] != 0 {
    elts_2_btb_cfiType = cfiTypeN[2]
    elts_2_btb_mask = btbMaskN[2]
    elts_2_btb_bridx = bridxN[2]
    elts_2_btb_target = targetN[2]
    elts_2_btb_entry = entryN[2]
    elts_2_btb_bht_history = bhtHistoryN[2]
    elts_2_btb_bht_value = bhtValueN[2]
    elts_2_pc = pcN[2]
    elts_2_data = dataN[2]
    elts_2_mask = maskN[2]
    elts_2_xcpt_pf_inst = pfInstN[2]
    elts_2_xcpt_ae_inst = aeInstN[2]
    elts_2_replay = replayN[2]
    elts_2_btb_taken = valid_3 & elts_3_btb_taken & 1
    elts_2_xcpt_gf_inst = valid_3 & elts_3_xcpt_gf_inst & 1
  }
  if wen[3] != 0 {
    elts_3_btb_cfiType = cfiTypeN[3]
    elts_3_btb_mask = btbMaskN[3]
    elts_3_btb_bridx = bridxN[3]
    elts_3_btb_target = targetN[3]
    elts_3_btb_entry = entryN[3]
    elts_3_btb_bht_history = bhtHistoryN[3]
    elts_3_btb_bht_value = bhtValueN[3]
    elts_3_pc = pcN[3]
    elts_3_data = dataN[3]
    elts_3_mask = maskN[3]
    elts_3_xcpt_pf_inst = pfInstN[3]
    elts_3_xcpt_ae_inst = aeInstN[3]
    elts_3_replay = replayN[3]
    elts_3_xcpt_gf_inst = valid_4 & elts_4_xcpt_gf_inst & 1
  }
  if wen[4] != 0 {
    elts_4_btb_cfiType = cfiTypeN[4]
    elts_4_btb_mask = btbMaskN[4]
    elts_4_btb_bridx = bridxN[4]
    elts_4_btb_target = targetN[4]
    elts_4_btb_entry = entryN[4]
    elts_4_btb_bht_history = bhtHistoryN[4]
    elts_4_btb_bht_value = bhtValueN[4]
    elts_4_pc = pcN[4]
    elts_4_data = dataN[4]
    elts_4_mask = maskN[4]
    elts_4_xcpt_pf_inst = pfInstN[4]
    elts_4_xcpt_ae_inst = aeInstN[4]
    elts_4_replay = replayN[4]
  }
  // btb_taken / xcpt_gf_inst have no enq input: the tail copy clears on write
  elts_3_btb_taken = (~wen[3]#[0]) & elts_3_btb_taken & 1
  elts_4_xcpt_gf_inst = (~wen[4]#[0]) & elts_4_xcpt_gf_inst & 1
  io_enq_ready = ~valid_4
  io_deq_valid = (io_enq_valid | valid_0) & 1
  io_deq_bits_btb_cfiType = if valid_0 != 0 { elts_0_btb_cfiType } else { io_enq_bits_btb_cfiType }
  io_deq_bits_btb_mask = if valid_0 != 0 { elts_0_btb_mask } else { io_enq_bits_btb_mask }
  io_deq_bits_btb_bridx = if valid_0 != 0 { elts_0_btb_bridx } else { io_enq_bits_btb_bridx }
  io_deq_bits_btb_target = if valid_0 != 0 { elts_0_btb_target } else { io_enq_bits_btb_target }
  io_deq_bits_btb_entry = if valid_0 != 0 { elts_0_btb_entry } else { io_enq_bits_btb_entry }
  io_deq_bits_btb_bht_history = if valid_0 != 0 { elts_0_btb_bht_history } else { io_enq_bits_btb_bht_history }
  io_deq_bits_btb_bht_value = if valid_0 != 0 { elts_0_btb_bht_value } else { io_enq_bits_btb_bht_value }
  io_deq_bits_pc = if valid_0 != 0 { elts_0_pc } else { io_enq_bits_pc }
  io_deq_bits_data = if valid_0 != 0 { elts_0_data } else { io_enq_bits_data }
  io_deq_bits_mask = if valid_0 != 0 { elts_0_mask } else { io_enq_bits_mask }
  io_deq_bits_xcpt_pf_inst = if valid_0 != 0 { elts_0_xcpt_pf_inst } else { io_enq_bits_xcpt_pf_inst }
  io_deq_bits_xcpt_ae_inst = if valid_0 != 0 { elts_0_xcpt_ae_inst } else { io_enq_bits_xcpt_ae_inst }
  io_deq_bits_replay = if valid_0 != 0 { elts_0_replay } else { io_enq_bits_replay }
  io_deq_bits_btb_taken = valid_0 & elts_0_btb_taken & 1
  io_deq_bits_xcpt_gf_inst = valid_0 & elts_0_xcpt_gf_inst & 1
  mut vmask:U5 = 0
  for e in 0..<5 {
    vmask = vmask | (valid[e] << e)
  }
  io_mask = vmask
}
