// Five fetch packets share the read and write pointers. An empty queue bypasses storage.
pub mod ShiftQueue<Entry>::[timecheck=false](clock:Clock, offer:Bool, packet:Entry, reset:Reset, take:Bool) -> (head:Entry@[], occupancy:U3@[], ready:Bool@[], valid:Bool@[]) {
  reg entries:[5]Entry:[ordering="old"] = nil
  reg readSlot:U3 = 0
  reg writeSlot:U3 = 0
  reg count:U3 = 0
  const occupied = count != 0
  ready = count < 5
  valid = occupied or offer
  const push = ready and offer and (occupied or !take)
  const pop = occupied and take
  if pop {
    readSlot = if readSlot == 4 { 0 } else { (readSlot + 1)#[0..<3] }
  }
  if push {
    entries[writeSlot] = packet
    writeSlot = if writeSlot == 4 { 0 } else { (writeSlot + 1)#[0..<3] }
  }
  wrap count = count + U1(push) - U1(pop)
  occupancy = count
  head = if occupied { entries[readSlot] } else { packet }
}
