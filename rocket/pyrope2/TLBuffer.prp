const Queue = import("Queue.Queue")

// The A request and D response channels buffer independently.
pub mod TLBuffer<A, D>(aReady:U1, aValid:U1, clk:Clock, dReady:U1, dValid:U1, request:A, response:D, rst:Reset) -> (inD:D@[], inReady:U1@[], inValid:U1@[], outA:A@[], outReady:U1@[], outValid:U1@[]) {
  const a = Queue<T=A>(offer=aValid, payload=request, take=aReady)
  const d = Queue<T=D>(offer=dValid, payload=response, take=dReady)
  inReady = a.ready
  outValid = a.valid
  outA = a.head
  outReady = d.ready
  inValid = d.valid
  inD = d.head
}
