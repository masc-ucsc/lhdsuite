const Queue = import("Queue.Queue")

// The A request and D response channels buffer independently.
pub mod TLBuffer<A, D>(clk:Clock, rst:U1, aValid:U1, request:A, aReady:U1,
    dValid:U1, response:D, dReady:U1) -> (inReady:U1@[], outValid:U1@[], outA:A@[],
    outReady:U1@[], inValid:U1@[], inD:D@[]) {
  const a = Queue<T=A>(clk=clk, rst=rst, offer=aValid, payload=request, take=aReady)
  const d = Queue<T=D>(clk=clk, rst=rst, offer=dValid, payload=response, take=dReady)
  inReady = a.ready
  outValid = a.valid
  outA = a.head
  outReady = d.ready
  inValid = d.valid
  inD = d.head
}
