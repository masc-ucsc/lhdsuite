        else { 1 }), const roccOpcodes=roccOpcodes, const vLen=vLen, const nMSHRs=nMSHRs, const icacheBlockBytes=icacheBlockBytes, const dcacheBlockBytes=dcacheBlockBytes, const xLen=xLen, const enableTraceCoreIngress=enableTraceCoreIngress, const asIdBits=asIdBits, const pgLevels=levels, const extraPgLevels=levels - minLevels, const useDebug=useDebug, const nPerfCounters=nPerfCounters, const counterBits=3 + nPerfCounters, const mcontextWidth=mcontextWidth, const scontextWidth=scontextWidth, const nBreakpoints=nBreakpoints, const triggerSlots=(if nBreakpoints > 0 {
