pub comb params(asIdBits=0, bhtCounterLength=1, bhtEntries=0, bhtHistoryBits=3, bhtHistoryLength=8, branchPredictionModeCSR=false, btbEntries=0, clockGate=false, dTLBEntries=4, dTLBWays=1, dcacheBlockBytes=64, dcacheClockGate=false, dcacheSets=256, dcacheWays=4, divEarlyOut=false, divEarlyOutGranularity=1, divSqrt=true, divUnroll=1, enableTraceCoreIngress=false, fLen=0, fastLoadByte=false, fastLoadWord=true, fpuClockGate=false, haveBasicCounters=true, haveCFlush=false, haveCease=true, iTLBEntries=4, iTLBWays=1, icacheBlockBytes=64, icachePrefetch=false, icacheSets=64, icacheWays=1, mcontextWidth=0, mimpid=0x20181004, minFLen=32, misaWritable=true, mtvecInit=0, mtvecWritable=true, mulDivClockGate=false, mulEarlyOut=false, mulUnroll=8, mvendorid=0, nBreakpoints=1, nL2TLBEntries=0, nL2TLBWays=1, nLocalInterrupts=0, nMSHRs=0, nPMPs=8, nPTECacheEntries=8, nPerfCounters=0, nRAS=0, pgLevels=0, roccOpcodes=0, scontextWidth=0, useAddiForMv=false, useAtomics=true, useAtomicsOnlyForIO=false, useBPWatch=false, useCompressed=true, useConditionalZero=false, useDataScratchpad=true, useDebug=true, useMulDiv=true, useRVE=false, useSupervisor=false, useUser=false, useVM=false, useZba=false, useZbb=false, useZbs=false, vLen=0, xLen=32) -> (cfg) {
