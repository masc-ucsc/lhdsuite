// Two asynchronous read ports and one synchronous write port. x0 has no storage.
pub mod RegFile<XLEN=32, RegBits=5>(clk:Clock, rs1:Unsigned(bits=RegBits), rs2:Unsigned(bits=RegBits),
    rd:Unsigned(bits=RegBits), write:Bool, data:Unsigned(bits=XLEN))
    -> (a:Unsigned(bits=XLEN)@[0], b:Unsigned(bits=XLEN)@[0]) {
  reg words:[(1 << RegBits) - 1]Unsigned(bits=XLEN):[ordering="old"] = nil
  const enable = write and rd != 0
  if enable { words[~rd] = data }
  a = if enable and rd == rs1 { data } elif rs1 != 0 { words[~rs1] } else { 0 }
  b = if enable and rd == rs2 { data } elif rs2 != 0 { words[~rs2] } else { 0 }
}
