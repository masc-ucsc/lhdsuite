// Scalar state preserves automatic correspondence with the RTL flops.
const advance = import("lfsr_step.advance")

pub mod MaxPeriodFibonacciLFSR::[timecheck=false](clock:u1, reset:u1, io_increment:u1) -> (io_out_0:u1@[], io_out_1:u1@[], io_out_2:u1@[], io_out_3:u1@[], io_out_4:u1@[], io_out_5:u1@[], io_out_6:u1@[], io_out_7:u1@[], io_out_8:u1@[], io_out_9:u1@[], io_out_10:u1@[], io_out_11:u1@[], io_out_12:u1@[], io_out_13:u1@[], io_out_14:u1@[], io_out_15:u1@[]) {
  reg state_0:u1:[reset_pin=ref reset, async=true] = 1
  reg state_1:u1:[reset_pin=ref reset, async=true] = 0
  reg state_2:u1:[reset_pin=ref reset, async=true] = 0
  reg state_3:u1:[reset_pin=ref reset, async=true] = 0
  reg state_4:u1:[reset_pin=ref reset, async=true] = 0
  reg state_5:u1:[reset_pin=ref reset, async=true] = 0
  reg state_6:u1:[reset_pin=ref reset, async=true] = 0
  reg state_7:u1:[reset_pin=ref reset, async=true] = 0
  reg state_8:u1:[reset_pin=ref reset, async=true] = 0
  reg state_9:u1:[reset_pin=ref reset, async=true] = 0
  reg state_10:u1:[reset_pin=ref reset, async=true] = 0
  reg state_11:u1:[reset_pin=ref reset, async=true] = 0
  reg state_12:u1:[reset_pin=ref reset, async=true] = 0
  reg state_13:u1:[reset_pin=ref reset, async=true] = 0
  reg state_14:u1:[reset_pin=ref reset, async=true] = 0
  reg state_15:u1:[reset_pin=ref reset, async=true] = 0

  // Direct output fan-out (16 lines, one per port)
  io_out_0 = state_0
  io_out_1 = state_1
  io_out_2 = state_2
  io_out_3 = state_3
  io_out_4 = state_4
  io_out_5 = state_5
  io_out_6 = state_6
  io_out_7 = state_7
  io_out_8 = state_8
  io_out_9 = state_9
  io_out_10 = state_10
  io_out_11 = state_11
  io_out_12 = state_12
  io_out_13 = state_13
  io_out_14 = state_14
  io_out_15 = state_15

  const state:u16 = (state_0, state_1, state_2, state_3, state_4, state_5, state_6, state_7, state_8, state_9, state_10, state_11, state_12, state_13, state_14, state_15)#[..]

  if io_increment != 0 {
    const next_state:u16 = advance(state=state)
    // Fan out the packed next-state to the 16 individual regs
    state_0 = next_state#[0]
    state_1 = next_state#[1]
    state_2 = next_state#[2]
    state_3 = next_state#[3]
    state_4 = next_state#[4]
    state_5 = next_state#[5]
    state_6 = next_state#[6]
    state_7 = next_state#[7]
    state_8 = next_state#[8]
    state_9 = next_state#[9]
    state_10 = next_state#[10]
    state_11 = next_state#[11]
    state_12 = next_state#[12]
    state_13 = next_state#[13]
    state_14 = next_state#[14]
    state_15 = next_state#[15]
  }
}
