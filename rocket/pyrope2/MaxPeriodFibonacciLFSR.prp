pub mod MaxPeriodFibonacciLFSR::[timecheck=false](`clock`:Clock, `reset`:U1, io_increment:U1) -> (io_out_0:U1@[], io_out_1:U1@[], io_out_2:U1@[], io_out_3:U1@[], io_out_4:U1@[], io_out_5:U1@[], io_out_6:U1@[], io_out_7:U1@[], io_out_8:U1@[], io_out_9:U1@[], io_out_10:U1@[], io_out_11:U1@[], io_out_12:U1@[], io_out_13:U1@[], io_out_14:U1@[], io_out_15:U1@[]) {
  reg state_0:U1:[initial=1, reset_pin=`reset`, async=false]
  reg state_1:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_2:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_3:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_4:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_5:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_6:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_7:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_8:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_9:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_10:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_11:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_12:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_13:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_14:U1:[initial=0, reset_pin=`reset`, async=false]
  reg state_15:U1:[initial=0, reset_pin=`reset`, async=false]
  const io_out_0_0__w1 = state_0
  const io_out_1_0__w1 = state_1
  const io_out_2_0__w1 = state_2
  const io_out_3_0__w1 = state_3
  const io_out_4_0__w1 = state_4
  const io_out_5_0__w1 = state_5
  const io_out_6_0__w1 = state_6
  const io_out_7_0__w1 = state_7
  const io_out_8_0__w1 = state_8
  const io_out_9_0__w1 = state_9
  const io_out_10_0__w1 = state_10
  const io_out_11_0__w1 = state_11
  const io_out_12_0__w1 = state_12
  const io_out_13_0__w1 = state_13
  const io_out_14_0__w1 = state_14
  const io_out_15_0__w1 = state_15
  if not (`reset` != 0) {
    if io_increment != 0 {
      state_0 = (((((state_15 ^ state_13) & 1) ^ state_12) & 1) ^ state_10) & 1
      state_1 = state_0
      state_2 = state_1
      state_3 = state_2
      state_4 = state_3
      state_5 = state_4
      state_6 = state_5
      state_7 = state_6
      state_8 = state_7
      state_9 = state_8
      state_10 = state_9
      state_11 = state_10
      state_12 = state_11
      state_13 = state_12
      state_14 = state_13
      state_15 = state_14
    }
  }
  io_out_0 = io_out_0_0__w1
  io_out_1 = io_out_1_0__w1
  io_out_2 = io_out_2_0__w1
  io_out_3 = io_out_3_0__w1
  io_out_4 = io_out_4_0__w1
  io_out_5 = io_out_5_0__w1
  io_out_6 = io_out_6_0__w1
  io_out_7 = io_out_7_0__w1
  io_out_8 = io_out_8_0__w1
  io_out_9 = io_out_9_0__w1
  io_out_10 = io_out_10_0__w1
  io_out_11 = io_out_11_0__w1
  io_out_12 = io_out_12_0__w1
  io_out_13 = io_out_13_0__w1
  io_out_14 = io_out_14_0__w1
  io_out_15 = io_out_15_0__w1
}
