// Match one virtual address against a trigger's exact, masked, or range encoding.
comb hits<W>(address:Unsigned(bits=W), mode:U2, value:Unsigned(bits=W)) -> (hit:U1) {
  mut mask:U4 = 0
  mask#[0] = mode#[0]
  for bit in 1..<4 {
    mask#[bit] = mask#[bit - 1] & address#[bit - 1]
  }
  hit = match mode {
    == 2 { U1(value >= address) }
    == 3 { U1(value < address) }
    else { U1((value | mask) == (address | mask)) }
  }
}

pub mod BreakpointUnit<C>(clk:Clock, cmd:U3, data:Unsigned(bits=C.xLen), debug:U1, ea:Unsigned(bits=C.xLen), index:U12, mcontext:Unsigned(bits=C.xLen)=0, pc:Unsigned(bits=C.xLen), privilege:U2, rst:Reset, scontext:Unsigned(bits=C.xLen)=0) -> (actions:Unsigned(bits=3*C.triggerSlots)@[], enterDebug:U3@[], exception:U3@[], fetch:Unsigned(bits=C.triggerSlots)@[], load:Unsigned(bits=C.triggerSlots)@[], read:Unsigned(bits=C.xLen)@[], store:Unsigned(bits=C.triggerSlots)@[]) {
  comptime const N = C.nBreakpoints
  cassert(N > 0)
  comptime const W = if C.xLen == 32 { 32 } elif C.useVM { 12 + (9*C.pgLevels) } else { 33 }
  comptime const idBits = if N == 1 { 1 } else { std.clog2(N) }
  comptime const mSelect = if C.xLen == 32 { 25 } else { 50 }
  comptime const mMask = ((1 << C.mcontextWidth) - 1) & (if C.xLen == 32 { 0x3f } else { 0x1fff })
  comptime const sMask = ((1 << C.scontextWidth) - 1) & (if C.xLen == 32 { 0xffff } else { 0x3ffffffff })
  comptime const extraMask = (mMask << (mSelect + 1)) | (U1(C.mcontextWidth > 0) << mSelect) | (sMask << 2) | U1(C.scontextWidth > 0)
  wire contextHits:Unsigned(bits=N) = nil
  wire contextData:Unsigned(bits=C.xLen) = nil
  wire id:Unsigned(bits=idBits) = nil
  reg control:[N]U16:[clock_pin=clk, ordering="old"] = nil
  reg address:[N]Unsigned(bits=W):[clock_pin=clk, ordering="old"] = nil
  const write = cmd >= 5
  read = if index == 0x7a0 { id } elif index == 0x7a3 { contextData } else { 0 }
  exception = 0
  enterDebug = 0
  fetch = 0
  load = 0
  store = 0
  actions = 0
  mut chainOK:U3 = 7
  for i in 0..<N {
    const flags = control[i]
    const action = flags#[12..<15]
    const enables = flags#[3..<7]
    const enabled = ~debug & enables#[privilege] & contextHits#[i]
    const mode = flags#[7..<9]
    const inst = hits<W>(address=address[i], mode, value=pc#[0..<W])
    const mem = hits<W>(address=address[i], mode, value=ea#[0..<W])
    const matched:U3 = if enabled != 0 { flags#[0..<3] & ((inst << 2) | (mem << 1) | mem) } else { 0 }
    if flags#[11] == 0 {
      const fire = matched & chainOK
      load#[i] = fire#[0]
      store#[i] = fire#[1]
      fetch#[i] = fire#[2]
      // The last matching end-of-chain selects the action for each access.
      exception = (exception & ~fire#[0..<3]) | (if action == 0 { fire } else { 0 })
      enterDebug = (enterDebug & ~fire#[0..<3]) | (if action == 1 { fire } else { 0 })
      chainOK = 7
    } else {
      chainOK = matched
    }
    actions#[(3*i)..+3] = action
    if id == i {
      if index == 0x7a1 {
        read = (2 << (C.xLen - 4)) | (flags#[15] << (C.xLen - 5)) | (4 << (C.xLen - 11)) | flags#[0..<15]
      } elif index == 0x7a2 {
        read = address[i]#sext[0..<W]#[0..<C.xLen]
      }
    }
  }
  const value = match cmd#[0..<2] {
    == 2 { read | data }
    == 3 { read & ~data }
    else { data }
  }
  if N > 1 {
    reg selected:Unsigned(bits=idBits):[clock_pin=clk] = nil
    id = selected
    if rst {
      selected = 0
    } elif write and index == 0x7a0 {
      selected = value#[0..<idBits]
    }
  } else {
    id = 0
  }
  if extraMask != 0 {
    reg extra:[N]Unsigned(bits=C.xLen):[clock_pin=clk, ordering="old"] = nil
    mut matches:Unsigned(bits=N) = 0
    mut selectedTag:Unsigned(bits=C.xLen) = 0
    for i in 0..<N {
      const tag = extra[i]
      const mHit = tag#[mSelect] == 0 or ((tag >> (mSelect + 1)) & mMask) == (mcontext & mMask)
      const sHit = tag#[0] == 0 or ((tag >> 2) & sMask) == (scontext & sMask)
      matches#[i] = U1(mHit and sHit)
      if id == i {
        selectedTag = tag
      }
      if rst {
        extra[i] = 0
      } elif write and index == 0x7a3 and id == i and (control[i]#[15] == 0 or debug != 0) {
        extra[i] = value & extraMask
      }
    }
    contextHits = matches
    contextData = selectedTag
  } else {
    contextHits = (1 << N) - 1
    contextData = 0
  }
  for i in 0..<N {
    const writable = write and id == i and (control[i]#[15] == 0 or debug != 0)
    const prev = if i == 0 { i } else { i - 1 }
    const next = if i + 1 < N { i + 1 } else { i }
    const prevChain = i > 0 and control[prev]#[11] != 0
    const dmode = value#[C.xLen - 5] != 0 and debug != 0 and (!prevChain or control[prev]#[15] != 0)
    const chain = i + 1 < N and value#[11] != 0 and !prevChain and control[next]#[11] == 0 and (dmode or control[next]#[15] == 0)
    const requested = if C.useBPWatch { value#[12..<15] } else { value#[12] }
    const action = if dmode or requested > 1 { requested } else { 0 }
    const modes = ((if C.useUser { value#[6] } else { 1 }) << 6) | ((if C.useSupervisor { value#[4] } else { 0 }) << 4) | ((if C.useUser {
            value#[3]
          } else {
            0
          }) << 3)
    if rst {
      control[i] = 0x40
    } elif writable and index == 0x7a1 {
      control[i] = (U1(dmode) << 15) | (action << 12) | (U1(chain) << 11) | (value & 0x187) | modes
    }
    if writable and index == 0x7a2 {
      address[i] = value#[0..<W]
    }
  }
}
