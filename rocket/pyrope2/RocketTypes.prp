// Shared interface and pipeline-stage types of the Rocket core. Declared once and
// applied with the tile's config: `types.Ext<C>` is the same bundle in
// `Rocket`, `RocketTile` and anything else that carries the extension port.
pub type Ext<C> = (rocc:Bool, vector:Bool, instruction:U32, pc:Unsigned(bits=C.xLen), rs1:Unsigned(bits=C.xLen), rs2:Unsigned(bits=C.xLen), privilege:U2, dprv:U2, exception:Bool, decodeInst:U32, roccRespReady:Bool, vectorRespReady:Bool, csrAddress:U12, csrWrite:Bool, csrData:Unsigned(bits=C.xLen))

pub type Ingress<C> = (iretire:U1, iaddr:Unsigned(bits=C.xLen), itype:U4, ilastsize:U1, priv:U4, ctx:Unsigned(bits=C.xLen), tval:Unsigned(bits=C.xLen), cause:Unsigned(bits=C.xLen), time:Unsigned(bits=C.xLen))

pub type ExStage<C> = (xcpt_interrupt:Bool, valid:Bool, rvc:Bool, exception:Bool, flush_pipe:Bool, load_use:Bool, cause:U32, replay:Bool, address:Unsigned(bits=C.xLen), mem_size:U2, instruction:U32, raw_inst:U32, watch:Unsigned(bits=C.triggerSlots))

pub type MemStage<C> = (xcpt_interrupt:Bool, valid:Bool, rvc:Bool, exception:Bool, replay:Bool, flush_pipe:Bool, cause:U32, slow_bypass:Bool, load:Bool, store:Bool, address:Unsigned(bits=C.xLen), instruction:U32, hls_or_dv:Bool, raw_inst:U32, wdata:Unsigned(bits=C.xLen), rs2:Unsigned(bits=C.dLen), watch:Unsigned(bits=C.triggerSlots))

pub type WbStage<C> = (valid:Bool, exception:Bool, replay:Bool, flush_pipe:Bool, cause:U32, address:Unsigned(bits=C.xLen), hls_or_dv:Bool, instruction:U32, raw_inst:U32, wdata:Unsigned(bits=C.xLen), watch:Unsigned(bits=C.triggerSlots))
