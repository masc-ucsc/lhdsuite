  io_status_isa = reg_misa
  const systemInsn = U1(io_rw_cmd == 4)
  const ecall = systemInsn & U1(io_rw_addr == 0)
  const ebreak = systemInsn & U1(io_rw_addr == 1)
  const sret = C.useSupervisor and systemInsn != 0 and io_rw_addr == 0x102
  const dret = C.useDebug and systemInsn != 0 and io_rw_addr == 0x7b2
  const returning = U1(sret or dret) | (systemInsn & U1(io_rw_addr == 0x302))
  const addr = io_decode_0_inst#[20..<32]
  const countBank = addr#[5..<12]
  const lowBank = countBank == 0x58 or countBank == 0x60
  const highBank = countBank == 0x5c or countBank == 0x64
  const counterCSR = C.haveBasicCounters and (((lowBank or (C.xLen == 32 and highBank)) and addr#[0..<5] != 1) or
      addr == 0x320 or (addr >= 0x323 and addr <= 0x33f))
  const pmpConfig = addr >= 0x3a0 and addr <= 0x3a3 and (C.xLen == 32 or addr#[0] == 0)
  const fpCSR = C.fLen > 0 and fpStatus#[13..<15] != 0 and reg_misa#[5] != 0 and addr >= 1 and addr <= 3
  const userCSR = C.useUser and (addr == 0x30a or (C.xLen == 32 and addr == 0x31a) or (C.haveBasicCounters and addr == 0x306))
  const pmpCSR = C.nPMPs > 0 and (pmpConfig or (addr >= 0x3b0 and addr <= 0x3bf))
  const csrExists = U1((C.vLen > 0 and unitStatus#[9..<11] != 0 and reg_misa#[21] != 0 and addr in (8,9,10,15,0xc20,0xc21,0xc22)) or fpCSR or userCSR or pmpCSR or counterCSR or (C.useSupervisor and supervisor.exists(addr=addr)) or
      (C.mcontextWidth > 0 and addr == 0x7a8) or (C.scontextWidth > 0 and addr == 0x5a8) or
      (addr >= 0x7a0 and addr <= 0x7a3) or (C.useDebug and addr >= 0x7b0 and addr <= 0x7b2) or
      (addr >= 0xf11 and addr <= 0xf15) or (addr >= 0x340 and addr <= 0x344) or
