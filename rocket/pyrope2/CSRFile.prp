      reg_mstatus_mie = writeLow#[3..<4]
    } else {
      reg_mstatus_mpie = machineReturn | (if machineTrap != 0 { reg_mstatus_mie } else { reg_mstatus_mpie })
      if machineReturn != 0 { reg_mstatus_mie = reg_mstatus_mpie }
      else { reg_mstatus_mie &= ~machineTrap }
    }
    if csrWriteEnable != 0 and io_rw_addr == 0x342 {
      reg_mcause = csrWrite & ((1 << (C.xLen - 1)) | ((1 << std.clog2(16+C.nLocalInterrupts))-1))
    } elif machineTrap != 0 { reg_mcause = architecturalCause }
    if C.mtvecWritable and csrWriteEnable != 0 and io_rw_addr == 0x305 {
      reg_mtvec = writeLow
    }
    if writeEnabled and io_rw_addr == 0x320 {
      reg_mcountinhibit = writeLow#[0..<C.counterBits] & ((1 << C.counterBits)-3)
    }
    if C.misaWritable and csrWriteEnable != 0 and io_rw_addr == 0x301 and
        (reg_misa#[2] == 0 or io_pc#[1] == 0 or writeLow#[2] != 0) {
      const writable = (U1(C.vLen > 0) << 21) | (U1(C.fLen >= 32) << 5) | (U1(C.fLen == 64) << 3) | (U1(C.useMulDiv) << 12) | (U1(C.useCompressed) << 2) | U1(C.useAtomics)
      const extensions = if writeLow#[5] == 0 { writeLow & 0xfffffff7 } else { writeLow }
      reg_misa = (reg_misa & (0xffffffff ^ writable)) | (extensions & writable)
    }
    if csrWriteEnable != 0 and io_rw_addr == 0x7c1 {
      fetchControl = csrWrite & controlMask
    }
  }
  if csrWriteEnable != 0 and io_rw_addr == 0x304 {
    reg_mie = csrWrite & machineMask
  }
  if csrWriteEnable != 0 and io_rw_addr == 0x341 {
    reg_mepc = csrWrite#[1..<C.xLen] << 1
  } elif machineTrap != 0 { reg_mepc = epc }
  if csrWriteEnable != 0 and io_rw_addr == 0x343 {
    reg_mtval = csrWrite
  } elif machineTrap != 0 { reg_mtval = trapValue }
  if csrWriteEnable != 0 and io_rw_addr == 0x340 {
    reg_mscratch = csrWrite
  }
  if !reset {
    const wake:U1 = U1(pendingIRQs != 0) | io_interrupts_debug | exception
    const waitForInterrupt = systemInsn & U1(io_rw_addr == 0x105) & ~singleStep & ~inDebug
    reg_wfi = ~wake & (waitForInterrupt | reg_wfi)
  }
  io_rw_rdata = csrRead
  const badPrivilege = privilege < addr#[8..<10]
  const userCounter = (countBank == 0x60 or countBank == 0x64) and privilege != 3
  const permittedCounters = if C.useSupervisor and privilege == 0 { counterEnable & sCounters } else { counterEnable }
  const counterAllowed = ((permittedCounters >> addr#[0..<5]) & 1) != 0
  io_decode_0_read_illegal = illegalCSR | U1(badPrivilege or (privilege == 1 and addr == 0x180 and sFlags#[20] != 0) or (userCounter and !counterAllowed))
  io_decode_0_write_illegal = U1(addr#[10..<12] == 3)
  io_decode_0_write_flush = U1(machineAlias < 0x340 or machineAlias > 0x343)
  sum = sStatus#[18] != 0
  mxr = sStatus#[19] != 0
  const restrictedSystem = (addr#[5..<12] == 9 and sFlags#[20] != 0) or (addr == 0x102 and sFlags#[22] != 0) or (addr == 0x105 and sFlags#[21] != 0)
  io_decode_0_system_illegal = illegalSystem | U1(badPrivilege or (privilege < 3 and restrictedSystem))
  io_decode_0_virtual_access_illegal = 0
  io_decode_0_virtual_system_illegal = 0
  io_csr_stall = stalled
  io_eret = redirect
  io_singleStep = singleStep
  io_status_prv = privilege
  io_status_dprv = if mprv != 0 and inDebug == 0 { reg_mstatus_mpp } else { privilege }
  io_status_cease = ceased
  io_evec = if sret { sEpc } elif returning == 0 and delegate and trapToDebug == 0 { sVector } else { machineVector }
  io_time = cycles#[0..<C.xLen]
  io_fcsr_rm = fcsr#[5..<8]
  fpEnabled = fpStatus#[13..<15] != 0 and reg_misa#[5] != 0
  io_interrupt = takeInterrupt
  io_interrupt_cause = 0x80000000 | irqNumber
  io_inhibit_cycle = inhibitCycle
  io_trace_0_valid = traceValid
  io_trace_0_iaddr = io_pc
  io_trace_0_insn = io_inst_0
  io_trace_0_priv = tracePrivilege
  io_trace_0_exception = exception
  io_trace_0_interrupt = interruptCause
  io_trace_0_cause = architecturalCause
  io_trace_0_tval = io_tval
  io_customCSRs_0_value = fetchControl
}
