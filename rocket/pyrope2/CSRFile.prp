// Local interrupts override the standard priority order. Debug has final priority.
comb interruptCauseCode<C>(debug:Bool, enabledIRQs:Unsigned(bits=C.xLen)) -> (irqNumber:U6) {
  irqNumber = if enabledIRQs#[13] != 0 { 13 }
    elif enabledIRQs#[11] != 0 { 11 }
    elif enabledIRQs#[3] != 0 { 3 }
    elif enabledIRQs#[7] != 0 { 7 }
    elif enabledIRQs#[9] != 0 { 9 }
    elif enabledIRQs#[1] != 0 { 1 }
    elif enabledIRQs#[5] != 0 { 5 }
    else { 4 }
  for i in 0..<C.nLocalInterrupts {
    if enabledIRQs#[16 + i] != 0 {
      irqNumber = 16 + i
    }
  }
  if debug {
    irqNumber = 14
  }
}

