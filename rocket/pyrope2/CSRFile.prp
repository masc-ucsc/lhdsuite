  const pendingIRQs = enables & mip
  const machineIRQs = if privilege != 3 or reg_mstatus_mie != 0 { pendingIRQs & ~iDeleg } else { 0 }
  const supervisorIRQs = if privilege == 0 or (privilege == 1 and sie != 0) { pendingIRQs & iDeleg } else { 0 }
  const enabledIRQs = if machineIRQs != 0 { machineIRQs } else { supervisorIRQs }
  const interruptPending = U1(enabledIRQs != 0) | io_interrupts_debug
  mut irqNumber:U6 = if enabledIRQs#[13] != 0 { 13 } elif enabledIRQs#[11] != 0 { 11 }
