        addr=io_rw_addr, cmd=io_rw_cmd, operand=io_rw_wdata, pc=io_pc, privilege=privilege, virtualized=reg_mstatus_v,
        compressed=reg_misa#[2], cause=cause, exception=exception, ebreak=ebreak, retire=io_retire, dret=U1(dret))
  } else {
