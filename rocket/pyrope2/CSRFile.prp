  wire scontext:Unsigned(bits=C.xLen) = nil
  wire mode:U1 = nil
  wire sRead:Unsigned(bits=C.xLen) = nil
  wire unitStatus:Unsigned(bits=C.xLen) = nil
  wire fpStatus:Unsigned(bits=C.xLen) = nil
  wire fcsr:U8 = nil
  wire sStatus:Unsigned(bits=C.xLen) = nil
  wire sFlags:U32 = nil
  wire sPending:U12 = nil
  wire sEnabled:Unsigned(bits=C.xLen) = nil
  wire iDeleg:Unsigned(bits=C.xLen) = nil
  wire delegate:Bool = nil
  wire sVector:Unsigned(bits=C.xLen) = nil
  wire sEpc:Unsigned(bits=C.xLen) = nil
  wire spp:U1 = nil
  wire sie:U1 = nil
  wire sCounters:Unsigned(bits=C.counterBits) = nil
  wire machineFIOM:U1 = nil
  wire privilege:U2 = nil
  wire mprv:U1 = nil
  wire debugPrivilege:U2 = nil
  wire inDebug:U1 = nil
  wire stepped:U1 = nil
  wire singleStep:U1 = nil
  wire counterEnable:Unsigned(bits=C.counterBits) = nil
  reg reg_mstatus_mpp:U2:[clock_pin=clock]
  reg reg_mstatus_mpie:U1:[clock_pin=clock]
  reg reg_mstatus_mie:U1:[clock_pin=clock]
  reg reg_mie:Unsigned(bits=C.xLen):[clock_pin=clock]
  reg reg_mepc:Unsigned(bits=C.xLen):[clock_pin=clock]
  reg reg_mcause:Unsigned(bits=C.xLen):[clock_pin=clock]
  reg reg_mtval:Unsigned(bits=C.xLen):[clock_pin=clock]
  reg reg_mscratch:Unsigned(bits=C.xLen):[clock_pin=clock]
  reg reg_mtvec:U32:[clock_pin=clock]
