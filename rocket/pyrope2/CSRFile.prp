    == 0xb80 { cycles#[32..<64] } == 0xc80 { cycles#[32..<64] } == 0xb82 { retired#[32..<64] } == 0xc82 { retired#[32..<64] }
    else { debugRead | pmpRead | sRead | triggerRead | contextRead | hpmRead }
