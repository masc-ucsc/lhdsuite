        cmd=io_rw_cmd, writeData=csrWrite, operand=io_rw_wdata, seip=io_interrupts_seip, compressed=reg_misa#[2],
        trap=exception != 0 and trapToDebug == 0, sret=sret, cause=architecturalCause, pc=io_pc, tval=trapValue)
    sRead = sv.rdata
    sStatus = sv.status
    sFlags = sv.flags
    sPending = sv.pending
    sEnabled = sv.enabled
    iDeleg = sv.ideleg
    delegate = sv.delegated
    satp = sv.satp
    sVector = sv.vector
    sEpc = sv.returnPC
    spp = sv.spp
    sie = sv.sie
    sCounters = sv.counters
  } else {
    sRead = 0
    sStatus = 0
    sFlags = 0
    sPending = 0
    sEnabled = 0
    iDeleg = 0
    delegate = false
    satp = 0
    sVector = 0
    sEpc = 0
    spp = 0
    sie = 0
    sCounters = 0
  }
  if C.useUser {
