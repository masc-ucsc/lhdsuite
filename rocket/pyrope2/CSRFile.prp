  const debugCSR = addr >= 0x7b0 and addr <= 0x7bf
  const illegalCSR = U1(csrExists == 0 or (debugCSR and inDebug == 0))
  const machineAlias = addr | 0x300
  const illegalSystem = U1(io_decode_0_inst == 0x7b200073 and inDebug == 0)
  const ecallPrivilege = if reg_mstatus_v != 0 and privilege#[0] != 0 { 2 } else { privilege }
