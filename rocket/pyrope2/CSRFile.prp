    io_trace_0_iaddr:Unsigned(bits=C.xLen)@[], io_trace_0_insn:U32@[], io_trace_0_priv:U3@[],
    io_trace_0_exception:U1@[], io_trace_0_interrupt:U1@[], io_trace_0_cause:Unsigned(bits=C.xLen)@[],
