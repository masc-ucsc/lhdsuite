  io_status_mpv = reg_mstatus_mpv
  io_status_gva = reg_mstatus_gva
  io_status_mpp = reg_mstatus_mpp
  io_status_mpie = reg_mstatus_mpie
  io_status_mie = reg_mstatus_mie
  io_status_debug = inDebug
  io_status_wfi = reg_wfi
