  }
  if C.useUser {
    const returnPrv = if dret { debugPrivilege } elif sret { spp } else { mpp }
    const u = UserPrivilege<COUNTERS=C.counterBits, S=C.useSupervisor>(clk=clock, returnPrv=returnPrv, write=csrWriteEnable, csr=io_rw_addr, data=writeLow, exception=exception != 0, returning=returning != 0, delegated=delegate and trapToDebug == 0, basicCounters=C.haveBasicCounters)
    privilege = u.prv
    mprv = u.mprv
    counterEnable = u.counters
    machineFIOM = u.fiom
  } else {
    privilege = Prv.machine
    mprv = 0
    counterEnable = 0
    machineFIOM = 0
  }
  const machineReturn:U1 = returning & U1(!dret) & U1(!sret)
  virtualMode &= ~returning & (~exception | (trapToDebug & inDebug))
  mpv = ~machineReturn & (if machineTrap != 0 { virtualMode } else { mpv })
  if machineTrap != 0 {
    gva = io_gva
  }
  if C.useUser and csrWriteEnable and io_rw_addr == csrAddr.mstatus {
    mpp = legalPrivilege<S=C.useSupervisor>(mode=writeLow#[11..<13])
  } elif returning != 0 and !dret and !sret {
    mpp = if C.useUser { Prv.user } else { Prv.machine }
  } elif exception != 0 and trapToDebug == 0 and !delegate {
    mpp = privilege
  }
  if csrWriteEnable and io_rw_addr == csrAddr.mstatus {
    mpie = writeLow#[7..<8]
    mieEnabled = writeLow#[3..<4]
  } else {
    mpie = machineReturn | (if machineTrap != 0 { mieEnabled } else { mpie })
    if machineReturn != 0 {
      mieEnabled = mpie
    } else {
      mieEnabled &= ~machineTrap
    }
  }
  if csrWriteEnable and io_rw_addr == csrAddr.mcause {
    mcause = csrWrite & ((1 << (C.xLen - 1)) | ((1 << std.clog2(16 + C.nLocalInterrupts)) - 1))
  } elif machineTrap != 0 {
    mcause = architecturalCause
  }
  if C.mtvecWritable and csrWriteEnable and io_rw_addr == csrAddr.mtvec {
    mtvecValue = writeLow
  }
  if writeEnabled and io_rw_addr == csrAddr.mcountinhibit {
    mcountinhibit = writeLow#[0..<C.counterBits] & ((1 << C.counterBits) - 3)
  }
  if C.misaWritable and csrWriteEnable and io_rw_addr == csrAddr.misa and (misa#[2] == 0 or io_pc#[1] == 0 or writeLow#[2] != 0) {
    const writable = (U1(C.vLen > 0) << 21) | (U1(C.fLen >= 32) << 5) | (U1(C.fLen == 64) << 3) | (U1(C.useMulDiv) << 12) | (U1(C.useCompressed) << 2) | U1(C.useAtomics)
    const extensions = if writeLow#[5] == 0 { writeLow & 0xfffffff7 } else { writeLow }
    misa = (misa & (0xffffffff ^ writable)) | (extensions & writable)
  }
  if csrWriteEnable and io_rw_addr == csrAddr.fetchControl {
    fetchControl = csrWrite & controlMask
  }
  if csrWriteEnable and io_rw_addr == csrAddr.mie {
    mie = csrWrite & machineMask
  }
  if csrWriteEnable and io_rw_addr == csrAddr.mepc {
    mepc = csrWrite#[1..<C.xLen] << 1
  } elif machineTrap != 0 {
    mepc = epc
  }
  if csrWriteEnable and io_rw_addr == csrAddr.mtval {
    mtval = csrWrite
  } elif machineTrap != 0 {
    mtval = trapValue
  }
  if csrWriteEnable and io_rw_addr == csrAddr.mscratch {
    mscratch = csrWrite
  }
  if !reset {
    const wake:U1 = U1(pendingIRQs != 0) | io_interrupts_debug | exception
    const waitForInterrupt = U1(systemInsn and io_rw_addr == SystemOp.wfi and singleStep == 0 and inDebug == 0)
    waitingForInterrupt = ~wake & (waitForInterrupt | waitingForInterrupt)
  }
  io_rw_rdata = csrRead
  const badPrivilege = privilege < addr#[8..<10]
  const userCounter = (countBank == 0x60 or countBank == 0x64) and privilege != Prv.machine
  const permittedCounters = if C.useSupervisor and privilege == Prv.user { counterEnable & sCounters } else { counterEnable }
  const counterAllowed = ((permittedCounters >> addr#[0..<5]) & 1) != 0
  io_decode_0_read_illegal = illegalCSR | U1(badPrivilege or (privilege == Prv.supervisor and addr == csrAddr.satp and sFlags#[20] != 0) or (userCounter and !counterAllowed))
  io_decode_0_write_illegal = U1(addr#[10..<12] == 3)
  io_decode_0_write_flush = U1(machineAlias < csrAddr.mscratch or machineAlias > csrAddr.mtval)
  sum = sStatus#[18] != 0
  mxr = sStatus#[19] != 0
  const restrictedSystem = (addr#[5..<12] == 9 and sFlags#[20] != 0) or (addr == SystemOp.sret and sFlags#[22] != 0) or (addr == SystemOp.wfi and sFlags#[21] != 0)
  io_decode_0_system_illegal = illegalSystem | U1(badPrivilege or (privilege < Prv.machine and restrictedSystem))
  io_decode_0_virtual_access_illegal = 0
  io_decode_0_virtual_system_illegal = 0
  io_csr_stall = stalled
  io_eret = redirect
  io_singleStep = singleStep
  io_status_prv = privilege
  io_status_dprv = if mprv != 0 and inDebug == 0 { mpp } else { privilege }
  io_status_cease = ceased
  io_evec = if sret { sEpc } elif returning == 0 and delegate and trapToDebug == 0 { sVector } else { machineVector }
  io_time = cycles#[0..<C.xLen]
  io_fcsr_rm = fcsr#[5..<8]
  fpEnabled = fpStatus#[13..<15] != 0 and misa#[5] != 0
  io_interrupt_cause = 0x80000000 | irqNumber
  io_inhibit_cycle = inhibitCycle
  io_trace_0_valid = traceValid
  io_trace_0_iaddr = io_pc
  io_trace_0_insn = io_inst_0
  io_trace_0_priv = tracePrivilege
  io_trace_0_exception = exception
  io_trace_0_interrupt = interruptCause
  io_trace_0_cause = architecturalCause
  io_trace_0_tval = io_tval
  io_customCSRs_0_value = fetchControl
}
