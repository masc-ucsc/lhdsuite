pub mod MaxPeriodFibonacciLFSR::[timecheck=false](clock:u1, reset:u1, io_increment:u1) -> (io_out_0:u1@[], io_out_1:u1@[], io_out_2:u1@[], io_out_3:u1@[], io_out_4:u1@[], io_out_5:u1@[], io_out_6:u1@[], io_out_7:u1@[], io_out_8:u1@[], io_out_9:u1@[], io_out_10:u1@[], io_out_11:u1@[], io_out_12:u1@[], io_out_13:u1@[], io_out_14:u1@[], io_out_15:u1@[]) {
  reg state_0:u1:[initial=1, reset_pin=ref reset, async=true]
  reg state_1:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_2:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_3:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_4:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_5:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_6:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_7:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_8:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_9:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_10:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_11:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_12:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_13:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_14:u1:[initial=0, reset_pin=ref reset, async=true]
  reg state_15:u1:[initial=0, reset_pin=ref reset, async=true]
  if not (reset != 0) {
    if io_increment != 0 {
      state_0 = (((((state_15 ^ state_13) & 1) ^ state_12) & 1) ^ state_10) & 1
      state_1 = state_0
      state_2 = state_1
      state_3 = state_2
      state_4 = state_3
      state_5 = state_4
      state_6 = state_5
      state_7 = state_6
      state_8 = state_7
      state_9 = state_8
      state_10 = state_9
      state_11 = state_10
      state_12 = state_11
      state_13 = state_12
      state_14 = state_13
      state_15 = state_14
    }
  }
  io_out_0 = state_0
  io_out_1 = state_1
  io_out_2 = state_2
  io_out_3 = state_3
  io_out_4 = state_4
  io_out_5 = state_5
  io_out_6 = state_6
  io_out_7 = state_7
  io_out_8 = state_8
  io_out_9 = state_9
  io_out_10 = state_10
  io_out_11 = state_11
  io_out_12 = state_12
  io_out_13 = state_13
  io_out_14 = state_14
  io_out_15 = state_15
}
