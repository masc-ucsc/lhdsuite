# Rocket-chip TinyConfig, in both source languages. The Verilog is the firtool
# emit of the canonical chipsalliance/rocket-chip TinyConfig (extracted from
# mascucsc/hagent-xiangshan:latest on 2026-08-29, mill target
# `emulator[freechips.rocketchip.system.TestHarness,freechips.rocketchip.system.TinyConfig].mfccompiler.rtls`).
# The bench is scoped to RocketTile (core + L1 caches): verilog/filelist.f lists
# only its cone, and pyrope/ is that cone regenerated by `lhd compile verilog
# --top RocketTile` (2026-11-03, PROVEN-full vs the Verilog). The other .sv
# files stay for the whole SoC, whose Pyrope emission is blocked in lhd.

filegroup(
    name = "verilog",
    srcs = glob(["verilog/*.sv", "verilog/*.v", "verilog/vsrc/*.v"]) + ["verilog/filelist.f"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "verilog_filelist",
    srcs = ["verilog/filelist.f"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pyrope",
    srcs = glob(["pyrope/*.prp"]) + glob(["pyrope/manifest.json"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pyrope_top",
    srcs = glob(["pyrope/RocketTile.prp"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sim",
    srcs = glob(["sim/*.prp", "sim/*.cpp"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "verif",
    srcs = glob(["verif/*.prp"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "tests",
    srcs = glob(["tests/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)
