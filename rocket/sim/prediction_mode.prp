const image = import("BootROM.Image")
const cfg = import("../pyrope2/RocketConfig")
comptime const p32 = cfg.params(btbEntries=16, branchPredictionModeCSR=true)
comptime const p64 = cfg.params(xLen=64, btbEntries=16, bhtEntries=64, nRAS=6, branchPredictionModeCSR=true)
comptime const absent = cfg.params(btbEntries=16)

// Time the same loop in dynamic, static, and dynamic mode. The first two
// branches in the loop fall through. One is compressed and one straddles words.
comb firmware() -> (words:[32]U32) {
  words = (
    0x7c0022f3, // csrr t0,0x7c0
    0x04029463, // bnez t0,1008c <fail>
    0x00100413, // li s0,1
    0x044000ef, // jal ra,10090 <bench>
    0x00050493, // mv s1,a0
    0x7c0fd2f3, // csrrwi t0,0x7c0,31
    0x02029a63, // bnez t0,1008c <fail>
    0x7c0022f3, // csrr t0,0x7c0
    0x02829663, // bne t0,s0,1008c <fail>
    0x02c000ef, // jal ra,10090 <bench>
    0x00050913, // mv s2,a0
    0x0324f063, // bgeu s1,s2,1008c <fail>
    0x7c00f2f3, // csrrci t0,0x7c0,1
    0x00829c63, // bne t0,s0,1008c <fail>
    0x7c0022f3, // csrr t0,0x7c0
    0x00029863, // bnez t0,1008c <fail>
    0x010000ef, // jal ra,10090 <bench>
    0x01257463, // bgeu a0,s2,1008c <fail>
    0x0000006f, // j 10088 <success>
    0x00100073, // ebreak
    0x01800293, // li t0,24
    0x00000593, // li a1,0
    0xb0002373, // csrr t1,mcycle
    0x07e3d865, // beqz s0,1008c <fail> / beqz s0,1008c <fail>
    0x0585fe04, // addi a1,a1,1
    0xfff28293, // addi t0,t0,-1
    0xfe029ae3, // bnez t0,1009c <loop>
    0xb0002573, // csrr a0,mcycle
    0x40650533, // sub a0,a0,t1
    0x01800393, // li t2,24
    0xfc759ae3, // bne a1,t2,1008c <fail>
    0x00008067 // ret
  )
}

mod run<C>(clk:Clock, rst:Reset) -> (done:Bool@[], bad:Bool@[], start:Bool@[], finish:Bool@[]) {
  const d = image<C=C,WORDS=32>(clk=clk, rst=rst, program=firmware(), successPC=0x10088)
  done = d.success
  bad = d.trap != 0
  start = d.traceValid and d.tracePC == 0x10098
  finish = d.traceValid and d.tracePC == 0x100ac
}

pub mod prediction_mode(clk:Clock, rst:Reset) -> (done:U2@[], bad:Bool@[], start:U2@[], finish:U2@[], illegal:Bool@[]) {
  const a = run<p32>(clk=clk, rst=rst)
  const b = run<p64>(clk=clk, rst=rst)
  const off = image<C=absent,WORDS=32>(clk=clk, rst=rst, program=firmware(), successPC=0x10088)
  done = (U1(b.done) << 1) | U1(a.done)
  bad = a.bad or b.bad
  start = (U1(b.start) << 1) | U1(a.start)
  finish = (U1(b.finish) << 1) | U1(a.finish)
  illegal = off.trap != 0 and off.cause == 2 and off.tracePC == 0x10040
}

test prediction_mode.switch_at_runtime {
  mut d = prediction_mode
  mut done:U2 = 0
  mut illegal = false
  mut from32 = 0
  mut from64 = 0
  mut count32 = 0
  mut count64 = 0
  tick 1900 {
    d.rst = clock < 4
    step
    if clock > 4 {
      assert(!d.bad, "mode readback, loop timing or retired path")
      done |= d.done
      illegal = illegal or d.illegal
      if d.start#[0] != 0 { from32 = clock }
      if d.start#[1] != 0 { from64 = clock }
      if d.finish#[0] != 0 { puts("RV32 pass {count32} cycles {clock-from32}"); count32 += 1 }
      if d.finish#[1] != 0 { puts("RV64 pass {count64} cycles {clock-from64}"); count64 += 1 }
    }
  }
  assert(done == 3 and illegal and count32 == 3 and count64 == 3)
}
