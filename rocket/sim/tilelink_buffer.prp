const Queue = import("../pyrope2/Queue.Queue")
const TLBuffer = import("../pyrope2/TLBuffer.TLBuffer")

type Beat = (tag:U3, data:U17)
type Response = (code:U2, denied:U1)

pub mod tilelink_buffer(clk:Clock, rst:Reset, send:U1, take:U1, tag:U3, data:U17, reply:U1, consume:U1, code:U2, denied:U1) -> (aData:U17@[], aTag:U3@[], dCode:U2@[], dDenied:U1@[], dReady:U1@[], dValid:U1@[], flowData:U17@[], flowReady:U1@[], flowValid:U1@[], oddReady:U1@[], oddTag:U3@[], oddValid:U1@[], ready:U1@[], valid:U1@[]) {
  const b = TLBuffer<A=Beat, D=Response>(clk=clk, rst=rst, aValid=send, aReady=take, request=(tag=tag, data=data), dValid=reply, dReady=consume, response=(code=code, denied=denied))
  ready = b.inReady
  valid = b.outValid
  aTag = b.outA.tag
  aData = b.outA.data
  dReady = b.outReady
  dValid = b.inValid
  dCode = b.inD.code
  dDenied = b.inD.denied
  const q = Queue<Beat, DEPTH=1, FLOW=true>(clk=clk, rst=rst, offer=send, take=take, payload=(tag=tag, data=data))
  flowReady = q.ready
  flowValid = q.valid
  flowData = q.head.data
  const three = Queue<U3, DEPTH=3>(clk=clk, rst=rst, offer=send, take=take, payload=tag)
  oddReady = three.ready
  oddValid = three.valid
  oddTag = three.head
}

test tilelink_buffer.stalls {
  mut b = tilelink_buffer
  b.rst = true
  step
  b.rst = false
  b.send = 1
  b.tag = 5
  b.data = 0x12345
  b.reply = 1
  b.code = 3
  b.denied = 1
  step
  b.reply = 0
  b.tag = 2
  b.data = 0x1abcd
  step
  assert(b.ready == 0 and b.valid == 1 and b.aTag == 5 and b.aData == 0x12345)
  assert(b.flowReady == 0 and b.flowValid == 1 and b.flowData == 0x12345)
  assert(b.dReady == 1 and b.dValid == 1 and b.dCode == 3 and b.dDenied == 1)
  b.send = 0
  b.take = 1
  step
  assert(b.ready == 1 and b.valid == 1 and b.aTag == 2 and b.aData == 0x1abcd)
  assert(b.flowReady == 1 and b.flowValid == 0 and b.dValid == 1)
  b.consume = 1
  step
  assert(b.valid == 0 and b.dValid == 0)
  b.data = 0x15555
  b.send = 1
  step
  assert(b.flowReady == 1 and b.flowValid == 1 and b.flowData == 0x15555)
  b.send = 0
  step
  assert(b.flowValid == 0)
}

test tilelink_buffer.depth_three {
  mut b = tilelink_buffer
  b.rst = true
  step
  b.rst = false
  b.send = 1
  b.tag = 1
  step
  b.tag = 2
  step
  b.tag = 3
  step
  assert(b.oddValid == 1 and b.oddReady == 0 and b.oddTag == 1)
  b.take = 1
  b.send = 0
  step
  assert(b.oddTag == 2)
  b.send = 1
  b.tag = 7
  step
  assert(b.oddTag == 3)
  b.send = 0
  step
  assert(b.oddTag == 7)
  step
  assert(b.oddReady == 1 and b.oddValid == 0)
}
