const configs = import("../pyrope2/RocketConfig")
const cachePort = import("../pyrope2/DCache.DCache")
const cache = import("../pyrope2/CacheBanks.CacheBanks")

// Hold both D grants until two independent misses have reached A. Return the
// second line first; keep its CPU response stalled while the first fills.
pub mod nonblocking_cache(clk:Clock, rst:Reset, issue:Bool, addr:U32, accept:Bool, grant:Bool, source:U5, word:U32) -> (acquire:Bool@[], bank:U5@[], dReady:Bool@[], id:U5@[], line:U32@[], ready:Bool@[], response:Bool@[], value:U32@[]) {
  comptime const c = configs.params(dcacheBlockBytes=16, dcacheSets=4, dcacheWays=1, useDataScratchpad=false, nMSHRs=3)
  const d = cache<C=c, N=3>(clk=clk, rst=rst, request=issue, address=addr, command=0, mask=15, data=0, responseReady=accept, aReady=true, bValid=false, bAddress=0, bParam=0, bSource=0, cReady=true, dValid=grant, dOpcode=5, dParam=1, dSource=source, dSink=source#[0..<4], dData=word, dDenied=false, dCorrupt=false, eReady=true)
  reg sampled:(ready:Bool, response:Bool, value:U32, bank:U5, acquire:Bool, line:U32, id:U5, dReady:Bool) = nil
  sampled = (acquire=d.aValid, bank=d.returnBank, dReady=d.dReady, id=d.aSource, line=d.aAddress, ready=d.ready, response=d.response, value=d.result)
  (ready, response, value, bank, acquire, line, id, dReady) = sampled
}

test nonblocking_cache.two_misses {
  mut d = nonblocking_cache
  mut issued = 0
  mut acquired = 0
  mut granted = 0
  mut received = 0
  tick 90 {
    d.rst = clock < 2
    d.issue = clock >= 2 and issued < 2
    d.addr = if issued == 0 { 0x1004 } else { 0x1018 }
    d.grant = acquired == 2 and granted < 8
    d.source = if granted < 4 { 2 } else { 1 }
    d.word = 256 + granted
    d.accept = clock > 40
    step
    if clock >= 2 {
      if d.issue and d.ready {
        issued += 1
      }
      if d.acquire {
        assert((d.id == 1 and d.line == 0x1000) or (d.id == 2 and d.line == 0x1010), "acquire source owns line")
        acquired += 1
      }
      if d.grant and d.dReady {
        granted += 1
      }
      if d.response {
        assert((received == 0 and d.bank == 1 and d.value == 258) or (received == 1 and d.bank == 0 and d.value == 261), "out-of-order return and stable stalled response")
        if d.accept {
          received += 1
        }
      }
    }
  }
  assert(issued == 2 and acquired == 2 and granted == 8 and received == 2, "overlapped both misses")
}

// Exercise the CPU pipeline and its saved tags as well as the coherent banks.
// The manager withholds the first grant until both acquires have handshaken.
pub mod pipeline(clk:Clock, rst:Reset, issue:Bool, second:Bool, grant:Bool, source:U5, word:U32) -> (acceptedD:Bool@[], acquire:Bool@[], nack:Bool@[], ready:Bool@[], response:Bool@[], tag:U7@[], value:U32@[]) {
  comptime const profile = configs.params(dcacheBlockBytes=16, nMSHRs=2, useDataScratchpad=false, dcacheSets=4, dcacheWays=1)
  const d = cachePort<profile>(clock=clk, reset=rst, io_ptw_status_debug=0, pmpPermissions=3, auto_out_a_ready=0, auto_out_d_valid=0, auto_out_d_bits_opcode=0, auto_out_d_bits_size=0, auto_out_d_bits_denied=0, auto_out_d_bits_data=0, memAReady=true, memCReady=true, memDValid=grant, memDOpcode=5, memDParam=1, memDSource=source, memDSink=1, memDData=word, memEReady=true, request=(address=(if second {
          0x80000018
        } else {
          0x80000004
        }), command=0, isSigned=false, kill=false, physical=false, privilege=3, size=2, skipException=false, storeData=0, storeMask=0, tag=(if second {
          12
        } else {
          10
        }), valid=issue, virtual=false))
  reg sample:(ready:Bool, acquire:Bool, acceptedD:Bool, response:Bool, tag:U7, value:U32, nack:Bool) = nil
  sample = (acceptedD=d.memDReady and grant, acquire=d.memAValid, nack=d.response.s2Nack, ready=d.response.reqReady, response=d.response.respValid, tag=d.response.respTag, value=d.response.respData)
  (ready, acquire, acceptedD, response, tag, value, nack) = sample
}

test pipeline.reordered_loads {
  mut d = pipeline
  mut issued = 0
  mut acquired = 0
  mut beats = 0
  mut returns = 0
  tick 80 {
    d.rst = clock < 3
    d.issue = clock >= 3 and issued < 2
    d.second = issued != 0
    d.grant = acquired == 2 and beats < 8
    d.source = if beats < 4 { 2 } else { 1 }
    d.word = 256 + beats
    step
    if clock >= 3 {
      if d.ready and d.issue {
        issued += 1
      }
      if d.acquire {
        acquired += 1
      }
      if d.acceptedD {
        beats += 1
      }
      assert(!d.nack, "independent misses accepted")
      if d.response {
        assert((returns == 0 and d.tag == 12 and d.value == 258) or (returns == 1 and d.tag == 10 and d.value == 261), "restored CPU tag, lane and payload")
        returns += 1
      }
    }
  }
  assert(issued == 2 and acquired == 2 and beats == 8 and returns == 2, "overlapping end-to-end requests")
}
