const boot = import("BootROM.BootROM")
const configs = import("../pyrope2/RocketConfig")
comptime const profile32 = configs.rv32
comptime const wide = configs.rv64

comptime const minimal = configs.params(useCompressed=false, useMulDiv=false, useAtomics=false, fastLoadWord=false, icacheBlockBytes=32, dcacheBlockBytes=32)
comptime const fast64 = configs.params(xLen=64, fastLoadByte=true, icacheSets=32, icacheWays=4)

// The boot ROM contains one 64-byte line at the tile's reset vector.
// Failed comparisons branch to the trap instruction. Success loops at offset 56.
comb rom<W=32>() -> (words:[16]U32) {
  words = (
    0x00100093, // addi x1,x0,1
    0x01f09093, // slli x1,x1,31 (DTIM base)
    0x00100113, // addi x2,x0,1
    if W == 64 { 0x02811113 } else { 0x01811113 }, // shift by 40 or 24
    0xfff10113, // addi x2,x2,-1
    if W == 64 { 0x0020b023 } else { 0x0020a023 }, // SD or SW
    if W == 64 { 0x0000b183 } else { 0x0000a183 }, // LD or LW
    0x02311063, // bne x2,x3,fail
    if W == 64 { 0x0040e203 } else { 0x0020c203 }, // LWU high word, or LBU byte 2
    0x0ff00293, // addi x5,x0,255
    0x00521a63, // bne x4,x5,fail
    0x00008303, // lb x6,0(x1)
    0xfff00393, // addi x7,x0,-1
    0x00731463, // bne x6,x7,fail
    0x0000006f, // success
    0x00100073, // ebreak
  )
}

pub mod tile_profiles(clk:Clock, rst:Reset) -> (failed:Bool@[], ok32:Bool@[], ok64:Bool@[], okFast:Bool@[], okMinimal:Bool@[]) {
  const rv32 = boot<profile32>(clk=clk, rst=rst, program=rom<W=profile32.xLen>(), successPC=0x10078)
  const rv64 = boot<wide>(clk=clk, rst=rst, program=rom<W=wide.xLen>(), successPC=0x10078)
  const lean = boot<minimal>(clk=clk, rst=rst, program=rom<W=minimal.xLen>(), successPC=0x10078)
  const fast = boot<fast64>(clk=clk, rst=rst, program=rom<W=fast64.xLen>(), successPC=0x10078)
  okMinimal = lean.success
  okFast = fast.success
  ok32 = rv32.success
  ok64 = rv64.success
  failed = rv32.trap != 0 or rv64.trap != 0 or rv32.badFetch or rv64.badFetch or lean.trap != 0 or fast.trap != 0 or lean.badFetch or fast.badFetch
}

test tile_profiles.boot_from_rom {
  mut d = tile_profiles
  mut saw32 = false
  mut saw64 = false
  mut sawMinimal = false
  mut sawFast = false
  tick 100 {
    d.rst = clock < 4
    step
    if clock > 4 {
      assert(!d.failed, "tile trapped or issued an unexpected bus transaction")
      if d.ok32 {
        saw32 = true
      }
      if d.ok64 {
        saw64 = true
      }
      if d.okMinimal {
        sawMinimal = true
      }
      if d.okFast {
        sawFast = true
      }
    }
  }
  assert(saw32 and saw64 and sawMinimal and sawFast, "all four configurations verified the scratchpad contents")
}
