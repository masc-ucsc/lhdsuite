const rocket = import("../pyrope2/Rocket.Rocket")
const configs = import("../pyrope2/RocketConfig")
comptime const wide = configs.rv64
pub mod rv64_program(clk:Clock, rst:Reset) -> (didStore:Bool@[], retired:U1@[], tracePC:U64@[], traceTime:U64@[], trap:U1@[], value:U64@[], where:U64@[]) {
  reg pc:U64 = 0
  reg s1Addr:U64 = 0
  reg s1Tag:U7 = 0
  reg s2Tag:U7 = 0
  reg s1Store:Bool = false
  reg s1Load:Bool = false
  reg s2Load:Bool = false
  reg memory:[4]U64 = 0
  reg readIndex:U2 = 0
  const readData = memory[readIndex]
  const instruction:U32 = match pc {
    == 0 { 0x00100093 } // addi x1,x0,1
    == 4 { 0x02809093 } // slli x1,x1,40
    == 8 { 0xfff08093 } // addi x1,x1,-1
    == 12 { 0x00103023 } // sd x1,0(x0)
    == 16 { 0x00003183 } // ld x3,0(x0)
    == 20 { 0x0201d193 } // srli x3,x3,32
    == 24 { 0x00303423 } // sd x3,8(x0)
    == 28 { 0x0010811b } // addiw x2,x1,1
    == 32 { 0x00203823 } // sd x2,16(x0)
    == 36 { 0x01800413 } // addi x8,x0,24
    == 40 { 0xfff00493 } // addi x9,x0,-1
    == 44 { 0xe0042489 } // c.addiw x9,2 followed by c.sd x9,0(x8)
    == 48 { 0x24856004 } // c.ld x9,0(x8) followed by c.addiw x9,1
    == 52 { 0x00903023 } // sd x9,0(x0)
    == 56 { 0x301022f3 } // csrrs x5,misa,x0
    == 60 { 0x00503023 } // sd x5,0(x0)
    == 64 { 0xb0009073 } // csrw mcycle,x1 (2^40 - 1)
    == 68 { 0x00000013 } // nop
    else { 0x0000006f }
  }
  const core = rocket<wide>(clock=clk, reset=rst, io_hartid=0, io_interrupts_debug=0, io_interrupts_mtip=0, io_interrupts_msip=0, io_interrupts_meip=0, io_ptw_perf_pte_miss=0, io_ptw_perf_pte_hit=0, imemResponse=(gpaBits=0, gpaValid=false, npc=(pc + 4)#[0..<64], perfAcquire=false, respBtbBridx=0, respBtbTaken=false, respData=instruction, respMask=3, respPc=pc, respReplay=false, respValid=!rst, respXcptAeInst=false, respXcptGfInst=false, respXcptPfInst=false), dmemResponse=(ordered=true, perfGrant=false, replayNext=false, reqReady=true, respData=readData, respDataWordBypass=readData, respHasData=s2Load, respReplay=false, respTag=s2Tag, respValid=s2Load, s2Nack=false, s2XcptAeLd=false, s2XcptAeSt=false, s2XcptMaLd=false, s2XcptMaSt=false, s2XcptPfLd=false, s2XcptPfSt=false))
  if core.imem.valid {
    pc = core.imem.pc
  } elif core.imem.respReady {
    wrap pc += 4
  }
  s1Addr = core.dmem.address
  s1Tag = core.dmem.tag
  s2Tag = s1Tag
  readIndex = s1Addr#[3..<5]
  s1Store = core.dmem.valid and core.dmem.command == 1
  s1Load = core.dmem.valid and core.dmem.command == 0
  s2Load = s1Load and !core.dmem.kill
  didStore = s1Store and !core.dmem.kill
  if didStore {
    memory[s1Addr#[3..<5]] = core.dmem.storeData
  }
  where = s1Addr
  value = core.dmem.storeData
  retired = core.trace.valid
  trap = core.trace.exception
  tracePC = core.trace.iaddr
  traceTime = core.io_trace_time
}
test rv64_program.execute {
  mut d = rv64_program
  mut stores:U3 = 0
  mut reachedEnd = false
  tick 80 {
    d.rst = clock == 0
    step
    if clock > 0 {
      assert(d.trap == 0, "program raised an exception")
    }
    if d.retired != 0 and d.tracePC == 72 {
      assert((d.traceTime >> 40) == 1, "RV64 trace time carries through bit 40")
      reachedEnd = true
    }
    if d.didStore {
      if stores == 0 {
        assert(d.where == 0 and d.value == 0xffffffffff, "64-bit shifted store")
      }
      if stores == 1 {
        assert(d.where == 8 and d.value == 255, "loaded high word")
      }
      if stores == 2 {
        assert(d.where == 16 and d.value == 0, "ADDIW truncation")
      }
      if stores == 3 {
        assert(d.where == 24 and d.value == 1, "C.ADDIW and C.SD")
      }
      if stores == 4 {
        assert(d.where == 0 and d.value == 2, "C.LD bypass and C.ADDIW")
      }
      if stores == 5 {
        assert(d.where == 0 and d.value == 0x8000000000801105, "misa.MXL and ISA extension bits")
      }
      wrap stores += 1
    }
  }
  assert(stores == 6 and reachedEnd, "program completed all six stores")
}

test rv64_program.reset_in_flight {
  mut d = rv64_program
  mut started = false
  mut restarted = false
  mut finished = false
  tick 80 {
    d.rst = clock == 0 or clock == 12
    step
    if clock < 12 and d.retired != 0 {
      started = true
    }
    if clock > 12 {
      assert(d.trap == 0, "an instruction from before reset raised a trap")
      if d.retired != 0 {
        if !restarted {
          assert(d.tracePC == 0, "the first retirement after reset must be the reset PC")
        }
        restarted = true
        if d.tracePC == 72 and (d.traceTime >> 40) == 1 {
          finished = true
        }
      }
    }
  }
  assert(started and restarted and finished, "the core must retire before reset and rerun the program")
}
