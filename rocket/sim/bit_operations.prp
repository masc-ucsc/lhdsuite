const configs = import("../pyrope2/RocketConfig")
const alu = import("../pyrope2/ALU.ALU")
const decode = import("../pyrope2/IDecode.IDecode")
comptime const b32 = configs.params(useZba=true, useZbb=true, useZbs=true, useConditionalZero=true)
comptime const b64 = configs.params(xLen=64, useZba=true, useZbb=true, useZbs=true, useConditionalZero=true)
comptime const zba = configs.params(xLen=64, useZba=true)
comptime const zbb = configs.params(xLen=64, useZbb=true)
comptime const zbs = configs.params(xLen=64, useZbs=true)
comptime const zicond = configs.params(xLen=64, useConditionalZero=true)

comb run<C>(a:Unsigned(bits=C.xLen), b:Unsigned(bits=C.xLen), inst:U32) -> (legal:U1, value:Unsigned(bits=C.xLen)) {
  const d = decode<C>(inst=inst)
  const rhs = if d.sel_alu2 == 2 { b } else { inst#[20..<32] }
  const x = alu<C>(io_fn=d.alu_fn, io_dw=d.alu_dw, io_in1=a, io_in2=rhs)
  legal = d.legal
  value = x.io_out
}

// Each row holds the instruction, its RV32 and RV64 answers, and the legal-XLEN mask.
pub mod bit_operations(row:U7) -> (ok:Bool@[0]) {
  const v = match row {
    == 0 { (ext=1, ins=0x0e73d1b3, legal=3, rv32=0xff008182, rv64=0x81230080ff008182) } // czero_eqz
    == 1 { (ext=1, ins=0x0e73f1b3, legal=3, rv32=0x00000000, rv64=0x0000000000000000) } // czero_nez
    == 2 { (ext=2, ins=0x2073a1b3, legal=3, rv32=0xfe010325, rv64=0x02460101fe010325) } // sh1add
    == 3 { (ext=2, ins=0x2073c1b3, legal=3, rv32=0xfc020629, rv64=0x048c0203fc020629) } // sh2add
    == 4 { (ext=2, ins=0x2073e1b3, legal=3, rv32=0xf8040c31, rv64=0x09180407f8040c31) } // sh3add
    == 5 { (ext=2, ins=0x2073a1bb, legal=2, rv32=0x00000000, rv64=0x00000001fe010325) } // sh1add_uw
    == 6 { (ext=2, ins=0x2073c1bb, legal=2, rv32=0x00000000, rv64=0x00000003fc020629) } // sh2add_uw
    == 7 { (ext=2, ins=0x2073e1bb, legal=2, rv32=0x00000000, rv64=0x00000007f8040c31) } // sh3add_uw
    == 8 { (ext=2, ins=0x087381bb, legal=2, rv32=0x00000000, rv64=0x00000000ff0081a3) } // add_uw
    == 9 { (ext=2, ins=0x0873919b, legal=2, rv32=0x00000000, rv64=0x0000007f8040c100) } // slli_uw
    == 10 { (ext=2, ins=0x0a83919b, legal=2, rv32=0x00000000, rv64=0x0081820000000000) } // slli_uw
    == 11 { (ext=4, ins=0x4073f1b3, legal=3, rv32=0xff008182, rv64=0x81230080ff008182) } // andn
    == 12 { (ext=4, ins=0x4073e1b3, legal=3, rv32=0xffffffde, rv64=0xffffffffffffffde) } // orn
    == 13 { (ext=4, ins=0x4073c1b3, legal=3, rv32=0x00ff7e5c, rv64=0x7edcff7f00ff7e5c) } // xnor
    == 14 { (ext=4, ins=0x0a73c1b3, legal=3, rv32=0xff008182, rv64=0x81230080ff008182) } // min
    == 15 { (ext=4, ins=0x0a73d1b3, legal=3, rv32=0x00000021, rv64=0x0000000000000021) } // minu
    == 16 { (ext=4, ins=0x0a73e1b3, legal=3, rv32=0x00000021, rv64=0x0000000000000021) } // max
    == 17 { (ext=4, ins=0x0a73f1b3, legal=3, rv32=0xff008182, rv64=0x81230080ff008182) } // maxu
    == 18 { (ext=4, ins=0x60039193, legal=3, rv32=0x00000000, rv64=0x0000000000000000) } // clz
    == 19 { (ext=4, ins=0x60139193, legal=3, rv32=0x00000001, rv64=0x0000000000000001) } // ctz
    == 20 { (ext=4, ins=0x60239193, legal=3, rv32=0x0000000c, rv64=0x0000000000000012) } // cpop
    == 21 { (ext=4, ins=0x6003919b, legal=2, rv32=0x00000000, rv64=0x0000000000000000) } // clzw
    == 22 { (ext=4, ins=0x6013919b, legal=2, rv32=0x00000000, rv64=0x0000000000000001) } // ctzw
    == 23 { (ext=4, ins=0x6023919b, legal=2, rv32=0x00000000, rv64=0x000000000000000c) } // cpopw
    == 24 { (ext=4, ins=0x60439193, legal=3, rv32=0xffffff82, rv64=0xffffffffffffff82) } // sext_b
    == 25 { (ext=4, ins=0x60539193, legal=3, rv32=0xffff8182, rv64=0xffffffffffff8182) } // sext_h
    == 26 { (ext=4, ins=0x0803c1bb, legal=2, rv32=0x00000000, rv64=0x0000000000008182) } // zext_h
    == 27 { (ext=4, ins=0x0803c1b3, legal=1, rv32=0x00008182, rv64=0x0000000000000000) } // zext_h
    == 28 { (ext=4, ins=0x2873d193, legal=3, rv32=0xff00ffff, rv64=0xffff00ffff00ffff) } // orc_b
    == 29 { (ext=4, ins=0x6b83d193, legal=2, rv32=0x00000000, rv64=0x828100ff80002381) } // rev8
    == 30 { (ext=4, ins=0x6983d193, legal=1, rv32=0x828100ff, rv64=0x0000000000000000) } // rev8
    == 31 { (ext=4, ins=0x607391b3, legal=3, rv32=0xfe010305, rv64=0xfe01030502460101) } // rol
    == 32 { (ext=4, ins=0x6073d1b3, legal=3, rv32=0x7f8040c1, rv64=0x7f8040c140918040) } // ror
    == 33 { (ext=4, ins=0x6073d193, legal=3, rv32=0x05fe0103, rv64=0x0502460101fe0103) } // rori
    == 34 { (ext=4, ins=0x6283d193, legal=2, rv32=0x00000000, rv64=0x80ff008182812300) } // rori
    == 35 { (ext=4, ins=0x607391bb, legal=2, rv32=0x00000000, rv64=0xfffffffffe010305) } // rolw
    == 36 { (ext=4, ins=0x6073d1bb, legal=2, rv32=0x00000000, rv64=0x000000007f8040c1) } // rorw
    == 37 { (ext=4, ins=0x6073d19b, legal=2, rv32=0x00000000, rv64=0x0000000005fe0103) } // roriw
    == 38 { (ext=8, ins=0x487391b3, legal=3, rv32=0xff008180, rv64=0x81230080ff008182) } // bclr
    == 39 { (ext=8, ins=0x48739193, legal=3, rv32=0xff008102, rv64=0x81230080ff008102) } // bclri
    == 40 { (ext=8, ins=0x4a839193, legal=2, rv32=0x00000000, rv64=0x81230080ff008182) } // bclri
    == 41 { (ext=8, ins=0x287391b3, legal=3, rv32=0xff008182, rv64=0x81230082ff008182) } // bset
    == 42 { (ext=8, ins=0x28739193, legal=3, rv32=0xff008182, rv64=0x81230080ff008182) } // bseti
    == 43 { (ext=8, ins=0x2a839193, legal=2, rv32=0x00000000, rv64=0x81230180ff008182) } // bseti
    == 44 { (ext=8, ins=0x687391b3, legal=3, rv32=0xff008180, rv64=0x81230082ff008182) } // binv
    == 45 { (ext=8, ins=0x68739193, legal=3, rv32=0xff008102, rv64=0x81230080ff008102) } // binvi
    == 46 { (ext=8, ins=0x6a839193, legal=2, rv32=0x00000000, rv64=0x81230180ff008182) } // binvi
    == 47 { (ext=8, ins=0x4873d1b3, legal=3, rv32=0x00000001, rv64=0x0000000000000000) } // bext
    == 48 { (ext=8, ins=0x4873d193, legal=3, rv32=0x00000001, rv64=0x0000000000000001) } // bexti
    == 49 { (ext=8, ins=0x4a83d193, legal=2, rv32=0x00000000, rv64=0x0000000000000000) } // bexti
    == 50 { (ext=1, ins=0x0e73d1b3, legal=3, rv32=0x00000000, rv64=0x0000000000000000) } // czero_eqz
    == 51 { (ext=1, ins=0x0e73f1b3, legal=3, rv32=0xff008182, rv64=0x81230080ff008182) } // czero_nez
    == 52 { (ext=4, ins=0x60039193, legal=3, rv32=0x00000020, rv64=0x0000000000000040) } // clz
    == 53 { (ext=4, ins=0x60139193, legal=3, rv32=0x00000020, rv64=0x0000000000000040) } // ctz
    == 54 { (ext=4, ins=0x60239193, legal=3, rv32=0x00000000, rv64=0x0000000000000000) } // cpop
    == 55 { (ext=4, ins=0x6003919b, legal=2, rv32=0x00000000, rv64=0x0000000000000020) } // clzw
    == 56 { (ext=4, ins=0x6013919b, legal=2, rv32=0x00000000, rv64=0x0000000000000020) } // ctzw
    == 57 { (ext=4, ins=0x6073d1bb, legal=2, rv32=0x00000000, rv64=0x0000000000000000) } // rorw
    == 58 { (ext=4, ins=0x607391bb, legal=2, rv32=0x00000000, rv64=0x0000000000000000) } // rolw
    else { (ext=0, ins=0, legal=0, rv32=0, rv64=0) }
  }
  const inst:U32 = v.ins
  const a:U64 = if row >= 52 { 0 } else { 0x81230080ff008182 }
  const b:U64 = if row >= 50 { 0 } else { 33 }
  const small = run<b32>(a=a#[0..<32], b=b#[0..<32], inst)
  const wide = run<b64>(a, b, inst)
  const base = decode<configs.rv64>(inst=inst)
  const aloneA = decode<zba>(inst=inst)
  const aloneB = decode<zbb>(inst=inst)
  const aloneS = decode<zbs>(inst=inst)
  const aloneC = decode<zicond>(inst=inst)
  const single = aloneC.legal | (aloneA.legal << 1) | (aloneB.legal << 2) | (aloneS.legal << 3)
  const flags:U2 = v.legal
  ok = single == (if flags#[1] != 0 { v.ext } else { 0 }) and base.legal == 0 and small.legal == flags#[0] and wide.legal == flags#[1] and (small.legal == 0 or small.value == v.rv32) and (wide.legal == 0 or wide.value == v.rv64)
}
test bit_operations.decode_and_execute {
  mut d = bit_operations
  tick 59 {
    d.row = clock
    step
    assert(d.ok, "extension decode or result disagrees with its RV32/RV64 vector")
  }
}
