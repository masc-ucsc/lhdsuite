const buffer = import("../pyrope2/IBuf.IBuf")
const configs = import("../pyrope2/RocketConfig")
comptime const word32 = configs.params(useCompressed=false)
comptime const word64 = configs.params(xLen=64, useCompressed=false)

mod check<C>(address:U64, clk:Clock, data:U32, fault:U3, fetch:U1, ready:U1, retry:U1, rst:Reset) -> (correct:Bool@[]) {
  const b = buffer<C>(clk=clk, rst=rst, kill=false, ready=ready != 0, fetchValid=fetch != 0, fetchPC=address#[0..<C.xLen], fetchData=data, fetchFault=fault, fetchReplay=retry != 0, taken=true, branchSlot=0)
  correct = b.fetchReady == (ready != 0) and b.valid == (fetch != 0) and b.pc == address#[0..<C.xLen] and b.raw == data and b.inst == data and !b.rvc and b.replay == (retry != 0 and fetch != 0) and b.firstFault == fault and b.secondFault == 0
}

pub mod ibuf_word_fetch(clk:Clock, rst:Reset, fetch:U1, ready:U1, address:U64, data:U32, fault:U3, retry:U1) -> (correct:Bool@[]) {
  const a = check<word32>(address, clk, data, fault, fetch, ready, retry, rst)
  const b = check<word64>(address, clk, data, fault, fetch, ready, retry, rst)
  correct = a and b
}

test ibuf_word_fetch.uncompressed_beats {
  mut d = ibuf_word_fetch
  tick 65 {
    d.rst = clock == 0
    d.fetch = clock#[0]
    d.ready = clock#[1]
    d.retry = clock#[2]
    d.fault = clock#[3..<6]
    d.data = 0xabc00000 + clock
    d.address = 0x100000004 + (clock << 2)
    step
    assert(d.correct, "a word-aligned fetch carries its original instruction and one set of faults")
  }
}
