const configs = import("../pyrope2/RocketConfig")
const walk = import("../pyrope2/PageTableWalk.PageTableWalk")
const arbiter = import("../pyrope2/HellaCacheArbiter.HellaCacheArbiter")
const checkPMP = import("../pyrope2/PMPChecker.PMPChecker")
const protection = import("../pyrope2/PhysicalProtection")
const cache = import("../pyrope2/DCache.DCache")

// Write actual page tables through the CPU port. Page-table reads share the
// same DCache, with supervisor PMP protection and normal uncached bus replay.
mod profile<W>(clk:Clock, phase:U6, rst:Reset, scenario:U3) -> (bad:Bool@[], done:Bool@[], retried:Bool@[]) {
  comptime const profileConfig = configs.params(xLen=W, useVM=true, useAtomics=false)
  const external = scenario >= 2
  const root = if external { 0x60000 } else { 0x80000 }
  const va = 0xabc
  wire ready:Bool = nil
  wire complete:Bool = nil
  wire error:Bool = nil
  wire data:Unsigned(bits=W) = nil
  const w = walk<PA=32, XLEN=W>(clk=clk, rst=rst, request=phase == 25, virtualAddress=va, rootPPN=root, user=false, fetch=false, store=false, sum=false, mxr=false, consume=phase == 60, readReady=ready, readDone=complete, readError=error, readData=data)
  const install = scenario == 0 and (phase == 4 or phase == 12 or (W == 64 and phase == 20))
  const leaf = (0x81234 << 10) | 0x43
  const writeAddress = if phase == 4 { 0x80000000 } elif phase == 12 { 0x80001000 } else { 0x80002000 }
  reg storeData:Unsigned(bits=W)
  if install {
    storeData = if phase == 4 { (0x80001 << 10) | 1 } elif phase == 12 and W == 64 { (0x80002 << 10) | 1 } else { leaf }
  }
  wire cacheReady:Bool = nil
  wire nack:Bool = nil
  wire valid:Bool = nil
  wire tag:U7 = nil
  wire fault:Bool = nil
  wire busError:Bool = nil
  const a = arbiter<profileConfig>(clk=clk, rst=rst, cpuValid=install, cpuAddress=writeAddress, cpuTag=6, cpuCommand=1, cpuSize=std.clog2(W/8), cpuSigned=false, cpuPrivilege=3, cpuVirtual=false, cpuKill=false, cpuData=storeData, slaveValid=false, slaveAddress=0, slaveCommand=0, slaveSize=0, slaveKill=false, slaveData=0, slaveMask=0, cacheReady=cacheReady, cacheNack=nack, cacheValid=valid, cacheTag=tag, cacheLoadError=fault, cacheResponseError=busError, walkRead=w.read, walkAddress=w.readAddress)
  ready = a.walkReady
  complete = a.walkDone
  error = a.walkError

  // Hold the external request channel until cycle 39 to force stage-two nacks.
  const accept = U1(phase >= 39)
  reg reply:Bool = false
  const grant = (0x80000 << 10) | 0x43
  wire permissions:U2 = nil
  const d = cache<profileConfig>(clock=clk, reset=rst, auto_out_a_ready=accept, auto_out_d_valid=U1(reply), auto_out_d_bits_opcode=1, auto_out_d_bits_size=std.clog2(W/8), auto_out_d_bits_denied=U1(scenario == 3), auto_out_d_bits_corrupt=U1(scenario == 4), auto_out_d_bits_data=grant, io_ptw_status_debug=0, pmpPermissions=permissions, request=a.request)
  mut table:protection.Entries = nil
  table.cfg = 0
  table.addr = 0
  table.cfg[0] = 0x18 | U1(scenario != 1)
  table.addr[0] = 0x3fffffff
  const access = checkPMP<N=1>(table=table, privilege=d.pmpPrivilege, address=d.pmpAddress, size=d.pmpSize)
  permissions = access#[0..<2]

  if d.dataA.valid != 0 and accept != 0 {
    reply = true
  }
  if reply and d.auto_out_d_ready != 0 {
    reply = false
  }
  cacheReady = d.response.reqReady
  nack = d.response.s2Nack
  valid = d.response.respValid
  tag = d.response.respTag
  fault = d.response.s2XcptAeLd
  busError = d.response.respError
  data = d.response.respData
  const expectFault = scenario == 1 or scenario == 3 or scenario == 4
  const expectAddress = if external { 0x80000abc } else { 0x81234abc }
  reg sawRetry:Bool = false
  if phase == 0 {
    sawRetry = false
  }
  if external and nack {
    sawRetry = true
  }
  done = w.valid
  retried = sawRetry
  bad = (w.valid and (w.pageFault or w.accessFault != expectFault or (!expectFault and w.address != expectAddress))) or (install and !a.cpuReady) or (a.walkDone and (a.cpuResponse or a.slaveResponse)) or (a.request.valid and a.request.tag == 3 and (a.request.privilege != 1 or !a.request.physical or a.request.skipException))
}
pub mod page_table_dcache(clk:Clock, rst:Reset, phase:U6, scenario:U3) -> (bad:Bool@[], done:Bool@[], retried:Bool@[]) {
  const a = profile<W=32>(clk, phase, rst, scenario)
  const b = profile<W=64>(clk, phase, rst, scenario)
  done = a.done and b.done
  bad = a.bad or b.bad
  retried = a.retried and b.retried
}
test page_table_dcache.scratchpad_and_bus {
  mut d = page_table_dcache
  tick 320 {
    const phase = clock%64
    const scenario = clock/64
    d.rst = clock < 2
    d.phase = phase
    d.scenario = scenario
    step
    if phase > 2 {
      assert(!d.bad, "incorrect PTE, protection, fault or response routing")
    }
    if phase == 58 {
      assert(d.done, "both walks completed")
      if scenario >= 2 {
        assert(d.retried, "the backpressured uncached PTE read must retry")
      }
    }
  }
}
