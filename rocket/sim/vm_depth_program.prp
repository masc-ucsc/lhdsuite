const cfg = import("../pyrope2/RocketConfig")
const image = import("BootROM.Image")
comptime const sv39 = cfg.params(xLen=64, useVM=true, pgLevels=3, dcacheSets=512)
comptime const sv48 = cfg.params(xLen=64, useVM=true, pgLevels=4, dcacheSets=512, useAddiForMv=true)
comptime const sv57 = cfg.params(xLen=64, useVM=true, pgLevels=5, dcacheSets=512)

// Build a real tree at 0x80000000 for each supported satp mode. Run S-mode
// code at the top-half canonical address, store through the DTLB and trap to M.
mod run<C>(clk:Clock, rst:Reset) -> (bad:Bool@[], done:Bool@[]) {
  const program:[96]U32 = (
    ((C.pgLevels + 5) << 20) | 0xd93, // li s11, maximum supported satp mode
    0xfff00293, // li	t0,-1
    0x3b029073, // csrw	pmpaddr0,t0
    0x00f00293, // li	t0,15
    0x3a029073, // csrw	pmpcfg0,t0
    0x00000297, // auipc	t0,0x0
    0x0ec28293, // addi	t0,t0,236 # 10140 <handler>
    0x30529073, // csrw	mtvec,t0
    0x00800413, // li	s0,8
    0x00100493, // li	s1,1
    0x01f49493, // slli	s1,s1,0x1f
    0xffb40313, // addi	t1,s0,-5
    0x00900293, // li	t0,9
    0x026282b3, // mul	t0,t0,t1
    0x00b28293, // addi	t0,t0,11
    0xfff00993, // li	s3,-1
    0x005999b3, // sll	s3,s3,t0
    0x00048e13, // mv	t3,s1
    0x00100293, // li	t0,1
    0x00b29293, // slli	t0,t0,0xb
    0x005e0eb3, // add	t4,t3,t0
    0xfff30313, // addi	t1,t1,-1
    0x00100293, // li	t0,1
    0x00c29293, // slli	t0,t0,0xc
    0x005e0e33, // add	t3,t3,t0
    0x002e5293, // srli	t0,t3,0x2
    0x0012e293, // ori	t0,t0,1
    0x005eb023, // sd	t0,0(t4)
    0x000e0e93, // mv	t4,t3
    0xfff30313, // addi	t1,t1,-1
    0xfe0310e3, // bnez	t1,10098 <parents>
    0x000042b7, // lui	t0,0x4
    0x04b2829b, // addiw	t0,t0,75
    0x085e3023, // sd	t0,128(t3)
    0x200022b7, // lui	t0,0x20002
    0xcc72829b, // addiw	t0,t0,-825
    0x105e3023, // sd	t0,256(t3)
    0x00c4da13, // srli	s4,s1,0xc
    0x03c41293, // slli	t0,s0,0x3c
    0x005a6a33, // or	s4,s4,t0
    0x180a1073, // csrw	satp,s4
    0x001d8293, // addi	t0,s11,1
    0x03c29293, // slli	t0,t0,0x3c
    0x18029073, // csrw	satp,t0
    0x180022f3, // csrr	t0,satp
    0x09429663, // bne	t0,s4,10180 <fail>
    0x12000073, // sfence.vma
    0x000012b7, // lui	t0,0x1
    0x8002829b, // addiw	t0,t0,-2048
    0x30029073, // csrw	mstatus,t0
    0x00000a97, // auipc	s5,0x0
    0x014a8a93, // addi	s5,s5,20 # 1011c <payload>
    0x013a8ab3, // add	s5,s5,s3
    0x341a9073, // csrw	mepc,s5
    0x30200073, // mret
    0x00020537, // lui	a0,0x20
    0x01350533, // add	a0,a0,s3
    0x00852023, // sw	s0,0(a0) # 20000 <__global_pointer$+0xe67c>
    0x00052583, // lw	a1,0(a0)
    0x00859863, // bne	a1,s0,1013c <bad>
    0x0001862e, // mv	a2,a1
    0x00861463, // bne	a2,s0,1013c <bad>
    0x00000073, // ecall
    0x00100073, // ebreak
    0x342022f3, // csrr	t0,mcause
    0x00900313, // li	t1,9
    0x02629c63, // bne	t0,t1,10180 <fail>
    0x341022f3, // csrr	t0,mepc
    0x00000317, // auipc	t1,0x0
    0xfe830313, // addi	t1,t1,-24 # 10138 <trap_site>
    0x01330333, // add	t1,t1,s3
    0x02629263, // bne	t0,t1,10180 <fail>
    0x000072b7, // lui	t0,0x7
    0x009282b3, // add	t0,t0,s1
    0x0002a283, // lw	t0,0(t0) # 7000 <_start-0x9040>
    0x00829a63, // bne	t0,s0,10180 <fail>
    0x18001073, // csrw	satp,zero
    0x00140413, // addi	s0,s0,1
    0xee8ddae3, // bge	s11,s0,1006c <setup>
    0x0000006f, // j	1017c <success>
    0x0000006f, // j	10180 <fail>
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
  )
  const t = image<C=C, WORDS=96>(clk=clk, rst=rst, program=program, successPC=0x1017c)
  bad = t.badFetch or (t.trap != 0 and t.cause != 9) or (t.traceValid and t.tracePC == 0x10180)
  done = t.success
}
pub mod vm_depth_program(clk:Clock, rst:Reset) -> (bad:Bool@[], done:U3@[]) {
  const a = run<sv39>(clk, rst)
  const b = run<sv48>(clk, rst)
  const c = run<sv57>(clk, rst)
  done = (U1(a.done) << 2) | (U1(b.done) << 1) | U1(c.done)
  bad = a.bad or b.bad or c.bad
}
test vm_depth_program.satp_modes {
  mut d = vm_depth_program
  mut seen:U3 = 0
  tick 3600 {
    d.rst = clock < 4
    step
    if clock > 4 {
      assert(!d.bad, "unexpected trap, fetch or firmware failure")
      seen |= d.done
    }
  }
  assert(seen == 7, "all tiles must execute every supported translation mode")
}
