const image = import("BootROM.Image")
const configs = import("../pyrope2/RocketConfig")
comptime const narrow = configs.params(xLen=32, fLen=64, fpuClockGate=true)
comptime const singleOnly = configs.params(xLen=32, fLen=32)
comptime const noDiv = configs.params(xLen=64, fLen=64, divSqrt=false)
comptime const wideProfile = configs.params(xLen=64, fLen=64, fpuClockGate=true)

mod run<C>(clk:Clock, rst:Reset) -> (cause:U32@[], done:Bool@[], pc:U32@[], trap:Bool@[]) {
  const code:[64]U32 = (
    0x000022b7, // lui t0,0x2
    0x3002a073, // csrs mstatus,t0
    0x00300293, // li t0,3
    0xd002f053, // fcvt.s.w ft0,t0
    0x000070d3, // fadd.s ft1,ft0,ft0
    0x0000f143, // fmadd.s ft2,ft1,ft0,ft0
    0xc0017353, // fcvt.w.s t1,ft2
    0x01500393, // li t2,21
    0x0a731c63, // bne t1,t2,10118 <fail>
    0x00100413, // li s0,1
    0x01f41413, // slli s0,s0,0x1f
    0x00242227, // fsw ft2,4(s0)
    0x00442187, // flw ft3,4(s0)
    0xa0312353, // feq.s t1,ft2,ft3
    0x0a030063, // beqz t1,10118 <fail>
    0x42018253, // fcvt.d.s ft4,ft3
    0x1a4272d3, // fdiv.d ft5,ft4,ft4
    0x00543427, // fsd ft5,8(s0)
    0x00c42303, // lw t1,12(s0)
    0x3ff003b7, // lui t2,0x3ff00
    0x08731463, // bne t1,t2,10118 <fail>
    0x12345e37, // lui t3,0x12345
    0x678e0e13, // addi t3,t3,1656 # 12345678 <__global_pointer$+0x12333d5c>
    0x01c42423, // sw t3,8(s0)
    0x00843507, // fld fa0,8(s0)
    0x00a43827, // fsd fa0,16(s0)
    0x01042e83, // lw t4,16(s0)
    0x07de1663, // bne t3,t4,10118 <fail>
    0x01442e83, // lw t4,20(s0)
    0x067e9263, // bne t4,t2,10118 <fail>
    0x00543427, // fsd ft5,8(s0)
    0x00843307, // fld ft6,8(s0)
    0x5a0373d3, // fsqrt.d ft7,ft6
    0xa253a353, // feq.d t1,ft7,ft5
    0x04030863, // beqz t1,10118 <fail>
    0xe0031353, // fclass.s t1,ft6
    0x20000393, // li t2,512
    0x04731263, // bne t1,t2,10118 <fail>
    0xf0000453, // fmv.w.x fs0,zero
    0x188074d3, // fdiv.s fs1,ft0,fs0
    0x00102373, // frflags t1
    0x00800393, // li t2,8
    0x02731863, // bne t1,t2,10118 <fail>
    0x00101073, // fsflags zero
    0x00200293, // li t0,2
    0xd002f453, // fcvt.s.w fs0,t0
    0x188074d3, // fdiv.s fs1,ft0,fs0
    0x0021d073, // fsrmi zero,3
    0xc004f353, // fcvt.w.s t1,fs1
    0x00629a63, // bne t0,t1,10118 <fail>
    0x00302373, // frcsr t1
    0x06100393, // li t2,97
    0x00731463, // bne t1,t2,10118 <fail>
    0x0000006f, // j 10114 <success>
    0x00100073, // ebreak
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
    0x00000013, // nop
  )
  const t = image<C=C, WORDS=64>(clk=clk, rst=rst, program=code, successPC=0x10114)
  done = t.success
  trap = t.trap != 0
  pc = t.tracePC#[0..<32]
  cause = t.cause#[0..<32]
}
pub mod float_program(clk:Clock, rst:Reset) -> (d:Bool@[], s:Bool@[], trap:Bool@[]) {
  const a = run<narrow>(clk, rst)
  const b = run<wideProfile>(clk, rst)
  s = a.done
  d = b.done
  trap = a.trap or b.trap
}
test float_program.boot {
  mut d = float_program
  mut small = false
  mut wide = false
  tick 400 {
    d.rst = clock < 4
    step
    if clock > 4 {
      assert(!d.trap, "floating point firmware trapped")
      if d.s {
        small = true
      }
      if d.d {
        wide = true
      }
    }
  }
  assert(small and wide, "RV32D and RV64D firmware retired their success loops")
}

pub mod float_limits(clk:Clock, rst:Reset) -> (base:Bool@[], failed:Bool@[], noDivide:Bool@[], single:Bool@[]) {
  const f = run<singleOnly>(clk, rst)
  const i = run<configs.tiny>(clk, rst)
  const n = run<noDiv>(clk, rst)
  noDivide = n.trap and n.pc == 0x10080 and n.cause == 2
  single = f.trap and f.pc == 0x1007c and f.cause == 2
  base = i.trap and i.pc == 0x1004c and i.cause == 2
  failed = f.done or i.done or n.done
}
test float_limits.extensions {
  mut d = float_limits
  mut single = false
  mut base = false
  mut div = false
  tick 200 {
    d.rst = clock < 4
    step
    if clock > 4 {
      if d.single {
        single = true
      }
      if d.noDivide {
        div = true
      }
      if d.base {
        base = true
      }
      assert(!d.failed)
    }
  }
  assert(single and base and div, "unsupported F and D opcodes raise precise illegal instruction traps")
}
