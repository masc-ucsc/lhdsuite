const fp = import("../pyrope2/Float")

comb check<E, F>(row:U5) -> (good:Bool) {
  comptime const bias = (1 << (E - 1)) - 1
  comptime const one = bias << F
  comptime const two = one + (1 << F)
  comptime const sign = 1 << (E + F)
  comptime const inf = ((1 << E) - 1) << F
  comptime const nan = inf | (1 << (F - 1))
  comptime const minNormal = 1 << F
  comptime const halfUlp = (bias - F - 1) << F
  comptime const fused = sign | (if bias > 2*F { (bias - 2*F) << F } else { 1 << (bias - F - 1) })
  comptime const sqrtTwo = if E == 5 { 0x3da8 } elif E == 8 { 0x3fb504f3 } else { 0x3ff6a09e667f3bcd }

  // fn selects FMA, multiply, divide, square root, minimum, or equality.
  const v = match row {
    == 0 { (a=one, b=two, c=one - minNormal, flags=0, fn=0, result=two + (1 << (F - 2)), rm=0) }
    == 1 { (a=one + 1, b=one - 2, c=sign | one, flags=0, fn=0, result=fused, rm=0) }
    == 2 { (a=one, b=one, c=halfUlp, flags=1, fn=0, result=one, rm=0) }
    == 3 { (a=one, b=one, c=halfUlp, flags=1, fn=0, result=one + 1, rm=3) }
    == 4 { (a=one, b=one, c=halfUlp, flags=1, fn=0, result=one + 1, rm=4) }
    == 5 { (a=one + 1, b=one, c=halfUlp, flags=1, fn=0, result=one + 2, rm=0) }
    == 6 { (a=minNormal, b=one - 1, c=0, flags=3, fn=1, result=minNormal, rm=0) }
    == 7 { (a=1, b=one, c=0, flags=0, fn=1, result=1, rm=0) }
    == 8 { (a=inf - 1, b=two, c=0, flags=5, fn=1, result=inf - 1, rm=1) }
    == 9 { (a=inf, b=0, c=nan, flags=16, fn=0, result=nan, rm=0) }
    == 10 { (a=inf, b=one, c=sign | inf, flags=16, fn=0, result=nan, rm=0) }
    == 11 { (a=one, b=one, c=sign | one, flags=0, fn=0, result=sign, rm=2) }
    == 12 { (a=one, b=sign, c=0, flags=8, fn=2, result=sign | inf, rm=0) }
    == 13 { (a=0, b=0, c=0, flags=16, fn=2, result=nan, rm=0) }
    == 14 { (a=inf, b=0, c=0, flags=0, fn=2, result=inf, rm=0) }
    == 15 { (a=two, b=0, c=0, flags=1, fn=3, result=sqrtTwo, rm=0) }
    == 16 { (a=sign | one, b=0, c=0, flags=16, fn=3, result=nan, rm=0) }
    == 17 { (a=sign, b=0, c=0, flags=0, fn=3, result=sign, rm=0) }
    == 18 { (a=0, b=sign, c=0, flags=0, fn=4, result=sign, rm=0) }
    == 19 { (a=inf + 1, b=one, c=0, flags=16, fn=4, result=one, rm=0) }
    == 20 { (a=nan, b=one, c=0, flags=0, fn=5, result=0, rm=0) }
    else { (a=0, b=sign, c=0, flags=0, fn=5, result=1, rm=0) }
  }
  const a = v.a#[0..<(1 + E + F)]
  const b = v.b#[0..<(1 + E + F)]
  const c = v.c#[0..<(1 + E + F)]
  const fma = fp.mulAdd<E=E, F=F>(a=a, b=b, c=c, rm=v.rm, negateProduct=0, negateC=0, multiplyOnly=v.fn == 1)
  const div = fp.divSqrt<E=E, F=F>(a=a, b=b, rm=v.rm, sqrt=v.fn == 3)
  const cmp = fp.compare<E=E, F=F>(a=a, b=b, fn=(if v.fn == 5 { 2 } else { 0 }), minMax=v.fn == 4)
  const bits = if v.fn < 2 { fma.bits } elif v.fn < 4 { div.bits } else { cmp.bits }
  const flags = if v.fn < 2 { fma.flags } elif v.fn < 4 { div.flags } else { cmp.flags }
  good = bits == v.result and flags == v.flags
}

pub mod float_arithmetic(clk:Clock, row:U5) -> (double:Bool@[], half:Bool@[], single:Bool@[]) {
  half = check<E=5, F=10>(row)
  single = check<E=8, F=23>(row)
  double = check<E=11, F=52>(row)
}
test float_arithmetic.rounding {
  mut u = float_arithmetic
  tick 22 {
    u.row = clock
    step
    assert(u.half and u.single and u.double, "incorrect IEEE result or RISC-V exception flags")
  }
}

pub mod float_conversions(clk:Clock, row:U4) -> (good:Bool@[]) {
  const v = match row {
    // The unsigned word result saturates on NaN and signed extremes.
    == 0 { (a=0x7ff0000000000001, class=256, flags=16, i=0xffffffff) }
    == 1 { (a=0xfff0000000000000, class=1, flags=16, i=0) }
    == 2 { (a=0xbfe0000000000000, class=2, flags=1, i=0) }
    == 3 { (a=0x41efffffffe00000, class=64, flags=0, i=0xffffffff) }
    == 4 { (a=0x41f0000000000000, class=64, flags=16, i=0xffffffff) }
    == 5 { (a=0x8000000000000000, class=8, flags=0, i=0) }
    == 6 { (a=1, class=32, flags=1, i=0) }
    else { (a=0x8000000000000001, class=4, flags=1, i=0) }
  }
  const word = fp.toInteger<E=11, F=52, W=32>(a=v.a, isSigned=false, rm=0)
  const classMask = fp.classify<E=11, F=52>(a=v.a)
  // 2^24+1 is halfway between adjacent singles. It remains exact in double.
  const single = fp.fromInteger<E=8, F=23, W=64>(a=0x1000001, isSigned=true, rm=4)
  const double = fp.fromInteger<E=11, F=52, W=64>(a=0x1000001, isSigned=false, rm=0)
  const narrow = fp.convertFormat<E=11, F=52, TE=8, TF=23>(a=double.bits, rm=0)
  const wide = fp.convertFormat<E=5, F=10, TE=11, TF=52>(a=0x8001, rm=0)
  good = word.bits == v.i and word.flags == v.flags and classMask == v.class and single.bits == 0x4b800001 and single.flags == 1 and double.flags == 0 and narrow.bits == 0x4b800000 and narrow.flags == 1 and wide.bits == 0xbe70000000000000 and wide.flags == 0
}
test float_conversions.boundaries {
  mut u = float_conversions
  tick 8 {
    u.row = clock
    step
    assert(u.good, "incorrect class, conversion result, or exception flags")
  }
}
