const configs = import("../pyrope2/RocketConfig")
const port = import("../pyrope2/ScratchpadSlavePort.ScratchpadSlavePort")

mod check<W, ATOMICS>(clk:Clock, cycle:U5, rst:Reset) -> (ok:Bool@[]) {
  const first = cycle == 2
  const atomic = cycle >= 12
  const opcode = if first { 1 } elif atomic { if cycle < 17 { 2 } else { 3 } } else { 4 }
  const param = if cycle < 17 { (cycle - 12)#[0..<3] } else { (cycle - 17)#[0..<3] }
  const ready = cycle != 6 and (!atomic or cycle == 20)
  const word = if W == 64 { 0x12345678abcdef01 } else { 0xabcdef01 }
  comptime const profileConfig = configs.params(xLen=W, useAtomics=ATOMICS)
  const d = port<profileConfig>(clock=clk, reset=rst, auto_in_d_ready=U1(cycle == 11), io_dmem_req_ready=U1(ready), io_dmem_s2_nack=U1(cycle == 5), io_dmem_resp_valid=U1(cycle == 9), io_dmem_resp_bits_data_raw=(if cycle == 9 {
        word
      } else {
        0
      }), requestA=(valid=U1(cycle == 1 or first or cycle == 4 or atomic), opcode=opcode, param=param, size=(if first { 0 } else { 2 }), source=(if first {
          123
        } else {
          42
        }), address=(if first { 0x85 } else { 0x100 }), mask=(if first { 2 } else { 15 }), data=(if first { 0x31313131 } else { 0 }), corrupt=0))
  mut good = true
  if first or cycle == 6 or cycle == 7 {
    good = d.io_dmem_req_valid != 0 and d.io_dmem_req_bits_addr == 0x85 and d.io_dmem_req_bits_size == 0 and d.io_dmem_req_bits_cmd == 1 and d.auto_in_a_ready == U1(first)
  } elif cycle == 3 or cycle == 8 {
    good = d.io_dmem_s1_kill == 0 and d.io_dmem_s1_data_mask == (if W == 64 { 32 } else { 2 }) and d.io_dmem_s1_data_data == (if W == 64 { 0x3131313131313131 } else { 0x31313131 })
  } elif cycle == 4 {
    good = d.io_dmem_req_valid != 0 and d.auto_in_a_ready == 0 and d.io_dmem_s1_kill != 0
  } elif cycle >= 9 and cycle <= 11 {
    good = d.responseD.valid != 0 and d.responseD.opcode == 0 and d.responseD.source == 123 and d.responseD.size == 0 and d.responseD.data == (if W == 64 { 0x12345678 } else { 0xabcdef01 })
  } elif atomic {
    const arithmetic:[8]U5 = [12, 13, 14, 15, 8, 0, 0, 0]
    const logical:[4]U5 = [9, 10, 11, 4]
    const expected = if opcode == 2 { arithmetic[param] } else { logical[param#[0..<2]] }
    good = d.io_dmem_req_valid == U1(ATOMICS) and d.auto_in_a_ready == U1(ATOMICS and ready) and (!ATOMICS or d.io_dmem_req_bits_cmd == expected)
  }
  reg sampled:Bool = true
  sampled = good
  ok = sampled
}

pub mod scratchpad_slave(clk:Clock, rst:Reset, cycle:U5) -> (ok:Bool@[]) {
  ok = true
  for i in 0..<4 {
    const t = check<ATOMICS=(i >= 2), W=(if i%2 == 0 { 32 } else { 64 })>(clk, cycle, rst)
    ok = ok and t.ok
  }
}
test scratchpad_slave.replay_and_stalled_reply {
  mut d = scratchpad_slave
  tick 21 {
    d.rst = clock == 0
    d.cycle = clock
    step
    assert(d.ok, "scratchpad request replay, response retention, and command decode")
  }
}
