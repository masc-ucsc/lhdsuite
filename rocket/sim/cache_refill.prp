const refill = import("../pyrope2/CacheRefill.CacheRefill")

// Accept the first GrantData with its Acquire. Stall RAM and E independently,
// then return a denied permission-only grant while RAM is unavailable.
pub mod cache_refill(clk:Clock, rst:Reset, cycle:U5) -> (ok:Bool@[]) {
  const denied = cycle == 18
  const validD = (cycle >= 2 and cycle <= 12) or denied
  const r = refill<W=64>(clk=clk, rst=rst, request=cycle == 1 or cycle == 17, address=0x1278,
      state=0, write=false, writeIntent=false, aReady=cycle == 3 or denied,
      dValid=validD, dOpcode=(if denied { 4 } else { 5 }),
      dSource=(if cycle == 4 { 2 } else { 1 }), dSink=(if cycle == 3 { 7 } elif denied { 2 } else { 9 }),
      dCap=1, dData=cycle+10, dDenied=denied, dCorrupt=denied, eReady=cycle == 15 or cycle == 20,
      ramReady=cycle != 5 and cycle < 17)
  const acquire = cycle == 2 or cycle == 3 or denied
  const transfer = cycle == 3 or (cycle >= 6 and cycle <= 12)
  const ack = (cycle >= 4 and cycle <= 15) or cycle == 19 or cycle == 20
  const idle = cycle == 1 or cycle == 16 or cycle == 17 or cycle == 21
  const finalBeat = cycle == 12

  // Capture signals at the edge where each handshake actually happens.
  reg correct:Bool = true
  correct = r.ready == idle and r.aValid == acquire and
      (!acquire or (r.lineAddress == 0x1240 and r.aSource == 1 and r.aParam == 0)) and
      r.fill == transfer and (validD and r.dReady) == (transfer or denied) and
      (!transfer or (r.fillBeat == (if cycle == 3 { 0 } else { cycle-5 }) and r.fillData == cycle+10)) and
      r.done == (finalBeat or denied) and r.error == denied and r.install == finalBeat and
      (!r.install or r.newState == 1) and r.eValid == ack and (!ack or r.eSink == (if cycle < 17 { 7 } else { 2 }))
  ok = correct
}

test cache_refill.independent_handshakes {
  mut x = cache_refill
  tick 22 {
    x.rst = clock == 0
    x.cycle = clock
    step
    if clock >= 1 { assert(x.ok, "Acquire, D data and E acknowledgement obey independent handshakes") }
  }
}
