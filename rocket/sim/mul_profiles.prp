const mul = import("../pyrope2/MulDiv.MulDiv")
const configs = import("../pyrope2/RocketConfig")
comptime const rv32 = configs.rv32
comptime const fast = configs.earlyMul
mod trial<C>(clk:Clock, rst:Reset, submit:Bool, x:U32) -> (done:Bool@[0], result:U32@[0]) {
  const d = mul<C>(clock=clk, reset=rst, io_req_valid=U1(submit), io_req_bits_fn=0, io_req_bits_dw=1, io_req_bits_in1=x, io_req_bits_in2=9, io_req_bits_tag=0, io_kill=0, io_resp_ready=0)
  done = d.io_resp_valid != 0
  result = d.io_resp_bits_data
}
pub mod mul_profiles(clk:Clock, rst:Reset, submit:Bool) -> (f:Bool@[0], fdata:U32@[0], v:Bool@[0], vdata:U32@[0], z:Bool@[0], zdata:U32@[0]) {
  const a = trial<rv32>(clk, rst, submit, x=2)
  const b = trial<fast>(clk, rst, submit, x=2)
  const c = trial<fast>(clk, rst, submit, x=3)
  v = a.done
  f = b.done
  z = c.done
  vdata = a.result
  fdata = b.result
  zdata = c.result
}
test mul_profiles.latency {
  mut d = mul_profiles
  tick 12 {
    d.rst = clock == 0
    d.submit = clock == 1
    step
    assert(d.v == (clock >= 5), "four radix-256 iterations on the default multiplier")
    assert(d.f == (clock >= 3) and d.z == d.f, "two iterations with mulEarlyOut")
    if d.f {
      assert(d.fdata == 18 and d.zdata == 27, "independent early-out instances")
    }
    if d.v {
      assert(d.vdata == 18, "default and early-out results agree")
    }
  }
}
