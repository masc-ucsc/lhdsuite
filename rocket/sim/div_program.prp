const boot = import("BootROM.BootROM")
const cfg = import("../pyrope2/RocketConfig")
comptime const fast32 = cfg.params(divUnroll=3, mulDivClockGate=true)
comptime const fast64 = cfg.params(xLen=64, mulDivClockGate=true, divUnroll=4, divEarlyOut=true, divEarlyOutGranularity=8)
comptime const ungated32 = cfg.params(divUnroll=3)
comptime const ungated64 = cfg.params(xLen=64, divUnroll=4, divEarlyOut=true, divEarlyOutGranularity=8)
pub mod div_program(clk:Clock, rst:Reset) -> (bad:Bool@[], ok32:Bool@[], ok64:Bool@[]) {
  const rom:[16]U32 = (
    0xf8500093, // li x1,-123
    0x00700113, // li x2,7
    0x0220c1b3, // div x3,x1,x2
    0x0220e233, // rem x4,x1,x2
    0x022182b3, // mul x5,x3,x2
    0x004282b3, // add x5,x5,x4
    0x02509263, // bne x1,x5,fail
    0xfef00313, // li x6,-17
    0x00619e63, // bne x3,x6,fail
    0xffc00393, // li x7,-4
    0x00721a63, // bne x4,x7,fail
    0x0200d433, // divu x8,x1,x0
    0xfff00493, // li x9,-1
    0x00941463, // bne x8,x9,fail
    0x0000006f, // success: jal x0,success
    0x00100073, // fail: ebreak
  )
  const a = boot<fast32>(clk=clk, rst=rst, program=rom, successPC=0x10078)
  const b = boot<fast64>(clk=clk, rst=rst, program=rom, successPC=0x10078)
  const ref32 = boot<ungated32>(clk=clk, rst=rst, program=rom, successPC=0x10078)
  const ref64 = boot<ungated64>(clk=clk, rst=rst, program=rom, successPC=0x10078)
  bad = a.trap != 0 or b.trap != 0 or a.badFetch or b.badFetch or a.traceValid != ref32.traceValid or b.traceValid != ref64.traceValid or (a.traceValid and a.tracePC != ref32.tracePC) or (b.traceValid and b.tracePC != ref64.tracePC) or a.trap != ref32.trap or b.trap != ref64.trap or a.success != ref32.success or b.success != ref64.success
  ok32 = a.success
  ok64 = b.success
}
test div_program.dependent_instructions {
  mut d = div_program
  mut a = false
  mut b = false
  tick 200 {
    d.rst = clock < 4
    step
    if clock > 4 {
      assert(!d.bad, "gated and ungated divider firmware must retire together without a trap")
      if d.ok32 {
        a = true
      }
      if d.ok64 {
        b = true
      }
    }
  }
  assert(a and b, "both tiles consumed their long-latency writebacks")
}
