pub mod MaxPeriodFibonacciLFSR::[timecheck=false](clock:u1, reset:u1, io_increment:u1) -> (io_out_0:u1@[], io_out_1:u1@[], io_out_2:u1@[], io_out_3:u1@[], io_out_4:u1@[], io_out_5:u1@[], io_out_6:u1@[], io_out_7:u1@[], io_out_8:u1@[], io_out_9:u1@[], io_out_10:u1@[], io_out_11:u1@[], io_out_12:u1@[], io_out_13:u1@[], io_out_14:u1@[], io_out_15:u1@[]) {
  reg state_0:u1
  reg state_1:u1
  reg state_2:u1
  reg state_3:u1
  reg state_4:u1
  reg state_5:u1
  reg state_6:u1
  reg state_7:u1
  reg state_8:u1
  reg state_9:u1
  reg state_10:u1
  reg state_11:u1
  reg state_12:u1
  reg state_13:u1
  reg state_14:u1
  reg state_15:u1
  io_out_0 = state_0
  io_out_1 = state_1
  io_out_2 = state_2
  io_out_3 = state_3
  io_out_4 = state_4
  io_out_5 = state_5
  io_out_6 = state_6
  io_out_7 = state_7
  io_out_8 = state_8
  io_out_9 = state_9
  io_out_10 = state_10
  io_out_11 = state_11
  io_out_12 = state_12
  io_out_13 = state_13
  io_out_14 = state_14
  io_out_15 = state_15
  if reset != 0 {
    state_0 = 1
    state_1 = 0
    state_10 = 0
    state_11 = 0
    state_12 = 0
    state_13 = 0
    state_14 = 0
    state_15 = 0
    state_2 = 0
    state_3 = 0
    state_4 = 0
    state_5 = 0
    state_6 = 0
    state_7 = 0
    state_8 = 0
    state_9 = 0
  } elif io_increment != 0 {
    state_0 = state_15 ^ state_13 ^ state_12 ^ state_10
    state_1 = state_0
    state_2 = state_1
    state_3 = state_2
    state_4 = state_3
    state_5 = state_4
    state_6 = state_5
    state_7 = state_6
    state_8 = state_7
    state_9 = state_8
    state_10 = state_9
    state_11 = state_10
    state_12 = state_11
    state_13 = state_12
    state_14 = state_13
    state_15 = state_14
  }
}
