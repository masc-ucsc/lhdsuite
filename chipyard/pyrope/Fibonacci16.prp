// Sixteen-bit Fibonacci LFSR used by the cache and micro-BTB replacement policies.
pub mod Fibonacci16(clock:Clock, reset:U1, io_increment:U1) -> (bits:U16@[]) {
  reg state:U16:[async=false, initial=1, reset_pin=reset]
  if io_increment != 0 {
    const feedback = state#[10] ^ state#[12] ^ state#[13] ^ state#[15]
    wrap state = (state << 1) | feedback
  }
  bits = state
}
