pub mod LevelGateway(
  clock:Clock,
  io_interrupt:U1,
  io_plic_complete:U1,
  io_plic_ready:U1,
  reset:Reset,
) -> (io_plic_valid:U1@[]) {
  reg inFlight:U1 = 0
  io_plic_valid = io_interrupt & ~inFlight
  if io_plic_complete != 0 {
    inFlight = 0
  } elif (io_plic_ready & io_interrupt) != 0 {
    inFlight = 1
  }
}
