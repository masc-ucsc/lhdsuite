// One accepted register access on an eight-byte aligned bus word.
pub type Access = (address:U32, data:U64, readMask:U8, writeMask:U8)

pub comb fromWord(address:U32, data:U32, mask:U4, read:Bool, write:Bool) -> (bus:Access) {
  const shift = if address#[2] != 0 { 4 } else { 0 }
  bus = (
    address=address,
    data=U64(data) << (8*shift),
    readMask=if read { U8(mask) << shift } else { 0 },
    writeMask=if write {
      U8(mask) << shift
    } else {
      0
    },
  )
}

pub comb updated(data:U64, mask:U8, old:U64) -> (value:U64) {
  value = old
  for lane in 0..<8 {
    if mask#[lane] != 0 {
      value#[(8*lane)..+8] = data#[(8*lane)..+8]
    }
  }
}
