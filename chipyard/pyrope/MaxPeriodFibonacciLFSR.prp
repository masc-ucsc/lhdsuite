const packed = import("Fibonacci16.Fibonacci16")

pub mod MaxPeriodFibonacciLFSR(
  clock:Clock,
  io_increment:U1,
  reset:U1,
) -> (
  io_out_0:U1@[],
  io_out_1:U1@[],
  io_out_10:U1@[],
  io_out_11:U1@[],
  io_out_12:U1@[],
  io_out_13:U1@[],
  io_out_14:U1@[],
  io_out_15:U1@[],
  io_out_2:U1@[],
  io_out_3:U1@[],
  io_out_4:U1@[],
  io_out_5:U1@[],
  io_out_6:U1@[],
  io_out_7:U1@[],
  io_out_8:U1@[],
  io_out_9:U1@[],
) {
  const state = packed(clock, reset, io_increment)
  io_out_0  = state#[0]
  io_out_1  = state#[1]
  io_out_2  = state#[2]
  io_out_3  = state#[3]
  io_out_4  = state#[4]
  io_out_5  = state#[5]
  io_out_6  = state#[6]
  io_out_7  = state#[7]
  io_out_8  = state#[8]
  io_out_9  = state#[9]
  io_out_10 = state#[10]
  io_out_11 = state#[11]
  io_out_12 = state#[12]
  io_out_13 = state#[13]
  io_out_14 = state#[14]
  io_out_15 = state#[15]
}
