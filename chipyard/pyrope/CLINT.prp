const mmio = import("InterruptMMIO")

pub mod registers<harts=1>(
  bus:mmio.Access,
  clock:Clock,
  reset:Reset,
  tickRtc:Bool,
) -> (data:U64@[], software:Unsigned(bits=harts)@[], timer:Unsigned(bits=harts)@[]) {
  cassert(harts >= 1 and harts <= 4095)
  const address = bus.address & 0xfff8
  reg now:U64 = 0
  if address == 0xbff8 and bus.writeMask != 0 {
    now = mmio.updated(old=now, data=bus.data, mask=bus.writeMask)
  } elif tickRtc {
    wrap now = now + 1
  }
  data = if address == 0xbff8 { now } else { 0 }
  for h in 0..<harts {
    reg ipi:U1       = 0
    reg deadline:U64 = nil
    if address == ((4*h) & ~7) {
      if bus.writeMask#[(h%2)*4] != 0 {
        ipi = bus.data#[(h%2)*32]
      }
      data#[(h%2)*32] = ipi
    }
    if address == 0x4000 + 8*h {
      if bus.writeMask != 0 {
        deadline = mmio.updated(old=deadline, data=bus.data, mask=bus.writeMask)
      }
      data = deadline
    }
    software#[h] = ipi
    timer#[h]    = U1(now >= deadline)
  }
}

pub mod CLINT::[
  timecheck=false
](
  auto_in_a_bits_address:U26,
  auto_in_a_bits_corrupt:U1,
  auto_in_a_bits_data:U32,
  auto_in_a_bits_mask:U4,
  auto_in_a_bits_opcode:U4,
  auto_in_a_bits_param:U3,
  auto_in_a_bits_size:U2,
  auto_in_a_bits_source:U10,
  auto_in_a_valid:U1,
  auto_in_d_ready:U1,
  clock:Clock,
  io_rtcTick:U1,
  reset:U1,
) -> (
  auto_in_a_ready:U1@[],
  auto_in_d_bits_data:U32@[],
  auto_in_d_bits_opcode:U4@[],
  auto_in_d_bits_size:U2@[],
  auto_in_d_bits_source:U10@[],
  auto_in_d_valid:U1@[],
  auto_int_out_0:U1@[],
  auto_int_out_1:U1@[],
) {
  reg full:Bool:[async=false, initial=false, reset_pin=reset] = nil
  reg result:U32                                              = nil
  reg source:U10                                              = nil
  reg size:U2                                                 = nil
  reg opcode:U4                                               = nil
  auto_in_a_ready = U1(not full or auto_in_d_ready != 0)
  const fire   = auto_in_a_valid != 0 and auto_in_a_ready != 0 and reset == 0
  const read   = auto_in_a_bits_opcode == 4
  const bus    = mmio.fromWord(
    address=auto_in_a_bits_address,
    data=auto_in_a_bits_data,
    mask=auto_in_a_bits_mask,
    read=fire and read,
    write=fire and auto_in_a_bits_opcode <= 1 and auto_in_a_bits_corrupt == 0,
  )
  const device = registers(bus, clock, reset=Bool(reset), tickRtc=Bool(io_rtcTick))
  auto_int_out_0 = device.software
  auto_int_out_1 = device.timer

  if fire {
    full   = true
    source = auto_in_a_bits_source
    size   = auto_in_a_bits_size
    opcode = U1(read)
    result = if auto_in_a_bits_address#[2] != 0 { device.data#[32..+32] } else { device.data#[0..+32] }
  } elif auto_in_d_ready != 0 {
    full = false
  }
  auto_in_d_valid       = U1(full)
  auto_in_d_bits_data   = result
  auto_in_d_bits_source = source
  auto_in_d_bits_size   = size
  auto_in_d_bits_opcode = opcode
}
