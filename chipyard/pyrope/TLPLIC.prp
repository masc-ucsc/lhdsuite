const mmio      = import("InterruptMMIO")
const arbitrate = import("PLICFanIn.winner")
const gateway   = import("LevelGateway.LevelGateway")

mod target<sources, priorityBits>(
  address:U32,
  bus:mmio.Access,
  c:U32,
  clock:Clock,
  pending:Unsigned(bits=sources),
  priorities:Unsigned(bits=sources*priorityBits),
  reset:Reset,
) -> (claimed:U32@[], completed:Unsigned(bits=sources)@[], interrupt:U1@[], readData:U64@[]) {
  readData  = 0
  claimed   = 0
  completed = 0
  reg enabled:Unsigned(bits=sources)        = 0
  reg threshold:Unsigned(bits=priorityBits) = 0
  const best = arbitrate<bits=priorityBits, sources=sources>(eligible=enabled & pending, priorities)
  reg irqPriority:Unsigned(bits=priorityBits) = 0
  irqPriority = best.priority
  interrupt   = U1(irqPriority > threshold)
  for i in 0..<sources {
    const id = i + 1
    if address == 0x2000 + 128*c + (id/64)*8 {
      readData#[id%64] = enabled#[i]
      if bus.writeMask#[(id%64)/8] != 0 {
        enabled#[i] = bus.data#[id%64]
      }
    }
  }
  if address == 0x200000 + 4096*c {
    readData = (U64(best.id) << 32) | threshold
    if bus.writeMask#[0] != 0 {
      threshold = bus.data#[0..+priorityBits]
    }
    if bus.readMask#[4..+4] == 15 {
      claimed = best.id
    }
    if bus.writeMask#[4..+4] == 15 {
      for i in 0..<sources {
        if bus.data#[32..+32] == i + 1 {
          completed#[i] = enabled#[i]
        }
      }
    }
  }
}

pub mod registers<contexts=1, sources=2, priorityBits=2>(
  bus:mmio.Access,
  clock:Clock,
  levels:Unsigned(bits=sources),
  reset:Reset,
) -> (data:U64@[], irq:Unsigned(bits=contexts)@[]) {
  cassert(sources >= 1 and sources <= 1023 and contexts >= 1 and contexts <= 15872)
  cassert(priorityBits >= 1 and priorityBits <= 8)
  const address = bus.address & 0x3fffff8
  reg pending:Unsigned(bits=sources) = 0
  mut priorities:Unsigned(bits=sources*priorityBits) = 0
  mut claimed:U32                                    = 0
  mut completed:Unsigned(bits=sources)               = 0
  data = 0
  for i in 0..<sources {
    const id   = i + 1
    const lane = (id%2)*32
    reg priority:Unsigned(bits=priorityBits) = 0
    if address == ((4*id) & ~7) {
      data#[lane..+priorityBits] = priority
      if bus.writeMask#[(id%2)*4] != 0 {
        priority = bus.data#[lane..+priorityBits]
      }
    }
    if address == 0x1000 + (id/64)*8 {
      data#[id%64] = pending#[i]
    }
    priorities#[(i*priorityBits)..+priorityBits] = priority
  }
  for c in 0..<contexts {
    const dest = target<priorityBits=priorityBits, sources=sources>(address, bus, c, clock, pending, priorities, reset)
    irq#[c]   = dest.interrupt
    data      = data | dest.readData
    claimed   = claimed | dest.claimed
    completed = completed | dest.completed
  }
  for i in 0..<sources {
    const request = gateway(
      clock,
      reset,
      io_interrupt=levels#[i],
      io_plic_ready=~pending#[i],
      io_plic_complete=completed#[i],
    )
    if claimed == i + 1 {
      pending#[i] = 0
    } elif request != 0 {
      pending#[i] = 1
    }
  }
}

pub mod TLPLIC::[
  timecheck=false
](
  auto_in_a_bits_address:U28,
  auto_in_a_bits_corrupt:U1,
  auto_in_a_bits_data:U32,
  auto_in_a_bits_mask:U4,
  auto_in_a_bits_opcode:U4,
  auto_in_a_bits_param:U3,
  auto_in_a_bits_size:U2,
  auto_in_a_bits_source:U10,
  auto_in_a_valid:U1,
  auto_in_d_ready:U1,
  auto_int_in_0:U1,
  auto_int_in_1:U1,
  clock:Clock,
  reset:U1,
) -> (
  auto_in_a_ready:U1@[],
  auto_in_d_bits_data:U32@[],
  auto_in_d_bits_opcode:U4@[],
  auto_in_d_bits_size:U2@[],
  auto_in_d_bits_source:U10@[],
  auto_in_d_valid:U1@[],
  auto_int_out_0:U1@[],
) {
  reg full:Bool:[async=false, initial=false, reset_pin=reset] = nil
  reg result:U32                                              = nil
  reg source:U10                                              = nil
  reg size:U2                                                 = nil
  reg opcode:U4                                               = nil
  auto_in_a_ready = U1(not full or auto_in_d_ready != 0)
  const fire   = auto_in_a_valid != 0 and auto_in_a_ready != 0 and reset == 0
  const read   = auto_in_a_bits_opcode == 4
  const bus    = mmio.fromWord(
    address=auto_in_a_bits_address,
    data=auto_in_a_bits_data,
    mask=auto_in_a_bits_mask,
    read=fire and read,
    write=fire and auto_in_a_bits_opcode <= 1 and auto_in_a_bits_corrupt == 0,
  )
  const device = registers(bus, clock, levels=(auto_int_in_1 << 1) | auto_int_in_0, reset=Bool(reset))
  auto_int_out_0 = device.irq

  if fire {
    full   = true
    source = auto_in_a_bits_source
    size   = auto_in_a_bits_size
    opcode = U1(read)
    result = if auto_in_a_bits_address#[2] != 0 { device.data#[32..+32] } else { device.data#[0..+32] }
  } elif auto_in_d_ready != 0 {
    full = false
  }
  auto_in_d_valid       = U1(full)
  auto_in_d_bits_data   = result
  auto_in_d_bits_source = source
  auto_in_d_bits_size   = size
  auto_in_d_bits_opcode = opcode
}
