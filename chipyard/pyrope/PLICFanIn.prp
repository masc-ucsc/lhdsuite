// Equal priorities select the lowest numbered source. Source zero means none.
pub comb winner<sources, bits>(
  eligible:Unsigned(bits=sources),
  priorities:Unsigned(bits=sources*bits),
) -> (id:U32, priority:Unsigned(bits=bits)) {
  id       = 0
  priority = 0
  for i in 0..<sources {
    const p = priorities#[(i*bits)..+bits]
    if eligible#[i] != 0 and p > priority {
      id       = i + 1
      priority = p
    }
  }
}

pub comb PLICFanIn(io_ip:U2, io_prio_0:U2, io_prio_1:U2) -> (io_dev:U2, io_max:U2) {
  const best = winner<bits=2, sources=2>(eligible=io_ip, priorities=(io_prio_1 << 2) | io_prio_0)
  io_dev = best.id#[0..+2]
  io_max = best.priority
}
