// A leaf at depth zero consumes only the most significant VPN index.
pub comb pageMask<levels>(level:Unsigned(bits=std.clog2(levels))) -> (mask:Unsigned(bits=9*levels)) {
  mask = 0
  for depth in 0..<(levels-1) {
    if level == depth { mask = (1 << (9*(levels-1-depth)))-1 }
  }
}

pub comb canonical<levels>(address:Unsigned(bits=13+9*levels), mode:U4) -> (valid:U1) {
  valid = 0
  for n in 3..<(levels+1) {
    if mode == n+5 {
      const high = address >> (11+9*n)
      valid = U1(high == 0 or high == (1 << (2+9*(levels-n)))-1)
    }
  }
}

// Preserve canonical sign extension or encode a fault in the extra address bit.
pub comb encode<levels>(value:U64) -> (address:Unsigned(bits=13+9*levels)) {
  comptime const bits = 12+9*levels
  const high = value >> bits
  const extra = if high == 0 or high == (1 << (64-bits))-1 { value#[bits] } else { ~value#[bits-1] }
  address = (extra << bits) | value#[0..+bits]
}
