pub comb Arbiter3_Valid_PTWReq<vpnBits=27>::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_valid:U1, io_in_0_bits_bits_addr:Unsigned(bits=vpnBits), io_in_1_valid:U1, io_in_1_bits_bits_addr:Unsigned(bits=vpnBits), io_in_1_bits_bits_need_gpa:U1, io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_valid:U1, io_out_bits_bits_addr:Unsigned(bits=vpnBits), io_out_bits_bits_need_gpa:U1, io_chosen:U2) {
  io_in_0_ready = io_out_ready
  io_in_1_ready = ~io_in_0_valid & io_out_ready
  io_out_valid = io_in_0_valid | io_in_1_valid
  io_out_bits_valid = if io_in_0_valid != 0 { io_in_0_bits_valid } else { io_in_1_valid }
  io_out_bits_bits_addr = if io_in_0_valid != 0 { io_in_0_bits_bits_addr }
      elif io_in_1_valid != 0 { io_in_1_bits_bits_addr } else { 0 }
  io_out_bits_bits_need_gpa = ~io_in_0_valid & io_in_1_valid & io_in_1_bits_bits_need_gpa
  io_chosen = if io_in_0_valid != 0 { 0 } elif io_in_1_valid != 0 { 1 } else { 2 }
}
