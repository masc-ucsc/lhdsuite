)

// WithNMegaTapeoutBooms execution widths, column policy and register files.
pub comb megaTapeoutCore(singlePorted=true) -> (cfg) {
  cfg = config.params<B=mega>(
    alu=config.queue(dispatchWidth=4, issueWidth=4, numEntries=20, numSlowEntries=12),
    dcacheSets=128,
    dcacheSinglePorted=singlePorted,
    dcacheWays=4,
    enableALUSingleWideDispatch=true,
    enableAgenStage=true,
    enableBankedFPFreelist=true,
    enableColumnALUIssue=true,
    enableCompactingLSUDuringDispatch=false,
    enableFastLoadUse=false,
    enableSlowBTBRedirect=true,
    enableSuperscalarSnapshots=false,
    fastTageBPD=true,
    fp=config.queue(dispatchWidth=4, issueWidth=2, numEntries=32, numSlowEntries=20),
    icacheSinglePorted=singlePorted,
    imulLatency=4,
    mem=config.queue(dispatchWidth=4, issueWidth=2, numEntries=32, numSlowEntries=20),
    numFrfBanks=4,
    numFrfReadPorts=4,
    tageSinglePorted=singlePorted,
    slowBTBSinglePorted=singlePorted,
    unq=config.queue(dispatchWidth=4, numEntries=20, numSlowEntries=12),
  )
}

pub const megaTapeout = megaTapeoutCore()

// The upstream teaching example assigns every ALU slot to the slow region.
// Its issue unit requires at least decodeWidth fast slots. The lab can change
// either the number of slow slots or the total queue depth.
pub comb cs152Default(numSlowAluEntries=32, issueEntries=32, fetchEntries=8) -> (cfg) {
  cfg = config.params(enableBranchPrintf=true, decodeWidth=3, fetchWidth=4, numFetchBufferEntries=fetchEntries, lsuWidth=1, numRobEntries=96,
      numIntPhysRegisters=96, numLdqEntries=16, numStqEntries=16, maxBrCount=12,
      numRasEntries=16, dTLBWays=32,
      mem=config.queue(dispatchWidth=3, issueWidth=2, numEntries=issueEntries),
      unq=config.queue(dispatchWidth=3, numEntries=issueEntries),
      alu=config.queue(dispatchWidth=3, issueWidth=3, numEntries=issueEntries, numSlowEntries=numSlowAluEntries),
      fp=config.queue(dispatchWidth=3, numEntries=issueEntries))
}
