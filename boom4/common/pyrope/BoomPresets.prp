pub const giga   = config.params<B=mega>(
  alu=config.queue(dispatchWidth=5, issueWidth=5, numEntries=20, numSlowEntries=10),
  decodeWidth=5,
  enableColumnALUIssue=true,
  enableFastLoadUse=false,
  enableSuperscalarSnapshots=false,
  fp=config.queue(dispatchWidth=5, issueWidth=2, numEntries=32, numSlowEntries=20),
  mem=config.queue(dispatchWidth=5, issueWidth=2, numEntries=32, numSlowEntries=12),
  numDCacheBanks=1,
  numFetchBufferEntries=40,
  numIntPhysRegisters=128,
  numIrfBanks=1,
