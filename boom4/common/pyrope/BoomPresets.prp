const config = import("BoomConfig")

// v4/common/config-mixins.scala resource settings used by the shared frontend,
// rename, issue and ROB blocks. The tile supports replicated integer and FP units.
pub const medium = config.params(
  nPerfCounters=6,
  decodeWidth=2,
  numLdqEntries=16,
  numStqEntries=16,
  maxBrCount=12,
  fetchWidth=4,
  numRobEntries=64,
  ftqEntries=32,
  numFetchBufferEntries=16,
  numIntPhysRegisters=80,
  numFpPhysRegisters=64,
  numIrfBanks=2,
  numIrfReadPorts=5,
  mem=config.queue(dispatchWidth=2, issueWidth=2, numEntries=12),
  unq=config.queue(dispatchWidth=2, numEntries=12),
  alu=config.queue(dispatchWidth=2, issueWidth=2, numEntries=20),
  fp=config.queue(dispatchWidth=2, numEntries=12),
)
pub const large  = config.params(
  decodeWidth=3,
  numLdqEntries=24,
  numStqEntries=24,
  maxBrCount=16,
  enableColumnALUIssue=true,
  fetchWidth=8,
  numRobEntries=96,
  ftqEntries=32,
  numFetchBufferEntries=24,
  icacheWays=8,
  dcacheMSHRs=4,
  dTLBWays=16,
  dcacheRowBits=128,
  dcacheWays=8,
  numIntPhysRegisters=100,
  numFpPhysRegisters=96,
  numIrfBanks=2,
  numIrfReadPorts=6,
  mem=config.queue(dispatchWidth=3, issueWidth=2, numEntries=16),
  unq=config.queue(dispatchWidth=3, numEntries=16, numSlowEntries=8),
  alu=config.queue(dispatchWidth=3, issueWidth=3, numEntries=16, numSlowEntries=8),
  fp=config.queue(dispatchWidth=3, numEntries=24, numSlowEntries=12),
)
pub const mega   = config.params(
