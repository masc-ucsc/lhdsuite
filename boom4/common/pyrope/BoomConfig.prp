const btb = import("../../ifu/pyrope/BTBBranchPredictorBank")
const micro = import("../../ifu/pyrope/FA2MicroBTBBranchPredictorBank")
const bim = import("../../ifu/pyrope/BimCounters")
const standardBank = import("../../ifu/pyrope/ComposedBranchPredictorBank.ComposedBranchPredictorBank")

// BOOM issue queue and front-end parameters. Defaults follow WithNSmallBooms.
pub const defaultQueue = (const iqType=-1, const useMatrixIssue=false, const dispatchWidth=1,
    const issueWidth=1, const numEntries=8, const numSlowEntries=0, const useFullIssueSel=true)

pub comb queue<B=defaultQueue>(iqType=B.iqType, useMatrixIssue=B.useMatrixIssue, dispatchWidth=B.dispatchWidth,
    issueWidth=B.issueWidth, numEntries=B.numEntries, numSlowEntries=B.numSlowEntries, useFullIssueSel=B.useFullIssueSel) -> (cfg) {
  cfg = (
    const iqType=iqType,
    const useMatrixIssue=useMatrixIssue,
    const issueWidth=issueWidth,
    const numEntries=numEntries,
    const numSlowEntries=numSlowEntries,
    const dispatchWidth=dispatchWidth,
    const useFullIssueSel=useFullIssueSel,
  )
}

pub const IQ_MEM = 0
pub const IQ_UNQ = 1
pub const IQ_ALU = 2
pub const IQ_FP = 3

comb selectQueue(entries, kind, fallback) -> (q) {
  q = queue<B=fallback>(iqType=kind)
  if entries.[size] != 0 {
    cassert(entries.[size] == 4, "BOOM needs one issue queue of each type")
    mut found = 0
    for entry in entries {
      if entry.iqType == kind {
        q = entry
        found = found+1
      }
    }
    cassert(found == 1, "BOOM needs exactly one queue of each type")
  }
}

pub const fast           = queue()
pub const memory         = queue(issueWidth=2)
pub const halfSlowMemory = queue(issueWidth=2, numSlowEntries=4)
pub const halfSlow       = queue(numSlowEntries=4)

pub const tageLTables = (
  (const history=2, const rows=128, const tag=7),
  (const history=4, const rows=128, const tag=7),
  (const history=8, const rows=256, const tag=8),
  (const history=16, const rows=256, const tag=8),
  (const history=32, const rows=128, const tag=9),
  (const history=64, const rows=128, const tag=9),
)

pub const fastTageTables = (
  (const history=2, const rows=128, const tag=8),
  (const history=4, const rows=128, const tag=8),
  (const history=8, const rows=128, const tag=8),
  (const history=16, const rows=128, const tag=8),
  (const history=32, const rows=128, const tag=8),
  (const history=64, const rows=128, const tag=8),
)

pub const alphaTables = (const globalSets=2048, const localSets=2048, const chooserSets=128, const historySets=128)

pub const boom2Table = (const history=16, const rows=256, const tag=7)

pub comb floatingPoint(sfmaLatency=4, dfmaLatency=4, divSqrt=true) -> (cfg) {
  cassert(sfmaLatency == dfmaLatency and dfmaLatency >= 3, "BOOM FP write ports share one latency with three issue stages")
  cfg = (const sfmaLatency=sfmaLatency, const dfmaLatency=dfmaLatency, const divSqrt=divSqrt)
}

pub comb integerDivide(divUnroll=1, divEarlyOut=true, divEarlyOutGranularity=1) -> (cfg) {
  cassert(divUnroll >= 1 and divUnroll <= 64 and divEarlyOutGranularity >= 1 and divEarlyOutGranularity <= 64)
  cfg = (const divUnroll=divUnroll, const divEarlyOut=divEarlyOut, const divEarlyOutGranularity=divEarlyOutGranularity)
}

pub comb fetchTargetQueue(nEntries=16) -> (cfg) {
  cfg = (const nEntries=nEntries,)
}

pub const defaultMulDiv = integerDivide()
pub const defaultFPU = floatingPoint()

// Unspecified widths and capacities are resolved after a profile is composed.
pub comb instructionTLB(nSets=1, nWays=32, nSectors=4, nSuperpageEntries=4) -> (cfg) {
  cassert(nSets >= 1 and nSets == 1 << std.clog2(nSets))
  cassert(nSectors >= 1 and nSectors == 1 << std.clog2(nSectors))
  cassert(nWays >= nSectors and nWays%nSectors == 0 and nSuperpageEntries >= 1)
  cfg = (const nSets=nSets, const nWays=nWays, const nSectors=nSectors, const nSuperpageEntries=nSuperpageEntries)
}

