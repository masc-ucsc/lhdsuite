const fpQueue = import("../pyrope/IssueUnitCollapsing.IssueUnitCollapsing")
const uniqueQueue = import("../pyrope/IssueUnitCollapsing_2.IssueUnitCollapsing_2")
const aluQueue = import("../pyrope/IssueUnitCollapsing_3.IssueUnitCollapsing_3")
const configs = import("../../common/pyrope/BoomConfig")

pub mod trial<Q, kind, banked=false, narrow=false, branches=8>(clk:Clock, rst:Reset, pattern:U5, enable:U1, drain:U1) -> (ok:Bool@[]) {
  comptime const ports = Q.issueWidth
  comptime const w = Q.dispatchWidth
  reg sent:U16 = nil
  reg retired:U16 = nil
  reg sawAllPorts:Bool = nil
  reg sawFull:Bool = nil
  reg sawGroup:Bool = nil
  wire ready:Unsigned(bits=w) = nil
  const submit = ready & pattern#[0..+w]
  mut ftq:Unsigned(bits=w*6) = 0
  mut physical:Unsigned(bits=w*8) = 0
  mut labels:Unsigned(bits=w*5) = 0
  comptime const tagBits = std.clog2(branches)
  mut masks:Unsigned(bits=w*branches) = 0
  mut branchTags:Unsigned(bits=w*tagBits) = 0
  mut columns:Unsigned(bits=w*8) = 0
  mut next = sent
  for lane in 0..<w {
    masks#[(lane*branches)..+branches] = 1 << (next#[0..+8]%branches)
    branchTags#[(lane*tagBits)..+tagBits] = next#[0..+8]%branches
    columns#[(lane*8)..+8] = lane
    ftq#[(lane*6)..+6] = next#[0..+6]
    physical#[(lane*8)..+8] = (next + 128)#[0..+8]
    labels#[(lane*5)..+5] = next#[0..+5]
    if submit#[lane] != 0 { wrap next = next+1 }
  }
  // Wake the row one cycle after dispatch through the high-numbered ALU buses.
  reg lastTags:U40 = nil
  reg lastValid:U5 = nil
  lastTags = physical << ((5-w)*8)
  lastValid = submit << (5-w)
  mut portMask:Unsigned(bits=ports*10) = 0
  for port in 0..<ports {
    // Disable port zero for part of the run; younger ports can still issue.
    if enable != 0 and (port != 0 or sent#[2] == 0 or pattern == 0) {
      portMask#[(port*10)..+10] = if kind == 0 { 1 << 6 } elif kind == 1 { 1 << 3 } else { 1 }
    }
  }
  mut observedMasks:Unsigned(bits=ports*branches) = 0
  mut observedTags:Unsigned(bits=ports*tagBits) = 0
  mut issued:Unsigned(bits=ports) = 0
  mut observedRob:Unsigned(bits=ports*8) = 0
  mut observedDest:Unsigned(bits=ports*8) = 0
  mut observedSource:Unsigned(bits=ports*8) = 0
  mut observedPred:Unsigned(bits=ports*6) = 0
  mut observedFtq:Unsigned(bits=ports*6) = 0
  mut observed:Unsigned(bits=5*ports) = 0
  if kind == 0 {
    const unit = fpQueue<Q, branches=branches, CoreWidth=w, ftqBits=6, pregBits=8, robBits=8>(`clock`=clk, `reset`=rst, disValid=submit, dis_inst=0,
      dis_debug_inst=0, dis_is_rvc=0, dis_debug_pc=0, dis_iq_type_0=0,
      dis_iq_type_1=0, dis_iq_type_2=0, dis_iq_type_3=0, dis_fu_code_1=0,
      dis_fu_code_2=0, dis_fu_code_4=0, dis_fu_code_5=0, dis_fu_code_7=0,
      dis_fu_code_8=0, dis_fu_code_9=0, dis_iw_p1_speculative_child=0, dis_iw_p2_speculative_child=0,
      dis_br_mask=masks, dis_br_tag=branchTags, dis_br_type=0, dis_is_sfb=0,
      dis_is_fence=0, dis_is_fencei=0, dis_is_sfence=0, dis_is_amo=0,
      dis_is_eret=0, dis_is_sys_pc2epc=0, dis_is_rocc=0, dis_is_mov=0,
      dis_ftq_idx=ftq, dis_edge_inst=0, dis_pc_lob=0, dis_taken=0,
      dis_imm_rename=0, dis_imm_sel=0, dis_pimm=labels, dis_imm_packed=0,
      dis_op1_sel=0, dis_op2_sel=0, dis_fp_ctrl_ldst=0, dis_fp_ctrl_wen=0,
      dis_fp_ctrl_ren1=0, dis_fp_ctrl_ren2=0, dis_fp_ctrl_ren3=0, dis_fp_ctrl_swap12=0,
      dis_fp_ctrl_swap23=0, dis_fp_ctrl_typeTagIn=0, dis_fp_ctrl_typeTagOut=0, dis_fp_ctrl_fromint=0,
      dis_fp_ctrl_toint=0, dis_fp_ctrl_fastpipe=0, dis_fp_ctrl_fma=0, dis_fp_ctrl_div=0,
      dis_fp_ctrl_sqrt=0, dis_fp_ctrl_wflags=0, dis_fp_ctrl_vec=0, dis_rob_idx=~physical,
      dis_ldq_idx=0, dis_stq_idx=0, dis_rxq_idx=0, dis_pdst=physical,
      dis_prs1=physical, dis_prs2=0, dis_prs3=0, dis_ppred=~ftq,
      dis_prs1_busy=0, dis_prs2_busy=0, dis_prs3_busy=0, dis_ppred_busy=0,
      dis_stale_pdst=0, dis_exception=0, dis_exc_cause=0, dis_mem_cmd=0,
      dis_mem_size=0, dis_mem_signed=0, dis_uses_ldq=0, dis_uses_stq=0,
      dis_is_unique=0, dis_flush_on_commit=0, dis_csr_cmd=0, dis_ldst_is_rs1=0,
      dis_ldst=0, dis_lrs1=0, dis_lrs2=0, dis_lrs3=0,
      dis_dst_rtype=0, dis_lrs1_rtype=0, dis_lrs2_rtype=0, dis_frs3_en=0,
      dis_fcn_dw=0, dis_fcn_op=0, dis_fp_val=0, dis_xcpt_pf_if=0,
      dis_xcpt_ae_if=0, dis_xcpt_ma_if=0, dis_bp_debug_if=0, dis_bp_xcpt_if=0,
      dis_debug_fsrc=0, dis_debug_tsrc=0, io_wakeup_ports_0_valid=0, io_wakeup_ports_0_bits_uop_pdst=0,
      io_wakeup_ports_1_valid=0, io_wakeup_ports_1_bits_uop_pdst=0, io_brupdate_b1_resolve_mask=0, io_brupdate_b1_mispredict_mask=0,
      io_flush_pipeline=0, io_squash_grant=U1(enable == 0), dis_fu_code_0=0, dis_fu_code_3=0, dis_fu_code_6=(1 << w)-1, dis_fp_rm=0,
        dis_fp_typ=0, fuMask=portMask)
    observedMasks = unit.iss_br_mask
    observedTags = unit.iss_br_tag
    ready = unit.disReady
    issued = unit.issValid
    observedRob = unit.iss_rob_idx
    observedDest = unit.iss_pdst
    observedSource = unit.iss_prs1
    observedPred = unit.iss_ppred
    observedFtq = unit.iss_ftq_idx
    observed = unit.iss_pimm
  } elif kind == 1 {
    const unit = uniqueQueue<Q, branches=branches, CoreWidth=w, alus=5, ftqBits=6, pregBits=8, robBits=8>(`clock`=clk, `reset`=rst, disValid=submit, dis_inst=0,
      dis_debug_inst=0, dis_is_rvc=0, dis_debug_pc=0, dis_iq_type_0=0,
      dis_iq_type_1=0, dis_iq_type_2=0, dis_iq_type_3=0, dis_fu_code_1=0,
      dis_fu_code_2=0, dis_fu_code_4=0, dis_fu_code_5=0, dis_fu_code_7=0,
      dis_fu_code_8=0, dis_fu_code_9=0, dis_iw_p1_speculative_child=0, dis_iw_p2_speculative_child=0,
      dis_br_mask=masks, dis_br_tag=branchTags, dis_br_type=0, dis_is_sfb=0,
      dis_is_fence=0, dis_is_fencei=0, dis_is_sfence=0, dis_is_amo=0,
      dis_is_eret=0, dis_is_sys_pc2epc=0, dis_is_rocc=0, dis_is_mov=0,
      dis_ftq_idx=ftq, dis_edge_inst=0, dis_pc_lob=0, dis_taken=0,
      dis_imm_rename=0, dis_imm_sel=0, dis_pimm=labels, dis_imm_packed=0,
      dis_op1_sel=0, dis_op2_sel=0, dis_fp_ctrl_ldst=0, dis_fp_ctrl_wen=0,
      dis_fp_ctrl_ren1=0, dis_fp_ctrl_ren2=0, dis_fp_ctrl_ren3=0, dis_fp_ctrl_swap12=0,
      dis_fp_ctrl_swap23=0, dis_fp_ctrl_typeTagIn=0, dis_fp_ctrl_typeTagOut=0, dis_fp_ctrl_fromint=0,
      dis_fp_ctrl_toint=0, dis_fp_ctrl_fastpipe=0, dis_fp_ctrl_fma=0, dis_fp_ctrl_div=0,
      dis_fp_ctrl_sqrt=0, dis_fp_ctrl_wflags=0, dis_fp_ctrl_vec=0, dis_rob_idx=~physical,
      dis_ldq_idx=0, dis_stq_idx=0, dis_rxq_idx=0, dis_pdst=physical,
      dis_prs1=physical, dis_prs2=0, dis_prs3=0, dis_ppred=~ftq,
      dis_prs1_busy=submit, dis_prs2_busy=0, dis_prs3_busy=0, dis_ppred_busy=0,
      dis_stale_pdst=0, dis_exception=0, dis_exc_cause=0, dis_mem_cmd=0,
      dis_mem_size=0, dis_mem_signed=0, dis_uses_ldq=0, dis_uses_stq=0,
      dis_is_unique=0, dis_flush_on_commit=0, dis_csr_cmd=0, dis_ldst_is_rs1=0,
      dis_ldst=0, dis_lrs1=0, dis_lrs2=0, dis_lrs3=0,
      dis_dst_rtype=0, dis_lrs1_rtype=0, dis_lrs2_rtype=0, dis_frs3_en=0,
      dis_fcn_dw=0, dis_fcn_op=0, dis_fp_val=0, dis_xcpt_pf_if=0,
      dis_xcpt_ae_if=0, dis_xcpt_ma_if=0, dis_bp_debug_if=0, dis_bp_xcpt_if=0,
      dis_debug_fsrc=0, dis_debug_tsrc=0, io_wakeup_ports_0_valid=0, io_wakeup_ports_0_bits_uop_pdst=0,
      io_wakeup_ports_1_valid=0, io_wakeup_ports_1_bits_uop_pdst=0, io_brupdate_b1_resolve_mask=0, io_brupdate_b1_mispredict_mask=0,
      io_flush_pipeline=0, io_squash_grant=U1(enable == 0), dis_fu_code_0=0, dis_fu_code_3=(1 << w)-1, dis_fu_code_6=0, dis_fp_rm=0,
        dis_fp_typ=0, io_wakeup_ports_0_bits_bypassable=0, io_wakeup_ports_0_bits_rebusy=0, io_wakeup_ports_2_valid=lastValid,
        io_wakeup_ports_2_bits_uop_pdst=lastTags, io_child_rebusys=0, fuMask=portMask)
    observedMasks = unit.iss_br_mask
    observedTags = unit.iss_br_tag
    ready = unit.disReady
    issued = unit.issValid
    observedRob = unit.iss_rob_idx
    observedDest = unit.iss_pdst
    observedSource = unit.iss_prs1
    observedPred = unit.iss_ppred
    observedFtq = unit.iss_ftq_idx
    observed = unit.iss_pimm
  } else {
    const unit = aluQueue<Q, branches=branches, columnIssue=banked, columnWrites=narrow, singleWide=narrow, CoreWidth=w, alus=5, ftqBits=6, pregBits=8, robBits=8>(columnTags=columns, `clock`=clk, `reset`=rst, disValid=submit, dis_inst=0,
      dis_debug_inst=0, dis_is_rvc=0, dis_debug_pc=0, dis_iq_type_0=0,
      dis_iq_type_1=0, dis_iq_type_2=0, dis_iq_type_3=0, dis_fu_code_1=0,
      dis_fu_code_2=0, dis_fu_code_4=0, dis_fu_code_5=0, dis_fu_code_7=0,
      dis_fu_code_8=0, dis_fu_code_9=0, dis_iw_p1_speculative_child=0, dis_iw_p2_speculative_child=0,
      dis_br_mask=masks, dis_br_tag=branchTags, dis_br_type=0, dis_is_sfb=0,
      dis_is_fence=0, dis_is_fencei=0, dis_is_sfence=0, dis_is_amo=0,
      dis_is_eret=0, dis_is_sys_pc2epc=0, dis_is_rocc=0, dis_is_mov=0,
      dis_ftq_idx=ftq, dis_edge_inst=0, dis_pc_lob=0, dis_taken=0,
      dis_imm_rename=0, dis_imm_sel=0, dis_pimm=labels, dis_imm_packed=0,
      dis_op1_sel=0, dis_op2_sel=0, dis_fp_ctrl_ldst=0, dis_fp_ctrl_wen=0,
      dis_fp_ctrl_ren1=0, dis_fp_ctrl_ren2=0, dis_fp_ctrl_ren3=0, dis_fp_ctrl_swap12=0,
      dis_fp_ctrl_swap23=0, dis_fp_ctrl_typeTagIn=0, dis_fp_ctrl_typeTagOut=0, dis_fp_ctrl_fromint=0,
      dis_fp_ctrl_toint=0, dis_fp_ctrl_fastpipe=0, dis_fp_ctrl_fma=0, dis_fp_ctrl_div=0,
      dis_fp_ctrl_sqrt=0, dis_fp_ctrl_wflags=0, dis_fp_ctrl_vec=0, dis_rob_idx=~physical,
      dis_ldq_idx=0, dis_stq_idx=0, dis_rxq_idx=0, dis_pdst=physical,
      dis_prs1=physical, dis_prs2=0, dis_prs3=0, dis_ppred=~ftq,
      dis_prs1_busy=submit, dis_prs2_busy=0, dis_prs3_busy=0, dis_ppred_busy=0,
      dis_stale_pdst=0, dis_exception=0, dis_exc_cause=0, dis_mem_cmd=0,
      dis_mem_size=0, dis_mem_signed=0, dis_uses_ldq=0, dis_uses_stq=0,
      dis_is_unique=0, dis_flush_on_commit=0, dis_csr_cmd=0, dis_ldst_is_rs1=0,
      dis_ldst=0, dis_lrs1=0, dis_lrs2=0, dis_lrs3=0,
      dis_dst_rtype=0, dis_lrs1_rtype=0, dis_lrs2_rtype=0, dis_frs3_en=0,
      dis_fcn_dw=0, dis_fcn_op=0, dis_fp_val=0, dis_xcpt_pf_if=0,
      dis_xcpt_ae_if=0, dis_xcpt_ma_if=0, dis_bp_debug_if=0, dis_bp_xcpt_if=0,
      dis_debug_fsrc=0, dis_debug_tsrc=0, io_wakeup_ports_0_valid=0, io_wakeup_ports_0_bits_uop_pdst=0,
      io_wakeup_ports_1_valid=0, io_wakeup_ports_1_bits_uop_pdst=0, io_brupdate_b1_resolve_mask=0, io_brupdate_b1_mispredict_mask=0,
      io_flush_pipeline=0, io_squash_grant=U1(enable == 0), dis_fu_code_0=(1 << w)-1, dis_fu_code_3=0, dis_fu_code_6=0, io_wakeup_ports_0_bits_bypassable=0,
        io_wakeup_ports_0_bits_rebusy=0, io_wakeup_ports_2_valid=lastValid, io_wakeup_ports_2_bits_uop_pdst=lastTags, io_pred_wakeup_port_valid=0,
        io_pred_wakeup_port_bits=0, io_child_rebusys=0, fuMask=portMask)
    observedMasks = unit.iss_br_mask
    observedTags = unit.iss_br_tag
    ready = unit.disReady
    issued = unit.issValid
    observedRob = unit.iss_rob_idx
    observedDest = unit.iss_pdst
    observedSource = unit.iss_prs1
    observedPred = unit.iss_ppred
    observedFtq = unit.iss_ftq_idx
    observed = unit.iss_pimm
  }
  ok = true
  reg outstanding:U256 = nil
  mut pending:U256 = outstanding
  mut nextRetired = retired
  for port in 0..<ports {
    if issued#[port] != 0 {
      const label = (observedDest#[(port*8)..+8] - 128)#[0..+8]
      if banked {
        ok = ok and pending#[label] != 0
        pending#[label] = 0
      }
      const sequence = if banked { label } else { nextRetired }
      ok = ok and portMask#[(port*10)..+10] != 0 and nextRetired < sent and observed#[(port*5)..+5] == sequence#[0..+5]
      ok = ok and observedFtq#[(port*6)..+6] == sequence#[0..+6]
      ok = ok and observedPred#[(port*6)..+6] == ((~sequence) & 63)
      ok = ok and observedMasks#[(port*branches)..+branches] == 1 << (sequence#[0..+8]%branches)
      ok = ok and observedTags#[(port*tagBits)..+tagBits] == sequence#[0..+8]%branches
      const expected = (sequence + 128)#[0..+8]
      ok = ok and observedRob#[(port*8)..+8] == ((~expected) & 255)
      ok = ok and observedDest#[(port*8)..+8] == expected and observedSource#[(port*8)..+8] == expected
      wrap nextRetired = nextRetired+1
    }
  }
  for lane in 0..<w {
    if submit#[lane] != 0 {
      const label = (physical#[(lane*8)..+8] - 128)#[0..+8]
      pending#[label] = 1
    }
  }
  outstanding = if rst { 0 } else { pending }
  if drain != 0 { ok = ok and retired == sent and sawFull and sawGroup and sawAllPorts and sent > 40 }
  if rst {
    sent = 0
    retired = 0
    sawAllPorts = false
    sawFull = false
    sawGroup = false
  } else {
    sent = next
    retired = nextRetired
    if issued == (1 << ports)-1 { sawAllPorts = true }
    if ready == 0 and sent >= w { sawFull = true }
    if submit == (1 << w)-1 { sawGroup = true }
  }
}

pub mod wide_issue_queues(clk:Clock, rst:Reset, pattern:U5, enable:U1, drain:U1) -> (ok:Bool@[]) {
  mut good = true
  for kind in 0..<3 {
    comptime const width = 4-kind
    comptime const q = configs.queue(issueWidth=if kind == 0 { 2 } elif kind == 1 { 1 } else { 4 }, numEntries=width*6, numSlowEntries=width*2, dispatchWidth=width)
    const testQueue = trial<Q=q, kind=kind>(clk=clk, rst=rst, pattern=pattern, enable=enable, drain=drain)
    good = good and testQueue.ok
  }
  ok = good
}

test wide_issue_queues.order {
  mut dut = wide_issue_queues
  tick 250 {
    dut.rst = clock < 3
    dut.pattern = if clock < 5 or clock >= 180 { 0 } elif clock < 30 { 31 } else { (clock*13)#[0..+5] }
    dut.enable = U1(clock >= 35 and (clock%17 < 11 or clock >= 180))
    dut.drain = U1(clock == 247)
    step
    if clock >= 4 { assert(dut.ok, "issue queue lost, duplicated, or reordered a dispatched uop") }
  }
}
