const merge = import("../pyrope/DispatchOperands.merge")

// Mix integer, FP, CSR and predicate operands in a single row. The physical
// maps have different tag widths, so slicing at the wrong stride is visible.
pub mod dispatch_operands(clock:Clock) -> (correct:Bool@[]) {
  const row = merge<fpBits=6, intBits=8, pregBits=8, width=5>(
    dstType=0xa4,
    src1Type=0x121,
    src2Type=0x64,
    logical1=0x2aaecb6e,
    brType=0x821,
    sfb=0x1d,
    frs3En=0xd,
    intDst=0x8c8b8a8988,
    intOld=0x8e8d8c8b8a,
    int1=0x908f8e8d8c,
    int2=0x9291908f8e,
    fpDst=0x2caeaa68,
    fpOld=0x2eb6caea,
    fp1=0x30beeb6c,
    fp2=0x32c70bee,
    fp3=0x34cf2c70,
    predDst=0x9e9d9c9b9a,
    randomDst=0xa09f9e9d9c,
    intBusy1=0x16,
    intBusy2=0x1b,
    fpBusy1=0xd,
    fpBusy2=0x16,
    fpBusy3=0x1b,
    predBusy=0xd,
  )
  correct = row.dst == 0x8c9f9c2988
    and row.old == 0x8e8d8c2b8a
    and row.src1 == 0x308f2c8d2c
    and row.src2 == 0x9231902f8e
    and row.src3 == 0x3433323130
    and row.busy1 == 0x3
    and row.busy2 == 0x13
    and row.busy3 == 0x9
    and row.busyPred == 0x8
}

test dispatch_operands.maps {
  mut d = dispatch_operands
  tick 1 {
    step
    assert(d.correct, "renamed tag width, register type and busy bits for every lane")
  }
}
