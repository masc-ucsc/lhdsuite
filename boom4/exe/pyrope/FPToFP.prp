const delay = import("../../util/pyrope/EnabledPipe.EnabledPipe")
const RecFNToRecFN = import("RecFNToRecFN.RecFNToRecFN")

pub mod FPToFP<latency=4>::[timecheck=false](clock:Clock, io_in_bits_in1:U65, io_in_bits_in2:U65, io_in_bits_ren2:U1, io_in_bits_rm:U3, io_in_bits_typeTagOut:U2, io_in_bits_wflags:U1, io_in_valid:U1, io_lt:U1, reset:U1) -> (io_out_bits_data:U65@[], io_out_bits_exc:U5@[]) {
  comptime const tailStages = latency-1
  reg in_pipe_v:U1:[async=false, initial=0, reset_pin=reset]
  reg in_pipe_b_ren2:U1
  reg in_pipe_b_typeTagOut:U2
  reg in_pipe_b_wflags:U1
  reg in_pipe_b_rm:U3
  reg in_pipe_b_in1:U65
  reg in_pipe_b_in2:U65
  const _GEN__w1 = in_pipe_b_wflags & (~in_pipe_b_ren2) & 1
  mut _mux_1:U65 = if in_pipe_b_in1#[61..<0x40] == 7 { 0xe008000000000000 } else { in_pipe_b_in1#[0..<0x41] }
  mut _mux_7:U65 = if ((U1(in_pipe_b_in2#[61..<0x40] == 7) | (U1((in_pipe_b_rm & 1) != io_lt) & (~U1(in_pipe_b_in1#[61..<0x40] == 7)#[0]) & 1)) & 1) != 0 {
    in_pipe_b_in1#[0..<0x41]
  } else {
    in_pipe_b_in2#[0..<0x41]
  }
  mut _mux_8:U65 = if (U1(in_pipe_b_in1#[61..<0x40] == 7) & U1(in_pipe_b_in2#[61..<0x40] == 7) & 1) != 0 { 0xe008000000000000 }
    else { _mux_7#[0..<0x41] }
  mut _mux_9:U1 = if in_pipe_b_rm#[1..<2] != 0 { (in_pipe_b_in1#[0x40..<0x41] ^ in_pipe_b_in2#[0x40..<0x41]) & 1 }
    else { ((in_pipe_b_rm & 1) ^ in_pipe_b_in2#[0x40..<0x41]) & 1 }
  mut _mux_10:U65 = if in_pipe_b_wflags != 0 { _mux_8#[0..<0x41] } else { ((_mux_9 & 1) << 64) | in_pipe_b_in1#[0..<0x40] }
  mut fsgnjMux_data:U65 = if _GEN__w1 != 0 { _mux_1#[0..<0x41] } else { _mux_10#[0..<0x41] }
  const _GEN_0__w1 = U1(in_pipe_b_typeTagOut == 0)
  const _mux_data_expOut_commonCase_T__w1 = (fsgnjMux_data#[52..<61] - 0x100)#[0..<9]
  mut narrower = RecFNToRecFN::[name=narrower](io_in=in_pipe_b_in1, io_roundingMode=in_pipe_b_rm)
  in_pipe_v = io_in_valid & ~reset
  if io_in_valid != 0 {
    in_pipe_b_ren2 = io_in_bits_ren2
    in_pipe_b_typeTagOut = io_in_bits_typeTagOut
    in_pipe_b_wflags = io_in_bits_wflags
    in_pipe_b_rm = io_in_bits_rm
    in_pipe_b_in1 = io_in_bits_in1
    in_pipe_b_in2 = io_in_bits_in2
  }
  const _b2i_13 = U1(fsgnjMux_data#[61..<0x40] == 0)
  const _b2i_14 = U1(fsgnjMux_data#[61..<0x40] > 5)
  const _mux_15:U9 = if ((_b2i_13 | _b2i_14) & 1) != 0 { (fsgnjMux_data#[61..<0x40] << 6) | _mux_data_expOut_commonCase_T__w1#[0..<6] } else { _mux_data_expOut_commonCase_T__w1#[0..<9] }
  const _mux_16:U65 = if _GEN__w1 != 0 { (fsgnjMux_data#[33..<0x41] << 33) | narrower.io_out#[0..<33] } else { (fsgnjMux_data#[33..<0x41] << 33) | (fsgnjMux_data#[0x40..<0x41] << 32) | (_mux_15#[0..<9] << 23) | fsgnjMux_data#[29..<52] }
  const _mux_17:U65 = if _GEN_0__w1 != 0 { _mux_16#[0..<0x41] } else { fsgnjMux_data#[0..<0x41] }
  const _mux_21:U5 = if in_pipe_b_wflags != 0 { (((U1(in_pipe_b_in1#[61..<0x40] == 7) & (~in_pipe_b_in1#[51..<52]) & 1) | (U1(in_pipe_b_in2#[61..<0x40] == 7) & (~in_pipe_b_in2#[51..<52]) & 1)) & 1) << 4 } else { 0 }
  const _mux_22:U5 = if _GEN__w1 != 0 { (U1(in_pipe_b_in1#[61..<0x40] == 7) & (~in_pipe_b_in1#[51..<52]) & 1) << 4 } else { _mux_21#[0..<5] }
  const _mux_23:U5 = if (_GEN__w1 & _GEN_0__w1 & 1) != 0 { narrower.io_exceptionFlags#[0..<5] } else { _mux_22#[0..<5] }
  const result = delay<bits=70, stages=tailStages>(clock, reset, valid=in_pipe_v, data=(_mux_23 << 65) | _mux_17)
  io_out_bits_data = result#[0..+65]
  io_out_bits_exc = result#[65..+5]
}
