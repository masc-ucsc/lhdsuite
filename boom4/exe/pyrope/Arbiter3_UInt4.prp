pub comb Arbiter3_UInt4<ftqBits=4>(io_in_0_valid:U1, io_in_0_bits:Unsigned(bits=ftqBits),
  io_in_1_valid:U1, io_in_1_bits:Unsigned(bits=ftqBits), io_in_2_bits:Unsigned(bits=ftqBits),
) -> (io_in_2_ready:U1, io_out_bits:Unsigned(bits=ftqBits)) {
  io_in_2_ready = U1(io_in_0_valid == 0 and io_in_1_valid == 0)
  io_out_bits = if io_in_0_valid != 0 { io_in_0_bits } elif io_in_1_valid != 0 { io_in_1_bits } else { io_in_2_bits }
}
