const BranchKillablePipeline = import("../../util/pyrope/BranchKillablePipeline.BranchKillablePipeline")
const PipelinedMultiplier = import("PipelinedMultiplier.PipelinedMultiplier")

pub mod PipelinedMulUnit<latency=3, pregBits=6, robBits=5, branches=8>::[timecheck=false](clock:Clock, io_brupdate_b1_mispredict_mask:Unsigned(bits=branches), io_brupdate_b1_resolve_mask:Unsigned(bits=branches), io_kill:U1, io_req_bits_rs1_data:U64, io_req_bits_rs2_data:U64, io_req_bits_uop_br_mask:Unsigned(bits=branches), io_req_bits_uop_dst_rtype:U2, io_req_bits_uop_fcn_dw:U1, io_req_bits_uop_fcn_op:U5, io_req_bits_uop_pdst:Unsigned(bits=pregBits), io_req_bits_uop_rob_idx:Unsigned(bits=robBits), io_req_valid:U1, reset:Reset) -> (io_resp_bits_data:U64@[], io_resp_bits_uop_br_mask:Unsigned(bits=branches)@[], io_resp_bits_uop_dst_rtype:U2@[], io_resp_bits_uop_pdst:Unsigned(bits=pregBits)@[], io_resp_bits_uop_rob_idx:Unsigned(bits=robBits)@[], io_resp_valid:U1@[]) {
  mut imul = PipelinedMultiplier<latency=latency>(clock=clock, reset=reset, io_req_valid=io_req_valid, io_req_bits_fn=io_req_bits_uop_fcn_op, io_req_bits_dw=io_req_bits_uop_fcn_dw, io_req_bits_in1=io_req_bits_rs1_data, io_req_bits_in2=io_req_bits_rs2_data)
  mut `pipe` = BranchKillablePipeline<branches=branches, stages=latency, pregBits=pregBits, robBits=robBits>(clock=clock, reset=reset, io_req_valid=io_req_valid, io_req_bits_uop_br_mask=io_req_bits_uop_br_mask, io_req_bits_uop_rob_idx=io_req_bits_uop_rob_idx, io_req_bits_uop_pdst=io_req_bits_uop_pdst, io_req_bits_uop_dst_rtype=io_req_bits_uop_dst_rtype, io_flush=io_kill, io_brupdate_b1_resolve_mask=io_brupdate_b1_resolve_mask, io_brupdate_b1_mispredict_mask=io_brupdate_b1_mispredict_mask)
  io_resp_valid = `pipe`.io_resp_valid
  io_resp_bits_uop_br_mask = `pipe`.io_resp_bits_uop_br_mask
  io_resp_bits_uop_rob_idx = `pipe`.io_resp_bits_uop_rob_idx
  io_resp_bits_uop_pdst = `pipe`.io_resp_bits_uop_pdst
  io_resp_bits_uop_dst_rtype = `pipe`.io_resp_bits_uop_dst_rtype
  io_resp_bits_data = imul
}
