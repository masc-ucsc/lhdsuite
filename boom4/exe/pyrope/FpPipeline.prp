    io_dgen_bits_uop_stq_idx = fpBus.io_dgen_bits_uop_stq_idx
    io_dgen_bits_data = fpBus.io_dgen_bits_data
    io_to_int_valid = fpBus.io_fpiu_resp_valid
    io_to_int_bits_uop_br_mask = fpBus.io_fpiu_resp_bits_uop_br_mask
    io_to_int_bits_uop_rob_idx = fpBus.io_fpiu_resp_bits_uop_rob_idx
    io_to_int_bits_uop_pdst = fpBus.io_fpiu_resp_bits_uop_pdst
    io_to_int_bits_uop_dst_rtype = fpBus.io_fpiu_resp_bits_uop_dst_rtype
    io_to_int_bits_data = fpBus.io_fpiu_resp_bits_data
    io_to_int_bits_predicated = fpBus.io_fpiu_resp_bits_predicated
    io_to_int_bits_fflags_valid = fpBus.io_fpiu_resp_bits_fflags_valid
    io_to_int_bits_fflags_bits = fpBus.io_fpiu_resp_bits_fflags_bits
    io_wakeups_0_valid = fpBus.io_wakeup_valid
    io_wakeups_0_bits_uop_pdst = fpBus.io_wakeup_bits_uop_pdst
    io_wakeups_0_bits_uop_dst_rtype = fpBus.io_wakeup_bits_uop_dst_rtype
    io_wakeups_1_valid = ll_wbarbFeedback.io_out_valid
    io_wakeups_1_bits_uop_pdst = ll_wbarbFeedback.io_out_bits_uop_pdst
    io_wakeups_1_bits_uop_dst_rtype = ll_wbarbFeedback.io_out_bits_uop_dst_rtype
    traceData = 0
    if C.trace or C.enableCommitLogPrintf {
      for port in 0..<ports {
        traceData#[(port*64)..+64] = ieeeBits(value=fpBus.io_fpu_resp_bits_data#[(port*65)..+65])
      }
      traceData#[(ports*64)..+64] = ieeeBits(value=ll_wbarbFeedback.io_out_bits_data)
    }
    io_wb_0_valid = fpBus.io_fpu_resp_valid
    io_wb_0_bits_uop_rob_idx = fpBus.io_fpu_resp_bits_uop_rob_idx
    io_wb_0_bits_uop_pdst = fpBus.io_fpu_resp_bits_uop_pdst
    io_wb_0_bits_fflags_valid = fpBus.io_fpu_resp_bits_fflags_valid
    io_wb_0_bits_fflags_bits = fpBus.io_fpu_resp_bits_fflags_bits
    io_wb_1_valid = ll_wbarbFeedback.io_out_valid
    io_wb_1_bits_uop_rob_idx = ll_wbarb.io_out_bits_uop_rob_idx
    io_wb_1_bits_uop_pdst = ll_wbarbFeedback.io_out_bits_uop_pdst
    io_wb_1_bits_predicated = ll_wbarb.io_out_bits_predicated
    io_wb_1_bits_fflags_valid = ll_wbarb.io_out_bits_fflags_valid
    io_wb_1_bits_fflags_bits = ll_wbarb.io_out_bits_fflags_bits
  } else {
    io_dgen_bits_data = 0
    io_dgen_bits_uop_stq_idx = 0
    io_dgen_valid = 0
    io_dis_uops_0_ready = (1 << C.coreWidth)-1
    io_from_int_ready = 1
    io_to_int_bits_data = 0
    io_to_int_bits_fflags_bits = 0
    io_to_int_bits_fflags_valid = 0
    io_to_int_bits_predicated = 0
    io_to_int_bits_uop_br_mask = 0
    io_to_int_bits_uop_dst_rtype = 0
    io_to_int_bits_uop_pdst = 0
    io_to_int_bits_uop_rob_idx = 0
    io_to_int_valid = 0
    io_wakeups_0_bits_uop_dst_rtype = 0
    io_wakeups_0_bits_uop_pdst = 0
    io_wakeups_0_valid = 0
    io_wakeups_1_bits_uop_dst_rtype = 0
    io_wakeups_1_bits_uop_pdst = 0
    io_wakeups_1_valid = 0
    io_wb_0_bits_fflags_bits = 0
    io_wb_0_bits_fflags_valid = 0
    io_wb_0_bits_uop_pdst = 0
    io_wb_0_bits_uop_rob_idx = 0
    traceData = 0
    io_wb_0_valid = 0
    io_wb_1_bits_fflags_bits = 0
    io_wb_1_bits_fflags_valid = 0
    io_wb_1_bits_predicated = 0
    io_wb_1_bits_uop_pdst = 0
    io_wb_1_bits_uop_rob_idx = 0
    io_wb_1_valid = 0
  }
}
