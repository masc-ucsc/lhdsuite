  io_lsu_dis_uops_0_bits_fp_ctrl_vec = rename_stageFeedback.io_ren2_uops_0_fp_ctrl_vec
  io_lsu_dis_uops_0_bits_rob_idx = robTags
  io_lsu_dis_uops_0_bits_ldq_idx = io_lsu_dis_ldq_idx_0
  io_lsu_dis_uops_0_bits_stq_idx = io_lsu_dis_stq_idx_0
  io_lsu_dis_uops_0_bits_rxq_idx = rename_stageFeedback.io_ren2_uops_0_rxq_idx
  io_lsu_dis_uops_0_bits_pdst = tags.dst
  io_lsu_dis_uops_0_bits_prs1 = tags.src1
  io_lsu_dis_uops_0_bits_prs2 = tags.src2
  io_lsu_dis_uops_0_bits_prs3 = tags.src3
  io_lsu_dis_uops_0_bits_ppred = _pred_rename_stage_io_ren2_uops_0_ppred
  io_lsu_dis_uops_0_bits_prs1_busy = tags.busy1
  io_lsu_dis_uops_0_bits_prs2_busy = tags.busy2
  io_lsu_dis_uops_0_bits_prs3_busy = tags.busy3
  io_lsu_dis_uops_0_bits_ppred_busy = tags.busyPred
  io_lsu_dis_uops_0_bits_stale_pdst = tags.old
  io_lsu_dis_uops_0_bits_exception = rename_stageFeedback.io_ren2_uops_0_exception
  io_lsu_dis_uops_0_bits_exc_cause = rename_stageFeedback.io_ren2_uops_0_exc_cause
  io_lsu_dis_uops_0_bits_mem_cmd = rename_stageFeedback.io_ren2_uops_0_mem_cmd
  io_lsu_dis_uops_0_bits_mem_size = rename_stageFeedback.io_ren2_uops_0_mem_size
  io_lsu_dis_uops_0_bits_mem_signed = rename_stageFeedback.io_ren2_uops_0_mem_signed
  io_lsu_dis_uops_0_bits_uses_ldq = rename_stageFeedback.io_ren2_uops_0_uses_ldq
  io_lsu_dis_uops_0_bits_uses_stq = rename_stageFeedback.io_ren2_uops_0_uses_stq
  io_lsu_dis_uops_0_bits_is_unique = rename_stageFeedback.io_ren2_uops_0_is_unique
  io_lsu_dis_uops_0_bits_flush_on_commit = rename_stageFeedback.io_ren2_uops_0_flush_on_commit
  io_lsu_dis_uops_0_bits_csr_cmd = rename_stageFeedback.io_ren2_uops_0_csr_cmd
  io_lsu_dis_uops_0_bits_ldst_is_rs1 = rename_stageFeedback.io_ren2_uops_0_ldst_is_rs1
  io_lsu_dis_uops_0_bits_ldst = rename_stageFeedback.io_ren2_uops_0_ldst
  io_lsu_dis_uops_0_bits_lrs1 = rename_stageFeedback.io_ren2_uops_0_lrs1
  io_lsu_dis_uops_0_bits_lrs2 = rename_stageFeedback.io_ren2_uops_0_lrs2
  io_lsu_dis_uops_0_bits_lrs3 = rename_stageFeedback.io_ren2_uops_0_lrs3
  io_lsu_dis_uops_0_bits_dst_rtype = rename_stageFeedback.io_ren2_uops_0_dst_rtype
  io_lsu_dis_uops_0_bits_lrs1_rtype = rename_stageFeedback.io_ren2_uops_0_lrs1_rtype
  io_lsu_dis_uops_0_bits_lrs2_rtype = rename_stageFeedback.io_ren2_uops_0_lrs2_rtype
  io_lsu_dis_uops_0_bits_frs3_en = rename_stageFeedback.io_ren2_uops_0_frs3_en
  io_lsu_dis_uops_0_bits_fcn_dw = rename_stageFeedback.io_ren2_uops_0_fcn_dw
  io_lsu_dis_uops_0_bits_fcn_op = rename_stageFeedback.io_ren2_uops_0_fcn_op
  io_lsu_dis_uops_0_bits_fp_val = rename_stageFeedback.io_ren2_uops_0_fp_val
  io_lsu_dis_uops_0_bits_fp_rm = rename_stageFeedback.io_ren2_uops_0_fp_rm
  io_lsu_dis_uops_0_bits_fp_typ = rename_stageFeedback.io_ren2_uops_0_fp_typ
  io_lsu_dis_uops_0_bits_xcpt_pf_if = rename_stageFeedback.io_ren2_uops_0_xcpt_pf_if
  io_lsu_dis_uops_0_bits_xcpt_ae_if = rename_stageFeedback.io_ren2_uops_0_xcpt_ae_if
  io_lsu_dis_uops_0_bits_xcpt_ma_if = rename_stageFeedback.io_ren2_uops_0_xcpt_ma_if
  io_lsu_dis_uops_0_bits_bp_debug_if = rename_stageFeedback.io_ren2_uops_0_bp_debug_if
  io_lsu_dis_uops_0_bits_bp_xcpt_if = rename_stageFeedback.io_ren2_uops_0_bp_xcpt_if
  io_lsu_dis_uops_0_bits_debug_fsrc = rename_stageFeedback.io_ren2_uops_0_debug_fsrc
  io_lsu_dis_uops_0_bits_debug_tsrc = rename_stageFeedback.io_ren2_uops_0_debug_tsrc
  io_lsu_commit_valids_0 = robFeedback.io_commit_valids_0
  io_lsu_commit_uops_0_uses_ldq = rob.io_commit_uops_0_uses_ldq
  io_lsu_commit_uops_0_uses_stq = rob.io_commit_uops_0_uses_stq
  io_lsu_commit_load_at_rob_head = rob.io_com_load_is_at_rob_head
  io_lsu_fence_dmem = dispatch.fence
  io_lsu_brupdate_b1_resolve_mask = b1_resolve_mask__w1
  io_lsu_brupdate_b1_mispredict_mask = branchResult.killed
  io_lsu_brupdate_b2_uop_ldq_idx = io_lsu_brupdate_b2_uop_ldq_idx__w1
  io_lsu_brupdate_b2_uop_stq_idx = io_lsu_brupdate_b2_uop_stq_idx__w1
  io_lsu_brupdate_b2_mispredict = io_lsu_brupdate_b2_mispredict__w1
  triggerTable = csr.triggerTable
  pmpTable = csr.pmpTable
  io_lsu_rob_head_idx = rob.io_rob_head_idx
  io_lsu_exception = io_lsu_exception__w1
  if C.enableTraceCoreIngress {
    comptime const laneBits = std.clog2(C.coreWidth)
    const result = tracePort.TraceIngress<addrBits=C.addrBits, width=C.coreWidth, rows=robRows>(clock, reset=Bool(reset),
        tail=rob.io_rob_tail_idx >> laneBits, head=rob.io_rob_head_idx >> laneBits,
        dispatch=dispatch.fire, retire=rob.io_commit_arch_valids_0, pc=dispatched.debug_pc,
        branch=dispatched.br_type, taken=rob.retiredTaken, compressed=dispatched.is_rvc, returning=dispatched.is_eret,
        trap=rob.io_com_xcpt_valid, trapCause=rob.io_com_xcpt_bits_cause,
        context=(privilege=csr.io_status_prv, context=0, tval=_mux_104, cause=csr_io_cause_REG, time=csr.cycleCount))
    traceGroups = result.groups
    traceContext = result.state
  } else {
    traceGroups = 0
    traceContext = tracePort.emptyContext
  }

  traceEmpty = rob.io_empty
  traceTime = csr.cycleCount
  if C.trace or C.enableCommitLogPrintf or C.enableBranchPrintf {
    comptime const laneBits = std.clog2(C.coreWidth)
    reg fastData:Unsigned(bits=64*(1+alus)) = nil
    fastData = (aluBus.io_alu_resp_bits_data << 64) | ll_arbFeedback.io_out_bits_data
    const secondary = if C.lsuWidth == 2 { loadWB.data << (64*(slowFPPort+1)) } else { 0 }
    const values = iregfile_io_write_ports_0_bits_data_REG | (fastData << 64) |
        (fp_pipeline.traceData << (64*(alus+2))) | secondary
    const observed = retirement.RetireTrace<addrBits=C.addrBits, width=C.coreWidth, rows=robRows, ports=completions>(clock, reset=Bool(reset),
        tail=rob.io_rob_tail_idx >> laneBits, head=rob.io_rob_head_idx >> laneBits,
        dispatch=dispatch.fire, retire=rob.io_commit_arch_valids_0, pc=dispatched.debug_pc,
        instructions=dispatched.debug_inst, compressed=dispatched.is_rvc,
        destType=rob.io_commit_uops_0_dst_rtype, dest=rob.io_commit_uops_0_ldst,
        wb=wbValid, wbTags=wbTags, data=values, debug=csr.io_status_debug, privilege=csr.io_status_prv,
        trap=rob.io_com_xcpt_valid, cause=rob.io_com_xcpt_bits_cause, tval=_mux_104)
    traceEvents = if C.trace { observed.events } else { 0 }
    traceStatus = if C.trace { observed.state } else { retirement.empty }
    logEvents = 0
    if C.enableCommitLogPrintf or C.enableBranchPrintf {
      reg previousPrivilege:U2 = nil
      reg retiringPrivilege:U2 = nil
      previousPrivilege = csr.io_status_prv
      retiringPrivilege = previousPrivilege
      for lane in 0..<C.coreWidth {
        const branch = rob.io_commit_uops_0_br_type#[(4*lane)..+4]
        const source = rob.io_commit_uops_0_debug_fsrc#[(3*lane)..+3]
        const kind = rob.io_commit_uops_0_dst_rtype#[(2*lane)..+2]
        const dest = rob.io_commit_uops_0_ldst#[(6*lane)..+6]
        reg details:U18 = nil
        details = (rob.retiredTaken#[lane] << 17) | (source << 14) | (branch << 10) |
                  (dest << 4) | (kind << 2) | retiringPrivilege
        logEvents#[(179*lane)..+179] = (details << 161) | observed.events#[(161*lane)..+161]
      }
    }
  } else {
    logEvents = 0
    traceEvents = 0
    traceStatus = retirement.empty
  }

}
