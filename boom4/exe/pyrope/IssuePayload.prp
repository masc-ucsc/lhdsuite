type Uop<ftqBits, pregBits, robBits, alus, branches, ldBits, stBits, immBits, addrBits> = (
    inst:U32,
    debug_inst:U32,
    is_rvc:U1,
    debug_pc:Unsigned(bits=addrBits),
    iq_type_0:U1,
    iq_type_1:U1,
    iq_type_2:U1,
    iq_type_3:U1,
    fu_code_0:U1,
    fu_code_1:U1,
    fu_code_2:U1,
    fu_code_3:U1,
    fu_code_4:U1,
    fu_code_5:U1,
    fu_code_6:U1,
    fu_code_7:U1,
    fu_code_8:U1,
    fu_code_9:U1,
    iw_issued:U1,
    iw_p1_speculative_child:Unsigned(bits=alus),
    iw_p2_speculative_child:Unsigned(bits=alus),
    iw_p1_bypass_hint:U1,
    iw_p2_bypass_hint:U1,
    iw_p3_bypass_hint:U1,
    dis_col_sel:U1,
    br_mask:Unsigned(bits=branches),
    br_tag:Unsigned(bits=std.clog2(branches)),
    br_type:U4,
    is_sfb:U1,
    is_fence:U1,
    is_fencei:U1,
    is_sfence:U1,
    is_amo:U1,
    is_eret:U1,
    is_sys_pc2epc:U1,
    is_rocc:U1,
    is_mov:U1,
    ftq_idx:Unsigned(bits=ftqBits),
    edge_inst:U1,
    pc_lob:U6,
    taken:U1,
    imm_rename:U1,
    imm_sel:U3,
    pimm:Unsigned(bits=immBits),
    imm_packed:U20,
    op1_sel:U2,
    op2_sel:U3,
    fp_ctrl_ldst:U1,
    fp_ctrl_wen:U1,
    fp_ctrl_ren1:U1,
    fp_ctrl_ren2:U1,
    fp_ctrl_ren3:U1,
    fp_ctrl_swap12:U1,
    fp_ctrl_swap23:U1,
    fp_ctrl_typeTagIn:U2,
    fp_ctrl_typeTagOut:U2,
    fp_ctrl_fromint:U1,
    fp_ctrl_toint:U1,
    fp_ctrl_fastpipe:U1,
    fp_ctrl_fma:U1,
    fp_ctrl_div:U1,
    fp_ctrl_sqrt:U1,
    fp_ctrl_wflags:U1,
    fp_ctrl_vec:U1,
    rob_idx:Unsigned(bits=robBits),
    ldq_idx:Unsigned(bits=ldBits),
    stq_idx:Unsigned(bits=stBits),
    rxq_idx:U2,
    pdst:Unsigned(bits=pregBits),
    prs1:Unsigned(bits=pregBits),
    prs2:Unsigned(bits=pregBits),
    prs3:Unsigned(bits=pregBits),
    ppred:Unsigned(bits=ftqBits),
    prs1_busy:U1,
    prs2_busy:U1,
    prs3_busy:U1,
    ppred_busy:U1,
    stale_pdst:Unsigned(bits=pregBits),
    exception:U1,
    exc_cause:U64,
    mem_cmd:U5,
    mem_size:U2,
    mem_signed:U1,
    uses_ldq:U1,
    uses_stq:U1,
    is_unique:U1,
    flush_on_commit:U1,
    csr_cmd:U3,
    ldst_is_rs1:U1,
    ldst:U6,
    lrs1:U6,
    lrs2:U6,
    lrs3:U6,
    dst_rtype:U2,
    lrs1_rtype:U2,
    lrs2_rtype:U2,
    frs3_en:U1,
    fcn_dw:U1,
    fcn_op:U5,
    fp_val:U1,
    fp_rm:U3,
    fp_typ:U2,
    xcpt_pf_if:U1,
    xcpt_ae_if:U1,
    xcpt_ma_if:U1,
    bp_debug_if:U1,
    bp_xcpt_if:U1,
    debug_fsrc:U3,
    debug_tsrc:U3)

pub comptime const fixedBits = 294
pub comb pack<ftqBits=4, pregBits=6, robBits=5, alus=1, branches=8, ldBits=4, stBits=4, immBits=5, addrBits=40>(uop:Uop<ftqBits, pregBits, robBits, alus, branches, ldBits, stBits, immBits, addrBits>) -> (value:Unsigned(bits=ldBits + stBits + branches + std.clog2(branches) + immBits + fixedBits + addrBits + 2*alus + 2*ftqBits + 5*pregBits + robBits)) {
  value = (uop.inst, uop.debug_inst, uop.is_rvc, uop.debug_pc,
           uop.iq_type_0, uop.iq_type_1, uop.iq_type_2, uop.iq_type_3,
           uop.fu_code_0, uop.fu_code_1, uop.fu_code_2, uop.fu_code_3,
           uop.fu_code_4, uop.fu_code_5, uop.fu_code_6, uop.fu_code_7,
           uop.fu_code_8, uop.fu_code_9, uop.iw_issued, uop.iw_p1_bypass_hint, uop.iw_p2_bypass_hint, uop.iw_p3_bypass_hint,
           uop.dis_col_sel, uop.br_type,
           uop.is_sfb, uop.is_fence, uop.is_fencei, uop.is_sfence,
           uop.is_amo, uop.is_eret, uop.is_sys_pc2epc, uop.is_rocc,
           uop.is_mov, uop.edge_inst, uop.pc_lob,
           uop.taken, uop.imm_rename, uop.imm_sel,
           uop.imm_packed, uop.op1_sel, uop.op2_sel, uop.fp_ctrl_ldst,
           uop.fp_ctrl_wen, uop.fp_ctrl_ren1, uop.fp_ctrl_ren2, uop.fp_ctrl_ren3,
           uop.fp_ctrl_swap12, uop.fp_ctrl_swap23, uop.fp_ctrl_typeTagIn, uop.fp_ctrl_typeTagOut,
           uop.fp_ctrl_fromint, uop.fp_ctrl_toint, uop.fp_ctrl_fastpipe, uop.fp_ctrl_fma,
           uop.fp_ctrl_div, uop.fp_ctrl_sqrt, uop.fp_ctrl_wflags, uop.fp_ctrl_vec,
           uop.rxq_idx,
           uop.prs1_busy, uop.prs2_busy, uop.prs3_busy,
           uop.ppred_busy, uop.exception, uop.exc_cause,
           uop.mem_cmd, uop.mem_size, uop.mem_signed, uop.uses_ldq,
           uop.uses_stq, uop.is_unique, uop.flush_on_commit, uop.csr_cmd,
           uop.ldst_is_rs1, uop.ldst, uop.lrs1, uop.lrs2,
           uop.lrs3, uop.dst_rtype, uop.lrs1_rtype, uop.lrs2_rtype,
           uop.frs3_en, uop.fcn_dw, uop.fcn_op, uop.fp_val,
           uop.fp_rm, uop.fp_typ, uop.xcpt_pf_if, uop.xcpt_ae_if,
           uop.xcpt_ma_if, uop.bp_debug_if, uop.bp_xcpt_if, uop.debug_fsrc,
           uop.debug_tsrc, uop.pimm, uop.iw_p1_speculative_child, uop.iw_p2_speculative_child, uop.ppred, uop.ftq_idx,
           uop.pdst, uop.prs1, uop.prs2, uop.prs3, uop.stale_pdst, uop.rob_idx, uop.br_mask, uop.br_tag, uop.ldq_idx, uop.stq_idx)#[..]
}
pub comb unpack<ftqBits=4, pregBits=6, robBits=5, alus=1, branches=8, ldBits=4, stBits=4, immBits=5, addrBits=40>(value:Unsigned(bits=ldBits + stBits + branches + std.clog2(branches) + immBits + fixedBits + addrBits + 2*alus + 2*ftqBits + 5*pregBits + robBits)) -> (uop:Uop<ftqBits, pregBits, robBits, alus, branches, ldBits, stBits, immBits, addrBits>) {
  const fields = value >> (65+addrBits)
  uop.inst = value#[0..+32]
  uop.debug_inst = value#[32..+32]
  uop.is_rvc = value#[64..+1]
  uop.debug_pc = value#[65..+addrBits]
  uop.iq_type_0 = fields#[0..+1]
  uop.iq_type_1 = fields#[1..+1]
  uop.iq_type_2 = fields#[2..+1]
  uop.iq_type_3 = fields#[3..+1]
  uop.fu_code_0 = fields#[4..+1]
  uop.fu_code_1 = fields#[5..+1]
  uop.fu_code_2 = fields#[6..+1]
  uop.fu_code_3 = fields#[7..+1]
  uop.fu_code_4 = fields#[8..+1]
  uop.fu_code_5 = fields#[9..+1]
  uop.fu_code_6 = fields#[10..+1]
  uop.fu_code_7 = fields#[11..+1]
  uop.fu_code_8 = fields#[12..+1]
  uop.fu_code_9 = fields#[13..+1]
  uop.iw_issued = fields#[14..+1]
  uop.iw_p1_speculative_child = fields#[(fixedBits-65+immBits)..+alus]
  uop.iw_p2_speculative_child = fields#[(fixedBits-65+immBits+alus)..+alus]
  uop.iw_p1_bypass_hint = fields#[15..+1]
  uop.iw_p2_bypass_hint = fields#[16..+1]
  uop.iw_p3_bypass_hint = fields#[17..+1]
  uop.dis_col_sel = fields#[18..+1]
  uop.br_mask = fields#[(fixedBits-65+immBits + 2*alus + 2*ftqBits + 5*pregBits + robBits)..+branches]
  uop.br_tag = fields#[(fixedBits-65+immBits + 2*alus + 2*ftqBits + 5*pregBits + robBits + branches)..+std.clog2(branches)]
  uop.br_type = fields#[19..+4]
  uop.is_sfb = fields#[23..+1]
  uop.is_fence = fields#[24..+1]
  uop.is_fencei = fields#[25..+1]
  uop.is_sfence = fields#[26..+1]
  uop.is_amo = fields#[27..+1]
  uop.is_eret = fields#[28..+1]
  uop.is_sys_pc2epc = fields#[29..+1]
  uop.is_rocc = fields#[30..+1]
  uop.is_mov = fields#[31..+1]
  uop.ftq_idx = fields#[(fixedBits-65+immBits+2*alus+ftqBits)..+ftqBits]
  uop.edge_inst = fields#[32..+1]
  uop.pc_lob = fields#[33..+6]
  uop.taken = fields#[39..+1]
  uop.imm_rename = fields#[40..+1]
  uop.imm_sel = fields#[41..+3]
  uop.pimm = fields#[(fixedBits-65)..+immBits]
  uop.imm_packed = fields#[44..+20]
  uop.op1_sel = fields#[64..+2]
  uop.op2_sel = fields#[66..+3]
  uop.fp_ctrl_ldst = fields#[69..+1]
  uop.fp_ctrl_wen = fields#[70..+1]
  uop.fp_ctrl_ren1 = fields#[71..+1]
  uop.fp_ctrl_ren2 = fields#[72..+1]
  uop.fp_ctrl_ren3 = fields#[73..+1]
  uop.fp_ctrl_swap12 = fields#[74..+1]
  uop.fp_ctrl_swap23 = fields#[75..+1]
  uop.fp_ctrl_typeTagIn = fields#[76..+2]
  uop.fp_ctrl_typeTagOut = fields#[78..+2]
  uop.fp_ctrl_fromint = fields#[80..+1]
  uop.fp_ctrl_toint = fields#[81..+1]
  uop.fp_ctrl_fastpipe = fields#[82..+1]
  uop.fp_ctrl_fma = fields#[83..+1]
  uop.fp_ctrl_div = fields#[84..+1]
  uop.fp_ctrl_sqrt = fields#[85..+1]
  uop.fp_ctrl_wflags = fields#[86..+1]
  uop.fp_ctrl_vec = fields#[87..+1]
  uop.rob_idx = fields#[(fixedBits-65+immBits+2*alus+2*ftqBits+5*pregBits)..+robBits]
  uop.ldq_idx = fields#[(fixedBits-65+immBits + 2*alus + 2*ftqBits + 5*pregBits + robBits + branches + std.clog2(branches))..+ldBits]
  uop.stq_idx = fields#[(fixedBits-65+immBits + 2*alus + 2*ftqBits + 5*pregBits + robBits + branches + std.clog2(branches) + ldBits)..+stBits]
  uop.rxq_idx = fields#[88..+2]
  uop.pdst = fields#[(fixedBits-65+immBits+2*alus+2*ftqBits+0*pregBits)..+pregBits]
  uop.prs1 = fields#[(fixedBits-65+immBits+2*alus+2*ftqBits+1*pregBits)..+pregBits]
  uop.prs2 = fields#[(fixedBits-65+immBits+2*alus+2*ftqBits+2*pregBits)..+pregBits]
  uop.prs3 = fields#[(fixedBits-65+immBits+2*alus+2*ftqBits+3*pregBits)..+pregBits]
  uop.ppred = fields#[(fixedBits-65+immBits+2*alus)..+ftqBits]
  uop.prs1_busy = fields#[90..+1]
  uop.prs2_busy = fields#[91..+1]
  uop.prs3_busy = fields#[92..+1]
  uop.ppred_busy = fields#[93..+1]
  uop.stale_pdst = fields#[(fixedBits-65+immBits+2*alus+2*ftqBits+4*pregBits)..+pregBits]
  uop.exception = fields#[94..+1]
  uop.exc_cause = fields#[95..+64]
  uop.mem_cmd = fields#[159..+5]
  uop.mem_size = fields#[164..+2]
  uop.mem_signed = fields#[166..+1]
  uop.uses_ldq = fields#[167..+1]
  uop.uses_stq = fields#[168..+1]
  uop.is_unique = fields#[169..+1]
  uop.flush_on_commit = fields#[170..+1]
  uop.csr_cmd = fields#[171..+3]
  uop.ldst_is_rs1 = fields#[174..+1]
  uop.ldst = fields#[175..+6]
  uop.lrs1 = fields#[181..+6]
  uop.lrs2 = fields#[187..+6]
  uop.lrs3 = fields#[193..+6]
  uop.dst_rtype = fields#[199..+2]
  uop.lrs1_rtype = fields#[201..+2]
  uop.lrs2_rtype = fields#[203..+2]
  uop.frs3_en = fields#[205..+1]
  uop.fcn_dw = fields#[206..+1]
  uop.fcn_op = fields#[207..+5]
  uop.fp_val = fields#[212..+1]
  uop.fp_rm = fields#[213..+3]
  uop.fp_typ = fields#[216..+2]
  uop.xcpt_pf_if = fields#[218..+1]
  uop.xcpt_ae_if = fields#[219..+1]
  uop.xcpt_ma_if = fields#[220..+1]
  uop.bp_debug_if = fields#[221..+1]
  uop.bp_xcpt_if = fields#[222..+1]
  uop.debug_fsrc = fields#[223..+3]
  uop.debug_tsrc = fields#[226..+3]
}
