const configs = import("../../common/pyrope/BoomConfig")
const MulDiv = import("MulDiv.MulDiv")

pub mod DivUnit<mulDiv=configs.defaultMulDiv, pregBits=6, robBits=5, branches=8>::[timecheck=false](clock:Clock, io_brupdate_b1_mispredict_mask:Unsigned(bits=branches), io_brupdate_b1_resolve_mask:Unsigned(bits=branches), io_kill:U1, io_req_bits_rs1_data:U64, io_req_bits_rs2_data:U64, io_req_bits_uop_br_mask:Unsigned(bits=branches), io_req_bits_uop_dst_rtype:U2, io_req_bits_uop_fcn_dw:U1, io_req_bits_uop_fcn_op:U5, io_req_bits_uop_pdst:Unsigned(bits=pregBits), io_req_bits_uop_rob_idx:Unsigned(bits=robBits), io_req_valid:U1, io_resp_ready:U1, reset:U1) -> (io_req_ready:U1@[], io_resp_bits_data:U64@[], io_resp_bits_uop_br_mask:Unsigned(bits=branches)@[], io_resp_bits_uop_dst_rtype:U2@[], io_resp_bits_uop_pdst:Unsigned(bits=pregBits)@[], io_resp_bits_uop_rob_idx:Unsigned(bits=robBits)@[], io_resp_valid:U1@[]) {
  reg req_valid:U1
  reg req_bits_br_mask:Unsigned(bits=branches)
  reg req_bits_rob_idx:Unsigned(bits=robBits)
  reg req_bits_pdst:Unsigned(bits=pregBits)
  reg req_bits_dst_rtype:U2
  mut _b2i_2 = U1((io_brupdate_b1_mispredict_mask & req_bits_br_mask) != 0)
  mut div = MulDiv<cfg=mulDiv>(clock=clock, reset=reset, io_req_valid=io_req_valid & (~((U1((io_brupdate_b1_mispredict_mask & io_req_bits_uop_br_mask) != 0) | io_kill) & 1)#[0]) & 1, io_req_bits_fn=io_req_bits_uop_fcn_op, io_req_bits_dw=io_req_bits_uop_fcn_dw, io_req_bits_in1=io_req_bits_rs1_data, io_req_bits_in2=io_req_bits_rs2_data, io_kill=req_valid & (_b2i_2 | io_kill) & 1, io_resp_ready=io_resp_ready)
  const io_resp_bits_uop_br_mask__w1 = req_bits_br_mask
  const io_resp_bits_uop_rob_idx__w1 = req_bits_rob_idx
  const io_resp_bits_uop_pdst__w1 = req_bits_pdst
  const io_resp_bits_uop_dst_rtype__w1 = req_bits_dst_rtype
  const io_req_ready_0__w1 = div.io_req_ready & (~req_valid) & 1
  const io_resp_valid_0__w1 = div.io_resp_valid & req_valid & 1
  const _GEN__w1 = io_req_ready_0__w1 & io_req_valid & 1
  mut _b2i_4 = U1((io_brupdate_b1_mispredict_mask & req_bits_br_mask) != 0)
  mut _mux_5:U1 = if _GEN__w1 != 0 {
    ~((U1((io_brupdate_b1_mispredict_mask & io_req_bits_uop_br_mask) != 0) | io_kill) & 1)#[0]
  } else {
    (~((_b2i_4 | io_kill) & 1)#[0]) & req_valid & 1
  }
  req_valid = (~(((io_resp_ready & io_resp_valid_0__w1 & 1) | reset) & 1)#[0]) & _mux_5 & 1
  mut _mux_6:Unsigned(bits=branches) = if _GEN__w1 != 0 { (io_req_bits_uop_br_mask & (~io_brupdate_b1_resolve_mask)) }
    else { (req_bits_br_mask & (~io_brupdate_b1_resolve_mask)) }
  req_bits_br_mask = _mux_6
  if _GEN__w1 != 0 {
    req_bits_rob_idx = io_req_bits_uop_rob_idx
    req_bits_pdst = io_req_bits_uop_pdst
    req_bits_dst_rtype = io_req_bits_uop_dst_rtype
  }
  io_req_ready = io_req_ready_0__w1
  io_resp_valid = io_resp_valid_0__w1
  io_resp_bits_uop_br_mask = io_resp_bits_uop_br_mask__w1
  io_resp_bits_uop_rob_idx = io_resp_bits_uop_rob_idx__w1
  io_resp_bits_uop_pdst = io_resp_bits_uop_pdst__w1
  io_resp_bits_uop_dst_rtype = io_resp_bits_uop_dst_rtype__w1
  io_resp_bits_data = div.io_resp_bits_data
}
