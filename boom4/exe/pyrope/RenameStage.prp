  io_ren2_uops_0_fu_code_7:Unsigned(bits=width)@[],
  io_ren2_uops_0_fu_code_8:Unsigned(bits=width)@[],
  io_ren2_uops_0_fu_code_9:Unsigned(bits=width)@[],
  io_ren2_uops_0_iw_issued:Unsigned(bits=width)@[],
  io_ren2_uops_0_iw_issued_partial_agen:Unsigned(bits=width)@[],
  io_ren2_uops_0_iw_issued_partial_dgen:Unsigned(bits=width)@[],
  io_ren2_uops_0_iw_p1_bypass_hint:Unsigned(bits=width)@[],
  io_ren2_uops_0_iw_p2_bypass_hint:Unsigned(bits=width)@[],
  io_ren2_uops_0_iw_p3_bypass_hint:Unsigned(bits=width)@[],
  io_ren2_uops_0_br_mask:Unsigned(bits=width*branches)@[],
  io_ren2_uops_0_br_tag:Unsigned(bits=width*std.clog2(branches))@[],
  io_ren2_uops_0_br_type:Unsigned(bits=width*4)@[],
  io_ren2_uops_0_is_sfb:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_fence:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_fencei:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_sfence:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_amo:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_eret:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_sys_pc2epc:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_rocc:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_mov:Unsigned(bits=width)@[],
  io_ren2_uops_0_ftq_idx:Unsigned(bits=width*ftqBits)@[],
  io_ren2_uops_0_edge_inst:Unsigned(bits=width)@[],
  io_ren2_uops_0_pc_lob:Unsigned(bits=width*6)@[],
  io_ren2_uops_0_taken:Unsigned(bits=width)@[],
  io_ren2_uops_0_imm_rename:Unsigned(bits=width)@[],
  io_ren2_uops_0_imm_packed:Unsigned(bits=width*20)@[],
  io_ren2_uops_0_op1_sel:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_op2_sel:Unsigned(bits=width*3)@[],
  io_ren2_uops_0_fp_ctrl_ldst:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_wen:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_ren1:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_ren2:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_ren3:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_swap12:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_swap23:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_typeTagIn:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_fp_ctrl_typeTagOut:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_fp_ctrl_fromint:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_toint:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_fastpipe:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_fma:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_div:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_sqrt:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_ctrl_wflags:Unsigned(bits=width)@[],
