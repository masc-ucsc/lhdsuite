  io_dec_uops_0_fp_ctrl_fma:Unsigned(bits=width),
  io_dec_uops_0_fp_ctrl_div:Unsigned(bits=width),
  io_dec_uops_0_fp_ctrl_sqrt:Unsigned(bits=width),
  io_dec_uops_0_fp_ctrl_wflags:Unsigned(bits=width),
