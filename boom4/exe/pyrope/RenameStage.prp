  io_dec_uops_0_xcpt_pf_if:Unsigned(bits=width),
  io_dec_uops_0_xcpt_ae_if:Unsigned(bits=width),
  io_dec_uops_0_bp_debug_if:Unsigned(bits=width),
  io_dec_uops_0_bp_xcpt_if:Unsigned(bits=width),
  io_dec_uops_0_debug_fsrc:Unsigned(bits=width*3),
  io_brupdate_b1_resolve_mask:Unsigned(bits=branches),
  io_brupdate_b2_uop_br_tag:Unsigned(bits=std.clog2(branches)),
  io_brupdate_b2_mispredict:U1,
  io_dis_fire_0:Unsigned(bits=width),
  io_dis_ready:U1,
  io_wakeups_0_valid:U1,
  io_wakeups_0_bits_uop_pdst:Unsigned(bits=std.clog2(physical)),
