  io_ren2_uops_0_prs1_busy:Unsigned(bits=width)@[],
  io_ren2_uops_0_prs2_busy:Unsigned(bits=width)@[],
  io_ren2_uops_0_stale_pdst:Unsigned(bits=width*std.clog2(physical))@[],
  io_ren2_uops_0_exception:Unsigned(bits=width)@[],
  io_ren2_uops_0_exc_cause:Unsigned(bits=width*64)@[],
  io_ren2_uops_0_mem_cmd:Unsigned(bits=width*5)@[],
  io_ren2_uops_0_mem_size:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_mem_signed:Unsigned(bits=width)@[],
  io_ren2_uops_0_uses_ldq:Unsigned(bits=width)@[],
  io_ren2_uops_0_uses_stq:Unsigned(bits=width)@[],
  io_ren2_uops_0_is_unique:Unsigned(bits=width)@[],
  io_ren2_uops_0_flush_on_commit:Unsigned(bits=width)@[],
  io_ren2_uops_0_csr_cmd:Unsigned(bits=width*3)@[],
  io_ren2_uops_0_ldst_is_rs1:Unsigned(bits=width)@[],
  io_ren2_uops_0_ldst:Unsigned(bits=width*6)@[],
  io_ren2_uops_0_lrs1:Unsigned(bits=width*6)@[],
  io_ren2_uops_0_lrs2:Unsigned(bits=width*6)@[],
  io_ren2_uops_0_lrs3:Unsigned(bits=width*6)@[],
  io_ren2_uops_0_dst_rtype:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_lrs1_rtype:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_lrs2_rtype:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_frs3_en:Unsigned(bits=width)@[],
  io_ren2_uops_0_fcn_dw:Unsigned(bits=width)@[],
  io_ren2_uops_0_fcn_op:Unsigned(bits=width*5)@[],
  io_ren2_uops_0_fp_val:Unsigned(bits=width)@[],
  io_ren2_uops_0_fp_rm:Unsigned(bits=width*3)@[],
  io_ren2_uops_0_fp_typ:Unsigned(bits=width*2)@[],
  io_ren2_uops_0_xcpt_pf_if:Unsigned(bits=width)@[],
  io_ren2_uops_0_xcpt_ae_if:Unsigned(bits=width)@[],
  io_ren2_uops_0_xcpt_ma_if:Unsigned(bits=width)@[],
  io_ren2_uops_0_bp_debug_if:Unsigned(bits=width)@[],
  io_ren2_uops_0_bp_xcpt_if:Unsigned(bits=width)@[],
  io_ren2_uops_0_debug_fsrc:Unsigned(bits=width*3)@[],
  io_ren2_uops_0_debug_tsrc:Unsigned(bits=width*3)@[],
) {
  comptime const bits = std.clog2(physical)
  comptime const wakePorts = 3 + alus
  mut parents:Unsigned(bits=(3+alus)*alus) = 0
  for i in 0..<alus {
    parents#[(2+i)*alus+i] = 1
  }
  const regs = rename<
    aluWidth=alus,
    banked=banked,
    branches=branches,
    float=false,
    physical=physical,
    ports=wakePorts,
    width=width,
  >(
    clock=clock,
    reset=reset,
    kill=io_kill,
    ready=io_dis_ready,
    decode=io_dec_fire_0,
    dispatch=io_dis_fire_0,
    rs1=io_dec_uops_0_lrs1,
    rs2=io_dec_uops_0_lrs2,
    rs3=io_dec_uops_0_lrs3,
    rd=io_dec_uops_0_ldst,
    src1Type=io_dec_uops_0_lrs1_rtype,
    src2Type=io_dec_uops_0_lrs2_rtype,
    src3En=io_dec_uops_0_frs3_en,
    dstType=io_dec_uops_0_dst_rtype,
    brType=io_dec_uops_0_br_type,
    sfb=io_dec_uops_0_is_sfb,
    brTag=io_dec_uops_0_br_tag,
    mispredict=io_brupdate_b2_mispredict,
    recover=io_brupdate_b2_uop_br_tag,
    rollback=io_rollback,
    commit=io_com_valids_0,
    comRd=io_com_uops_0_ldst,
    comType=io_com_uops_0_dst_rtype,
    comDest=io_com_uops_0_pdst,
    comStale=io_com_uops_0_stale_pdst,
    wake=io_wakeups_0_valid | (io_wakeups_1_valid << 1) | (io_wakeups_2_valid << 2) | (loadDone << (2+alus)),
    wakeDest=io_wakeups_0_bits_uop_pdst | (
        io_wakeups_1_bits_uop_pdst << (1*bits)
      ) | (io_wakeups_2_bits_uop_pdst << (2*bits)) | (loadDest << ((2+alus)*bits)),
    rebusy=io_wakeups_0_bits_rebusy,
    speculative=parents,
    children=io_child_rebusys,
  )
  io_ren_stalls_0 = regs.stall
  io_ren2_mask_0  = regs.valid
  reg payload:(
    inst:Unsigned(bits=width*32),
    debug_inst:Unsigned(bits=width*32),
    is_rvc:Unsigned(bits=width*1),
    debug_pc:Unsigned(bits=width*addrBits),
    iq_type_0:Unsigned(bits=width*1),
    iq_type_1:Unsigned(bits=width*1),
    iq_type_2:Unsigned(bits=width*1),
    iq_type_3:Unsigned(bits=width*1),
    fu_code_0:Unsigned(bits=width*1),
    fu_code_1:Unsigned(bits=width*1),
    fu_code_2:Unsigned(bits=width*1),
    fu_code_3:Unsigned(bits=width*1),
    fu_code_4:Unsigned(bits=width*1),
    fu_code_5:Unsigned(bits=width*1),
    fu_code_6:Unsigned(bits=width*1),
    fu_code_7:Unsigned(bits=width*1),
    fu_code_8:Unsigned(bits=width*1),
    fu_code_9:Unsigned(bits=width*1),
    br_tag:Unsigned(bits=width*std.clog2(branches)),
    br_type:Unsigned(bits=width*4),
    is_sfb:Unsigned(bits=width*1),
    is_fence:Unsigned(bits=width*1),
    is_fencei:Unsigned(bits=width*1),
    is_sfence:Unsigned(bits=width*1),
    is_amo:Unsigned(bits=width*1),
    is_eret:Unsigned(bits=width*1),
    is_sys_pc2epc:Unsigned(bits=width*1),
    is_rocc:Unsigned(bits=width*1),
    is_mov:Unsigned(bits=width*1),
    ftq_idx:Unsigned(bits=width*ftqBits),
    edge_inst:Unsigned(bits=width*1),
    pc_lob:Unsigned(bits=width*6),
    taken:Unsigned(bits=width*1),
    imm_rename:Unsigned(bits=width*1),
    imm_packed:Unsigned(bits=width*20),
    op1_sel:Unsigned(bits=width*2),
    op2_sel:Unsigned(bits=width*3),
    fp_ctrl_ldst:Unsigned(bits=width*1),
    fp_ctrl_wen:Unsigned(bits=width*1),
    fp_ctrl_ren1:Unsigned(bits=width*1),
    fp_ctrl_ren2:Unsigned(bits=width*1),
    fp_ctrl_ren3:Unsigned(bits=width*1),
    fp_ctrl_swap12:Unsigned(bits=width*1),
    fp_ctrl_swap23:Unsigned(bits=width*1),
    fp_ctrl_typeTagIn:Unsigned(bits=width*2),
    fp_ctrl_typeTagOut:Unsigned(bits=width*2),
    fp_ctrl_fromint:Unsigned(bits=width*1),
    fp_ctrl_toint:Unsigned(bits=width*1),
    fp_ctrl_fastpipe:Unsigned(bits=width*1),
    fp_ctrl_fma:Unsigned(bits=width*1),
    fp_ctrl_div:Unsigned(bits=width*1),
    fp_ctrl_sqrt:Unsigned(bits=width*1),
    fp_ctrl_wflags:Unsigned(bits=width*1),
    exception:Unsigned(bits=width*1),
    exc_cause:Unsigned(bits=width*64),
    mem_cmd:Unsigned(bits=width*5),
    mem_size:Unsigned(bits=width*2),
    mem_signed:Unsigned(bits=width*1),
    uses_ldq:Unsigned(bits=width*1),
    uses_stq:Unsigned(bits=width*1),
    is_unique:Unsigned(bits=width*1),
    flush_on_commit:Unsigned(bits=width*1),
    csr_cmd:Unsigned(bits=width*3),
    ldst_is_rs1:Unsigned(bits=width*1),
    ldst:Unsigned(bits=width*6),
    lrs1:Unsigned(bits=width*6),
    lrs2:Unsigned(bits=width*6),
    lrs3:Unsigned(bits=width*6),
    dst_rtype:Unsigned(bits=width*2),
    lrs1_rtype:Unsigned(bits=width*2),
    lrs2_rtype:Unsigned(bits=width*2),
    frs3_en:Unsigned(bits=width*1),
    fcn_dw:Unsigned(bits=width*1),
    fcn_op:Unsigned(bits=width*5),
    fp_val:Unsigned(bits=width*1),
    fp_rm:Unsigned(bits=width*3),
    fp_typ:Unsigned(bits=width*2),
    xcpt_pf_if:Unsigned(bits=width*1),
    xcpt_ae_if:Unsigned(bits=width*1),
    bp_debug_if:Unsigned(bits=width*1),
    bp_xcpt_if:Unsigned(bits=width*1),
    debug_fsrc:Unsigned(bits=width*3),
  ) = nil
  const take = io_dis_ready != 0 and io_kill == 0
  if take {
    payload = (
      bp_debug_if=io_dec_uops_0_bp_debug_if,
      bp_xcpt_if=io_dec_uops_0_bp_xcpt_if,
      br_tag=io_dec_uops_0_br_tag,
      br_type=io_dec_uops_0_br_type,
      csr_cmd=io_dec_uops_0_csr_cmd,
