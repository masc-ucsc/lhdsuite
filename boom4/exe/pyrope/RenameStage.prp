  io_wakeups_2_bits_uop_dst_rtype:Unsigned(bits=2*alus),
  io_child_rebusys:Unsigned(bits=alus),
  io_com_valids_0:Unsigned(bits=width),
  io_com_uops_0_pdst:Unsigned(bits=width*std.clog2(physical)),
  io_com_uops_0_stale_pdst:Unsigned(bits=width*std.clog2(physical)),
  io_com_uops_0_ldst:Unsigned(bits=width*6),
  io_com_uops_0_dst_rtype:Unsigned(bits=width*2),
  io_rollback:U1,
) -> (
  io_ren_stalls_0:Unsigned(bits=width)@[],
  io_ren2_mask_0:Unsigned(bits=width)@[],
  io_ren2_uops_0_inst:Unsigned(bits=width*32)@[],
  io_ren2_uops_0_debug_inst:Unsigned(bits=width*32)@[],
  io_ren2_uops_0_is_rvc:Unsigned(bits=width)@[],
  io_ren2_uops_0_debug_pc:Unsigned(bits=width*addrBits)@[],
  io_ren2_uops_0_iq_type_0:Unsigned(bits=width)@[],
  io_ren2_uops_0_iq_type_1:Unsigned(bits=width)@[],
  io_ren2_uops_0_iq_type_2:Unsigned(bits=width)@[],
