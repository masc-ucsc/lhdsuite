// All queues must have capacity for a lane. A micro-op may target several
// queues, each of which receives the same renamed payload.
pub comb BasicDispatcher<width=1>(valid:Unsigned(bits=width),
    memType:Unsigned(bits=width), memReady:Unsigned(bits=width),
    unqType:Unsigned(bits=width), unqReady:Unsigned(bits=width),
    aluType:Unsigned(bits=width), aluReady:Unsigned(bits=width),
    fpType:Unsigned(bits=width), fpReady:Unsigned(bits=width)) ->
    (ready:Unsigned(bits=width), mem:Unsigned(bits=width), unq:Unsigned(bits=width),
     alu:Unsigned(bits=width), fp:Unsigned(bits=width)) {
  ready = memReady & unqReady & aluReady & fpReady
  mem = valid & memType
  unq = valid & unqType
  alu = valid & aluType
  fp = valid & fpType
}
