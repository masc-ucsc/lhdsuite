// GlobalHistory.update uses the same circular pointer at fetch, FTQ replay
// and backend redirect. Chisel allocates at least two entries.
pub comb RasIndex<entries>(index:Unsigned(bits=std.clog2(entries))) -> (
  push:Unsigned(bits=std.clog2(entries)), pop:Unsigned(bits=std.clog2(entries)),
) {
  cassert(entries >= 2)
  wrap push = if index == entries - 1 { 0 } else { index + 1 }
  wrap pop = if index == 0 { entries - 1 } else { index - 1 }
}
