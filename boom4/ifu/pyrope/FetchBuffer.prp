const rows = import("FetchRows.FetchRows")

pub mod FetchBuffer<entries=8, fetchWidth=4, decodeWidth=1, ftqBits=4, banks=1, addrBits=40>(clock:Clock, reset:U1, io_enq_valid:U1, io_deq_ready:U1, io_clear:U1, pcBase:Unsigned(bits=addrBits), bankEdges:Unsigned(bits=banks), mask:Unsigned(bits=fetchWidth), raw:Unsigned(bits=32*fetchWidth), expanded:Unsigned(bits=32*fetchWidth), sfbs:Unsigned(bits=fetchWidth), shadowed:Unsigned(bits=fetchWidth), debug:Unsigned(bits=fetchWidth), exceptions:Unsigned(bits=fetchWidth), cfiValid:U1, cfiLane:Unsigned(bits=std.clog2(fetchWidth)), ftqIdx:Unsigned(bits=ftqBits), pageFault:U1, accessFault:U1, source:U3) -> (io_deq_valid:U1@[], io_enq_ready:U1@[], lanes:Unsigned(bits=decodeWidth)@[], row_bp_debug_if:Unsigned(bits=decodeWidth*1)@[], row_bp_xcpt_if:Unsigned(bits=decodeWidth*1)@[], row_debug_fsrc:Unsigned(bits=decodeWidth*3)@[], row_debug_inst:Unsigned(bits=decodeWidth*32)@[], row_debug_pc:Unsigned(bits=decodeWidth*addrBits)@[], row_edge_inst:Unsigned(bits=decodeWidth*1)@[], row_ftq_idx:Unsigned(bits=decodeWidth*ftqBits)@[], row_inst:Unsigned(bits=decodeWidth*32)@[], row_is_rvc:Unsigned(bits=decodeWidth*1)@[], row_is_sfb:Unsigned(bits=decodeWidth*1)@[], row_pc_lob:Unsigned(bits=decodeWidth*6)@[], row_taken:Unsigned(bits=decodeWidth*1)@[], row_xcpt_ae_if:Unsigned(bits=decodeWidth*1)@[], row_xcpt_pf_if:Unsigned(bits=decodeWidth*1)@[]) {
  cassert(banks == 1 or banks == 2)
  cassert(fetchWidth >= banks and fetchWidth == 1 << std.clog2(fetchWidth))
  comptime const bankWidth = fetchWidth/banks
  const base = pcBase & ~(2*bankWidth - 1)
  comptime const bits = 81 + ftqBits + addrBits
  mut packet:Unsigned(bits=bits*fetchWidth) = 0
  for i in 0..<fetchWidth {
    const pc = base + (2*i)
    const edge = i%bankWidth == 0 and bankEdges#[i/bankWidth] != 0
    mut uop:Unsigned(bits=bits) = 0
    uop#[0..+32] = expanded#[(32*i)..+32]
    uop#[32..+32] = raw#[(32*i)..+32]
    uop#[64..+1] = U1(raw#[(32*i)..+32]#[0..+2] != 3)
    uop#[(81+ftqBits)..+addrBits] = if edge { (pc - 2)#[0..+addrBits] } else { pc#[0..+addrBits] }
    uop#[65..+1] = sfbs#[i] | shadowed#[i]
    uop#[81..+ftqBits] = ftqIdx
    uop#[66..+1] = U1(edge)
    uop#[67..+6] = pc#[0..+6]
    uop#[73..+1] = cfiValid & U1(cfiLane == i)
    uop#[74..+1] = pageFault
    uop#[75..+1] = accessFault
    uop#[76..+1] = debug#[i]
    uop#[77..+1] = exceptions#[i]
    uop#[78..+3] = source
    packet#[(bits*i)..+bits] = uop
  }
  const buffer = rows<bits=bits, decodeWidth=decodeWidth, entries=entries, fetchWidth=fetchWidth>(clock=clock, reset=reset, clear=io_clear, enq=io_enq_valid, mask=mask, packet=packet, deq=io_deq_ready)
  io_deq_valid = buffer.valid
  lanes = buffer.lanes
  io_enq_ready = buffer.ready
  for lane in 0..<decodeWidth {
    row_inst#[(lane*32)..+32] = buffer.row#[((lane*bits) + 0)..+32]
    row_debug_inst#[(lane*32)..+32] = buffer.row#[((lane*bits) + 32)..+32]
    row_is_rvc#[(lane*1)..+1] = buffer.row#[((lane*bits) + 64)..+1]
    row_debug_pc#[(lane*addrBits)..+addrBits] = buffer.row#[((lane*bits) + 81 + ftqBits)..+addrBits]
    row_is_sfb#[(lane*1)..+1] = buffer.row#[((lane*bits) + 65)..+1]
    row_ftq_idx#[(lane*ftqBits)..+ftqBits] = buffer.row#[((lane*bits) + 81)..+ftqBits]
    row_edge_inst#[(lane*1)..+1] = buffer.row#[((lane*bits) + 66)..+1]
    row_pc_lob#[(lane*6)..+6] = buffer.row#[((lane*bits) + 67)..+6]
    row_taken#[(lane*1)..+1] = buffer.row#[((lane*bits) + 73)..+1]
    row_xcpt_pf_if#[(lane*1)..+1] = buffer.row#[((lane*bits) + 74)..+1]
    row_xcpt_ae_if#[(lane*1)..+1] = buffer.row#[((lane*bits) + 75)..+1]
    row_bp_debug_if#[(lane*1)..+1] = buffer.row#[((lane*bits) + 76)..+1]
    row_bp_xcpt_if#[(lane*1)..+1] = buffer.row#[((lane*bits) + 77)..+1]
    row_debug_fsrc#[(lane*3)..+3] = buffer.row#[((lane*bits) + 78)..+3]
  }
}
