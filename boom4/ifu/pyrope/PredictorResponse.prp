// A physical BOOM bank predicts four instruction slots at each fetch stage.
pub type Prediction<addrBits=40> = (taken:U4, branch:U4, valid:U4, target:Unsigned(bits=4*addrBits))
pub type Update<addrBits=40> = (valid:U1, mispredict:U1, repair:U1, wrongTargets:U4, pc:Unsigned(bits=addrBits),
    branches:U4, cfiValid:U1, cfi:U2, taken:U1, missed:U1, branch:U1, jal:U1, jalr:U1, target:Unsigned(bits=addrBits))

pub type BankStage<addrBits=40> = (taken:U4, branch:U4, jumps:U4, valid:U4, target:Unsigned(bits=4*addrBits))
pub const emptyStage:BankStage = (taken=0, branch=0, jumps=0, valid=0, target=0)

pub comb response<addrBits=40>(incoming:BankStage<addrBits>) -> (value:Prediction<addrBits>) {
  value = (taken=incoming.taken, branch=incoming.branch, valid=incoming.valid, target=incoming.target)
}

pub comb direction<addrBits=40>(incoming:BankStage<addrBits>, taken:U4) -> (value:BankStage<addrBits>) {
  value = (taken=taken, branch=incoming.branch, jumps=incoming.jumps, valid=incoming.valid, target=incoming.target)
}
