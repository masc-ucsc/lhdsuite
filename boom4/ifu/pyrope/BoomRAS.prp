// Synchronous return-address stack with same-cycle write forwarding.
pub mod BoomRAS<nRasEntries=32, IdxT=U5, AddrT=U40>::[timecheck=false](
  clock:Clock,
  io_read_idx:IdxT,
  io_write_valid:U1,
  io_write_idx:IdxT,
  io_write_addr:AddrT
) -> (
  io_read_addr:AddrT@[]
) {

  reg ras:[nRasEntries]AddrT

  reg io_read_addr_REG  :U1
  reg io_read_addr_REG_1:AddrT
  reg io_read_addr_REG_2:AddrT

  io_read_addr_REG   = U1(io_write_valid != 0 and io_write_idx == io_read_idx)
  io_read_addr_REG_1 = io_write_addr
  io_read_addr_REG_2 = ras[io_read_idx%nRasEntries]

  io_read_addr = if io_read_addr_REG != 0 { io_read_addr_REG_1 } else { io_read_addr_REG_2 }

  if io_write_valid != 0 { ras[io_write_idx%nRasEntries] = io_write_addr }
}
