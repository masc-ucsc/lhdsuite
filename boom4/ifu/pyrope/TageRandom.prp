// Chisel Fibonacci LFSR taps. The top bit feeds back with one or three
// taps; each byte records the distance of a tap from the top bit. Two
// zero distances cancel for the two-tap polynomials.
comptime const taps = (
  0x0, 0x0, 0x1, 0x1, 0x1, 0x2, 0x1, 0x1, 0x20304, 0x4,
  0x3, 0x2, 0x10406, 0x10304, 0x10305, 0x1, 0x20305, 0x3, 0x7, 0x10205,
  0x3, 0x2, 0x1, 0x5, 0x10304, 0x3, 0x10206, 0x10205, 0x3, 0x2,
  0x10406, 0x3, 0x20607, 0xd, 0x30408, 0x2, 0xb, 0x10406, 0x10506, 0x4,
  0x30405, 0x3, 0x20507, 0x10506, 0x20506, 0x10304, 0x60708, 0x5, 0x40709, 0x9,
  0x20304, 0x10306, 0x3, 0x10206, 0x30608, 0x18, 0x20407, 0x7, 0x13, 0x20407,
  0x1, 0x10205, 0x30506, 0x1, 0x10304, 0x12, 0x60809, 0x10205, 0x9, 0x20506,
  0x10305, 0x6, 0x3090a, 0x19, 0x30407, 0x10306, 0x20405, 0x20506, 0x10207, 0x9,
  0x20409, 0x4, 0x40609, 0x20407, 0xd, 0x10208, 0x20506, 0xd, 0x8090b, 0x26,
  0x20305, 0x10508, 0x20506, 0x2, 0x15, 0xb, 0x6090a, 0x6, 0xb, 0x40507,
  0x25, 0x10607, 0x30506, 0x9, 0x10a0b, 0x10, 0xf, 0x20809, 0x1f, 0x20405,
  0x10406, 0xa, 0x4060b, 0x9, 0x1020b, 0x50708, 0x20506, 0x10205, 0x21, 0x8,
  0x20609, 0x12, 0x10206, 0x2, 0x25, 0x50607, 0x20407, 0x1, 0x10207, 0x5,
  0x3, 0x20308, 0x1d, 0x20809, 0x39, 0xb, 0x20308, 0x15, 0x10708, 0x30508,
  0x1d, 0x1060d, 0x15, 0x20305, 0x20407, 0x34, 0x20305, 0x2040b, 0x1b, 0x7090a,
  0x35, 0x3, 0x20306, 0x1, 0x10509, 0x40507, 0x30509, 0x20506, 0x50608, 0x1f,
  0x20305, 0x12, 0x40708, 0x30607, 0x5060c, 0x30809, 0x2030a, 0x6, 0x60910, 0x22,
  0x17, 0x20506, 0x7, 0x20508, 0xd, 0x6, 0x90b0c, 0x8, 0x57, 0x10204,
  0x70a0c, 0x10607, 0x10608, 0x38, 0x70809, 0x18, 0x60809, 0x50607, 0x20506, 0x20506,
  0x2060d, 0x9, 0x20e0f, 0xf, 0x57, 0x20308, 0x2090b, 0x20409, 0x41, 0x22,
  0x20305, 0xe, 0x37, 0x10708, 0x3040a, 0x20509, 0x5090a, 0x2b, 0x10309, 0x6,
  0x3040c, 0x80a0b, 0x69, 0x20506, 0x10305, 0x17, 0x10307, 0x2d, 0xb, 0x10408,
  0x90a0c, 0x20608, 0x20508, 0x21, 0x2070c, 0x20, 0x3070a, 0x4090a, 0x20b0c, 0x1040a,
  0x60708, 0x1a, 0x4090b, 0x4a, 0x1f, 0x10609, 0x5, 0x10407, 0x10205, 0x24,
  0x30508, 0x46, 0x1060b, 0x10508, 0x10409, 0x10406, 0x1020b, 0x52, 0xa0e0f, 0x56,
  0x67, 0x20407, 0x43, 0x10607, 0x10207, 0x34, 0x2050a,
)
pub mod TageRandom<n>(clock:Clock, reset:Reset) -> (sample:Unsigned(bits=n)@[]) {
  comptime const width = if n < 2 { 2 } else { n }
  comptime const poly = taps[width]
  comptime const hi = width-1
  reg bits:Unsigned(bits=width)
  const feedback = bits#[hi] ^ bits#[hi-(poly & 255)] ^ bits#[hi-((poly >> 8) & 255)] ^ bits#[hi-(poly >> 16)]
  bits = if reset { 1 } else { ((bits << 1) | feedback)#[0..+width] }
  sample = bits#[0..+n]
}
