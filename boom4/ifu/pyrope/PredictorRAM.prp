// Synchronous address read and independently masked writes to each fetch lane.
pub mod PredictorRAM<rows, lanes, bits>(clock:Clock, read:U1, readRow:Unsigned(bits=if rows == 1 { 1 } else { std.clog2(rows) }),
    write:U1, writeRow:Unsigned(bits=if rows == 1 { 1 } else { std.clog2(rows) }), data:Unsigned(bits=lanes*bits),
    mask:Unsigned(bits=lanes)) -> (value:Unsigned(bits=lanes*bits)@[]) {
  reg address:Unsigned(bits=if rows == 1 { 1 } else { std.clog2(rows) }) = nil
  if read != 0 { address = readRow }
  for lane in 0..<lanes {
    reg memory:[rows]Unsigned(bits=bits):[ordering="old"] = nil
    if write != 0 and mask#[lane] != 0 { memory[writeRow%rows] = data#[(lane*bits)..+bits] }
    value#[(lane*bits)..+bits] = memory[address%rows]
  }
}
