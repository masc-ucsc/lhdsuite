const targets = import("BTBBranchPredictorBank")
const stages = import("PredictorResponse")
const bim = import("BimCounters")
// Direction and target predictions feeding FastTAGE's six tagged tables.
// Each bank covers four halfwords. Stage 1 uses the fetch-group micro-BTB,
// stage 2 uses the fast BTB and BIM, and stage 3 accepts late predictions.
const randomWay = import("../../util/pyrope/MaxPeriodFibonacciLFSR.MaxPeriodFibonacciLFSR")

type Update<pcBits> = (pc:Unsigned(bits=pcBits), target:Unsigned(bits=pcBits), valid:U1, commit:U1, invalidate:U4, branches:U4,
  lane:U2, cfi:U1, taken:U1, isBr:U1, jal:U1, jalr:U1, meta:U120)
type Prediction<pcBits> = (valid:U4, target:Unsigned(bits=4*pcBits), branch:U4, jal:U4, taken:U4)

mod micro<ways=24, tagBits=12, pcBits=40>(clock:Clock, reset:U1, pc:Unsigned(bits=pcBits), valid:U1, update:Update<pcBits>)
    -> (out:Prediction<pcBits>@[], hitMeta:U1@[]) {
  cassert(ways >= 1 and ways <= 65536 and tagBits >= 1 and tagBits <= pcBits)
  type Tag = Unsigned(bits=tagBits)
  type Entry = (tag:Tag, count:U2, branch:U1, jump:U1, target:Unsigned(bits=pcBits))
  reg present:Unsigned(bits=ways) = nil
  reg table:[ways]Entry:[ordering="old"] = nil
  const random = randomWay(clock=clock, reset=reset, io_increment=1)
  mut matchUpdate:U1 = 0
  comptime const wayBits = if ways == 1 { 1 } else { std.clog2(ways) }
  mut selected:Unsigned(bits=wayBits) = if ways == 1 { 0 } else { random#[0..+wayBits] }
  mut prediction:Entry = nil
  mut hit:U1 = 0
  for way in 0..<ways {
    if present#[way] != 0 and table[way].tag == pc#[0..+tagBits] {
      prediction = table[way]
      hit = valid
    }
    if present#[way] != 0 and table[way].tag == update.pc#[0..+tagBits] {
      selected = way
      matchUpdate = 1
    }
  }
  out.valid = hit << 3
  out.target = prediction.target << (3*pcBits)
  out.branch = if prediction.branch != 0 { if prediction.jump != 0 { 7 } else { 15 } } else { 0 }
  out.jal = prediction.jump << 3
  out.taken = (hit & (prediction.jump | prediction.count#[1])) << 3
  reg hit2:U1 = nil
  reg hit3:U1 = nil
  hit2 = hit
  hit3 = hit2
  hitMeta = hit3
  if reset != 0 { present = 0 }
  elif update.commit != 0 and (update.cfi != 0 or update.branches != 0) and selected < ways {
    const way = selected%ways
    const taken = update.cfi & update.taken
    const jump = update.cfi & (update.jal | update.jalr)
    const lower = ((2 << update.lane)-1)#[0..+4]
    table[way].tag = update.pc#[0..+tagBits]
    table[way].count = if matchUpdate != 0 { bim.train(counter=table[way].count, taken=taken) }
                       elif taken != 0 { 3 } else { 0 }
    table[way].jump = jump
    table[way].branch = U1(jump == 0 or (update.branches & lower) != 0)
    if update.cfi != 0 { present#[way] = 1; table[way].target = update.target }
  }
}

pub mod FastTageBase<shift=3, singlePorted=true, fastBIM=bim.fast, slowBIM=bim.late, pcBits=40, fastBTB=targets.fastGeometry, slowBTB=targets.standard, microWays=24, microTagBits=12>(clock:Clock, reset:U1, fetch:U1, pc:Unsigned(bits=pcBits), update:Update<pcBits>)
    -> (f1:Prediction<pcBits>@[], f2:Prediction<pcBits>@[], f3:Prediction<pcBits>@[], info:Unsigned(bits=17+std.clog2(fastBTB.nWays)+std.clog2(slowBTB.nWays))@[]) {
  reg pc1:Unsigned(bits=pcBits) = nil
  reg valid1:U1 = nil
  reg u:Update<pcBits> = nil
  pc1 = pc
  valid1 = fetch
  u = update
  const first = micro<ways=microWays, tagBits=microTagBits, pcBits=pcBits>(clock=clock, reset=reset, pc=pc1, valid=valid1, update=u)
  const training:bim.Training<pcBits> = (pc=u.pc, commit=u.commit, branches=u.branches, lane=u.lane, cfi=u.cfi,
      taken=u.taken, isBr=u.isBr, jal=u.jal)
  const fastDir = bim.counters<pcBits=pcBits, geometry=fastBIM, shift=shift>(clock, reset, valid=fetch, pc, update=training, meta=u.meta#[1..+8])
  const slowDir = bim.counters<pcBits=pcBits, geometry=slowBIM, shift=shift>(clock, reset, valid=fetch, pc, update=training, meta=u.meta#[9..+8])
  comptime const slowOffset = 17+std.clog2(fastBTB.nWays)
  const trainingTarget:stages.Update<pcBits> = (valid=update.valid, mispredict=update.valid & ~update.commit & U1(update.invalidate == 0),
      repair=0, wrongTargets=update.invalidate, pc=update.pc, branches=update.branches, cfiValid=update.cfi,
      cfi=update.lane, taken=update.taken, missed=0, branch=update.isBr, jal=update.jal, jalr=update.jalr, target=update.target)
  const early:stages.BankStage<pcBits> = (taken=first.out.taken, valid=first.out.valid, branch=first.out.branch,
      jumps=first.out.jal, target=first.out.target)
  const dir2:stages.BankStage<pcBits> = (taken=fastDir.taken2, valid=0, branch=0, jumps=0, target=0)
  const dir3:stages.BankStage<pcBits> = (taken=slowDir.taken3, valid=0, branch=0, jumps=0, target=0)
  const fast = targets.BTBBranchPredictorBank<fetchShift=shift, geometry=fastBTB, addrBits=pcBits>(
      clock, reset=Bool(reset), fetch, pc, base1=early, base2=dir2, base3=dir3, update=trainingTarget, updateMeta=update.meta >> 17)
  const late = targets.BTBBranchPredictorBank<fetchShift=shift, geometry=slowBTB, slow=true, singlePorted=singlePorted, addrBits=pcBits>(
      clock, reset=Bool(reset), fetch, pc, base1=fast.f1, base2=fast.f2, base3=fast.f3, update=trainingTarget, updateMeta=update.meta >> slowOffset)
  f1 = first.out
  f2 = (valid=late.f2.valid, target=late.f2.target, branch=late.f2.branch, jal=late.f2.jumps, taken=late.f2.taken)
  f3 = (valid=late.f3.valid, target=late.f3.target, branch=late.f3.branch, jal=late.f3.jumps, taken=late.f3.taken)
  wrap info = first.hitMeta | (fastDir.meta3 << 1) | (slowDir.meta3 << 9) | (fast.metadata << 17) | (late.metadata << slowOffset)
}
