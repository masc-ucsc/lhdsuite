test lsu_rows.mixed {
  mut d = lsu_rows
  tick 10 {
    d.completeStores = U1(clock == 5)
    d.reset   = U1(clock < 2)
    d.load    = if clock == 2 or clock == 3 or clock == 5 { 21 } else { 31 }
    d.store   = if clock == 2 or clock == 3 or clock == 5 { 10 } else { 0 }
    d.enqueue = if clock == 2 or clock == 3 { 31 } elif clock == 4 { 3 } else { 0 }
    d.commit  = if clock == 5 { 31 } else { 0 }
    step
    if clock == 2 {
      assert(d.loadTags == 0x55443 and d.storeTags == 0x43322, "second dispatch row sees three loads and two stores")
    }
    if clock == 3 {
      assert(d.loadFull == 24 and d.storeFull == 0, "two free load entries before wrap")
    }
    if clock == 4 {
      assert(d.loadFull == 31 and d.loadTags == 0xaaa98, "wrapped load queue and two accepted lanes")
    }
    if clock == 5 {
      assert(d.core.storeDataValid#[0..+4] == 15, "all three memory issue ports and the FP store deliver together")
      assert(d.core.storeDataBits#[0..+64] == 100 and d.core.storeDataBits#[64..+64] == 101, "both data-only memory ports write their own slots")
      assert(d.core.storeDataBits#[128..+64] == 102 and d.core.storeDataBits#[192..+64] == 103, "address/data and FP ports write their own slots")
    }
    if clock >= 6 {
      assert(d.loadFull == 24 and d.loadTags == 0x88888, "three independently retired loads free the oldest entries")
      assert(d.storeFull == 0 and d.storeTags == 0x44444, "store commit preserves younger store slots")
    }
  }
}

test lsu_rows.address_pair {
  mut d = lsu_rows
  mut seen:U2 = 0
  tick 48 {
    d.reset = U1(clock == 0)
    d.enqueue = if clock == 2 { 3 } else { 0 }
    d.load = 3
    d.store = 0
    d.commit = 0
    d.completeStores = 0
    d.addressPair = U1(clock == 5)
    step
    if clock == 5 {
      assert(d.core.loadAddrBits#[40..+40] == 0x80000180, "second address generator writes its own queue entry")
    }
    if d.request != 0 {
      if d.address == 0x80000080 { seen = seen | 1 }
      if d.address == 0x80000180 { seen = seen | 2 }
    }
    if clock == 47 { assert(seen == 3, "both simultaneous addresses reach the data cache") }
  }
}
