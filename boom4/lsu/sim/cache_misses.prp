const file = import("../pyrope/BoomMSHRFile.BoomMSHRFile")

pub mod cache_misses(clock:Clock, reset:U1, send:U1, returning:U1, grantSource:U4)
    -> (count:U4@[], issued:U8@[], lines:U8@[], responses:U16@[], grants:U8@[]) {
  reg requested:U4 = nil
  reg sources:U8 = nil
  reg blocks:U8 = nil
  reg loads:U16 = nil
  reg received:U8 = nil
  const cache = file<entries=8, sources=8, sourceBits=4>(
    clock, reset, io_brupdate_b1_mispredict_mask=0, io_brupdate_b1_resolve_mask=0, io_clear_all=0,
    io_exception=0, io_mem_acquire_ready=send, io_mem_finish_ready=1, io_mem_grant_bits_data=0x15161718,
    io_mem_grant_bits_opcode=5, io_mem_grant_bits_param=0, io_mem_grant_bits_sink=3,
    io_mem_grant_bits_size=6, io_mem_grant_bits_source=grantSource, io_mem_grant_valid=returning,
    io_meta_read_ready=1, io_meta_resp_bits_coh_state=0, io_meta_resp_valid=1, io_meta_write_ready=1,
    io_prober_state_bits=0, io_prober_state_valid=0, io_refill_ready=1, io_replay_ready=1,
    io_req_0_bits_addr=0x80000000 + (requested << 6), io_req_0_bits_data=0, io_req_0_bits_is_hella=0,
    io_req_0_bits_old_meta_coh_state=0, io_req_0_bits_old_meta_tag=0, io_req_0_bits_tag_match=0,
    io_req_0_bits_uop_bp_debug_if=0, io_req_0_bits_uop_bp_xcpt_if=0, io_req_0_bits_uop_br_mask=0,
    io_req_0_bits_uop_br_tag=0, io_req_0_bits_uop_br_type=0, io_req_0_bits_uop_csr_cmd=0,
    io_req_0_bits_uop_debug_fsrc=0, io_req_0_bits_uop_debug_inst=0, io_req_0_bits_uop_debug_pc=0,
    io_req_0_bits_uop_debug_tsrc=0, io_req_0_bits_uop_dis_col_sel=0, io_req_0_bits_uop_dst_rtype=0,
    io_req_0_bits_uop_edge_inst=0, io_req_0_bits_uop_exc_cause=0, io_req_0_bits_uop_exception=0,
    io_req_0_bits_uop_fcn_dw=0, io_req_0_bits_uop_fcn_op=0, io_req_0_bits_uop_flush_on_commit=0,
    io_req_0_bits_uop_fp_ctrl_div=0, io_req_0_bits_uop_fp_ctrl_fastpipe=0,
    io_req_0_bits_uop_fp_ctrl_fma=0, io_req_0_bits_uop_fp_ctrl_fromint=0,
    io_req_0_bits_uop_fp_ctrl_ldst=0, io_req_0_bits_uop_fp_ctrl_ren1=0, io_req_0_bits_uop_fp_ctrl_ren2=0,
    io_req_0_bits_uop_fp_ctrl_ren3=0, io_req_0_bits_uop_fp_ctrl_sqrt=0,
    io_req_0_bits_uop_fp_ctrl_swap12=0, io_req_0_bits_uop_fp_ctrl_swap23=0,
    io_req_0_bits_uop_fp_ctrl_toint=0, io_req_0_bits_uop_fp_ctrl_typeTagIn=0,
    io_req_0_bits_uop_fp_ctrl_typeTagOut=0, io_req_0_bits_uop_fp_ctrl_vec=0,
    io_req_0_bits_uop_fp_ctrl_wen=0, io_req_0_bits_uop_fp_ctrl_wflags=0, io_req_0_bits_uop_fp_rm=0,
    io_req_0_bits_uop_fp_typ=0, io_req_0_bits_uop_fp_val=0, io_req_0_bits_uop_frs3_en=0,
    io_req_0_bits_uop_ftq_idx=0, io_req_0_bits_uop_fu_code_0=0, io_req_0_bits_uop_fu_code_1=0,
    io_req_0_bits_uop_fu_code_2=0, io_req_0_bits_uop_fu_code_3=0, io_req_0_bits_uop_fu_code_4=0,
    io_req_0_bits_uop_fu_code_5=0, io_req_0_bits_uop_fu_code_6=0, io_req_0_bits_uop_fu_code_7=0,
    io_req_0_bits_uop_fu_code_8=0, io_req_0_bits_uop_fu_code_9=0, io_req_0_bits_uop_imm_packed=0,
    io_req_0_bits_uop_imm_rename=0, io_req_0_bits_uop_imm_sel=0, io_req_0_bits_uop_inst=0,
    io_req_0_bits_uop_iq_type_0=0, io_req_0_bits_uop_iq_type_1=0, io_req_0_bits_uop_iq_type_2=0,
    io_req_0_bits_uop_iq_type_3=0, io_req_0_bits_uop_is_amo=0, io_req_0_bits_uop_is_eret=0,
    io_req_0_bits_uop_is_fence=0, io_req_0_bits_uop_is_fencei=0, io_req_0_bits_uop_is_mov=0,
    io_req_0_bits_uop_is_rocc=0, io_req_0_bits_uop_is_rvc=0, io_req_0_bits_uop_is_sfb=0,
    io_req_0_bits_uop_is_sfence=0, io_req_0_bits_uop_is_sys_pc2epc=0, io_req_0_bits_uop_is_unique=0,
    io_req_0_bits_uop_iw_issued=0, io_req_0_bits_uop_iw_issued_partial_agen=0,
    io_req_0_bits_uop_iw_issued_partial_dgen=0, io_req_0_bits_uop_iw_p1_bypass_hint=0,
    io_req_0_bits_uop_iw_p1_speculative_child=0, io_req_0_bits_uop_iw_p2_bypass_hint=0,
    io_req_0_bits_uop_iw_p2_speculative_child=0, io_req_0_bits_uop_iw_p3_bypass_hint=0,
    io_req_0_bits_uop_ldq_idx=requested, io_req_0_bits_uop_ldst=0, io_req_0_bits_uop_ldst_is_rs1=0,
    io_req_0_bits_uop_lrs1=0, io_req_0_bits_uop_lrs1_rtype=0, io_req_0_bits_uop_lrs2=0,
    io_req_0_bits_uop_lrs2_rtype=0, io_req_0_bits_uop_lrs3=0, io_req_0_bits_uop_mem_cmd=0,
    io_req_0_bits_uop_mem_signed=0, io_req_0_bits_uop_mem_size=3, io_req_0_bits_uop_op1_sel=0,
    io_req_0_bits_uop_op2_sel=0, io_req_0_bits_uop_pc_lob=0, io_req_0_bits_uop_pdst=0,
    io_req_0_bits_uop_pimm=0, io_req_0_bits_uop_ppred=0, io_req_0_bits_uop_ppred_busy=0,
    io_req_0_bits_uop_prs1=0, io_req_0_bits_uop_prs1_busy=0, io_req_0_bits_uop_prs2=0,
    io_req_0_bits_uop_prs2_busy=0, io_req_0_bits_uop_prs3=0, io_req_0_bits_uop_prs3_busy=0,
    io_req_0_bits_uop_rob_idx=0, io_req_0_bits_uop_rxq_idx=0, io_req_0_bits_uop_stale_pdst=0,
    io_req_0_bits_uop_stq_idx=0, io_req_0_bits_uop_taken=0, io_req_0_bits_uop_uses_ldq=1,
    io_req_0_bits_uop_uses_stq=0, io_req_0_bits_uop_xcpt_ae_if=0, io_req_0_bits_uop_xcpt_ma_if=0,
    io_req_0_bits_uop_xcpt_pf_if=0, io_req_0_bits_way_en=1,
    io_req_0_valid=U1(requested < 9 and reset == 0), io_req_is_probe_0=0, io_resp_ready=1,
    io_wb_req_ready=1, io_wb_resp=0)
  if reset != 0 {
    requested = 0
    sources = 0
    blocks = 0
    loads = 0
    received = 0
  } else {
    if requested < 9 and cache.io_req_0_ready != 0 { wrap requested = requested+1 }
    if send != 0 and cache.io_mem_acquire_valid != 0 {
      if cache.io_mem_acquire_bits_address < 0x80000200 {
        sources#[cache.io_mem_acquire_bits_source] = 1
        blocks#[cache.io_mem_acquire_bits_address#[6..+3]] = 1
      }
    }
    if returning != 0 and cache.io_mem_grant_ready != 0 { wrap received = received+1 }
    if cache.io_resp_valid != 0 { loads#[cache.io_resp_bits_uop_ldq_idx] = 1 }
  }
  count = requested
  issued = sources
  lines = blocks
  responses = loads
  grants = received
}
test cache_misses.concurrent {
  mut d = cache_misses
  tick 320 {
    d.reset = U1(clock == 0)
    d.send = U1(clock >= 32)
    d.returning = U1(clock >= 80 and clock < 144)
    d.grantSource = if clock >= 80 and clock < 144 { 7 - (clock-80)/8 } else { 0 }
    step
    if clock == 30 { assert(d.count == 8, "eight pending independent misses fill the file") }
    if clock == 70 {
      assert(d.issued == 255 and d.lines == 255, "eight distinct cache lines and native TileLink source IDs")
      assert(d.count == 8, "ninth miss waits for a free entry")
    }
    if clock == 319 {
      assert(d.grants == 64, "eight complete grants returned in reverse source order")
      assert((d.responses & 255) == 255 and d.count == 9, "every original load completed and a slot was reused")
    }
  }
}
