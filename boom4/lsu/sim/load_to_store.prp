const forward = import("../pyrope/LoadToStore.LoadToStore")

pub mod load_to_store(clock:Clock, search:U1, head:U4, eligible:U8, dst:U7, request:U5, response:U5, writeback:U1) -> (writes:U8@[]) {
  const result = forward<entries=8, pregBits=7, loadBits=5>(clock, search, boundary=head, eligible=eligible,
    sources=(U7(78), U7(12), U7(78), U7(78), U7(12), U7(78), U7(12), U7(78))#[..],
    destination=dst, searchedLoad=request, writeback=writeback, completedLoad=response)
  writes = result.write
}

test load_to_store.dependencies {
  mut d = load_to_store
  tick 16384 {
    const pattern = clock/2
    const head = pattern%8
    const mask = (pattern/8)%256
    const dst = if (pattern/2048)%2 == 0 { 78 } else { 12 }
    const ready = pattern/4096 == 0
    d.head = head
    d.eligible = mask
    d.dst = dst
    d.request = 21
    d.response = if ready { 21 } else { 5 }
    d.search = 1
    d.writeback = 1
    step
    if clock%2 == 1 {
      const hits = mask & (if dst == 78 { 173 } else { 82 })
      const after = hits & (255 << head)
      const candidates = if after != 0 { after } else { hits }
      const first = candidates & (0-candidates)
      assert(d.writes == (if ready { first } else { 0 }), "select one consuming store only for the matching load generation")
    }
  }
}
