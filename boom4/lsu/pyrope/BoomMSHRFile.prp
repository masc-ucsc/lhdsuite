  if seenResp == 0 and mmio.io_resp_valid != 0 {
    response = (amo=mmio.io_resp_bits_uop_is_amo, load=mmio.io_resp_bits_uop_uses_ldq, store=mmio.io_resp_bits_uop_uses_stq, ldq=mmio.io_resp_bits_uop_ldq_idx, stq=mmio.io_resp_bits_uop_stq_idx, data=mmio.io_resp_bits_data, hella=mmio.io_resp_bits_is_hella)
    responseMask = mmio.io_resp_bits_uop_br_mask
  }
  const q = responseQueue<branches=branches, entries=4, Payload=Response>(clock, reset,
    enqueue=seenResp | mmio.io_resp_valid, input=response, mask=responseMask, flushable=response.load,
    consume=io_resp_ready, resolve=io_brupdate_b1_resolve_mask, mispredict=io_brupdate_b1_mispredict_mask, flush=io_exception)
  responseReady = q.ready
  io_resp_valid = q.valid
  io_resp_bits_uop_is_amo = q.output.amo
  io_resp_bits_uop_ldq_idx = q.output.ldq
  io_resp_bits_uop_stq_idx = q.output.stq
  io_resp_bits_uop_uses_ldq = q.output.load
  io_resp_bits_uop_uses_stq = q.output.store
  io_resp_bits_data = q.output.data
  io_resp_bits_is_hella = q.output.hella
  io_refill_valid = seenRefill
  io_meta_write_valid = seenMetaWrite
  io_meta_read_valid = seenMetaRead
  io_wb_req_valid = seenWbReq
  io_replay_valid = seenReplay
  io_mem_finish_valid = seenMemFinish
  replayID = pendingReplay
  io_replay_bits_data = if replayID < 17 { storeData[replayID] } else { 0 }
  const insert = selectedReady != 0 and requesting and isWrite(io_req_0_bits_uop_mem_cmd)
  const release = seenReplay != 0 and io_replay_ready != 0 and isWrite(io_replay_bits_uop_mem_cmd)
  if insert and storeID < 17 { storeData[storeID] = io_req_0_bits_data }
  if reset != 0 {
    usedStores = 0
  } else {
    if release { usedStores#[replayID] = 0 }
    if insert { usedStores#[storeID] = 1 }
  }
}
