const pick = import("../../util/pyrope/ParallelFindOne.ParallelFindOne")

// The tail points just beyond the youngest store. Prefer the most recent
// match before it, wrapping to the high end of the queue if necessary.
pub mod ForwardingAgeLogic<entries=8>(
  clock:Clock,
  matches:Unsigned(bits=entries),
  youngest:Unsigned(bits=std.clog2(entries)),
) -> (io_found:U1@[], io_found_idx:Unsigned(bits=std.clog2(entries))@[]) {
  cassert(entries >= 2)
  const before = matches & ((1 << youngest) - 1)
  const winner = pick<favorHigh=true, width=entries>(mask=if before != 0 { before } else { matches })
  reg found:U1                                = nil
  reg index:Unsigned(bits=std.clog2(entries)) = nil
  found        = U1(winner.success)
  index        = winner.index
  io_found     = found
  io_found_idx = index
}
