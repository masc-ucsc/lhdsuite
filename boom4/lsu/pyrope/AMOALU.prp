pub comb AMOALU(
  io_cmd:(e4:U1, e3:U1, e2:U1, e1:U1, e0:U1),
  io_lhs:U64,
  io_mask:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1),
  io_rhs:U64,
) -> (io_out:U64) {
  const cmd   = io_cmd.e0 | (io_cmd.e1 << 1) | (io_cmd.e2 << 2) | (io_cmd.e3 << 3) | (io_cmd.e4 << 4)
  const lanes = io_mask.e0
    | (io_mask.e1 << 1)
    | (io_mask.e2 << 2)
    | (io_mask.e3 << 3)
    | (io_mask.e4 << 4)
    | (io_mask.e5 << 5)
    | (io_mask.e6 << 6)
    | (io_mask.e7 << 7)
  // For an upper-word addition, clear bit 31 so the lower word cannot carry in.
  const carryMask:U64 = 0xffffffff7fffffff | (io_mask.e3 << 31)
  const lhs:U64       = if io_mask.e4 != 0 { io_lhs } else { io_lhs#[0..+32] }
  const rhs:U64       = if io_mask.e4 != 0 { io_rhs } else { io_rhs#[0..+32] }
  const sign:U64      = if io_cmd.e1 != 0 { 0 } elif io_mask.e4 != 0 { 1 << 63 } else { 1 << 31 }
  const less          = (lhs ^ sign) < (rhs ^ sign)
  mut result:U64 = io_rhs
  if cmd == 8 {
    wrap result = (io_lhs & carryMask) + (io_rhs & carryMask)
  } elif cmd == 9 {
    result = io_lhs ^ io_rhs
  } elif cmd == 10 {
    result = io_lhs | io_rhs
  } elif cmd == 11 {
    result = io_lhs & io_rhs
  } elif (less and (cmd == 12 or cmd == 14)) or (not less and (cmd == 13 or cmd == 15)) {
    result = io_lhs
  }
  io_out = io_lhs
  for lane in 0..<8 {
    if lanes#[lane] != 0 {
      io_out#[(8*lane)..+8] = result#[(8*lane)..+8]
    }
  }
}
