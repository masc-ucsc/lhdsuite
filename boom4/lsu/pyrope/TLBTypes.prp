pub type Protection = (pmpTable:U608, ptbr_mode:U4, resp_bits_pte_ppn:U44, resp_valid:U1, status_debug:U1, status_dprv:U2, status_mxr:U1, status_sum:U1)

// BOOM packed TLB entry fields used during translation and protection checks.
pub comb unpack(data:U34) -> (ppn:U20, u:U1, ae:U1, sw:U1, sx:U1, sr:U1,
    pw:U1, pr:U1, pal:U1, paa:U1, eff:U1, c:U1) {
  ppn = data#[14..+20]
  u = data#[13]
  ae = data#[11]
  sw = data#[10]
  sx = data#[9]
  sr = data#[8]
  pw = data#[7]
  pr = data#[5]
  pal = data#[4]
  paa = data#[3]
  eff = data#[2]
  c = data#[1]
}
