pub comb Arbiter2_L1MetaWriteReq<indexBits=6, ways=4>::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_idx:Unsigned(bits=indexBits), io_in_0_bits_way_en:Unsigned(bits=ways), io_in_0_bits_data_coh_state:U2, io_in_0_bits_data_tag:Unsigned(bits=(26-indexBits)), io_in_1_valid:U1, io_in_1_bits_idx:Unsigned(bits=indexBits), io_in_1_bits_way_en:Unsigned(bits=ways), io_in_1_bits_data_coh_state:U2, io_in_1_bits_data_tag:Unsigned(bits=(26-indexBits)), io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_idx:Unsigned(bits=indexBits), io_out_bits_way_en:Unsigned(bits=ways), io_out_bits_data_coh_state:U2, io_out_bits_data_tag:Unsigned(bits=(26-indexBits))) {
  mut _mux_1:Unsigned(bits=indexBits) = if io_in_0_valid != 0 { io_in_0_bits_idx#[0..+indexBits] } else { io_in_1_bits_idx#[0..+indexBits] }
  mut _mux_2:Unsigned(bits=ways) = if io_in_0_valid != 0 { io_in_0_bits_way_en } else { io_in_1_bits_way_en }
  mut _mux_3:U2 = if io_in_0_valid != 0 { io_in_0_bits_data_coh_state#[0..<2] } else { io_in_1_bits_data_coh_state#[0..<2] }
  mut _mux_4:Unsigned(bits=(26-indexBits)) = if io_in_0_valid != 0 { io_in_0_bits_data_tag#[0..+(26-indexBits)] } else { io_in_1_bits_data_tag#[0..+(26-indexBits)] }
  io_in_0_ready = io_out_ready
  io_in_1_ready = (~io_in_0_valid) & io_out_ready & 1
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_idx = _mux_1
  io_out_bits_way_en = _mux_2
  io_out_bits_data_coh_state = _mux_3
  io_out_bits_data_tag = _mux_4
}
