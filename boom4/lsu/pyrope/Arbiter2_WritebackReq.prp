pub comb Arbiter2_WritebackReq<sourceBits=2, indexBits=6, ways=4>::[timecheck=false](io_in_0_valid:U1, io_in_0_bits_tag:Unsigned(bits=(26-indexBits)), io_in_0_bits_idx:Unsigned(bits=indexBits), io_in_0_bits_source:Unsigned(bits=sourceBits), io_in_0_bits_param:U3, io_in_0_bits_way_en:Unsigned(bits=ways), io_in_0_bits_voluntary:U1, io_in_1_valid:U1, io_in_1_bits_tag:Unsigned(bits=(26-indexBits)), io_in_1_bits_idx:Unsigned(bits=indexBits), io_in_1_bits_source:Unsigned(bits=sourceBits), io_in_1_bits_param:U3, io_in_1_bits_way_en:Unsigned(bits=ways), io_in_1_bits_voluntary:U1, io_out_ready:U1) -> (io_in_0_ready:U1, io_in_1_ready:U1, io_out_valid:U1, io_out_bits_tag:Unsigned(bits=(26-indexBits)), io_out_bits_idx:Unsigned(bits=indexBits), io_out_bits_source:Unsigned(bits=sourceBits), io_out_bits_param:U3, io_out_bits_way_en:Unsigned(bits=ways), io_out_bits_voluntary:U1) {
  mut _mux_1:Unsigned(bits=(26-indexBits)) = if io_in_0_valid != 0 { io_in_0_bits_tag#[0..+(26-indexBits)] } else { io_in_1_bits_tag#[0..+(26-indexBits)] }
  mut _mux_2:Unsigned(bits=indexBits) = if io_in_0_valid != 0 { io_in_0_bits_idx#[0..+indexBits] } else { io_in_1_bits_idx#[0..+indexBits] }
  mut _mux_3:Unsigned(bits=sourceBits) = if io_in_0_valid != 0 { io_in_0_bits_source } else { io_in_1_bits_source }
  mut _mux_4:U3 = if io_in_0_valid != 0 { io_in_0_bits_param#[0..<3] } else { io_in_1_bits_param#[0..<3] }
  mut _mux_5:Unsigned(bits=ways) = if io_in_0_valid != 0 { io_in_0_bits_way_en } else { io_in_1_bits_way_en }
  mut _mux_6:U1 = if io_in_0_valid != 0 { io_in_0_bits_voluntary & 1 } else { io_in_1_bits_voluntary & 1 }
  io_in_0_ready = io_out_ready
  io_in_1_ready = (~io_in_0_valid) & io_out_ready & 1
  io_out_valid = (io_in_0_valid | io_in_1_valid) & 1
  io_out_bits_tag = _mux_1
  io_out_bits_idx = _mux_2
  io_out_bits_source = _mux_3
  io_out_bits_param = _mux_4
  io_out_bits_way_en = _mux_5
  io_out_bits_voluntary = _mux_6
}
