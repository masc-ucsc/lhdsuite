const pick = import("../pyrope/ParallelFindOne.ParallelFindOne")
pub mod find_one(mask:U5) -> (valid:Bool@[], high:U3@[], low:U3@[]) {
  const h = pick<width=5,favorHigh=true>(mask=mask)
  const l = pick<width=5,favorHigh=false>(mask=mask)
  valid = h.success and l.success
  high = h.index
  low = l.index
}
test find_one.exhaustive {
  mut dut = find_one
  tick 32 {
    dut.mask = U5(clock)
    step
    if clock == 0 {
      assert(not dut.valid and dut.low == 7 and dut.high == 0, "empty padded mask")
    } else {
      assert(dut.valid and (1 << dut.low) == (clock & -clock), "least significant bit")
      assert((clock >> dut.high) == 1, "most significant bit")
    }
  }
}
