// Encode the first or last asserted bit. The empty-mask index follows the
// Chisel tree's fallback, including its zero padding to the next power of two.
pub comb ParallelFindOne<width=4, favorHigh=true>(mask:Unsigned(bits=width)) -> (success:Bool, index:Unsigned(bits=std.clog2(width))) {
  cassert(width >= 2)
  comptime const levels = std.clog2(width)
  mut choice:Unsigned(bits=levels) = 0
  for bit in 0..<width {
    const preferred = if favorHigh { mask >> (bit+1) } else { mask & ((1 << bit)-1) }
    if mask#[bit] != 0 and preferred == 0 { choice = choice | bit }
  }
  success = mask != 0
  index = if mask == 0 and not favorHigh { (1 << levels)-1 } else { choice }
}
