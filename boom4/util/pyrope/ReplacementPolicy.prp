// An incomplete right subtree has no leaves beyond the configured way count.
pub comb replacementPolicy<count, depth, indexBits, treeBits>(tree:Unsigned(bits=treeBits),
    touch:Unsigned(bits=indexBits), empty:Unsigned(bits=count))
    -> (victim:Unsigned(bits=indexBits), updated:Unsigned(bits=treeBits)) {
  updated = tree
  mut readNode = 0
  mut writeNode = 0
  mut base = 0
  for level in 0..<depth {
    const bit = depth-level-1
    const right = base + (1 << bit)
    const side = U1(right < count) & tree#[readNode]
    if side != 0 { base = right }
    readNode = 2*readNode+1+side
    const touchedSide = touch#[bit]
    updated#[writeNode] = ~touchedSide
    writeNode = 2*writeNode+1+touchedSide
  }
  victim = base#[0..+indexBits]
  for offset in 0..<count {
    const i = count-1-offset
    if empty#[i] != 0 { victim = i }
  }
}
