// BOOM's two-entry elastic register. Backpressure depends only on stored occupancy.
pub mod ElasticReg<T=U64>(clock:Clock, reset:Reset, enqValid:Bool, enqBits:T,
                           deqReady:Bool) -> (enqReady:Bool@[], deqValid:Bool@[], deqBits:T@[], count:U2@[]) {
  reg front:T = nil
  reg back:T = nil
  reg occupied:U2 = 0
  const push = enqValid and occupied < 2
  const pop = deqReady and occupied != 0
  enqReady = occupied < 2
  deqValid = occupied != 0
  deqBits = front
  count = occupied
  if pop and occupied == 2 { front = back }
  if push {
    if occupied == 0 or pop { front = enqBits } else { back = enqBits }
  }
  if push and not pop { wrap occupied = occupied + 1 }
  if pop and not push { wrap occupied = occupied - 1 }
}
