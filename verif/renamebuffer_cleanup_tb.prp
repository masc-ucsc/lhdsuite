const original = import("RenameBuffer_original.RenameBuffer")
const cleaned = import("RenameBuffer_clean.RenameBuffer")
test original.compare(cycles:U20=2048) {
  mut before = original
  mut after = cleaned
  tick cycles clocks=(clock=1) {
    const phase = clock & 255
    mut requests = 0
    mut valid0 = 0
    const lane0 = phase + 0
    const mask0 = lane0 & 3
    if clock >= 4 {
      if clock < 64 { valid0 = 1 }
      if mask0 != 0 { valid0 = 1 }
    }
    const enables0 = (lane0 & 31) | 16
    const ldest0 = lane0 & 63
    const preg_sum0 = (clock * 13) + 0
    const pdest0 = preg_sum0 & 255
    const move0 = (clock >> 2) & 1
    mut request0 = valid0 << 509
    request0 = request0 | (enables0 << 407)
    request0 = request0 | (ldest0 << 457)
    request0 = request0 | (pdest0 << 66)
    request0 = request0 | (move0 << 143)
    requests = requests | (request0 << 0)
    mut valid1 = 0
    const lane1 = phase + 1
    const mask1 = lane1 & 3
    if clock >= 4 {
      if clock < 64 { valid1 = 1 }
      if mask1 != 0 { valid1 = 1 }
    }
    const enables1 = (lane1 & 31) | 16
    const ldest1 = lane1 & 63
    const preg_sum1 = (clock * 13) + 1
    const pdest1 = preg_sum1 & 255
    const move1 = (clock >> 2) & 1
    mut request1 = valid1 << 509
    request1 = request1 | (enables1 << 407)
    request1 = request1 | (ldest1 << 457)
    request1 = request1 | (pdest1 << 66)
    request1 = request1 | (move1 << 143)
    requests = requests | (request1 << 510)
    mut valid2 = 0
    const lane2 = phase + 2
    const mask2 = lane2 & 3
    if clock >= 4 {
      if clock < 64 { valid2 = 1 }
      if mask2 != 0 { valid2 = 1 }
    }
    const enables2 = (lane2 & 31) | 16
    const ldest2 = lane2 & 63
    const preg_sum2 = (clock * 13) + 2
    const pdest2 = preg_sum2 & 255
    const move2 = (clock >> 2) & 1
    mut request2 = valid2 << 509
    request2 = request2 | (enables2 << 407)
    request2 = request2 | (ldest2 << 457)
    request2 = request2 | (pdest2 << 66)
    request2 = request2 | (move2 << 143)
    requests = requests | (request2 << 1020)
    mut valid3 = 0
    const lane3 = phase + 3
    const mask3 = lane3 & 3
    if clock >= 4 {
      if clock < 64 { valid3 = 1 }
      if mask3 != 0 { valid3 = 1 }
    }
    const enables3 = (lane3 & 31) | 16
    const ldest3 = lane3 & 63
    const preg_sum3 = (clock * 13) + 3
    const pdest3 = preg_sum3 & 255
    const move3 = (clock >> 2) & 1
    mut request3 = valid3 << 509
    request3 = request3 | (enables3 << 407)
    request3 = request3 | (ldest3 << 457)
    request3 = request3 | (pdest3 << 66)
    request3 = request3 | (move3 << 143)
    requests = requests | (request3 << 1530)
    mut valid4 = 0
    const lane4 = phase + 4
    const mask4 = lane4 & 3
    if clock >= 4 {
      if clock < 64 { valid4 = 1 }
      if mask4 != 0 { valid4 = 1 }
    }
    const enables4 = (lane4 & 31) | 16
    const ldest4 = lane4 & 63
    const preg_sum4 = (clock * 13) + 4
    const pdest4 = preg_sum4 & 255
    const move4 = (clock >> 2) & 1
    mut request4 = valid4 << 509
    request4 = request4 | (enables4 << 407)
    request4 = request4 | (ldest4 << 457)
    request4 = request4 | (pdest4 << 66)
    request4 = request4 | (move4 << 143)
    requests = requests | (request4 << 2040)
    mut valid5 = 0
    const lane5 = phase + 5
    const mask5 = lane5 & 3
    if clock >= 4 {
      if clock < 64 { valid5 = 1 }
      if mask5 != 0 { valid5 = 1 }
    }
    const enables5 = (lane5 & 31) | 16
    const ldest5 = lane5 & 63
    const preg_sum5 = (clock * 13) + 5
    const pdest5 = preg_sum5 & 255
    const move5 = (clock >> 2) & 1
    mut request5 = valid5 << 509
    request5 = request5 | (enables5 << 407)
    request5 = request5 | (ldest5 << 457)
    request5 = request5 | (pdest5 << 66)
    request5 = request5 | (move5 << 143)
    requests = requests | (request5 << 2550)
    mut valid6 = 0
    const lane6 = phase + 6
    const mask6 = lane6 & 3
    if clock >= 4 {
      if clock < 64 { valid6 = 1 }
      if mask6 != 0 { valid6 = 1 }
    }
    const enables6 = (lane6 & 31) | 16
    const ldest6 = lane6 & 63
    const preg_sum6 = (clock * 13) + 6
    const pdest6 = preg_sum6 & 255
    const move6 = (clock >> 2) & 1
    mut request6 = valid6 << 509
    request6 = request6 | (enables6 << 407)
    request6 = request6 | (ldest6 << 457)
    request6 = request6 | (pdest6 << 66)
    request6 = request6 | (move6 << 143)
    requests = requests | (request6 << 3060)
    mut valid7 = 0
    const lane7 = phase + 7
    const mask7 = lane7 & 3
    if clock >= 4 {
      if clock < 64 { valid7 = 1 }
      if mask7 != 0 { valid7 = 1 }
    }
    const enables7 = (lane7 & 31) | 16
    const ldest7 = lane7 & 63
    const preg_sum7 = (clock * 13) + 7
    const pdest7 = preg_sum7 & 255
    const move7 = (clock >> 2) & 1
    mut request7 = valid7 << 509
    request7 = request7 | (enables7 << 407)
    request7 = request7 | (ldest7 << 457)
    request7 = request7 | (pdest7 << 66)
    request7 = request7 | (move7 << 143)
    requests = requests | (request7 << 3570)
    before.reset = clock < 4
    before.io_req = requests
    before.io_redirect_valid = phase == 64 or phase == 128
    before.io_fromRob_walkSize = 0
    if phase >= 128 and phase < 180 { before.io_fromRob_walkSize = 8 }
    before.io_fromRob_walkEnd = phase == 180
    before.io_fromRob_commitSize = 0
    if clock >= 48 { before.io_fromRob_commitSize = clock & 15 }
    before.io_fromRob_vecLoadExcp.valid = 1
    before.io_fromRob_vecLoadExcp.bits_isStrided = clock & 1
    before.io_fromRob_vecLoadExcp.bits_isVlm = (clock >> 1) & 1
    before.io_snpt.snptEnq = phase >= 4 and phase < 8
    before.io_snpt.snptDeq = 0
    before.io_snpt.useSnpt = phase >= 128
    before.io_snpt.snptSelect = (clock >> 8) & 3
    before.io_snpt.flushVec = 0
    after.reset = clock < 4
    after.io_req = requests
    after.io_redirect_valid = phase == 64 or phase == 128
    after.io_fromRob_walkSize = 0
    if phase >= 128 and phase < 180 { after.io_fromRob_walkSize = 8 }
    after.io_fromRob_walkEnd = phase == 180
    after.io_fromRob_commitSize = 0
    if clock >= 48 { after.io_fromRob_commitSize = clock & 15 }
    after.io_fromRob_vecLoadExcp.valid = 1
    after.io_fromRob_vecLoadExcp.bits_isStrided = clock & 1
    after.io_fromRob_vecLoadExcp.bits_isVlm = (clock >> 1) & 1
    after.io_snpt.snptEnq = phase >= 4 and phase < 8
    after.io_snpt.snptDeq = 0
    after.io_snpt.useSnpt = phase >= 128
    after.io_snpt.snptSelect = (clock >> 8) & 3
    after.io_snpt.flushVec = 0
    step
    if clock >= 4 {
      assert(before.io_canEnq == after.io_canEnq, "io_canEnq differs at cycle {clock}")
      assert(before.io_canEnqForDispatch == after.io_canEnqForDispatch, "io_canEnqForDispatch differs at cycle {clock}")
      assert(before.io_commits.isCommit == after.io_commits.isCommit, "io_commits.isCommit differs at cycle {clock}")
      assert(before.io_commits.commitValid == after.io_commits.commitValid, "io_commits.commitValid differs at cycle {clock}")
      assert(before.io_commits.isWalk == after.io_commits.isWalk, "io_commits.isWalk differs at cycle {clock}")
      assert(before.io_commits.walkValid == after.io_commits.walkValid, "io_commits.walkValid differs at cycle {clock}")
      assert(before.io_commits.info == after.io_commits.info, "io_commits.info differs at cycle {clock}")
      assert(before.io_diffCommits.isCommit == after.io_diffCommits.isCommit, "io_diffCommits.isCommit differs at cycle {clock}")
      assert(before.io_diffCommits.commitValid == after.io_diffCommits.commitValid, "io_diffCommits.commitValid differs at cycle {clock}")
      assert(before.io_diffCommits.info == after.io_diffCommits.info, "io_diffCommits.info differs at cycle {clock}")
      assert(before.io_status.walkEnd == after.io_status.walkEnd, "io_status.walkEnd differs at cycle {clock}")
      assert(before.io_status.commitEnd == after.io_status.commitEnd, "io_status.commitEnd differs at cycle {clock}")
      assert(before.io_toVecExcpMod.logicPhyRegMap == after.io_toVecExcpMod.logicPhyRegMap, "io_toVecExcpMod.logicPhyRegMap differs at cycle {clock}")
  }
  }
  puts("RenameBuffer differential simulation passed {cycles} cycles")
}
