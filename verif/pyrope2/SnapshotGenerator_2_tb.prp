// Shared unchanged across Verilog, generated Pyrope, and Pyrope2.
const queue = import("lg:SnapshotGenerator_2")
test queue.transitions {
  mut dut = queue
  mut head:u3 = 0
  mut tail:u3 = 0
  mut valids:u4 = 0
  mut known:u4 = 0
  mut payload0:u8 = 0
  mut payload1:u8 = 0
  mut payload2:u8 = 0
  mut payload3:u8 = 0
  tick 1024 clocks=(clock=1) {
    const resetting = (clock < 2) or (clock == 511)
    const enqueue = (clock % 7) != 0
    const dequeue = (clock % 3) == 0
    const redirect = (clock % 13) == 0
    const flush:u4 = if (clock % 11) == 0 { (clock / 11) & 15 } else { 0 }
    const data:u8 = ((clock * 257) ^ (clock << 18) ^ (clock << 47)) & 0xff
    dut.reset = resetting
    dut.io_enq = enqueue
    dut.io_deq = dequeue
    dut.io_redirect = redirect
    dut.io_flushVec = flush
    dut.io_enqData.illegal = (data >> 7) & 1
    dut.io_enqData.vma = (data >> 6) & 1
    dut.io_enqData.vta = (data >> 5) & 1
    dut.io_enqData.vsew = (data >> 3) & 3
    dut.io_enqData.vlmul = data & 7
    const push = enqueue and not redirect and ((tail ^ head) != 4)
    const pop = dequeue and not redirect
    mut next_tail:u3 = tail
    if (flush & valids) != 0 {
      next_tail = (head + 3) & 7
      mut selected:bool = false
      const i0 = head & 3
      const i1 = (head + 1) & 3
      const i2 = (head + 2) & 3
      if ((valids >> i0) & 1) == 0 or ((flush >> i0) & 1) != 0 { next_tail = head }
      elif ((valids & flush) >> i1) & 1 { next_tail = (head + 1) & 7 }
      elif ((valids & flush) >> i2) & 1 { next_tail = (head + 2) & 7 }
    } elif push { next_tail = (tail + 1) & 7 }
    if push {
      if (tail & 3) == 0 { payload0 = data }
      if (tail & 3) == 1 { payload1 = data }
      if (tail & 3) == 2 { payload2 = data }
      if (tail & 3) == 3 { payload3 = data }
      known = known | (1 << (tail & 3))
    }
    if resetting {
      head = 0
      tail = 0
      valids = 0
    } else {
      if push { valids = valids | (1 << (tail & 3)) }
      if pop { valids = valids & ~(1 << (head & 3)) }
      valids = valids & ~flush
      tail = next_tail
      if pop { head = (head + 1) & 7 }
    }
    step
    assert(dut.io_valids == valids, "snapshot validity priority")
    assert(((dut.io_enqPtr.flag << 2) | dut.io_enqPtr.value) == tail, "snapshot tail rewind")
    assert(((dut.io_deqPtr.flag << 2) | dut.io_deqPtr.value) == head, "snapshot head")
    if known & 1 { assert(((dut.io_snapshots >> 0) & 0xff) == payload0, "snapshot payload 0") }
    if known & 2 { assert(((dut.io_snapshots >> 8) & 0xff) == payload1, "snapshot payload 1") }
    if known & 4 { assert(((dut.io_snapshots >> 16) & 0xff) == payload2, "snapshot payload 2") }
    if known & 8 { assert(((dut.io_snapshots >> 24) & 0xff) == payload3, "snapshot payload 3") }
  }
}
