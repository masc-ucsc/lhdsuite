# Optional picorv32 state, valid only for configurations that elaborate it
# (TWO_CYCLE_ALU or ENABLE_MUL or ENABLE_FAST_MUL or ENABLE_DIV). An explicit
# match name that does not resolve is an error: append only the rows that apply
# to the configuration under check to picorv32.match. Proofs there are bounded.
# Optional registered ALU/compare paths.
cpu.alu_add_sub=cpu.alu_add_sub_q
cpu.alu_eq=cpu.alu_eq_q
cpu.alu_lts=cpu.alu_lts_q
cpu.alu_ltu=cpu.alu_ltu_q
cpu.alu_shl=cpu.alu_shl_q
cpu.alu_shr=cpu.alu_shr_q

# Optional PCPI engines, relocated through the arbiter.
cpu.genblk1_pcpi_mul.instr_mul=cpu.coprocessor.serial.instr_mul
cpu.genblk1_pcpi_mul.instr_mulh=cpu.coprocessor.serial.instr_mulh
cpu.genblk1_pcpi_mul.instr_mulhsu=cpu.coprocessor.serial.instr_mulhsu
