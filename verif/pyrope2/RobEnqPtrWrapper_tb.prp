// One driver for all three languages; exercise the 352-entry wrap boundary.
const rob = import("lg:RobEnqPtrWrapper")
test rob.pointers {
  mut dut = rob
  mut ptr0:u10 = 0
  mut ptr1:u10 = 1
  mut ptr2:u10 = 2
  mut ptr3:u10 = 3
  mut ptr4:u10 = 4
  mut ptr5:u10 = 5
  mut ptr6:u10 = 6
  mut ptr7:u10 = 7
  tick 1024 clocks=(clock=1) {
    const resetting = (clock < 2) or (clock == 511)
    const redirect = (clock % 17) == 0
    const target = (clock * 13) & 511
    const flag = (clock >> 5) & 1
    const level = (clock >> 4) & 1
    const allow = (clock % 7) != 0
    const blocked = (clock % 11) == 0
    const mask:u8 = clock & 255
    const count = (mask & 1) + ((mask >> 1) & 1) + ((mask >> 2) & 1) + ((mask >> 3) & 1) +
      ((mask >> 4) & 1) + ((mask >> 5) & 1) + ((mask >> 6) & 1) + ((mask >> 7) & 1)
    const accepted = if allow and not blocked { count } else { 0 }
    dut.reset = resetting
    dut.io_redirect.valid = redirect
    dut.io_redirect.bits_robIdx_value = target
    dut.io_redirect.bits_robIdx_flag = flag
    dut.io_redirect.bits_level = level
    dut.io_allowEnqueue = allow
    dut.io_hasBlockBackward = blocked
    dut.io_enq = mask
    const value0 = if redirect { target + 0 + (1 - level) } else { (ptr0 & 511) + accepted }
    const flag0 = if redirect { flag } else { ptr0 >> 9 }
    if resetting { ptr0 = 0 }
    else { ptr0 = if value0 >= 352 { ((flag0 ^ 1) << 9) | (value0 - 352) } else { (flag0 << 9) | value0 } }
    const value1 = if redirect { target + 1 + (1 - level) } else { (ptr1 & 511) + accepted }
    const flag1 = if redirect { flag } else { ptr1 >> 9 }
    if resetting { ptr1 = 1 }
    else { ptr1 = if value1 >= 352 { ((flag1 ^ 1) << 9) | (value1 - 352) } else { (flag1 << 9) | value1 } }
    const value2 = if redirect { target + 2 + (1 - level) } else { (ptr2 & 511) + accepted }
    const flag2 = if redirect { flag } else { ptr2 >> 9 }
    if resetting { ptr2 = 2 }
    else { ptr2 = if value2 >= 352 { ((flag2 ^ 1) << 9) | (value2 - 352) } else { (flag2 << 9) | value2 } }
    const value3 = if redirect { target + 3 + (1 - level) } else { (ptr3 & 511) + accepted }
    const flag3 = if redirect { flag } else { ptr3 >> 9 }
    if resetting { ptr3 = 3 }
    else { ptr3 = if value3 >= 352 { ((flag3 ^ 1) << 9) | (value3 - 352) } else { (flag3 << 9) | value3 } }
    const value4 = if redirect { target + 4 + (1 - level) } else { (ptr4 & 511) + accepted }
    const flag4 = if redirect { flag } else { ptr4 >> 9 }
    if resetting { ptr4 = 4 }
    else { ptr4 = if value4 >= 352 { ((flag4 ^ 1) << 9) | (value4 - 352) } else { (flag4 << 9) | value4 } }
    const value5 = if redirect { target + 5 + (1 - level) } else { (ptr5 & 511) + accepted }
    const flag5 = if redirect { flag } else { ptr5 >> 9 }
    if resetting { ptr5 = 5 }
    else { ptr5 = if value5 >= 352 { ((flag5 ^ 1) << 9) | (value5 - 352) } else { (flag5 << 9) | value5 } }
    const value6 = if redirect { target + 6 + (1 - level) } else { (ptr6 & 511) + accepted }
    const flag6 = if redirect { flag } else { ptr6 >> 9 }
    if resetting { ptr6 = 6 }
    else { ptr6 = if value6 >= 352 { ((flag6 ^ 1) << 9) | (value6 - 352) } else { (flag6 << 9) | value6 } }
    const value7 = if redirect { target + 7 + (1 - level) } else { (ptr7 & 511) + accepted }
    const flag7 = if redirect { flag } else { ptr7 >> 9 }
    if resetting { ptr7 = 7 }
    else { ptr7 = if value7 >= 352 { ((flag7 ^ 1) << 9) | (value7 - 352) } else { (flag7 << 9) | value7 } }
    step
    assert(((dut.io_out >> 0) & 1023) == ptr0, "ROB pointer 0 wrap, dispatch, or redirect")
    assert(((dut.io_out >> 10) & 1023) == ptr1, "ROB pointer 1 wrap, dispatch, or redirect")
    assert(((dut.io_out >> 20) & 1023) == ptr2, "ROB pointer 2 wrap, dispatch, or redirect")
    assert(((dut.io_out >> 30) & 1023) == ptr3, "ROB pointer 3 wrap, dispatch, or redirect")
    assert(((dut.io_out >> 40) & 1023) == ptr4, "ROB pointer 4 wrap, dispatch, or redirect")
    assert(((dut.io_out >> 50) & 1023) == ptr5, "ROB pointer 5 wrap, dispatch, or redirect")
    assert(((dut.io_out >> 60) & 1023) == ptr6, "ROB pointer 6 wrap, dispatch, or redirect")
    assert(((dut.io_out >> 70) & 1023) == ptr7, "ROB pointer 7 wrap, dispatch, or redirect")
  }
}
