// Suite configuration: mirrors ../verilog/picorv32_top.v.
const picorv32 = import("picorv32.picorv32")

pub mod picorv32_top::[
  timecheck=false
](
  clk:Clock,
  irq:U32,
  mem_rdata:U32,
  mem_ready:U1,
  resetn:U1,
) -> (eoi:U32@[], mem_addr:U32@[], mem_instr:U1@[], mem_valid:U1@[], mem_wdata:U32@[], mem_wstrb:U4@[], trap:U1@[]) {
  mut cpu = picorv32(
    resetn=resetn == 1,
    mem_ready=mem_ready == 1,
    mem_rdata=mem_rdata,
    pcpi_wr=false,
    pcpi_rd=0,
    pcpi_wait=false,
    pcpi_ready=false,
    irq=irq,
  )
  trap      = U1(cpu.trap)
  mem_valid = U1(cpu.mem_valid)
  mem_instr = U1(cpu.mem_instr)
  mem_addr  = cpu.mem_addr
  mem_wdata = cpu.mem_wdata
  mem_wstrb = cpu.mem_wstrb
  eoi       = cpu.eoi
}
