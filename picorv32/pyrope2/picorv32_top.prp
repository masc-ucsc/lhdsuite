// Suite configuration: mirrors ../verilog/picorv32_top.v.
const picorv32 = import("picorv32.picorv32")

pub mod picorv32_top::[timecheck=false](
  clk:u1, resetn:bool, mem_ready:bool, mem_rdata:u32, irq:u32
) -> (
  trap:bool@[], mem_valid:bool@[], mem_instr:bool@[],
  mem_addr:u32@[], mem_wdata:u32@[], mem_wstrb:u4@[], eoi:u32@[]
) {
  mut cpu = picorv32(
    clk=clk, resetn=resetn, mem_ready=mem_ready, mem_rdata=mem_rdata,
    pcpi_wr=false, pcpi_rd=0, pcpi_wait=false, pcpi_ready=false, irq=irq
  )
  trap = cpu.trap
  mem_valid = cpu.mem_valid
  mem_instr = cpu.mem_instr
  mem_addr = cpu.mem_addr
  mem_wdata = cpu.mem_wdata
  mem_wstrb = cpu.mem_wstrb
  eoi = cpu.eoi
}
