// Operations shared by the barrel shifter and the iterative shift state.
pub comb shift_word(value:u32, amount:u5, left:bool, arithmetic:bool) -> (result:u32) {
  // A leading sign bit lets one right shifter serve SRL and SRA.
  const sign:u1 = if arithmetic { value#[31] } else { 0 }
  const extended = ((sign << 32) | value)#sext[0..=32]
  wrap result = if left { value << amount } else { extended >> amount }
}

// Pure ALU primitives. The caller owns optional pipeline registers.
pub comb alu_operands(a, b, subtract, arithmetic) -> (add_sub:u32, eq:bool, lts:bool, ltu:bool, shl:u32, shr:u32) {
  wrap add_sub = if subtract { a - b } else { a + b }
  eq = a == b
  lts = a#sext[0..=31] < b#sext[0..=31]
  ltu = a < b
  shl = shift_word(value=a, amount=b#[0..=4], left=true, arithmetic=false)
  shr = shift_word(value=a, amount=b#[0..=4], left=false, arithmetic=arithmetic)
}
