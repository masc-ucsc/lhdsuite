const picorv32 = import("picorv32.picorv32")

pub mod picorv32_top::[timecheck=false](clk:Clock, resetn:U1, mem_ready:U1, mem_rdata:U32, irq:U32) -> (trap:U1@[], mem_valid:U1@[], mem_instr:U1@[], mem_addr:U32@[], mem_wdata:U32@[], mem_wstrb:U4@[], eoi:U32@[]) {
  mut cpu = picorv32::[name=cpu](clk = clk, resetn = resetn, mem_ready = mem_ready, mem_rdata = mem_rdata, pcpi_wr = 0, pcpi_rd = 0, pcpi_wait = 0, pcpi_ready = 0, irq = irq)
  trap = cpu.trap
  mem_valid = cpu.mem_valid
  mem_instr = cpu.mem_instr
  mem_addr = cpu.mem_addr
  mem_wdata = cpu.mem_wdata
  mem_wstrb = cpu.mem_wstrb
  eoi = cpu.eoi
}
