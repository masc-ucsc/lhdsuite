// PicoRV32, maintained Pyrope translation of ../verilog/picorv32.v (ISC).
// Defaults reproduce picorv32_top.v, including RVC and the barrel shifter.
// Global constants below control real elaboration paths. The remaining
// configuration is RV32 with 32 registers, no PCPI/M/D/IRQ/trace extension,
// and a single-cycle ALU/comparator. See ../README.md for scope and checks.
// Keep nonblocking register reads and old-data register-file ordering intact.

// Configuration: edit these compile-time constants to select the core features.
comptime const ENABLE_COUNTERS:bool = true
comptime const ENABLE_COUNTERS64:bool = true
comptime const ENABLE_REGS_DUALPORT:bool = true
comptime const LATCHED_MEM_RDATA:bool = false
comptime const TWO_STAGE_SHIFT:bool = true
comptime const BARREL_SHIFTER:bool = true
comptime const COMPRESSED_ISA:bool = true
comptime const CATCH_MISALIGN:bool = true
comptime const CATCH_ILLINSN:bool = true
comptime const PROGADDR_RESET:u32 = 0
comptime const STACKADDR:u32 = 0xffffffff
comptime const DEBUG:bool = false

comptime const CPU_TRAP:u8 = 0x80
comptime const CPU_FETCH:u8 = 0x40
comptime const CPU_LD_RS1:u8 = 0x20
comptime const CPU_LD_RS2:u8 = 0x10
comptime const CPU_EXEC:u8 = 0x08
comptime const CPU_SHIFT:u8 = 0x04
comptime const CPU_STMEM:u8 = 0x02
comptime const CPU_LDMEM:u8 = 0x01

pub mod picorv32::[timecheck=false](
  clk:u1, resetn:u1, mem_ready:u1, mem_rdata:u32,
  pcpi_wr:u1, pcpi_rd:u32, pcpi_wait:u1, pcpi_ready:u1, irq:u32
) -> (
  trap:u1@[], mem_valid:u1@[], mem_instr:u1@[],
  mem_addr:u32@[], mem_wdata:u32@[], mem_wstrb:u4@[],
  mem_la_read:u1@[], mem_la_write:u1@[], mem_la_addr:u32@[],
  mem_la_wdata:u32@[], mem_la_wstrb:u4@[],
  pcpi_valid:u1@[], pcpi_insn:u32@[], pcpi_rs1:u32@[], pcpi_rs2:u32@[],
  eoi:u32@[], trace_valid:u1@[], trace_data:u36@[]
) {

  cassert(PROGADDR_RESET >= 0 and PROGADDR_RESET <= 0xffffffff)
  cassert(STACKADDR >= 0 and STACKADDR <= 0xffffffff)

  // State. Registers without a reset keep their original unknown power-on value.
  reg trap:u1 = nil
  reg mem_valid:u1 = nil
  reg mem_instr:u1 = nil
  reg mem_addr:u32 = nil
  reg mem_wdata:u32 = nil
  reg mem_wstrb:u4 = nil
  reg mem_la_wdata:u32:[latch=true] = nil
  reg mem_la_wstrb:u4:[latch=true] = nil
  reg pcpi_valid:u1 = nil
  reg pcpi_insn:u32 = nil
  reg eoi:u32 = nil
  reg trace_valid:u1 = nil
  reg trace_data:u36 = nil
  reg count_cycle:u64 = nil
  reg count_instr:u64 = nil
  reg reg_pc:u32 = nil
  reg reg_next_pc:u32 = nil
  reg reg_op1:u32 = nil
  reg reg_op2:u32 = nil
  reg reg_out:u32 = nil
  reg reg_sh:u5 = nil
  reg next_insn_opcode:u32 = nil
  reg irq_active:u1 = nil
  reg irq_mask:u32 = nil
  reg irq_pending:u32 = nil
  reg timer:u32 = nil
  reg cpuregs:[32]u32:[ordering="old"] = nil
  reg mem_state:u2 = nil
  reg mem_wordsize:u2 = nil
  reg mem_rdata_word:u32:[latch=true] = nil
  reg mem_rdata_q:u32 = nil
  reg mem_do_prefetch:u1 = nil
  reg mem_do_rinst:u1 = nil
  reg mem_do_rdata:u1 = nil
  reg mem_do_wdata:u1 = nil
  reg mem_la_secondword:u1 = nil
  reg mem_la_firstword_reg:u1 = nil
  reg last_mem_valid:u1 = nil
  reg prefetched_high_word:u1 = nil
  reg mem_16bit_buffer:u16 = nil
  reg instr_lui:u1 = nil
  reg instr_auipc:u1 = nil
  reg instr_jal:u1 = nil
  reg instr_jalr:u1 = nil
  reg instr_beq:u1 = nil
  reg instr_bne:u1 = nil
  reg instr_blt:u1 = nil
  reg instr_bge:u1 = nil
  reg instr_bltu:u1 = nil
  reg instr_bgeu:u1 = nil
  reg instr_lb:u1 = nil
  reg instr_lh:u1 = nil
  reg instr_lw:u1 = nil
  reg instr_lbu:u1 = nil
  reg instr_lhu:u1 = nil
  reg instr_sb:u1 = nil
  reg instr_sh:u1 = nil
  reg instr_sw:u1 = nil
  reg instr_addi:u1 = nil
  reg instr_slti:u1 = nil
  reg instr_sltiu:u1 = nil
  reg instr_xori:u1 = nil
  reg instr_ori:u1 = nil
  reg instr_andi:u1 = nil
  reg instr_slli:u1 = nil
  reg instr_srli:u1 = nil
  reg instr_srai:u1 = nil
  reg instr_add:u1 = nil
  reg instr_sub:u1 = nil
  reg instr_sll:u1 = nil
  reg instr_slt:u1 = nil
  reg instr_sltu:u1 = nil
  reg instr_xor:u1 = nil
  reg instr_srl:u1 = nil
  reg instr_sra:u1 = nil
  reg instr_or:u1 = nil
  reg instr_and:u1 = nil
  reg instr_rdcycle:u1 = nil
  reg instr_rdcycleh:u1 = nil
  reg instr_rdinstr:u1 = nil
  reg instr_rdinstrh:u1 = nil
  reg instr_ecall_ebreak:u1 = nil
  reg instr_fence:u1 = nil
  reg instr_getq:u1 = nil
  reg instr_setq:u1 = nil
  reg instr_retirq:u1 = nil
  reg instr_maskirq:u1 = nil
  reg instr_waitirq:u1 = nil
  reg instr_timer:u1 = nil
  reg decoded_rd:u5 = nil
  reg decoded_rs1:u5 = nil
  reg decoded_rs2:u5 = nil
  reg decoded_imm:u32 = nil
  reg decoded_imm_j:u32 = nil
  reg decoder_trigger:u1 = nil
  reg decoder_trigger_q:u1 = nil
  reg decoder_pseudo_trigger:u1 = nil
  reg decoder_pseudo_trigger_q:u1 = nil
  reg compressed_instr:u1 = nil
  reg is_lui_auipc_jal:u1 = nil
  reg is_lb_lh_lw_lbu_lhu:u1 = nil
  reg is_slli_srli_srai:u1 = nil
  reg is_jalr_addi_slti_sltiu_xori_ori_andi:u1 = nil
  reg is_sb_sh_sw:u1 = nil
  reg is_sll_srl_sra:u1 = nil
  reg is_lui_auipc_jal_jalr_addi_add_sub:u1 = nil
  reg is_slti_blt_slt:u1 = nil
  reg is_sltiu_bltu_sltu:u1 = nil
  reg is_beq_bne_blt_bge_bltu_bgeu:u1 = nil
  reg is_lbu_lhu_lw:u1 = nil
  reg is_alu_reg_imm:u1 = nil
  reg is_alu_reg_reg:u1 = nil
  reg is_compare:u1 = nil
  reg cpu_state:u8 = nil
  reg irq_state:u2 = nil
  reg latched_store:u1 = nil
  reg latched_stalu:u1 = nil
  reg latched_branch:u1 = nil
  reg latched_compr:u1 = nil
  reg latched_is_lu:u1 = nil
  reg latched_is_lh:u1 = nil
  reg latched_is_lb:u1 = nil
  reg latched_rd:u5 = nil
  reg pcpi_timeout:u1 = nil
  reg do_waitirq:u1 = nil
  reg alu_out_q:u32 = nil
  reg alu_out_0_q:u1 = nil
  reg clear_prefetched_high_word_q:u1 = nil
  mut set_mem_do_rinst:u1 = 0
  mut set_mem_do_rdata:u1 = 0
  mut set_mem_do_wdata:u1 = 0
  mut current_pc:u32 = 0
  mut next_irq_pending:u32 = 0
  mut alu_out_0:u1 = 0
  mut cpuregs_write:u1 = 0
  mut cpuregs_wrdata:u32 = 0
  mut cpuregs_rs1:u32 = 0
  mut cpuregs_rs2:u32 = 0
  mut clear_prefetched_high_word = 0ub?
  mut alu_out:u32 = 0sb?

  // Memory byte lanes and instruction validity.
  const next_pcpi_rs1 = reg_op1
  const next_pcpi_rs2 = reg_op2
  const next_mem_la_write = unsigned((resetn != 0) and (mem_state == 0) and (mem_do_wdata != 0))
  match mem_wordsize {
    == 0 {
      mem_la_wdata = reg_op2
      mem_la_wstrb = 15
      mem_rdata_word = mem_rdata
    }
    == 1 {
      const store_halfword = reg_op2#[0..=15]
      mem_la_wdata = store_halfword | (store_halfword << 16)
      mem_la_wstrb = if reg_op1#[1] != 0 { 12 } else { 3 }
      const halfword_lane = reg_op1#[1]
      mem_rdata_word = unique if halfword_lane == 0 {
        mem_rdata#[0..=15]
      } elif halfword_lane == 1 {
        mem_rdata#[16..=31]
      } else {
        0sb?
      }
    }
    == 2 {
      const store_byte = reg_op2#[0..=7]
      mem_la_wdata = store_byte | (store_byte << 8) | (store_byte << 16) | (store_byte << 24)
      mem_la_wstrb = (1 << reg_op1#[0..=1])#[0..=3]
      mem_rdata_word = unique if reg_op1#[0..=1] == 0 {
        mem_rdata#[0..=7]
      } elif reg_op1#[0..=1] == 1 {
        mem_rdata#[8..=15]
      } elif reg_op1#[0..=1] == 2 {
        mem_rdata#[16..=23]
      } elif reg_op1#[0..=1] == 3 {
        mem_rdata#[24..=31]
      } else {
        0sb?
      }
    }
    else {
      mem_la_wdata = 0sb?
      mem_la_wstrb = 0sb?
      mem_rdata_word = 0sb?
    }
  }
  const instr_trap = unsigned(CATCH_ILLINSN and ((
    instr_lui | instr_auipc | instr_jal | instr_jalr | instr_beq | instr_bne |
    instr_blt | instr_bge | instr_bltu | instr_bgeu | instr_lb | instr_lh |
    instr_lw | instr_lbu | instr_lhu | instr_sb | instr_sh | instr_sw |
    instr_addi | instr_slti | instr_sltiu | instr_xori | instr_ori | instr_andi |
    instr_slli | instr_srli | instr_srai | instr_add | instr_sub | instr_sll |
    instr_slt | instr_sltu | instr_xor | instr_srl | instr_sra | instr_or |
    instr_and | instr_rdcycle | instr_rdcycleh | instr_rdinstr | instr_rdinstrh | instr_fence |
    instr_getq | instr_setq | instr_retirq | instr_maskirq | instr_waitirq | instr_timer
  ) == 0))

  // ALU and register-file writeback.
  const next_pc:u32 = if (latched_store != 0) and (latched_branch != 0) {
    reg_out & 0xfffffffe
  } else {
    reg_next_pc
  }
  const alu_add_sub:u32 = if instr_sub != 0 {
    (reg_op1 - reg_op2)#[0..=31]
  } else {
    (reg_op1 + reg_op2)#[0..=31]
  }
  const alu_eq = unsigned(reg_op1 == reg_op2)
  const alu_lts = unsigned(reg_op1#sext[0..=31] < reg_op2#sext[0..=31])
  const alu_ltu = unsigned(reg_op1 < reg_op2)
  const shift_sign:u1 = if (instr_sra != 0) or (instr_srai != 0) { reg_op1#[31] } else { 0 }
  alu_out_0 = 0ub?
  if instr_beq != 0 {
    alu_out_0 = alu_eq
  } elif instr_bne != 0 {
    alu_out_0 = unsigned(alu_eq == 0)
  } elif instr_bge != 0 {
    alu_out_0 = unsigned(alu_lts == 0)
  } elif instr_bgeu != 0 {
    alu_out_0 = unsigned(alu_ltu == 0)
  } elif ((is_slti_blt_slt != 0)) {
    alu_out_0 = alu_lts
  } elif ((is_sltiu_bltu_sltu != 0)) {
    alu_out_0 = alu_ltu
  } else {
    alu_out_0 = 0ub?
  }
  alu_out = if is_lui_auipc_jal_jalr_addi_add_sub != 0 {
    alu_add_sub
  } elif is_compare != 0 {
    alu_out_0
  } elif ((instr_xori != 0) or (instr_xor != 0)) {
    reg_op1 ^ reg_op2
  } elif ((instr_ori != 0) or (instr_or != 0)) {
    reg_op1 | reg_op2
  } elif ((instr_andi != 0) or (instr_and != 0)) {
    reg_op1 & reg_op2
  } elif (BARREL_SHIFTER and ((instr_sll != 0) or (instr_slli != 0))) {
    (reg_op1 << reg_op2#[0..=4])#[0..=31]
  } elif (BARREL_SHIFTER and ((instr_srl != 0) or (instr_srli != 0) or (instr_sra != 0) or (instr_srai != 0))) {
    ((((shift_sign & 1) << 32) | reg_op1)#sext[0..=32] >> reg_op2#[0..=4])#[0..=31]
  } else {
    0sb?
  }
  clear_prefetched_high_word = if prefetched_high_word == 0 { 0 } else { clear_prefetched_high_word_q }
  if (latched_branch != 0) or (irq_state != 0) or (resetn == 0) {
    clear_prefetched_high_word = if COMPRESSED_ISA { 1 } else { 0 }
  }
  cpuregs_wrdata = 0sb?
  cpuregs_write = 0
  if cpu_state == CPU_FETCH {
    if latched_branch != 0 {
      const return_offset = if latched_compr != 0 { 2 } else { 4 }
      cpuregs_wrdata = (reg_pc + return_offset)#[0..=31]
      cpuregs_write = 1
    } elif ((latched_store != 0) and (latched_branch == 0)) {
      cpuregs_wrdata = if latched_stalu != 0 { alu_out_q } else { reg_out }
      cpuregs_write = 1
    }
  }
  if (resetn != 0) and (cpuregs_write != 0) and (latched_rd != 0) {
    cpuregs[latched_rd] = cpuregs_wrdata
  }
  if ENABLE_REGS_DUALPORT {
    cpuregs_rs1 = if decoded_rs1 != 0 { cpuregs[decoded_rs1] } else { 0 }
    cpuregs_rs2 = if decoded_rs2 != 0 { cpuregs[decoded_rs2] } else { 0 }
  } else {
    const decoded_rs = if cpu_state == CPU_LD_RS2 { decoded_rs2 } else { decoded_rs1 }
    cpuregs_rs1 = if decoded_rs != 0 { cpuregs[decoded_rs] } else { 0 }
    cpuregs_rs2 = cpuregs_rs1
  }

  // Instruction fetch and compressed-word assembly.
  const launch_next_insn = unsigned((cpu_state == CPU_FETCH) and (decoder_trigger != 0))
  if DEBUG and (launch_next_insn != 0) {
    puts("picorv32 decode: pc={reg_pc} opcode={next_insn_opcode} rd={decoded_rd} rs1={decoded_rs1} rs2={decoded_rs2}")
  }
  const mem_la_firstword = unsigned(COMPRESSED_ISA and ((mem_do_prefetch != 0) or (mem_do_rinst != 0)) and
    (next_pc#[1] != 0) and (mem_la_secondword == 0))
  const mem_la_use_prefetched_high_word = unsigned(COMPRESSED_ISA and (mem_la_firstword != 0) and
    (prefetched_high_word != 0) and (clear_prefetched_high_word == 0))
  const mem_xfer = unsigned(((mem_valid != 0) and (mem_ready != 0)) or ((mem_la_use_prefetched_high_word != 0) and
    (mem_do_rinst != 0)))
  const mem_rdata_latched_noshuffle:u32 = if (mem_xfer != 0) or LATCHED_MEM_RDATA {
    mem_rdata
  } else {
    mem_rdata_q
  }
  const firstword_rdata:u32 = if COMPRESSED_ISA and (mem_la_firstword != 0) {
    (0sb?#[0..=15] << 16) | mem_rdata_latched_noshuffle#[16..=31]
  } else {
    mem_rdata_latched_noshuffle
  }
  const secondword_rdata:u32 = if COMPRESSED_ISA and (mem_la_secondword != 0) {
    (mem_rdata_latched_noshuffle#[0..=15] << 16) | mem_16bit_buffer
  } else {
    firstword_rdata
  }
  const mem_rdata_latched:u32 = if COMPRESSED_ISA and (mem_la_use_prefetched_high_word != 0) {
    (0sb?#[0..=15] << 16) | mem_16bit_buffer
  } else {
    secondword_rdata
  }
  if resetn == 0 {
    mem_la_firstword_reg = 0
    last_mem_valid = 0
  } else {
    if last_mem_valid == 0 {
      mem_la_firstword_reg = mem_la_firstword
    }
    last_mem_valid = unsigned((mem_valid != 0) and (mem_ready == 0))
  }
  clear_prefetched_high_word_q = clear_prefetched_high_word
  const firstword_pending:u1 = if last_mem_valid == 0 {
    mem_la_firstword & 1
  } else {
    mem_la_firstword_reg & 1
  }
  const mem_done = unsigned((resetn != 0) and (((mem_xfer != 0) and (mem_state != 0) and ((mem_do_rinst != 0) or
    (mem_do_rdata != 0) or (mem_do_wdata != 0))) or ((mem_state == 3) and (mem_do_rinst != 0))) and
    ((mem_la_firstword == 0) or ((mem_rdata_latched#[0..=1] != 3) and (mem_xfer != 0))))
  const next_mem_la_read = unsigned((resetn != 0) and (((mem_la_use_prefetched_high_word == 0) and
    (mem_state == 0) and ((mem_do_rinst != 0) or (mem_do_prefetch != 0) or (mem_do_rdata != 0))) or
    (COMPRESSED_ISA and (mem_xfer != 0) and (firstword_pending != 0) and (mem_la_secondword == 0) and
    (mem_rdata_latched#[0..=1] == 3))))
  const next_mem_la_addr:u32 = if (mem_do_prefetch != 0) or (mem_do_rinst != 0) {
    (next_pc#[2..=31] + unsigned(COMPRESSED_ISA and (mem_xfer != 0) and (firstword_pending != 0)))#[0..=29] << 2
  } else {
    reg_op1#[2..=31] << 2
  }
  if mem_xfer != 0 {
    mem_rdata_q = if COMPRESSED_ISA { mem_rdata_latched } else { mem_rdata }
    next_insn_opcode = if COMPRESSED_ISA { mem_rdata_latched } else { mem_rdata }
  }

  // Expand RVC encodings into the ordinary decoder fields.
  if COMPRESSED_ISA and (mem_done != 0) and ((mem_do_prefetch != 0) or (mem_do_rinst != 0)) {
    match mem_rdata_latched#[0..=1] {
      == 0 {
        match mem_rdata_latched#[13..=15] {
          == 0 {
            mem_rdata_q#[12..=14] = 0
            mem_rdata_q#[20..=31] = (mem_rdata_latched#[7..=10] << 6) | (mem_rdata_latched#[11..=12] << 4) | (mem_rdata_latched#[5] << 3) | (mem_rdata_latched#[6] << 2)
          }
          == 2 {
            mem_rdata_q#[20..=31] = (mem_rdata_latched#[5] << 6) | (mem_rdata_latched#[10..=12] << 3) | (mem_rdata_latched#[6] << 2)
            mem_rdata_q#[12..=14] = 2
          }
          == 6 {
            const compressed_load_offset = (mem_rdata_latched#[5] << 6) | (mem_rdata_latched#[10..=12] << 3) | (mem_rdata_latched#[6] << 2)
            mem_rdata_q#[7..=11] = compressed_load_offset#[0..=4]
            mem_rdata_q#[25..=31] = (compressed_load_offset >> 5)#[0..=6]
            mem_rdata_q#[12..=14] = 2
          }
          else {
          }
        }
      }
      == 1 {
        match mem_rdata_latched#[13..=15] {
          == 0 {
            mem_rdata_q#[12..=14] = 0
            mem_rdata_q#[20..=31] = ((mem_rdata_latched#[12] << 5) | mem_rdata_latched#[2..=6])#sext[0..=5]#[0..=11]
          }
          == 2 {
            mem_rdata_q#[12..=14] = 0
            mem_rdata_q#[20..=31] = ((mem_rdata_latched#[12] << 5) | mem_rdata_latched#[2..=6])#sext[0..=5]#[0..=11]
          }
          == 3 {
            if mem_rdata_latched#[7..=11] == 2 {
              mem_rdata_q#[12..=14] = 0
              mem_rdata_q#[20..=31] = ((mem_rdata_latched#[12] << 9) | (mem_rdata_latched#[3..=4] << 7) |
                (mem_rdata_latched#[5] << 6) | (mem_rdata_latched#[2] << 5) | (mem_rdata_latched#[6] << 4))#sext[0..=9]#[0..=11]
            } else {
              mem_rdata_q#[12..=31] = ((mem_rdata_latched#[12] << 5) | mem_rdata_latched#[2..=6])#sext[0..=5]#[0..=19]
            }
          }
          == 4 {
            if mem_rdata_latched#[10..=11] == 0 {
              mem_rdata_q#[25..=31] = 0
              mem_rdata_q#[12..=14] = 5
            }
            if mem_rdata_latched#[10..=11] == 1 {
              mem_rdata_q#[25..=31] = 32
              mem_rdata_q#[12..=14] = 5
            }
            if mem_rdata_latched#[10..=11] == 2 {
              mem_rdata_q#[12..=14] = 7
              mem_rdata_q#[20..=31] = ((mem_rdata_latched#[12] << 5) | mem_rdata_latched#[2..=6])#sext[0..=5]#[0..=11]
            }
            if mem_rdata_latched#[10..=12] == 3 {
              if mem_rdata_latched#[5..=6] == 0 {
                mem_rdata_q#[12..=14] = 0
              }
              if mem_rdata_latched#[5..=6] == 1 {
                mem_rdata_q#[12..=14] = 4
              }
              if mem_rdata_latched#[5..=6] == 2 {
                mem_rdata_q#[12..=14] = 6
              }
              if mem_rdata_latched#[5..=6] == 3 {
                mem_rdata_q#[12..=14] = 7
              }
              mem_rdata_q#[25..=31] = if mem_rdata_latched#[5..=6] == 0 { 32 } else { 0 }
            }
          }
          == 6 {
            mem_rdata_q#[12..=14] = 0
            mem_rdata_q#[8..=11] = ((mem_rdata_latched#[12] << 7) | (mem_rdata_latched#[5..=6] << 5) |
              (mem_rdata_latched#[2] << 4) | (mem_rdata_latched#[10..=11] << 2) | mem_rdata_latched#[3..=4])#sext[0..=7]#[0..=11]#[0..=3]
            mem_rdata_q#[25..=30] = (((mem_rdata_latched#[12] << 7) | (mem_rdata_latched#[5..=6] << 5) |
              (mem_rdata_latched#[2] << 4) | (mem_rdata_latched#[10..=11] << 2) | mem_rdata_latched#[3..=4])#sext[0..=7]#[0..=11] >> 4)#[0..=5]
