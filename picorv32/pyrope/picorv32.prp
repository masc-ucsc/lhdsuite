    instr_or = 0
    instr_and = 0
    instr_fence = 0
  }
  trap = 0
  reg_sh = 0sb?
  reg_out = 0sb?

  // CPU state machine and counter maintenance.
  alu_out_0_q = alu_out_0
  alu_out_q = alu_out
  if ENABLE_COUNTERS {
    count_cycle = if resetn != 0 { (count_cycle + 1)#[0..=63] } else { 0 }
    if not ENABLE_COUNTERS64 { count_cycle#[32..=63] = 0 }
  } else {
    count_cycle = 0sb?
    count_instr = 0sb?
  }
  decoder_trigger = unsigned((mem_do_rinst != 0) and (mem_done != 0))
  decoder_trigger_q = decoder_trigger
  decoder_pseudo_trigger = 0
  decoder_pseudo_trigger_q = decoder_pseudo_trigger
  do_waitirq = 0
  trace_valid = 0
  trace_data = 0sb?
  set_mem_do_wdata = 0
  set_mem_do_rdata = 0
  next_irq_pending = 0sb?
  set_mem_do_rinst = 0
  if resetn == 0 {
    reg_pc = PROGADDR_RESET
    reg_next_pc = PROGADDR_RESET
    if ENABLE_COUNTERS { count_instr = 0 }
    latched_store = 0
    latched_stalu = 0
    latched_branch = 0
    latched_is_lu = 0
    latched_is_lh = 0
    latched_is_lb = 0
    pcpi_valid = 0
    pcpi_timeout = 0
    irq_active = 0
    irq_mask = 0xffffffff
    next_irq_pending = 0
    irq_state = 0
    eoi = 0
    timer = 0
    if STACKADDR != 0xffffffff {
      latched_store = 1
      latched_rd = 2
      reg_out = STACKADDR
    }
    cpu_state = CPU_FETCH
  } else {
    match cpu_state {
      == CPU_TRAP {
        trap = 1
      }
      == CPU_FETCH {
        mem_do_rinst = unsigned((decoder_trigger == 0) and (do_waitirq == 0))
        mem_wordsize = 0
        current_pc = reg_next_pc
        if latched_branch != 0 {
          const branch_target = if latched_stalu != 0 { alu_out_q } else { reg_out }
          current_pc = if latched_store != 0 { branch_target & 0xfffffffe } else { reg_next_pc }
        }
        reg_pc = current_pc
        reg_next_pc = current_pc
        latched_store = 0
        latched_stalu = 0
        latched_branch = 0
        latched_is_lu = 0
        latched_is_lh = 0
        latched_is_lb = 0
        latched_rd = decoded_rd
        latched_compr = compressed_instr
        if decoder_trigger != 0 {
          const instruction_bytes = if compressed_instr != 0 { 2 } else { 4 }
          wrap reg_next_pc = (current_pc + instruction_bytes)
          if ENABLE_COUNTERS {
            count_instr = (count_instr + 1)#[0..=63]
            if not ENABLE_COUNTERS64 { count_instr#[32..=63] = 0 }
          }
          if instr_jal != 0 {
            mem_do_rinst = 1
            wrap reg_next_pc = current_pc + decoded_imm_j
            latched_branch = 1
          } else {
            mem_do_rinst = 0
            mem_do_prefetch = unsigned((instr_jalr == 0) and (instr_retirq == 0))
            cpu_state = CPU_LD_RS1
          }
        }
      }
      == CPU_LD_RS1 {
        reg_op1 = 0sb?
        reg_op2 = 0sb?
        if (CATCH_ILLINSN and (instr_trap != 0)) {
          cpu_state = CPU_TRAP
        } elif (ENABLE_COUNTERS and (unsigned((((instr_rdcycle & 1) << 3) | ((instr_rdcycleh & 1) << 2) |
          ((instr_rdinstr & 1) << 1) | (instr_rdinstrh & 1)) != 0) != 0)) {
          reg_out = if instr_rdcycle != 0 {
            count_cycle#[0..=31]
          } elif ((instr_rdcycleh != 0) and ENABLE_COUNTERS64) {
            count_cycle#[32..=63]
          } elif instr_rdinstr != 0 {
            count_instr#[0..=31]
          } elif ((instr_rdinstrh != 0) and ENABLE_COUNTERS64) {
            count_instr#[32..=63]
          } else {
            0sb?
          }
          latched_store = 1
          cpu_state = CPU_FETCH
        } elif is_lui_auipc_jal != 0 {
          reg_op1 = if instr_lui != 0 { 0 } else { reg_pc }
          reg_op2 = decoded_imm
          mem_do_rinst = mem_do_prefetch
          cpu_state = CPU_EXEC
        } elif ((is_lb_lh_lw_lbu_lhu != 0) and (instr_trap == 0)) {
          reg_op1 = cpuregs_rs1
          cpu_state = CPU_LDMEM
          mem_do_rinst = 1
        } elif ((is_slli_srli_srai != 0) and not BARREL_SHIFTER) {
          reg_op1 = cpuregs_rs1
          reg_sh = decoded_rs2
          cpu_state = CPU_SHIFT
        } elif (is_jalr_addi_slti_sltiu_xori_ori_andi != 0) or (((is_slli_srli_srai != 0) and BARREL_SHIFTER)) {
          reg_op1 = cpuregs_rs1
          reg_op2 = if (is_slli_srli_srai != 0) and BARREL_SHIFTER { decoded_rs2 } else { decoded_imm }
          mem_do_rinst = mem_do_prefetch
          cpu_state = CPU_EXEC
        } else {
          reg_op1 = cpuregs_rs1
          if ENABLE_REGS_DUALPORT {
            reg_sh = cpuregs_rs2#[0..=4]
            reg_op2 = cpuregs_rs2
            if is_sb_sh_sw != 0 {
              cpu_state = CPU_STMEM
              mem_do_rinst = 1
            } elif ((is_sll_srl_sra != 0) and not BARREL_SHIFTER) {
              cpu_state = CPU_SHIFT
            } else {
              mem_do_rinst = mem_do_prefetch
              cpu_state = CPU_EXEC
            }
          } else {
            cpu_state = CPU_LD_RS2
          }
        }
      }
      == CPU_LD_RS2 {
        reg_sh = cpuregs_rs2#[0..=4]
        reg_op2 = cpuregs_rs2
        if is_sb_sh_sw != 0 {
          cpu_state = CPU_STMEM
          mem_do_rinst = 1
        } elif ((is_sll_srl_sra != 0) and not BARREL_SHIFTER) {
          cpu_state = CPU_SHIFT
        } else {
          mem_do_rinst = mem_do_prefetch
          cpu_state = CPU_EXEC
        }
      }
      == CPU_EXEC {
        reg_out = (reg_pc + decoded_imm)#[0..=31]
        if is_beq_bne_blt_bge_bltu_bgeu != 0 {
          latched_rd = 0
          latched_store = alu_out_0 & 1
          latched_branch = alu_out_0 & 1
          if mem_done != 0 {
            cpu_state = CPU_FETCH
          }
          const branch_taken = alu_out_0 & 1
          if branch_taken != 0 {
            decoder_trigger = 0
            set_mem_do_rinst = 1
          }
        } else {
          latched_branch = instr_jalr
          latched_store = 1
          latched_stalu = 1
          cpu_state = CPU_FETCH
        }
      }
      == CPU_SHIFT {
        latched_store = 1
        if reg_sh == 0 {
          reg_out = reg_op1
          mem_do_rinst = mem_do_prefetch
          cpu_state = CPU_FETCH
        } elif TWO_STAGE_SHIFT and (reg_sh >= 4) {
          if ((instr_slli != 0) or (instr_sll != 0)) {
            reg_op1 = (reg_op1 << 4)#[0..=31]
          } elif ((instr_srli != 0) or (instr_srl != 0)) {
            reg_op1 = reg_op1 >> 4
          } elif ((instr_srai != 0) or (instr_sra != 0)) {
            reg_op1 = (reg_op1#sext[0..=31] >> 4)#[0..=31]
          } else {
            reg_op1 = 0sb?
          }
          reg_sh = (reg_sh - 4)#[0..=31]#[0..=4]
        } else {
          if ((instr_slli != 0) or (instr_sll != 0)) {
            reg_op1 = (reg_op1 << 1)#[0..=31]
          } elif ((instr_srli != 0) or (instr_srl != 0)) {
            reg_op1 = reg_op1 >> 1
          } elif ((instr_srai != 0) or (instr_sra != 0)) {
            reg_op1 = (reg_op1#sext[0..=31] >> 1)#[0..=31]
          } else {
            reg_op1 = 0sb?
          }
          reg_sh = (reg_sh - 1)#[0..=31]#[0..=4]
        }
      }
      == CPU_STMEM {
        if (mem_do_prefetch == 0) or (mem_done != 0) {
          if mem_do_wdata == 0 {
            mem_wordsize = if instr_sb != 0 {
              2
            } elif instr_sh != 0 {
              1
            } elif instr_sw != 0 {
              0
            } else {
              0sb?
            }
            reg_op1 = (reg_op1 + decoded_imm)#[0..=31]
            set_mem_do_wdata = 1
          }
          if (mem_do_prefetch == 0) and (mem_done != 0) {
            cpu_state = CPU_FETCH
            decoder_trigger = 1
            decoder_pseudo_trigger = 1
          }
        }
      }
      == CPU_LDMEM {
        latched_store = 1
        if (mem_do_prefetch == 0) or (mem_done != 0) {
          if mem_do_rdata == 0 {
            mem_wordsize = if ((instr_lb != 0) or (instr_lbu != 0)) {
              2
            } elif ((instr_lh != 0) or (instr_lhu != 0)) {
              1
            } elif instr_lw != 0 {
              0
            } else {
              0sb?
            }
            latched_is_lu = is_lbu_lhu_lw
            latched_is_lh = instr_lh
            latched_is_lb = instr_lb
            reg_op1 = (reg_op1 + decoded_imm)#[0..=31]
            set_mem_do_rdata = 1
          }
          if (mem_do_prefetch == 0) and (mem_done != 0) {
            reg_out = if latched_is_lu != 0 {
              mem_rdata_word
            } elif latched_is_lh != 0 {
              mem_rdata_word#[0..=15]#sext[0..=15]#[0..=31]
            } elif latched_is_lb != 0 {
              mem_rdata_word#[0..=7]#sext[0..=7]#[0..=31]
            } else {
              0sb?
            }
            decoder_trigger = 1
            decoder_pseudo_trigger = 1
            cpu_state = CPU_FETCH
          }
        }
      }
      else {
        trap = 0ub?
        mem_do_rinst = 0ub?
        mem_wordsize = 0sb?
        current_pc = 0sb?
        irq_active = 0ub?
        eoi = 0sb?
        next_irq_pending = 0sb?
        trace_valid = 0ub?
        trace_data = 0sb?
        reg_pc = 0sb?
        reg_next_pc = 0sb?
        latched_store = 0ub?
        latched_stalu = 0ub?
        latched_branch = 0ub?
        latched_is_lu = 0ub?
        latched_is_lh = 0ub?
        latched_is_lb = 0ub?
        latched_rd = 0sb?
        latched_compr = 0ub?
        irq_state = 0sb?
        reg_out = 0sb?
        do_waitirq = 0ub?
        count_instr = 0sb?
        mem_do_prefetch = 0ub?
        cpu_state = 0sb?
        reg_op1 = 0sb?
        reg_op2 = 0sb?
        pcpi_valid = 0ub?
        reg_sh = 0sb?
        irq_mask = 0sb?
        timer = 0sb?
        decoder_trigger = 0ub?
        set_mem_do_rinst = 0ub?
        set_mem_do_wdata = 0ub?
        decoder_pseudo_trigger = 0ub?
        set_mem_do_rdata = 0ub?
      }
    }
  }

  // Alignment and illegal-instruction traps.
  if CATCH_MISALIGN and (resetn != 0) and ((mem_do_rdata != 0) or (mem_do_wdata != 0)) {
    if (mem_wordsize == 0) and (reg_op1#[0..=1] != 0) {
      cpu_state = CPU_TRAP
    }
    if (mem_wordsize == 1) and ((reg_op1 & 1) != 0) {
      cpu_state = CPU_TRAP
    }
  }
  const pc_misaligned = if COMPRESSED_ISA { reg_pc#[0] } else { unsigned(reg_pc#[0..=1] != 0) }
  if CATCH_MISALIGN and (resetn != 0) and (mem_do_rinst != 0) and (pc_misaligned != 0) {
    cpu_state = CPU_TRAP
  }
  if (resetn == 0) or (mem_done != 0) {
    mem_do_prefetch = 0
    mem_do_rinst = 0
    mem_do_rdata = 0
    mem_do_wdata = 0
  }
  if set_mem_do_rinst != 0 {
    mem_do_rinst = 1
  }
  if set_mem_do_rdata != 0 {
    mem_do_rdata = 1
  }
  if set_mem_do_wdata != 0 {
    mem_do_wdata = 1
  }
  if not CATCH_ILLINSN and (decoder_trigger_q != 0) and (decoder_pseudo_trigger_q == 0) and (instr_ecall_ebreak != 0) {
    cpu_state = CPU_TRAP
  }
  if not CATCH_MISALIGN {
    if COMPRESSED_ISA {
      reg_pc#[0] = 0
      reg_next_pc#[0] = 0
    } else {
      reg_pc#[0..=1] = 0
      reg_next_pc#[0..=1] = 0
    }
  }
  irq_pending = next_irq_pending
  mem_la_read = next_mem_la_read
  mem_la_write = next_mem_la_write
  mem_la_addr = next_mem_la_addr
  pcpi_rs1 = next_pcpi_rs1
  pcpi_rs2 = next_pcpi_rs2
}
