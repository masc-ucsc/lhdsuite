# lhdsuite bazel options.
#
# livehd's own .bazelrc does NOT apply when livehd is consumed as a bazel
# dependency, so the subset of flags its build requires is replicated here.
build --features=external_include_paths
build --repo_env=BAZEL_CONLYOPTS="-std=gnu17"
build --cxxopt="-std=c++23" --cxxopt="-fexceptions" --force_pic
build --action_env=BAZEL_CXXOPTS="-std=c++23"
# cvc5's bignum backend (@gmp, built from source) must ALWAYS compile
# optimized, even in -c dbg — see livehd/.bazelrc for the rationale.
build --per_file_copt=external/gmp[+~].*@-O2,-g0

# macOS needs 13.3+ for the C++23 features livehd uses.
build --enable_platform_specific_config
build:macos --linkopt="-mmacosx-version-min=13.3"
build:macos --copt="-mmacosx-version-min=13.3"
build:macos --cxxopt="-mmacosx-version-min=13.3"
build:macos --host_linkopt="-mmacosx-version-min=13.3"
build:macos --host_copt="-mmacosx-version-min=13.3"
build:darwin --config=macos

# This suite measures speed as much as correctness: default to an optimized
# lhd. (Override per-invocation with -c dbg / --config=... as usual.)
build -c opt

# PDK installations are host state, not Bazel inputs.  Pass HOME so ciel sees
# the same default PDK root inside the test sandbox as it does in the user's
# shell.  Keep HAGENT_TECH_DIR passthrough for CI compatibility, but synthesis
# benchmarks deliberately replace it after resolving and validating ciel's
# newest enabled sky130 version.
test --test_env=HOME
test --test_env=HAGENT_TECH_DIR

# Bazel's built-in `eternal` category is only one hour. The slow partitioned
# synthesis scenarios carry a six-hour end-to-end watchdog in bench/common.sh;
# give only eternal tests the same outer ceiling so Bazel cannot kill the test
# before its scenario-level budget reports the intended exit-124 diagnostic.
test --test_timeout=-1,-1,-1,21600

# Verilator is host state too (the sim_verilator scenario compares `lhd sim`
# against it on the same RTL). bench/common.sh finds it on PATH or in the usual
# install prefixes; $VERILATOR overrides that, and bazel's test PATH does not
# carry /opt/homebrew/bin, so pass it through. Unlike HAGENT_TECH_DIR a missing
# verilator SKIPS the scenario instead of failing it.
test --test_env=VERILATOR

# Benchmarks print their metrics on stdout; show test output on failure by
# default (use --test_output=all to always see the numbers).
test --test_output=errors
