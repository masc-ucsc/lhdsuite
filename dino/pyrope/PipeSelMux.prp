// 64-bit 2:1 select shared by the ex_ctrl/wb_ctrl-driven muxes of
// PipelinedDualIssueCPU (extracted in 3a910c3; each call site replaced
// `if sel != 0 { tv } else { fv }`).
pub comb PipeSelMux::[timecheck=false](io_sel:u1, io_tv:u64, io_fv:u64) -> (io_out:u64) {
  io_out = if io_sel != 0 { io_tv } else { io_fv }
}
