pub comb ALU::[timecheck=false](io_operation:u5, io_inputx:u64, io_inputy:u64) -> (io_result:u64) {
  wire io:(operation:u5, inputx:u64, inputy:u64, result:u64) = nil
  wire wordinst:u1
  wire aluop:u4
  wire operand1_32:u32
  wire operand2_32:u32
  wire _io_result_T_2:u32
  wire _GEN:u64
  wire _io_result_T_10:u32
  wire _GEN_0:u64
  wire _io_result_T_20:u32
  wire _GEN_1:u64
  wire _io_result_T_36:u32
  wire _GEN_2:u64
  wire _io_result_T_44:u63
  wire _io_result_T_50:u127
  wire _GEN_3:u64
  wire _GEN_4:u1024
  wordinst = (io.operation >> 4) & 1
  aluop = io.operation#[0..=3]
  operand1_32 = io.inputx#[0..=31]
  operand2_32 = io.inputy#[0..=31]
  _io_result_T_2 = (operand1_32 + operand2_32)#[0..=31]
  mut _mux_1:u64 = if wordinst != 0 { _io_result_T_2#sext[0..=31]#[0..=63] } else { (io.inputx + io.inputy)#[0..=63] }
  _GEN = _mux_1
  _io_result_T_10 = (operand1_32 - operand2_32)#[0..=31]
  mut _mux_2:u64 = if wordinst != 0 { _io_result_T_10#sext[0..=31]#[0..=63] } else { (io.inputx - io.inputy)#[0..=63] }
  _GEN_0 = _mux_2
  _io_result_T_20 = (operand1_32#sext[0..=31] >> operand2_32#[0..=4])#[0..=31]#sext[0..=31]#[0..=31]
  mut _mux_3:u64 = if wordinst != 0 { _io_result_T_20#sext[0..=31]#[0..=63] } else { (io.inputx#sext[0..=63] >> io.inputy#[0..=5])#[0..=63]#sext[0..=63]#[0..=63] }
  _GEN_1 = _mux_3
  _io_result_T_36 = operand1_32 >> operand2_32#[0..=4]
  mut _mux_4:u64 = if wordinst != 0 { _io_result_T_36#sext[0..=31]#[0..=63] } else { (io.inputx >> io.inputy#[0..=5])#[0..=63] }
  _GEN_2 = _mux_4
  _io_result_T_44 = (operand1_32 << operand2_32#[0..=4])#[0..=62]
  _io_result_T_50 = (io.inputx#[0..=63] << io.inputy#[0..=5])#[0..=126]
  mut _mux_5:u64 = if wordinst != 0 { _io_result_T_44#[0..=31]#sext[0..=31]#[0..=63] } else { _io_result_T_50#[0..=63] }
  _GEN_3 = _mux_5
  _GEN_4 = ((unsigned(io.inputx != io.inputy) & 1) << 896) | ((unsigned(io.inputx == io.inputy) & 1) << 832) | ((unsigned(io.inputx >= io.inputy) & 1) << 768) | ((unsigned(io.inputx#sext[0..=63] >= io.inputy#sext[0..=63]) & 1) << 704) | ((~(io.inputx | io.inputy)#[0..=63])#[0..=63] << 640) | ((unsigned(io.inputx#sext[0..=63] < io.inputy#sext[0..=63]) & 1) << 576) | (_GEN_3 << 512) | (_GEN << 448) | ((io.inputx & io.inputy)#[0..=63] << 384) | ((io.inputx | io.inputy)#[0..=63] << 320) | (_GEN_0 << 256) | (_GEN_1 << 192) | (_GEN_2 << 128) | ((unsigned(io.inputx < io.inputy) & 1) << 64) | (io.inputx ^ io.inputy)#[0..=63]
  io.operation = io_operation
  io.inputx = io_inputx
  io.inputy = io_inputy
  io.result = ((_GEN_4 << 0x40) >> ((aluop * 0x40) + 0x40))#[0..=63]
  io_result = io.result
}
