pub comb ImmediateGenerator::[timecheck=false](io_instruction:u64) -> (io_sextImm:u64) {
  wire io:(instruction:u64, sextImm:u64) = nil
  wire opcode:u7
  wire imm:u20
  wire imm_1:u20
  wire imm_2:u20
  wire imm_3:u12
  wire imm_5:u12
  wire imm_7:u12
  wire imm_8:u12
  wire imm_4:u12
  wire imm_6:u12
  wire _GEN:u64
  wire _GEN_0:u64
  wire _GEN_1:u64
  wire _GEN_2:u64
  wire _GEN_3:u64
  wire _GEN_4:u64
  wire _GEN_5:u64
  wire _GEN_6:u64
  wire _GEN_7:u64
  wire _GEN_8:u64
  opcode = io.instruction#[0..=6]
  imm = io.instruction#[12..=31]
  imm_1 = io.instruction#[12..=31]
  imm_2 = (((io.instruction >> 31) & 1) << 19) | (io.instruction#[12..=19] << 11) | (((io.instruction >> 20) & 1) << 10) | io.instruction#[21..=30]
  imm_3 = io.instruction#[20..=31]
  imm_5 = io.instruction#[20..=31]
  imm_7 = io.instruction#[20..=31]
  imm_8 = io.instruction#[20..=31]
  imm_4 = (((io.instruction >> 31) & 1) << 11) | (((io.instruction >> 7) & 1) << 10) | (io.instruction#[25..=30] << 4) | io.instruction#[8..=11]
  imm_6 = (io.instruction#[25..=31] << 5) | io.instruction#[7..=11]
  mut _mux_1:u64 = if opcode == 0x73 { io.instruction#[15..=19] } else { 0 }
  _GEN = _mux_1
  mut _mux_2:u64 = if opcode == 27 { imm_8#sext[0..=11]#[0..=63] } else { _GEN }
  _GEN_0 = _mux_2
  mut _mux_3:u64 = if opcode == 19 { imm_7#sext[0..=11]#[0..=63] } else { _GEN_0 }
  _GEN_1 = _mux_3
  mut _mux_4:u64 = if opcode == 35 { imm_6#sext[0..=11]#[0..=63] } else { _GEN_1 }
  _GEN_2 = _mux_4
  mut _mux_5:u64 = if opcode == 3 { imm_5#sext[0..=11]#[0..=63] } else { _GEN_2 }
  _GEN_3 = _mux_5
  mut _mux_6:u64 = if opcode == 0x63 { (imm_4 << 1)#sext[0..=12]#[0..=63] } else { _GEN_3 }
  _GEN_4 = _mux_6
  mut _mux_7:u64 = if opcode == 0x67 { imm_3#sext[0..=11]#[0..=63] } else { _GEN_4 }
  _GEN_5 = _mux_7
  mut _mux_8:u64 = if opcode == 0x6f { (imm_2 << 1)#sext[0..=20]#[0..=63] } else { _GEN_5 }
  _GEN_6 = _mux_8
  mut _mux_9:u64 = if opcode == 23 { (imm_1 << 12)#sext[0..=31]#[0..=63] } else { _GEN_6 }
  _GEN_7 = _mux_9
  mut _mux_10:u64 = if opcode == 55 { (imm << 12)#sext[0..=31]#[0..=63] } else { _GEN_7 }
  _GEN_8 = _mux_10
  io.instruction = io_instruction
  io.sextImm = _GEN_8
  io_sextImm = io.sextImm
}
