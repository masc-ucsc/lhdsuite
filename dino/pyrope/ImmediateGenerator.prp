pub comb ImmediateGenerator::[timecheck=false](io_instruction:U64) -> (io_sextImm:U64) {
  wire io:(instruction:U64, sextImm:U64) = nil
  wire opcode:U7 = nil
  wire imm:U20 = nil
  wire imm_1:U20 = nil
  wire imm_2:U20 = nil
  wire imm_3:U12 = nil
  wire imm_5:U12 = nil
  wire imm_7:U12 = nil
  wire imm_8:U12 = nil
  wire imm_4:U12 = nil
  wire imm_6:U12 = nil
  wire _GEN:U64 = nil
  wire _GEN_0:U64 = nil
  wire _GEN_1:U64 = nil
  wire _GEN_2:U64 = nil
  wire _GEN_3:U64 = nil
  wire _GEN_4:U64 = nil
  wire _GEN_5:U64 = nil
  wire _GEN_6:U64 = nil
  wire _GEN_7:U64 = nil
  wire _GEN_8:U64 = nil
  opcode = io.instruction#[0..<7]
  imm = io.instruction#[12..<32]
  imm_1 = io.instruction#[12..<32]
  imm_2 = (io.instruction#[31..<32] << 19) | (io.instruction#[12..<20] << 11) | (io.instruction#[20..<21] << 10) | io.instruction#[21..<31]
  imm_3 = io.instruction#[20..<32]
  imm_5 = io.instruction#[20..<32]
  imm_7 = io.instruction#[20..<32]
  imm_8 = io.instruction#[20..<32]
  imm_4 = (io.instruction#[31..<32] << 11) | (io.instruction#[7..<8] << 10) | (io.instruction#[25..<31] << 4) | io.instruction#[8..<12]
  imm_6 = (io.instruction#[25..<32] << 5) | io.instruction#[7..<12]
  mut _mux_1:U64 = if opcode == 0x73 { io.instruction#[15..<20] } else { 0 }
  _GEN = _mux_1
  mut _mux_2:U64 = if opcode == 27 { imm_8#[0..<12]#sext[0..=11]#[0..<0x40] } else { _GEN#[0..<0x40] }
  _GEN_0 = _mux_2
  mut _mux_3:U64 = if opcode == 19 { imm_7#[0..<12]#sext[0..=11]#[0..<0x40] } else { _GEN_0#[0..<0x40] }
  _GEN_1 = _mux_3
  mut _mux_4:U64 = if opcode == 35 { imm_6#[0..<12]#sext[0..=11]#[0..<0x40] } else { _GEN_1#[0..<0x40] }
  _GEN_2 = _mux_4
  mut _mux_5:U64 = if opcode == 3 { imm_5#[0..<12]#sext[0..=11]#[0..<0x40] } else { _GEN_2#[0..<0x40] }
  _GEN_3 = _mux_5
  mut _mux_6:U64 = if opcode == 0x63 { (imm_4#[0..<12] << 1)#sext[0..=12]#[0..<0x40] } else { _GEN_3#[0..<0x40] }
  _GEN_4 = _mux_6
  mut _mux_7:U64 = if opcode == 0x67 { imm_3#[0..<12]#sext[0..=11]#[0..<0x40] } else { _GEN_4#[0..<0x40] }
  _GEN_5 = _mux_7
  mut _mux_8:U64 = if opcode == 0x6f { (imm_2#[0..<20] << 1)#sext[0..=20]#[0..<0x40] } else { _GEN_5#[0..<0x40] }
  _GEN_6 = _mux_8
  mut _mux_9:U64 = if opcode == 23 { (imm_1#[0..<20] << 12)#sext[0..=31]#[0..<0x40] } else { _GEN_6#[0..<0x40] }
  _GEN_7 = _mux_9
  mut _mux_10:U64 = if opcode == 55 { (imm#[0..<20] << 12)#sext[0..=31]#[0..<0x40] } else { _GEN_7#[0..<0x40] }
  _GEN_8 = _mux_10
  io.instruction = io_instruction#[0..<0x40]
  io.sextImm = _GEN_8#[0..<0x40]
  io_sextImm = io.sextImm
}
