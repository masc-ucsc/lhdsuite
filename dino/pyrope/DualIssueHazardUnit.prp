  stalling_due_to_pipeB = io.pipeB_idex_memread & (((((U1(io.pipeB_idex_rd == io.id_pipeA_rs1) | U1(io.pipeB_idex_rd == io.id_pipeA_rs2)) & 1) | U1(io.pipeB_idex_rd == io.id_pipeB_rs1)) & 1) | U1(io.pipeB_idex_rd == io.id_pipeB_rs2)) & 1 & 1
  _GEN = (io.pipeA_exmem_taken | io.pipeB_exmem_taken) & 1
