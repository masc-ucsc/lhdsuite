pub comb DualIssueHazardUnit::[timecheck=false](io_id_pipeA_rs1:u5, io_id_pipeA_rs2:u5, io_id_pipeB_rs1:u5, io_id_pipeB_rs2:u5, io_pipeA_idex_memread:u1, io_pipeA_idex_rd:u5, io_pipeA_exmem_taken:u1, io_pipeB_idex_memread:u1, io_pipeB_idex_rd:u5, io_pipeB_exmem_taken:u1) -> (io_pcfromtaken:u1, io_pcstall:u1, io_if_id_stall:u1, io_id_ex_flush:u1, io_ex_mem_flush:u1, io_if_id_flush:u1) {
  wire io:(id_pipeA_rs1:u5, id_pipeA_rs2:u5, id_pipeB_rs1:u5, id_pipeB_rs2:u5, pipeA_idex_memread:u1, pipeA_idex_rd:u5, pipeA_exmem_taken:u1, pipeB_idex_memread:u1, pipeB_idex_rd:u5, pipeB_exmem_taken:u1, pcfromtaken:u1, pcstall:u1, if_id_stall:u1, id_ex_flush:u1, ex_mem_flush:u1, if_id_flush:u1) = nil
  wire stalling_due_to_pipeA:u1
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  wire stalling_due_to_pipeB:u1
  wire _GEN:u1
  wire _GEN_0:u1
  wire _GEN_1:u1
  io_ex_mem_flush = 0ub?
  io_id_ex_flush = 0ub?
  io_if_id_flush = 0ub?
  io_if_id_stall = 0ub?
  io_pcfromtaken = 0ub?
  io_pcstall = 0ub?
  mut _b2i_1 = if io.pipeA_idex_rd == io.id_pipeA_rs1 { 1 } else { 0 }
  mut _b2i_2 = if io.pipeA_idex_rd == io.id_pipeA_rs2 { 1 } else { 0 }
  mut _b2i_3 = if io.pipeA_idex_rd == io.id_pipeB_rs1 { 1 } else { 0 }
  mut _b2i_4 = if io.pipeA_idex_rd == io.id_pipeB_rs2 { 1 } else { 0 }
  stalling_due_to_pipeA = io.pipeA_idex_memread & (_b2i_1 | _b2i_2 | _b2i_3 | _b2i_4)
  mut _b2i_5 = if io.pipeB_idex_rd == io.id_pipeA_rs1 { 1 } else { 0 }
  mut _b2i_6 = if io.pipeB_idex_rd == io.id_pipeA_rs2 { 1 } else { 0 }
  mut _b2i_7 = if io.pipeB_idex_rd == io.id_pipeB_rs1 { 1 } else { 0 }
  mut _b2i_8 = if io.pipeB_idex_rd == io.id_pipeB_rs2 { 1 } else { 0 }
  stalling_due_to_pipeB = io.pipeB_idex_memread & (_b2i_5 | _b2i_6 | _b2i_7 | _b2i_8)
  _GEN = io.pipeA_exmem_taken | io.pipeB_exmem_taken
  _GEN_0 = stalling_due_to_pipeB | stalling_due_to_pipeA
  _GEN_1 = (~_GEN) & 1 & _GEN_0
  io.pcfromtaken = _GEN & 1
  const io_pcfromtaken__w1 = io.pcfromtaken
  io.pcstall = _GEN_1 & 1
  const io_pcstall__w1 = io.pcstall
  io.if_id_stall = _GEN_1 & 1
  const io_if_id_stall__w1 = io.if_id_stall
  io.id_ex_flush = (_GEN | _GEN_0) & 1
  const io_id_ex_flush__w1 = io.id_ex_flush
  io.ex_mem_flush = _GEN & 1
  const io_ex_mem_flush__w1 = io.ex_mem_flush
  io.if_id_flush = _GEN & 1
  const io_if_id_flush__w1 = io.if_id_flush
  io.id_pipeA_rs1 = io_id_pipeA_rs1#[0..=4]
  io.id_pipeA_rs2 = io_id_pipeA_rs2#[0..=4]
  io.id_pipeB_rs1 = io_id_pipeB_rs1#[0..=4]
  io.id_pipeB_rs2 = io_id_pipeB_rs2#[0..=4]
  io.pipeA_exmem_taken = io_pipeA_exmem_taken & 1
  io.pipeA_idex_memread = io_pipeA_idex_memread & 1
  io.pipeA_idex_rd = io_pipeA_idex_rd#[0..=4]
  io.pipeB_exmem_taken = io_pipeB_exmem_taken & 1
  io.pipeB_idex_memread = io_pipeB_idex_memread & 1
  io.pipeB_idex_rd = io_pipeB_idex_rd#[0..=4]
  io_ex_mem_flush = io_ex_mem_flush__w1
  io_id_ex_flush = io_id_ex_flush__w1
  io_if_id_flush = io_if_id_flush__w1
  io_if_id_stall = io_if_id_stall__w1
  io_pcfromtaken = io_pcfromtaken__w1
  io_pcstall = io_pcstall__w1
}
