pub mod StageReg::[timecheck=false](clock:u1, reset:u1, io_in:(instruction:u32, pc:u64, isValid:u1), io_flush:u1, io_valid:u1) -> (io_data:(instruction:u32, pc:u64, isValid:u1)@[]) {
  mut _GEN:u32 = 0
  mut _GEN_0:u32 = 0
  mut _GEN_1:u64 = 0
  mut _GEN_2:u64 = 0
  mut _GEN_3:u1 = 0
  mut _mux_1:u32 = 0
  mut _mux_2:u32 = 0
  mut _mux_3:u64 = 0
  mut _mux_4:u64 = 0
  mut _mux_5:u1 = 0
  reg reg_0:u97
  mut `io.in` = ((io_in.instruction << 0x41) | (io_in.pc << 1) | io_in.isValid)#[0..=96]
  mut `io.flush` = io_flush & 1
  mut `io.valid` = io_valid & 1
  mut `io.data` = reg_0
  if reset != 0 {
    reg_0 = 0
  } else {
    _GEN = 0ub????????????????????????????????
    _mux_1 = if `io.valid` != 0 { `io.in`#[65..=96] } else { reg_0#[65..=96] }
    _GEN = _mux_1
    _GEN_0 = 0ub????????????????????????????????
    _mux_2 = if `io.flush` != 0 { 0 } else { _GEN }
    _GEN_0 = _mux_2
    _GEN_1 = 0ub????????????????????????????????????????????????????????????????
    _mux_3 = if `io.valid` != 0 { `io.in`#[1..=64] } else { reg_0#[1..=64] }
    _GEN_1 = _mux_3
    _GEN_2 = 0ub????????????????????????????????????????????????????????????????
    _mux_4 = if `io.flush` != 0 { 0 } else { _GEN_1 }
    _GEN_2 = _mux_4
    _GEN_3 = 0ub?
    _mux_5 = if `io.valid` != 0 { `io.in` & 1 } else { reg_0 & 1 }
    _GEN_3 = _mux_5
    reg_0 = ((~`io.flush`) & 1 & _GEN_3 & 1) | (_GEN_2 << 1) | (_GEN_0 << 0x41)
  }
  const t50 = `io.data`
  mut `io_data__bpo.instruction` = t50#[65..=96]
  mut `io_data__bpo.pc` = t50#[1..=64]
  mut `io_data__bpo.isValid` = t50 & 1
  io_data.instruction = `io_data__bpo.instruction`
  io_data.pc = `io_data__bpo.pc`
  io_data.isValid = `io_data__bpo.isValid`
}
