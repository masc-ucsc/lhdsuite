pub mod StageReg_8::[timecheck=false](clock:u1, reset:u1, io_in:(mem_ctrl:(memop:u2), wb_ctrl:(toreg:u1, regwrite:u1)), io_flush:u1) -> (io_data:(mem_ctrl:(memop:u2), wb_ctrl:(toreg:u1, regwrite:u1))@[]) {
  mut _GEN_0:u2 = 0
  mut _mux_1:u2 = 0
  mut `_GEN.regwrite` = 0
  mut `_GEN.toreg` = 0
  mut `_GEN_1.memop` = 0
  reg reg_0:u4
  mut `io.valid` = 0
  mut `io.in` = ((io_in.mem_ctrl.memop << 2) | (io_in.wb_ctrl.toreg << 1) | io_in.wb_ctrl.regwrite)#[0..=3]
  mut `io.flush` = io_flush & 1
  mut `io.data` = reg_0
  if reset != 0 {
    reg_0 = 0
  } else {
    `_GEN.toreg` = (~`io.flush`) & 1 & (`io.in`#[0..=1] >> 1) & 1 & 1
    `_GEN.regwrite` = (~`io.flush`) & 1 & `io.in`#[0..=1] & 1 & 1
    _GEN_0 = 0ub??
    _mux_1 = if `io.flush` != 0 { 0 } else { `io.in`#[2..=3] }
    _GEN_0 = _mux_1
    `_GEN_1.memop` = _GEN_0
    reg_0 = (`_GEN.toreg` << 1) | `_GEN.regwrite` | (`_GEN_1.memop` << 2)
  }
  const t51 = `io.data`
  mut `io_data__bpo.mem_ctrl.memop` = t51#[2..=3]
  mut `io_data__bpo.wb_ctrl.toreg` = (t51 >> 1) & 1
  mut `io_data__bpo.wb_ctrl.regwrite` = t51 & 1
  io_data.mem_ctrl.memop = `io_data__bpo.mem_ctrl.memop`
  io_data.wb_ctrl.toreg = `io_data__bpo.wb_ctrl.toreg`
  io_data.wb_ctrl.regwrite = `io_data__bpo.wb_ctrl.regwrite`
}
