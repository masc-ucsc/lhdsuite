pub mod StageReg_8::[timecheck=false](clock:u1, reset:u1, io_in:(mem_ctrl:(memop:u2), wb_ctrl:(toreg:u1, regwrite:u1)), io_flush:u1) -> (io_data:(mem_ctrl:(memop:u2), wb_ctrl:(toreg:u1, regwrite:u1))@[]) {
  mut _GEN_0 = 0
  mut `_GEN.regwrite` = 0
  mut `_GEN.toreg` = 0
  mut `_GEN_1.memop` = 0
  reg reg_0:u4
  mut `io_data__bpo.mem_ctrl.memop` = 0
  mut `io_data__bpo.wb_ctrl.toreg` = 0
  mut `io_data__bpo.wb_ctrl.regwrite` = 0
  mut `io.in` = 0
  mut `io.flush` = 0
  mut `io.valid` = 0
  mut `io.data` = 0
  `io.data` = reg_0#[0..=3]
  `io.flush` = io_flush & 1
  `io.in` = ((io_in.mem_ctrl.memop << 2) | (io_in.wb_ctrl.toreg << 1) | io_in.wb_ctrl.regwrite)#[0..=3]
  `io.valid` = 1
  if reset != 0 {
    reg_0 = 0
  } else {
    `_GEN.regwrite` = (~`io.flush`) & 1 & `io.in`#[0..=1] & 1 & 1
    `_GEN.toreg` = (~`io.flush`) & 1 & (`io.in`#[0..=1] >> 1) & 1 & 1
    _GEN_0 = 0ub??
    _GEN_0 = if `io.flush` != 0 { 0 } else { `io.in`#[2..=3]#[0..=1]#[0..=1] }
    `_GEN_1.memop` = _GEN_0#[0..=1]
    reg_0 = (`_GEN.toreg` << 1) | `_GEN.regwrite` | (`_GEN_1.memop` << 2)
  }
  const t55 = `io.data`
  `io_data__bpo.mem_ctrl.memop` = t55#[2..=3]
  `io_data__bpo.wb_ctrl.toreg` = (t55 >> 1) & 1
  `io_data__bpo.wb_ctrl.regwrite` = t55 & 1
  io_data.mem_ctrl.memop = `io_data__bpo.mem_ctrl.memop`
  io_data.wb_ctrl.regwrite = `io_data__bpo.wb_ctrl.regwrite`
  io_data.wb_ctrl.toreg = `io_data__bpo.wb_ctrl.toreg`
}
