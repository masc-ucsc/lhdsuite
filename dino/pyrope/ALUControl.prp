pub comb ALUControl::[timecheck=false](io_aluop:u1, io_itype:u1, io_funct7:u7, io_funct3:u3, io_wordinst:u1) -> (io_operation:u5) {
  wire io:(aluop:u1, itype:u1, funct7:u7, funct3:u3, wordinst:u1, operation:u5) = nil
  wire _GEN_3:u40
  mut _mux_1:u5 = if io.funct7 == 32 { ((io.wordinst & 1) << 4) | 4 } else { 31 }
  mut _mux_3:u5 = if ((io.itype | unsigned(io.funct7 == 0)) & 1) != 0 { ((io.wordinst & 1) << 4) | 7 } else { _mux_1 }
  mut _mux_4:u5 = if io.funct7#[1..=6] == 16 { ((io.wordinst & 1) << 4) | 3 } else { 31 }
  mut _mux_5:u5 = if io.funct7#[1..=6] == 0 { ((io.wordinst & 1) << 4) | 2 } else { _mux_4 }
  _GEN_3 = (6 << 35) | (5 << 30) | (_mux_5 << 25) | (1 << 15) | (9 << 10) | ((((io.wordinst & 1) << 4) | 8) << 5) | _mux_3
  mut _mux_6:u5 = if io.aluop != 0 { ((_GEN_3 << 5) >> ((io.funct3 * 5) + 5))#[0..=4] } else { 7 }
  io.aluop = io_aluop & 1
  io.itype = io_itype & 1
  io.funct7 = io_funct7
  io.funct3 = io_funct3
  io.wordinst = io_wordinst & 1
  io.operation = _mux_6
  io_operation = io.operation
}
