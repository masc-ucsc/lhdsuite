pub comb ALUControl::[timecheck=false](io_aluop:u1, io_itype:u1, io_funct7:u7, io_funct3:u3, io_wordinst:u1) -> (io_operation:u5) {
  wire io:(aluop:u1, itype:u1, funct7:u7, funct3:u3, wordinst:u1, operation:u5) = nil
  wire _GEN:u5
  
  
  
  
  
  
  wire _GEN_0:u5
  wire _GEN_1:u5
  wire _GEN_2:u5
  wire _GEN_3:u40
  wire _GEN_4:u5
  io_operation = 0ub?????
  mut _mux_1:u5 = if io.funct7 == 32 { (4 | (io.wordinst << 4))#[0..=4] } else { 31 }
  _GEN = _mux_1
  mut _b2i_2 = if io.funct7 == 0 { 1 } else { 0 }
  mut _mux_3:u5 = if (io.itype | _b2i_2) != 0 { (7 | (io.wordinst << 4))#[0..=4] } else { _GEN#[0..=4] }
  _GEN_0 = _mux_3
  mut _mux_4:u5 = if io.funct7#[1..=6] == 16 { (3 | (io.wordinst << 4))#[0..=4] } else { 31 }
  _GEN_1 = _mux_4
  mut _mux_5:u5 = if io.funct7#[1..=6] == 0 { (2 | (io.wordinst << 4))#[0..=4] } else { _GEN_1#[0..=4] }
  _GEN_2 = _mux_5
  _GEN_3 = _GEN_0 | ((8 | (io.wordinst << 4)) << 5) | 0x2400 | 0x8000 | 0 | (_GEN_2 << 25) | 0x140000000 | 0x3000000000
  mut _mux_6:u5 = if io.aluop != 0 { ((_GEN_3 << 5) >> ((io.funct3 * 5)#[0..=6] + 5))#[0..=4]#[0..=4] } else { 7 }
  _GEN_4 = _mux_6
  io.operation = _GEN_4#[0..=4]
  const io_operation__w1 = io.operation
  io.aluop = io_aluop & 1
  io.funct3 = io_funct3#[0..=2]
  io.funct7 = io_funct7#[0..=6]
  io.itype = io_itype & 1
  io.wordinst = io_wordinst & 1
  io_operation = io_operation__w1
}
