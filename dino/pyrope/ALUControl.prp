pub comb ALUControl::[timecheck=false](io_aluop:U1, io_itype:U1, io_funct7:U7, io_funct3:U3, io_wordinst:U1) -> (io_operation:U5) {
  wire io:(aluop:U1, itype:U1, funct7:U7, funct3:U3, wordinst:U1, operation:U5) = nil
  wire _GEN:U5 = nil
  wire _GEN_0:U5 = nil
  wire _GEN_1:U5 = nil
  wire _GEN_2:U5 = nil
  wire _GEN_3:U40 = nil
  wire _GEN_4:U5 = nil
  mut _mux_1:U5 = if io.funct7 == 32 { ((io.wordinst & 1) << 4) | 4 } else { 31 }
  _GEN = _mux_1
  mut _mux_3:U5 = if ((io.itype | U1(io.funct7 == 0)) & 1) != 0 { ((io.wordinst & 1) << 4) | 7 } else { _GEN#[0..<5] }
  _GEN_0 = _mux_3
  mut _mux_4:U5 = if io.funct7#[1..<7] == 16 { ((io.wordinst & 1) << 4) | 3 } else { 31 }
  _GEN_1 = _mux_4
  mut _mux_5:U5 = if io.funct7#[1..<7] == 0 { ((io.wordinst & 1) << 4) | 2 } else { _GEN_1#[0..<5] }
  _GEN_2 = _mux_5
  _GEN_3 = (6 << 35) | (5 << 30) | (_GEN_2#[0..<5] << 25) | (1 << 15) | (9 << 10) | ((((io.wordinst & 1) << 4) | 8) << 5) | _GEN_0#[0..<5]
  mut _mux_6:U5 = if io.aluop != 0 { ((_GEN_3 << 5) >> ((io.funct3 * 5) + 5))#[0..<5] } else { 7 }
  _GEN_4 = _mux_6
  io.aluop = io_aluop & 1
  io.itype = io_itype & 1
  io.funct7 = io_funct7#[0..<7]
  io.funct3 = io_funct3#[0..<3]
  io.wordinst = io_wordinst & 1
  io.operation = _GEN_4#[0..<5]
  io_operation = io.operation
}
