pub mod StageReg_12::[timecheck=false](`clock`:Clock, `reset`:U1, io_in:(wb_ctrl:(toreg:U1, regwrite:U1))) -> (io_data:(wb_ctrl:(toreg:U1, regwrite:U1))@[]) {
