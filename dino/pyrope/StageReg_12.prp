pub mod StageReg_12::[timecheck=false](clock:u1, reset:u1, io_in:(wb_ctrl:(toreg:u1, regwrite:u1))) -> (io_data:(wb_ctrl:(toreg:u1, regwrite:u1))@[]) {
  reg reg_0:u2
  mut `io_data__bpo.wb_ctrl.toreg` = 0
  mut `io_data__bpo.wb_ctrl.regwrite` = 0
  mut `io.in` = 0
  mut `io.flush` = 0
  mut `io.valid` = 0
  mut `io.data` = 0
  `io.data` = reg_0#[0..=1]
  `io.flush` = 0
  `io.in` = ((io_in.wb_ctrl.toreg << 1) | io_in.wb_ctrl.regwrite)#[0..=1]
  `io.valid` = 1
  reg_0 = if reset != 0 { 0 } else { `io.in` }
  const t17 = `io.data`
  `io_data__bpo.wb_ctrl.toreg` = (t17 >> 1) & 1
  `io_data__bpo.wb_ctrl.regwrite` = t17 & 1
  io_data.wb_ctrl.regwrite = `io_data__bpo.wb_ctrl.regwrite`
  io_data.wb_ctrl.toreg = `io_data__bpo.wb_ctrl.toreg`
}
