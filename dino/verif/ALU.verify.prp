// Assert/assume collateral for the dino ALU — a sidecar, so the design files
// are never touched. io_operation = {word:1, aluop:4}; aluop row 7 is the
// adder, so 0x17 = ADDW and 0x07 = ADD.
//
// NOTE: each `formal` block is an INDEPENDENT test — its assumes constrain only
// its own obligations, so the two blocks below may carry mutually-exclusive
// constraints (0x17 vs 0x07) and both prove. (Before the upstream per-block
// scoping fix they poisoned each other into "assume set contradictory", which
// is why this sidecar used to carry only the ADDW block.)
//
// The op pins are spelled `assume_nocheck`: a plain `assume` is a PROOF
// OBLIGATION (checked as an assert before it is used), and over a free input
// `io_operation == 0x17` can never be proven — it REFUTES. `assume_nocheck`
// is the explicit free environment constraint: assumed without check,
// disclosed in the verdict table.
//
// Usage:
//   lhd formal verify dino/pyrope/ALU.prp dino/verif/ALU.verify.prp \
//       --top ALU --set formal.bound=2 --workdir W
//
// The first ADDW assert is exactly what dino/tests/bug1/ALU.prp breaks:
// against that variant this sidecar REFUTES with a counterexample trace.
const alu = import("ALU.ALU")

formal alu.addw {
  mut acc = alu
  assume_nocheck(acc.io_operation == 0x17)
  assert(acc.io_result#[0..=31] == (acc.io_inputx#[0..=31] + acc.io_inputy#[0..=31])#[0..=31],
         "ADDW low 32 bits are the 32-bit sum")
  assert(acc.io_result#[31..=63] == 0 or acc.io_result#[31..=63] == 0x1ffffffff,
         "ADDW result is sign-extended")
}

// The full-width ADD (aluop row 7, word bit clear). Restored as its own block
// now that blocks no longer share an assume set: this claim needs io_operation
// == 0x07, the exact opposite of the block above.
formal alu.add {
  mut acc = alu
  assume_nocheck(acc.io_operation == 0x07)
  assert(acc.io_result == (acc.io_inputx + acc.io_inputy)#[0..=63],
         "ADD is the full 64-bit sum")
}
