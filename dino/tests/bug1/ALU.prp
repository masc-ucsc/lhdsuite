const enc = import("encodings")
comptime const full_msb = 63
comptime const word_msb = 31
comptime const full_shamt_msb = 5
comptime const word_shamt_msb = 4
comptime const operation_msb = 3

pub mod ALU::[timecheck = false](io_operation:u5, io_inputx:u64, io_inputy:u64) -> (io_result:u64@[]) {
  const word:bool      = io_operation#[enc.alu_word_bit] != 0
  mut sum:u64          = 0
  mut difference:u64   = 0
  mut left_shift:u64   = 0
  mut signed_shift:u64 = 0
  wrap sum = if word { io_inputx - io_inputy } else { io_inputx + io_inputy } // BUG: ADDW subtracts
  wrap difference = io_inputx - io_inputy
  wrap left_shift = if word { io_inputx#[0 ..= word_msb] << io_inputy#[0 ..= word_shamt_msb] } else { io_inputx << io_inputy#[0 ..= full_shamt_msb] }
  wrap signed_shift     = if word { io_inputx#sext[0 ..= word_msb] >> io_inputy#[0 ..= word_shamt_msb] } else {
    io_inputx#sext[0 ..= full_msb] >> io_inputy#[0 ..= full_shamt_msb]
  }
  const right_shift:u64 = if word { io_inputx#[0 ..= word_msb] >> io_inputy#[0 ..= word_shamt_msb] } else { io_inputx >> io_inputy#[0 ..= full_shamt_msb] }
  // The word flag only affects add/subtract and shifts, as in the reference.
  match io_operation#[0 ..= operation_msb] {
    == enc.alu_xor { io_result = io_inputx ^ io_inputy }
    == enc.alu_ltu { io_result = unsigned(io_inputx < io_inputy) }
    == enc.alu_srl { wrap  io_result = if word { right_shift#sext[0 ..= word_msb] } else { right_shift } }
    == enc.alu_sra { wrap  io_result = if word { signed_shift#sext[0 ..= word_msb] } else { signed_shift } }
    == enc.alu_sub { wrap  io_result = if word { difference#sext[0 ..= word_msb] } else { difference } }
    == enc.alu_or { io_result = io_inputx | io_inputy }
    == enc.alu_and { io_result = io_inputx & io_inputy }
    == enc.alu_add { wrap  io_result = if word { sum#sext[0 ..= word_msb] } else { sum } }
    == enc.alu_sll { wrap  io_result = if word { left_shift#sext[0 ..= word_msb] } else { left_shift } }
    == enc.alu_lt { io_result = unsigned(io_inputx#sext[0 ..= full_msb] < io_inputy#sext[0 ..= full_msb]) }
    == enc.alu_nor { wrap  io_result = ~(io_inputx | io_inputy) }
    == enc.alu_ge { io_result = unsigned(io_inputx#sext[0 ..= full_msb] >= io_inputy#sext[0 ..= full_msb]) }
    == enc.alu_geu { io_result = unsigned(io_inputx >= io_inputy) }
    == enc.alu_eq { io_result = unsigned(io_inputx == io_inputy) }
    == enc.alu_ne { io_result = unsigned(io_inputx != io_inputy) }
    else { io_result = 0 }
  }
}
