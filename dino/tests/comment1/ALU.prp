  mut _mux_1:U64 = if wordinst != 0 { _io_result_T_2#[0..<32]#sext[0..=31]#[0..<0x40] } else { (io.inputx + io.inputy)#[0..<0x40] }
  _GEN = _mux_1
  _io_result_T_10 = (operand1_32 - operand2_32)#[0..<32]
  mut _mux_2:U64 = if wordinst != 0 { _io_result_T_10#[0..<32]#sext[0..=31]#[0..<0x40] } else { (io.inputx - io.inputy)#[0..<0x40] }
  _GEN_0 = _mux_2
  _io_result_T_20 = (operand1_32#sext[0..=31] >> operand2_32#[0..<5])#[0..<32]#sext[0..=31]#[0..<32]
  mut _mux_3:U64 = if wordinst != 0 { _io_result_T_20#[0..<32]#sext[0..=31]#[0..<0x40] } else { (io.inputx#sext[0..=63] >> io.inputy#[0..<6])#[0..<0x40]#sext[0..=63]#[0..<0x40] }
  _GEN_1 = _mux_3
  _io_result_T_36 = operand1_32 >> operand2_32#[0..<5]
  mut _mux_4:U64 = if wordinst != 0 { _io_result_T_36#[0..<32]#sext[0..=31]#[0..<0x40] } else { (io.inputx >> io.inputy#[0..<6])#[0..<0x40] }
  _GEN_2 = _mux_4
  _io_result_T_44 = (operand1_32#[0..<32] << operand2_32#[0..<5])#[0..<63]
  _io_result_T_50 = (io.inputx#[0..<0x40] << io.inputy#[0..<6])#[0..<0x7f]
  mut _mux_5:U64 = if wordinst != 0 { _io_result_T_44#[0..<32]#sext[0..=31]#[0..<0x40] } else { _io_result_T_50#[0..<0x40] }
  _GEN_3 = _mux_5
  _GEN_4 = ((U1(io.inputx != io.inputy) & 1) << 896) | ((U1(io.inputx == io.inputy) & 1) << 832) | ((U1(io.inputx >= io.inputy) & 1) << 768) | ((U1(io.inputx#sext[0..=63] >= io.inputy#sext[0..=63]) & 1) << 704) | ((~(io.inputx | io.inputy)#[0..<0x40]) << 640) | ((U1(io.inputx#sext[0..=63] < io.inputy#sext[0..=63]) & 1) << 576) | (_GEN_3#[0..<0x40] << 512) | (_GEN#[0..<0x40] << 448) | ((io.inputx & io.inputy)#[0..<0x40] << 384) | ((io.inputx | io.inputy)#[0..<0x40] << 320) | (_GEN_0#[0..<0x40] << 256) | (_GEN_1#[0..<0x40] << 192) | (_GEN_2#[0..<0x40] << 128) | ((U1(io.inputx < io.inputy) & 1) << 64) | (io.inputx ^ io.inputy)#[0..<0x40]
  io.operation = io_operation#[0..<5]
  io.inputx = io_inputx#[0..<0x40]
  io.inputy = io_inputy#[0..<0x40]
