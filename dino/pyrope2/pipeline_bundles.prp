// Pure conversions between pipeline bundles and the corresponding stored bits.
// Named fields have no implicit packing order in Pyrope.

comptime const fetch_instruction_lo = 65
comptime const fetch_instruction_hi = 96
comptime const fetch_pc_lo = 1
comptime const fetch_pc_hi = 64
comptime const fetch_is_valid_lo = 0

pub comb pack_fetch(io_in:(instruction:u32, pc:u64, isValid:u1)) -> (bits:u97) {
  bits = (io_in.instruction << fetch_instruction_lo)
    | (io_in.pc << fetch_pc_lo)
    | io_in.isValid
}

pub comb unpack_fetch(bits:u97) -> (io_data:(instruction:u32, pc:u64, isValid:u1)) {
  io_data.instruction = bits#[fetch_instruction_lo ..= fetch_instruction_hi]
  io_data.pc          = bits#[fetch_pc_lo ..= fetch_pc_hi]
  io_data.isValid     = bits#[fetch_is_valid_lo]
}

comptime const decode_pc_lo = 257
comptime const decode_pc_hi = 320
comptime const decode_instruction_lo = 193
comptime const decode_instruction_hi = 256
comptime const decode_sext_imm_lo = 129
comptime const decode_sext_imm_hi = 192
comptime const decode_readdata1_lo = 65
comptime const decode_readdata1_hi = 128
comptime const decode_readdata2_lo = 1
comptime const decode_readdata2_hi = 64
comptime const decode_is_valid_lo = 0

pub comb pack_decode(io_in:(pc:u64, instruction:u64, sextImm:u64, readdata1:u64, readdata2:u64, isValid:u1)) -> (bits:u321) {
  bits = (io_in.pc << decode_pc_lo)
    | (io_in.instruction << decode_instruction_lo)
    | (io_in.sextImm << decode_sext_imm_lo)
    | (io_in.readdata1 << decode_readdata1_lo)
    | (io_in.readdata2 << decode_readdata2_lo)
    | io_in.isValid
}

pub comb unpack_decode(bits:u321) -> (io_data:(pc:u64, instruction:u64, sextImm:u64, readdata1:u64, readdata2:u64, isValid:u1)) {
  io_data.pc          = bits#[decode_pc_lo ..= decode_pc_hi]
  io_data.instruction = bits#[decode_instruction_lo ..= decode_instruction_hi]
  io_data.sextImm     = bits#[decode_sext_imm_lo ..= decode_sext_imm_hi]
  io_data.readdata1   = bits#[decode_readdata1_lo ..= decode_readdata1_hi]
  io_data.readdata2   = bits#[decode_readdata2_lo ..= decode_readdata2_hi]
  io_data.isValid     = bits#[decode_is_valid_lo]
}

comptime const execute_control_itype_lo = 13
comptime const execute_control_aluop_lo = 12
comptime const execute_control_src1_lo = 11
comptime const execute_control_src2_lo = 9
comptime const execute_control_src2_hi = 10
comptime const execute_control_branch_lo = 8
comptime const execute_control_jumptype_lo = 6
comptime const execute_control_jumptype_hi = 7
comptime const execute_control_resultselect_lo = 5
comptime const execute_control_wordinst_lo = 4
comptime const execute_control_memop_lo = 2
comptime const execute_control_memop_hi = 3
comptime const execute_control_toreg_lo = 1
comptime const execute_control_regwrite_lo = 0

pub comb pack_execute_control(io_in:(
   itype:u1, aluop:u1, src1:u1, src2:u2, branch:u1, jumptype:u2, resultselect:u1, wordinst:u1, memop:u2, toreg:u1, regwrite:u1 )) -> (bits:u14) {
  bits = (io_in.itype << execute_control_itype_lo)
    | (io_in.aluop << execute_control_aluop_lo)
    | (io_in.src1 << execute_control_src1_lo)
    | (io_in.src2 << execute_control_src2_lo)
    | (io_in.branch << execute_control_branch_lo)
    | (io_in.jumptype << execute_control_jumptype_lo)
    | (io_in.resultselect << execute_control_resultselect_lo)
    | (io_in.wordinst << execute_control_wordinst_lo)
    | (io_in.memop << execute_control_memop_lo)
    | (io_in.toreg << execute_control_toreg_lo)
    | io_in.regwrite
}

pub comb unpack_execute_control(bits:u14) -> (io_data:(
   ex_ctrl:(itype:u1, aluop:u1, src1:u1, src2:u2, branch:u1, jumptype:u2, resultselect:u1, wordinst:u1),
  mem_ctrl:(memop:u2),
  wb_ctrl:(toreg:u1, regwrite:u1) )) {
  io_data.ex_ctrl.itype        = bits#[execute_control_itype_lo]
  io_data.ex_ctrl.aluop        = bits#[execute_control_aluop_lo]
  io_data.ex_ctrl.src1         = bits#[execute_control_src1_lo]
  io_data.ex_ctrl.src2         = bits#[execute_control_src2_lo ..= execute_control_src2_hi]
  io_data.ex_ctrl.branch       = bits#[execute_control_branch_lo]
  io_data.ex_ctrl.jumptype     = bits#[execute_control_jumptype_lo ..= execute_control_jumptype_hi]
  io_data.ex_ctrl.resultselect = bits#[execute_control_resultselect_lo]
  io_data.ex_ctrl.wordinst     = bits#[execute_control_wordinst_lo]
  io_data.mem_ctrl.memop       = bits#[execute_control_memop_lo ..= execute_control_memop_hi]
  io_data.wb_ctrl.toreg        = bits#[execute_control_toreg_lo]
  io_data.wb_ctrl.regwrite     = bits#[execute_control_regwrite_lo]
}

comptime const execute_pc_lo = 258
comptime const execute_pc_hi = 321
comptime const execute_ex_result_lo = 194
comptime const execute_ex_result_hi = 257
comptime const execute_mem_writedata_lo = 130
comptime const execute_mem_writedata_hi = 193
comptime const execute_nextpc_lo = 66
comptime const execute_nextpc_hi = 129
comptime const execute_taken_lo = 65
comptime const execute_instruction_lo = 1
comptime const execute_instruction_hi = 64
comptime const execute_is_valid_lo = 0

pub comb pack_execute(io_in:(
  pc:u64, ex_result:u64, mem_writedata:u64, nextpc:u64, taken:u1,
  instruction:u64, isValid:u1)) -> (bits:u322) {
  bits = (io_in.pc << execute_pc_lo)
    | (io_in.ex_result << execute_ex_result_lo)
    | (io_in.mem_writedata << execute_mem_writedata_lo)
    | (io_in.nextpc << execute_nextpc_lo)
    | (io_in.taken << execute_taken_lo)
    | (io_in.instruction << execute_instruction_lo)
    | io_in.isValid
}

pub comb unpack_execute(bits:u322) -> (io_data:(
  pc:u64, ex_result:u64, mem_writedata:u64, nextpc:u64, taken:u1,
  instruction:u64, isValid:u1)) {
  io_data.pc            = bits#[execute_pc_lo ..= execute_pc_hi]
  io_data.ex_result     = bits#[execute_ex_result_lo ..= execute_ex_result_hi]
  io_data.mem_writedata = bits#[execute_mem_writedata_lo ..= execute_mem_writedata_hi]
  io_data.nextpc        = bits#[execute_nextpc_lo ..= execute_nextpc_hi]
  io_data.taken         = bits#[execute_taken_lo]
  io_data.instruction   = bits#[execute_instruction_lo ..= execute_instruction_hi]
  io_data.isValid       = bits#[execute_is_valid_lo]
}

comptime const memory_control_memop_lo = 2
comptime const memory_control_memop_hi = 3
comptime const memory_control_toreg_lo = 1
comptime const memory_control_regwrite_lo = 0

pub comb pack_memory_control(io_in:(memop:u2, toreg:u1, regwrite:u1)) -> (bits:u4) {
  bits = (io_in.memop << memory_control_memop_lo)
    | (io_in.toreg << memory_control_toreg_lo)
    | io_in.regwrite
}

pub comb unpack_memory_control(bits:u4) -> (io_data:(mem_ctrl:(memop:u2), wb_ctrl:(toreg:u1, regwrite:u1))) {
  io_data.mem_ctrl.memop   = bits#[memory_control_memop_lo ..= memory_control_memop_hi]
  io_data.wb_ctrl.toreg    = bits#[memory_control_toreg_lo]
  io_data.wb_ctrl.regwrite = bits#[memory_control_regwrite_lo]
}

comptime const memory_pc_lo = 193
comptime const memory_pc_hi = 256
comptime const memory_readdata_lo = 129
comptime const memory_readdata_hi = 192
comptime const memory_ex_result_lo = 65
comptime const memory_ex_result_hi = 128
comptime const memory_instruction_lo = 1
comptime const memory_instruction_hi = 64
comptime const memory_is_valid_lo = 0

pub comb pack_memory(io_in:(pc:u64, readdata:u64, ex_result:u64, instruction:u64, isValid:u1)) -> (bits:u257) {
  bits = (io_in.pc << memory_pc_lo)
    | (io_in.readdata << memory_readdata_lo)
    | (io_in.ex_result << memory_ex_result_lo)
    | (io_in.instruction << memory_instruction_lo)
    | io_in.isValid
}

pub comb unpack_memory(bits:u257) -> (io_data:(pc:u64, readdata:u64, ex_result:u64, instruction:u64, isValid:u1)) {
  io_data.pc          = bits#[memory_pc_lo ..= memory_pc_hi]
  io_data.readdata    = bits#[memory_readdata_lo ..= memory_readdata_hi]
  io_data.ex_result   = bits#[memory_ex_result_lo ..= memory_ex_result_hi]
  io_data.instruction = bits#[memory_instruction_lo ..= memory_instruction_hi]
  io_data.isValid     = bits#[memory_is_valid_lo]
}

comptime const writeback_control_toreg_lo = 1
comptime const writeback_control_regwrite_lo = 0

pub comb pack_writeback_control(io_in:(toreg:u1, regwrite:u1)) -> (bits:u2) {
  bits = (io_in.toreg << writeback_control_toreg_lo)
    | io_in.regwrite
}

pub comb unpack_writeback_control(bits:u2) -> (io_data:(wb_ctrl:(toreg:u1, regwrite:u1))) {
  io_data.wb_ctrl.toreg    = bits#[writeback_control_toreg_lo]
  io_data.wb_ctrl.regwrite = bits#[writeback_control_regwrite_lo]
}
