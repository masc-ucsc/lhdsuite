const enc                     = import("encodings")
const StageReg                = import("StageReg.StageReg")
const ALU                     = import("ALU.ALU")
const ALUControl              = import("ALUControl.ALUControl")
const Control                 = import("Control.Control")
const DualIssueForwardingUnit = import("DualIssueForwardingUnit.DualIssueForwardingUnit")
const DualIssueHazardUnit     = import("DualIssueHazardUnit.DualIssueHazardUnit")
const DualIssueIssueUnit      = import("DualIssueIssueUnit.DualIssueIssueUnit")
const DualIssueNextPC         = import("DualIssueNextPC.DualIssueNextPC")
const DualIssueRegisterFile   = import("DualIssueRegisterFile.DualIssueRegisterFile")
const ImmediateGenerator      = import("ImmediateGenerator.ImmediateGenerator")

// Pipeline bundles, one per stage boundary. Instructions are 32-bit; the decode and
// later stages keep the 64-bit slot the reference uses.
type Fetch            = (instruction:U32, pc:U64, isValid:U1)
type Decode           = (pc:U64, instruction:U64, sextImm:U64, readdata1:U64, readdata2:U64, isValid:U1)
type Execute          = (ex_result:U64, mem_writedata:U64, nextpc:U64, taken:U1, instruction:U64, isValid:U1)
type Memory           = (readdata:U64, ex_result:U64, instruction:U64)
type ExecuteCtrl      = (itype:U1, aluop:U1, src1:U1, src2:U2, branch:U1, jumptype:U2, resultselect:U1, wordinst:U1)
type MemoryCtrl       = (memop:U2)
type WritebackCtrl    = (toreg:U1, regwrite:U1)
type ExecuteControl   = (ex_ctrl:ExecuteCtrl, mem_ctrl:MemoryCtrl, wb_ctrl:WritebackCtrl)
type MemoryControl    = (mem_ctrl:MemoryCtrl, wb_ctrl:WritebackCtrl)
type WritebackControl = (wb_ctrl:WritebackCtrl)

// Operand mux for one lane. Lane B reserves selector 1 for EX-A, a path this design lacks
// (it selects zero), so the selector codes differ per lane.
comb forward_operand(mem_a:U64, mem_b:U64, original:U64, pipe_b:Bool, select:U3, wb_a:U64, wb_b:U64) -> (value:U64) {
  value = if pipe_b {
    match select {
      == enc.forward_original { original }
      == enc.b_forward_mem_a { mem_a }
      == enc.b_forward_mem_b { mem_b }
      == enc.b_forward_wb_a { wb_a }
      == enc.b_forward_wb_b { wb_b }
      else { 0 }
    }
  } else {
    match select {
      == enc.forward_original { original }
      == enc.a_forward_mem_a { mem_a }
      == enc.a_forward_mem_b { mem_b }
      == enc.a_forward_wb_a { wb_a }
      == enc.a_forward_wb_b { wb_b }
      else { 0 }
    }
  }
}

// Instruction decode: the Control signals regrouped into the execute-stage bundle.
comb decode(opcode:U7) -> (control:ExecuteControl) {
  const c = Control(io_opcode=opcode)
  control.ex_ctrl.itype        = c.io_itype
  control.ex_ctrl.aluop        = c.io_aluop
  control.ex_ctrl.src1         = c.io_src1
  control.ex_ctrl.src2         = c.io_src2
  control.ex_ctrl.branch       = c.io_branch
  control.ex_ctrl.jumptype     = c.io_jumptype
  control.ex_ctrl.resultselect = c.io_resultselect
  control.ex_ctrl.wordinst     = c.io_wordinst
  control.mem_ctrl.memop       = c.io_memop
  control.wb_ctrl.toreg        = c.io_toreg
  control.wb_ctrl.regwrite     = c.io_regwrite
}

// ALU operand B: register, immediate, or the constant 4 (link address).
comb alu_operand_y(forwarded:U64, immediate:U64, src2:U2) -> (y:U64) {
  y = if src2 == enc.src2_register { forwarded }
    elif src2 == enc.src2_immediate { immediate }
    elif src2 == enc.src2_four { enc.instruction_bytes }
    else { 0 }
}

// Dual-issue, in-order 5-stage RV64 pipeline. Lane A is the older instruction; lane B
// issues alongside it when independent. Fetch can stall (load-use); decode/execute/memory
// flush on redirects. Outputs are unconstrained (@[]) because they mix register state
// and same-cycle forwarding.
pub mod PipelinedDualIssueCPU::[
  timecheck=false
](
  clock:Clock,
  io_dmem_good:U1,
  io_dmem_readdata:U64,
  io_imem_good:U1,
  io_imem_instruction:U64,
  io_imem_ready:U1,
  reset:U1,
) -> (
  io_dmem_address:U64@[],
  io_dmem_maskmode:U2@[],
  io_dmem_memread:U1@[],
  io_dmem_memwrite:U1@[],
  io_dmem_sext:U1@[],
  io_dmem_valid:U1@[],
  io_dmem_writedata:U64@[],
  io_imem_address:U64@[],
  io_imem_valid:U1@[],
) {
  const rst = reset == 1

  // Stage outputs are forward-declared: write-back and redirects feed earlier stages.
  wire b_writeback_control:WritebackControl = nil
  wire a_writeback_control:WritebackControl = nil
  wire b_writeback:Memory                   = nil
  wire a_writeback:Memory                   = nil
  wire b_memory_control:MemoryControl       = nil
  wire a_memory_control:MemoryControl       = nil
  wire b_memory:Execute                     = nil
  wire a_memory:Execute                     = nil
  wire b_execute_control:ExecuteControl     = nil
  wire a_execute_control:ExecuteControl     = nil
  wire b_execute:Decode                     = nil
  wire a_execute:Decode                     = nil
  wire b_decode:Fetch                       = nil
  wire a_decode:Fetch                       = nil

  reg pc:U64:[reset_pin=rst] = 0

  const hazard = DualIssueHazardUnit(
    io_id_pipeA_rs1=a_decode.instruction#[enc.rs1_lo..=enc.rs1_hi],
    io_id_pipeA_rs2=a_decode.instruction#[enc.rs2_lo..=enc.rs2_hi],
    io_id_pipeB_rs1=b_decode.instruction#[enc.rs1_lo..=enc.rs1_hi],
    io_id_pipeB_rs2=b_decode.instruction#[enc.rs2_lo..=enc.rs2_hi],
    io_pipeA_idex_memread=a_execute_control.mem_ctrl.memop == enc.mem_load,
    io_pipeA_idex_rd=a_execute.instruction#[enc.rd_lo..=enc.rd_hi],
    io_pipeA_exmem_taken=a_memory.taken == 1,
    io_pipeB_idex_memread=b_execute_control.mem_ctrl.memop == enc.mem_load,
    io_pipeB_idex_rd=b_execute.instruction#[enc.rd_lo..=enc.rd_hi],
    io_pipeB_exmem_taken=b_memory.taken == 1,
  )

  // Fetch: two instructions per cycle from the aligned fetch address.
  const issue       = DualIssueIssueUnit(io_pc=pc, io_inst=io_imem_instruction)
  const redirect_pc = if b_memory.isValid == 1 { b_memory.nextpc } else { a_memory.nextpc }
  if hazard.io_pcfromtaken {
    pc = redirect_pc
  } elif not hazard.io_pcstall {
    pc = issue.io_nextpc
  }

  // Decode: register read (write-back writes are the register file's write ports), control, immediates.
  wire pipeA_wb_writedata:U64 = nil
  wire pipeB_wb_writedata:U64 = nil
  const pipeA_wb_rd   = a_writeback.instruction#[enc.rd_lo..=enc.rd_hi]
  const pipeB_wb_rd   = b_writeback.instruction#[enc.rd_lo..=enc.rd_hi]
  const a_instruction = a_decode.instruction#[0..=31]
  const b_instruction = b_decode.instruction#[0..=31]
  const registers     = DualIssueRegisterFile(
    io_pipeA_readreg1=a_decode.instruction#[enc.rs1_lo..=enc.rs1_hi],
    io_pipeA_readreg2=a_decode.instruction#[enc.rs2_lo..=enc.rs2_hi],
    io_pipeA_writereg=pipeA_wb_rd,
    io_pipeA_writedata=pipeA_wb_writedata,
    io_pipeA_wen=pipeA_wb_rd != 0 and a_writeback_control.wb_ctrl.regwrite == 1,
    io_pipeB_readreg1=b_decode.instruction#[enc.rs1_lo..=enc.rs1_hi],
    io_pipeB_readreg2=b_decode.instruction#[enc.rs2_lo..=enc.rs2_hi],
    io_pipeB_writereg=pipeB_wb_rd,
    io_pipeB_writedata=pipeB_wb_writedata,
    io_pipeB_wen=pipeB_wb_rd != 0 and b_writeback_control.wb_ctrl.regwrite == 1,
  )
  const pipeA_control = decode(opcode=a_decode.instruction#[enc.opcode_lo..=enc.opcode_hi])
  const pipeB_control = decode(opcode=b_decode.instruction#[enc.opcode_lo..=enc.opcode_hi])
  const pipeA_immGen  = ImmediateGenerator(io_instruction=a_instruction)
  const pipeB_immGen  = ImmediateGenerator(io_instruction=b_instruction)

  // Execute: forwarding, ALUs and the (single, oldest-lane-first) branch resolver.
  const forwarding             = DualIssueForwardingUnit(
    io_ex_pipeA_rs1=a_execute.instruction#[enc.rs1_lo..=enc.rs1_hi],
    io_ex_pipeA_rs2=a_execute.instruction#[enc.rs2_lo..=enc.rs2_hi],
    io_ex_pipeB_rs1=b_execute.instruction#[enc.rs1_lo..=enc.rs1_hi],
    io_ex_pipeB_rs2=b_execute.instruction#[enc.rs2_lo..=enc.rs2_hi],
    io_mem_pipeA_rd=a_memory.instruction#[enc.rd_lo..=enc.rd_hi],
    io_mem_pipeA_rw=a_memory_control.wb_ctrl.regwrite == 1,
    io_mem_pipeB_rd=b_memory.instruction#[enc.rd_lo..=enc.rd_hi],
    io_mem_pipeB_rw=b_memory_control.wb_ctrl.regwrite == 1,
    io_wb_pipeA_rd=pipeA_wb_rd,
    io_wb_pipeA_rw=a_writeback_control.wb_ctrl.regwrite == 1,
    io_wb_pipeB_rd=pipeB_wb_rd,
    io_wb_pipeB_rw=b_writeback_control.wb_ctrl.regwrite == 1,
  )
  const pipeA_forwarded_inputx = forward_operand(
    mem_a=a_memory.ex_result,
    mem_b=b_memory.ex_result,
    original=a_execute.readdata1,
    pipe_b=false,
    select=forwarding.io_pipeA_forward1,
    wb_a=pipeA_wb_writedata,
    wb_b=pipeB_wb_writedata,
  )
  const pipeA_forwarded_inputy = forward_operand(
    mem_a=a_memory.ex_result,
    mem_b=b_memory.ex_result,
    original=a_execute.readdata2,
    pipe_b=false,
    select=forwarding.io_pipeA_forward2,
    wb_a=pipeA_wb_writedata,
    wb_b=pipeB_wb_writedata,
  )
  const pipeB_forwarded_inputx = forward_operand(
    mem_a=a_memory.ex_result,
    mem_b=b_memory.ex_result,
    original=b_execute.readdata1,
    pipe_b=true,
    select=forwarding.io_pipeB_forward1,
    wb_a=pipeA_wb_writedata,
    wb_b=pipeB_wb_writedata,
  )
  const pipeB_forwarded_inputy = forward_operand(
    mem_a=a_memory.ex_result,
    mem_b=b_memory.ex_result,
    original=b_execute.readdata2,
    pipe_b=true,
    select=forwarding.io_pipeB_forward2,
    wb_a=pipeA_wb_writedata,
    wb_b=pipeB_wb_writedata,
  )

  const a_funct3         = a_execute.instruction#[enc.funct3_lo..=enc.funct3_hi]
  const b_funct3         = b_execute.instruction#[enc.funct3_lo..=enc.funct3_hi]
  const pipeA_aluControl = ALUControl(
    io_aluop=a_execute_control.ex_ctrl.aluop == 1,
    io_itype=a_execute_control.ex_ctrl.itype == 1,
    io_funct7=a_execute.instruction#[enc.funct7_lo..=enc.funct7_hi],
    io_funct3=a_funct3,
    io_wordinst=a_execute_control.ex_ctrl.wordinst == 1,
  )
  const pipeB_aluControl = ALUControl(
    io_aluop=b_execute_control.ex_ctrl.aluop == 1,
    io_itype=b_execute_control.ex_ctrl.itype == 1,
    io_funct7=b_execute.instruction#[enc.funct7_lo..=enc.funct7_hi],
    io_funct3=b_funct3,
    io_wordinst=b_execute_control.ex_ctrl.wordinst == 1,
  )
  const pipeA_alu        = ALU(
    io_operation=pipeA_aluControl,
    io_inputx=if a_execute_control.ex_ctrl.src1 == 1 { a_execute.pc } else { pipeA_forwarded_inputx },
    io_inputy=alu_operand_y(
      forwarded=pipeA_forwarded_inputy,
      immediate=a_execute.sextImm,
      src2=a_execute_control.ex_ctrl.src2,
    ),
  )
  const pipeB_alu        = ALU(
    io_operation=pipeB_aluControl,
    io_inputx=if b_execute_control.ex_ctrl.src1 == 1 { b_execute.pc } else { pipeB_forwarded_inputx },
    io_inputy=alu_operand_y(
      forwarded=pipeB_forwarded_inputy,
      immediate=b_execute.sextImm,
      src2=b_execute_control.ex_ctrl.src2,
    ),
  )
  const b_issued         = b_execute.isValid == 1
  const branch_unit      = DualIssueNextPC(
    io_branch=(if b_issued { b_execute_control.ex_ctrl.branch } else { a_execute_control.ex_ctrl.branch }) == 1,
    io_jumptype=if b_issued { b_execute_control.ex_ctrl.jumptype } else { a_execute_control.ex_ctrl.jumptype },
    io_inputx=if b_issued { pipeB_forwarded_inputx } else { pipeA_forwarded_inputx },
    io_inputy=if b_issued { pipeB_forwarded_inputy } else { pipeA_forwarded_inputy },
    io_funct3=if b_issued { b_funct3 } else { a_funct3 },
    io_pc=if b_issued { b_execute.pc } else { a_execute.pc },
    io_imm=if b_issued { b_execute.sextImm } else { a_execute.sextImm },
    io_pipeB_valid=b_issued,
  )

  // Memory stage: lane B's access wins when valid. Control bits come from memop.
  const b_in_memory = b_memory.isValid == 1
  const memop       = if b_in_memory { b_memory_control.mem_ctrl.memop } else { a_memory_control.mem_ctrl.memop }
  const mem_funct3  = (if b_in_memory { b_memory.instruction } else { a_memory.instruction })#[enc.funct3_lo..=enc.funct3_hi]

  // Write-back data and the register-file bypass values.
  pipeA_wb_writedata = if a_writeback_control.wb_ctrl.toreg == 1 { a_writeback.readdata } else { a_writeback.ex_result }
  pipeB_wb_writedata = if b_writeback_control.wb_ctrl.toreg == 1 { b_writeback.readdata } else { b_writeback.ex_result }

  // Pipeline storage: fetch can stall; decode/execute/memory can flush.
  const stall_enable = not hazard.io_if_id_stall
  const pipeA_if_id  = StageReg<T=Fetch>(
    reset=rst,
    data=(const instruction=issue.io_pipeA_inst, const pc=pc, const isValid=1),
    flush=hazard.io_if_id_flush,
    enable=stall_enable,
  )
  a_decode = pipeA_if_id.out
  const pipeB_if_id = StageReg<T=Fetch>(
    reset=rst,
    data=(
      const instruction=issue.io_pipeB_inst,
      const pc=(pc + enc.instruction_bytes)#[0..=63],
      const isValid=U1(issue.io_pipeB_valid),
    ),
    flush=hazard.io_if_id_flush,
    enable=stall_enable,
  )
  b_decode = pipeB_if_id.out
  const pipeA_id_ex = StageReg<T=Decode>(
    reset=rst,
    data=(
      const instruction=a_instruction,
      const isValid=a_decode.isValid,
      const pc=a_decode.pc,
      const readdata1=registers.io_pipeA_readdata1,
      const readdata2=registers.io_pipeA_readdata2,
      const sextImm=pipeA_immGen,
    ),
    flush=hazard.io_id_ex_flush,
    enable=true,
  )
  a_execute = pipeA_id_ex.out
  const pipeB_id_ex = StageReg<T=Decode>(
    reset=rst,
    data=(
      const instruction=b_instruction,
      const isValid=b_decode.isValid,
      const pc=b_decode.pc,
      const readdata1=registers.io_pipeB_readdata1,
      const readdata2=registers.io_pipeB_readdata2,
      const sextImm=pipeB_immGen,
    ),
    flush=hazard.io_id_ex_flush,
    enable=true,
  )
  b_execute = pipeB_id_ex.out
  const pipeA_id_ex_ctrl = StageReg<T=ExecuteControl>(
    reset=rst,
    data=pipeA_control,
    flush=hazard.io_id_ex_flush,
    enable=true,
  )
  a_execute_control = pipeA_id_ex_ctrl.out
  const pipeB_id_ex_ctrl = StageReg<T=ExecuteControl>(
    reset=rst,
    data=pipeB_control,
    flush=hazard.io_id_ex_flush,
    enable=true,
  )
  b_execute_control = pipeB_id_ex_ctrl.out
  const pipeA_ex_mem = StageReg<T=Execute>(
    reset=rst,
    data=(
      const ex_result=if a_execute_control.ex_ctrl.resultselect == 1 { a_execute.sextImm } else { pipeA_alu },
      const instruction=a_execute.instruction,
      const isValid=a_execute.isValid,
      const mem_writedata=pipeA_forwarded_inputy,
      const nextpc=if b_issued { 0 } else { branch_unit.io_nextpc },
      const taken=U1(not b_issued and branch_unit.io_taken),
    ),
    flush=hazard.io_ex_mem_flush,
    enable=true,
  )
  a_memory = pipeA_ex_mem.out
  const pipeB_ex_mem = StageReg<T=Execute>(
    reset=rst,
    data=(
      const ex_result=if b_execute_control.ex_ctrl.resultselect == 1 { b_execute.sextImm } else { pipeB_alu },
      const instruction=b_execute.instruction,
      const isValid=b_execute.isValid,
      const mem_writedata=pipeB_forwarded_inputy,
      const nextpc=if b_issued { branch_unit.io_nextpc } else { 0 },
      const taken=U1(b_issued and branch_unit.io_taken),
    ),
    flush=hazard.io_ex_mem_flush,
    enable=true,
  )
  b_memory = pipeB_ex_mem.out
  const pipeA_ex_mem_ctrl = StageReg<T=MemoryControl>(
    reset=rst,
    data=(const mem_ctrl=a_execute_control.mem_ctrl, const wb_ctrl=a_execute_control.wb_ctrl),
    flush=hazard.io_ex_mem_flush,
    enable=true,
  )
  a_memory_control = pipeA_ex_mem_ctrl.out
  const pipeB_ex_mem_ctrl = StageReg<T=MemoryControl>(
    reset=rst,
    data=(const mem_ctrl=b_execute_control.mem_ctrl, const wb_ctrl=b_execute_control.wb_ctrl),
    flush=hazard.io_ex_mem_flush,
    enable=true,
  )
  b_memory_control = pipeB_ex_mem_ctrl.out
  const pipeA_mem_wb = StageReg<T=Memory>(
    reset=rst,
    data=(const ex_result=a_memory.ex_result, const instruction=a_memory.instruction, const readdata=io_dmem_readdata),
    flush=false,
    enable=true,
  )
  a_writeback = pipeA_mem_wb.out
  const pipeB_mem_wb = StageReg<T=Memory>(
    reset=rst,
    data=(const ex_result=b_memory.ex_result, const instruction=b_memory.instruction, const readdata=io_dmem_readdata),
    flush=false,
    enable=true,
  )
  b_writeback = pipeB_mem_wb.out
  const pipeA_mem_wb_ctrl = StageReg<T=WritebackControl>(
    reset=rst,
    data=(const wb_ctrl=a_memory_control.wb_ctrl),
    flush=false,
    enable=true,
  )
  a_writeback_control = pipeA_mem_wb_ctrl.out
  const pipeB_mem_wb_ctrl = StageReg<T=WritebackControl>(
    reset=rst,
    data=(const wb_ctrl=b_memory_control.wb_ctrl),
    flush=false,
    enable=true,
  )
  b_writeback_control = pipeB_mem_wb_ctrl.out

  io_imem_address   = pc
  io_imem_valid     = 1
  io_dmem_address   = if b_in_memory { b_memory.ex_result } else { a_memory.ex_result }
  io_dmem_valid     = memop#[1]
  io_dmem_writedata = if b_in_memory { b_memory.mem_writedata } else { a_memory.mem_writedata }
  io_dmem_memread   = ~memop#[0]
  io_dmem_memwrite  = memop#[0]
  io_dmem_maskmode  = mem_funct3#[0..=1]
  io_dmem_sext      = ~mem_funct3#[2]
}
