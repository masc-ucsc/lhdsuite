// Pipeline register for one bundle `T`; the bundle gets no bit layout.
// Loads `data` when enabled; reset or flush clears it (reset_pin is a synchronous clear).
pub mod StageReg<T>(data:T, enable:Bool, flush:Bool, reset:Bool) -> (out:T@[0]) {
  const clear = reset or flush
  reg reg_0:T:[reset_pin=clear] = 0
  if enable {
    reg_0 = data
  }
  out = reg_0
}
