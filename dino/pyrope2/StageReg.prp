// One storage module for every pipeline stage. Named bundle conversions are pure.
pub mod StageReg<T=u97>(clock:u1, reset:u1, io_in:T, io_flush:u1, io_valid:u1) -> (io_data:T@[]) {
  reg reg_0:T:[reset_pin=ref reset] = 0
  io_data = reg_0
  if io_flush != 0 { reg_0 = 0 } elif io_valid != 0 { reg_0 = io_in }
}
