const enc = import("encodings")
comptime const funct3_add_sub = 0
comptime const funct3_sll = 1
comptime const funct3_slt = 2
comptime const funct3_sltu = 3
comptime const funct3_xor = 4
comptime const funct3_right_shift = 5
comptime const funct3_or = 6
comptime const funct3_and = 7
comptime const funct7_add = 0
comptime const funct7_sub = 32
comptime const shift_logical = 0
comptime const shift_arithmetic = 16

pub mod ALUControl::[timecheck = false](io_aluop:u1, io_itype:u1, io_funct7:u7, io_funct3:u3, io_wordinst:u1) -> (
  io_operation:u5@[]
) {
  const word:u5 = io_wordinst << enc.alu_word_bit
  // Address calculation defaults to 64-bit addition.
  io_operation = if io_aluop != 0 {
    match io_funct3 {
      == funct3_add_sub {
        if io_itype != 0 or io_funct7 == funct7_add { word | enc.alu_add }
          elif io_funct7 == funct7_sub { word | enc.alu_sub }
          else { enc.alu_invalid }
      }
      == funct3_sll { word | enc.alu_sll }
      == funct3_slt { enc.alu_lt }
      == funct3_sltu { enc.alu_ltu }
      == funct3_xor { enc.alu_xor }
      == funct3_right_shift {
        if io_funct7#[1 ..= 6] == shift_logical { word | enc.alu_srl }
          elif io_funct7#[1 ..= 6] == shift_arithmetic { word | enc.alu_sra }
          else { enc.alu_invalid }
      }
      == funct3_or { enc.alu_or }
      == funct3_and { enc.alu_and }
    }
  } else {
    enc.alu_add
  }
}
