const enc = import("encodings")

// Priority is MEM-B, MEM-A, WB-B, WB-A; register x0 is never forwarded.
pub mod DualIssueForwardingUnit::[timecheck = false](
  io_ex_pipeA_rs1:u5,
  io_ex_pipeA_rs2:u5,
  io_ex_pipeB_rs1:u5,
  io_ex_pipeB_rs2:u5,
  io_ex_pipeA_rd:u5,
  io_ex_pipeA_rw:u1,
  io_mem_pipeA_rd:u5,
  io_mem_pipeA_rw:u1,
  io_mem_pipeB_rd:u5,
  io_mem_pipeB_rw:u1,
  io_wb_pipeA_rd:u5,
  io_wb_pipeA_rw:u1,
  io_wb_pipeB_rd:u5,
  io_wb_pipeB_rw:u1
) -> (io_pipeA_forward1:u3@[], io_pipeA_forward2:u3@[], io_pipeB_forward1:u3@[], io_pipeB_forward2:u3@[]) {
  io_pipeA_forward1 = if io_ex_pipeA_rs1 == enc.zero_register { enc.forward_original }
    elif io_mem_pipeB_rw != 0 and io_mem_pipeB_rd == io_ex_pipeA_rs1 { enc.a_forward_mem_b }
    elif io_mem_pipeA_rw != 0 and io_mem_pipeA_rd == io_ex_pipeA_rs1 { enc.a_forward_mem_a }
    elif io_wb_pipeB_rw != 0 and io_wb_pipeB_rd == io_ex_pipeA_rs1 { enc.a_forward_wb_b }
    elif io_wb_pipeA_rw != 0 and io_wb_pipeA_rd == io_ex_pipeA_rs1 { enc.a_forward_wb_a }
    else { enc.forward_original }

  io_pipeA_forward2 = if io_ex_pipeA_rs2 == enc.zero_register { enc.forward_original }
    elif io_mem_pipeB_rw != 0 and io_mem_pipeB_rd == io_ex_pipeA_rs2 { enc.a_forward_mem_b }
    elif io_mem_pipeA_rw != 0 and io_mem_pipeA_rd == io_ex_pipeA_rs2 { enc.a_forward_mem_a }
    elif io_wb_pipeB_rw != 0 and io_wb_pipeB_rd == io_ex_pipeA_rs2 { enc.a_forward_wb_b }
    elif io_wb_pipeA_rw != 0 and io_wb_pipeA_rd == io_ex_pipeA_rs2 { enc.a_forward_wb_a }
    else { enc.forward_original }

  io_pipeB_forward1 = if io_ex_pipeB_rs1 == enc.zero_register { enc.forward_original }
    elif io_mem_pipeB_rw != 0 and io_mem_pipeB_rd == io_ex_pipeB_rs1 { enc.b_forward_mem_b }
    elif io_mem_pipeA_rw != 0 and io_mem_pipeA_rd == io_ex_pipeB_rs1 { enc.b_forward_mem_a }
    elif io_wb_pipeB_rw != 0 and io_wb_pipeB_rd == io_ex_pipeB_rs1 { enc.b_forward_wb_b }
    elif io_wb_pipeA_rw != 0 and io_wb_pipeA_rd == io_ex_pipeB_rs1 { enc.b_forward_wb_a }
    else { enc.forward_original }

  io_pipeB_forward2 = if io_ex_pipeB_rs2 == enc.zero_register { enc.forward_original }
    elif io_mem_pipeB_rw != 0 and io_mem_pipeB_rd == io_ex_pipeB_rs2 { enc.b_forward_mem_b }
    elif io_mem_pipeA_rw != 0 and io_mem_pipeA_rd == io_ex_pipeB_rs2 { enc.b_forward_mem_a }
    elif io_wb_pipeB_rw != 0 and io_wb_pipeB_rd == io_ex_pipeB_rs2 { enc.b_forward_wb_b }
    elif io_wb_pipeA_rw != 0 and io_wb_pipeA_rd == io_ex_pipeB_rs2 { enc.b_forward_wb_a }
    else { enc.forward_original }
}
