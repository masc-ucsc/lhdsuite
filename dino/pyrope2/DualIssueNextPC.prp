const enc = import("encodings")
comptime const branch_eq = 0
comptime const branch_ne = 1
comptime const branch_lt = 4
comptime const branch_ge = 5
comptime const branch_ltu = 6
comptime const branch_geu = 7

pub mod DualIssueNextPC::[timecheck = false](
  io_branch:u1,
  io_jumptype:u2,
  io_inputx:u64,
  io_inputy:u64,
  io_funct3:u3,
  io_pc:u64,
  io_imm:u64,
  io_pipeB_valid:u1
) -> (io_nextpc:u64@[], io_taken:u1@[]) {
  mut branch_taken:bool = false
  match io_funct3 {
    == branch_eq { branch_taken = io_inputx == io_inputy }
    == branch_ne { branch_taken = io_inputx != io_inputy }
    == branch_lt { branch_taken = io_inputx#sext[0 ..= 63] < io_inputy#sext[0 ..= 63] }
    == branch_ge { branch_taken = io_inputx#sext[0 ..= 63] >= io_inputy#sext[0 ..= 63] }
    == branch_ltu { branch_taken = io_inputx < io_inputy }
    == branch_geu { branch_taken = io_inputx >= io_inputy }
    else { branch_taken = false }
  }
  const taken:bool = if io_branch != 0 { branch_taken } else { io_jumptype != 0 }
  // The reference does not clear JALR bit zero; retain that behavior.
  const indirect:bool = io_branch == 0 and io_jumptype#[0] != 0
  const base:u64      = if indirect { io_inputx } else { io_pc }
  wrap io_nextpc = if taken { base + io_imm } else { io_pc + (if io_pipeB_valid != 0 { enc.fetch_bytes } else { enc.instruction_bytes }) }
  io_taken  = unsigned(taken)
}
