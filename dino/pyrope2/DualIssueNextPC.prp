const enc = import("encodings")

comptime const branch_eq  = 0
comptime const branch_ne  = 1
comptime const branch_lt  = 4
comptime const branch_ge  = 5
comptime const branch_ltu = 6
comptime const branch_geu = 7

// Resolves the branch or jump in EX: the taken flag and the next fetch address.
pub comb DualIssueNextPC(
  io_branch:Bool,
  io_funct3:U3,
  io_imm:U64,
  io_inputx:U64,
  io_inputy:U64,
  io_jumptype:U2,
  io_pc:U64,
  io_pipeB_valid:Bool,
) -> (io_nextpc:U64, io_taken:Bool) {
  const branch_taken = match io_funct3 {
    == branch_eq { io_inputx == io_inputy }
    == branch_ne { io_inputx != io_inputy }
    == branch_lt { io_inputx#sext[0..=63] < io_inputy#sext[0..=63] }
    == branch_ge { io_inputx#sext[0..=63] >= io_inputy#sext[0..=63] }
    == branch_ltu { io_inputx < io_inputy }
    == branch_geu { io_inputx >= io_inputy }
    else { false }
  }
  io_taken = if io_branch { branch_taken } else { io_jumptype != 0 }
  // The reference does not clear JALR bit zero; retain that behavior.
  const indirect = not io_branch and io_jumptype#[0] == 1
  const base:U64 = if indirect { io_inputx } else { io_pc }
  wrap io_nextpc = if io_taken { base + io_imm }
    else { io_pc + (if io_pipeB_valid { enc.fetch_bytes } else { enc.instruction_bytes }) }
}
