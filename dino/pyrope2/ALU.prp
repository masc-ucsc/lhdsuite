const enc = import("encodings")

comptime const full_msb       = 63
comptime const word_msb       = 31
comptime const full_shamt_msb = 5
comptime const word_shamt_msb = 4
comptime const operation_msb  = 3

// 64-bit ALU. The word flag (operation bit 4) only affects add, subtract and
// shifts: those operate on the low 32 bits and sign-extend the result.
pub comb ALU(io_inputx:U64, io_inputy:U64, io_operation:U5) -> (io_result:U64) {
  const word = io_operation#[enc.alu_word_bit] == 1
  mut sum:U64          = 0
  mut difference:U64   = 0
  mut left_shift:U64   = 0
  mut signed_shift:U64 = 0
  wrap sum          = io_inputx + io_inputy
  wrap difference   = io_inputx - io_inputy
  wrap left_shift   = if word { io_inputx#[0..=word_msb] << io_inputy#[0..=word_shamt_msb] }
    else { io_inputx << io_inputy#[0..=full_shamt_msb] }
  wrap signed_shift = if word {
    io_inputx#sext[0..=word_msb] >> io_inputy#[0..=word_shamt_msb]
  } else {
    io_inputx#sext[0..=full_msb] >> io_inputy#[0..=full_shamt_msb]
  }
  const right_shift:U64 = if word { io_inputx#[0..=word_msb] >> io_inputy#[0..=word_shamt_msb] }
    else { io_inputx >> io_inputy#[0..=full_shamt_msb] }
  io_result = match io_operation#[0..=operation_msb] {
    == enc.alu_xor { io_inputx ^ io_inputy }
    == enc.alu_ltu { U1(io_inputx < io_inputy) }
    == enc.alu_srl { if word { right_shift#sext[0..=word_msb] } else { right_shift } }
    == enc.alu_sra { if word { signed_shift#sext[0..=word_msb] } else { signed_shift } }
    == enc.alu_sub { if word { difference#sext[0..=word_msb] } else { difference } }
    == enc.alu_or { io_inputx | io_inputy }
    == enc.alu_and { io_inputx & io_inputy }
    == enc.alu_add { if word { sum#sext[0..=word_msb] } else { sum } }
    == enc.alu_sll { if word { left_shift#sext[0..=word_msb] } else { left_shift } }
    == enc.alu_lt { U1(io_inputx#sext[0..=full_msb] < io_inputy#sext[0..=full_msb]) }
    == enc.alu_nor { ~(io_inputx | io_inputy) }
    == enc.alu_ge { U1(io_inputx#sext[0..=full_msb] >= io_inputy#sext[0..=full_msb]) }
    == enc.alu_geu { U1(io_inputx >= io_inputy) }
    == enc.alu_eq { U1(io_inputx == io_inputy) }
    == enc.alu_ne { U1(io_inputx != io_inputy) }
    else { 0 }
  }
}
