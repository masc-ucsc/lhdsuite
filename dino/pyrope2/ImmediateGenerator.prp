const enc = import("encodings")

// Sign-extended immediate for each RISC-V instruction format. The U/J/B/S/I
// layouts are the only packed encodings here.
pub comb ImmediateGenerator(io_instruction:U64) -> (io_sextImm:U64) {
  wrap io_sextImm = match io_instruction#[enc.opcode_lo..=enc.opcode_hi] {
    in (enc.op_lui, enc.op_auipc) {
      (io_instruction#[12..=31] << 12)#sext[0..=31]
    } // U
    == enc.op_jal { // J
      const immediate:U21 = (io_instruction#[     31] << 20)
                          | (io_instruction#[12..=19] << 12)
                          | (io_instruction#[     20] << 11)
                          | (io_instruction#[21..=30] <<  1)
      immediate#sext[0..=20]
    }
    == enc.op_branch { // B
      const immediate:U13 = (io_instruction#[     31] << 12)
                          | (io_instruction#[      7] << 11)
                          | (io_instruction#[25..=30] <<  5)
                          | (io_instruction#[ 8..=11] <<  1)
      immediate#sext[0..=12]
    }
    in (enc.op_jalr, enc.op_load, enc.op_immediate, enc.op_immediate_word) {
      io_instruction#sext[20..=31]
    } // I
    == enc.op_store { // S
      const immediate:U12 = (io_instruction#[enc.funct7_lo..=enc.funct7_hi] << 5) | io_instruction#[enc.rd_lo..=enc.rd_hi]
      immediate#sext[0..=11]
    }
    == enc.op_system {
      io_instruction#[enc.rs1_lo..=enc.rs1_hi]
    }
    else {
      0
    }
  }
}
