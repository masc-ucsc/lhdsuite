const enc = import("encodings")

// Instruction decoder: opcode -> execute / memory / write-back control signals.
// (The reference's unused io_validinst output is omitted.)
pub comb Control(
  io_opcode:U7
) -> (
  io_aluop:U1,
  io_branch:U1,
  io_itype:U1,
  io_jumptype:U2,
  io_memop:U2,
  io_regwrite:U1,
  io_resultselect:U1,
  io_src1:U1,
  io_src2:U2,
  io_toreg:U1,
  io_wordinst:U1,
) {
  const register_op  = io_opcode == enc.op_register or io_opcode == enc.op_register_word
  const immediate_op = io_opcode == enc.op_immediate or io_opcode == enc.op_immediate_word
  const load         = io_opcode == enc.op_load
  const store        = io_opcode == enc.op_store
  const branch       = io_opcode == enc.op_branch
  const lui          = io_opcode == enc.op_lui
  const auipc        = io_opcode == enc.op_auipc
  const jal          = io_opcode == enc.op_jal
  const jalr         = io_opcode == enc.op_jalr
  const jump         = jal or jalr

  io_itype = U1(immediate_op)
  io_aluop = U1(register_op or immediate_op)
  io_src1 = U1(auipc or jump)
  io_src2 = if jump { enc.src2_four } elif immediate_op or load or store or auipc { enc.src2_immediate } else { enc.src2_register }
  io_branch = U1(branch)
  io_jumptype = if jal { enc.jump_direct } elif jalr { enc.jump_indirect } else { enc.jump_none }
  io_resultselect = U1(lui)
  io_wordinst = U1(io_opcode == enc.op_immediate_word or io_opcode == enc.op_register_word)
  io_memop = if load { enc.mem_load } elif store { enc.mem_store } else { enc.mem_none }
  io_toreg = U1(load)
  io_regwrite = U1(register_op or immediate_op or load or lui or auipc or jump)
}
