const enc = import("encodings")

pub mod DualIssueRegisterFile::[timecheck = false](
  clock:u1,
  io_pipeA_readreg1:u5,
  io_pipeA_readreg2:u5,
  io_pipeA_writereg:u5,
  io_pipeA_writedata:u64,
  io_pipeA_wen:u1,
  io_pipeB_readreg1:u5,
  io_pipeB_readreg2:u5,
  io_pipeB_writereg:u5,
  io_pipeB_writedata:u64,
  io_pipeB_wen:u1
) -> (io_pipeA_readdata1:u64@[], io_pipeA_readdata2:u64@[], io_pipeB_readdata1:u64@[], io_pipeB_readdata2:u64@[]) {
  // Unreset storage; reads observe committed data. Port B wins write collisions.
  reg regs:[enc.register_count]u64:[ordering = "old"] = nil
  io_pipeA_readdata1 = if io_pipeA_readreg1 == enc.zero_register { 0 } else { regs[io_pipeA_readreg1] }
  io_pipeA_readdata2 = if io_pipeA_readreg2 == enc.zero_register { 0 } else { regs[io_pipeA_readreg2] }
  io_pipeB_readdata1 = if io_pipeB_readreg1 == enc.zero_register { 0 } else { regs[io_pipeB_readreg1] }
  io_pipeB_readdata2 = if io_pipeB_readreg2 == enc.zero_register { 0 } else { regs[io_pipeB_readreg2] }
  if io_pipeA_wen != 0 { regs[io_pipeA_writereg] = io_pipeA_writedata }
  if io_pipeB_wen != 0 { regs[io_pipeB_writereg] = io_pipeB_writedata }
}
