pub mod DualIssueHazardUnit::[timecheck = false](
  io_id_pipeA_rs1:u5,
  io_id_pipeA_rs2:u5,
  io_id_pipeB_rs1:u5,
  io_id_pipeB_rs2:u5,
  io_pipeA_idex_memread:u1,
  io_pipeA_idex_rd:u5,
  io_pipeA_exmem_taken:u1,
  io_pipeB_idex_memread:u1,
  io_pipeB_idex_rd:u5,
  io_pipeB_exmem_taken:u1
) -> (
  io_pcfromtaken:u1@[],
  io_pcstall:u1@[],
  io_if_id_stall:u1@[],
  io_id_ex_flush:u1@[],
  io_ex_mem_flush:u1@[],
  io_if_id_flush:u1@[]
) {
  const redirect:bool     = io_pipeA_exmem_taken != 0 or io_pipeB_exmem_taken != 0
  const a_dependency:bool = io_pipeA_idex_rd == io_id_pipeA_rs1
                            or io_pipeA_idex_rd == io_id_pipeA_rs2
                            or io_pipeA_idex_rd == io_id_pipeB_rs1
                            or io_pipeA_idex_rd == io_id_pipeB_rs2
  const b_dependency:bool = io_pipeB_idex_rd == io_id_pipeA_rs1
                            or io_pipeB_idex_rd == io_id_pipeA_rs2
                            or io_pipeB_idex_rd == io_id_pipeB_rs1
                            or io_pipeB_idex_rd == io_id_pipeB_rs2
  // Preserve the reference's conservative hazard even for rd == x0.
  const load_use:bool = (io_pipeA_idex_memread != 0 and a_dependency) or (io_pipeB_idex_memread != 0 and b_dependency)
  io_pcfromtaken      = unsigned(redirect)
  io_pcstall          = unsigned(not redirect and load_use)
  io_if_id_stall      = io_pcstall
  io_id_ex_flush      = unsigned(redirect or load_use)
  io_ex_mem_flush     = unsigned(redirect)
  io_if_id_flush      = unsigned(redirect)
}
