// Redirects (a taken branch/jump in MEM) flush the front of the pipe. A load in
// EX whose destination matches any decode source stalls fetch and decode for a cycle.
pub comb DualIssueHazardUnit(
  io_id_pipeA_rs1:U5,
  io_id_pipeA_rs2:U5,
  io_id_pipeB_rs1:U5,
  io_id_pipeB_rs2:U5,
  io_pipeA_exmem_taken:Bool,
  io_pipeA_idex_memread:Bool,
  io_pipeA_idex_rd:U5,
  io_pipeB_exmem_taken:Bool,
  io_pipeB_idex_memread:Bool,
  io_pipeB_idex_rd:U5,
) -> (
  io_ex_mem_flush:Bool,
  io_id_ex_flush:Bool,
  io_if_id_flush:Bool,
  io_if_id_stall:Bool,
  io_pcfromtaken:Bool,
  io_pcstall:Bool,
) {
  const sources  = (io_id_pipeA_rs1, io_id_pipeA_rs2, io_id_pipeB_rs1, io_id_pipeB_rs2)
  const redirect = io_pipeA_exmem_taken or io_pipeB_exmem_taken
  // Preserve the reference's conservative hazard even for rd == x0.
  const load_use = (io_pipeA_idex_memread and io_pipeA_idex_rd in sources)
    or (io_pipeB_idex_memread and io_pipeB_idex_rd in sources)
  io_pcfromtaken  = redirect
  io_pcstall      = not redirect and load_use
  io_if_id_stall  = io_pcstall
  io_id_ex_flush  = redirect or load_use
  io_ex_mem_flush = redirect
  io_if_id_flush  = redirect
}
