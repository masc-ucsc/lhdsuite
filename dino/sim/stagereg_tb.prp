// Standalone capture check for the default 97-bit StageReg specialization.
// The old fetch tuple is now passed as its packed bit vector. Field slices keep
// checks within 64 bits while covering all 97 bits, including the high instruction.
const sreg = import("StageReg.StageReg")

test sreg.hello(cycles:u20 = 1000) {
  comptime const pc_lo = 1
  comptime const stimulus_pc = 0x91a

  mut acc = sreg
  mut got_instruction = 0
  mut got_pc = 0
  mut got_isvalid = 0
  tick cycles clocks=(clock=1) {
    acc.reset = clock < 2
    acc.io_flush = 0
    acc.io_valid = 1
    acc.io_in = stimulus_pc << pc_lo
    step
    // LiveHD test bit selectors currently require literal bounds (see cleanup_issues.md).
    got_instruction = acc.io_data#[65 ..= 96]
    got_pc = acc.io_data#[1 ..= 64]
    got_isvalid = acc.io_data#[0]
  }
  assert(got_instruction == 0 and got_pc == stimulus_pc and got_isvalid == 0,
         "StageReg latched the driven value after reset")
  const got = (got_pc << pc_lo) | got_isvalid
  puts("hello world: dino StageReg ran {cycles} cycles, data={got}")
}
