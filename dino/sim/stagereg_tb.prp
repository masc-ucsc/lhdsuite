// Standalone capture check for the default 97-bit StageReg specialization.
// The fetch tuple ports are driven and read field by field (instruction, pc, isValid).
const sreg = import("StageReg.StageReg")

test sreg.hello(cycles:U20 = 1000) {
  comptime const pc_lo = 1
  comptime const stimulus_pc = 0x91a

  mut acc = sreg
  mut got_instruction = 0
  mut got_pc = 0
  mut got_isvalid = 0
  tick cycles {
    acc.reset = U1(clock < 2)
    acc.io_flush = 0
    acc.io_valid = 1
    acc.io_in.instruction = 0
    acc.io_in.pc = stimulus_pc
    acc.io_in.isValid = 0
    step
    got_instruction = acc.io_data.instruction
    got_pc = acc.io_data.pc
    got_isvalid = acc.io_data.isValid
  }
  assert(got_instruction == 0 and got_pc == stimulus_pc and got_isvalid == 0,
         "StageReg latched the driven value after reset")
  const got = (got_pc << pc_lo) | got_isvalid
  puts("hello world: dino StageReg ran {cycles} cycles, data={got}")
}
