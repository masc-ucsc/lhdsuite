// Verilog-side twin of stagereg_tb.prp: same module, same stimulus, but the
// slang re-emission of dino/verilog carries the port as a TUPLE.
//
// dino/verilog/StageReg.sv declares
//   input struct packed {logic [31:0] instruction; logic [63:0] pc;
//                        logic isValid;} io_in
// which `lhd compile verilog --emit-dir pyrope:` emits as a Pyrope tuple port
//   io_in:(instruction:u32, pc:u64, isValid:u1)
// while the checked-in dino/pyrope/StageReg.prp declares that same port as one
// flat io_in:u97. A whole-tuple scalar write (`acc.io_in = 0x1234`, what
// stagereg_tb.prp does) names no field of the tuple, so MODE=verilog drives
// the leaves instead; bench/defs.bzl points the verilog sim at this file
// through the per-core `sim_tb_v` knob.
//
// Stimulus is the 0x1234 the flat testbench drives, in the struct's field
// layout {instruction[96:65], pc[64:1], isValid[0]}: pc = 0x91a, rest 0. Each
// leaf is checked on its own and the printed `data=` is the packed value the
// flat testbench prints, so one CORE_SIM_EXPECT gates both modes.
//
// Do NOT compare a reconstructed 97-bit value here: testbench scalars
// silently truncate past 64 bits (`x << 65` folds to 0 — fixme.md issue 6),
// so a packed compare would be checking zeros.
//
// Usage: copy next to a Pyrope re-emission of dino/verilog, then:
//   lhd sim <dir>/stagereg_v_tb.prp
const stage = import("StageReg.StageReg")

test stage.hello(cycles:u20 = 1000) {
  mut acc = stage
  mut got_instruction = 0
  mut got_pc = 0
  mut got_isvalid = 0
  tick cycles clocks=(clock=1) {
    acc.reset = clock < 2
    acc.io_flush = 0
    acc.io_valid = 1
    acc.io_in.instruction = 0
    acc.io_in.pc = 0x91a
    acc.io_in.isValid = 0
    step
    got_instruction = acc.io_data.instruction
    got_pc = acc.io_data.pc
    got_isvalid = acc.io_data.isValid
  }
  assert(got_instruction == 0 and got_pc == 0x91a and got_isvalid == 0,
         "StageReg latched the driven value after reset")
  const got = (got_pc << 1) | got_isvalid
  puts("hello world: dino StageReg ran {cycles} cycles, data={got}")
}
