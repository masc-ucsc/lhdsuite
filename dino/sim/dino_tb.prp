// Hello-world simulation driver for the dino dual-issue CPU. Both language
// sides expose the same interface, so the same driver serves dino/pyrope and
// the Verilog compiled straight to an lgraph library
// (lhd compile verilog ... --emit-dir lg:DIR).
//
// This is the additional whole-top NOP-stream correctness gate in
// //bench:sim_*; dino_prog_tb.prp is the asserted, timed benchmark.
//
// The DUT is named as `lg:NAME`, i.e. a module already compiled in the same
// `lhd sim` invocation, rather than as a source path — that is what lets one
// driver serve both a Pyrope tree and an `lg:` library. So supply the design
// BEFORE this file:
//   lhd sim dino/pyrope/PipelinedDualIssueCPU.prp dino/sim/dino_tb.prp --workdir W
//   lhd sim lg:DIR dino/sim/dino_tb.prp --workdir W
// (`tick N clocks=(clock=1)` advances N cycles; `clock` is the cycle index.)
const cpu = import("lg:PipelinedDualIssueCPU")

test cpu.hello(cycles:u20 = 1000) {
  mut acc = cpu
  mut addr = 0
  tick cycles clocks=(clock=1) {
    acc.reset = clock < 2
    acc.io_imem_good = 1
    acc.io_imem_ready = 1
    acc.io_imem_instruction = 0x1300000013  // two NOPs (addi x0,x0,0) per fetch
    acc.io_dmem_good = 1
    acc.io_dmem_readdata = 0
    step
    addr = acc.io_imem_address
  }
  assert(addr > 0, "PC advanced past reset on a NOP stream")
  puts("hello world: dino ran {cycles} cycles, pc={addr}")
}
