const profiles = import("TileProfiles")
comptime const defaultTiles = profiles.selected
const mixed_soc = import("mixed_soc.mixed_soc")

pub mod MeshFabric<Tiles=defaultTiles, boomHarts=4>::[timecheck=false](`clock`:Clock, `reset`:U1, interrupts:U64=0, core_enable:U16, host_req_valid:U1, host_req_data:U64, host_req_addr:U32, host_req_meta:U40, host_rsp_ready:U1, mem_req_ready:U1, mem_rsp_valid:U1, mem_rsp_data:U64, mem_rsp_addr:U32, mem_rsp_meta:U40) -> (host_req_fire:U1@[], host_rsp_fire:U1@[], mem_req_fire:U1@[], mem_rsp_fire:U1@[], seen_mem_meta:U40@[], seen_host_meta:U40@[], seen_mem_addr:U32@[], seen_host_data:U64@[], host_req_ready:U1@[], host_rsp_valid:U1@[], host_rsp_data:U64@[], host_rsp_addr:U32@[], host_rsp_meta:U40@[], mem_req_valid:U1@[], mem_req_data:U64@[], mem_req_addr:U32@[], mem_req_meta:U40@[], mem_rsp_ready:U1@[]) {
