  mut `mem_rsp.tl_source` = 0
  mut `mem_rsp.sink` = 0
  mut `mem_rsp.addr` = 0
  mut `mem_rsp.mask` = 0
  mut `mem_rsp.data` = 0
  mut `mem_rsp.corrupt` = 0
  mut `mem_rsp.denied` = 0
  `host_req.data` = host_req_data#[0..<0x40]
  `host_req.addr` = host_req_addr#[0..<32]
  `host_req.denied` = host_req_meta & 1
  `host_req.corrupt` = (host_req_meta >> 1) & 1
  `host_req.mask` = (host_req_meta >> 2)#[0..<8]
  `host_req.sink` = (host_req_meta >> 10)#[0..<3]
  `host_req.tl_source` = (host_req_meta >> 13)#[0..<3]
  `host_req.param` = (host_req_meta >> 16)#[0..<3]
  `host_req.size` = (host_req_meta >> 19)#[0..<4]
  `host_req.opcode` = (host_req_meta >> 23)#[0..<4]
  `host_req.ch` = (host_req_meta >> 27)#[0..<3]
  `host_req.target` = (host_req_meta >> 30)#[0..<5]
  `host_req.origin` = (host_req_meta >> 35)#[0..<5]
  `mem_rsp.data` = mem_rsp_data#[0..<0x40]
  `mem_rsp.addr` = mem_rsp_addr#[0..<32]
  `mem_rsp.denied` = mem_rsp_meta & 1
  `mem_rsp.corrupt` = (mem_rsp_meta >> 1) & 1
  `mem_rsp.mask` = (mem_rsp_meta >> 2)#[0..<8]
  `mem_rsp.sink` = (mem_rsp_meta >> 10)#[0..<3]
  `mem_rsp.tl_source` = (mem_rsp_meta >> 13)#[0..<3]
  `mem_rsp.param` = (mem_rsp_meta >> 16)#[0..<3]
  `mem_rsp.size` = (mem_rsp_meta >> 19)#[0..<4]
  `mem_rsp.opcode` = (mem_rsp_meta >> 23)#[0..<4]
  `mem_rsp.ch` = (mem_rsp_meta >> 27)#[0..<3]
  `mem_rsp.target` = (mem_rsp_meta >> 30)#[0..<5]
  `mem_rsp.origin` = (mem_rsp_meta >> 35)#[0..<5]
  mut soc = mixed_soc<Tiles=Tiles, boomHarts=boomHarts>(interrupts, `clock` = `clock`, `reset` = `reset`, `core_enable.e15` = core_enable#[15..<16], `core_enable.e14` = core_enable#[14..<15], `core_enable.e13` = core_enable#[13..<14], `core_enable.e12` = core_enable#[12..<13], `core_enable.e11` = core_enable#[11..<12], `core_enable.e10` = core_enable#[10..<11], `core_enable.e9` = core_enable#[9..<10], `core_enable.e8` = core_enable#[8..<9], `core_enable.e7` = core_enable#[7..<8], `core_enable.e6` = core_enable#[6..<7], `core_enable.e5` = core_enable#[5..<6], `core_enable.e4` = core_enable#[4..<5], `core_enable.e3` = core_enable#[3..<4], `core_enable.e2` = core_enable#[2..<3], `core_enable.e1` = core_enable#[1..<2], `core_enable.e0` = core_enable & 1, host_req_valid = host_req_valid, `host_req.origin` = `host_req.origin`, `host_req.target` = `host_req.target`, `host_req.ch` = `host_req.ch`, `host_req.opcode` = `host_req.opcode`, `host_req.size` = `host_req.size`, `host_req.param` = `host_req.param`, `host_req.tl_source` = `host_req.tl_source`, `host_req.sink` = `host_req.sink`, `host_req.addr` = `host_req.addr`, `host_req.mask` = `host_req.mask`, `host_req.data` = `host_req.data`, `host_req.corrupt` = `host_req.corrupt`, `host_req.denied` = `host_req.denied`, host_rsp_ready = host_rsp_ready, mem_req_ready = mem_req_ready, mem_rsp_valid = mem_rsp_valid, `mem_rsp.origin` = `mem_rsp.origin`, `mem_rsp.target` = `mem_rsp.target`, `mem_rsp.ch` = `mem_rsp.ch`, `mem_rsp.opcode` = `mem_rsp.opcode`, `mem_rsp.size` = `mem_rsp.size`, `mem_rsp.param` = `mem_rsp.param`, `mem_rsp.tl_source` = `mem_rsp.tl_source`, `mem_rsp.sink` = `mem_rsp.sink`, `mem_rsp.addr` = `mem_rsp.addr`, `mem_rsp.mask` = `mem_rsp.mask`, `mem_rsp.data` = `mem_rsp.data`, `mem_rsp.corrupt` = `mem_rsp.corrupt`, `mem_rsp.denied` = `mem_rsp.denied`)
  const host_rsp_data__w1 = soc.host_rsp.data
  const host_rsp_meta__w1 = (soc.host_rsp.origin#[0..<5] << 35) | (soc.host_rsp.target#[0..<5] << 30) | (soc.host_rsp.ch#[0..<3] << 27) | (soc.host_rsp.opcode#[0..<4] << 23) | (soc.host_rsp.size#[0..<4] << 19) | (soc.host_rsp.param#[0..<3] << 16) | (soc.host_rsp.tl_source#[0..<3] << 13) | (soc.host_rsp.sink#[0..<3] << 10) | (soc.host_rsp.mask#[0..<8] << 2) | ((soc.host_rsp.corrupt & 1) << 1) | (soc.host_rsp.denied & 1)
  const mem_req_addr__w1 = soc.mem_req.addr
  const mem_req_meta__w1 = (soc.mem_req.origin#[0..<5] << 35) | (soc.mem_req.target#[0..<5] << 30) | (soc.mem_req.ch#[0..<3] << 27) | (soc.mem_req.opcode#[0..<4] << 23) | (soc.mem_req.size#[0..<4] << 19) | (soc.mem_req.param#[0..<3] << 16) | (soc.mem_req.tl_source#[0..<3] << 13) | (soc.mem_req.sink#[0..<3] << 10) | (soc.mem_req.mask#[0..<8] << 2) | ((soc.mem_req.corrupt & 1) << 1) | (soc.mem_req.denied & 1)
  mut _b2i_1 = if (`reset` == 0) and (host_req_valid != 0) and (soc.host_req_ready != 0) { 1 } else { 0 }
  host_req_fire = _b2i_1
  mut _b2i_2 = if (`reset` == 0) and (soc.host_rsp_valid != 0) and (host_rsp_ready != 0) { 1 } else { 0 }
  host_rsp_fire = _b2i_2
  mut _b2i_3 = if (`reset` == 0) and (soc.mem_req_valid != 0) and (mem_req_ready != 0) { 1 } else { 0 }
  mem_req_fire = _b2i_3
  mut _b2i_4 = if (`reset` == 0) and (mem_rsp_valid != 0) and (soc.mem_rsp_ready != 0) { 1 } else { 0 }
  mem_rsp_fire = _b2i_4
  if (soc.mem_req_valid != 0) and (mem_req_ready != 0) {
    seen_mem_meta = mem_req_meta__w1
    seen_mem_addr = mem_req_addr__w1
  }
  if (soc.host_rsp_valid != 0) and (host_rsp_ready != 0) {
    seen_host_meta = host_rsp_meta__w1
    seen_host_data = host_rsp_data__w1
  }
  host_req_ready = soc.host_req_ready
  host_rsp_valid = soc.host_rsp_valid
  host_rsp_data = host_rsp_data__w1
  host_rsp_addr = soc.host_rsp.addr
  host_rsp_meta = host_rsp_meta__w1
  mem_req_valid = soc.mem_req_valid
  mem_req_data = soc.mem_req.data
  mem_req_addr = mem_req_addr__w1
  mem_req_meta = mem_req_meta__w1
  mem_rsp_ready = soc.mem_rsp_ready
