pub mod GemminiSimTop::[timecheck=false](`clock`:Clock, `reset`:Reset, a_valid:U1, a_bits:U64, b_valid:U1, b_bits:U64, d_valid:U1, d_bits:U64, req_valid:U1, req_tag_id:U1, req_dataflow:U1, req_propagate:U1, req_shift:U5, req_a_transpose:U1, req_bd_transpose:U1, req_total_rows:U4, req_flush:U2, wr_valid:U1, wr_addr:U6, wr_data_0:U64, wr_data_1:U64, wr_data_2:U64, wr_data_3:U64, wr_acc:U1, wr_mask:U32, rd_valid:U1, rd_scale:U32, rd_addr:U6, rd_act:U3, rd_full:U1, rd_fromDMA:U1, rd_resp_ready:U1) -> (a_ready:U1@[], b_ready:U1@[], d_ready:U1@[], req_ready:U1@[], resp_valid:U1@[], resp_tag_id:U1@[], resp_data_0:U64@[], resp_data_1:U64@[], resp_data_2:U64@[], resp_data_3:U64@[], resp_total_rows:U4@[], resp_last:U1@[], wr_ready:U1@[], rd_req_ready:U1@[], rd_resp_valid:U1@[], rd_data_0:U64@[], rd_data_1:U64@[], rd_data_2:U64@[], rd_data_3:U64@[], rd_resp_fromDMA:U1@[], rd_resp_scale:U32@[], rd_resp_act:U3@[], rd_resp_bank:U2@[]) {
  const t9 = ((req_tag_id & 1) << 15) | ((req_dataflow & 1) << 14) | ((req_propagate & 1) << 13) | (req_shift#[0..<5] << 8) | ((req_a_transpose & 1) << 7) | ((req_bd_transpose & 1) << 6) | (req_total_rows#[0..<4] << 2) | req_flush#[0..<2]
  const t25 = (wr_addr#[0..<6] << 289) | (wr_data_3#[0..<0x40] << 225) | (wr_data_2#[0..<0x40] << 161) | (wr_data_1#[0..<0x40] << 97) | (wr_data_0#[0..<0x40] << 33) | ((wr_acc & 1) << 32) | wr_mask#[0..<32]
  const t35 = (rd_scale#[0..<32] << 139) | (rd_addr#[0..<6] << 133) | (rd_act#[0..<3] << 2) | ((rd_full & 1) << 1) | (rd_fromDMA & 1)
  mut tpu = GemminiTPU::[name=tpu](`clock` = `clock`, `reset` = `reset`, io_mesh_a_valid = a_valid, io_mesh_a_bits = a_bits, io_mesh_b_valid = b_valid, io_mesh_b_bits = b_bits, io_mesh_d_valid = d_valid, io_mesh_d_bits = d_bits, io_mesh_req_valid = req_valid, `io_mesh_req_bits.tag.id` = t9#[15..<16], `io_mesh_req_bits.pe_control.dataflow` = t9#[14..<15], `io_mesh_req_bits.pe_control.propagate` = t9#[13..<14], `io_mesh_req_bits.pe_control.shift` = t9#[8..<13], `io_mesh_req_bits.a_transpose` = t9#[7..<8], `io_mesh_req_bits.bd_transpose` = t9#[6..<7], `io_mesh_req_bits.total_rows` = t9#[2..<6], `io_mesh_req_bits.flush` = t9#[0..<2], io_acc_write_valid = wr_valid, `io_acc_write_bits.addr` = t25#[0x121..<0x127], `io_acc_write_bits.data` = t25#[33..<0x121], `io_acc_write_bits.acc` = t25#[32..<33], `io_acc_write_bits.mask` = t25#[0..<32], io_acc_read_req_valid = rd_valid, `io_acc_read_req_bits.scale` = t35#[0x8b..<0xab], `io_acc_read_req_bits.addr` = t35#[0x85..<0x8b], `io_acc_read_req_bits.igelu_qb` = t35#[0x65..<0x85], `io_acc_read_req_bits.igelu_qc` = t35#[0x45..<0x65], `io_acc_read_req_bits.iexp_qln2` = t35#[37..<0x45], `io_acc_read_req_bits.iexp_qln2_inv` = t35#[5..<37], `io_acc_read_req_bits.act` = t35#[2..<5], `io_acc_read_req_bits.full` = t35#[1..<2], `io_acc_read_req_bits.fromDMA` = t35 & 1, io_acc_read_resp_ready = rd_resp_ready)
  const mesh_resp__w1 = (tpu.io_mesh_resp.valid << 0x106) | (tpu.io_mesh_resp.bits.tag.id << 0x105) | (tpu.io_mesh_resp.bits.data << 5) | (tpu.io_mesh_resp.bits.total_rows << 1) | tpu.io_mesh_resp.bits.last
  const rd_resp__w1 = (tpu.io_acc_read_resp_bits.data << 0xa6) | (tpu.io_acc_read_resp_bits.fromDMA << 0xa5) | (tpu.io_acc_read_resp_bits.scale << 0x85) | (tpu.io_acc_read_resp_bits.igelu_qb << 0x65) | (tpu.io_acc_read_resp_bits.igelu_qc << 0x45) | (tpu.io_acc_read_resp_bits.iexp_qln2 << 37) | (tpu.io_acc_read_resp_bits.iexp_qln2_inv << 5) | (tpu.io_acc_read_resp_bits.act << 2) | tpu.io_acc_read_resp_bits.acc_bank_id
