const rockets = import("../../rocket/pyrope2/RocketConfig")
const booms   = import("../../boom4/common/pyrope/BoomConfig")

comptime const rocket = rockets.params(useDataScratchpad=false, dcacheSets=64, dcacheWays=2)
comptime const earlyRocket = rockets.params(useDataScratchpad=false, dcacheSets=64, dcacheWays=2, mulEarlyOut=true)

pub const uniform = (
  const tile0=rocket,
  const tile1=rocket,
  const tile10=rocket,
  const tile11=rocket,
  const tile12=booms.small,
  const tile13=booms.small,
  const tile14=booms.small,
  const tile15=booms.small,
  const tile2=rocket,
  const tile3=rocket,
  const tile4=rocket,
  const tile5=rocket,
  const tile6=rocket,
  const tile7=rocket,
  const tile8=rocket,
  const tile9=rocket,
)

comptime const fiveWideQueue       = booms.queue(dispatchWidth=5, numEntries=12, numSlowEntries=4)
comptime const fiveWideAlu         = booms.queue(dispatchWidth=5, issueWidth=5, numEntries=32, numSlowEntries=4, useFullIssueSel=false)
comptime const twoWideQueue        = booms.queue(dispatchWidth=2)
comptime const twoWideMemory       = booms.queue(dispatchWidth=2, useMatrixIssue=true, numEntries=12, numSlowEntries=4, issueWidth=2)
comptime const threeWideQueue      = booms.queue(dispatchWidth=3)
comptime const largeMemory         = booms.queue(dispatchWidth=3, numEntries=32, numSlowEntries=4, useFullIssueSel=false, issueWidth=2)
comptime const twoWideDirectMapped = booms.params(
  dTLBSets=2, dTLBWays=6,
  iTLB=booms.instructionTLB(nSets=2, nWays=6, nSectors=2, nSuperpageEntries=3),
  decodeWidth=2,
  maxBrCount=6,
  numLdqEntries=16,
  numStqEntries=16,
  enableColumnALUIssue=true,
  enableALUSingleWideDispatch=true,
  fp=twoWideQueue,
  unq=twoWideQueue,
  alu=booms.queue(dispatchWidth=2, issueWidth=2),
  numRasEntries=48,
  numImmPhysRegisters=12,
  nPMPs=0,
  nL2TLBEntries=0,
  enableConservativeSNI=true,
  mulDiv=booms.integerDivide(divUnroll=3, divEarlyOut=false),
  ftqEntries=32,
  intToFpLatency=1,
  fpu=booms.floatingPoint(sfmaLatency=3, dfmaLatency=3, divSqrt=false),
  nPerfCounters=6,
  enableSFBOpt=false,
  numIntPhysRegisters=80,
  numFpPhysRegisters=64,
  numIrfBanks=2,
  numRobEntries=64,
  boom2BPD=true,
  numFetchBufferEntries=16,
  mem=twoWideMemory,
  dcacheWays=1,
  icacheSets=32,
  icacheWays=1,
  enableBTBFastRepair=false,
)
comptime const deeperIssue         = booms.params(
  cachedSourceIds=2,
  lsuWidth=2,
  dcacheMSHRs=8,
  dTLBWays=32,
  dcacheWays=8,
  dcacheRowBits=128,
  numDCacheBanks=4,
  decodeWidth=5,
  maxBrCount=20,
  numLdqEntries=32,
  numStqEntries=32,
  enableColumnALUIssue=true,
  fetchWidth=8,
  numFetchBufferEntries=40,
  numRasEntries=0,
  numImmPhysRegisters=48,
  ftqEntries=40,
  numIntPhysRegisters=144,
  numFpPhysRegisters=128,
  numRobEntries=130,
  intToFpLatency=4,
  fpu=booms.floatingPoint(sfmaLatency=6, dfmaLatency=6),
  enablePrefetching=true,
  alpha21264BPD=true,
  enableBPDHPMs=true,
  nL2TLBEntries=128,
  nPMPs=16,
  nL2TLBWays=4,
  mulDiv=booms.integerDivide(divUnroll=4, divEarlyOutGranularity=8),
  localHistoryLength=16,
  localHistoryNSets=64,
  fp=booms.queue(dispatchWidth=5, issueWidth=2, numEntries=12, numSlowEntries=4),
  unq=fiveWideQueue,
  mem=booms.queue(dispatchWidth=5, issueWidth=3, numEntries=12, numSlowEntries=4),
  alu=fiveWideAlu,
)
comptime const smallDelayed        = booms.params(
  cachedSourceIds=2,
  dcacheMSHRs=4,
  dTLBWays=16,
  dcacheSets=128,
  dcacheRowBits=128,
  dcacheSinglePorted=true,
  numDCacheBanks=4,
  decodeWidth=3,
  maxBrCount=12,
  numLdqEntries=24,
  numStqEntries=12,
  fp=threeWideQueue,
  alu=booms.queue(dispatchWidth=3, issueWidth=3),
  unq=threeWideQueue,
  numRasEntries=12,
  ftqEntries=12,
  enableSlowBTBRedirect=true,
  enableGHistStallRepair=false,
  enableCompactingLSUDuringDispatch=false,
  enableFastLoadUse=true,
  enableStLdForwarding=true,
  numIntPhysRegisters=64,
  numFpPhysRegisters=56,
  numIrfBanks=4,
  numIrfReadPorts=4,
  numFrfBanks=2,
  numRobEntries=24,
  numFetchBufferEntries=30,
  mem=largeMemory,
  tageSinglePorted=true,
  icacheSinglePorted=false,
  enableICacheDelay=true,
  enableRasTopRepair=false,
)

