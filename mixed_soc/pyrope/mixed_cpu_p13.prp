const configs = import("../../boom4/common/pyrope/BoomConfig")
comptime const defaultTile = configs.small
const tl = import("mixed_packet")
const link = import("BoomEndpoint")

pub mod mixed_cpu_p13<IS_BOOM=1, ID=13, HOST=17, ACC=16, C=defaultTile, enabled=true>::[timecheck=false](`clock`:Clock, `reset`:U1, irq:U4=0, txr:U1, rxv:U1, rx:tl.Packet) -> (txv:U1@[], tx:tl.Packet@[], rxr:U1@[]) {
  const port = link.BoomEndpoint<C=C, hart=ID, enabled=enabled, host=HOST, accelerator=ACC, acceptProbes=(IS_BOOM != 0)>(clock, reset, irq, txr, rxv, rx)
  txv = port.txv
  tx = port.tx
  rxr = port.rxr
}
