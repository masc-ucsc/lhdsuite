const configs = import("../../rocket/pyrope2/RocketConfig")
comptime const defaultTile = configs.rv32
const tl = import("mixed_packet")
const port = import("RocketEndpoint.RocketEndpoint")

pub mod mixed_cpu_p3<IS_BOOM=0, ID=3, HOST=17, ACC=16, C=defaultTile>::[timecheck=false](clock:Clock, reset:U1, irq:U4=0, txr:U1, rxv:U1, rx:tl.Packet) -> (txv:U1@[], tx:tl.Packet@[], rxr:U1@[]) {
  const socket = port<C=C, hart=ID, host=HOST, accelerator=ACC>(clock, reset, irq, txr, rxv, rx)
  txv = socket.txv
  tx = socket.tx
  rxr = socket.rxr
}
