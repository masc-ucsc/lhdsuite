const profiles = import("TileProfiles")
comptime const defaultTiles = profiles.selected
const system = import("CoherentMixedSoc.CoherentMixedSoc")

pub mod MixedSocTop<Tiles=defaultTiles, sources=2, boomHarts=4>::[timecheck=false](`clock`:Clock, `reset`:U1, rtcTick:Bool=true, deviceInterrupts:Unsigned(bits=sources)=0, core_enable:U16, host_req_valid:U1, host_req_data:U64, host_req_addr:U32, host_req_meta:U40, host_rsp_ready:U1, mem_req_ready:U1, mem_rsp_valid:U1, mem_rsp_data:U64, mem_rsp_addr:U32, mem_rsp_meta:U40) -> (host_req_fire:U1@[], host_rsp_fire:U1@[], mem_req_fire:U1@[], mem_rsp_fire:U1@[], seen_mem_meta:U40@[], seen_host_meta:U40@[], seen_mem_addr:U32@[], seen_host_data:U64@[], host_req_ready:U1@[], host_rsp_valid:U1@[], host_rsp_data:U64@[], host_rsp_addr:U32@[], host_rsp_meta:U40@[], mem_req_valid:U1@[], mem_req_data:U64@[], mem_req_addr:U32@[], mem_req_meta:U40@[], mem_rsp_ready:U1@[], dirtyBeat:Bool@[], dirtyHart:U5@[]) {
  const soc = system<Tiles=Tiles, boomHarts=boomHarts, sources=sources, internalRAM=true>(
      clock, reset=Bool(reset), core_enable, host_req_valid, host_req_data, host_req_addr, host_req_meta, host_rsp_ready,
      mem_req_ready=Bool(mem_req_ready), mem_rsp_valid=Bool(mem_rsp_valid), mem_rsp_data, mem_rsp_addr, mem_rsp_meta,
      rtcTick, deviceInterrupts)
  dirtyBeat = soc.dirtyBeat
  dirtyHart = soc.dirtyHart
  host_req_fire = soc.host_req_fire
  host_rsp_fire = soc.host_rsp_fire
  seen_host_meta = soc.seen_host_meta
  seen_host_data = soc.seen_host_data
  host_req_ready = soc.host_req_ready
  host_rsp_valid = soc.host_rsp_valid
  host_rsp_data = soc.host_rsp_data
  host_rsp_addr = soc.host_rsp_addr
  host_rsp_meta = soc.host_rsp_meta
  mem_req_data = soc.mem_req_data
  mem_req_addr = soc.mem_req_addr
  mem_req_meta = soc.mem_req_meta
  mem_req_valid = U1(soc.mem_req_valid)
  mem_rsp_ready = U1(soc.mem_rsp_ready)
  mem_req_fire = U1(soc.externalRequest)
  mem_rsp_fire = U1(soc.externalResponse)
  seen_mem_addr = soc.externalAddress
  seen_mem_meta = soc.externalMeta
}
