// Generated by mixed_soc/scripts/gen_sim.py. Regenerate both twins together.
// Four CPUs start together after host writes eight Gemmini pointer pairs.
const top = import("lg:MixedSocTop")


test top.concurrent(cycles:U32 = 36000) {
  mut dut = top
  mut hindex:U64 = 0
  mut hwaiting:U64 = 0
  mut left:U64 = 0
  mut beat:U64 = 0
  mut saved_addr:U64 = 0
  mut saved_id:U64 = 0
  mut saved_size:U64 = 0
  mut saved_src:U64 = 0
  mut saved_op:U64 = 0
  mut boot:U64 = 0
  mut landed:U64 = 0
  mut finished:U64 = 0
  mut sum:U64 = 0
  tick cycles {
    dut.reset = clock < 8
    dut.core_enable = 0
    if hindex == 8 { dut.core_enable = 0xffff }
    dut.host_req_valid = 0
    if clock >= 8 and hindex < 8 and hwaiting == 0 { dut.host_req_valid = 1 }
    dut.host_req_addr = 0x18100 + (2048 * (hindex % 3)) + (8 * hindex)
    dut.host_req_data = (0x11000 + (128 * (15 - (2 * hindex)))) | ((0x11000 + (128 * (15 - ((2 * hindex) + 1)))) << 32)
    dut.host_req_meta = (3 << 19) | (255 << 2)
    dut.host_rsp_ready = 1
    dut.mem_req_ready = 0
    if left == 0 and hindex == 8 { dut.mem_req_ready = 1 }
    dut.mem_rsp_valid = 0
    if left != 0 { dut.mem_rsp_valid = 1 }
    mut width:U64 = 4
    if saved_id >= 12 { width = 8 }
    const address:U64 = (saved_addr & (0xffffffff ^ (width - 1))) + (width * beat)
    const pc0:U64 = address + 0
    mut ent0:U64 = 0x10040
    if saved_id >= 12 { ent0 = 0x10000 }
    const land0:U64 = 0x10200 + (128 * saved_id)
    const imm0:U64 = land0 - ent0
    mut word0:U64 = 0x13
    if pc0 == ent0 { word0 = (((imm0 >> 20) & 1) << 31) | (((imm0 >> 1) & 1023) << 21) | (((imm0 >> 11) & 1) << 20) | (((imm0 >> 12) & 255) << 12) | 0x6f }
    const pointer0:U64 = 0x18100 + (2048 * ((saved_id / 2) % 3)) + (4 * saved_id)
    if pc0 == land0 { word0 = ((pointer0 + 0x800) & 0xfffff000) | 0xb7 }
    if pc0 == (land0 + 4) { word0 = ((pointer0 & 4095) << 20) | 0xa103 }
    if pc0 == (land0 + 8) { word0 = 0x10067 }
    if pc0 == (0x11000 + (128 * (15 - (saved_id)))) { word0 = 0x6f }
    // Non-working harts execute: park: wfi; jal x0, park.
    if ((1 << saved_id) & 0x5009) == 0 {
      word0 = 0x13
      if pc0 == ent0 { word0 = 0x10500073 }
      if pc0 == (ent0 + 4) { word0 = 0xffdff06f }
    }
    const pc1:U64 = address + 4
    mut ent1:U64 = 0x10040
    if saved_id >= 12 { ent1 = 0x10000 }
    const land1:U64 = 0x10200 + (128 * saved_id)
    const imm1:U64 = land1 - ent1
    mut word1:U64 = 0x13
    if pc1 == ent1 { word1 = (((imm1 >> 20) & 1) << 31) | (((imm1 >> 1) & 1023) << 21) | (((imm1 >> 11) & 1) << 20) | (((imm1 >> 12) & 255) << 12) | 0x6f }
    const pointer1:U64 = 0x18100 + (2048 * ((saved_id / 2) % 3)) + (4 * saved_id)
    if pc1 == land1 { word1 = ((pointer1 + 0x800) & 0xfffff000) | 0xb7 }
    if pc1 == (land1 + 4) { word1 = ((pointer1 & 4095) << 20) | 0xa103 }
    if pc1 == (land1 + 8) { word1 = 0x10067 }
    if pc1 == (0x11000 + (128 * (15 - (saved_id)))) { word1 = 0x6f }
    // Non-working harts execute: park: wfi; jal x0, park.
    if ((1 << saved_id) & 0x5009) == 0 {
      word1 = 0x13
      if pc1 == ent1 { word1 = 0x10500073 }
      if pc1 == (ent1 + 4) { word1 = 0xffdff06f }
    }
    dut.mem_rsp_data = word0 | (word1 << 32)
    dut.mem_rsp_addr = 0
    mut dop:U64 = 1
    if saved_op == 6 { dop = 5 }
    const meta:U64 = (saved_id << 30) | (3 << 27) | (dop << 23) | (saved_size << 19) | (saved_src << 13)
    dut.mem_rsp_meta = meta#[0..=39]
    step
    mut obs:U64 = 0
    if dut.host_req_fire != 0 { hwaiting = 1 }
    if dut.host_rsp_fire != 0 {
      assert((((dut.seen_host_meta) >> 0) & 1) == 0)
      assert((((dut.seen_host_meta) >> 35) & 31) == (16 + (hindex % 3)))
      hwaiting = 0
      hindex += 1
      obs = 1
    }
    if dut.mem_rsp_fire != 0 {
      assert(left != 0)
      left -= 1
      beat += 1
      obs = obs | 2
    }
    if dut.mem_req_fire != 0 {
      saved_id = (((dut.seen_mem_meta) >> 35) & 31)
      saved_size = (((dut.seen_mem_meta) >> 19) & 15)
      saved_src = (((dut.seen_mem_meta) >> 13) & 7)
      saved_op = (((dut.seen_mem_meta) >> 23) & 15)
      saved_addr = dut.seen_mem_addr
      const channel:U64 = (((dut.seen_mem_meta) >> 27) & 7)
      assert(saved_id < 16)
      assert(channel == 0 or channel == 4)
      if channel == 0 {
        assert(saved_op == 4 or saved_op == 6)
        assert(saved_size <= 6)
        assert(saved_addr < 0x18000 or saved_addr >= 0x19800)
        left = 1
        // Size beats using the requester's bus width.
        if saved_id >= 12 { left = (1 << saved_size) / 8 }
        if saved_id < 12 { left = (1 << saved_size) / 4 }
        if left == 0 { left = 1 }
        beat = 0
        mut entry_pc:U64 = 0x10040
        if saved_id >= 12 { entry_pc = 0x10000 }
        if (((saved_addr) >> 6) & 67108863) == (((entry_pc) >> 6) & 67108863) { boot = boot | (1 << saved_id) }
        if saved_addr >= 0x10200 and saved_addr < 0x10a00 {
          assert(((1 << saved_id) & 0x5009) != 0)
          assert(((boot >> saved_id) & 1) == 1)
          assert((((saved_addr) >> 6) & 67108863) == (((0x10200 + (128 * saved_id)) >> 6) & 67108863))
          landed = landed | (1 << saved_id)
        }
        if saved_addr >= 0x11000 and saved_addr < 0x11800 {
          assert(((1 << saved_id) & 0x5009) != 0)
          assert(((landed >> saved_id) & 1) == 1)
          assert((((saved_addr) >> 6) & 67108863) == ((((0x11000 + (128 * (15 - (saved_id))))) >> 6) & 67108863))
          finished = finished | (1 << saved_id)
        }
      }
      obs = obs | (saved_id << 8) | (saved_addr << 16) | (channel << 4)
    }
    wrap sum = ((sum * 31) + obs) & 0x7fffffffffffffff
  }
  assert(hindex == 8)
  assert(boot == 0xffff)
  assert(landed == 0x5009)
  assert(finished == 0x5009)
  if cycles == 12000 { assert(sum == 2618389655497334948) }
  if cycles == 36000 { assert(sum == 1865501407077597348) }
  puts("mixed_soc: cycles={cycles} active={finished} sum={sum}")
}
