// ROM words from interrupt_harts.S, linked at 0x10000 with relaxation disabled.
const top = import("lg:MixedSocTop")
test top.interrupt_delivery {
  mut dut              = top
  mut left:U8          = 0
  mut beat:U8          = 0
  mut saved:U32        = 0
  mut reply:U40        = 0
  mut origin:U5        = 0
  mut passed:U16       = 0
  mut rocketBeats:U16  = 0
  mut smallBeats:U16   = 0
  mut twoWideBeats:U16 = 0
  mut certified:Bool = false
  tick 12000 {
    dut.reset            = clock < 8
    dut.core_enable      = 0x3008
    dut.deviceInterrupts = 3
    dut.rtcTick          = true
    dut.mem_req_ready    = left == 0
    dut.mem_rsp_valid    = left != 0
    dut.mem_rsp_meta     = reply
    dut.mem_rsp_addr     = saved
    const width   = if origin < 12 { 4 } else { 8 }
    const address = saved + beat*width
    mut rom:U64 = 0x0000006f0000006f
    if (address & ~7) == 0x10000 {
      rom = 0x000000000440006f
    } elif (address & ~7) == 0x10040 {
      rom = 0xf14024730040006f
    } elif (address & ~7) == 0x10048 {
      rom = 0x1842829300000297
    } elif (address & ~7) == 0x10050 {
      rom = 0x0000049330529073
    } elif (address & ~7) == 0x10058 {
      rom = 0x0024129302000937
    } elif (address & ~7) == 0x10060 {
      rom = 0x00100b93005909b3
    } elif (address & ~7) == 0x10068 {
      rom = 0x00112c3701fb9b93
    } elif (address & ~7) == 0x10070 {
      rom = 0x00445cb7233c0c13
    } elif (address & ~7) == 0x10078 {
      rom = 0x00300293566c8c93
    } elif (address & ~7) == 0x10080 {
      rom = 0x018ba22302541263
    } elif (address & ~7) == 0x10088 {
      rom = 0x0350000f039bae23
    } elif (address & ~7) == 0x10090 {
      rom = 0x0259282300100293
    } elif (address & ~7) == 0x10098 {
      rom = 0x0080029300100a13
    } elif (address & ~7) == 0x100a0 {
      rom = 0xff540a930740006f
    } elif (address & ~7) == 0x100a8 {
      rom = 0x002a93130c0002b7
    } elif (address & ~7) == 0x100b0 {
      rom = 0x0153202300530333
    } elif (address & ~7) == 0x100b8 {
      rom = 0x00131313ff440313
    } elif (address & ~7) == 0x100c0 {
      rom = 0x0073139300c30313
    } elif (address & ~7) == 0x100c8 {
      rom = 0x01c383b30c002e37
    } elif (address & ~7) == 0x100d0 {
      rom = 0x015e1e3300100e13
    } elif (address & ~7) == 0x100d8 {
      rom = 0x00c3131301c3a023
    } elif (address & ~7) == 0x100e0 {
      rom = 0x004b0b130c200b37
    } elif (address & ~7) == 0x100e8 {
      rom = 0x020042b7006b0b33
    } elif (address & ~7) == 0x100f0 {
      rom = 0x006282b300341313
    } elif (address & ~7) == 0x100f8 {
      rom = 0x7d0003130002a223
    } elif (address & ~7) == 0x10100 {
      rom = 0x0062a02300830333
    } elif (address & ~7) == 0x10108 {
      rom = 0x000012b700700a13
    } elif (address & ~7) == 0x10110 {
      rom = 0x3042907388828293
    } elif (address & ~7) == 0x10118 {
      rom = 0x0144906330046073
    } elif (address & ~7) == 0x10120 {
      rom = 0x003002930a30000f
    } elif (address & ~7) == 0x10128 {
      rom = 0xff44029300540663
    } elif (address & ~7) == 0x10130 {
      rom = 0x002002930080006f
    } elif (address & ~7) == 0x10138 {
      rom = 0x005c8cb3005c0c33
    } elif (address & ~7) == 0x10140 {
      rom = 0x0f831463004ba303
    } elif (address & ~7) == 0x10148 {
      rom = 0x0f93106303cba303
    } elif (address & ~7) == 0x10150 {
      rom = 0x0454046300300293
    } elif (address & ~7) == 0x10158 {
      rom = 0x001c8c93001c0c13
    } elif (address & ~7) == 0x10160 {
      rom = 0x039bae23018ba223
    } elif (address & ~7) == 0x10168 {
      rom = 0x001002930350000f
    } elif (address & ~7) == 0x10170 {
      rom = 0x00231313ff440313
    } elif (address & ~7) == 0x10178 {
      rom = 0x0053202300690333
    } elif (address & ~7) == 0x10180 {
      rom = 0x00c003130550000f
    } elif (address & ~7) == 0x10188 {
      rom = 0x02592a2300641663
    } elif (address & ~7) == 0x10190 {
      rom = 0x0059262302c0006f
    } elif (address & ~7) == 0x10198 {
      rom = 0x000922830240006f
    } elif (address & ~7) == 0x101a0 {
      rom = 0x0062f2b300492303
    } elif (address & ~7) == 0x101a8 {
      rom = 0x6000033708028263
    } elif (address & ~7) == 0x101b0 {
      rom = 0x0053033300241293
    } elif (address & ~7) == 0x101b8 {
      rom = 0x0074129301932023
    } elif (address & ~7) == 0x101c0 {
      rom = 0x006282b300011337
    } elif (address & ~7) == 0x101c8 {
      rom = 0x342022f300028067
    } elif (address & ~7) == 0x101d0 {
      rom = 0x03f2f2930402de63
    } elif (address & ~7) == 0x101d8 {
      rom = 0x0262886300300313
    } elif (address & ~7) == 0x101e0 {
      rom = 0x02628c6300700313
    } elif (address & ~7) == 0x101e8 {
      rom = 0x0462906300b00313
    } elif (address & ~7) == 0x101f0 {
      rom = 0x03531c63000b2303
    } elif (address & ~7) == 0x101f8 {
      rom = 0x000012b7006b2023
    } elif (address & ~7) == 0x10200 {
      rom = 0x0044e49380028293
    } elif (address & ~7) == 0x10208 {
      rom = 0x0009a02301c0006f
    } elif (address & ~7) == 0x10210 {
      rom = 0x0014e49300800293
    } elif (address & ~7) == 0x10218 {
      rom = 0x0800029300c0006f
    } elif (address & ~7) == 0x10220 {
      rom = 0x3042b0730024e493
    } elif (address & ~7) == 0x10228 {
      rom = 0x0000006f30200073
    }
    dut.mem_rsp_data = if width == 4 and address#[2] != 0 { rom >> 32 } else { rom }
    step
    if dut.dirtyBeat {
      if dut.dirtyHart == 3 {
        rocketBeats += 1
      } elif dut.dirtyHart == 12 {
        smallBeats += 1
      } elif dut.dirtyHart == 13 {
        twoWideBeats += 1
      }
    }
    if dut.mem_rsp_fire != 0 {
      left = left - 1
      beat = beat + 1
    }
    if dut.mem_req_fire != 0 {
      origin = dut.seen_mem_meta#[35..+5]
      saved  = dut.seen_mem_addr
      const size = dut.seen_mem_meta#[19..+4]
      const put  = dut.seen_mem_meta#[23..+4] <= 1
      reply = (17 << 35) | (origin << 30) | (3 << 27) | (U1(!put) << 23) | (size << 19) | (
          dut.seen_mem_meta#[13..+3] << 13
        )
      left  = if size == 6 { if origin < 12 { 16 } else { 8 } } else { 1 }
      beat  = 0
      if put {
        assert(origin == 3 and saved == 0x6000000c and size == 2, "unexpected external store")
        certified = true
      } else {
        assert(saved < 0x20000, "coherent SRAM or interrupt MMIO escaped to external memory")
      }
      if saved == 0x11000 + (origin << 7) {
        passed = passed | (1 << origin)
      }
    }
  }
  puts("coherent mailbox and interrupt handlers completed on hart mask {passed}")
  puts("dirty probe beats: Rocket 3={rocketBeats}, BOOM 12={smallBeats}, BOOM 13={twoWideBeats}")
  assert(rocketBeats == 16 and smallBeats == 8 and twoWideBeats == 8, "each hart returned one dirty cache line")
  assert(passed == 0x3008 and certified, "Rocket and both BOOMs must reach their own post-handler address")
}
