# lhdsuite — larger LiveHD tests + benchmarks over real designs.
#
# LiveHD is built FROM SOURCE as a bazel dependency (no PATH / LIVEHD_BIN
# lookup): every test/bench target depends on @livehd//lhd:lhd, so a plain
# `bazel test //...` first builds lhd (and ABC, slang, yosys, cvc5, ... as
# livehd's own externals) and then runs the suite against that binary.
#
# livehd is SELF-CONTAINED as a dependency: its sibling libraries (iassert,
# hlop, hhds) are fetched by use_repo_rule git pins inside livehd's own
# MODULE.bazel, and @livehd//lhd:lhd stages the `lhd sim` runtime headers in
# its runfiles — so the ONLY thing pinned here is livehd itself.
module(
    name = "lhdsuite",
    version = "0.1.0",
)

bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "livehd", version = "0.2.0")

# NOTE: this commit has the self-contained-deps restructure but PREDATES the
# follow-up that inlines the hlop/iassert sim-header patch_cmds (its
# packages/*_sim_hdrs.patch references are dangling). Module resolution and
# `bazel run //bench:show` work; to BUILD lhd (bazel test //bench:...) run
# against the local checkout until that follow-up is pushed:
#   bazel test //... --override_module=livehd=../livehd
# then bump this commit past the push, after which no flag is needed.
git_override(
    module_name = "livehd",
    commit = "c1a1bc159a89e31f443a5d986b4e6b498566fbb8",
    remote = "https://github.com/masc-ucsc/livehd.git",
)
# For local co-development swap the git_override above for:
# local_path_override(module_name = "livehd", path = "../livehd")
