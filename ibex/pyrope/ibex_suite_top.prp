const ibex_top = import("ibex_top.ibex_top")
const ibex_pkg = import("ibex_pkg")

pub mod ibex_suite_top::[timecheck=false](clk_i:Clock, rst_ni:U1, instr_gnt_i:U1, instr_rvalid_i:U1, instr_rdata_i:U32, data_gnt_i:U1, data_rvalid_i:U1, data_rdata_i:U32) -> (instr_req_o:U1@[], instr_addr_o:U32@[], data_req_o:U1@[], data_we_o:U1@[], data_be_o:U4@[], data_addr_o:U32@[], data_wdata_o:U32@[], core_sleep_o:U1@[]) {
  mut u_top = ibex_top::[name=u_top](clk_i = clk_i, rst_ni = rst_ni, test_en_i = 0, ram_cfg_icache_tag_i = 0, ram_cfg_icache_data_i = 0, cheriot_enable_i = ibex_pkg.IbexMuBiOff, hart_id_i = 0, boot_addr_i = 0, trvk_heap_base_addr_i = 0, instr_gnt_i = instr_gnt_i, instr_rvalid_i = instr_rvalid_i, instr_rdata_i = instr_rdata_i, instr_rdata_intg_i = 0, instr_err_i = 0, data_gnt_i = data_gnt_i, data_rvalid_i = data_rvalid_i, data_rdata_i = data_rdata_i, data_rdata_intg_i = 0, data_tag_i = 0, data_err_i = 0, trvk_revbm_gnt_i = 0, trvk_revbm_rvalid_i = 0, trvk_revbm_rdata_i = 0, trvk_revbm_rdata_intg_i = 0, trvk_revbm_err_i = 0, irq_software_i = 0, irq_timer_i = 0, irq_external_i = 0, irq_fast_i = 0, irq_nm_i = 0, scramble_key_valid_i = 0, scramble_key_i = 0, scramble_nonce_i = 0, debug_req_i = 0, fetch_enable_i = ibex_pkg.IbexMuBiOn, mcounteren_writable_i = ibex_pkg.IbexMuBiOn, scan_rst_ni = 1)
  instr_req_o = u_top.instr_req_o
  instr_addr_o = u_top.instr_addr_o
  data_req_o = u_top.data_req_o
  data_we_o = u_top.data_we_o
  data_be_o = u_top.data_be_o
  data_addr_o = u_top.data_addr_o
  data_wdata_o = u_top.data_wdata_o
  core_sleep_o = u_top.core_sleep_o
}
