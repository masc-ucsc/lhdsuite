pub mod ibex_csr_p2<Width=18, ShadowCopy=0, ResetValue=0>::[timecheck=false](clk_i:Clock, rst_ni:U1, wr_data_i:U18, wr_en_i:U1) -> (rd_data_o:U18@[], rd_error_o:U1@[]) {
  reg rdata_q:U18:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  if rst_ni != 0 {
    if wr_en_i != 0 {
      rdata_q = wr_data_i
    }
  }
  rd_data_o = rdata_q
  rd_error_o = 0
}
