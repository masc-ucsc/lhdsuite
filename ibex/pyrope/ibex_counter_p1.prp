pub mod ibex_counter_p1<CounterWidth=0x40, ProvideValUpd=1>::[timecheck=false](clk_i:Clock, rst_ni:U1, counter_inc_i:U1, counterh_we_i:U1, counter_we_i:U1, counter_val_i:U32) -> (counter_val_o:U64@[], counter_val_upd_o:U64@[]) {
  reg counter_q:U64:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  wire we:U1 = nil
  mut counter_load:U64 = 0
  mut counter_d:U64 = 0
  counter_load = 0sb?
  counter_d = 0sb?
  const counter__w1 = counter_q
  const counter_val_o__w1 = counter__w1
  const counter_upd__w1 = (counter__w1#[0..<0x40] + 1)#[0..<0x40]
  we = (counter_we_i | counterh_we_i) & 1
  mut counter_load__w1:U64 = counter_load
  counter_load__w1#[32..<0x40] = counter__w1#[32..<0x40]
  mut counter_load__w2:U64 = counter_load__w1
  counter_load__w2#[0..<32] = counter_val_i#[0..<32]
  counter_load = counter_load__w2
  if counterh_we_i != 0 {
    counter_load#[32..<0x40] = counter_val_i#[0..<32]
    counter_load#[0..<32] = counter__w1#[0..<32]
  }
  if we != 0 {
    counter_d = counter_load#[0..<0x40]
  } else {
    counter_d = if counter_inc_i != 0 { counter_upd__w1#[0..<0x40] } else { counter__w1#[0..<0x40] }
  }
  if rst_ni != 0 {
    counter_q = counter_d
  }
  counter_val_o = counter_val_o__w1
  counter_val_upd_o = counter_upd__w1
}
