  multdiv_alu_operand_b = gen_multdiv_fast_multdiv_i.alu_operand_b_o
  multdiv_imd_val_we = (gen_multdiv_fast_multdiv_i.imd_val_we_o.e1 << 1) | gen_multdiv_fast_multdiv_i.imd_val_we_o.e0
  multdiv_result = gen_multdiv_fast_multdiv_i.multdiv_result_o
  mut _mux_5:U1 = if multdiv_sel__w1 != 0 { gen_multdiv_fast_multdiv_i.valid_o & 1 } else { 1 }
