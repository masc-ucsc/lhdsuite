  imd_val_d_o = 0sb?
  const multdiv_sel__w1 = (mult_sel_i | div_sel_i) & 1
  mut _mux_1:U34 = if multdiv_sel__w1 != 0 { multdiv_imd_val_d__wnet#[34..<0x44] } else { 0 }
  mut imd_val_d_o__w1 = imd_val_d_o
  imd_val_d_o__w1#[34..<0x44] = _mux_1
