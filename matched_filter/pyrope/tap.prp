pub mod tap::[timecheck=false](clock:u1, reset:u1, x_in:s8, ref_in:s8, ref_load:u1) -> (x_out:s8@[], ref_out:s8@[]) {
  reg x_r:s8
  reg ref_r:s8
  if reset != 0 {
    x_r = 0
    ref_r = 0
  } else {
    x_r = x_in
    if ref_load != 0 {
      ref_r = ref_in
    }
  }
  x_out = x_r
  ref_out = ref_r
}
