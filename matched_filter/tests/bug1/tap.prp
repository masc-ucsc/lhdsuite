// Intentional mutation: loaded references are incremented.
pub mod tap::[timecheck=false](`clock`:Clock, `reset`:U1, x_in:S8, ref_in:S8, ref_load:U1) -> (x_out:S8@[], ref_out:S8@[]) {
  reg x_r:S8:[initial=0, reset_pin=`reset`, async=false]
  reg ref_r:S8:[initial=0, reset_pin=`reset`, async=false]
  if not (`reset` != 0) {
    x_r = x_in
    if ref_load != 0 {
      wrap ref_r = ref_in + 1
    }
  }
  x_out = x_r
  ref_out = ref_r
}
