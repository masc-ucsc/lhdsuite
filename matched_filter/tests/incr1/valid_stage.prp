// Incremental-synthesis semantic edit: invert only the next valid bit in this
// small, definitely-instantiated leaf. The formal/LEC bug1 remains the shared
// tap corruption; this variant measures locality without changing all 64 taps.
pub mod valid_stage::[timecheck=false](in_valid:bool, clear:bool) -> (out_valid:bool@[0]) {
  reg valid_r:bool = false
  out_valid = valid_r
  valid_r = if clear { false } else { not in_valid }
}
