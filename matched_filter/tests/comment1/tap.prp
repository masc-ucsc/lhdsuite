// Comment-only incremental variant of the reference/sample storage tap.
pub mod tap::[timecheck=false](x_in:s8, ref_in:s8, ref_load:bool) -> (x_out:s8@[0], ref_out:s8@[0]) {
  reg x_r:s8 = 0
  reg ref_r:s8 = 0
  x_out = x_r
  ref_out = ref_r
  x_r = x_in
  if ref_load { ref_r = ref_in }
}

// comment-only touch (comment1): semantics unchanged, incremental caches must hit
