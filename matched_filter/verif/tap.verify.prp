// Sequential contract for the independent return-sample and reference chains.
const tap = import("tap.tap")

formal tap.x_advances {
  mut acc = tap
  assert((past(acc.reset, 1) == 0)
           implies (acc.x_out == past(acc.x_in, 1)),
         "x advances every cycle")
}

formal tap.ref_loads {
  mut acc = tap
  assert(((past(acc.reset, 1) == 0) and past(acc.ref_load, 1))
           implies (acc.ref_out == past(acc.ref_in, 1)),
         "ref advances only when ref_load is set")
}

formal tap.ref_holds {
  mut acc = tap
  assert(((past(acc.reset, 1) == 0) and not past(acc.ref_load, 1))
           implies stable(acc.ref_out),
         "ref holds while ref_load is clear")
}
