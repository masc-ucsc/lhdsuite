// One storage tap. The return sample chain advances every cycle, while the
// independent reference chain advances only under ref_load. Multiplication is
// done in matched_filter, where the compile-time precision knobs are visible.
//
// `timecheck=false`: x_r is a pipeline stage and ref_r is infrequently loaded
// state; a matched filter deliberately combines values with different ages.
pub mod tap::[timecheck=false](clock:Clock, ref_in:S8, ref_load:Bool, reset:Reset, x_in:S8) -> (ref_out:S8@[0], x_out:S8@[0]) {
  reg x_r:S8:[reset_pin=reset] = 0
  reg ref_r:S8:[reset_pin=reset] = 0
  x_out = x_r
  ref_out = ref_r
  x_r = x_in
  if ref_load {
    ref_r = ref_in
  }
}
