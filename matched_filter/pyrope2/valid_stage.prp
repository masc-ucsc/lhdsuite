// One validity register per adder level. ref_load flushes all outstanding
// results; y_valid is also gated low immediately throughout the load window.
pub mod valid_stage::[timecheck=false](in_valid:bool, clear:bool) -> (out_valid:bool@[0]) {
  reg valid_r:bool = false
  out_valid = valid_r
  valid_r = if clear { false } else { in_valid }
}
