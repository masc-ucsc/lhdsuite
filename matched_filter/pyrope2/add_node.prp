// One registered node of the adder tree. The caller supplies its computed
// accumulator type; the generic is specialized once for that signed width.
//
// `timecheck=false`, as on `tap`: the node is one pipeline level of a tree
// whose levels are mixed in the parent's in-place array.
pub mod add_node<T>::[timecheck=false](a:T, b:T) -> (s:T@[0]) {
  reg s_r:T = 0
  s = s_r
  wrap s_r = a + b
}
