// The suite's bitcoin configuration: the miner with NENGINES pinned to 4, the
// same value verilog/bitcoin_top.v binds (see the comment there for why).
// The U1 ports are the external interface the testbenches drive.
const bitcoin = import("bitcoin.bitcoin")

comptime const NENGINES = 4

pub mod bitcoin_top(
  clk:Clock,
  header:U640,
  nonce_base:U32,
  reset_n:Reset,
  start:U1,
  target:U256,
) -> (busy:U1@[], found:U1@[], golden_nonce:U32@[]) {
  const u_miner = bitcoin<NENGINES=NENGINES>(start=start == 1, header, target, nonce_base)
  found        = U1(u_miner.found)
  golden_nonce = u_miner.golden_nonce
  busy         = U1(u_miner.busy)
}
