// Proof-of-work target check: Bitcoin reads the SHA256d digest as a
// little-endian 256-bit integer, so the digest's bytes are reversed before
// the unsigned `<=` against the difficulty target.
pub comb bitcoin_compare(hash:U256, target:U256) -> (below:Bool) {
  mut le:U256 = 0
  for i in 0..<32 {
    le#[i*8..+8] = hash#[(31 - i)*8..+8]
  }
  below = le <= target
}
