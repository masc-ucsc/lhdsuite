pub mod prim_phase_pair_hi_lo<Width=66>::[timecheck=false](clk_i:Clock, hi_en_i:U1, lo_en_i:U1, d_i:U66) -> (q_hi_o:U66@[], q_lo_o:U66@[]) {
  reg hi_en_1p:U1:[enable=clk_i, enable_high=false, latch=true]
  reg lo_en_2p:U1:[enable=clk_i, latch=true]
  reg q_hi_reg:U66:[enable=clk_i, latch=true]
  reg q_lo_reg:U66:[enable=clk_i, enable_high=false, latch=true]
  hi_en_1p = hi_en_i
  lo_en_2p = lo_en_i
  if hi_en_1p != 0 {
    q_hi_reg = d_i
  }
  if lo_en_2p != 0 {
    q_lo_reg = q_hi_reg
  }
  q_hi_o = q_hi_reg
  q_lo_o = q_lo_reg
}
