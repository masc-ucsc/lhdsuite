pub mod prim_phase_pair_hi_lo::[timecheck=false](clk_i:u1, hi_en_i:u1, lo_en_i:u1, d_i:u66) -> (q_hi_o:u66@[], q_lo_o:u66@[]) {
  reg hi_en_1p:u1:[latch=true]
  reg lo_en_2p:u1:[latch=true]
  reg q_hi_reg:u66:[latch=true]
  reg q_lo_reg:u66:[latch=true]
  q_hi_o = 0ub??????????????????????????????????????????????????????????????????
  q_lo_o = 0ub??????????????????????????????????????????????????????????????????
  if clk_i == 0 {
    hi_en_1p = hi_en_i
  }
  if clk_i != 0 {
