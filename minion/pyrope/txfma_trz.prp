pub comb txfma_trz<TrzOut=5, Max=23>::[timecheck=false](frac_i:U24) -> (trz_o:U5) {
  const FracWidth = Max + 1
  trz_o = 0sb?
  trz_o = if frac_i#[23..<24] != 0 { 23 } else { FracWidth#[0..<5] }
  if frac_i#[22..<23] != 0 {
    trz_o = 22
  }
  if frac_i#[21..<22] != 0 {
    trz_o = 21
  }
  if frac_i#[20..<21] != 0 {
    trz_o = 20
  }
  if frac_i#[19..<20] != 0 {
    trz_o = 19
  }
  if frac_i#[18..<19] != 0 {
    trz_o = 18
  }
  if frac_i#[17..<18] != 0 {
    trz_o = 17
  }
  if frac_i#[16..<17] != 0 {
    trz_o = 16
  }
  if frac_i#[15..<16] != 0 {
    trz_o = 15
  }
  if frac_i#[14..<15] != 0 {
    trz_o = 14
  }
  if frac_i#[13..<14] != 0 {
    trz_o = 13
  }
  if frac_i#[12..<13] != 0 {
    trz_o = 12
  }
  if frac_i#[11..<12] != 0 {
    trz_o = 11
  }
  if frac_i#[10..<11] != 0 {
    trz_o = 10
  }
  if frac_i#[9..<10] != 0 {
    trz_o = 9
  }
  if frac_i#[8..<9] != 0 {
    trz_o = 8
  }
  if frac_i#[7..<8] != 0 {
    trz_o = 7
  }
  if frac_i#[6..<7] != 0 {
    trz_o = 6
  }
  if frac_i#[5..<6] != 0 {
    trz_o = 5
  }
  if frac_i#[4..<5] != 0 {
    trz_o = 4
  }
  if frac_i#[3..<4] != 0 {
    trz_o = 3
  }
  if frac_i#[2..<3] != 0 {
    trz_o = 2
  }
  if frac_i#[1..<2] != 0 {
    trz_o = 1
  }
  if (frac_i & 1) != 0 {
    trz_o = 0
  }
}
