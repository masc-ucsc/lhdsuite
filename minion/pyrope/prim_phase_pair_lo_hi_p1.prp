pub mod prim_phase_pair_lo_hi_p1<Width=7>::[timecheck=false](clk_i:Clock, reset_i:U1, lo_en_i:U1, hi_en_i:U1, d_i:U7) -> (q_lo_o:U7@[], q_hi_o:U7@[]) {
  reg lo_en_2p:U1:[initial=0, reset_pin=reset_i, async=true, enable=clk_i, latch=true]
  reg hi_en_1p:U1:[initial=0, reset_pin=reset_i, async=true, enable=clk_i, enable_high=false, latch=true]
  reg q_lo_reg:U7:[initial=0, reset_pin=reset_i, async=true, enable=clk_i, enable_high=false, latch=true]
  reg q_hi_reg:U7:[initial=0, reset_pin=reset_i, async=true, enable=clk_i, latch=true]
  lo_en_2p = lo_en_i
  hi_en_1p = hi_en_i
  if lo_en_2p != 0 {
    q_lo_reg = d_i
  }
  if hi_en_1p != 0 {
    q_hi_reg = q_lo_reg
  }
  q_lo_o = q_lo_reg
  q_hi_o = q_hi_reg
}
