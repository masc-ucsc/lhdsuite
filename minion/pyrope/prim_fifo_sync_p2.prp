const minion_dcache_pkg = import("minion_dcache_pkg")
const minion_pkg = import("minion_pkg")

pub mod prim_fifo_sync_p2::[timecheck=false](clk_i:u1, rst_ni:u1, clr_i:u1, wvalid_i:u1, wdata_i:u40, rready_i:u1) -> (wready_o:u1@[], rvalid_o:u1@[], rdata_o:u40@[], depth_o:u2@[], full_o:u1@[], empty_o:u1@[]) {
  mut _mux_3:u32 = 0
  mut _mux_4:u32 = 0
  reg depth_q:u2:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg wptr_q:u1:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg rptr_q:u1:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg mem:[2]u40:[ordering="old", clock_pin=ref clk_i]
  mut wptr_d = 0
  mut rptr_d = 0
  mut Depth = minion_pkg.DcacheTsPhysAddrNum
  const full_o__w1 = unsigned(depth_q == Depth)
  const empty_o__w1 = unsigned(depth_q == 0)
  const wready_o__w1 = (~full_o__w1) & 1
  const rvalid_o__w1 = (~empty_o__w1) & 1
  const depth_o__w1 = depth_q
  const do_write__w1 = wvalid_i & wready_o__w1
  const do_read__w1 = rvalid_o__w1 & rready_i
  const t11 = ((do_write__w1 & 1) << 1) | (do_read__w1 & 1)
  mut depth_d = depth_q
  depth_d = unique if t11 == 2 { (depth_q + 1)#[0..=1] } elif t11 == 1 { (depth_q - 1)#[0..=31]#[0..=1] } else { depth_q }
  wptr_d = wptr_q
  if do_write__w1 != 0 {
    _mux_3 = if wptr_q == 1 { 0 } else { (wptr_q + 1)#[0..=31] }
    wptr_d = _mux_3 & 1
  }
  rptr_d = rptr_q
  if do_read__w1 != 0 {
    _mux_4 = if rptr_q == 1 { 0 } else { (rptr_q + 1)#[0..=31] }
    rptr_d = _mux_4 & 1
  }
  if do_write__w1 != 0 {
    mem[wptr_q] = wdata_i
  }
  const rdata_o__w1 = mem[rptr_q]
  if clr_i != 0 {
    depth_q = 0
    rptr_q = 0
    wptr_q = 0
  } else {
    depth_q = depth_d
    rptr_q = rptr_d
    wptr_q = wptr_d
  }
  depth_o = depth_o__w1
  empty_o = empty_o__w1
  full_o = full_o__w1
  rdata_o = rdata_o__w1
  rvalid_o = rvalid_o__w1
  wready_o = wready_o__w1
}
