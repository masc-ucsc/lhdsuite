pub mod vpu_lane_tima::[timecheck=false](te_i:u1, clk_i:u1, tima_clk_en_i:u1, f1_tima_mul_en_i:u1, tima_in1_signed_i:u1, tima_in2_signed_i:u1, f2_tima_en_i:u1, f2_tima_in3_en_i:u1, f2_tima_zap_opdc_i:u1, tena_rd_data_i:minion_pkg.VpuDataSSz_T, tenb_wr_en_i:u1, tenb_wr_en_early_i:u1, tenb_rd_addr_i:vpu_pkg.VpuTenbRfAddrW_T, tenb_wr_addr_i:vpu_pkg.VpuTenbRfAddrW_T, tenb_wr_data_i:minion_pkg.VpuDataSSz_T, tenc_wr_en_i:u1, tenc_wr_en_early_i:u1, tenc_rd_addr_i:vpu_pkg.VpuTencAddrW_T, tenc_wr_addr_i:vpu_pkg.VpuTencAddrW_T) -> (tenb_out_o:minion_pkg.VpuDataSSz_T@[], tima_out_o:minion_pkg.VpuDataSSz_T@[]) {
  mut `dft_tieoff.scanmode` = 0
  mut `dft_tieoff.scan_reset_n` = 0
  mut `dft_tieoff.sram_clk_override` = 0
  mut `dft_tieoff.ram_rei` = 0
  mut `dft_tieoff.ram_wei` = 0
  `dft_tieoff.ram_rei` = 0
  `dft_tieoff.ram_wei` = 0
  `dft_tieoff.scan_reset_n` = 0
  `dft_tieoff.scanmode` = 0
  `dft_tieoff.sram_clk_override` = 0
  tenb_out_o = 0ub????????????????????????????????
  mut u_tenb_rf = vpu_tensorb_rf::[name=u_tenb_rf](clk_i = clk_i, rd_addr_i = tenb_rd_addr_i, wr_en_i = tenb_wr_en_i, wr_en_early_i = tenb_wr_en_early_i, wr_addr_i = tenb_wr_addr_i, wr_data_i = tenb_wr_data_i)
  const tenb_out_o__w1 = u_tenb_rf
  mut u_cgate_tima = prim_clk_gate::[name=u_cgate_tima](clk_i = clk_i, en_i = tima_clk_en_i, `dft_i.scanmode` = 0, `dft_i.scan_reset_n` = 0, `dft_i.sram_clk_override` = 0, `dft_i.ram_rei` = 0, `dft_i.ram_wei` = 0)
  mut u_tenc_rf = vpu_tensorc_rf::[name=u_tenc_rf](clk_i = clk_i, rd_addr_i = tenc_rd_addr_i, wr_en_i = tenc_wr_en_i, wr_en_early_i = tenc_wr_en_early_i, wr_addr_i = tenc_wr_addr_i, wr_data_i = tima_out_o)
  mut u_tima = tima_top::[name=u_tima](clk_i = u_cgate_tima, f1_mul_en_i = f1_tima_mul_en_i, f1_in1_i = tena_rd_data_i, f1_in2_i = tenb_out_o__w1, f1_in1_signed_i = tima_in1_signed_i, f1_in2_signed_i = tima_in2_signed_i, f2_in3_i = u_tenc_rf, f2_zap_opd3_i = unsigned(f2_tima_zap_opdc_i == 0), f2_tima_en_i = f2_tima_en_i, f2_in3_en_i = f2_tima_in3_en_i)
  tenb_out_o = tenb_out_o__w1
  tima_out_o = u_tima
