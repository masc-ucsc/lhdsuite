  paddin2_selc_f2a_h = paddin2_selc_f1a_h
  paddin2_selfcneg_f2a_h = paddin2_selfcneg_f1a_h
  sel_famask_f2a_h = sel_famask_f1a_h
  mut wallace2 = txfma_wallace2::[name=wallace2](sxt_i = booth_fSxt_f2a_h, cin_i = booth_fCin_f2a_h, pp17_i = booth_fpp17_f2a_h, c21_i = wallace_fC21_f2a_h, c22_i = wallace_fC22_f2a_h, s21_i = wallace_fS21_f2a_h, s22_i = wallace_fS22_f2a_h)
  match paddin1_sels_f2a_h {
