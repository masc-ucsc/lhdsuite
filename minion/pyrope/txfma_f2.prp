  reg paddin1_sels_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
  reg paddin2_selc_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
  reg paddin2_selfcneg_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
