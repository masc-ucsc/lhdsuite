  mut prod_adder_64b = txfma_adder::[name=prod_adder_64b](a_i = padd_in2_f2a_h, b_i = padd_in1_f2a_h, cin_i = padd_cin_f2a_h)
  fa_out_f2a_h = 0ub????????????????????????????????
  mut fa_out_f2a_h__w1 = fa_out_f2a_h
  fa_out_f2a_h__w1#[8..=31] = (sel_famask_f2a_h | (sel_famask_f2a_h << 1) | (sel_famask_f2a_h << 2) | (sel_famask_f2a_h << 3) | (sel_famask_f2a_h << 4) | (sel_famask_f2a_h << 5) | (sel_famask_f2a_h << 6) | (sel_famask_f2a_h << 7) | (sel_famask_f2a_h << 8) | (sel_famask_f2a_h << 9) | (sel_famask_f2a_h << 10) | (sel_famask_f2a_h << 11) | (sel_famask_f2a_h << 12) | (sel_famask_f2a_h << 13) | (sel_famask_f2a_h << 14) | (sel_famask_f2a_h << 15) | (sel_famask_f2a_h << 16) | (sel_famask_f2a_h << 17) | (sel_famask_f2a_h << 18) | (sel_famask_f2a_h << 19) | (sel_famask_f2a_h << 20) | (sel_famask_f2a_h << 21) | (sel_famask_f2a_h << 22) | fa_f2a_h#[8..=31])
  mut fa_out_f2a_h__w2 = fa_out_f2a_h__w1
  fa_out_f2a_h__w2#[0..=7] = fa_f2a_h#[0..=7]
  fa_f3a_h = fa_out_f2a_h__w2
  fc_f3a_h = fc_f2a_h
  prodsum_f3a_h = prod_adder_64b
