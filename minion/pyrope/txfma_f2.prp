const txfma_adder = import("txfma_adder.txfma_adder")
const txfma_wallace2 = import("txfma_wallace2.txfma_wallace2")
const vpu_defs_pkg = import("vpu_defs_pkg")

pub mod txfma_f2::[timecheck=false](ctrl_f1_clk:u1, ctrl_f2_clk:u1, fa_f2a_h:u32, fc_f2a_h:u32, booth_fCin_f2a_h:vpu_defs_pkg.VPU_DATA_S_SZ_T, booth_fSxt_f2a_h:vpu_defs_pkg.VPU_DATA_S_SZ_T, booth_fpp17_f2a_h:u33, wallace_fC21_f2a_h:u64, wallace_fC22_f2a_h:u64, wallace_fS21_f2a_h:u64, wallace_fS22_f2a_h:u64, paddin1_sels_f1a_h:u1, paddin2_selc_f1a_h:u1, paddin2_selfcneg_f1a_h:u1, padd_cin_f1a_h:u1, sel_famask_f1a_h:u1) -> (fa_f3a_h:u32@[], fc_f3a_h:u32@[], prodsum_f3a_h:u64@[]) {
  mut _rep_1:u64 = 0
  mut padd_in1_f2a_h:u64 = 0
  mut padd_in2_f2a_h:u64 = 0
  reg fa_f3a_h:u32:[clock_pin=ref ctrl_f2_clk]
  reg fc_f3a_h:u32:[clock_pin=ref ctrl_f2_clk]
  reg prodsum_f3a_h:u64:[clock_pin=ref ctrl_f2_clk]
  reg paddin1_sels_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
  reg paddin2_selc_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
  reg paddin2_selfcneg_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
  reg padd_cin_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
  reg sel_famask_f2a_h:u1:[clock_pin=ref ctrl_f1_clk]
  mut fa_out_f2a_h:u32 = 0
  padd_cin_f2a_h = padd_cin_f1a_h
  paddin1_sels_f2a_h = paddin1_sels_f1a_h
  paddin2_selc_f2a_h = paddin2_selc_f1a_h
  paddin2_selfcneg_f2a_h = paddin2_selfcneg_f1a_h
  sel_famask_f2a_h = sel_famask_f1a_h
  mut wallace2 = txfma_wallace2::[name=wallace2](sxt_i = booth_fSxt_f2a_h, cin_i = booth_fCin_f2a_h, pp17_i = booth_fpp17_f2a_h, c21_i = wallace_fC21_f2a_h, c22_i = wallace_fC22_f2a_h, s21_i = wallace_fS21_f2a_h, s22_i = wallace_fS22_f2a_h)
  match paddin1_sels_f2a_h {
    == 0 {
      padd_in1_f2a_h = fa_f2a_h << 29
    }
    == 1 {
      padd_in1_f2a_h = wallace2.s41_o
    }
    else {
      padd_in1_f2a_h = 0ub????????????????????????????????????????????????????????????????
    }
  }
  match paddin2_selc_f2a_h {
    == 0 {
      _rep_1 = if (paddin2_selfcneg_f2a_h & 1) != 0 { 0xffffffffffffffff } else { 0 }
      padd_in2_f2a_h = _rep_1 ^ (fc_f2a_h << 29)
    }
    == 1 {
      padd_in2_f2a_h = wallace2.c41_o#[0..=62] << 1
    }
    else {
      padd_in2_f2a_h = 0ub????????????????????????????????????????????????????????????????
    }
  }
  mut prod_adder_64b = txfma_adder::[name=prod_adder_64b](a_i = padd_in2_f2a_h, b_i = padd_in1_f2a_h, cin_i = padd_cin_f2a_h)
  mut _rep_2:u23 = if (sel_famask_f2a_h & 1) != 0 { 0x7fffff } else { 0 }
  fa_out_f2a_h = 0sb?
  mut fa_out_f2a_h__w1 = fa_out_f2a_h
  fa_out_f2a_h__w1#[8..=31] = _rep_2 | fa_f2a_h#[8..=31]
  mut fa_out_f2a_h__w2 = fa_out_f2a_h__w1
  fa_out_f2a_h__w2#[0..=7] = fa_f2a_h#[0..=7]
  fa_f3a_h = fa_out_f2a_h__w2
  fc_f3a_h = fc_f2a_h
  prodsum_f3a_h = prod_adder_64b
}
