      padd_in1_f2a_h = fa_f2a_h << 29
    }
    == 1 {
      padd_in1_f2a_h = wallace2.s41_o
    }
    else {
    }
  }
  match paddin2_selc_f2a_h {
    == 0 {
      
      padd_in2_f2a_h = (paddin2_selfcneg_f2a_h | (paddin2_selfcneg_f2a_h << 1) | (paddin2_selfcneg_f2a_h << 2) | (paddin2_selfcneg_f2a_h << 3) | (paddin2_selfcneg_f2a_h << 4) | (paddin2_selfcneg_f2a_h << 5) | (paddin2_selfcneg_f2a_h << 6) | (paddin2_selfcneg_f2a_h << 7) | (paddin2_selfcneg_f2a_h << 8) | (paddin2_selfcneg_f2a_h << 9) | (paddin2_selfcneg_f2a_h << 10) | (paddin2_selfcneg_f2a_h << 11) | (paddin2_selfcneg_f2a_h << 12) | (paddin2_selfcneg_f2a_h << 13) | (paddin2_selfcneg_f2a_h << 14) | (paddin2_selfcneg_f2a_h << 15) | (paddin2_selfcneg_f2a_h << 16) | (paddin2_selfcneg_f2a_h << 17) | (paddin2_selfcneg_f2a_h << 18) | (paddin2_selfcneg_f2a_h << 19) | (paddin2_selfcneg_f2a_h << 20) | (paddin2_selfcneg_f2a_h << 21) | (paddin2_selfcneg_f2a_h << 22) | (paddin2_selfcneg_f2a_h << 23) | (paddin2_selfcneg_f2a_h << 24) | (paddin2_selfcneg_f2a_h << 25) | (paddin2_selfcneg_f2a_h << 26) | (paddin2_selfcneg_f2a_h << 27) | (paddin2_selfcneg_f2a_h << 28) | (paddin2_selfcneg_f2a_h << 29) | (paddin2_selfcneg_f2a_h << 30) | (paddin2_selfcneg_f2a_h << 31) | (paddin2_selfcneg_f2a_h << 32) | (paddin2_selfcneg_f2a_h << 33) | (paddin2_selfcneg_f2a_h << 34) | (paddin2_selfcneg_f2a_h << 35) | (paddin2_selfcneg_f2a_h << 36) | (paddin2_selfcneg_f2a_h << 37) | (paddin2_selfcneg_f2a_h << 38) | (paddin2_selfcneg_f2a_h << 39) | (paddin2_selfcneg_f2a_h << 40) | (paddin2_selfcneg_f2a_h << 41) | (paddin2_selfcneg_f2a_h << 42) | (paddin2_selfcneg_f2a_h << 43) | (paddin2_selfcneg_f2a_h << 44) | (paddin2_selfcneg_f2a_h << 45) | (paddin2_selfcneg_f2a_h << 46) | (paddin2_selfcneg_f2a_h << 47) | (paddin2_selfcneg_f2a_h << 48) | (paddin2_selfcneg_f2a_h << 49) | (paddin2_selfcneg_f2a_h << 50) | (paddin2_selfcneg_f2a_h << 51) | (paddin2_selfcneg_f2a_h << 52) | (paddin2_selfcneg_f2a_h << 53) | (paddin2_selfcneg_f2a_h << 54) | (paddin2_selfcneg_f2a_h << 55) | (paddin2_selfcneg_f2a_h << 56) | (paddin2_selfcneg_f2a_h << 57) | (paddin2_selfcneg_f2a_h << 58) | (paddin2_selfcneg_f2a_h << 59) | (paddin2_self