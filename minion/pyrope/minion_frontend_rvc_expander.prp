pub comb minion_frontend_rvc_expander::[timecheck=false](in_bits:U32) -> (out_bits:U32) {
  mut _rep_1:U9 = 0
  mut illegal:U1 = 0
  mut expanded:U32 = 0
  illegal = 0ub?
  expanded = 0sb?
  out_bits = 0sb?
  const c_op__w1 = in_bits#[0..<2]
  const c_rs2__w1 = in_bits#[2..<7]
  const c_rd__w1 = in_bits#[7..<12]
  const c_rs1p__w1 = (1 << 3) | in_bits#[7..<10]
  const c_rs2p__w1 = (1 << 3) | in_bits#[2..<5]
  const c_rdp__w1 = (1 << 3) | in_bits#[7..<10]
  expanded = in_bits
  illegal = 0
  out_bits = in_bits
  if c_op__w1 != 3 {
    const t14 = (in_bits#[13..<16]#[0..<3] << 2) | c_op__w1#[0..<2]
    match t14 {
      == 0 {
        expanded = (in_bits#[7..<11] << 26) | (in_bits#[11..<13] << 24) | (in_bits#[5..<6] << 23) | (in_bits#[6..<7] << 22) | (2 << 15) | (c_rs2p__w1#[0..<5] << 7) | 19
        if in_bits#[5..<13] == 0 {
          illegal = 1
        }
      }
      == 4 {
        expanded = (in_bits#[5..<7] << 26) | (in_bits#[10..<13] << 23) | (c_rs1p__w1#[0..<5] << 15) | (3 << 12) | (c_rs2p__w1#[0..<5] << 7) | 7
      }
      == 8 {
        expanded = (in_bits#[5..<6] << 26) | (in_bits#[10..<13] << 23) | (in_bits#[6..<7] << 22) | (c_rs1p__w1#[0..<5] << 15) | (2 << 12) | (c_rs2p__w1#[0..<5] << 7) | 3
      }
      == 12 {
        expanded = (in_bits#[5..<7] << 26) | (in_bits#[10..<13] << 23) | (c_rs1p__w1#[0..<5] << 15) | (3 << 12) | (c_rs2p__w1#[0..<5] << 7) | 3
      }
      == 16 {
        expanded = 0
      }
      == 20 {
        expanded = (in_bits#[5..<7] << 26) | (in_bits#[12..<13] << 25) | (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (3 << 12) | (in_bits#[10..<12] << 10) | 39
      }
      == 24 {
        expanded = (in_bits#[5..<6] << 26) | (in_bits#[12..<13] << 25) | (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (2 << 12) | (in_bits#[10..<12] << 10) | (in_bits#[6..<7] << 9) | 35
      }
      == 28 {
        expanded = (in_bits#[5..<7] << 26) | (in_bits#[12..<13] << 25) | (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (3 << 12) | (in_bits#[10..<12] << 10) | 35
      }
      == 1 {
        expanded = ((in_bits#[12..<13] << 25) | (in_bits#[2..<7] << 20) | (c_rd__w1#[0..<5] << 15) | (c_rd__w1#[0..<5] << 7) | 19)#sext[0..=25]#[0..<32]
      }
      == 5 {
        expanded = ((in_bits#[12..<13] << 25) | (in_bits#[2..<7] << 20) | (c_rd__w1#[0..<5] << 15) | (c_rd__w1#[0..<5] << 7) | 27)#sext[0..=25]#[0..<32]
        if c_rd__w1 == 0 {
          illegal = 1
        }
      }
      == 9 {
        expanded = ((in_bits#[12..<13] << 25) | (in_bits#[2..<7] << 20) | (c_rd__w1#[0..<5] << 7) | 19)#sext[0..=25]#[0..<32]
      }
      == 13 {
        if (c_rd__w1 == 2) or (c_rd__w1 == 0) {
          expanded = ((in_bits#[12..<13] << 29) | (in_bits#[3..<5] << 27) | (in_bits#[5..<6] << 26) | (in_bits#[2..<3] << 25) | (in_bits#[6..<7] << 24) | (c_rd__w1#[0..<5] << 15) | (c_rd__w1#[0..<5] << 7) | 19)#sext[0..=29]#[0..<32]
        } else {
          expanded = ((in_bits#[12..<13] << 17) | (in_bits#[2..<7] << 12) | (c_rd__w1#[0..<5] << 7) | 55)#sext[0..=17]#[0..<32]
        }
        if (in_bits#[12..<13] == 0) and (in_bits#[2..<7] == 0) {
          illegal = 1
        }
      }
      == 17 {
        match in_bits#[10..<12] {
          == 0 {
            expanded = (in_bits#[12..<13] << 25) | (in_bits#[2..<7] << 20) | (c_rs1p__w1#[0..<5] << 15) | (5 << 12) | (c_rdp__w1#[0..<5] << 7) | 19
          }
          == 1 {
            expanded = (16 << 26) | (in_bits#[12..<13] << 25) | (in_bits#[2..<7] << 20) | (c_rs1p__w1#[0..<5] << 15) | (5 << 12) | (c_rdp__w1#[0..<5] << 7) | 19
          }
          == 2 {
            expanded = ((in_bits#[12..<13] << 25) | (in_bits#[2..<7] << 20) | (c_rs1p__w1#[0..<5] << 15) | (7 << 12) | (c_rdp__w1#[0..<5] << 7) | 19)#sext[0..=25]#[0..<32]
          }
          == 3 {
            const t166 = (in_bits#[12..<13] << 2) | in_bits#[5..<7]
            match t166 {
              == 0 {
                expanded = (32 << 25) | (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (c_rdp__w1#[0..<5] << 7) | 51
              }
              == 1 {
                expanded = (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (4 << 12) | (c_rdp__w1#[0..<5] << 7) | 51
              }
              == 2 {
                expanded = (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (6 << 12) | (c_rdp__w1#[0..<5] << 7) | 51
              }
              == 3 {
                expanded = (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (7 << 12) | (c_rdp__w1#[0..<5] << 7) | 51
              }
              == 4 {
                expanded = (32 << 25) | (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (c_rdp__w1#[0..<5] << 7) | 59
              }
              == 5 {
                expanded = (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (c_rdp__w1#[0..<5] << 7) | 59
              }
              == 6 {
                expanded = (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (2 << 12) | (c_rdp__w1#[0..<5] << 7) | 59
              }
              == 7 {
                expanded = (c_rs2p__w1#[0..<5] << 20) | (c_rs1p__w1#[0..<5] << 15) | (3 << 12) | (c_rdp__w1#[0..<5] << 7) | 59
              }
              else {
                expanded = 0sb?
              }
            }
          }
          else {
            expanded = 0sb?
          }
        }
      }
      == 21 {
        _rep_1 = if in_bits#[12..<13] != 0 { 0x1ff } else { 0 }
        expanded = (in_bits#[12..<13] << 31) | (in_bits#[8..<9] << 30) | (in_bits#[9..<11] << 28) | (in_bits#[6..<7] << 27) | (in_bits#[7..<8] << 26) | (in_bits#[2..<3] << 25) | (in_bits#[11..<12] << 24) | (in_bits#[3..<6] << 21) | (_rep_1#[0..<9] << 12) | 0x6f
      }
      == 25 {
        expanded = ((in_bits#[12..<13] << 28) | (in_bits#[5..<7] << 26) | (in_bits#[2..<3] << 25) | (c_rs1p__w1#[0..<5] << 15) | (in_bits#[10..<12] << 10) | (in_bits#[3..<5] << 8) | (in_bits#[12..<13] << 7) | 0x63)#sext[0..=28]#[0..<32]
      }
      == 29 {
        expanded = ((in_bits#[12..<13] << 28) | (in_bits#[5..<7] << 26) | (in_bits#[2..<3] << 25) | (c_rs1p__w1#[0..<5] << 15) | (1 << 12) | (in_bits#[10..<12] << 10) | (in_bits#[3..<5] << 8) | (in_bits#[12..<13] << 7) | 0x63)#sext[0..=28]#[0..<32]
      }
      == 2 {
        expanded = (in_bits#[12..<13] << 25) | (in_bits#[2..<7] << 20) | (c_rd__w1#[0..<5] << 15) | (1 << 12) | (c_rd__w1#[0..<5] << 7) | 19
      }
      == 6 {
        expanded = (in_bits#[2..<5] << 26) | (in_bits#[12..<13] << 25) | (in_bits#[5..<7] << 23) | (2 << 15) | (3 << 12) | (c_rd__w1#[0..<5] << 7) | 7
      }
      == 10 {
        expanded = (in_bits#[2..<4] << 26) | (in_bits#[12..<13] << 25) | (in_bits#[4..<7] << 22) | (2 << 15) | (2 << 12) | (c_rd__w1#[0..<5] << 7) | 3
        if c_rd__w1 == 0 {
          illegal = 1
        }
      }
      == 14 {
        expanded = (in_bits#[2..<5] << 26) | (in_bits#[12..<13] << 25) | (in_bits#[5..<7] << 23) | (2 << 15) | (3 << 12) | (c_rd__w1#[0..<5] << 7) | 3
        if c_rd__w1 == 0 {
          illegal = 1
        }
      }
      == 18 {
        if in_bits#[12..<13] == 0 {
          if c_rs2__w1 == 0 {
            if c_rd__w1 == 0 {
              expanded = 19
              illegal = 1
            } else {
              expanded = (c_rd__w1#[0..<5] << 15) | 0x67
            }
          } else {
            expanded = (c_rs2__w1#[0..<5] << 20) | (c_rd__w1#[0..<5] << 7) | 51
          }
        } elif (c_rs2__w1 == 0) and (c_rd__w1 == 0) {
          expanded = 0x100073
        } elif c_rs2__w1 == 0 {
          expanded = (c_rd__w1#[0..<5] << 15) | (1 << 7) | 0x67
        } else {
          expanded = (c_rs2__w1#[0..<5] << 20) | (c_rd__w1#[0..<5] << 15) | (c_rd__w1#[0..<5] << 7) | 51
        }
      }
      == 22 {
        expanded = (in_bits#[7..<10] << 26) | (in_bits#[12..<13] << 25) | (c_rs2__w1#[0..<5] << 20) | (2 << 15) | (3 << 12) | (in_bits#[10..<12] << 10) | 39
      }
      == 26 {
        expanded = (in_bits#[7..<9] << 26) | (in_bits#[12..<13] << 25) | (c_rs2__w1#[0..<5] << 20) | (2 << 15) | (2 << 12) | (in_bits#[9..<12] << 9) | 35
      }
      == 30 {
        expanded = (in_bits#[7..<10] << 26) | (in_bits#[12..<13] << 25) | (c_rs2__w1#[0..<5] << 20) | (2 << 15) | (3 << 12) | (in_bits#[10..<12] << 10) | 35
      }
      else {
        expanded = in_bits
      }
    }
    if in_bits#[0..<16] == 0 {
      out_bits = 0
    } else {
      out_bits = if illegal != 0 { (expanded#[5..<32] << 5) | 31 } else { expanded }
    }
  }
}
