pub mod prim_fifo_sync_p1<Width=3, Depth=4>::[timecheck=false](clk_i:Clock, rst_ni:U1, clr_i:U1, wvalid_i:U1, wdata_i:U3, rready_i:U1) -> (wready_o:U1@[], rvalid_o:U1@[], rdata_o:U3@[], depth_o:U3@[], full_o:U1@[], empty_o:U1@[]) {
  mut _mux_3:U32 = 0
  mut _mux_4:U32 = 0
  reg depth_q:U3:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg wptr_q:U2:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg rptr_q:U2:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg mem:[4]U3:[ordering="old", __store_clock_pin=clk_i, __store_posclk=true]
  mut wptr_d:U2 = 0
  mut rptr_d:U2 = 0
  mut depth_d:U3 = 0sb?
  wptr_d = 0sb?
  rptr_d = 0sb?
  mut _b2i_1 = if depth_q == Depth { 1 } else { 0 }
  const full_o__w1 = _b2i_1
  mut _b2i_2 = if depth_q == 0 { 1 } else { 0 }
  const empty_o__w1 = _b2i_2
  const wready_o__w1 = ~full_o__w1#[0]
  const rvalid_o__w1 = ~empty_o__w1#[0]
  const depth_o__w1 = depth_q
  const do_write__w1 = wvalid_i & wready_o__w1 & 1
  const do_read__w1 = rvalid_o__w1 & rready_i & 1
  const t13 = ((do_write__w1 & 1) << 1) | (do_read__w1 & 1)
  depth_d = unique if t13 == 2 { (depth_q + 1)#[0..<3] } elif t13 == 1 { (depth_q - 1)#[0..<32]#[0..<3] } else { depth_q }
  wptr_d = wptr_q
  if do_write__w1 != 0 {
    _mux_3 = if wptr_q == (Depth - 1)#[0..<32]#[0..<2] { 0 } else { (wptr_q + 1)#[0..<32] }
    wptr_d = _mux_3#[0..<2]
  }
  rptr_d = rptr_q
  if do_read__w1 != 0 {
    _mux_4 = if rptr_q == (Depth - 1)#[0..<32]#[0..<2] { 0 } else { (rptr_q + 1)#[0..<32] }
    rptr_d = _mux_4#[0..<2]
  }
  if do_write__w1 != 0 {
    mem[wptr_q] = wdata_i
  }
  const rdata_o__w1 = mem[rptr_q]
  if rst_ni != 0 {
    if clr_i != 0 {
      depth_q = 0
      wptr_q = 0
      rptr_q = 0
    } else {
      depth_q = depth_d
      wptr_q = wptr_d
      rptr_q = rptr_d
    }
  }
  wready_o = wready_o__w1
  rvalid_o = rvalid_o__w1
  rdata_o = rdata_o__w1
  depth_o = depth_o__w1
  full_o = full_o__w1
  empty_o = empty_o__w1
}
