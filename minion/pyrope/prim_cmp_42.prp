pub comb prim_cmp_42::[timecheck=false](a:u68, b:u68, c:u68, d:u68, cin:u1) -> (sv:u68, cv:u68) {
  const cout__w1 = ((a ^ b) & c) | ((~(a ^ b))#[0..=67] & a)
  cv = ((a ^ b ^ c ^ d) & (cin | (cout__w1#[0..=66] << 1))) | ((~(a ^ b ^ c ^ d))#[0..=67] & d)
  sv = a ^ b ^ c ^ d ^ (cin | (cout__w1#[0..=66] << 1))
}
