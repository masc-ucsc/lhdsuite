  const t12 = ((cout__w1#[0..=66] & 0x00000000000000007ffffffffffffffff) << 1) | (cin & 1)
  const t18 = ((cout__w1#[0..=66] & 0x00000000000000007ffffffffffffffff) << 1) | (cin & 1)
