pub mod prim_phase_pair_lo_hi::[timecheck=false](clk_i:u1, lo_en_i:u1, hi_en_i:u1, d_i:u1) -> (q_lo_o:u1@[], q_hi_o:u1@[]) {
  reg lo_en_2p:u1:[latch=true]
  reg hi_en_1p:u1:[latch=true]
  reg q_lo_reg:u1:[latch=true]
  reg q_hi_reg:u1:[latch=true]
  if clk_i != 0 {
    lo_en_2p = lo_en_i
  }
  if clk_i == 0 {
    hi_en_1p = hi_en_i
    if lo_en_2p != 0 {
      q_lo_reg = d_i
    }
  }
  if (clk_i != 0) and (hi_en_1p != 0) {
    q_hi_reg = q_lo_reg
  }
  q_hi_o = q_hi_reg
  q_lo_o = q_lo_reg
}
