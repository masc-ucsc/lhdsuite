pub mod prim_write_commit_rst_en<Width=9, ResetValue=0>::[timecheck=false](clk_i:Clock, rst_i:U1, en_i:U1, d_i:U9) -> (q_o:U9@[]) {
  reg q_o:U9:[initial=0, reset_pin=rst_i, async=true, enable=clk_i, latch=true]
  reg en_1p:U1:[enable=clk_i, enable_high=false, latch=true]
  en_1p = en_i
  if en_1p != 0 {
    q_o = d_i
  }
}
