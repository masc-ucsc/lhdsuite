const vpu_defs_pkg = import("vpu_defs_pkg")

pub comb txfma_norm_shf::[timecheck=false](op_i:u52, shfamnt_i:(e6:u1, e5:u1, e4:u1, e3:u1, e2:u1, e1:u1, e0:u1)) -> (op_norm_o:u34) {
  mut _mux_1:u7 = if shfamnt_i.e6 != 0 { (0 - ((shfamnt_i.e6 << 6) | (shfamnt_i.e5 << 5) | (shfamnt_i.e4 << 4) | (shfamnt_i.e3 << 3) | (shfamnt_i.e2 << 2) | (shfamnt_i.e1 << 1) | shfamnt_i.e0))#[0..=6] } else { ((shfamnt_i.e6 << 6) | (shfamnt_i.e5 << 5) | (shfamnt_i.e4 << 4) | (shfamnt_i.e3 << 3) | (shfamnt_i.e2 << 2) | (shfamnt_i.e1 << 1) | shfamnt_i.e0)#[0..=6] }
  const shfamnt_abs__w1 = _mux_1
  mut _mux_2:u52 = if shfamnt_i.e6 != 0 { (op_i >> shfamnt_abs__w1)#[0..=51] } else { (op_i << shfamnt_abs__w1)#[0..=51] }
  op_norm_o = _mux_2#[15..=48]
}
