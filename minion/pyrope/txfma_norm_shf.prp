pub comb txfma_norm_shf<left_bit_in=63, left_bit_out=60, right_bit_in=12, right_bit_out=27, shift_size=7>::[timecheck=false](op_i:U52, shfamnt_i:(e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)) -> (op_norm_o:U34) {
  mut _mux_1:U7 = if shfamnt_i.e6 != 0 { (0 - ((shfamnt_i.e6 << 6) | (shfamnt_i.e5 << 5) | (shfamnt_i.e4 << 4) | (shfamnt_i.e3 << 3) | (shfamnt_i.e2 << 2) | (shfamnt_i.e1 << 1) | shfamnt_i.e0))#[0..<7] } else { ((shfamnt_i.e6 << 6) | (shfamnt_i.e5 << 5) | (shfamnt_i.e4 << 4) | (shfamnt_i.e3 << 3) | (shfamnt_i.e2 << 2) | (shfamnt_i.e1 << 1) | shfamnt_i.e0)#[0..<7] }
  const shfamnt_abs__w1 = _mux_1
  mut _mux_2:U52 = if shfamnt_i.e6 != 0 { (op_i >> shfamnt_abs__w1)#[0..<52] } else { (op_i << shfamnt_abs__w1)#[0..<52] }
  op_norm_o = _mux_2#[15..<49]
}
