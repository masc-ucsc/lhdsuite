const vpu_defs_pkg = import("vpu_defs_pkg")

pub comb txfma_norm_shf::[timecheck=false](op_i:u52, shfamnt_i:u7) -> (op_norm_o:u34) {
  mut _mux_1:u7 = if ((shfamnt_i >> 6) & 1) != 0 { (0 - shfamnt_i)#[0..=6]#[0..=6] } else { shfamnt_i }
  const shfamnt_abs__w1 = _mux_1
  mut _mux_2:u52 = if ((shfamnt_i >> 6) & 1) != 0 { (op_i >> shfamnt_abs__w1)#[0..=51] } else { (op_i << shfamnt_abs__w1)#[0..=51]#[0..=51] }
  op_norm_o = _mux_2#[15..=48]
}
