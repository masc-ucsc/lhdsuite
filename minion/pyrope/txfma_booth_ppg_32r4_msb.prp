const minion_pkg = import("minion_pkg")

pub comb txfma_booth_ppg_32r4_msb::[timecheck=false](mulcand_i:minion_pkg.VpuDataSSz_T, msb_i:u1, sign_i:u1) -> (pp_o:u33) {
  const t4 = ((0 & 1) << 32) | (mulcand_i & 4294967295)
  mut _mux_1:u33 = if (sign_i == 0) and (msb_i != 0) { t4#[0..=32] } else { 0 }
  pp_o = _mux_1
}
