pub mod minion_frontend_thread_sched<NrThreads=2>::[timecheck=false](clk_i:Clock, rst_ni:U1, f7_valid_tid_i:U2, f0_thread_enabled_i:U2, id_core_stall_i:U2) -> (f7_thread_awake_o:U2@[], f7_thread_id_o:U1@[]) {
  reg thread_id_prev_q:U1:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg thread_awake_q:U2:[initial=3, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  wire valid_tid_qual:U2 = nil
  f7_thread_id_o = 0ub?
  valid_tid_qual = (f7_valid_tid_i & thread_awake_q)#[0..<2]
  if valid_tid_qual#[1..<2] == 0 {
    f7_thread_id_o = 0
  } else {
    f7_thread_id_o = if (valid_tid_qual & 1) == 0 { 1 } else { ~thread_id_prev_q }
  }
  const f7_thread_awake_o__w1 = thread_awake_q
  if rst_ni != 0 {
    if valid_tid_qual != 0 {
      thread_id_prev_q = f7_thread_id_o
    }
    thread_awake_q = (f0_thread_enabled_i & (~id_core_stall_i))#[0..<2]
  }
  f7_thread_awake_o = f7_thread_awake_o__w1
}
