pub mod prim_rf_1r1w_reg_preview<Width=32, Depth=0x80, PreviewClkSameAsRf=1>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_data_i:U32, wr_addr_i:U7, wr_en_i:U1, rd_addr_i:U7, rd_en_i:U1) -> (rd_data_o:U32@[]) {
  reg rf_q:[128]U32:[ordering="old", __store_clock_pin=rf_clk_i, __store_posclk=true]
  reg wr_data_del_q:U32:[clock_pin=rf_clk_i, posclk=false]
  reg rd_addr_q:U7:[clock_pin=rf_clk_i]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if rd_en_i != 0 {
    rd_addr_q = rd_addr_i
  }
  if wr_en_i != 0 {
    rf_q[wr_addr_i] = wr_data_del_q
  }
  rd_data_o = rf_q[rd_addr_q]
}
