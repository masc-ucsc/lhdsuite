const minion_pkg = import("minion_pkg")
const intpipe_csr_pkg = import("intpipe_csr_pkg")

pub mod intpipe_csr_pmu_read_interface::[timecheck=false](clk_i:u1, rst_ni:u1, io_rw_mem_valid:u1, io_rw_mem_thread_id:u1, io_rw_mem_addr:minion_pkg.CsrRegAddrSize_T) -> (io_rw_mem_ready:minion_pkg.NrThreads_T@[], pmu_read_sel:u8@[], pmu_read_en_wb:u1@[]) {
  reg pmu_read_sel:u8:[clock_pin=ref clk_i, clock_pin=ref clk_i]
  reg pmu_read_en_wb:u1:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg pmu_read_prop:u6:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg pmu_read_ready:u2:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  mut pmu_read_valid_th = 0
  mut pmu_read_current_sel = 0
  mut pmu_read_sel_next = 0
  mut pmu_read_ready_next = 0
  mut pmu_read_prop_next = 0
  io_rw_mem_ready = 0ub??
  mut pmu_read_ongoing__w2 = 0
  pmu_read_ongoing__w2#[0..=0] = (0 | unsigned(pmu_read_prop#[0..=2] != 0))
  mut pmu_read_ongoing__w3 = pmu_read_ongoing__w2
  pmu_read_ongoing__w3#[1..=1] = (((pmu_read_ongoing__w2 >> 1) & 1) | unsigned(pmu_read_prop#[3..=5] != 0))
  const pmu_read_valid_mm__w1 = unsigned((io_rw_mem_valid != 0) and (io_rw_mem_addr >= intpipe_csr_pkg.csr_ad_MHPMCOUNTER3) and (io_rw_mem_addr <= intpipe_csr_pkg.csr_ad_MHPMCOUNTER8))
  const pmu_read_valid__w1 = unsigned((pmu_read_valid_mm__w1 != 0) or (unsigned((io_rw_mem_valid != 0) and (io_rw_mem_addr >= intpipe_csr_pkg.csr_ad_HPMCOUNTER3) and (io_rw_mem_addr <= intpipe_csr_pkg.csr_ad_HPMCOUNTER8)) != 0))
  mut _mux_6:u3 = if pmu_read_valid_mm__w1 != 0 { (io_rw_mem_addr - intpipe_csr_pkg.csr_ad_MHPMCOUNTER3)#[0..=11]#[0..=2]#[0..=2] } else { (io_rw_mem_addr - intpipe_csr_pkg.csr_ad_HPMCOUNTER3)#[0..=11]#[0..=2]#[0..=2] }
  const pmu_read_addr__w1 = _mux_6
  pmu_read_valid_th = 0ub??
  mut pmu_read_valid_th__w1 = pmu_read_valid_th
  pmu_read_valid_th__w1#[0..=0] = unsigned((pmu_read_valid__w1 != 0) and (io_rw_mem_thread_id == 0) and (not ((pmu_read_ongoing__w3 & 2) != 0)))
  pmu_read_current_sel = 0ub??
  mut pmu_read_current_sel__w1 = pmu_read_current_sel
  pmu_read_current_sel__w1#[0..=0] = unsigned((pmu_read_valid__w1 != 0) and (io_rw_mem_thread_id == 0) and (pmu_read_sel#[0..=3] == (io_rw_mem_thread_id | (pmu_read_addr__w1 << 1))))
  pmu_read_sel_next = 0ub????????
  mut pmu_read_sel_next__w1 = pmu_read_sel_next
  pmu_read_sel_next__w1#[0..=3] = (io_rw_mem_thread_id | (pmu_read_addr__w1 << 1))
  mut pmu_read_valid_th__w2 = pmu_read_valid_th__w1
  pmu_read_valid_th__w2#[1..=1] = unsigned((pmu_read_valid__w1 != 0) and (io_rw_mem_thread_id == 1) and (not ((pmu_read_ongoing__w3 & 1) != 0)))
  mut pmu_read_current_sel__w2 = pmu_read_current_sel__w1
  pmu_read_current_sel__w2#[1..=1] = unsigned((pmu_read_valid__w1 != 0) and (io_rw_mem_thread_id == 1) and (pmu_read_sel#[4..=7] == (io_rw_mem_thread_id | (pmu_read_addr__w1 << 1))))
  mut pmu_read_sel_next__w2 = pmu_read_sel_next__w1
  pmu_read_sel_next__w2#[4..=7] = (io_rw_mem_thread_id | (pmu_read_addr__w1 << 1))
  pmu_read_ready_next = 0ub??
  mut pmu_read_ready_next__w1 = pmu_read_ready_next
  pmu_read_ready_next__w1#[0..=0] = (pmu_read_ready & 1)
  pmu_read_ready_next = pmu_read_ready_next__w1
  if ((pmu_read_prop#[0..=2] >> (minion_pkg.PmuCountersReadDelay - 1)) & 1) != 0 {
    pmu_read_ready_next#[0..=0] = 1
  } elif ((pmu_read_ready & 1) != 0) and ((pmu_read_current_sel__w2 & 1) != 0) {
    pmu_read_ready_next#[0..=0] = 1
  } elif ((pmu_read_valid_th__w2 & 1) != 0) and ((pmu_read_current_sel__w2 & 1) == 0) {
    pmu_read_ready_next#[0..=0] = 0
  }
  pmu_read_prop_next = 0ub??????
  mut pmu_read_prop_next__w1 = pmu_read_prop_next
  pmu_read_prop_next__w1#[0..=2] = ((pmu_read_valid_th__w2 & 1 & (~(pmu_read_ready_next & 1)) & 1) | (pmu_read_prop#[0..=2]#[0..=1] << 1))
  mut pmu_read_ready_next__w2 = pmu_read_ready_next
  pmu_read_ready_next__w2#[1..=1] = ((pmu_read_ready >> 1) & 1)
  pmu_read_ready_next = pmu_read_ready_next__w2
  if ((pmu_read_prop#[3..=5] >> (minion_pkg.PmuCountersReadDelay - 1)) & 1) != 0 {
    pmu_read_ready_next#[1..=1] = 1
  } elif (((pmu_read_ready >> 1) & 1) != 0) and (((pmu_read_current_sel__w2 >> 1) & 1) != 0) {
    pmu_read_ready_next#[1..=1] = 1
  } elif (((pmu_read_valid_th__w2 >> 1) & 1) != 0) and (((pmu_read_current_sel__w2 >> 1) & 1) == 0) {
    pmu_read_ready_next#[1..=1] = 0
  }
  mut pmu_read_prop_next__w2 = pmu_read_prop_next__w1
  pmu_read_prop_next__w2#[3..=5] = (((pmu_read_valid_th__w2 >> 1) & 1 & (~((pmu_read_ready_next >> 1) & 1)) & 1) | (pmu_read_prop#[3..=5]#[0..=1] << 1))
  if rst_ni == 0 {
    pmu_read_sel#[0..=3] = 0
  } elif (pmu_read_valid_th__w2 & 1) != 0 {
    pmu_read_sel#[0..=3] = pmu_read_sel_next__w2#[0..=3]
  }
  if rst_ni == 0 {
    pmu_read_sel#[4..=7] = 0
  } elif ((pmu_read_valid_th__w2 >> 1) & 1) != 0 {
    pmu_read_sel#[4..=7] = pmu_read_sel_next__w2#[4..=7]
  }
  pmu_read_prop = pmu_read_prop_next__w2
  pmu_read_ready = pmu_read_ready_next
  pmu_read_en_wb = unsigned(pmu_read_valid_th__w2 != 0)
  io_rw_mem_ready = pmu_read_ready
}
