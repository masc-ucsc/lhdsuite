pub comb txfma_trz_p1<TrzOut=4, Max=10>::[timecheck=false](frac_i:U11) -> (trz_o:U4) {
  const FracWidth = Max + 1
  trz_o = 0sb?
  trz_o = if frac_i#[10..<11] != 0 { 10 } else { FracWidth#[0..<4] }
  if frac_i#[9..<10] != 0 {
    trz_o = 9
  }
  if frac_i#[8..<9] != 0 {
    trz_o = 8
  }
  if frac_i#[7..<8] != 0 {
    trz_o = 7
  }
  if frac_i#[6..<7] != 0 {
    trz_o = 6
  }
  if frac_i#[5..<6] != 0 {
    trz_o = 5
  }
  if frac_i#[4..<5] != 0 {
    trz_o = 4
  }
  if frac_i#[3..<4] != 0 {
    trz_o = 3
  }
  if frac_i#[2..<3] != 0 {
    trz_o = 2
  }
  if frac_i#[1..<2] != 0 {
    trz_o = 1
  }
  if (frac_i & 1) != 0 {
    trz_o = 0
  }
}
