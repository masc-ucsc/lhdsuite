pub comb txfma_trz_p1<TrzOut=4, Max=10>::[timecheck=false](frac_i:u11) -> (trz_o:u4) {
  const FracWidth = Max + 1
  trz_o = 0sb?
  trz_o = if ((frac_i >> 10) & 1) != 0 { 10 } else { FracWidth#[0..=3] }
  if ((frac_i >> 9) & 1) != 0 {
    trz_o = 9
  }
  if ((frac_i >> 8) & 1) != 0 {
    trz_o = 8
  }
  if ((frac_i >> 7) & 1) != 0 {
    trz_o = 7
  }
  if ((frac_i >> 6) & 1) != 0 {
    trz_o = 6
  }
  if ((frac_i >> 5) & 1) != 0 {
    trz_o = 5
  }
  if ((frac_i >> 4) & 1) != 0 {
    trz_o = 4
  }
  if ((frac_i >> 3) & 1) != 0 {
    trz_o = 3
  }
  if ((frac_i >> 2) & 1) != 0 {
    trz_o = 2
  }
  if ((frac_i >> 1) & 1) != 0 {
    trz_o = 1
  }
  if (frac_i & 1) != 0 {
    trz_o = 0
  }
}
