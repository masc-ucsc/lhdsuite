const minion_dcache_pkg = import("minion_dcache_pkg")

pub mod minion_dcache_scratchpad_ctrl::[timecheck=false](clk_i:Clock, rst_ni:U1, scratchpad_ctrl_i:U2, dcache_idle_i:U1, da_clear_rdy_i:U1) -> (dcache_cfg_stall_o:U1@[], dcache_cfg_clear_all_o:U1@[], dcache_cfg_clear_low_o:U1@[], dcache_cfg_alloc_scp_o:U1@[], da_clear_en_o:U1@[], da_clear_val_o:U1@[], da_clear_set_o:minion_dcache_pkg.DcacheSetIdxWidth_T@[], da_clear_way_o:minion_dcache_pkg.DcacheWayIdxWidth_T@[], da_clear_idx_o:U1@[], dcache_cfg_mode_o:U2@[]) {
  reg state_q:U2:[initial=0, reset_pin=rst_ni, async=false, negreset=true, clock_pin=clk_i]
  reg current_scp_ctrl_q:U2:[initial=0, reset_pin=rst_ni, async=false, negreset=true, clock_pin=clk_i]
  reg zero_counter_q:U7:[clock_pin=clk_i]
  wire zero_count_up:U1 = nil
  mut state_d:U2 = 0
  mut current_scp_ctrl_d:U2 = 0
  const DcacheLramRowsLast = (minion_dcache_pkg.DcacheLramRows - 1)#[0..<32]
  const DcacheLramRowsSplitLast = (minion_dcache_pkg.DcacheLramRowsSplit - 1)#[0..<32]
  state_d = 0sb?
  current_scp_ctrl_d = 0sb?
  mut zero_counter_d:U7 = 0sb?
  mut _b2i_1 = if (state_q != 3) or (current_scp_ctrl_q != scratchpad_ctrl_i) { 1 } else { 0 }
  mut _b2i_2 = if state_q != 3 { 1 } else { 0 }
  mut _b2i_3 = if (state_q == 1) and ((current_scp_ctrl_q == minion_dcache_pkg.DcacheModeShared) or (scratchpad_ctrl_i == minion_dcache_pkg.DcacheModeShared)) { 1 } else { 0 }
  mut _b2i_4 = if (state_q == 1) and (not ((current_scp_ctrl_q == minion_dcache_pkg.DcacheModeShared) or (scratchpad_ctrl_i == minion_dcache_pkg.DcacheModeShared))) { 1 } else { 0 }
  mut _b2i_5 = if (state_q == 1) and (current_scp_ctrl_q == minion_dcache_pkg.DcacheModeSplit) and (scratchpad_ctrl_i == minion_dcache_pkg.DcacheModeScratchpad) { 1 } else { 0 }
  const dcache_cfg_mode_o__w1 = current_scp_ctrl_q
  mut _mux_6:U7 = if (current_scp_ctrl_q == minion_dcache_pkg.DcacheModeShared) or (scratchpad_ctrl_i == minion_dcache_pkg.DcacheModeShared) { DcacheLramRowsLast#[0..<7] } else { DcacheLramRowsSplitLast#[0..<7] }
  mut _b2i_7 = if state_q == 2 { 1 } else { 0 }
  const da_clear_val_o__w1 = _b2i_7
  mut _b2i_8 = if (state_q == 1) or (state_q == 2) { 1 } else { 0 }
  const da_clear_way_o__w1 = zero_counter_q#[0..<2]
  const da_clear_idx_o__w1 = (zero_counter_q >> 2) & 1
  const da_clear_set_o__w1 = (zero_counter_q >> 3)#[0..<4]
  mut _b2i_9 = if ((da_clear_val_o__w1 != 0) and (da_clear_rdy_i != 0)) or (state_q == 1) { 1 } else { 0 }
  zero_count_up = _b2i_9
  zero_counter_d = if state_q == 1 { 0 } else { (zero_counter_q + 1)#[0..<7] }
  mut _b2i_10 = if (zero_counter_q == _mux_6) and (zero_count_up != 0) { 1 } else { 0 }
  if zero_count_up != 0 {
    zero_counter_q = zero_counter_d
  }
  current_scp_ctrl_d = current_scp_ctrl_q
  state_d = state_q
  if state_q == 0 {
    if dcache_idle_i != 0 {
      state_d = 1
    }
  } elif state_q == 1 {
    state_d = 2
  } elif state_q == 2 {
    if _b2i_10 != 0 {
      state_d = 3
      current_scp_ctrl_d = scratchpad_ctrl_i
    }
  } elif state_q == 3 {
    state_d = 0
  }
  if rst_ni != 0 {
    if _b2i_1 != 0 {
      state_q = state_d
      current_scp_ctrl_q = current_scp_ctrl_d
    }
  }
  dcache_cfg_stall_o = _b2i_2
  dcache_cfg_clear_all_o = _b2i_3
  dcache_cfg_clear_low_o = _b2i_4
  dcache_cfg_alloc_scp_o = _b2i_5
  da_clear_en_o = _b2i_8
  da_clear_val_o = da_clear_val_o__w1
  da_clear_set_o = da_clear_set_o__w1
  da_clear_way_o = da_clear_way_o__w1
  da_clear_idx_o = da_clear_idx_o__w1
  dcache_cfg_mode_o = dcache_cfg_mode_o__w1
}
