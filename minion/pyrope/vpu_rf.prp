const prim_rf_3r2w_preview = import("prim_rf_3r2w_preview.prim_rf_3r2w_preview")
const minion_pkg = import("minion_pkg")
const vpu_pkg = import("vpu_pkg")

pub mod vpu_rf<UseMmi=0, UseMmiNetlist=0>::[timecheck=false](rd_en_i:(e2:u1, e1:u1, e0:u1), rd_thread_id_i:(e2:u1, e1:u1, e0:u1), rd_addr_i:u15, clk_i:u1, wr_en_i:(e1:u1, e0:u1), wr_en_early_i:(e1:u1, e0:u1), wr_thread_id_i:(e1:u1, e0:u1), wr_mask_i:(e1:u1, e0:u1), wr_addr_i:u10, wr_data_i:u64) -> (rd_data_o:u96@[]) {
  reg rd_addr_q:[3]u6:[ordering="old", clock_pin=ref clk_i]
  mut rd_data_o__wtmp:u96 = 0sb?
  wire rd_data_o:u96
  if rd_en_i.e0 != 0 {
    rd_addr_q[0] = ((rd_thread_id_i.e0 & 1) << 5) | rd_addr_i#[0..=4]
  }
  if rd_en_i.e1 != 0 {
    rd_addr_q[1] = ((rd_thread_id_i.e1 & 1) << 5) | rd_addr_i#[5..=9]
  }
  if rd_en_i.e2 != 0 {
    rd_addr_q[2] = ((rd_thread_id_i.e2 & 1) << 5) | rd_addr_i#[10..=14]
  }
  mut gen_latch_u_rf = prim_rf_3r2w_preview::[name=gen_latch_u_rf](preview_clk_i = clk_i, rf_clk_i = clk_i, rd_addr_a_i = rd_addr_q[0], rd_addr_b_i = rd_addr_q[1], rd_addr_c_i = rd_addr_q[2], wr_en_a_i = wr_en_i.e0 & wr_mask_i.e0 & 1, wr_addr_a_i = ((wr_thread_id_i.e0 & 1) << 5) | wr_addr_i#[0..=4], wr_data_a_en_1p_next_i = wr_en_early_i.e0, wr_data_a_i = wr_data_i#[0..=31], wr_en_b_i = wr_en_i.e1 & wr_mask_i.e1 & 1, wr_addr_b_i = ((wr_thread_id_i.e1 & 1) << 5) | wr_addr_i#[5..=9], wr_data_b_en_1p_next_i = wr_en_early_i.e1, wr_data_b_i = wr_data_i#[32..=63])
  rd_data_o__wtmp#[0..=31] = gen_latch_u_rf.rd_data_a_o#[0..=31]
  mut rd_data_o__wtmp__w1 = rd_data_o__wtmp
  rd_data_o__wtmp__w1#[32..=63] = gen_latch_u_rf.rd_data_b_o#[0..=31]
  mut rd_data_o__wtmp__w2 = rd_data_o__wtmp__w1
  rd_data_o__wtmp__w2#[64..=95] = gen_latch_u_rf.rd_data_c_o#[0..=31]
  rd_data_o = rd_data_o__wtmp__w2
}
