const minion_pkg = import("minion_pkg")

pub comb debug_breakpoint<TriggerType=0>::[timecheck=false](control_ip:u18, in_debug_ip:minion_pkg.NrThreadsDefault_T, prv_ip:u4, tdata2_ip:u96, address_ip:minion_pkg.VaSizeExt_T, cmd_ip:u3, valid_ip:u1, thread_id_ip:u1) -> (timing_op:u1, xcpt_op:u1, enter_debug_op:u1, update_op:u1) {
  wire `match`:u1
  mut masked_tdata2:u49 = 0
  mut masked_op:u49 = 0
  mut mask:u6 = 0sb?
  masked_tdata2 = 0sb?
  masked_op = 0sb?
  const enabled__w1 = unsigned(((((in_debug_ip << 1) >> (thread_id_ip + 1)) & 1) == 0) and (((((control_ip << 9) >> ((thread_id_ip * 9) + 9))#[0..=8] >> 2) & 1) != 0) and (valid_ip != 0) and (unsigned(((((prv_ip << 2) >> ((thread_id_ip * 2) + 2))#[0..=1] == minion_pkg.PrvM) and (((((control_ip << 9) >> ((thread_id_ip * 9) + 9))#[0..=8] >> 5) & 1) != 0)) or ((((prv_ip << 2) >> ((thread_id_ip * 2) + 2))#[0..=1] == minion_pkg.PrvS) and (((((control_ip << 9) >> ((thread_id_ip * 9) + 9))#[0..=8] >> 4) & 1) != 0)) or ((((prv_ip << 2) >> ((thread_id_ip * 2) + 2))#[0..=1] == minion_pkg.PrvU) and (((((control_ip << 9) >> ((thread_id_ip * 9) + 9))#[0..=8] >> 3) & 1) != 0))) != 0))
  const masked_tdata2__w1 = (((((tdata2_ip << 48) >> ((thread_id_ip * 48) + 48))#[0..=47] >> (minion_pkg.VaSize - 1)#[0..=31]) & 1) << 48) | ((tdata2_ip << 48) >> ((thread_id_ip * 48) + 48))#[0..=47]
  mask = unique if (masked_tdata2__w1#[0..=5] & 0xffffffffffffffc1) == 0 { 1 } elif (masked_tdata2__w1#[0..=5] & 0xffffffffffffffc3) == 1 { 3 } elif (masked_tdata2__w1#[0..=5] & 0xffffffffffffffc7) == 3 { 7 } elif (masked_tdata2__w1#[0..=5] & 0xffffffffffffffcf) == 7 { 15 } elif (masked_tdata2__w1#[0..=5] & 0xffffffffffffffdf) == 15 { 31 } else { 63 }
  masked_tdata2 = masked_tdata2__w1
  masked_op = address_ip
  if ((((control_ip << 9) >> ((thread_id_ip * 9) + 9))#[0..=8] >> 6) & 1) != 0 {
    masked_tdata2#[0..=5] = masked_tdata2#[0..=5] | mask
    masked_op#[0..=5] = masked_op#[0..=5] | mask
  }
  `match` = unsigned(masked_op == masked_tdata2)
  timing_op = 0
  xcpt_op = unsigned((`match` != 0) and (enabled__w1 != 0) and (((((control_ip << 9) >> ((thread_id_ip * 9) + 9))#[0..=8] >> 7) & 1) == 0))
  enter_debug_op = unsigned((`match` != 0) and (enabled__w1 != 0) and (((((control_ip << 9) >> ((thread_id_ip * 9) + 9))#[0..=8] >> 7) & 1) != 0))
  update_op = unsigned((`match` != 0) and (enabled__w1 != 0))
}
