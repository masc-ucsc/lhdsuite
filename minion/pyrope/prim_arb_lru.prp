pub mod prim_arb_lru::[timecheck=false](clk_i:u1, rst_ni:u1, bid_i:(e1:u1, e0:u1), stall_i:u1) -> (grant_o:(e1:u1, e0:u1)@[], winner_o:u1@[]) {
  reg prio_q:[2]u2:[ordering="old", init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  mut win_per_client:u2 = 0
  mut prio_d:u4 = 0
  winner_o = 0ub?
  win_per_client = 0sb?
  mut win_per_client__w1 = win_per_client
  win_per_client__w1#[0] = bid_i.e0 & 1
  mut win_per_client__w2 = win_per_client__w1
  win_per_client__w2#[0] = unsigned(((win_per_client__w1 & 1) != 0) and ((((~bid_i.e1) & 1) != 0) or (((~(prio_q[1] & 1)) & 1) != 0))) & 1
  mut `grant_o__bpo.e0` = unsigned(((win_per_client__w2 & 1) != 0) and (((~stall_i) & 1) != 0))
  mut win_per_client__w3 = win_per_client__w2
  win_per_client__w3#[1] = bid_i.e1 & 1
  mut win_per_client__w4 = win_per_client__w3
  win_per_client__w4#[1] = unsigned((((win_per_client__w3 >> 1) & 1) != 0) and ((((~bid_i.e0) & 1) != 0) or ((prio_q[1] & 1) != 0))) & 1
  mut `grant_o__bpo.e1` = unsigned((((win_per_client__w4 >> 1) & 1) != 0) and (((~stall_i) & 1) != 0))
  prio_d = 0sb?
  winner_o = if (win_per_client__w4 & 1) != 0 { 0 } else { 0 }
  prio_d = prio_q
  if `grant_o__bpo.e0` != 0 {
    prio_d#[2] = 1
  }
  if ((win_per_client__w4 >> 1) & 1) != 0 {
    winner_o = 1
  }
  if `grant_o__bpo.e1` != 0 {
    prio_d#[2] = 0
  }
  if (((bid_i.e1 << 1) | bid_i.e0) != 0) and (stall_i == 0) {
    prio_q = prio_d
  }
  grant_o.e1 = `grant_o__bpo.e1`
  grant_o.e0 = `grant_o__bpo.e0`
}
