pub mod prim_arb_lru<NumClients=2, NumClientsLog=1>::[timecheck=false](clk_i:Clock, rst_ni:U1, bid_i:(e1:U1, e0:U1), stall_i:U1) -> (grant_o:(e1:U1, e0:U1)@[], winner_o:U1@[]) {
  wire grant_o__bpr:(e1:U1, e0:U1) = nil
  reg prio_q:[2]U2:[ordering="old", initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  mut prio_d:U4 = 0
  mut win_per_client:U2 = 0
  prio_d = 0sb?
  win_per_client = 0sb?
  winner_o = 0ub?
  mut win_per_client__w1 = win_per_client
  win_per_client__w1#[0..<1] = bid_i.e0 & 1
  mut _b2i_1 = if ((win_per_client__w1 & 1) != 0) and (((~bid_i.e1#[0]) != 0) or ((~(prio_q[1] & 1)#[0]) != 0)) { 1 } else { 0 }
  mut win_per_client__w2 = win_per_client__w1
  win_per_client__w2#[0..<1] = _b2i_1 & 1
  mut _b2i_2 = if ((win_per_client__w2 & 1) != 0) and ((~stall_i) != 0) { 1 } else { 0 }
  mut `grant_o__bpo.e0` = _b2i_2
  mut win_per_client__w3 = win_per_client__w2
  win_per_client__w3#[1..<2] = bid_i.e1 & 1
  mut _b2i_3 = if (win_per_client__w3#[1..<2] != 0) and (((~bid_i.e0#[0]) != 0) or ((prio_q[1] & 1) != 0)) { 1 } else { 0 }
  mut win_per_client__w4 = win_per_client__w3
  win_per_client__w4#[1..<2] = _b2i_3 & 1
  mut _b2i_4 = if (win_per_client__w4#[1..<2] != 0) and ((~stall_i) != 0) { 1 } else { 0 }
  mut `grant_o__bpo.e1` = _b2i_4
  winner_o = if (win_per_client__w4 & 1) != 0 { 0 } else { 0 }
  prio_d = prio_q#[0..<4]
  if grant_o__bpr.e0 != 0 {
    prio_d#[2..<3] = 1
  }
  if win_per_client__w4#[1..<2] != 0 {
    winner_o = 1
  }
  if grant_o__bpr.e1 != 0 {
    prio_d#[2..<3] = 0
  }
  if rst_ni != 0 {
    if (((bid_i.e1 << 1) | bid_i.e0) != 0) and (stall_i == 0) {
      prio_q#[0..<4] = prio_d
    }
  }
  const t57 = `grant_o__bpo.e1`
  grant_o__bpr.e1 = t57
  grant_o.e1 = t57
  const t58 = `grant_o__bpo.e0`
  grant_o__bpr.e0 = t58
  grant_o.e0 = t58
}
