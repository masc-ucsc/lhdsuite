pub mod prim_arb_lru::[timecheck=false](clk_i:u1, rst_ni:u1, bid_i:u2, stall_i:u1) -> (grant_o:u2@[], winner_o:u1@[]) {
  reg prio_q:u4:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  mut win_per_client = 0
  mut prio_d = 0
  win_per_client = 0ub??
  mut win_per_client__w1 = win_per_client
  win_per_client__w1#[0..=0] = (bid_i & 1)
  grant_o = 0ub??
  winner_o = 0ub?
  mut win_per_client__w2 = win_per_client__w1
  win_per_client__w2#[0..=0] = unsigned(((win_per_client__w1 & 1) != 0) and ((((~((bid_i >> 1) & 1)) & 1) != 0) or (((~(prio_q#[2..=3] & 1)) & 1) != 0)))
  mut grant_o__w1 = grant_o
  grant_o__w1#[0..=0] = unsigned(((win_per_client__w2 & 1) != 0) and (((~stall_i) & 1) != 0))
  mut win_per_client__w3 = win_per_client__w2
  win_per_client__w3#[1..=1] = ((bid_i >> 1) & 1)
  mut win_per_client__w4 = win_per_client__w3
  win_per_client__w4#[1..=1] = unsigned((((win_per_client__w3 >> 1) & 1) != 0) and ((((~(bid_i & 1)) & 1) != 0) or ((prio_q#[2..=3] & 1) != 0)))
  mut grant_o__w2 = grant_o__w1
  grant_o__w2#[1..=1] = unsigned((((win_per_client__w4 >> 1) & 1) != 0) and (((~stall_i) & 1) != 0))
  prio_d = 0ub????
  winner_o = if (win_per_client__w4 & 1) != 0 { 0 } else { 0 }
  prio_d = prio_q
  if (grant_o__w2 & 1) != 0 {
    prio_d#[2..=2] = 1
  }
  if ((win_per_client__w4 >> 1) & 1) != 0 {
    winner_o = 1
  }
  if ((grant_o__w2 >> 1) & 1) != 0 {
    prio_d#[2..=2] = 0
  }
  if (bid_i != 0) and (stall_i == 0) {
    prio_q = prio_d
  }
  grant_o = grant_o__w2
}
