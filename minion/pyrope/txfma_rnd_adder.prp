const txfma_adder_p2 = import("txfma_adder_p2.txfma_adder_p2")

pub mod txfma_rnd_adder<left_bit=32, right_bit=0, rnd_ctl_sz=5, rnd_ps=1>::[timecheck=false](`in`:U33, rnd_ctl:U5, cin:U1) -> (out:U32@[]) {
  mut round_vector__w2 = 0
  round_vector__w2#[21..<23] = rnd_ctl#[3..<5]
  mut round_vector__w3 = round_vector__w2
  round_vector__w3#[8..<10] = rnd_ctl#[1..<3]
  mut round_vector__w4 = round_vector__w3
  round_vector__w4#[1..<2] = rnd_ctl & 1
  mut rnd_adder = txfma_adder_p2::[name=rnd_adder](a_i = `in`, b_i = round_vector__w4, cin_i = cin)
  out = rnd_adder#[1..<33]
}
