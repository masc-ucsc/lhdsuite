const txfma_adder_p2 = import("txfma_adder_p2.txfma_adder_p2")

pub mod txfma_rnd_adder::[timecheck=false](`in`:u33, rnd_ctl:u5, cin:u1) -> (out:u32@[]) {
  mut ROUND_VECTOR_PS_PH_INT_round_vector__w2 = 0
  ROUND_VECTOR_PS_PH_INT_round_vector__w2#[21..=22] = rnd_ctl#[3..=4]
  mut ROUND_VECTOR_PS_PH_INT_round_vector__w3 = ROUND_VECTOR_PS_PH_INT_round_vector__w2
  ROUND_VECTOR_PS_PH_INT_round_vector__w3#[8..=9] = rnd_ctl#[1..=2]
  mut ROUND_VECTOR_PS_PH_INT_round_vector__w4 = ROUND_VECTOR_PS_PH_INT_round_vector__w3
  ROUND_VECTOR_PS_PH_INT_round_vector__w4#[1] = (rnd_ctl & 1)
  mut rnd_adder = txfma_adder_p2::[name=rnd_adder](a_i = `in`, b_i = ROUND_VECTOR_PS_PH_INT_round_vector__w4, cin_i = cin)
  out = rnd_adder#[1..=32]
}
