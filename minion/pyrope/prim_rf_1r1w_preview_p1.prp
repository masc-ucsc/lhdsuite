pub mod prim_rf_1r1w_preview_p1<Width=69, Depth=8, PreviewClkSameAsRf=1>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_en_i:U1, wr_addr_i:U3, wr_data_i:U69, rd_addr_i:U3) -> (rd_data_o:U69@[]) {
  reg rf_q:[8]U69:[ordering="old", __store_clock_pin=rf_clk_i, __store_posclk=true]
  reg wr_data_del_q:U69:[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p = wr_data_en_1p_next_i
  if wr_data_en_1p != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q[wr_addr_i] = wr_data_del_q
  }
  rd_data_o = rf_q[rd_addr_i]
}
