      `f5_rom_response_l.exc` = `f5_rom_exp1_coefs.exc`
      `f5_rom_response_l.mask` = `f5_rom_exp1_coefs.mask`
      `f5_rom_response_l.taylor` = `f5_rom_exp1_coefs.taylor`
    }
    == vpu_pkg.TransRomExp2Id {
      `f5_rom_response_l.c0` = `f5_rom_exp2_coefs.c0`
      `f5_rom_response_l.c2` = `f5_rom_exp2_coefs.c2`
      `f5_rom_response_l.exc` = f5_exc_q & 1
      `f5_rom_response_l.mask` = `f5_rom_exp2_coefs.mask`
      `f5_rom_response_l.taylor` = `f5_rom_exp2_coefs.taylor`
    }
    == vpu_pkg.TransRomSin1Id {
      `f5_rom_response_l.c0` = 0
      `f5_rom_response_l.c2` = 0
      `f5_rom_response_l.exc` = 0
      `f5_rom_response_l.mask` = 0
      `f5_rom_response_l.taylor` = f5_sin_taylor_q & 1
    }
    == vpu_pkg.TransRomSin2Id {
      if f5_sin_taylor_q != 0 {
        `f5_rom_response_l.c0` = 0xc90fdb00
        `f5_rom_response_l.c2` = 0
        `f5_rom_response_l.exc` = 0
        `f5_rom_response_l.mask` = 0
        `f5_rom_response_l.taylor` = 0
      } else {
        `f5_rom_response_l.c0` = 0
        `f5_rom_response_l.c2` = 0
        `f5_rom_response_l.exc` = 0
        `f5_rom_response_l.mask` = 0
        `f5_rom_response_l.taylor` = 0
      }
      `f5_rom_response_l.taylor` = f5_sin_taylor_q & 1
    }
    == vpu_pkg.TransRomSin3Id {
      `f5_rom_response_l.taylor` = f5_sin_taylor_q & 1
    }
    else {
      `f5_rom_response_l.c0` = 0
      `f5_rom_response_l.c2` = 0
      `f5_rom_response_l.exc` = 0
      `f5_rom_response_l.mask` = 0
      `f5_rom_response_l.taylor` = 0
    }
  }
  if f2_trans_valid_q != 0 {
    f3_exc_q = f2_exc_q
    f3_rom_ctrl_q = (`f2_rom_ctrl_d.cmd` << 8) | `f2_rom_ctrl_d.index`
    f3_sin_taylor_q = f2_sin_taylor_d
  }
  if f3_trans_valid_q != 0 {
    f4_exc_q = f3_exc_q
    f4_rom_ctrl_q = f3_rom_ctrl_q
    f4_sin_taylor_q = f3_sin_taylor_q
  }
  if f4_trans_valid_q != 0 {
    f5_exc_q = f4_exc_q
    f5_rom_ctrl_q = f4_rom_ctrl_q
    f5_sin_taylor_q = f4_sin_taylor_q
  }
  if f5_trans_valid_q != 0 {
    f6_exc_q = f5_exc_q
    f6_rom_response_q = (`f5_rom_response_l.exc` << 57) | (`f5_rom_response_l.mask` << 50) | (`f5_rom_response_l.taylor` << 49) | (`f5_rom_response_l.c2` << 32) | `f5_rom_response_l.c0`
  }
  if f6_trans_valid_q != 0 {
    f7_exc_q = f6_exc_q
    f7_rom_response_q = f6_rom_response_q
  }
  if f7_trans_valid_q != 0 {
    f8_exc_q = f7_exc_q
    f8_rom_response_o_q = f7_rom_response_q
  }
}
