  sm_match_debug_signals_o = sm_match_debug_signals_o__w1
  tenb_flush_o = tenb_flush_int__w1
  tenb_ready_o = tenb_ready_o__w1
  tl_op_o = l2_req_valid__w1 & l2_req_ready__w1 & 1
  tl_start_o = tl_start_o__w1
  tmp_data_q = tmp_data_q__wtmp__w15
  vm_status_tl_o.debug = `vm_status_tl_o__bpo.debug`
  vm_status_tl_o.mpp = `vm_status_tl_o__bpo.mpp`
  vm_status_tl_o.mprv = `vm_status_tl_o__bpo.mprv`
  vm_status_tl_o.mxr = `vm_status_tl_o__bpo.mxr`
  vm_status_tl_o.prv = `vm_status_tl_o__bpo.prv`
  vm_status_tl_o.sum = `vm_status_tl_o__bpo.sum`
}
