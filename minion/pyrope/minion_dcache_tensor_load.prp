  l2_req_valid_no_coop_o = l2_req_valid__w1 & (~request_control_use_coop) & 1 & 1
  load_addr_o = load_addr_o__w1
  load_capture_o = unsigned((ctrl_state_q == 4) or (ctrl_state_q == 6))
  load_data_o = shared_load_data
  load_valid_o = load_valid_o__w1
  load_valid_pre_o = unsigned((ctrl_state_d == 5) or (ctrl_state_d == 7))
  load_way_o = load_way_o__w1
  s0_addr_load_o = s0_addr_load_o__w1
  s0_thread_id_o = s0_thread_id_o__w1
