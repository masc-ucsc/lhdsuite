pub mod prim_rst_sync::[timecheck=false](clk_i:u1, rst_ni:u1, dft_i:(scanmode:u1, scan_reset_n:u1, sram_clk_override:u1, ram_rei:u1, ram_wei:u1)) -> (rst_no:u1@[]) {
  wire rst_int_ni:u1
  rst_int_ni = if dft_i.scanmode != 0 { dft_i.scan_reset_n & 1 } else { rst_ni & 1 }
  reg rst_q:u1:[init=0, reset_pin=ref rst_int_ni, async=true, negreset=true, clock_pin=ref clk_i]
  rst_no = 0ub?
  rst_q = 1
  const rst_no__w1 = if dft_i.scanmode != 0 { dft_i.scan_reset_n & 1 } else { rst_q & 1 }
  rst_no = rst_no__w1
}
