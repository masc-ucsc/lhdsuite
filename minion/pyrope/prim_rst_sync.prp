pub mod prim_rst_sync::[timecheck=false](clk_i:Clock, rst_ni:U1, dft_i:(scanmode:U1, scan_reset_n:U1, sram_clk_override:U1, ram_rei:U1, ram_wei:U1)) -> (rst_no:U1@[]) {
  reg rst_q:U1:[initial=0, reset_pin=rst_int_ni, async=true, negreset=true, clock_pin=clk_i]
  wire rst_int_ni:U1 = nil
  mut _mux_1:U1 = if dft_i.scanmode != 0 { dft_i.scan_reset_n & 1 } else { rst_ni & 1 }
  rst_int_ni = _mux_1
  if rst_int_ni != 0 {
    rst_q = 1
  }
  mut _mux_2:U1 = if dft_i.scanmode != 0 { dft_i.scan_reset_n & 1 } else { rst_q & 1 }
  rst_no = _mux_2
}
