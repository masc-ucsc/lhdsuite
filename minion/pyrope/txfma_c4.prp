  use_elxd_f4a_h = (unsigned(op_dtype_f4a_h == vpu_defs_pkg.VPU_DTYPE_F32) & (~(((sigs_f4a_h >> vpu_defs_pkg.TXFMA_CVT) & 1) | ((sigs_f4a_h >> vpu_defs_pkg.TXFMA_NORM_F32) & 1) | unsigned(cmd_f4a_h == vpu_defs_pkg.VPU_TRANS_EXP_FRAC))) & 1) | unsigned(cmd_f4a_h == vpu_defs_pkg.VPU_FCMD_CVT_F32INT) | unsigned(cmd_f4a_h == vpu_defs_pkg.VPU_FCMD_CVT_F32UINT) | unsigned(cmd_f4a_h == vpu_defs_pkg.VPU_FCMD_CVT_F32RAST) | unsigned(op_dtype_f4a_h == vpu_defs_pkg.VPU_DTYPE_F16_F32)
