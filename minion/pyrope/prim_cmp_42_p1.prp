pub comb prim_cmp_42_p1::[timecheck=false](a:u71, b:u71, c:u71, d:u71, cin:u1) -> (sv:u71, cv:u71) {
  const cout__w1 = ((a ^ b) & c) | ((~(a ^ b))#[0..=70] & a)
  cv = ((a ^ b ^ c ^ d) & (cin | (cout__w1#[0..=69] << 1))) | ((~(a ^ b ^ c ^ d))#[0..=70] & d)
  sv = a ^ b ^ c ^ d ^ (cin | (cout__w1#[0..=69] << 1))
}
