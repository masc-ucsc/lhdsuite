const trans_top = import("trans_top.trans_top")
const txfma_top = import("txfma_top.txfma_top")

pub mod vpu_txfma_trans_top::[timecheck=false](clock_txfma:u1, clock_trans_rom:u1, reset:u1, ex_rom_valid:u1, ex_in_bits:u167, ex_txfma_valid:u1) -> (f8_txfma_res:(data:u32, exc:u6)@[], f8_txfma_comp_res:u1@[], txfma_trans_dbg:u2@[]) {
  mut `f8_trans_rom_response.exc` = 0
  mut `f8_trans_rom_response.mask` = 0
  mut `f8_trans_rom_response.taylor` = 0
  mut `f8_trans_rom_response.c2` = 0
  mut `f8_trans_rom_response.c0` = 0
  mut `f8_txfma_res__bpo.data` = 0
  mut `f8_txfma_res__bpo.exc` = 0
  f8_txfma_comp_res = 0ub?
  txfma_trans_dbg = 0ub??
  mut txfma = txfma_top::[name=txfma](clock = clock_txfma, reset = reset, in_valid = ex_txfma_valid, in_data = ex_in_bits, `trans_coefficients.exc` = `f8_trans_rom_response.exc`, `trans_coefficients.mask` = `f8_trans_rom_response.mask`, `trans_coefficients.taylor` = `f8_trans_rom_response.taylor`, `trans_coefficients.c2` = `f8_trans_rom_response.c2`, `trans_coefficients.c0` = `f8_trans_rom_response.c0`)
  const t17 = (txfma["out_data_res.data"] << 6) | txfma["out_data_res.exc"]
  `f8_txfma_res__bpo.data` = t17#[6..=37]
  `f8_txfma_res__bpo.exc` = t17#[0..=5]
  mut trans = trans_top::[name=trans](clk_i = clock_trans_rom, rst_ni = (~reset) & 1, ex_valid_i = ex_rom_valid, ex_in_bits_i = ex_in_bits, ex_txfma_exc_i = `f8_txfma_res__bpo.exc`)
  const t40 = (trans["f8_rom_response_o.exc"] << 57) | (trans["f8_rom_response_o.mask"] << 50) | (trans["f8_rom_response_o.taylor"] << 49) | (trans["f8_rom_response_o.c2"] << 32) | trans["f8_rom_response_o.c0"]
  `f8_trans_rom_response.c0` = t40#[0..=31]
  `f8_trans_rom_response.c2` = t40#[32..=48]
  `f8_trans_rom_response.exc` = (t40 >> 57) & 1
  `f8_trans_rom_response.mask` = t40#[50..=56]
  `f8_trans_rom_response.taylor` = (t40 >> 49) & 1
  f8_txfma_comp_res = txfma.out_comp_res
  f8_txfma_res.data = `f8_txfma_res__bpo.data`
  f8_txfma_res.exc = `f8_txfma_res__bpo.exc`
  txfma_trans_dbg = `f8_trans_rom_response.taylor` | (`f8_trans_rom_response.exc` << 1)
}
