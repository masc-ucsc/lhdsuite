const txfma_csa = import("txfma_csa.txfma_csa")

pub mod txfma_4_2_compressor::[timecheck=false](x0_i:U1, x1_i:U1, x2_i:U1, x3_i:U1, cin_i:U1) -> (cout_o:U1@[], c_o:U1@[], s_o:U1@[]) {
  mut u_csa0 = txfma_csa::[name=u_csa0](a_i = x0_i, b_i = x1_i, cin_i = x2_i)
  mut u_csa1 = txfma_csa::[name=u_csa1](a_i = u_csa0.sum_o, b_i = x3_i, cin_i = cin_i)
  cout_o = u_csa0.cout_o & 1
  c_o = u_csa1.cout_o & 1
  s_o = u_csa1.sum_o & 1
}
