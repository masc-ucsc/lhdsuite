const vpu_defs_pkg = import("vpu_defs_pkg")

pub comb txfma_ediff_opdorder_logic::[timecheck=false](cmd:vpu_defs_pkg.VPU_FCMD_SZ_T, op_dtype:vpu_defs_pkg.VPU_DTYPE_SZ_T, sigs:vpu_defs_pkg.TXFMA_SIGS_SZ_T, sign_c_ph:u1, sign_c_pl:u1, sign_ph_pl:u1, exp_fma2_exc:u1, exp_res_2f3_f2a_h:u7) -> (align1_mux_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, align2_mux_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, opd3_mux_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, ediff1_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, ediff2_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, res_exp_hi_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, res_exp_lo_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T) {
  mut _mux_1:u5 = 0
  mut _mux_2:u5 = 0
  mut _mux_3:u5 = 0
  align1_mux_sel = 0ub?????
  align2_mux_sel = 0ub?????
  ediff1_sel = 0ub?????
  ediff2_sel = 0ub?????
  opd3_mux_sel = 0ub?????
  res_exp_hi_sel = 0ub?????
  res_exp_lo_sel = 0ub?????
  align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
  ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
  opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
  res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_C
  if ((sigs >> vpu_defs_pkg.TXFMA_F32_NORM) & 1) != 0 {
    align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
    opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_A
    ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
    res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_GCVT_F32_NORM
  }
  align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
  if op_dtype == vpu_defs_pkg.VPU_DTYPE_INT {
    if ((sigs >> vpu_defs_pkg.TXFMA_CVT) & 1) != 0 {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_A
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      res_exp_hi_sel = if cmd == vpu_defs_pkg.VPU_FCMD_CVT_F32RAST { vpu_defs_pkg.TXFMA_SEL_CVT_F32_FXP1615 } else { vpu_defs_pkg.TXFMA_SEL_CVT_F32INT }
    }
    if (((sigs >> vpu_defs_pkg.TXFMA_TRANS1) & 1) != 0) or (((sigs >> vpu_defs_pkg.TXFMA_TRANS2) & 1) != 0) or (cmd == vpu_defs_pkg.VPU_FCMD_NR1_FRCPFXP) {
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_P
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C_INT
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_P_INT
      if (cmd == vpu_defs_pkg.VPU_TRANS_EXP_FMA2) and (exp_fma2_exc != 0) {
        res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_B
        align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
        align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
        opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      }
    }
    if cmd == vpu_defs_pkg.VPU_FCMD_NR2_FRCPFXP {
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_NR2_FRCPFXP
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C_INT
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
    }
  }
  ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
  res_exp_lo_sel = vpu_defs_pkg.TXFMA_SEL_PH
  if op_dtype == vpu_defs_pkg.VPU_DTYPE_F32 {
    if ((sigs >> vpu_defs_pkg.TXFMA_CVT) & 1) != 0 {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PH
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_A
      if cmd == vpu_defs_pkg.VPU_FCMD_FROUND {
        opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_ROUND
        res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_CVT_F32INT
      }
    } elif cmd == vpu_defs_pkg.VPU_TRANS_LOG_MUL {
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_P
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
      ediff1_sel = if exp_res_2f3_f2a_h == 0 { vpu_defs_pkg.TXFMA_SEL_EDIFF_LOG_MUL2 } else { vpu_defs_pkg.TXFMA_SEL_EDIFF_LOG_MUL }
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_EXP_RES
    } elif ((sigs >> vpu_defs_pkg.TXFMA_MUL) & 1) != 0 {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PH
    } elif cmd == vpu_defs_pkg.VPU_TRANS_LOG_RR {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_C
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
    } elif (cmd == vpu_defs_pkg.VPU_FCMD_FFRC) or (cmd == vpu_defs_pkg.VPU_FCMD_FFRC_SIN) {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_A
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_C
    } elif (cmd == vpu_defs_pkg.VPU_FCMD_FLE) or (cmd == vpu_defs_pkg.VPU_FCMD_FLT) or (cmd == vpu_defs_pkg.VPU_FCMD_FEQ) {
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
    } elif cmd == vpu_defs_pkg.VPU_TRANS_EXP_FRAC {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_EXP_FRAC
      res_exp_lo_sel = vpu_defs_pkg.TXFMA_SEL_EXP_FRAC
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
    } elif cmd == vpu_defs_pkg.VPU_TRANS_SIN_TRANSFORM {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_A
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      ediff2_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PH
    } elif ((sigs >> vpu_defs_pkg.TXFMA_NORM_F32) & 1) != 0 {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_P
      align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_lo_sel = vpu_defs_pkg.TXFMA_SEL_ZERO
    } elif ((sigs >> vpu_defs_pkg.TXFMA_FX_F32) & 1) != 0 {
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PH
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_A
    } elif sign_c_ph != 0 {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      _mux_1 = if (cmd == vpu_defs_pkg.VPU_FCMD_ADD) or (cmd == vpu_defs_pkg.VPU_FCMD_SUB) { vpu_defs_pkg.TXFMA_SEL_A#[0..=4] } else { vpu_defs_pkg.TXFMA_SEL_P#[0..=4] }
      opd3_mux_sel = _mux_1
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      _mux_2 = if (cmd == vpu_defs_pkg.VPU_FCMD_ADD) or (cmd == vpu_defs_pkg.VPU_FCMD_SUB) { vpu_defs_pkg.TXFMA_SEL_A#[0..=4] } else { vpu_defs_pkg.TXFMA_SEL_P#[0..=4] }
      res_exp_hi_sel = _mux_2
    } else {
      _mux_3 = if (cmd == vpu_defs_pkg.VPU_FCMD_ADD) or (cmd == vpu_defs_pkg.VPU_FCMD_SUB) { vpu_defs_pkg.TXFMA_SEL_A#[0..=4] } else { vpu_defs_pkg.TXFMA_SEL_P#[0..=4] }
      align1_mux_sel = _mux_3
      opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_C
    }
  }
  if op_dtype == vpu_defs_pkg.VPU_DTYPE_F16_F32 {
    if ((sigs >> vpu_defs_pkg.TXFMA_MUL) & 1) != 0 {
      align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
      ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      if sign_ph_pl != 0 {
        align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
        opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
        ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL
        res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PL
      } else {
        align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
        opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
        ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL
        res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PH
      }
    } else {
      const t159 = ((sign_c_ph & 1) << 2) | ((sign_c_pl & 1) << 1) | (sign_ph_pl & 1)
      match t159 {
        == 0 {
          align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
          align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
          opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
          ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
          ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
          res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_C
        }
        == 1 {
          align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
          align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
          opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
          ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
          ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
          res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_C
        }
        == 3 {
          align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
          align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
          opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
          ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
          ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EPH_EPL
          res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PL
        }
        == 4 {
          align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
          align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
          opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
          ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPH
          ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL
          res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PH
        }
        == 6 {
          align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
          align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
          opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
          ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPH
          ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL
          res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PH
        }
        == 7 {
          align1_mux_sel = vpu_defs_pkg.TXFMA_SEL_C
          align2_mux_sel = vpu_defs_pkg.TXFMA_SEL_PH
          opd3_mux_sel = vpu_defs_pkg.TXFMA_SEL_PL
          ediff1_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPL
          ediff2_sel = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EPH_EPL
          res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_PL
        }
        else {
        }
      }
    }
  }
  if (op_dtype == vpu_defs_pkg.VPU_DTYPE_F11) or (op_dtype == vpu_defs_pkg.VPU_DTYPE_F10) or (op_dtype == vpu_defs_pkg.VPU_DTYPE_F16) {
    res_exp_hi_sel = vpu_defs_pkg.TXFMA_SEL_C
  }
}
