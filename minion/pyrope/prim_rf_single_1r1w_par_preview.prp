pub mod prim_rf_single_1r1w_par_preview<Width=64, PreviewClkSameAsRf=1>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_data_i:U64, wr_en_i:U1) -> (rd_data_o:U64@[]) {
  reg rf_q:U64:[clock_pin=rf_clk_i]
  reg wr_data_del_q:U64:[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q = wr_data_del_q
  }
  rd_data_o = rf_q
}
