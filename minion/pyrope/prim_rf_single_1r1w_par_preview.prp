const minion_dcache_pkg = import("minion_dcache_pkg")

pub mod prim_rf_single_1r1w_par_preview::[timecheck=false](preview_clk_i:u1, rf_clk_i:u1, wr_data_en_1p_next_i:u1, wr_data_i:u64, wr_en_i:u1) -> (rd_data_o:u64@[]) {
  reg rf_q:u64:[clock_pin=ref rf_clk_i]
  reg wr_data_del_q:u64:[clock_pin=ref rf_clk_i, posclk=false]
  reg wr_data_en_1p_q:u1:[latch=true]
  if preview_clk_i == 0 {
    wr_data_en_1p_q = wr_data_en_1p_next_i
  }
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q = wr_data_del_q
  }
  rd_data_o = rf_q
}
