const minion_pkg = import("minion_pkg")

pub comb intpipe_imm::[timecheck=false](inst_bits:minion_pkg.InstSize_T, sel_imm:U3) -> (imm:minion_pkg.XregSize_T) {
  wire b30_b20:U11 = nil
  wire b19_b12:U8 = nil
  wire b11:U1 = nil
  wire b10_b5:U6 = nil
  wire b4_b1:U4 = nil
  wire b0:U1 = nil
  wire sign:U1 = nil
  mut _mux_1:U1 = if sel_imm == minion_pkg.ImmZ { 0 } else { inst_bits#[31..<32] }
  sign = _mux_1
  mut _rep_2:U11 = if (sign & 1) != 0 { 0x7ff } else { 0 }
  mut _mux_3:U11 = if sel_imm == minion_pkg.ImmU { inst_bits#[20..<31] } else { _rep_2#[0..<11] }
  b30_b20 = _mux_3
  mut _rep_4:U8 = if (sign & 1) != 0 { 0xff } else { 0 }
  mut _mux_5:U8 = if (sel_imm != minion_pkg.ImmU) and (sel_imm != minion_pkg.ImmUj) { _rep_4#[0..<8] } else { inst_bits#[12..<20] }
  b19_b12 = _mux_5
  mut _mux_6:U1 = if sel_imm == minion_pkg.ImmSb { inst_bits#[7..<8] } else { sign & 1 }
  mut _mux_7:U1 = if sel_imm == minion_pkg.ImmUj { inst_bits#[20..<21] } else { _mux_6 & 1 }
  mut _mux_8:U1 = if (sel_imm == minion_pkg.ImmU) or (sel_imm == minion_pkg.ImmZ) { 0 } else { _mux_7 & 1 }
  b11 = _mux_8
  mut _mux_9:U6 = if (sel_imm == minion_pkg.ImmU) or (sel_imm == minion_pkg.ImmZ) { 0 } else { inst_bits#[25..<31] }
  b10_b5 = _mux_9
  mut _mux_10:U4 = if sel_imm == minion_pkg.ImmZ { inst_bits#[16..<20] } else { inst_bits#[21..<25] }
  mut _mux_11:U4 = if (sel_imm == minion_pkg.ImmS) or (sel_imm == minion_pkg.ImmSb) { inst_bits#[8..<12] } else { _mux_10#[0..<4] }
  mut _mux_12:U4 = if sel_imm == minion_pkg.ImmU { 0 } else { _mux_11#[0..<4] }
  b4_b1 = _mux_12
  mut _mux_13:U1 = if sel_imm == minion_pkg.ImmZ { inst_bits#[15..<16] } else { 0 }
  mut _mux_14:U1 = if sel_imm == minion_pkg.ImmI { inst_bits#[20..<21] } else { _mux_13 & 1 }
  mut _mux_15:U1 = if sel_imm == minion_pkg.ImmS { inst_bits#[7..<8] } else { _mux_14 & 1 }
  b0 = _mux_15
  mut _rep_16:U33 = if (sign & 1) != 0 { 0x1ffffffff } else { 0 }
  imm = (_rep_16#[0..<33] << 31) | (b30_b20#[0..<11] << 20) | (b19_b12#[0..<8] << 12) | ((b11 & 1) << 11) | (b10_b5#[0..<6] << 5) | (b4_b1#[0..<4] << 1) | (b0 & 1)
}
