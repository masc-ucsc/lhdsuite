const minion_pkg = import("minion_pkg")

pub comb intpipe_imm::[timecheck=false](inst_bits:minion_pkg.InstSize_T, sel_imm:u3) -> (imm:minion_pkg.XregSize_T) {
  mut _mux_1:u1 = if sel_imm == minion_pkg.ImmZ { 0 } else { (inst_bits >> 31) & 1 & 1 }
  const sign__w1 = _mux_1
  const t9 = (sign__w1 & 1)
  mut _mux_2:u11 = if sel_imm == minion_pkg.ImmU { inst_bits#[20..=30]#[0..=10] } else { (t9 | (t9 << 1) | (t9 << 2) | (t9 << 3) | (t9 << 4) | (t9 << 5) | (t9 << 6) | (t9 << 7) | (t9 << 8) | (t9 << 9) | (t9 << 10))#[0..=10] }
  const t34 = (sign__w1 & 1)
  mut _mux_3:u8 = if (sel_imm != minion_pkg.ImmU) and (sel_imm != minion_pkg.ImmUj) { (t34 | (t34 << 1) | (t34 << 2) | (t34 << 3) | (t34 << 4) | (t34 << 5) | (t34 << 6) | (t34 << 7))#[0..=7] } else { inst_bits#[12..=19]#[0..=7] }
  mut _mux_4:u1 = if sel_imm == minion_pkg.ImmSb { (inst_bits >> 7) & 1 & 1 } else { sign__w1 & 1 }
  mut _mux_5:u1 = if sel_imm == minion_pkg.ImmUj { (inst_bits >> 20) & 1 & 1 } else { _mux_4 & 1 }
  mut _mux_6:u1 = if (sel_imm == minion_pkg.ImmU) or (sel_imm == minion_pkg.ImmZ) { 0 } else { _mux_5 & 1 }
  mut _mux_7:u6 = if (sel_imm == minion_pkg.ImmU) or (sel_imm == minion_pkg.ImmZ) { 0 } else { inst_bits#[25..=30]#[0..=5] }
  mut _mux_8:u4 = if sel_imm == minion_pkg.ImmZ { inst_bits#[16..=19]#[0..=3] } else { inst_bits#[21..=24]#[0..=3] }
  mut _mux_9:u4 = if (sel_imm == minion_pkg.ImmS) or (sel_imm == minion_pkg.ImmSb) { inst_bits#[8..=11]#[0..=3] } else { _mux_8#[0..=3] }
  mut _mux_10:u4 = if sel_imm == minion_pkg.ImmU { 0 } else { _mux_9#[0..=3] }
  mut _mux_11:u1 = if sel_imm == minion_pkg.ImmZ { (inst_bits >> 15) & 1 & 1 } else { 0 }
  mut _mux_12:u1 = if sel_imm == minion_pkg.ImmI { (inst_bits >> 20) & 1 & 1 } else { _mux_11 & 1 }
  mut _mux_13:u1 = if sel_imm == minion_pkg.ImmS { (inst_bits >> 7) & 1 & 1 } else { _mux_12 & 1 }
  const t102 = (sign__w1 & 1)
  const t166 = t102 | (t102 << 1) | (t102 << 2) | (t102 << 3) | (t102 << 4) | (t102 << 5) | (t102 << 6) | (t102 << 7) | (t102 << 8) | (t102 << 9) | (t102 << 10) | (t102 << 11) | (t102 << 12) | (t102 << 13) | (t102 << 14) | (t102 << 15) | (t102 << 16) | (t102 << 17) | (t102 << 18) | (t102 << 19) | (t102 << 20) | (t102 << 21) | (t102 << 22) | (t102 << 23) | (t102 << 24) | (t102 << 25) | (t102 << 26) | (t102 << 27) | (t102 << 28) | (t102 << 29) | (t102 << 30) | (t102 << 31) | (t102 << 32)
  const t167 = ((t166 & 8589934591) << 31) | ((_mux_2 & 2047) << 20) | ((_mux_3 & 255) << 12) | ((_mux_6 & 1) << 11) | ((_mux_7 & 63) << 5) | ((_mux_10 & 15) << 1) | (_mux_13 & 1)
  const imm__w1 = t167
  imm = imm__w1
}
