const minion_pkg = import("minion_pkg")

pub comb intpipe_imm::[timecheck=false](inst_bits:minion_pkg.InstSize_T, sel_imm:u3) -> (imm:minion_pkg.XregSize_T) {
  mut _mux_1:u1 = if sel_imm == minion_pkg.ImmZ { 0 } else { (inst_bits >> 31) & 1 }
  const sign__w1 = _mux_1
  mut _rep_2:u11 = if (sign__w1 & 1) != 0 { 0x7ff } else { 0 }
  mut _mux_3:u11 = if sel_imm == minion_pkg.ImmU { inst_bits#[20..=30] } else { _rep_2 }
  mut _rep_4:u8 = if (sign__w1 & 1) != 0 { 0xff } else { 0 }
  mut _mux_5:u8 = if (sel_imm != minion_pkg.ImmU) and (sel_imm != minion_pkg.ImmUj) { _rep_4 } else { inst_bits#[12..=19] }
  mut _mux_6:u1 = if sel_imm == minion_pkg.ImmSb { (inst_bits >> 7) & 1 } else { sign__w1 & 1 }
  mut _mux_7:u1 = if sel_imm == minion_pkg.ImmUj { (inst_bits >> 20) & 1 } else { _mux_6 & 1 }
  mut _mux_8:u1 = if (sel_imm == minion_pkg.ImmU) or (sel_imm == minion_pkg.ImmZ) { 0 } else { _mux_7 & 1 }
  mut _mux_9:u6 = if (sel_imm == minion_pkg.ImmU) or (sel_imm == minion_pkg.ImmZ) { 0 } else { inst_bits#[25..=30] }
  mut _mux_10:u4 = if sel_imm == minion_pkg.ImmZ { inst_bits#[16..=19] } else { inst_bits#[21..=24] }
  mut _mux_11:u4 = if (sel_imm == minion_pkg.ImmS) or (sel_imm == minion_pkg.ImmSb) { inst_bits#[8..=11] } else { _mux_10 }
  mut _mux_12:u4 = if sel_imm == minion_pkg.ImmU { 0 } else { _mux_11 }
  mut _mux_13:u1 = if sel_imm == minion_pkg.ImmZ { (inst_bits >> 15) & 1 } else { 0 }
  mut _mux_14:u1 = if sel_imm == minion_pkg.ImmI { (inst_bits >> 20) & 1 } else { _mux_13 & 1 }
  mut _mux_15:u1 = if sel_imm == minion_pkg.ImmS { (inst_bits >> 7) & 1 } else { _mux_14 & 1 }
  mut _rep_16:u33 = if (sign__w1 & 1) != 0 { 0x1ffffffff } else { 0 }
  imm = (_rep_16 << 31) | (_mux_3 << 20) | (_mux_5 << 12) | ((_mux_8 & 1) << 11) | (_mux_9 << 5) | (_mux_12 << 1) | (_mux_15 & 1)
}
