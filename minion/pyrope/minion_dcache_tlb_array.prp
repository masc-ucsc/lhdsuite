pub mod minion_dcache_tlb_array::[timecheck=false](clk_i:u1, rst_ni:u1, dft_i:(scanmode:u1, scan_reset_n:u1, sram_clk_override:u1, ram_rei:u1, ram_wei:u1), esr_vmspagesize_i:u2, req_data_i:(status:(prv:u2, mprv:u1, mpp:u2, sum:u1, mxr:u1, debug:u1), vpn:u36, passthrough:u1, store:u1, msb_err:u1), req_valid_i:u1, satp_info_i:(mode:u4, ppn:u28), matp_info_i:(mode:u4, ppn:u28), satp_info_en_i:u1, matp_info_en_i:u1, tlb_invalidate_i:u1, ptw_req_ready_i:u1, ptw_resp_data_i:(canceled_req:u1, access_fault:u1, rsvd_for_hw:u8, ppn:u44, rsvd_for_sw:u2, d:u1, a:u1, g:u1, u:u1, x:u1, w:u1, r:u1, v:u1), ptw_resp_valid_i:u1) -> (resp_data_o:(fill_pending:u1, miss:u1, ppn:u28, xcpt_ld:u1, xcpt_st:u1, access_fault:u1)@[], ptw_req_data_o:(satp_mode:u4, satp_ppn:u28, prv:u2, addr:u36)@[], ptw_req_valid_o:u1@[], vm_enabled_o:u1@[]) {
