const prim_rf_2r1w_preview = import("prim_rf_2r1w_preview.prim_rf_2r1w_preview")
const minion_pkg = import("minion_pkg")

pub mod intpipe_rf::[timecheck=false](clk_i:u1, rd_en:u2, rd_thread_id:u1, rd_addr:u10, wr_en:u1, wr_en_early:u1, wr_thread_id:u1, wr_addr:u5, wr_data:u64) -> (rd_data:u128@[], wb_x31_reg:u128@[]) {
  rd_data = 0sb?
  mut u_rf = prim_rf_2r1w_preview::[name=u_rf](preview_clk_i = clk_i, rf_clk_i = clk_i, rd_addr_a_i = ((rd_thread_id & 1) << 5) | rd_addr#[0..=4], rd_addr_b_i = ((rd_thread_id & 1) << 5) | rd_addr#[5..=9], wr_en_i = wr_en & 1, wr_data_en_1p_next_i = wr_en_early & 1, wr_addr_i = ((wr_thread_id & 1) << 5) | wr_addr, wr_data_i = wr_data)
  mut rd_data__w1 = rd_data
  rd_data__w1#[0..=63] = u_rf.rd_data_a_o#[0..=63]
  mut rd_data__w2 = rd_data__w1
  rd_data__w2#[64..=127] = u_rf.rd_data_b_o#[0..=63]
  rd_data = rd_data__w2
  wb_x31_reg = u_rf.rd_par_o
}
