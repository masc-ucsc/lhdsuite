pub mod prim_rf_1r1w_diff_preview::[timecheck=false](preview_clk_i:u1, rf_clk_i:u1, wr_data_en_1p_next_i:u8, rd_addr_i:u5, wr_data_i:u256, wr_addr_i:u1, wr_en_i:u8) -> (rd_data_o:u32@[]) {
