pub mod prim_rf_1r1w_par_preview_p1<Width=54, Depth=8, PreviewClkSameAsRf=1>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_data_i:U54, wr_addr_i:U3, wr_en_i:U1) -> (rd_data_o:U432@[]) {
  reg rf_q:[8]U54:[ordering="old", __store_clock_pin=rf_clk_i, __store_posclk=true]
  reg wr_data_del_q:U54:[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q[wr_addr_i] = wr_data_del_q
  }
  mut rd_data_o__w2 = 0
  rd_data_o__w2#[0..<54] = rf_q[0]
  mut rd_data_o__w3 = rd_data_o__w2
  rd_data_o__w3#[54..<0x6c] = rf_q[1]
  mut rd_data_o__w4 = rd_data_o__w3
  rd_data_o__w4#[0x6c..<0xa2] = rf_q[2]
  mut rd_data_o__w5 = rd_data_o__w4
  rd_data_o__w5#[0xa2..<0xd8] = rf_q[3]
  mut rd_data_o__w6 = rd_data_o__w5
  rd_data_o__w6#[0xd8..<0x10e] = rf_q[4]
  mut rd_data_o__w7 = rd_data_o__w6
  rd_data_o__w7#[0x10e..<0x144] = rf_q[5]
  mut rd_data_o__w8 = rd_data_o__w7
  rd_data_o__w8#[0x144..<0x17a] = rf_q[6]
  mut rd_data_o__w9 = rd_data_o__w8
  rd_data_o__w9#[0x17a..<0x1b0] = rf_q[7]
  rd_data_o = rd_data_o__w9
}
