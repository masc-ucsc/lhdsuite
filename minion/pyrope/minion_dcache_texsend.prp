  const t75 = t73 ^ (t73 >> 2)
  const t99 = (l2_resp_i.id << 0x10b) | (l2_resp_i.dest << 0x10a) | (l2_resp_i.wdata << 0x109) | (l2_resp_i.opcode << 0x107) | (l2_resp_i.data << 7) | (l2_resp_i.size << 4) | l2_resp_i.qwen
  const t101 = t99 ^ (t99 >> 32)
  const t103 = t101 ^ (t101 >> 16)
