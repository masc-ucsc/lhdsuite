  const t48 = neigh_min_id_i ^ (neigh_min_id_i >> 2)
  const t69 = (tex_send_ctrl_i.port_id << 11) | (tex_send_ctrl_i.size << 8) | (tex_send_ctrl_i.way << 6) | (tex_send_ctrl_i.set << 2) | (tex_send_ctrl_i.port_en << 1) | tex_send_ctrl_i.thread_id
  const t71 = t69 ^ (t69 >> 8)
