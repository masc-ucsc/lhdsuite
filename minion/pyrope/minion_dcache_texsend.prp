pub comb minion_dcache_texsend::[timecheck=false](clk_i:u1, rst_ni:u1, neigh_min_id_i:u3, chicken_bit_dcache_i:u1, tex_send_valid_i:u1, tex_send_ctrl_i:(port_id:u2, size:u3, way:u2, set:u4, port_en:u1, thread_id:u1), l2_resp_valid_i:u1, l2_resp_i:(id:u8, dest:u1, wdata:u1, opcode:u2, data:u256, size:u3, qwen:u4), l2_req_ready_i:u1, writeback_ready_i:u1, writeback_done_i:u1) -> (idle_o:u1, tex_send_ready_o:u1, l2_req_valid_o:u1, l2_req_o:(id:u5, source:u1, wdata:u1, opcode:u5, address:u40, data:u20, size:u3, qwen:u4, subopcode:u7), writeback_valid_o:u1, writeback_req_o:(tag:u33, set:u4, way_en:u4, is_tbox:u1, mem_idx:u1, addr_low:u7), csr_debug_signals_o:u2) {
