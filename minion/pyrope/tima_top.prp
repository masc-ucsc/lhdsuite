const tima_adder = import("tima_adder.tima_adder")
const minion_pkg = import("minion_pkg")

pub mod tima_top::[timecheck=false](clk_i:u1, f1_mul_en_i:u1, f1_in1_i:minion_pkg.VpuDataSSz_T, f1_in2_i:minion_pkg.VpuDataSSz_T, f1_in1_signed_i:u1, f1_in2_signed_i:u1, f2_in3_i:minion_pkg.VpuDataSSz_T, f2_zap_opd3_i:u1, f2_tima_en_i:u1, f2_in3_en_i:u1) -> (f3_out_o:minion_pkg.VpuDataSSz_T@[]) {
  reg f2_in1_q:u32:[clock_pin=ref clk_i]
  reg f2_in2_q:u32:[clock_pin=ref clk_i]
  reg f2_in1_sign_q:u4:[clock_pin=ref clk_i]
  reg f2_in2_sign_q:u4:[clock_pin=ref clk_i]
  reg f3_prod_add_q:s19:[clock_pin=ref clk_i]
  reg f3_in3_q:u32:[clock_pin=ref clk_i]
  reg f3_zap_opd3_q:u1:[clock_pin=ref clk_i]
  mut f1_in1_sign:u4 = 0
  mut f1_in2_sign:u4 = 0
  mut f2_in1_part:u36 = 0
  mut f2_in2_part:u36 = 0
  f1_in1_sign = 0sb?
  mut f1_in1_sign__w1 = f1_in1_sign
  f1_in1_sign__w1#[0] = unsigned((f1_in1_signed_i != 0) and (((f1_in1_i >> 7) & 1) != 0)) & 1
  f1_in2_sign = 0sb?
  mut f1_in2_sign__w1 = f1_in2_sign
  f1_in2_sign__w1#[0] = unsigned((f1_in2_signed_i != 0) and (((f1_in2_i >> 7) & 1) != 0)) & 1
  f2_in1_part = 0sb?
  mut f2_in1_part__w1 = f2_in1_part
  f2_in1_part__w1#[0..=8] = ((f2_in1_sign_q & 1) << 8) | f2_in1_q#[0..=7]
  f2_in2_part = 0sb?
  mut f2_in2_part__w1 = f2_in2_part
  f2_in2_part__w1#[0..=8] = ((f2_in2_sign_q & 1) << 8) | f2_in2_q#[0..=7]
  mut f2_prod = 0sb?
  mut f2_prod__w1 = f2_prod
  f2_prod__w1#[0..=17] = (f2_in1_part__w1#[0..=8]#sext[0..=8] * f2_in2_part__w1#[0..=8]#sext[0..=8])#[0..=17]#sext[0..=17]#[0..=17]
  mut f1_in1_sign__w2 = f1_in1_sign__w1
  f1_in1_sign__w2#[1] = unsigned((f1_in1_signed_i != 0) and (((f1_in1_i >> 15) & 1) != 0)) & 1
  mut f1_in2_sign__w2 = f1_in2_sign__w1
  f1_in2_sign__w2#[1] = unsigned((f1_in2_signed_i != 0) and (((f1_in2_i >> 15) & 1) != 0)) & 1
  mut f2_in1_part__w2 = f2_in1_part__w1
  f2_in1_part__w2#[9..=17] = (((f2_in1_sign_q >> 1) & 1) << 8) | f2_in1_q#[8..=15]
  mut f2_in2_part__w2 = f2_in2_part__w1
  f2_in2_part__w2#[9..=17] = (((f2_in2_sign_q >> 1) & 1) << 8) | f2_in2_q#[8..=15]
  mut f2_prod__w2 = f2_prod__w1
  f2_prod__w2#[18..=35] = (f2_in1_part__w2#[9..=17]#sext[0..=8] * f2_in2_part__w2#[9..=17]#sext[0..=8])#[0..=17]#sext[0..=17]#[0..=17]
  mut f1_in1_sign__w3 = f1_in1_sign__w2
  f1_in1_sign__w3#[2] = unsigned((f1_in1_signed_i != 0) and (((f1_in1_i >> 23) & 1) != 0)) & 1
  mut f1_in2_sign__w3 = f1_in2_sign__w2
  f1_in2_sign__w3#[2] = unsigned((f1_in2_signed_i != 0) and (((f1_in2_i >> 23) & 1) != 0)) & 1
  mut f2_in1_part__w3 = f2_in1_part__w2
  f2_in1_part__w3#[18..=26] = (((f2_in1_sign_q >> 2) & 1) << 8) | f2_in1_q#[16..=23]
  mut f2_in2_part__w3 = f2_in2_part__w2
  f2_in2_part__w3#[18..=26] = (((f2_in2_sign_q >> 2) & 1) << 8) | f2_in2_q#[16..=23]
  mut f2_prod__w3 = f2_prod__w2
  f2_prod__w3#[36..=53] = (f2_in1_part__w3#[18..=26]#sext[0..=8] * f2_in2_part__w3#[18..=26]#sext[0..=8])#[0..=17]#sext[0..=17]#[0..=17]
  mut f1_in1_sign__w4 = f1_in1_sign__w3
  f1_in1_sign__w4#[3] = unsigned((f1_in1_signed_i != 0) and (((f1_in1_i >> 31) & 1) != 0)) & 1
  mut f1_in2_sign__w4 = f1_in2_sign__w3
  f1_in2_sign__w4#[3] = unsigned((f1_in2_signed_i != 0) and (((f1_in2_i >> 31) & 1) != 0)) & 1
  mut f2_in1_part__w4 = f2_in1_part__w3
  f2_in1_part__w4#[27..=35] = (((f2_in1_sign_q >> 3) & 1) << 8) | f2_in1_q#[24..=31]
  mut f2_in2_part__w4 = f2_in2_part__w3
  f2_in2_part__w4#[27..=35] = (((f2_in2_sign_q >> 3) & 1) << 8) | f2_in2_q#[24..=31]
  mut f2_prod__w4 = f2_prod__w3
  f2_prod__w4#[54..=71] = (f2_in1_part__w4#[27..=35]#sext[0..=8] * f2_in2_part__w4#[27..=35]#sext[0..=8])#[0..=17]#sext[0..=17]#[0..=17]
  const t141 = ((((0 + f2_prod__w4#[0..=71]#[0..=17]#sext[0..=17]#[0..=18])#[0..=18]#sext[0..=18]#[0..=18] + f2_prod__w4#[0..=71]#[18..=35]#sext[0..=17]#[0..=18])#[0..=18]#sext[0..=18]#[0..=18] + f2_prod__w4#[0..=71]#[36..=53]#sext[0..=17]#[0..=18])#[0..=18]#sext[0..=18]#[0..=18] + f2_prod__w4#[0..=71]#[54..=71]#sext[0..=17]#[0..=18])#[0..=18]
  const t142 = t141#sext[0..=18]
  const f2_prod_add__w5 = t142
  if f1_mul_en_i != 0 {
    f2_in1_q#[0..=7] = f1_in1_i#[0..=7]
    f2_in2_q#[0..=7] = f1_in2_i#[0..=7]
    f2_in1_sign_q#[0] = f1_in1_sign__w4 & 1
    f2_in2_sign_q#[0] = f1_in2_sign__w4 & 1
    f2_in1_q#[8..=15] = f1_in1_i#[8..=15]
    f2_in2_q#[8..=15] = f1_in2_i#[8..=15]
    f2_in1_sign_q#[1] = (f1_in1_sign__w4 >> 1) & 1
    f2_in2_sign_q#[1] = (f1_in2_sign__w4 >> 1) & 1
    f2_in1_q#[16..=23] = f1_in1_i#[16..=23]
    f2_in2_q#[16..=23] = f1_in2_i#[16..=23]
    f2_in1_sign_q#[2] = (f1_in1_sign__w4 >> 2) & 1
    f2_in2_sign_q#[2] = (f1_in2_sign__w4 >> 2) & 1
    f2_in1_q#[24..=31] = f1_in1_i#[24..=31]
    f2_in1_sign_q#[3] = (f1_in1_sign__w4 >> 3) & 1
    f2_in2_q#[24..=31] = f1_in2_i#[24..=31]
    f2_in2_sign_q#[3] = (f1_in2_sign__w4 >> 3) & 1
  }
  if f2_tima_en_i != 0 {
    f3_prod_add_q = f2_prod_add__w5
  }
  if f2_in3_en_i != 0 {
    f3_in3_q = f2_in3_i
  }
  f3_zap_opd3_q = f2_zap_opd3_i
  mut _rep_9:u32 = if (f3_zap_opd3_q & 1) != 0 { 0xffffffff } else { 0 }
  mut u_comb_adder = tima_adder::[name=u_comb_adder](a_i = f3_prod_add_q#[0..=18]#sext[0..=18]#[0..=31], b_i = _rep_9 & f3_in3_q)
  f3_out_o = u_comb_adder
}
