const tima_adder = import("tima_adder.tima_adder")
const minion_pkg = import("minion_pkg")

pub mod tima_top::[timecheck=false](clk_i:Clock, f1_mul_en_i:U1, f1_in1_i:minion_pkg.VpuDataSSz_T, f1_in2_i:minion_pkg.VpuDataSSz_T, f1_in1_signed_i:U1, f1_in2_signed_i:U1, f2_in3_i:minion_pkg.VpuDataSSz_T, f2_zap_opd3_i:U1, f2_tima_en_i:U1, f2_in3_en_i:U1) -> (f3_out_o:minion_pkg.VpuDataSSz_T@[]) {
  reg f2_in1_q:U32:[clock_pin=clk_i]
  reg f2_in2_q:U32:[clock_pin=clk_i]
  reg f2_in1_sign_q:U4:[clock_pin=clk_i]
  reg f2_in2_sign_q:U4:[clock_pin=clk_i]
  reg f3_prod_add_q:S19:[clock_pin=clk_i]
  reg f3_in3_q:U32:[clock_pin=clk_i]
  reg f3_zap_opd3_q:U1:[clock_pin=clk_i]
  mut f1_in1_sign:U4 = 0
  mut f1_in2_sign:U4 = 0
  mut f2_in1_part:U36 = 0
  mut f2_in2_part:U36 = 0
  f1_in1_sign = 0sb?
  f1_in2_sign = 0sb?
  f2_in1_part = 0sb?
  f2_in2_part = 0sb?
  mut f2_prod = 0sb?
  mut f1_in1_sign__w1 = f1_in1_sign
  f1_in1_sign__w1#[0..<1] = U1((f1_in1_signed_i != 0) and (((f1_in1_i >> 7) & 1) != 0)) & 1
  mut f1_in2_sign__w1 = f1_in2_sign
  f1_in2_sign__w1#[0..<1] = U1((f1_in2_signed_i != 0) and (((f1_in2_i >> 7) & 1) != 0)) & 1
  mut f2_in1_part__w1 = f2_in1_part
  f2_in1_part__w1#[0..<9] = ((f2_in1_sign_q & 1) << 8) | (f2_in1_q >> 0)#[0..<8]
  mut f2_in2_part__w1 = f2_in2_part
  f2_in2_part__w1#[0..<9] = ((f2_in2_sign_q & 1) << 8) | (f2_in2_q >> 0)#[0..<8]
  mut f2_prod__w1 = f2_prod
  f2_prod__w1#[0..<18] = (f2_in1_part__w1#[0..<9]#sext[0..=8] * f2_in2_part__w1#[0..<9]#sext[0..=8])#[0..<18]#sext[0..=17]#[0..<18]
  mut f1_in1_sign__w2 = f1_in1_sign__w1
  f1_in1_sign__w2#[1..<2] = U1((f1_in1_signed_i != 0) and (((f1_in1_i >> 15) & 1) != 0)) & 1
  mut f1_in2_sign__w2 = f1_in2_sign__w1
  f1_in2_sign__w2#[1..<2] = U1((f1_in2_signed_i != 0) and (((f1_in2_i >> 15) & 1) != 0)) & 1
  mut f2_in1_part__w2 = f2_in1_part__w1
  f2_in1_part__w2#[9..<18] = (f2_in1_sign_q#[1..<2] << 8) | (f2_in1_q >> 8)#[0..<8]
  mut f2_in2_part__w2 = f2_in2_part__w1
  f2_in2_part__w2#[9..<18] = (f2_in2_sign_q#[1..<2] << 8) | (f2_in2_q >> 8)#[0..<8]
  mut f2_prod__w2 = f2_prod__w1
  f2_prod__w2#[18..<36] = (f2_in1_part__w2#[9..<18]#sext[0..=8] * f2_in2_part__w2#[9..<18]#sext[0..=8])#[0..<18]#sext[0..=17]#[0..<18]
  mut f1_in1_sign__w3 = f1_in1_sign__w2
  f1_in1_sign__w3#[2..<3] = U1((f1_in1_signed_i != 0) and (((f1_in1_i >> 23) & 1) != 0)) & 1
  mut f1_in2_sign__w3 = f1_in2_sign__w2
  f1_in2_sign__w3#[2..<3] = U1((f1_in2_signed_i != 0) and (((f1_in2_i >> 23) & 1) != 0)) & 1
  mut f2_in1_part__w3 = f2_in1_part__w2
  f2_in1_part__w3#[18..<27] = (f2_in1_sign_q#[2..<3] << 8) | (f2_in1_q >> 16)#[0..<8]
  mut f2_in2_part__w3 = f2_in2_part__w2
  f2_in2_part__w3#[18..<27] = (f2_in2_sign_q#[2..<3] << 8) | (f2_in2_q >> 16)#[0..<8]
  mut f2_prod__w3 = f2_prod__w2
  f2_prod__w3#[36..<54] = (f2_in1_part__w3#[18..<27]#sext[0..=8] * f2_in2_part__w3#[18..<27]#sext[0..=8])#[0..<18]#sext[0..=17]#[0..<18]
  mut f1_in1_sign__w4 = f1_in1_sign__w3
  f1_in1_sign__w4#[3..<4] = U1((f1_in1_signed_i != 0) and (((f1_in1_i >> 31) & 1) != 0)) & 1
  mut f1_in2_sign__w4 = f1_in2_sign__w3
  f1_in2_sign__w4#[3..<4] = U1((f1_in2_signed_i != 0) and (((f1_in2_i >> 31) & 1) != 0)) & 1
  mut f2_in1_part__w4 = f2_in1_part__w3
  f2_in1_part__w4#[27..<36] = (f2_in1_sign_q#[3..<4] << 8) | (f2_in1_q >> 24)#[0..<8]
  mut f2_in2_part__w4 = f2_in2_part__w3
  f2_in2_part__w4#[27..<36] = (f2_in2_sign_q#[3..<4] << 8) | (f2_in2_q >> 24)#[0..<8]
  mut f2_prod__w4 = f2_prod__w3
  f2_prod__w4#[54..<0x48] = (f2_in1_part__w4#[27..<36]#sext[0..=8] * f2_in2_part__w4#[27..<36]#sext[0..=8])#[0..<18]#sext[0..=17]#[0..<18]
  const t202 = (((0 + f2_prod__w4#[0..<0x48]#[0..<18]#sext[0..=17]#[0..<19])#[0..<19]#sext[0..=18]#[0..<19] + f2_prod__w4#[0..<0x48]#[18..<36]#sext[0..=17]#[0..<19])#[0..<19]#sext[0..=18]#[0..<19] + f2_prod__w4#[0..<0x48]#[36..<54]#sext[0..=17]#[0..<19])#[0..<19]#sext[0..=18]#[0..<19] + f2_prod__w4#[0..<0x48]#[54..<0x48]#sext[0..=17]#[0..<19]
  const t203 = t202#[0..<19]
  const t204 = t203#sext[0..=18]
  const f2_prod_add__w5 = t204
  if f1_mul_en_i != 0 {
    f2_in1_q#[0..<8] = (f1_in1_i >> 0)#[0..<8]
    f2_in2_q#[0..<8] = (f1_in2_i >> 0)#[0..<8]
    f2_in1_sign_q#[0..<1] = f1_in1_sign__w4 & 1
    f2_in2_sign_q#[0..<1] = f1_in2_sign__w4 & 1
    f2_in1_q#[8..<16] = (f1_in1_i >> 8)#[0..<8]
    f2_in2_q#[8..<16] = (f1_in2_i >> 8)#[0..<8]
    f2_in1_sign_q#[1..<2] = f1_in1_sign__w4#[1..<2]
    f2_in2_sign_q#[1..<2] = f1_in2_sign__w4#[1..<2]
    f2_in1_q#[16..<24] = (f1_in1_i >> 16)#[0..<8]
    f2_in2_q#[16..<24] = (f1_in2_i >> 16)#[0..<8]
    f2_in1_sign_q#[2..<3] = f1_in1_sign__w4#[2..<3]
    f2_in2_sign_q#[2..<3] = f1_in2_sign__w4#[2..<3]
    f2_in1_q#[24..<32] = (f1_in1_i >> 24)#[0..<8]
    f2_in2_q#[24..<32] = (f1_in2_i >> 24)#[0..<8]
    f2_in1_sign_q#[3..<4] = f1_in1_sign__w4#[3..<4]
    f2_in2_sign_q#[3..<4] = f1_in2_sign__w4#[3..<4]
  }
  if f2_tima_en_i != 0 {
    f3_prod_add_q = f2_prod_add__w5
  }
  if f2_in3_en_i != 0 {
    f3_in3_q = f2_in3_i
  }
  f3_zap_opd3_q = f2_zap_opd3_i
  mut _rep_9:U32 = if (f3_zap_opd3_q & 1) != 0 { 0xffffffff } else { 0 }
  mut u_comb_adder = tima_adder::[name=u_comb_adder](a_i = f3_prod_add_q#[0..<19]#sext[0..=18]#[0..<32], b_i = (_rep_9 & f3_in3_q)#[0..<32])
  f3_out_o = u_comb_adder
}
