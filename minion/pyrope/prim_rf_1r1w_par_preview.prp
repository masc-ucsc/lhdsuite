pub mod prim_rf_1r1w_par_preview<Width=76, Depth=8, PreviewClkSameAsRf=1>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_data_i:U76, wr_addr_i:U3, wr_en_i:U1) -> (rd_data_o:U608@[]) {
  reg rf_q:[8]U76:[ordering="old", __store_clock_pin=rf_clk_i, __store_posclk=true]
  reg wr_data_del_q:U76:[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q[wr_addr_i] = wr_data_del_q
  }
  mut rd_data_o__w2 = 0
  rd_data_o__w2#[0..<0x4c] = rf_q[0]
  mut rd_data_o__w3 = rd_data_o__w2
  rd_data_o__w3#[0x4c..<0x98] = rf_q[1]
  mut rd_data_o__w4 = rd_data_o__w3
  rd_data_o__w4#[0x98..<0xe4] = rf_q[2]
  mut rd_data_o__w5 = rd_data_o__w4
  rd_data_o__w5#[0xe4..<0x130] = rf_q[3]
  mut rd_data_o__w6 = rd_data_o__w5
  rd_data_o__w6#[0x130..<0x17c] = rf_q[4]
  mut rd_data_o__w7 = rd_data_o__w6
  rd_data_o__w7#[0x17c..<0x1c8] = rf_q[5]
  mut rd_data_o__w8 = rd_data_o__w7
  rd_data_o__w8#[0x1c8..<0x214] = rf_q[6]
  mut rd_data_o__w9 = rd_data_o__w8
  rd_data_o__w9#[0x214..<0x260] = rf_q[7]
  rd_data_o = rd_data_o__w9
}
