  if conv_row_pos__w1 >= tensorconv_size_data.row_size#[0..=15] {
    conv_pass_result = 0
  }
  const conv_bits_ready__w1 = compute_done_q
  compute_done_d = compute_done_q
  if trigger__w1 != 0 {
    compute_done_d = 0
  } elif conv_idx == 15 {
    compute_done_d = 1
  }
  const clk_en__w1 = unsigned((trigger__w1 != 0) or (compute_done_q == 0) or (pending_q != 0))
  mut _mux_4:u1 = if conv_save_mask != 0 { 0 } else { conv_save_mask & 1 }
  mut _mux_5:u1 = if (compute_done_d != 0) and (compute_done_q == 0) { 1 } else { _mux_4 & 1 }
  if clk_en__w1 != 0 {
    conv_bits = ((conv_bits & (~(1 << conv_idx))) | ((conv_pass_result & 1) << conv_idx))#[0..=15]
    conv_col_offset = conv_col_offset_d
    conv_idx = conv_idx_d
    conv_row_offset = conv_row_offset_d
