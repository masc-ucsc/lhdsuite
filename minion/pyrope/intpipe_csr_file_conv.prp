pub mod intpipe_csr_file_conv::[timecheck=false](clk_i:u1, rst_ni:u1, tensorconv_size_data:(row_step_offset:u8, padding2:u8, row_size:u16, col_step_offset:u8, padding1:u8, col_size:u16), tensorconv_ctrl_data:(row_pos:u16, padding1:u16, col_pos:u16), tensorconv_size_wen:u1, tensorconv_ctrl_wen:u1, tensorload_wen:u1, tensorfma_wen:u1, cacheop_wen:u1) -> (can_accept_new_write:u1@[], conv_save_mask:u1@[], conv_bits_ready:u1@[], conv_bits:u16@[]) {
  reg conv_save_mask:u1:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
