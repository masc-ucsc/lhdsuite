  mut conv_col_offset_d:u16 = 0
  mut conv_row_offset_d:u16 = 0
  mut compute_done_d:u1 = 0
  const can_accept_new_write__w1 = unsigned(pending_q == 0)
  mut pending_d:u1 = if ((tensorload_wen != 0) or (tensorfma_wen != 0) or (cacheop_wen != 0)) and (compute_done_q == 0) { 1 } else { pending_q }
  if compute_done_q != 0 {
    pending_d = 0
  }
  const trigger__w1 = unsigned(((tensorconv_size_wen != 0) or (tensorconv_ctrl_wen != 0)) and (can_accept_new_write__w1 != 0))
  mut conv_idx_d:u4 = if trigger__w1 != 0 { 0 } else { (conv_idx + 1)#[0..=3] }
  conv_col_offset_d = (conv_col_offset + tensorconv_size_data.col_step_offset#[0..=7]#sext[0..=7]#[0..=15])#[0..=15]
  conv_row_offset_d = (conv_row_offset + tensorconv_size_data.row_step_offset#[0..=7]#sext[0..=7]#[0..=15])#[0..=15]
  if trigger__w1 != 0 {
