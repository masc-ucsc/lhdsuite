  const conv_row_pos__w1 = (tensorconv_ctrl_data.row_pos#[0..=15]#sext[0..=15]#[0..=17] + conv_row_offset#sext[0..=15]#[0..=17])#[0..=17]
  mut conv_pass_result:u1 = if ((conv_col_pos__w1 >> 17) & 1) != 0 { 0 } else { 1 }
  if ((conv_row_pos__w1 >> 17) & 1) != 0 {
    conv_pass_result = 0
  }
  if conv_col_pos__w1 >= tensorconv_size_data.col_size#[0..=15] {
