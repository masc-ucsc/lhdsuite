  l2_mul_res_1p = l2_mul_res_1p__wtmp__w1
  md_div_by_zero_1p = md_div_by_zero_1p__w1
  md_mplr_2d = mul_lo_dvsr_2d__w1#[0..=7]
  md_nxt_quot_1q = md_nxt_quot_1q__w1
  md_rem_sgn_1d = (sum_1d >> 64) & 1
  md_resp_data_2p = _mux_80
  md_zero_rem_1d = unsigned(sum_1d#[0..=64] == 0)
}
