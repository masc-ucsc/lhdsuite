// Whole-subsystem simulation driver for minion's vector unit — the analogue
// of dino/sim/dino_tb.prp: INFORMATIONAL, not asserted. bench/sim.sh reports
// its status as METRIC sim_cpu_top_ok, so the flip to 1 is visible the day
// `lhd sim` handles everything this top needs.
//
// vpu_top is minion's vector unit — a real ~75-module subtree, big enough to
// exercise elaboration + the generated host simulator without driving the
// whole core's enormous port list. This driver just holds it in
// reset-then-idle and steps it.
//
// Usage: copy next to a Pyrope tree of the design, then:
//   lhd sim <dir>/vpu_top_tb.prp
const vpu = import("vpu_top.vpu_top")

test vpu.idle(cycles:u20 = 64) {
  mut acc = vpu
  tick cycles clocks=(clock=1) {
    acc.rst_ni = int(clock >= 2)
    step
  }
  puts("hello world: minion vpu_top idled {cycles} cycles")
}
