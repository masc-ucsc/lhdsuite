// Whole-subsystem simulation driver for minion's vector unit — the analogue
// of dino/sim/dino_tb.prp, but still INFORMATIONAL, not asserted. bench/sim.sh
// reports its status as METRIC sim_cpu_top_ok, so the flip to 1 is visible the
// day `lhd sim` handles everything this top needs. dino's timed program and
// extra top smoke ARE asserted now (CORES.sim_top_assert in bench/defs.bzl);
// what still blocks this one is a real gap, not a stale driver:
//
//   module `vpu_trans.vpu_trans`: flop `flop_76:id_insert_en_o` has a derived
//   clock inou.cgen.sim cannot fold into a commit guard
//
// i.e. the same gated-clock cone that keeps `vpu_trans` unproven in fixme
// issue 1 — here on the sim-cgen side rather than the LEC encoder's.
//
// vpu_top is minion's vector unit — a real ~75-module subtree, big enough to
// exercise elaboration + the generated host simulator without driving the
// whole core's enormous port list. This driver just holds it in
// reset-then-idle and steps it.
//
// The DUT is named as `lg:NAME` — a module already compiled in the same
// `lhd sim` invocation — so supply the design BEFORE this file:
//   lhd sim minion/pyrope/vpu_top.prp minion/sim/vpu_top_tb.prp
//   lhd sim lg:DIR minion/sim/vpu_top_tb.prp     (lg: rooted at vpu_top)
const vpu = import("lg:vpu_top")

test vpu.idle(cycles:u20 = 64) {
  mut acc = vpu
  tick cycles clocks=(clock=1) {
    acc.reset = 1  // vpu_top's reset is ACTIVE-HIGH `reset`, not rst_ni
    if clock >= 2 {
      acc.reset = 0
    }
    step
  }
  puts("hello world: minion vpu_top idled {cycles} cycles")
}
