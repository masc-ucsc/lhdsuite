// Assert/assume collateral for the minion TxFMA adder — a sidecar, so the
// design files are never touched. txfma_adder is the 64-bit carry-in adder at
// the bottom of the vector FMA datapath:
//
//   sum_o = (a_i + b_i + cin_i)#[0..=63]
//
// It is deliberately a module of BOTH tops: it sits in the vpu_top cone (so
// the cross-language LEC scenarios see the bug1 edit) and therefore also in
// the whole-design minion_top cone (so the incremental synthesis scenarios
// do too).
//
// NOTE: each `formal` block is an INDEPENDENT test — its assumes constrain only
// its own obligations, so a second block may carry a conflicting assume. Both
// claims below still share one block because both genuinely hold under the same
// cin_i == 0 environment; the second is written implication-style because it is
// a case ANALYSIS on b_i, not a different environment.
//
// Usage:
//   lhd formal verify minion/pyrope/txfma_adder.prp \
//       minion/verif/txfma_adder.verify.prp \
//       --top txfma_adder --set formal.bound=2 --workdir W
//
// These asserts are exactly what minion/tests/bug1/txfma_adder.prp breaks
// (it subtracts b_i): against that variant this sidecar REFUTES.
const adder = import("txfma_adder.txfma_adder")

formal adder.sum {
  mut acc = adder
  assume(acc.cin_i == 0)
  assert(acc.sum_o == (acc.a_i + acc.b_i)#[0..=63],
         "with no carry-in the output is the 64-bit sum")
  assert((acc.b_i == 0) implies (acc.sum_o == acc.a_i),
         "adding zero is the identity")
}
