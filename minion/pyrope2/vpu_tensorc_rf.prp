const prim_rf_1r1w_preview = import("prim_rf_1r1w_preview.prim_rf_1r1w_preview")
const vpu_pkg = import("vpu_pkg")
const minion_pkg = import("minion_pkg")

// VPU tensor C accumulator register file (16 entries): 32-bit entries, one asynchronous read port and one write port
// (prim_rf_1r1w_preview): wr_en_early_i arms the write-data capture one cycle ahead,
// wr_en_i commits it to wr_addr_i.
pub mod vpu_tensorc_rf::[timecheck=false](clk_i:Clock, rd_addr_i:vpu_pkg.VpuTencAddrW_T, wr_addr_i:vpu_pkg.VpuTencAddrW_T, wr_data_i:minion_pkg.VpuDataSSz_T, wr_en_early_i:U1, wr_en_i:U1) -> (rd_data_o:minion_pkg.VpuDataSSz_T@[]) {
  const u_rf = prim_rf_1r1w_preview<Depth=16, Width=32>(preview_clk_i=clk_i, rf_clk_i=clk_i, wr_data_en_1p_next_i=wr_en_early_i, wr_en_i=wr_en_i, wr_addr_i=wr_addr_i, wr_data_i=wr_data_i, rd_addr_i=rd_addr_i)
  rd_data_o = u_rf
}
