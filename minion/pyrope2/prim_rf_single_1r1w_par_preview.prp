// Single-entry variant of prim_rf_1r1w_preview: one 64-bit register written
// from the previewed (negative-edge, latched-enable) data, always readable.
// Width is a file constant, not a generic: the only instance width is 64, and a
// generic would make every instance a hashed specialisation that LEC no longer
// pairs with the Verilog module of the same name.
const Width = 64
pub mod prim_rf_single_1r1w_par_preview::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_data_i:Unsigned(bits=Width), wr_en_i:U1) -> (rd_data_o:Unsigned(bits=Width)@[]) {
  reg rf_q:Unsigned(bits=Width):[clock_pin=rf_clk_i]
  reg wr_data_del_q:Unsigned(bits=Width):[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q = wr_data_del_q
  }
  rd_data_o = rf_q
}
