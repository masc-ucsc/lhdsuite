// Radix-4 Booth partial product (verilog: txfma_booth_ppg_32r4_norm) for one 3-bit
// multiplier window r4input_i: 0 for 000/111, +x for 001/010, +2x for 011, -2x for 100
// and -x for 101/110. Negative products are one's complemented; the +1 that completes
// the negation is added by the caller. The multiplicand is sign extended for a signed multiply.
const minion_pkg = import("minion_pkg")

pub comb txfma_booth_ppg_32r4_norm(mulcand_i:minion_pkg.VpuDataSSz_T, r4input_i:U3, sign_i:U1) -> (pp_o:U33) {
  const x1:U33 = if sign_i == 1 { (mulcand_i#[31] << 32) | mulcand_i } else { mulcand_i }
  const x2:U33 = mulcand_i << 1
  pp_o = if r4input_i == 1 or r4input_i == 2 { x1 }
    elif r4input_i == 5 or r4input_i == 6 { ~x1 }
    elif r4input_i == 3 { x2 }
    elif r4input_i == 4 { ~x2 }
    else { 0 }
}
