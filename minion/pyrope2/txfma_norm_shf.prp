// Normalization shifter: shfamnt_i is a signed 7-bit amount (two's complement);
// a negative amount shifts right by its magnitude, otherwise left. The result
// is bits [15, 49) of the 52-bit shifted value.
pub comb txfma_norm_shf(op_i:U52, shfamnt_i:U7) -> (op_norm_o:U34) {
  const negative = shfamnt_i#[6] != 0
  const shfamnt_abs:U7 = if negative { (0 - shfamnt_i)#[0..<7] } else { shfamnt_i }
  const shifted:U52 = if negative { (op_i >> shfamnt_abs)#[0..<52] } else { (op_i << shfamnt_abs)#[0..<52] }
  op_norm_o = shifted#[15..<49]
}
