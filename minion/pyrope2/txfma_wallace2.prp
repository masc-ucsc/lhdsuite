// Wallace tree, second half: two 4:2 compressor levels that merge the first half's
// carry/sum pairs (c21/s21, c22/s22) with the last partial product (pp17) and the
// sign-extension/carry-in correction words, producing the final carry/sum pair.
const txfma_4_2_compressor_array = import("txfma_4_2_compressor_array.txfma_4_2_compressor_array")
const minion_pkg = import("minion_pkg")

pub mod txfma_wallace2::[timecheck=false](c21_i:U64, c22_i:U64, cin_i:minion_pkg.VpuDataSSz_T, pp17_i:U33, s21_i:U64, s22_i:U64, sxt_i:minion_pkg.VpuDataSSz_T) -> (c41_o:U64@[], s41_o:U64@[]) {
  // Carry vectors have the weight of the next column: shift left by one (the top bit is dropped).
  const csa31 = txfma_4_2_compressor_array::[name=u_csa42_31](x0_i=c21_i#[0..<63] << 1, x1_i=s21_i, x2_i=c22_i#[0..<63] << 1, x3_i=s22_i)
  // Last partial product and sign-extension word enter at bit 32; the carry-in word at bit 0.
  const csa41 = txfma_4_2_compressor_array::[name=u_csa41_41](x0_i=csa31.c_o#[0..<63] << 1, x1_i=csa31.s_o, x2_i=pp17_i#[0..<32] << 32, x3_i=(sxt_i#[0..<32] << 32) | cin_i#[0..<32])
  c41_o = csa41.c_o
  s41_o = csa41.s_o
}
