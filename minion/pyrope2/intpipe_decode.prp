const pkg = import("minion_pkg")

// Integer-pipe instruction decoder: maps a 32-bit instruction word to its
// control bundle (minion_control_t). Pure combinational, one row per
// instruction. Rows are written as calls to small constructors for the common
// instruction shapes (alu_reg, load, ...) so only what distinguishes an
// instruction shows. Fields a row does not use stay don't-care (unknown bits),
// except `legal`, which is only 0 for an undecoded word.
//
// The match patterns never overlap, so the order of the rows is irrelevant
// (`unique if`). EnableExtraTrans selects whether FRSQ_PS/FSIN_PS decode as a
// float op (1) or as m-code (0).

// Instruction-word fields used by the match masks.
comptime const OPC = 0x7f // [6:0] opcode
comptime const F3 = 0x7000 // [14:12] funct3
comptime const F7 = 0xfe000000 // [31:25] funct7
comptime const F12 = 0xfff00000 // [31:20] funct12 / immediate

type Ctrl = (legal:U1, mcode:U1, fp:U1, br:U1, jal:U1, jalr:U1, rxs2:U1, rxs1:U1, sel_alu2:U2, sel_alu1:U2, sel_imm:U3, alu_dw:U1, alu_fn:U5, mem:U1, mem_cmd:U5, mem_type:U4, rma:U1, wmd:U1, wmad:U1, wfd:U1, div:U1, wxd:U1, csr:U3, fence:U1, mem_g:U1, gsc:U1, gfx:U1, x31:U1)

// The helpers below take untyped parameters on purpose: that makes each one a
// template inlined at its call (every argument is a constant), instead of a
// sub-module whose don't-care outputs the simulator cannot schedule.
//
// One decode row. Defaults: no flags, don't-care operand selects/immediate/ALU/memory fields, no CSR op.
comb row(alu_dw=0ub?, alu_fn=0ub1????, br=false, csr=pkg.CsrN, div=false, fence=false, fp=false, gfx=false, gsc=false, jal=false, jalr=false, legal=true, mcode=false, mem=false, mem_cmd=0ub?????, mem_g=false, mem_type=0ub????, rma=false, rxs1=false, rxs2=false, sel_alu1=0ub??, sel_alu2=0ub??, sel_imm=0ub???, wfd=false, wmad=false, wmd=false, wxd=false, x31=false) -> (c:Ctrl) {
  c = (legal=U1(legal), mcode=U1(mcode), fp=U1(fp), br=U1(br), jal=U1(jal), jalr=U1(jalr), rxs2=U1(rxs2), rxs1=U1(rxs1), sel_alu2=sel_alu2, sel_alu1=sel_alu1, sel_imm=sel_imm, alu_dw=alu_dw, alu_fn=alu_fn, mem=U1(mem), mem_cmd=mem_cmd, mem_type=mem_type, rma=U1(rma), wmd=U1(wmd), wmad=U1(wmad), wfd=U1(wfd), div=U1(div), wxd=U1(wxd), csr=csr, fence=U1(fence), mem_g=U1(mem_g), gsc=U1(gsc), gfx=U1(gfx), x31=U1(x31))
}

// Conditional branch: compares rs1 and rs2 with `fn`, target from the SB immediate.
comb branch(fn) -> (c:Ctrl) {
  c = row(alu_fn=fn, br=true, rxs1=true, rxs2=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Rs2, sel_imm=pkg.ImmSb)
}

// rd = rs1 `fn` I-immediate.
comb alu_imm(dw=pkg.Dw64, fn) -> (c:Ctrl) {
  c = row(alu_dw=dw, alu_fn=fn, rxs1=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Imm, sel_imm=pkg.ImmI, wxd=true)
}

// rd = rs1 `fn` rs2; `div` marks the multiply/divide unit, `gfx` the graphics-extension op.
comb alu_reg(div=false, dw=pkg.Dw64, fn, gfx=false) -> (c:Ctrl) {
  c = row(alu_dw=dw, alu_fn=fn, div, gfx, rxs1=true, rxs2=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Rs2, wxd=true)
}

// rd (integer, or FP when `fp`) = mem[rs1 + I-immediate].
comb load(fp=false, ty) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, fp, mem=true, mem_cmd=pkg.DcCmdXrd, mem_type=ty, rxs1=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Imm, sel_imm=pkg.ImmI, wfd=fp, wxd=not fp)
}

// mem[rs1 + S-immediate] = rs2 (the FP register when `fp`, so no integer rs2 read).
comb store(fp=false, ty) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, fp, mem=true, mem_cmd=pkg.DcCmdXwr, mem_type=ty, rxs1=true, rxs2=not fp, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Imm, sel_imm=pkg.ImmS)
}

// CSR read-modify-write with a register operand.
comb csr_reg(csr) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, csr, rxs1=true, rxs2=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Zero, wxd=true)
}

// CSR read-modify-write with the 5-bit zero-extended immediate.
comb csr_imm(csr) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, csr, rxs2=true, sel_alu1=pkg.A1Zero, sel_alu2=pkg.A2Imm, sel_imm=pkg.ImmZ, wxd=true)
}

// Atomic on the packed-single (FP) register file.
comb fp_amo(cmd, is_global=false) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, fp=true, gsc=true, mem=true, mem_cmd=cmd, mem_g=is_global, mem_type=pkg.DcTypePsGs32, rxs2=true, sel_alu1=pkg.A1Fs1, sel_alu2=pkg.A2Rs2, wfd=true)
}

// Scalar atomic; `x31` marks compare-and-swap, which also reads x31.
comb amo(cmd, is_global=false, ty, x31=false) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, mem=true, mem_cmd=cmd, mem_g=is_global, mem_type=ty, rxs1=true, rxs2=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Zero, wxd=true, x31)
}

// Byte/half store through the write-bypass command.
comb store_sub(is_global=false, ty) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, mem=true, mem_cmd=pkg.DcCmdXwrb, mem_g=is_global, mem_type=ty, rxs1=true, rxs2=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Zero, sel_imm=pkg.ImmS)
}

// Whole-line packed-single load/store (bypass commands) addressed by rs1.
comb ps_line(cmd, is_global=false) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, fp=true, mem=true, mem_cmd=cmd, mem_g=is_global, mem_type=pkg.DcTypePs, rxs1=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Zero, wfd=cmd == pkg.DcCmdXrdb)
}

// Packed-single gather (loads, wfd) or scatter (stores), per-lane addresses in an FP register.
comb ps_gather(cmd, is_global=false, is_load, ty) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, fp=true, gsc=true, mem=true, mem_cmd=cmd, mem_g=is_global, mem_type=ty, rxs2=true, sel_alu1=pkg.A1Fs1, sel_alu2=pkg.A2Rs2, wfd=is_load)
}

// 32-bit-index gather/scatter: base in rs1, index vector in rs2.
comb ps_g32(cmd, ty) -> (c:Ctrl) {
  c = row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, fp=true, mem=true, mem_cmd=cmd, mem_type=ty, rxs1=true, rxs2=true, sel_alu1=pkg.A1Zero, sel_alu2=pkg.A2Rs2, wfd=cmd == pkg.DcCmdG32)
}

// FP/vector-unit op with no scalar operands unless `src_x` (rs1 is an integer register).
comb fp_op(gfx=false, src_x=false, wfd=false, wmad=false, wmd=false, wxd=false) -> (c:Ctrl) {
  c = row(fp=true, gfx, rxs1=src_x, sel_alu1=if src_x { pkg.A1Rs1 } else { 0ub?? }, wfd, wmad, wmd, wxd)
}

pub comb intpipe_decode<EnableExtraTrans=0>(inst_bits:U32) -> (inst_ctrl:Ctrl) {
  inst_ctrl = unique if (inst_bits & (OPC | F3)) == 0x1063 { // Basic set: BNE
    branch(fn=pkg.AluSne)
  } elif (inst_bits & (OPC | F3)) == 0x63 { // BEQ
    branch(fn=pkg.AluSeq)
  } elif (inst_bits & (OPC | F3)) == 0x4063 { // BLT
    branch(fn=pkg.AluSlt)
  } elif (inst_bits & (OPC | F3)) == 0x6063 { // BLTU
    branch(fn=pkg.AluSltu)
  } elif (inst_bits & (OPC | F3)) == 0x5063 { // BGE
    branch(fn=pkg.AluSge)
  } elif (inst_bits & (OPC | F3)) == 0x7063 { // BGEU
    branch(fn=pkg.AluSgeu)
  } elif (inst_bits & OPC) == 0x6f { // JAL
    row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, jal=true, sel_alu1=pkg.A1Pc, sel_alu2=pkg.A2Size, sel_imm=pkg.ImmUj, wxd=true)
  } elif (inst_bits & (OPC | F3)) == 0x67 { // JALR
    row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, jalr=true, rxs1=true, sel_alu1=pkg.A1Rs1, sel_alu2=pkg.A2Imm, sel_imm=pkg.ImmI, wxd=true)
  } elif (inst_bits & OPC) == 0x17 { // AUIPC
    row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, sel_alu1=pkg.A1Pc, sel_alu2=pkg.A2Imm, sel_imm=pkg.ImmU, wxd=true)
  } elif (inst_bits & (OPC | F3)) == 0x3 { // Loads: LB
    load(ty=pkg.DcTypeB)
  } elif (inst_bits & (OPC | F3)) == 0x1003 { // LH
    load(ty=pkg.DcTypeH)
  } elif (inst_bits & (OPC | F3)) == 0x2003 { // LW
    load(ty=pkg.DcTypeW)
  } elif (inst_bits & (OPC | F3)) == 0x4003 { // LBU
    load(ty=pkg.DcTypeBu)
  } elif (inst_bits & (OPC | F3)) == 0x5003 { // LHU
    load(ty=pkg.DcTypeHu)
  } elif (inst_bits & (OPC | F3)) == 0x23 { // Stores: SB
    store(ty=pkg.DcTypeB)
  } elif (inst_bits & (OPC | F3)) == 0x1023 { // SH
    store(ty=pkg.DcTypeH)
  } elif (inst_bits & (OPC | F3)) == 0x2023 { // SW
    store(ty=pkg.DcTypeW)
  } elif (inst_bits & OPC) == 0x37 { // LUI: LUI
    row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, sel_alu1=pkg.A1Zero, sel_alu2=pkg.A2Imm, sel_imm=pkg.ImmU, wxd=true)
  } elif (inst_bits & (OPC | F3)) == 0x13 { // ALU I-type: ADDI
    alu_imm(fn=pkg.AluAdd)
  } elif (inst_bits & (OPC | F3)) == 0x2013 { // SLTI
    alu_imm(fn=pkg.AluSlt)
  } elif (inst_bits & (OPC | F3)) == 0x3013 { // SLTIU
    alu_imm(fn=pkg.AluSltu)
  } elif (inst_bits & (OPC | F3)) == 0x7013 { // ANDI
    alu_imm(fn=pkg.AluAnd)
  } elif (inst_bits & (OPC | F3)) == 0x6013 { // ORI
    alu_imm(fn=pkg.AluOr)
  } elif (inst_bits & (OPC | F3)) == 0x4013 { // XORI
    alu_imm(fn=pkg.AluXor)
  } elif (inst_bits & 0xfc00707f) == 0x1013 { // Shifts I-type: SLLI
    alu_imm(fn=pkg.AluSl)
  } elif (inst_bits & 0xfc00707f) == 0x5013 { // SRLI
    alu_imm(fn=pkg.AluSr)
  } elif (inst_bits & 0xfc00707f) == 0x40005013 { // SRAI
    alu_imm(fn=pkg.AluSra)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x33 { // ALU R-type: ADD
    alu_reg(fn=pkg.AluAdd)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x40000033 { // SUB
    alu_reg(fn=pkg.AluSub)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2033 { // SLT
    alu_reg(fn=pkg.AluSlt)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x3033 { // SLTU
    alu_reg(fn=pkg.AluSltu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x7033 { // AND
    alu_reg(fn=pkg.AluAnd)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x6033 { // OR
    alu_reg(fn=pkg.AluOr)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x4033 { // XOR
    alu_reg(fn=pkg.AluXor)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x1033 { // SLL
    alu_reg(fn=pkg.AluSl)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x5033 { // SRL
    alu_reg(fn=pkg.AluSr)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x40005033 { // SRA
    alu_reg(fn=pkg.AluSra)
  } elif (inst_bits & (OPC | F3)) == 0xf { // Misc: FENCE
    row(fence=true)
  } elif (inst_bits & 0xffffffff) == 0x73 { // ECALL
    row(csr=pkg.CsrI)
  } elif (inst_bits & 0xffffffff) == 0x100073 { // EBREAK
    row(alu_dw=pkg.Dw64, alu_fn=pkg.AluAdd, csr=pkg.CsrI, sel_alu1=pkg.A1Pc, sel_alu2=pkg.A2Zero)
  } elif (inst_bits & 0xffffffff) == 0x30200073 { // MRET
    row(csr=pkg.CsrI)
  } elif (inst_bits & 0xffffffff) == 0x10500073 { // WFI
    row(csr=pkg.CsrI)
  } elif (inst_bits & (OPC | F3)) == 0x1073 { // CSR: CSRRW
    csr_reg(csr=pkg.CsrW)
  } elif (inst_bits & (OPC | F3)) == 0x2073 { // CSRRS
    csr_reg(csr=pkg.CsrS)
  } elif (inst_bits & (OPC | F3)) == 0x3073 { // CSRRC
    csr_reg(csr=pkg.CsrC)
  } elif (inst_bits & (OPC | F3)) == 0x5073 { // CSRRWI
    csr_imm(csr=pkg.CsrW)
  } elif (inst_bits & (OPC | F3)) == 0x6073 { // CSRRSI
    csr_imm(csr=pkg.CsrS)
  } elif (inst_bits & (OPC | F3)) == 0x7073 { // CSRRCI
    csr_imm(csr=pkg.CsrC)
  } elif (inst_bits & 0xffffffff) == 0x10200073 { // Rets: SRET
    row(csr=pkg.CsrI)
  } elif (inst_bits & 0xffffffff) == 0x7b200073 { // DRET
    row(csr=pkg.CsrI)
  } elif (inst_bits & (OPC | F3)) == 0x3003 { // 64-bit loads/stores: LD
    load(ty=pkg.DcTypeD)
  } elif (inst_bits & (OPC | F3)) == 0x6003 { // LWU
    load(ty=pkg.DcTypeWu)
  } elif (inst_bits & (OPC | F3)) == 0x3023 { // SD
    store(ty=pkg.DcTypeD)
  } elif (inst_bits & (OPC | F3)) == 0x1b { // 32-bit W-suffix ops: ADDIW
    alu_imm(dw=pkg.Dw32, fn=pkg.AluAdd)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x101b { // SLLIW
    alu_imm(dw=pkg.Dw32, fn=pkg.AluSl)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x501b { // SRLIW
    alu_imm(dw=pkg.Dw32, fn=pkg.AluSr)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x4000501b { // SRAIW
    alu_imm(dw=pkg.Dw32, fn=pkg.AluSra)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x3b { // ADDW
    alu_reg(dw=pkg.Dw32, fn=pkg.AluAdd)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x4000003b { // SUBW
    alu_reg(dw=pkg.Dw32, fn=pkg.AluSub)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x103b { // SLLW
    alu_reg(dw=pkg.Dw32, fn=pkg.AluSl)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x503b { // SRLW
    alu_reg(dw=pkg.Dw32, fn=pkg.AluSr)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x4000503b { // SRAW
    alu_reg(dw=pkg.Dw32, fn=pkg.AluSra)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2000033 { // Mul/Div: MUL
    alu_reg(div=true, fn=pkg.AluMul)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2001033 { // MULH
    alu_reg(div=true, fn=pkg.AluMulh)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2003033 { // MULHU
    alu_reg(div=true, fn=pkg.AluMulhu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2002033 { // MULHSU
    alu_reg(div=true, fn=pkg.AluMulhsu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2004033 { // DIV
    alu_reg(div=true, fn=pkg.AluDiv)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2005033 { // DIVU
    alu_reg(div=true, fn=pkg.AluDivu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2006033 { // REM
    alu_reg(div=true, fn=pkg.AluRem)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2007033 { // REMU
    alu_reg(div=true, fn=pkg.AluRemu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x200003b { // Mul/Div 64b W-suffix: MULW
    alu_reg(div=true, dw=pkg.Dw32, fn=pkg.AluMul)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x200403b { // DIVW
    alu_reg(div=true, dw=pkg.Dw32, fn=pkg.AluDiv)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x200503b { // DIVUW
    alu_reg(div=true, dw=pkg.Dw32, fn=pkg.AluDivu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x200603b { // REMW
    alu_reg(div=true, dw=pkg.Dw32, fn=pkg.AluRem)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x200703b { // REMUW
    alu_reg(div=true, dw=pkg.Dw32, fn=pkg.AluRemu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x600400b { // FP atomics (local PI): FAMOADDL_PI
    fp_amo(cmd=pkg.DcCmdXaAdd)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xe00400b { // FAMOSWAPL_PI
    fp_amo(cmd=pkg.DcCmdXaSwap)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x1600400b { // FAMOANDL_PI
    fp_amo(cmd=pkg.DcCmdXaAnd)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x1e00400b { // FAMOORL_PI
    fp_amo(cmd=pkg.DcCmdXaOr)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2600400b { // FAMOXORL_PI
    fp_amo(cmd=pkg.DcCmdXaXor)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2e00400b { // FAMOMINL_PI
    fp_amo(cmd=pkg.DcCmdXaMin)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x3600400b { // FAMOMAXL_PI
    fp_amo(cmd=pkg.DcCmdXaMax)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x3e00400b { // FAMOMINUL_PI
    fp_amo(cmd=pkg.DcCmdXaMinu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x4600400b { // FAMOMAXUL_PI
    fp_amo(cmd=pkg.DcCmdXaMaxu)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2800400b { // FAMOMAXL_PS
    fp_amo(cmd=pkg.DcCmdXaMaxPs)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x3000400b { // FAMOMINL_PS
    fp_amo(cmd=pkg.DcCmdXaMinPs)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x8600400b { // FP atomics (global PI): FAMOADDG_PI
    fp_amo(cmd=pkg.DcCmdXaAdd, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x8e00400b { // FAMOSWAPG_PI
    fp_amo(cmd=pkg.DcCmdXaSwap, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x9600400b { // FAMOANDG_PI
    fp_amo(cmd=pkg.DcCmdXaAnd, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x9e00400b { // FAMOORG_PI
    fp_amo(cmd=pkg.DcCmdXaOr, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xa600400b { // FAMOXORG_PI
    fp_amo(cmd=pkg.DcCmdXaXor, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xae00400b { // FAMOMING_PI
    fp_amo(cmd=pkg.DcCmdXaMin, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xb600400b { // FAMOMAXG_PI
    fp_amo(cmd=pkg.DcCmdXaMax, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xbe00400b { // FAMOMINUG_PI
    fp_amo(cmd=pkg.DcCmdXaMinu, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xc600400b { // FAMOMAXUG_PI
    fp_amo(cmd=pkg.DcCmdXaMaxu, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xa800400b { // FAMOMAXG_PS
    fp_amo(cmd=pkg.DcCmdXaMaxPs, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0xb000400b { // FAMOMING_PS
    fp_amo(cmd=pkg.DcCmdXaMinPs, is_global=true)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x800203b { // Scalar AMO W (local): AMOSWAPL_W
    amo(cmd=pkg.DcCmdXaSwap, ty=pkg.DcTypeW)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x203b { // AMOADDL_W
    amo(cmd=pkg.DcCmdXaAdd, ty=pkg.DcTypeW)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x2000203b { // AMOXORL_W
    amo(cmd=pkg.DcCmdXaXor, ty=pkg.DcTypeW)
  } elif (inst_bits & (OPC | F3 | F7)) == 0x6000203b { // AMOANDL_W
