// 2R1W register file with a previewed write (see prim_rf_1r1w_preview): two
// async read ports plus a parallel read (rd_par_o) of the entries selected by
// the Parallel bit mask, lowest entry in the low lane. Entries selected by the
// Zero bit mask are hardwired to 0 (entry 0 and 32 by default, like x0 of each
// thread's register file).
pub mod prim_rf_2r1w_preview<Width=64, Entries=64, Zero=0x100000001, Parallel=0x8000000080000000, ParallelW=128>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, rd_addr_a_i:Unsigned(bits=std.clog2(Entries)), rd_addr_b_i:Unsigned(bits=std.clog2(Entries)), wr_en_i:U1, wr_data_en_1p_next_i:U1, wr_addr_i:Unsigned(bits=std.clog2(Entries)), wr_data_i:Unsigned(bits=Width)) -> (rd_data_a_o:Unsigned(bits=Width)@[], rd_data_b_o:Unsigned(bits=Width)@[], rd_par_o:Unsigned(bits=ParallelW)@[]) {
  reg rf_q:[Entries]Unsigned(bits=Width):[__store_clock_pin=rf_clk_i, __store_posclk=true, ordering="old"]
  reg wr_data_del_q:Unsigned(bits=Width):[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  for i in 0..<Entries {
    if ((Zero >> i) & 1) != 0 {
      rf_q[i] = 0
    } elif wr_en_i != 0 and wr_addr_i == i {
      rf_q[i] = wr_data_del_q
    }
  }
  mut lane = 0
  for i in 0..<Entries {
    if ((Parallel >> i) & 1) != 0 {
      rd_par_o#[(lane*Width)..<((lane + 1)*Width)] = rf_q[i]
      lane += 1
    }
  }
  rd_data_a_o = rf_q[rd_addr_a_i]
  rd_data_b_o = rf_q[rd_addr_b_i]
}
