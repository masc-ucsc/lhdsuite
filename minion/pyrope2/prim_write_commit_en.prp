// Write-commit latch pair: enable captured while clk_i is low, data committed while clk_i is high.
// The numbered variants (_p1, _p2) differ only in width; they stay separate modules because LEC pairs
// hierarchy by definition name against the Verilog reference (see livehd_bugs/L0r2_01).
pub mod prim_write_commit_en<Width=64>::[timecheck=false](clk_i:Clock, en_i:U1, d_i:U64) -> (q_o:U64@[]) {
  reg q_o:U64:[enable=clk_i, latch=true]
  reg en_1p:U1:[enable=clk_i, enable_high=false, latch=true]
  en_1p = en_i
  if en_1p != 0 {
    q_o = d_i
  }
}
