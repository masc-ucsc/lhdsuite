// Exponent datapath of the transcendental FMA (stages E1..E6). Each stage is a
// combinational block (txfma_e1/e2/e5/e6) followed by enable-gated pipeline
// registers that advance only when that stage's ctrl_valid is set; none of the
// pipeline registers is reset. The E4 stage has no logic besides the sticky OR.
const txfma_e1 = import("txfma_e1.txfma_e1")
const txfma_e2 = import("txfma_e2.txfma_e2")
const txfma_e5 = import("txfma_e5.txfma_e5")
const txfma_e6 = import("txfma_e6.txfma_e6")
const vpu_defs_pkg = import("vpu_defs_pkg")

// Split the packed 19-bit signal vector into the named bits the stage exponent blocks take.
comb unpack_sigs(v:U19) -> (e0:U1, e1:U1, e10:U1, e11:U1, e12:U1, e13:U1, e14:U1, e15:U1, e16:U1, e17:U1, e18:U1, e2:U1, e3:U1, e4:U1, e5:U1, e6:U1, e7:U1, e8:U1, e9:U1) {
  e18 = v#[18]
  e17 = v#[17]
  e16 = v#[16]
  e15 = v#[15]
  e14 = v#[14]
  e13 = v#[13]
  e12 = v#[12]
  e11 = v#[11]
  e10 = v#[10]
  e9 = v#[9]
  e8 = v#[8]
  e7 = v#[7]
  e6 = v#[6]
  e5 = v#[5]
  e4 = v#[4]
  e3 = v#[3]
  e2 = v#[2]
  e1 = v#[1]
  e0 = v#[0]
}

