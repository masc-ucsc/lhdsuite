// Lookup ROM of the exp function for the transcendental unit (trans_top), coefficient set c0: one packed entry per index_i[5:0].
// Each 58-bit entry packs {exc:1, mask:7, taylor:1, c2:17, c0:32} from the MSB down.
comptime const TABLE:[64]U58 = [0xc000000000010, 0xc000000593470, 0xc000000b361a0, 0xc0000010e8a40, 0xc0000016ab0e0, 0xc000001c7d860, 0xc0000022603a0, 0xc000002853560, 0xc000002e57080, 0xc00000346b7e0, 0xc000003a90e80, 0xc0000040c7720, 0xc00000470f4e0, 0xc000004d68ac0, 0xc0000053d3be0, 0xc000005a50b40, 0xc0000060dfc20, 0xc000006781160, 0xc000006e34e80, 0xc0000074fb680, 0xc000007bd4ca0, 0xc0000082c1440, 0xc0000089c10c0, 0xc0000090d4580, 0xc0000097fb5c0, 0xc000009f36500, 0xc00000a6856c0, 0xc00000ade8e80, 0xc00000b560fc0, 0xc00000bcede20, 0xc00000c48fd60, 0xc00000cc47100, 0xc00000d413ce0, 0xc00000dbf6480, 0xc00000e3eebe0, 0xc00000ebfd6c0, 0xc00000f4228e0, 0xc00000fc5e680, 0xc0000104b1340, 0xc000010d1b340, 0xc00001159ca80, 0xc000011e35d20, 0xc0000126e6f60, 0xc000012fb0540, 0xc000013892300, 0xc00001418cd00, 0xc000014aa0760, 0xc0000153cd6c0, 0xc000015d13f40, 0xc000016674580, 0xc000016feede0, 0xc000017983d20, 0xc0000183337c0, 0xc000018cfe260, 0xc0000196e41c0, 0xc00001a0e5aa0, 0xc00001ab031c0, 0xc00001b53cc00, 0xc00001bf92e60, 0xc00001ca05de0, 0xc00001d495f40, 0xc00001df437e0, 0xc00001ea0ecc0, 0xc00001f4f8300]

pub comb trans_exp_rom_case_c0(index_i:U8) -> (data_o:(exc:U1, mask:U7, taylor:U1, c2:U17, c0:U32)) {
  const entry:U58 = TABLE[index_i#[0..<6]]
  data_o.exc = entry#[57]
  data_o.mask = entry#[50..<57]
  data_o.taylor = entry#[49]
  data_o.c2 = entry#[32..<49]
  data_o.c0 = entry#[0..<32]
}
