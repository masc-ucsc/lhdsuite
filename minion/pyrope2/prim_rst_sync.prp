// Reset synchronizer: asserts rst_no asynchronously with rst_ni (or the scan
// reset in scan mode), and releases it one clk_i edge after rst_ni deasserts.
// In scan mode the scan reset drives both the flop reset and rst_no directly.
pub mod prim_rst_sync::[timecheck=false](clk_i:Clock, dft_i:(scanmode:U1, scan_reset_n:U1), rst_ni:U1) -> (rst_no:U1@[]) {
  wire rst_int_ni:U1 = nil
  reg rst_q:U1:[async=true, clock_pin=clk_i, negreset=true, reset_pin=rst_int_ni] = 0
  rst_int_ni = if dft_i.scanmode != 0 { dft_i.scan_reset_n } else { rst_ni }
  rst_q = 1
  rst_no = if dft_i.scanmode != 0 { dft_i.scan_reset_n } else { rst_q }
}
