// prim_rf_1r1w_preview with a synchronous read: rd_addr_q holds the read address
// captured when rd_en_i is set, and the read data follows it combinationally.
pub mod prim_rf_1r1w_reg_preview<Width=32, Depth=128>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_data_i:Unsigned(bits=Width), wr_addr_i:Unsigned(bits=std.clog2(Depth)), wr_en_i:U1, rd_addr_i:Unsigned(bits=std.clog2(Depth)), rd_en_i:U1) -> (rd_data_o:Unsigned(bits=Width)@[]) {
  reg rf_q:[Depth]Unsigned(bits=Width):[__store_clock_pin=rf_clk_i, __store_posclk=true, ordering="old"]
  reg wr_data_del_q:Unsigned(bits=Width):[clock_pin=rf_clk_i, posclk=false]
  reg rd_addr_q:Unsigned(bits=std.clog2(Depth)):[clock_pin=rf_clk_i]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if rd_en_i != 0 {
    rd_addr_q = rd_addr_i
  }
  if wr_en_i != 0 {
    rf_q[wr_addr_i] = wr_data_del_q
  }
  rd_data_o = rf_q[rd_addr_q]
}
