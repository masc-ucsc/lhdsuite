const txfma_trz = import("txfma_trz.txfma_trz")

// Trailing-zero count of the sum in1_i + in2_i + add_cin_i, predicted from the
// operands without waiting for the carry chain (so it can run in parallel with
// the adder). Bit i of the indicator is set where the sum's trailing zeros end;
// the count is the lowest set indicator bit, or InWidth when there is none.
pub comb txfma_trz2<InWidth=52>(add_cin_i:U1, in1_i:Unsigned(bits=InWidth), in2_i:Unsigned(bits=InWidth)) -> (trz_o:Unsigned(bits=std.clog2(InWidth + 1))) {
  const p:Unsigned(bits=InWidth) = in1_i ^ in2_i
  const k:Unsigned(bits=InWidth) = (~in1_i) & (~in2_i)
  mut indicator:Unsigned(bits=InWidth) = 0
  indicator#[0] = p#[0] ^ add_cin_i
  for i in 1..<InWidth {
    indicator#[i] = (p#[i] ^ k#[i - 1]) ^ 1
  }
  trz_o = txfma_trz<Max=(InWidth - 1)>(frac_i=indicator)
}
