// Exponent stage 6: over/underflow flags of the rounded exponent for the F32 (ps)
// and F16 (ph) result paths, then the final exponent.
const txfma_adder = import("txfma_adder.txfma_adder")
const vpu_defs_pkg = import("vpu_defs_pkg")

pub mod txfma_e6::[timecheck=false](cmd_f6a_h:vpu_defs_pkg.VPU_FCMD_SZ_T, exp_res_in_f6a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T, op_dtype_f6a_h:vpu_defs_pkg.VPU_DTYPE_SZ_T, ph_rndovf_f6a_h:U1, ps_rndovf_f6a_h:U1, sigs_f6a_h:(e18:U1, e17:U1, e16:U1, e15:U1, e14:U1, e13:U1, e12:U1, e11:U1, e10:U1, e9:U1, e8:U1, e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)) -> (def_ovf_ph_f6a_h:U1@[], def_ovf_ps_f6a_h:U1@[], def_unf_ph_f6a_h:U1@[], def_unf_ps_f6a_h:U1@[], exp_res_f6a_h:vpu_defs_pkg.TXFMA_EXP_PS_SZ_T@[], exp_res_zero_f6a_h:U1@[], pot_ovf_ph_f6a_h:U1@[], pot_ovf_ps_f6a_h:U1@[], pot_unf_ph_f6a_h:U1@[], pot_unf_ps_f6a_h:U1@[]) {
  // The exponent arrives sign-extended in 10 bits; flags compare its signed value.
  const exp = exp_res_in_f6a_h#sext[0..=9]
  const exp_nz = exp_res_in_f6a_h != 0
  const is_rsqrt = cmd_f6a_h == vpu_defs_pkg.VPU_TRANS_RSQRT_FMA2

  def_ovf_ps_f6a_h = 0
  pot_ovf_ps_f6a_h = 0
  def_unf_ps_f6a_h = 0
  pot_unf_ps_f6a_h = 0
  def_ovf_ph_f6a_h = 0
  pot_ovf_ph_f6a_h = 0
  def_unf_ph_f6a_h = 0
  pot_unf_ph_f6a_h = 0
  if op_dtype_f6a_h == vpu_defs_pkg.VPU_DTYPE_F32 and sigs_f6a_h.e13 == 0 {
    pot_ovf_ps_f6a_h = U1(exp_res_in_f6a_h == 0xfe)
    def_ovf_ps_f6a_h = U1(exp > 0xfe)
    pot_unf_ps_f6a_h = U1(exp_res_in_f6a_h == 0)
    def_unf_ps_f6a_h = U1(exp < 0)
  } elif op_dtype_f6a_h == vpu_defs_pkg.VPU_DTYPE_F16_F32 {
    // e7 masks the flags for this dtype
    const en = sigs_f6a_h.e7 == 0
    pot_ovf_ps_f6a_h = U1(exp_res_in_f6a_h == 0xfe and en)
    def_ovf_ps_f6a_h = U1(exp > 0xfe and en)
    pot_unf_ps_f6a_h = U1(exp_res_in_f6a_h == 0 and en)
    def_unf_ps_f6a_h = U1(exp < 0 and en)
  } else {
    const max_ph = vpu_defs_pkg.FLOAT16_32_MAX#sext[0..=9]
    const bias_diff = vpu_defs_pkg.TXFMA_BIAS_DIFF#sext[0..=9]
    pot_ovf_ph_f6a_h = U1(exp_res_in_f6a_h == vpu_defs_pkg.FLOAT16_32_MAX)
    def_ovf_ph_f6a_h = U1(exp > max_ph)
    pot_unf_ph_f6a_h = U1(exp_res_in_f6a_h == vpu_defs_pkg.TXFMA_BIAS_DIFF and exp_nz)
    def_unf_ph_f6a_h = U1(exp < bias_diff and exp_nz)
  }

  // exp + 1 (rounding overflow), or exp - 1 (0xfe + 1 == 0xff) for RSQRT
  const adj = txfma_adder<Width=8>(a_i=exp_res_in_f6a_h#[0..<8], b_i=if is_rsqrt { 0xfe } else { 0 }, cin_i=1)
  const exp_res = if ps_rndovf_f6a_h != 0 or ph_rndovf_f6a_h != 0 or is_rsqrt { adj } else { exp_res_in_f6a_h#[0..<8] }
  exp_res_f6a_h = exp_res
  exp_res_zero_f6a_h = U1(exp_res == 0)
}
