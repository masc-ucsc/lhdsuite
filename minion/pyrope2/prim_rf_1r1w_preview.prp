// 1R1W register file with a previewed write: the write data is captured in a
// negative-edge register (wr_data_del_q) gated by a latched enable, and written
// into the array (async read, read returns the committed value) on the next
// rf_clk_i rising edge when wr_en_i is set.
pub mod prim_rf_1r1w_preview<Width=35, Depth=16>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_data_en_1p_next_i:U1, wr_en_i:U1, wr_addr_i:Unsigned(bits=std.clog2(Depth)), wr_data_i:Unsigned(bits=Width), rd_addr_i:Unsigned(bits=std.clog2(Depth))) -> (rd_data_o:Unsigned(bits=Width)@[]) {
  reg rf_q:[Depth]Unsigned(bits=Width):[__store_clock_pin=rf_clk_i, __store_posclk=true, ordering="old"]
  reg wr_data_del_q:Unsigned(bits=Width):[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p = wr_data_en_1p_next_i
  if wr_data_en_1p != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q[wr_addr_i] = wr_data_del_q
  }
  rd_data_o = rf_q[rd_addr_i]
}
