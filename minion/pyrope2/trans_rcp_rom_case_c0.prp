// Lookup ROM of the rcp function for the transcendental unit (trans_top), coefficient set c0: one packed entry per index_i[6:0].
// Each 58-bit entry packs {exc:1, mask:7, taylor:1, c2:17, c0:32} from the MSB down.
comptime const TABLE:[128]U58 = [0x3fffffe, 0x3f80fe0, 0x3f03f04, 0x3e88cb3, 0x3e0f83d, 0x3d980f5, 0x3d22636, 0x3cae758, 0x3c3c3c4, 0x3bcbadc, 0x3b5cc0d, 0x3aef6c9, 0x3a83a83, 0x3a196b1, 0x39b0ad0, 0x3949661, 0x38e38e4, 0x387f1df, 0x381c0df, 0x37ba570, 0x3759f24, 0x36fad88, 0x369d035, 0x36406c7, 0x35e50d9, 0x358ae03, 0x3531dec, 0x34da034, 0x3483482, 0x342da7e, 0x33d91d4, 0x3385a28, 0x3333333, 0x32e1c9d, 0x329161e, 0x3241f6b, 0x31f3832, 0x31a6033, 0x3159721, 0x310dcbf, 0x30c30c4, 0x30792ee, 0x3030304, 0x2fe80bf, 0x2fa0be7, 0x2f5a443, 0x2f14991, 0x2ecfb9c, 0x2e8ba2d, 0x2e4850e, 0x2e05c0a, 0x2dc3eed, 0x2d82d82, 0x2d42798, 0x2d02d03, 0x2cc3d8c, 0x2c8590d, 0x2c47f4e, 0x2c0b02b, 0x2bceb77, 0x2b93107, 0x2b580af, 0x2b1da45, 0x2ae3da9, 0x2aaaaac, 0x2a72129, 0x2a3a0fc, 0x2a02a04, 0x29cbc14, 0x2995711, 0x295fad3, 0x292a73e, 0x28f5c29, 0x28c1978, 0x288df0e, 0x285acc6, 0x2828284, 0x27f6027, 0x27c4596, 0x27932b4, 0x2762761, 0x2732386, 0x2702702, 0x26d31c0, 0x26a43a0, 0x2675c8d, 0x2647c68, 0x261a31f, 0x25ed098, 0x25c04b7, 0x2593f6b, 0x2568097, 0x253c826, 0x2511601, 0x24e6a19, 0x24bc44d, 0x2492494, 0x2468ad0, 0x243f6f1, 0x24168e0, 0x23ee08f, 0x23c5de9, 0x239e0d4, 0x2376949, 0x234f72b, 0x2328a6f, 0x2302301, 0x22dc0d0, 0x22b63cd, 0x2290be3, 0x226b901, 0x2246b1e, 0x2222221, 0x21fde01, 0x21d9eac, 0x21b6417, 0x2192e2b, 0x216fcdf, 0x214d022, 0x212a7e6, 0x2108420, 0x20e64c1, 0x20c49ba, 0x20a3300, 0x2082081, 0x2061238, 0x2040810, 0x2020203]

pub comb trans_rcp_rom_case_c0(index_i:U8) -> (data_o:(exc:U1, mask:U7, taylor:U1, c2:U17, c0:U32)) {
  const entry:U58 = TABLE[index_i#[0..<7]]
  data_o.exc = entry#[57]
  data_o.mask = entry#[50..<57]
  data_o.taylor = entry#[49]
  data_o.c2 = entry#[32..<49]
  data_o.c0 = entry#[0..<32]
}
