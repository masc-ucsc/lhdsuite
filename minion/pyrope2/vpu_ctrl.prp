  const f3_trans = f3_sigs.s.trans != 0
  f3_bypass_clk_en = bypass_clk_en(cmd=f2_sigs.s.cmd, trans=f3_sigs.s.trans, txfma=f3_sigs.s.txfma, wen=f3_wen)
