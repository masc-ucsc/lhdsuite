  const zero48:U48 = 0
  const io_ev_bits:U11 = (io_ev.e0, io_ev.e1, io_ev.e2, io_ev.e3, io_ev.e4, io_ev.e5, io_ev.e6, io_ev.e7, io_ev.e8, io_ev.e9, io_ev.e10)#[..]
