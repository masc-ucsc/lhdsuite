// VPU control: the instruction/valid/kill/register-address bookkeeping that runs beside the VPU datapath.
//
// Pipeline (one control copy per stage, `fN_*`): ID decodes the instruction (the core's or one injected
// by the tensor ML unit / the trans unit) and picks the register-file read addresses; EX (F1) forms the
// request seen by the lanes; F2..F8 carry the write-back control (kill, write mask, thread, address,
// bypass-clock enables) down to the register file; WB hands results back to the core.  The sub-units
// (vpu_ml, vpu_trans, vpu_mask, the tensor-A / tensor-tmp register files) hang off that control.
//
// Two clocks: `clock_aon` (always-on front of the pipe) and `clock_sec` (F2 and later, gated copy).
// Only the EnableExtraTrans = 0 configuration of the reference is built (no RSQRT/SIN bypass-force commands).
const vpu_mask = import("vpu_mask.vpu_mask")
const vpu_ml = import("vpu_ml.vpu_ml")
const vpu_tensora_rf = import("vpu_tensora_rf.vpu_tensora_rf")
const vpu_tensortmp_rf = import("vpu_tensortmp_rf.vpu_tensortmp_rf")
const vpu_trans = import("vpu_trans.vpu_trans")
const vpu_uinst_decoder = import("vpu_uinst_decoder.vpu_uinst_decoder")
const vpu_defs_pkg = import("vpu_defs_pkg")
const minion_dcache_pkg = import("minion_dcache_pkg")
const minion_pkg = import("minion_pkg")

// Per-instruction control bits produced by the decoder (45 bits when packed, `cmd` on top).
type CtrlSigs = (cmd:U7, txfma:U1, shsw:U1, rom:U1, scatter:U1, cvt:U1, trans:U1, gcvt:U1, fromintf:U1, tointm:U1, tointf:U1, maskop:U1, ldst:U1, m0ren:U1, mallren:U1, mren1:U1, mren2:U1, wen:U1, ren1:U1, ren2:U1, ren3:U1, rend:U1, swap12:U1, swap23:U1, swap13:U1, vector:U1, dtype:U4, fromint:U1, toint:U1, fma:U1, fms:U1, add:U1, sub:U1, mul:U1, round:U1, wflags:U1)
// What the lanes receive at EX: the control bits plus rounding mode, immediate and operand type.
type VpuInput = (use_prev_sigs:U1, sigs:CtrlSigs, imm:U20, rm:U3, typ:U2, in1:U32, in2:U32, in3:U32)
// Which operand sources of the transcendental/short units are forced onto the bypass network.
type BypassForce = (txfma_in0:U1, txfma_in1:U1, txfma_in2:U1, shsw_in1:U1, shsw_in2:U1)

type ExCoreCtrl = (tointm:U1, illegal_rm:U1, ps_mask:U8, gsc_fs:U32)

type IoEvents = (e10:U1, e9:U1, e8:U1, e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)

// The registered ID control word (167 bits, the VpuInput bundle packed): use_prev_sigs on top, then the 45 control
// bits, immediate, rounding mode, operand type and the three operands.  Control state is kept packed, one flop vector
// per stage, so that it pairs bit for bit with the reference in LEC.
comptime const IN_USE_PREV = 166
comptime const IN_SIGS = 121
comptime const IN_IMM = 101
comptime const IN_RM = 98
comptime const IN_TYP = 96
comptime const IN_IN1 = 64
comptime const IN_IN2 = 32
comptime const SIG_REN2 = 19 // positions inside the 45-bit control word
comptime const SIG_REN3 = 18

comptime const LANES = 8
comptime const LANE_BITS = 32 // VPU_DATA_S_SZ
comptime const FLAG_BITS = 6 // fcsr flag bits per lane

// Bit-vector view of the control bits (`cmd` in the top bits, `wflags` in bit 0): used to compare two
// control sets in one operation and to place them in the debug words.
comb pack_sigs(s:CtrlSigs) -> (p:U45) {
  p = (s.wflags, s.round, s.mul, s.sub, s.add, s.fms, s.fma, s.toint, s.fromint, s.dtype, s.vector, s.swap13, s.swap23, s.swap12, s.rend, s.ren3, s.ren2, s.ren1, s.wen, s.mren2, s.mren1, s.mallren, s.m0ren, s.ldst, s.maskop, s.tointf, s.tointm, s.fromintf, s.gcvt, s.trans, s.cvt, s.scatter, s.rom, s.shsw, s.txfma, s.cmd)#[..]
}

// The packed control word of one pipeline stage as a bundle (inverse of pack_sigs).
comb unpack_sigs(p:U45) -> (s:CtrlSigs) {
  s.cmd = p#[38..<45]
  s.txfma = p#[37]
  s.shsw = p#[36]
  s.rom = p#[35]
  s.scatter = p#[34]
  s.cvt = p#[33]
  s.trans = p#[32]
  s.gcvt = p#[31]
  s.fromintf = p#[30]
  s.tointm = p#[29]
  s.tointf = p#[28]
  s.maskop = p#[27]
  s.ldst = p#[26]
  s.m0ren = p#[25]
  s.mallren = p#[24]
  s.mren1 = p#[23]
  s.mren2 = p#[22]
  s.wen = p#[21]
  s.ren1 = p#[20]
  s.ren2 = p#[19]
  s.ren3 = p#[18]
  s.rend = p#[17]
  s.swap12 = p#[16]
  s.swap23 = p#[15]
  s.swap13 = p#[14]
  s.vector = p#[13]
  s.dtype = p#[9..<13]
  s.fromint = p#[8]
  s.toint = p#[7]
  s.fma = p#[6]
  s.fms = p#[5]
  s.add = p#[4]
  s.sub = p#[3]
  s.mul = p#[2]
  s.round = p#[1]
  s.wflags = p#[0]
}

// Bypass-clock enable of a write-back stage: it has a register write to forward, or is a trans or
// move-to-int op.
comb bypass_clk_en(cmd:U7, trans:U1, txfma:U1, wen:Bool) -> (en:U1) {
  en = U1((wen and txfma == 0) or trans != 0 or cmd == vpu_defs_pkg.VPU_FCMD_MVS_FX or cmd == vpu_defs_pkg.VPU_FCMD_MVZ_FX)
}

// Scoreboard destination entry {fp, addr, thread} (thread in the low bit).
comb scoreboard_dest(addr:U5, fp:U1, thread:U1) -> (d:U7) {
  d = (thread, addr, fp)#[..]
}

pub mod vpu_ctrl::[timecheck=false](chicken_bit_vputrans:U1, clock_aon:Clock, clock_sec:Clock, dcache_reduce_ctrl:(send_reg:U1, exec_op:U1, nothing:U1), dcache_scp_data:vpu_defs_pkg.DCACHE_DATA_SIZE_T, dcache_scp_resp:(fill_is_tenb_early:U1, fill_is_tenb:U1, tenb_flush:U1, tenb_line:U4), dcache_tenb_data:vpu_defs_pkg.DCACHE_DATA_SIZE_T, ex_core_fromint_data:vpu_defs_pkg.XREG_SIZE_T, ex_core_gsc_src:U3, ex_core_gscing:U1, ex_core_kill:U1, ex_regfile_rdata_bypass:U512, ex_thread_id:U1, f0_core_ctrl:(tensorfma_start:U1, tensorfma_ctrl:(is_conv:U1, padding3:U6, cols_b:U2, rows_a:U4, cols_a:U4, start_a:U4, padding2:U19, to_vrf:U1, u_b:U1, u_a:U1, ten_b:U1, padding1:U2, scp_b:U6, padding0:U2, scp_a:U6, mode:U3, first_pass:U1), tensorfma_conv_bits_ready:U1, tensorfma_conv_bits:U16, reduce_start:U1, tensorstore_start:U1, reduce_ctrl:U64, tensorquant_start:U1, tensorquant_ctrl:(padding2:U2, start_reg:U5, cols:U2, rows:U4, scp_src:U6, padding:U5, trans:U40), pending_scoreboard_t0:U1), f2_core_kill:U1, f2_fswizz_rdata:U256, f3_core_kill:U1, f3_regmask_wdata_lane:vpu_defs_pkg.VPU_LANE_NUM_T, f4_core_kill:U1, f8_sh_sw_wdata:vpu_defs_pkg.VPU_DATA_SZ_T, f8_txfma_comp_res:vpu_defs_pkg.VPU_LANE_NUM_T, f8_wdata_lane0:vpu_defs_pkg.VPU_DATA_S_SZ_T, f8_wflags:U48, id_core_inst_bits:vpu_defs_pkg.INST_SIZE_T, id_core_thread_id:U1, id_core_valid:U1, id_decoder_sigs:CtrlSigs, id_fcsr_rm:vpu_defs_pkg.CORE_FCSR_RM_SZ_T, reset:U1, txfma_trans_dbg:U16, wb_dmem_resp:(thread_id:U1, gdst:U3, typ:U4, addr:U5, data:U256, ps_mask:U8), wb_dmem_resp_val:U1) -> (dcache_ctrl:(scp_req:(read_en:U1, way:U2, addr:U10, size64:U1, size256:U1, bid:U1), tenb_credit:U1, tenb_credit_entry:U2, tfma_enabled:U1, reduce_wait:U1, tfma_rf_write:U1)@[], ex_bypass_force_ctrl:(txfma_in0:U1, txfma_in1:U1, txfma_in2:U1, shsw_in1:U1, shsw_in2:U1)@[], ex_core_ctrl:(tointm:U1, illegal_rm:U1, ps_mask:U8, gsc_fs:U32)@[], ex_mask_in1:vpu_defs_pkg.VPU_LANE_NUM_T@[], ex_regfile_raddr1:U5@[], ex_regfile_raddr2:U5@[], ex_regfile_raddr3:U5@[], ex_regfile_thread_id:U3@[], ex_req:VpuInput@[], ex_rom_clock_valid:U1@[], ex_rom_valid:U1@[], ex_sh_sw_clock_valid:U1@[], ex_sh_sw_valid:U1@[], ex_tena_regfile_bypass_en:U1@[], ex_tena_rf_rdata:U256@[], ex_tena_rf_tima_rdata:vpu_defs_pkg.VPU_DATA_S_SZ_T@[], ex_tenb_regfile_bypass_en:U1@[], ex_tima_sa:U1@[], ex_tima_sb:U1@[], ex_tima_tenb_raddr:vpu_defs_pkg.VPU_TENB_ADDR_W_T@[], ex_tima_valid:U16@[], ex_tima_valid_unqual:U1@[], ex_txfma_clock_valid:U1@[], ex_txfma_valid:vpu_defs_pkg.VPU_LANE_NUM_T@[], f2_core_ctrl:(fma:U1, store_data:U256, scatter_data:U32, tointm:U1)@[], f2_fswizz_rdata1:U256@[], f2_fswizz_rdata2:U256@[], f2_fswizz_rdata3:U256@[], f2_tenb_regfile_wen_l:U1@[], f2_tima_ren3:U1@[], f2_tima_rf_wen:U16@[], f2_tima_tenc_raddr:U4@[], f2_tima_tenc_wen:U16@[], f3_bypass_clk_en:U1@[], f3_core_ctrl:(fma:U1, tointm:U1)@[], f3_data_vector:U1@[], f3_regfile_waddr:U5@[], f3_regfile_wen_l:U1@[], f3_regfile_wmask:vpu_defs_pkg.VPU_LANE_NUM_T@[], f3_tenb_regfile_waddr_l:vpu_defs_pkg.VPU_TENB_ADDR_W_T@[], f3_tenb_regfile_wdata_l:vpu_defs_pkg.VPU_DATA_SZ_T@[], f3_tenb_regfile_wen_l:U1@[], f3_thread_id:U1@[], f3_tima_rf_wen:U16@[], f3_tima_tenc_waddr:U4@[], f3_tima_tenc_wen:U16@[], f4_bypass_clk_en:U1@[], f4_regfile_thrid_l:U1@[], f4_regfile_waddr:U5@[], f4_regfile_waddr_l:U5@[], f4_regfile_wdata_l:vpu_defs_pkg.VPU_DATA_SZ_T@[], f4_regfile_wen_l:U1@[], f4_regfile_wmask:vpu_defs_pkg.VPU_LANE_NUM_T@[], f4_regfile_wmask_l:U16@[], f4_thread_id:U1@[], f5_bypass_clk_en:U1@[], f5_regfile_waddr:U5@[], f5_regfile_wmask:vpu_defs_pkg.VPU_LANE_NUM_T@[], f5_thread_id:U1@[], f6_bypass_clk_en:U1@[], f6_regfile_waddr:U5@[], f6_regfile_wmask:vpu_defs_pkg.VPU_LANE_NUM_T@[], f6_thread_id:U1@[], f7_bypass_clk_en:U1@[], f7_regfile_waddr:U5@[], f7_regfile_wen:vpu_defs_pkg.VPU_LANE_NUM_T@[], f7_regfile_wmask:vpu_defs_pkg.VPU_LANE_NUM_T@[], f7_thread_id:U1@[], f8_data_vector:U1@[], f8_regfile_waddr:U5@[], f8_regfile_wen:vpu_defs_pkg.VPU_LANE_NUM_T@[], f8_regfile_wmask:vpu_defs_pkg.VPU_LANE_NUM_T@[], f8_thread_id:U1@[], f8_txfma_op:U1@[], id_core_ctrl:(m0ren:U1, mallren:U1, mren1:U1, mren2:U1, wen:U1, ren1:U1, ren2:U1, ren3:U1, rend:U1, is_trans:U1, trans_busy:U1, id_trans_insert:U1, scoreboard:(fp_valid:U14, fp_dest:U98, toint_valid:U4, toint_dest:U28, mask_valid:U4, mask_dest:U16), tfma_enabled:U1, tfma_wrrf_enabled:U1, tquant_enabled:U1, reduce_enabled:U1, fflags_stall:U1, fromint:U1)@[], id_regfile_raddr1:U5@[], id_regfile_raddr2:U5@[], id_regfile_raddr3:U5@[], id_regfile_ren:(e2:U1, e1:U1, e0:U1)@[], id_regfile_thread_id:U3@[], io_events:(e10:U1, e9:U1, e8:U1, e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)@[], vpu_dbg_data:U640@[], vpu_dbg_filter:vpu_defs_pkg.NEIGH_DEBUG_FILTER_WIDTH_T@[], vpu_dbg_match:vpu_defs_pkg.NEIGH_DEBUG_MATCH_WIDTH_T@[], wb_core_ctrl:(fma:U1, toint_data:U64, mova_mx:U1, fcsr_flags_valid:U1, fcsr_flags:U6, thread_id:U1, tointm:U1)@[]) {
  // ---- pipeline state ------------------------------------------------------------------------------
  // Only the control that needs a reset is reset (valid/kill/wen/sigs); data-like copies (addresses,
  // thread ids, lane index, masks) are left unreset on purpose, as in the reference.
  // ID / EX (always-on clock)
  reg id_core_inst:U32:[clock_pin=clock_aon] = nil
  reg id_inst_from_core:Bool:[clock_pin=clock_aon] = nil
  reg id_ml_mask:U8:[clock_pin=clock_aon] = nil
  reg ex_ra1:U5:[clock_pin=clock_aon] = nil
  reg ex_ra2:U5:[clock_pin=clock_aon] = nil
  reg ex_ra3:U5:[clock_pin=clock_aon] = nil
  reg ex_core_inst:U32:[clock_pin=clock_aon] = nil
  reg ex_ml_mask:U8:[clock_pin=clock_aon] = nil
  reg ex_tensorfma_en:Bool:[clock_pin=clock_aon] = nil
  reg ex_mova_mx:Bool:[clock_pin=clock_aon] = nil
  reg ex_tena_regfile_bypass_en:U1:[clock_pin=clock_aon] = nil
  reg ex_tenb_regfile_bypass_en:U1:[clock_pin=clock_aon] = nil
  reg ex_regfile_thread_id:U3:[clock_pin=clock_aon] = nil
  reg ex_ctrl_valid:Bool:[clock_pin=clock_aon, reset_pin=reset] = false
  reg ex_ml_inst_val:Bool:[clock_pin=clock_aon, reset_pin=reset] = false
  reg ex_vpu_ctrl:U167:[clock_pin=clock_aon, reset_pin=reset] = 0
  reg ex_bypass_force_ctrl_q:U5:[clock_pin=clock_aon, reset_pin=reset] = 0
  reg f3_tenb_pass:U1:[clock_pin=clock_aon, reset_pin=reset] = 0
  reg ex_gsc_fs:[LANES]U32:[clock_pin=clock_aon, ordering="old"] = nil
  // F2 (secondary clock from here on)
  reg f2_req:U167:[clock_pin=clock_sec, reset_pin=reset] = 0
  const f2_sigs = unpack_sigs(p=f2_req#[IN_SIGS..<(IN_SIGS + 45)])
  reg f2_ctrl_valid_qual:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f2_ctrl_valid:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f2_ctrl_killed_prev:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f2_txfma_valid_all_en:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f2_wen:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f2_ml_inst_val:Bool:[clock_pin=clock_sec] = nil
  reg f2_mova_mx:Bool:[clock_pin=clock_sec] = nil
  reg f2_ml_use_prev_sigs:Bool:[clock_pin=clock_sec] = nil
  reg f2_ml_mask:U8:[clock_pin=clock_sec] = nil
  reg f2_regfile_waddr:U5:[clock_pin=clock_sec] = nil
  reg f2_thread_id:U1:[clock_pin=clock_sec] = nil
  reg f2_lane_idx:U3:[clock_pin=clock_sec] = nil
  reg f2_gsc_src:U3:[clock_pin=clock_sec] = nil
  reg f2_store_data_lane:[LANES]U32:[clock_pin=clock_sec, ordering="old"] = nil
  reg ex_tensora_zero_mask:[2]U8:[clock_pin=clock_sec, ordering="old"] = nil
  reg ex_tensortmp_zero_mask:[8]U8:[clock_pin=clock_sec, ordering="old"] = nil
  reg ex_tensorb_zero_mask:[8]U8:[clock_pin=clock_sec, ordering="old"] = nil
  // F3
  reg f3_ctrl_sigs:U45:[clock_pin=clock_sec, reset_pin=reset] = 0
  const f3_sigs = unpack_sigs(p=f3_ctrl_sigs)
  reg f3_ctrl_valid_qual:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f3_ctrl_valid:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f3_ctrl_killed_prev:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f3_ml_inst_val:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f3_wen:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f3_mova_mx:Bool:[clock_pin=clock_sec] = nil
  reg f3_ml_use_prev_sigs:Bool:[clock_pin=clock_sec] = nil
  reg f3_lane_idx:U3:[clock_pin=clock_sec] = nil
  reg f3_thread_id:U1:[clock_pin=clock_sec] = nil
  reg f3_regfile_wmask:U8:[clock_pin=clock_sec] = nil
  reg f3_regfile_waddr:U5:[clock_pin=clock_sec] = nil
  // F4
  reg f4_ctrl_sigs:U45:[clock_pin=clock_sec, reset_pin=reset] = 0
  const f4_sigs = unpack_sigs(p=f4_ctrl_sigs)
  reg f4_ctrl_valid_qual:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f4_ctrl_valid:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f4_ctrl_killed_prev:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f4_ml_inst_val:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f4_wen:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f4_mova_mx:Bool:[clock_pin=clock_sec] = nil
  reg f4_ml_use_prev_sigs:Bool:[clock_pin=clock_sec] = nil
  reg f4_lane_idx:U3:[clock_pin=clock_sec] = nil
  reg f4_thread_id:U1:[clock_pin=clock_sec] = nil
  reg f4_regfile_wmask:U8:[clock_pin=clock_sec] = nil
  reg f4_regfile_waddr:U5:[clock_pin=clock_sec] = nil
  reg f4_regfile_thrid_l:U1:[clock_pin=clock_sec] = nil
  reg f4_regfile_wmask_l:U16:[clock_pin=clock_sec] = nil
  reg f4_regfile_waddr_l:U5:[clock_pin=clock_sec] = nil
  reg f4_regfile_wdata_l:U256:[clock_pin=clock_sec] = nil
  reg f4_regfile_wen_l:U1:[clock_pin=clock_sec] = nil
  // F5
  reg f5_ctrl_sigs:U45:[clock_pin=clock_sec, reset_pin=reset] = 0
  const f5_sigs = unpack_sigs(p=f5_ctrl_sigs)
  reg f5_ctrl_valid_qual:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f5_ctrl_killed:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f5_ml_inst_val:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f5_wen:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f5_core_kill:Bool:[clock_pin=clock_sec] = nil
  reg f5_mova_mx:Bool:[clock_pin=clock_sec] = nil
  reg f5_ml_use_prev_sigs:Bool:[clock_pin=clock_sec] = nil
  reg f5_lane_idx:U3:[clock_pin=clock_sec] = nil
  reg f5_thread_id:U1:[clock_pin=clock_sec] = nil
  reg f5_regfile_wmask:U8:[clock_pin=clock_sec] = nil
  reg f5_regfile_waddr:U5:[clock_pin=clock_sec] = nil
  // F6
  reg f6_ctrl_sigs:U45:[clock_pin=clock_sec, reset_pin=reset] = 0
  const f6_sigs = unpack_sigs(p=f6_ctrl_sigs)
  reg f6_ctrl_valid_qual:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f6_ctrl_killed:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f6_ml_inst_val:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f6_wen:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f6_core_kill:Bool:[clock_pin=clock_sec] = nil
  reg f6_ml_use_prev_sigs:Bool:[clock_pin=clock_sec] = nil
  reg f6_lane_idx:U3:[clock_pin=clock_sec] = nil
  reg f6_thread_id:U1:[clock_pin=clock_sec] = nil
  reg f6_regfile_wmask:U8:[clock_pin=clock_sec] = nil
  reg f6_regfile_waddr:U5:[clock_pin=clock_sec] = nil
  // F7
  reg f7_ctrl_sigs:U45:[clock_pin=clock_sec, reset_pin=reset] = 0
  const f7_sigs = unpack_sigs(p=f7_ctrl_sigs)
  reg f7_ctrl_valid_qual:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f7_ctrl_killed:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f7_wen:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f7_ml_use_prev_sigs:Bool:[clock_pin=clock_sec] = nil
  reg f7_lane_idx:U3:[clock_pin=clock_sec] = nil
  reg f7_thread_id:U1:[clock_pin=clock_sec] = nil
  reg f7_regfile_wmask:U8:[clock_pin=clock_sec] = nil
  reg f7_regfile_waddr:U5:[clock_pin=clock_sec] = nil
  // F8
  reg f8_ctrl_sigs:U45:[clock_pin=clock_sec, reset_pin=reset] = 0
  const f8_sigs = unpack_sigs(p=f8_ctrl_sigs)
  reg f8_ctrl_valid_qual:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f8_ctrl_killed:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f8_wen:Bool:[clock_pin=clock_sec, reset_pin=reset] = false
  reg f8_lane_idx:U3:[clock_pin=clock_sec] = nil
  reg f8_thread_id:U1:[clock_pin=clock_sec, reset_pin=reset] = 0
  reg f8_regfile_wmask:U8:[clock_pin=clock_sec, reset_pin=reset] = 0
  reg f8_regfile_waddr:U5:[clock_pin=clock_sec] = nil

  // Nets driven by sub-units that feed back into the logic that drives those sub-units.
  wire id_trans_insert_en:Bool = nil
  wire id_trans_thread_id:U1 = nil
  wire ex_mask_rf0:U8 = nil

  // ---- EX / F1 request ------------------------------------------------------------------------------
  // The registered ID control; the operand-2/3 read flags of from-int instructions follow the swap flags.
  const ex_vpu_sigs = unpack_sigs(p=ex_vpu_ctrl#[IN_SIGS..<(IN_SIGS + 45)])
  mut ex_req_word:U167 = ex_vpu_ctrl
  if ex_vpu_sigs.s.fromint != 0 {
    ex_req_word#[IN_SIGS + SIG_REN2] = ex_vpu_sigs.s.swap12
    ex_req_word#[IN_SIGS + SIG_REN3] = ex_vpu_sigs.s.swap13
  }
  // A TensorFMA micro-op that repeats the control already in F2 (once every lane got a first valid) does not
  // reload it.
  const ex_same_sigs = ex_req_word#[IN_SIGS..<(IN_SIGS + 45)] == f2_req#[IN_SIGS..<(IN_SIGS + 45)]
  const ex_use_prev_sigs = ex_tensorfma_en and ex_same_sigs and f2_txfma_valid_all_en
  ex_req_word#[IN_USE_PREV] = U1(ex_use_prev_sigs)
  const ex_sigs = unpack_sigs(p=ex_req_word#[IN_SIGS..<(IN_SIGS + 45)])
  const ex_rm:U3 = ex_req_word#[IN_RM..<(IN_RM + 3)]
  const ex_imm:U20 = ex_req_word#[IN_IMM..<(IN_IMM + 20)]

  // ---- ID / F0: instruction select and decode -----------------------------------------------------
  // A micro-op injected by ml/trans (registered one cycle ahead) overrides the core's instruction.
  const id_inst:U32 = if id_inst_from_core { id_core_inst_bits } else { id_core_inst }

  const ml = vpu_ml::[name=ml](clock=clock_sec, reset=reset, f0_core_ctrl=f0_core_ctrl, dcache_scp_resp=dcache_scp_resp, dcache_scp_data=dcache_scp_data, dcache_reduce_ctrl=dcache_reduce_ctrl, id_inst=id_inst)

  mut id_core_valid_int:Bool = id_core_valid != 0
  mut id_core_thread_id_int:U1 = id_core_thread_id
  if ml.id_inst_en != 0 {
    id_core_valid_int = true
  } elif id_trans_insert_en {
    id_core_valid_int = true
    id_core_thread_id_int = id_trans_thread_id
  }

  const trans = vpu_trans<EnableExtraTrans=0>(clk_aon_i=clock_aon, rst_ni=~reset, id_valid_i=U1(id_core_valid_int), id_core_thread_id_i=id_core_thread_id, id_instruction_i=id_inst, ex_valid_i=U1(ex_ctrl_valid), ex_core_thread_id_i=ex_thread_id, ex_instruction_i=ex_core_inst, ex_mask_rf0_i=ex_mask_rf0, chicken_bit_vputrans_i=chicken_bit_vputrans, f6_killed_i=U1(f6_ctrl_killed), f7_killed_i=U1(f7_ctrl_killed), f8_killed_i=U1(f8_ctrl_killed))
  id_trans_insert_en = trans.id_insert_en_o != 0
  id_trans_thread_id = trans.id_trans_thread_id_o
  const id_trans_insert_en_next = trans.id_insert_en_next_o != 0

  // Next cycle's ID instruction: ml micro-op, else trans micro-op, else the core's.
  const id_inst_inject = ml.id_inst_en_next != 0 or id_trans_insert_en_next
  const id_core_inst_next:U32 = if ml.id_inst_en_next != 0 { ml.id_inst_next }
    elif id_trans_insert_en_next { trans.id_insert_inst_next_o }
    else { id_inst }
  if id_inst_inject {
    id_core_inst = id_core_inst_next
  }
  id_inst_from_core = not id_inst_inject
  if ml.id_inst_en_next != 0 {
    id_ml_mask = ml.id_mask_next
  }

  // ---- EX / F1: valid, kill and thread ---------------------------------------------------------------
  const ex_cmd = ex_sigs.s.cmd
  const ex_trans = ex_sigs.s.trans != 0
  const ex_kill = ex_core_kill != 0
  const ex_thread_id_int:U1 = if ex_trans { trans.ex_trans_thread_id_o } else { ex_thread_id }
  // Instructions that do not depend on the mask are valid even if every lane is masked off.
  const ex_mask_independent = ex_sigs.s.vector == 0 or ex_sigs.s.maskop != 0 or ex_ml_inst_val or ex_cmd == vpu_defs_pkg.VPU_FCMD_MVZ_FX or ex_cmd == vpu_defs_pkg.VPU_FCMD_MVS_FX or ex_cmd == vpu_defs_pkg.VPU_FCMD_FCMOVM
  const ex_ctrl_valid_qual = ex_ctrl_valid and (ex_mask_independent or ex_mask_rf0 != 0 or ex_trans)
  // Core kills are ignored for the generated (ml/trans) operations.
  const ex_alive = not ex_kill or ex_ml_inst_val or ex_trans
  const ex_ctrl_valid_kill = ex_ctrl_valid and ex_alive
  const ex_ctrl_killed = ex_ctrl_valid and not ex_alive
  const ex_wen = ex_ctrl_valid_qual and ex_sigs.s.wen != 0 and ex_sigs.s.ldst == 0 // loads write through the load path
  const ex_lane_idx:U3 = if ex_sigs.s.vector != 0 { ex_core_inst#[20..<23] } else { 0 }
  const ex_thread_for_f2:U1 = U1(ex_thread_id_int != 0 and not ex_ml_inst_val)

  // The decoder inside the VPU decodes the injected micro-ops; the core's decoder covers its own.
  const uinst_decoder = vpu_uinst_decoder::[name=uinst_decoder](id_inst_i=id_core_inst)
  // Instruction fields.
  const inst_rs1:U5 = id_inst#[15..<20] // first source register
  const inst_rs2:U5 = id_inst#[20..<25] // second source register
  const inst_rs3:U5 = id_inst#[27..<32] // third source register
  const inst_rd:U5 = id_inst#[7..<12] // destination register
  const inst_rm:U3 = id_inst#[12..<15] // rounding mode

  // The decoded control, with the source operands re-routed for swapped-operand forms below.
  mut id_vpu_ctrl:VpuInput = nil
  id_vpu_ctrl.use_prev_sigs = 0
  id_vpu_ctrl.in1 = 0
  id_vpu_ctrl.in2 = 0
  id_vpu_ctrl.in3 = 0
  id_vpu_ctrl.sigs.cmd = if id_inst_from_core { id_decoder_sigs.cmd } else { uinst_decoder.id_sigs_o.cmd }
  id_vpu_ctrl.sigs.txfma = if id_inst_from_core { id_decoder_sigs.txfma } else { uinst_decoder.id_sigs_o.txfma }
  id_vpu_ctrl.sigs.shsw = if id_inst_from_core { id_decoder_sigs.shsw } else { uinst_decoder.id_sigs_o.shsw }
  id_vpu_ctrl.sigs.rom = if id_inst_from_core { id_decoder_sigs.rom } else { uinst_decoder.id_sigs_o.rom }
  id_vpu_ctrl.sigs.scatter = if id_inst_from_core { id_decoder_sigs.scatter } else { uinst_decoder.id_sigs_o.scatter }
  id_vpu_ctrl.sigs.cvt = if id_inst_from_core { id_decoder_sigs.cvt } else { uinst_decoder.id_sigs_o.cvt }
  id_vpu_ctrl.sigs.trans = if id_inst_from_core { id_decoder_sigs.trans } else { uinst_decoder.id_sigs_o.trans }
  id_vpu_ctrl.sigs.gcvt = if id_inst_from_core { id_decoder_sigs.gcvt } else { uinst_decoder.id_sigs_o.gcvt }
  id_vpu_ctrl.sigs.fromintf = if id_inst_from_core { id_decoder_sigs.fromintf } else { uinst_decoder.id_sigs_o.fromintf }
  id_vpu_ctrl.sigs.tointm = if id_inst_from_core { id_decoder_sigs.tointm } else { uinst_decoder.id_sigs_o.tointm }
  id_vpu_ctrl.sigs.tointf = if id_inst_from_core { id_decoder_sigs.tointf } else { uinst_decoder.id_sigs_o.tointf }
  id_vpu_ctrl.sigs.maskop = if id_inst_from_core { id_decoder_sigs.maskop } else { uinst_decoder.id_sigs_o.maskop }
  id_vpu_ctrl.sigs.ldst = if id_inst_from_core { id_decoder_sigs.ldst } else { uinst_decoder.id_sigs_o.ldst }
  id_vpu_ctrl.sigs.m0ren = if id_inst_from_core { id_decoder_sigs.m0ren } else { uinst_decoder.id_sigs_o.m0ren }
  id_vpu_ctrl.sigs.mallren = if id_inst_from_core { id_decoder_sigs.mallren } else { uinst_decoder.id_sigs_o.mallren }
  id_vpu_ctrl.sigs.mren1 = if id_inst_from_core { id_decoder_sigs.mren1 } else { uinst_decoder.id_sigs_o.mren1 }
  id_vpu_ctrl.sigs.mren2 = if id_inst_from_core { id_decoder_sigs.mren2 } else { uinst_decoder.id_sigs_o.mren2 }
  id_vpu_ctrl.sigs.wen = if id_inst_from_core { id_decoder_sigs.wen } else { uinst_decoder.id_sigs_o.wen }
  id_vpu_ctrl.sigs.ren1 = if id_inst_from_core { id_decoder_sigs.ren1 } else { uinst_decoder.id_sigs_o.ren1 }
  id_vpu_ctrl.sigs.ren2 = if id_inst_from_core { id_decoder_sigs.ren2 } else { uinst_decoder.id_sigs_o.ren2 }
  id_vpu_ctrl.sigs.ren3 = if id_inst_from_core { id_decoder_sigs.ren3 } else { uinst_decoder.id_sigs_o.ren3 }
  id_vpu_ctrl.sigs.rend = if id_inst_from_core { id_decoder_sigs.rend } else { uinst_decoder.id_sigs_o.rend }
  id_vpu_ctrl.sigs.swap12 = if id_inst_from_core { id_decoder_sigs.swap12 } else { uinst_decoder.id_sigs_o.swap12 }
  id_vpu_ctrl.sigs.swap23 = if id_inst_from_core { id_decoder_sigs.swap23 } else { uinst_decoder.id_sigs_o.swap23 }
  id_vpu_ctrl.sigs.swap13 = if id_inst_from_core { id_decoder_sigs.swap13 } else { uinst_decoder.id_sigs_o.swap13 }
  id_vpu_ctrl.sigs.vector = if id_inst_from_core { id_decoder_sigs.vector } else { uinst_decoder.id_sigs_o.vector }
  id_vpu_ctrl.sigs.dtype = if id_inst_from_core { id_decoder_sigs.dtype } else { uinst_decoder.id_sigs_o.dtype }
  id_vpu_ctrl.sigs.fromint = if id_inst_from_core { id_decoder_sigs.fromint } else { uinst_decoder.id_sigs_o.fromint }
  id_vpu_ctrl.sigs.toint = if id_inst_from_core { id_decoder_sigs.toint } else { uinst_decoder.id_sigs_o.toint }
  id_vpu_ctrl.sigs.fma = if id_inst_from_core { id_decoder_sigs.fma } else { uinst_decoder.id_sigs_o.fma }
  id_vpu_ctrl.sigs.fms = if id_inst_from_core { id_decoder_sigs.fms } else { uinst_decoder.id_sigs_o.fms }
  id_vpu_ctrl.sigs.add = if id_inst_from_core { id_decoder_sigs.add } else { uinst_decoder.id_sigs_o.add }
  id_vpu_ctrl.sigs.sub = if id_inst_from_core { id_decoder_sigs.sub } else { uinst_decoder.id_sigs_o.sub }
  id_vpu_ctrl.sigs.mul = if id_inst_from_core { id_decoder_sigs.mul } else { uinst_decoder.id_sigs_o.mul }
  id_vpu_ctrl.sigs.round = if id_inst_from_core { id_decoder_sigs.round } else { uinst_decoder.id_sigs_o.round }
  id_vpu_ctrl.sigs.wflags = if id_inst_from_core { id_decoder_sigs.wflags } else { uinst_decoder.id_sigs_o.wflags }
  const sel_cmd:U7 = id_vpu_ctrl.sigs.cmd
  const sel_ren1 = id_vpu_ctrl.sigs.ren1 != 0
  const sel_ren2 = id_vpu_ctrl.sigs.ren2 != 0
  const sel_ren3 = id_vpu_ctrl.sigs.ren3 != 0
  const sel_rend = id_vpu_ctrl.sigs.rend != 0
  const sel_swap12 = id_vpu_ctrl.sigs.swap12 != 0
  const sel_swap13 = id_vpu_ctrl.sigs.swap13 != 0
  const sel_swap23 = id_vpu_ctrl.sigs.swap23 != 0
  const sel_cvt = id_vpu_ctrl.sigs.cvt != 0
  const sel_maskop = id_vpu_ctrl.sigs.maskop != 0

  // Register-file read addresses: hold the EX ones while a gather/scatter is in flight.
  mut id_ra1:U5 = ex_ra1
  mut id_ra2:U5 = ex_ra2
  mut id_ra3:U5 = ex_ra3
  if ex_core_gscing == 0 {
    if sel_ren1 {
      if not sel_swap12 {
        id_ra1 = inst_rs1
      }
      if sel_swap12 {
        id_ra2 = inst_rs1
        id_vpu_ctrl.sigs.ren1 = 0
        id_vpu_ctrl.sigs.ren2 = 1
      }
      if sel_swap13 {
        id_ra3 = inst_rs1
        id_vpu_ctrl.sigs.ren1 = U1(sel_cmd == vpu_defs_pkg.VPU_TRANS_EXP_FRAC)
        id_vpu_ctrl.sigs.ren3 = 1
      }
    }
    if sel_ren2 {
      if sel_swap12 {
        id_ra1 = inst_rs2
        id_vpu_ctrl.sigs.ren1 = 1
        id_vpu_ctrl.sigs.ren2 = 0
      }
      if sel_swap23 {
        id_ra3 = inst_rs2
        id_vpu_ctrl.sigs.ren2 = 0
        id_vpu_ctrl.sigs.ren3 = 1
      }
      if not sel_swap12 and not sel_swap23 {
        id_ra2 = inst_rs2
      }
    }
    if sel_ren3 {
      id_ra3 = inst_rs3
    }
    if sel_cvt and sel_cmd == vpu_defs_pkg.VPU_FCMD_FSETM {
      id_ra1 = inst_rs1
    }
    if sel_cmd == vpu_defs_pkg.VPU_FCMD_NR2_FRCPFXP {
      id_ra3 = inst_rs2
    }
    if sel_maskop {
      // Mask registers are 3-bit addresses.
      id_ra1 = id_inst#[15..<18]
      id_ra2 = id_inst#[20..<23]
    }
    if sel_rend {
      // rd doubles as a source: ra3 for three-source forms, else ra1 (scatter).
      if sel_ren3 {
        id_ra3 = inst_rd
      } else {
        id_ra1 = inst_rd
      }
    }
  }

  // Rounding mode: RTZ when the instruction does not round; the CSR mode when the instruction says "dynamic"
  // or is a global convert.
  id_vpu_ctrl.rm = if id_vpu_ctrl.sigs.round == 0 { vpu_defs_pkg.RTZ }
    elif inst_rm == vpu_defs_pkg.VPU_RM_DYN or id_vpu_ctrl.sigs.gcvt != 0 { id_fcsr_rm }
    else { inst_rm }

  // Previous-configuration reuse: a TensorFMA micro-op that repeats the request already at EX does not
  // reload the lane control.
  const id_use_prev_sigs = ml.id_inst_fma_en != 0 and pack_sigs(s=id_vpu_ctrl.sigs) == ex_req_word#[IN_SIGS..<(IN_SIGS + 45)] and ex_rm == id_vpu_ctrl.rm

  // Operand type.
  id_vpu_ctrl.typ = if id_use_prev_sigs { 0 } else { id_inst#[20..<22] }
  // Immediate operand: its source bits depend on the command.
  const imm_fswizz:U20 = (id_inst#[20..<25] << 3) | inst_rm
  const imm_default:U20 = (inst_rs3 << 5) | inst_rs2
  const imm_rast:U20 = (id_inst#[23..<25] << 2) | id_inst#[18..<20]
  id_vpu_ctrl.imm = if id_use_prev_sigs { 0 }
    elif id_vpu_ctrl.sigs.cmd == vpu_defs_pkg.VPU_FCMD_FBCI { id_inst#[12..<32] }
    elif id_vpu_ctrl.sigs.cmd == vpu_defs_pkg.VPU_FCMD_MPOPC_RAST { imm_rast }
    elif id_vpu_ctrl.sigs.cmd == vpu_defs_pkg.VPU_FCMD_FSWIZZ or id_vpu_ctrl.sigs.maskop != 0 { imm_fswizz }
    else { imm_default }

  id_regfile_raddr1 = id_ra1
  id_regfile_raddr2 = id_ra2
  id_regfile_raddr3 = id_ra3

  // For ML micro-ops the tensor register files feed the operands, so the vector register read is skipped
  // (except for the reduce forms, which still read it).
  const id_not_reduce = id_vpu_ctrl.sigs.cmd != vpu_defs_pkg.VPU_FCMD_XOR and id_vpu_ctrl.sigs.cmd != vpu_defs_pkg.VPU_FCMD_SETZ
  const id_tenb_regfile_bypass_en = ml.id_inst_fma_en != 0 and id_not_reduce
  const id_tena_regfile_bypass_en = id_tenb_regfile_bypass_en or ml.id_inst_tena_quant_en != 0

  // Register-file read enables; a gather/scatter in flight reads all three ports.
  const ex_gscing = ex_core_gscing != 0
  const id_ren_e0:U1 = U1((id_core_valid_int and (id_vpu_ctrl.sigs.ren1 != 0 or id_vpu_ctrl.sigs.rend != 0) and not id_tena_regfile_bypass_en) or ex_gscing)
  const id_ren_e1:U1 = U1((id_core_valid_int and id_vpu_ctrl.sigs.ren2 != 0 and not id_tenb_regfile_bypass_en) or ex_gscing)
  const id_ren_e2:U1 = U1((id_core_valid_int and id_vpu_ctrl.sigs.ren3 != 0) or ex_gscing)
  id_regfile_ren.e0 = id_ren_e0
  id_regfile_ren.e1 = id_ren_e1
  id_regfile_ren.e2 = id_ren_e2

  // Thread per read port: ML micro-ops always read thread 0; a gather/scatter reads its own thread.
  const ex_thread_all:U3 = if ex_thread_id_int != 0 { 7 } else { 0 }
  const id_thread_all:U3 = if id_core_thread_id_int != 0 { 7 } else { 0 }
  const id_regfile_thread_id_w:U3 = if ml.id_inst_fma_en != 0 or ml.id_inst_en != 0 { 0 }
    elif ex_gscing { ex_thread_all }
    else { id_thread_all }
  id_regfile_thread_id = id_regfile_thread_id_w

  // Bypass forcing for the transcendental micro-ops, by command:
  //   txfma_in0: RCP_FMA2, LOG_FMA2, LOG_MUL, EXP_FMA2, NR2_FRCPFXP    txfma_in1: EXP_RR    txfma_in2: LOG_FMA1
  //   shsw_in1: LOG_MUL                                               shsw_in2: LOG_FMA2
  const id_cmd = id_vpu_ctrl.sigs.cmd
  const id_bypass_force:BypassForce = (shsw_in1=U1(id_cmd == vpu_defs_pkg.VPU_TRANS_LOG_MUL), shsw_in2=U1(id_cmd == vpu_defs_pkg.VPU_TRANS_LOG_FMA2), txfma_in0=U1(id_cmd == vpu_defs_pkg.VPU_TRANS_RCP_FMA2 or id_cmd == vpu_defs_pkg.VPU_TRANS_LOG_FMA2 or id_cmd == vpu_defs_pkg.VPU_TRANS_LOG_MUL or id_cmd == vpu_defs_pkg.VPU_TRANS_EXP_FMA2 or id_cmd == vpu_defs_pkg.VPU_FCMD_NR2_FRCPFXP), txfma_in1=U1(id_cmd == vpu_defs_pkg.VPU_TRANS_EXP_RR), txfma_in2=U1(id_cmd == vpu_defs_pkg.VPU_TRANS_LOG_FMA1))

  const id_bypass_force_bits:U5 = (id_bypass_force.shsw_in2, id_bypass_force.shsw_in1, id_bypass_force.txfma_in2, id_bypass_force.txfma_in1, id_bypass_force.txfma_in0)#[..]
  // The control word registered for EX.
  const id_sigs_bits:U45 = pack_sigs(s=id_vpu_ctrl.sigs)
  const id_typ:U2 = id_vpu_ctrl.typ
  const id_rm:U3 = id_vpu_ctrl.rm
  const id_imm:U20 = id_vpu_ctrl.imm
  const zero1:U1 = 0
  const zero32:U32 = 0
  const id_vpu_word:U167 = (zero32, zero32, zero32, id_typ, id_rm, id_imm, id_sigs_bits, zero1)#[..]

  // ---- ID -> EX registers ---------------------------------------------------------------------------
  if id_core_valid_int {
    ex_ra1 = id_ra1
    ex_ra2 = id_ra2
    ex_ra3 = id_ra3
    ex_core_inst = id_inst
    ex_ml_mask = id_ml_mask
    ex_tensorfma_en = ml.id_inst_fma_en != 0
    ex_tena_regfile_bypass_en = U1(id_tena_regfile_bypass_en)
    ex_tenb_regfile_bypass_en = U1(id_tenb_regfile_bypass_en)
  }
  // The control sets feed stall decisions in later stages, so they are reset and only reloaded when the
  // ID instruction changes them.
  if id_core_valid_int and not id_use_prev_sigs {
    ex_vpu_ctrl = id_vpu_word
    ex_bypass_force_ctrl_q = id_bypass_force_bits
  }
  ex_regfile_thread_id = id_regfile_thread_id_w
  ex_mova_mx = id_core_valid_int and id_vpu_ctrl.sigs.cmd == vpu_defs_pkg.VPU_FCMD_MOVA_M_X
  if not ex_gscing {
    ex_ml_inst_val = ml.id_inst_en != 0
    ex_ctrl_valid = id_core_valid_int
  }
  // Toggles on every tensor-B fill: selects the tensor-B half that the next fill writes.
  if dcache_scp_resp.fill_is_tenb != 0 {
    f3_tenb_pass = ~f3_tenb_pass
  }

  // ---- EX / F1: tensor zero masks and lane gating ----------------------------------------------------
  // Per tensor-register row, which lanes hold all-zero data (computed when the row is written), so the
  // FMA lanes can be gated off when an operand is zero.
  const ex_tima_on = ml.ex_tima_valid != 0
  const ex_ra2_ten:U3 = ex_ra2#[0..<3]
  const ex_tena_sel:U1 = if ex_tima_on { ml.ex_tima_tena_raddr } else { ex_ra1#[0] }
  const ex_tensora_zero_mask_mux:U8 = if ml.ex_tentmp_ren != 0 { ex_tensortmp_zero_mask[ml.ex_tentmp_raddr] }
    else { ex_tensora_zero_mask[ex_tena_sel] }
  const ex_tenb_sel0:U3 = if ex_tima_on { ml.ex_tima_tenb_raddr#[0..<3] } else { ex_ra2_ten }
  const ex_tenb_sel1:U3 = if ex_tima_on { (ml.ex_tima_tenb_raddr | 1)#[0..<3] } else { ex_ra2_ten }
  const ex_tensorb_zero_mask_tima0:U8 = ex_tensorb_zero_mask[ex_tenb_sel0]
  // The second tensor-B row is not used (never gates) when its TIMA lane is masked off.
  mut ex_tensorb_zero_mask_tima1:U8 = ex_tensorb_zero_mask[ex_tenb_sel1]
  for l in 0..<LANES {
    ex_tensorb_zero_mask_tima1#[l] = ex_tensorb_zero_mask_tima1#[l] | U1(ml.ex_tima_mask#[2*l + 1] == 0)
  }
  const ex_tensor_zero_mask:U8 = ex_tensora_zero_mask_mux | (ex_tensorb_zero_mask_tima0 & ex_tensorb_zero_mask_tima1)

  // TIMA valid per lane and unit: unqualified valid, minus zero-gated lanes (only while a TIMA pass is in
  // progress), AND the per-unit mask.
  const ex_tima_gate = ml.ex_tima_ren3 != 0 and ml.ex_tima_last_pass == 0
  mut ex_tima_valid_w:U16 = 0
  for l in 0..<LANES {
    const lane_zero = ex_tensor_zero_mask#[l] != 0 and ex_tima_gate
    for t in 0..<2 {
      ex_tima_valid_w#[2*l + t] = U1(ex_tima_on and not lane_zero and ml.ex_tima_mask#[2*l + t] != 0)
    }
  }

  // TXFMA lane enables: gated by the zero mask for TensorFMA multiplies and by the ML lane mask.
  const ex_txfma_valid_all = ex_ctrl_valid_qual and ex_sigs.s.txfma != 0
  const ex_fma_gate_mask:U8 = if ex_cmd == vpu_defs_pkg.VPU_FCMD_MADD and ex_tensorfma_en { ex_tensor_zero_mask } else { 0 }
  const ex_ml_gate_mask:U8 = if ex_ml_inst_val { ex_ml_mask } else { 0xff }
  const ex_txfma_valid_w:U8 = if ex_txfma_valid_all { (~ex_fma_gate_mask) & ex_ml_gate_mask } else { 0 }
  const ex_ml_mask_to_f2:U8 = if ex_txfma_valid_all { (~ex_fma_gate_mask) & ex_ml_mask } else { ex_ml_mask }

  // "All lanes have had a first valid" tracking for the previous-control reuse.
  mut ex_txfma_valid_all_en:Bool = f2_txfma_valid_all_en
  if f0_core_ctrl.tensorfma_start != 0 or (ex_tensorfma_en and not ex_same_sigs) {
    ex_txfma_valid_all_en = false
  }
  if ex_tensorfma_en and ex_txfma_valid_w == 0xff {
    ex_txfma_valid_all_en = true
  }

  // Store data: each lane's first bypassed operand; gather/scatter keeps the second one (the "fs" source).
  const ex_store_data_lane_en = (ex_cmd == vpu_defs_pkg.VPU_FCMD_MVZ_FX or ex_cmd == vpu_defs_pkg.VPU_FCMD_MVS_FX or ex_sigs.s.ldst != 0) and ex_ctrl_valid_qual
  mut ex_store_data_lane:[LANES]U32 = nil
  mut ex_gsc_fs_next:[LANES]U32 = nil
  for i in 0..<LANES {
    ex_store_data_lane[i] = ex_regfile_rdata_bypass#[(64*i)..<(64*i + 32)]
    ex_gsc_fs_next[i] = ex_regfile_rdata_bypass#[(64*i + 32)..<(64*i + 64)]
  }
  if ex_gscing {
    ex_gsc_fs = ex_gsc_fs_next
  }

  ex_regfile_raddr1 = ex_ra1
  ex_regfile_raddr2 = ex_ra2
  ex_regfile_raddr3 = ex_ra3
  // The request bundle, leaf by leaf: a whole-bundle store into the nested `ex_req.sigs` is not lowered (livehd_bugs/L4u2_03).
  // prp-style-allow whole-tuple-copy
  ex_req.use_prev_sigs = ex_req_word#[IN_USE_PREV]
  ex_req.sigs.cmd = ex_sigs.s.cmd
  ex_req.sigs.txfma = ex_sigs.s.txfma
  ex_req.sigs.shsw = ex_sigs.s.shsw
  ex_req.sigs.rom = ex_sigs.s.rom
  ex_req.sigs.scatter = ex_sigs.s.scatter
  ex_req.sigs.cvt = ex_sigs.s.cvt
  ex_req.sigs.trans = ex_sigs.s.trans
  ex_req.sigs.gcvt = ex_sigs.s.gcvt
  ex_req.sigs.fromintf = ex_sigs.s.fromintf
  ex_req.sigs.tointm = ex_sigs.s.tointm
  ex_req.sigs.tointf = ex_sigs.s.tointf
  ex_req.sigs.maskop = ex_sigs.s.maskop
  ex_req.sigs.ldst = ex_sigs.s.ldst
  ex_req.sigs.m0ren = ex_sigs.s.m0ren
  ex_req.sigs.mallren = ex_sigs.s.mallren
  ex_req.sigs.mren1 = ex_sigs.s.mren1
  ex_req.sigs.mren2 = ex_sigs.s.mren2
  ex_req.sigs.wen = ex_sigs.s.wen
  ex_req.sigs.ren1 = ex_sigs.s.ren1
  ex_req.sigs.ren2 = ex_sigs.s.ren2
  ex_req.sigs.ren3 = ex_sigs.s.ren3
  ex_req.sigs.rend = ex_sigs.s.rend
  ex_req.sigs.swap12 = ex_sigs.s.swap12
  ex_req.sigs.swap23 = ex_sigs.s.swap23
  ex_req.sigs.swap13 = ex_sigs.s.swap13
  ex_req.sigs.vector = ex_sigs.s.vector
  ex_req.sigs.dtype = ex_sigs.s.dtype
  ex_req.sigs.fromint = ex_sigs.s.fromint
  ex_req.sigs.toint = ex_sigs.s.toint
  ex_req.sigs.fma = ex_sigs.s.fma
  ex_req.sigs.fms = ex_sigs.s.fms
  ex_req.sigs.add = ex_sigs.s.add
  ex_req.sigs.sub = ex_sigs.s.sub
  ex_req.sigs.mul = ex_sigs.s.mul
  ex_req.sigs.round = ex_sigs.s.round
  ex_req.sigs.wflags = ex_sigs.s.wflags
  ex_req.imm = ex_imm
  ex_req.rm = ex_rm
  ex_req.typ = ex_req_word#[IN_TYP..<(IN_TYP + 2)]
  ex_req.in1 = ex_req_word#[IN_IN1..<(IN_IN1 + 32)]
  ex_req.in2 = ex_req_word#[IN_IN2..<(IN_IN2 + 32)]
  ex_req.in3 = ex_req_word#[0..<32]
  ex_bypass_force_ctrl.txfma_in0 = ex_bypass_force_ctrl_q#[4]
  ex_bypass_force_ctrl.txfma_in1 = ex_bypass_force_ctrl_q#[3]
  ex_bypass_force_ctrl.txfma_in2 = ex_bypass_force_ctrl_q#[2]
  ex_bypass_force_ctrl.shsw_in1 = ex_bypass_force_ctrl_q#[1]
  ex_bypass_force_ctrl.shsw_in2 = ex_bypass_force_ctrl_q#[0]
  const ex_core_ctrl_w:ExCoreCtrl = (gsc_fs=ex_gsc_fs[ex_core_gsc_src], illegal_rm=U1(ex_rm >= 5 and ex_sigs.s.round != 0), ps_mask=ex_mask_rf0, tointm=U1(ex_sigs.s.tointm != 0 and ex_sigs.s.shsw == 0))
  ex_core_ctrl = ex_core_ctrl_w
  ex_tima_valid = ex_tima_valid_w
  ex_tima_valid_unqual = ml.ex_tima_valid
  ex_tima_sa = ml.ex_tima_sa
  ex_tima_sb = ml.ex_tima_sb
  ex_tima_tenb_raddr = ml.ex_tima_tenb_raddr
  ex_sh_sw_valid = U1(ex_ctrl_valid_qual and ex_sigs.s.shsw != 0)
  ex_sh_sw_clock_valid = U1(ex_ctrl_valid and ex_sigs.s.shsw != 0)
  ex_txfma_valid = ex_txfma_valid_w
  ex_txfma_clock_valid = U1(ex_ctrl_valid and ex_sigs.s.txfma != 0)
  const ex_rom_valid_w:U1 = U1(ex_ctrl_valid_qual and ex_sigs.s.rom != 0)
  ex_rom_valid = ex_rom_valid_w
  ex_rom_clock_valid = U1(ex_ctrl_valid and ex_sigs.s.rom != 0)

  // ---- EX -> F2 registers ---------------------------------------------------------------------------
  f2_ctrl_valid_qual = ex_ctrl_valid_qual and ex_alive
  f2_ctrl_valid = ex_ctrl_valid_kill
  f2_ctrl_killed_prev = ex_ctrl_killed
  f2_txfma_valid_all_en = ex_txfma_valid_all_en
  f2_wen = ex_wen and ex_alive
  f2_ml_inst_val = ex_ml_inst_val
  f2_mova_mx = ex_mova_mx
  if ex_ctrl_valid_kill {
    f2_regfile_waddr = ex_core_inst#[7..<12]
    f2_ml_mask = ex_ml_mask_to_f2
    f2_thread_id = ex_thread_for_f2
    f2_ml_use_prev_sigs = ex_use_prev_sigs
    f2_lane_idx = ex_lane_idx
  }
  if ex_ctrl_valid_kill and not ex_use_prev_sigs {
    f2_req = ex_req_word
  }
  if ex_ctrl_valid_kill and not ex_use_prev_sigs and ex_store_data_lane_en {
    f2_gsc_src = ex_core_gsc_src
    f2_store_data_lane = ex_store_data_lane
  }

  // ---- Mask unit -------------------------------------------------------------------------------------
  // Compare results of the TXFMA come back to the mask registers at F8 only for mask-producing ops.
  const f8_regmask_from_txfma = f8_sigs.s.tointm != 0 and f8_sigs.s.txfma != 0
  const f8_regmask_comp_res:U8 = if f8_regmask_from_txfma { f8_txfma_comp_res } else { 0 }
  // Loads/stores through lane 0 ignore the mask, as does the conditional move of the mask itself.
  const ex_ignore_mask = (ex_sigs.s.ldst != 0 and ex_sigs.s.m0ren == 0) or ex_cmd == vpu_defs_pkg.VPU_FCMD_FCMOVM
  const mask = vpu_mask::[name=mask](clk_i=clock_sec, rst_ni=~reset, ex_in_valid_i=U1(ex_ctrl_valid_qual and ex_sigs.s.maskop != 0), ex_inst_valid_i=U1(ex_ctrl_valid_kill), ex_regfile_raddr1_i=ex_ra1#[0..<3], ex_regfile_raddr2_i=ex_ra2#[0..<3], ex_cmd_i=ex_cmd, ex_imm_i=ex_imm#[0..<8], ex_fromint_i=ex_sigs.s.fromint, ex_fromint_data_i=ex_core_fromint_data, ex_thread_id_i=ex_thread_for_f2, ex_ignore_mask_i=U1(ex_ignore_mask), f2_thread_id_i=f2_thread_id, f2_wen_i=U1(f2_wen and f2_sigs.s.toint == 0), f2_core_kill_i=f2_core_kill, f2_waddr_i=f2_regfile_waddr#[0..<3], f2_maskop_i=f2_sigs.s.maskop, f2_tointm_i=f2_sigs.s.tointm, f3_thread_id_i=f3_thread_id, f3_regmask_from_txfma_i=U1(f3_sigs.s.tointm != 0 and f3_sigs.s.txfma != 0), f3_regmask_from_short_i=U1(f3_sigs.s.tointm != 0 and f3_sigs.s.shsw != 0), f3_core_kill_i=f3_core_kill, f3_regmask_wdata_lane_i=f3_regmask_wdata_lane, f4_regmask_from_txfma_i=U1(f4_sigs.s.tointm != 0 and f4_sigs.s.txfma != 0), f4_core_kill_i=f4_core_kill, f5_thread_id_i=f5_thread_id, f6_thread_id_i=f6_thread_id, f7_thread_id_i=f7_thread_id, f8_thread_id_i=f8_thread_id, f8_regmask_comp_res_i=(const e0=f8_regmask_comp_res#[0], const e1=f8_regmask_comp_res#[1], const e2=f8_regmask_comp_res#[2], const e3=f8_regmask_comp_res#[3], const e4=f8_regmask_comp_res#[4], const e5=f8_regmask_comp_res#[5], const e6=f8_regmask_comp_res#[6], const e7=f8_regmask_comp_res#[7]))
  ex_mask_rf0 = mask.ex_mask_rf0_o
  ex_mask_in1 = mask.ex_mask_in1_o
  const f8_toint_mask_rf = mask.f8_toint_data_o
  const f8_regmask_store = mask.f8_regmask_store_o

  // ---- F2 ----------------------------------------------------------------------------------------------
  const f2_trans = f2_sigs.s.trans != 0
  const f2_kill = f2_core_kill != 0 and not f2_trans and not f2_ml_inst_val // core kills are ignored for generated ops
  const f2_ctrl_killed = f2_kill or f2_ctrl_killed_prev

  // Register-file write mask: ML micro-ops use their own lane mask; otherwise all lanes for a scalar write
  // (or a mask move), the mask for a vector one, none for ops that write the mask registers or the integer file.
  const f2_plain_write = f2_wen and f2_sigs.s.maskop == 0 and f2_sigs.s.tointm == 0 and f2_sigs.s.toint == 0
  const f2_all_lanes = (f2_ctrl_valid_qual and f2_sigs.s.vector == 0) or f2_sigs.s.cmd == vpu_defs_pkg.VPU_FCMD_FCMOVM
  const f2_regfile_wmask:U8 = if f2_wen and f2_ml_inst_val { f2_ml_mask }
    elif f2_plain_write { if f2_all_lanes { 0xff } else { mask.f2_mask_rf0_o } }
    else { 0 }

  // Lane swizzle: lane L reads the other three lanes of its group of four (self excluded, in order).  The
  // pack commands instead gather the low halves (PACKREPH, per lane pair) or low bytes (PACKREPB, per
  // lane quad) of the group.
  mut f2_fswizz_rdata1_w:U256 = 0
  mut f2_fswizz_rdata2_w:U256 = 0
  mut f2_fswizz_rdata3_w:U256 = 0
  for lane in 0..<LANES {
    const grp = lane & 4
    const pos = lane & 3
    const src1 = grp + (if pos == 0 { 1 } else { 0 })
    const src2 = grp + (if pos <= 1 { 2 } else { 1 })
    const src3 = grp + (if pos <= 2 { 3 } else { 2 })
    const quad = lane & 1
    const packreph:U32 = (f2_fswizz_rdata#[(64*pos + 32)..<(64*pos + 48)] << 16) | f2_fswizz_rdata#[(64*pos)..<(64*pos + 16)]
    const packrepb:U32 = (f2_fswizz_rdata#[(128*quad + 96)..<(128*quad + 104)] << 24) | (f2_fswizz_rdata#[(128*quad + 64)..<(128*quad + 72)] << 16) | (f2_fswizz_rdata#[(128*quad + 32)..<(128*quad + 40)] << 8) | f2_fswizz_rdata#[(128*quad)..<(128*quad + 8)]
    mut rdata1:U32 = f2_fswizz_rdata#[(32*src1)..<(32*src1 + 32)]
    if f2_sigs.s.cmd == vpu_defs_pkg.VPU_FCMD_PACKREPH {
      rdata1 = packreph
    }
    if f2_sigs.s.cmd == vpu_defs_pkg.VPU_FCMD_PACKREPB {
      rdata1 = packrepb
    }
    f2_fswizz_rdata1_w#[(32*lane)..<(32*lane + 32)] = rdata1
    f2_fswizz_rdata2_w#[(32*lane)..<(32*lane + 32)] = f2_fswizz_rdata#[(32*src2)..<(32*src2 + 32)]
    f2_fswizz_rdata3_w#[(32*lane)..<(32*lane + 32)] = f2_fswizz_rdata#[(32*src3)..<(32*src3 + 32)]
  }
  f2_fswizz_rdata1 = f2_fswizz_rdata1_w
  f2_fswizz_rdata2 = f2_fswizz_rdata2_w
  f2_fswizz_rdata3 = f2_fswizz_rdata3_w

  // Control handed to the core's store path.
  const f2_core_fma:U1 = U1(f2_sigs.s.txfma != 0)
  const f2_core_tointm:U1 = U1(f2_sigs.s.tointm != 0 and f2_sigs.s.shsw == 0)
  f2_core_ctrl.fma = f2_core_fma
  f2_core_ctrl.store_data = f2_store_data_lane#[..]
  f2_core_ctrl.scatter_data = f2_store_data_lane[f2_gsc_src]
  f2_core_ctrl.tointm = f2_core_tointm

  // ---- F2 -> F3 registers ---------------------------------------------------------------------------
  const f2_pass = f2_ctrl_valid_qual and not f2_kill
  f3_ctrl_valid_qual = f2_pass
  f3_ctrl_valid = f2_ctrl_valid
  f3_ctrl_killed_prev = f2_ctrl_killed
  f3_ml_inst_val = f2_ml_inst_val
  f3_wen = f2_wen and not f2_kill
  f3_thread_id = f2_thread_id
  f3_mova_mx = f2_mova_mx
  f3_regfile_wmask = if f2_pass { f2_regfile_wmask } else { 0 }
  if f2_ctrl_valid_qual {
    f3_ml_use_prev_sigs = f2_ml_use_prev_sigs
    f3_lane_idx = f2_lane_idx
  }
  if f2_ctrl_valid {
    f3_regfile_waddr = f2_regfile_waddr
  }
  if f2_ctrl_valid and not f2_ml_use_prev_sigs {
    f3_ctrl_sigs = f2_req#[IN_SIGS..<(IN_SIGS + 45)]
  }

  // ---- F3: load write-back and tensor register-file writes --------------------------------------------
  // A load response writes the vector register file through the load port (a second write path), unless
  // it is a masked-off partial vector response.
  const wb_resp_valid = wb_dmem_resp_val != 0 and (wb_dmem_resp.ps_mask != 0 or wb_dmem_resp.typ#[3] == 0)
  const wb_resp_is_gather = wb_dmem_resp.typ == minion_dcache_pkg.DcTypePsGs8 or wb_dmem_resp.typ == minion_dcache_pkg.DcTypePsGs16 or wb_dmem_resp.typ == minion_dcache_pkg.DcTypePsGs32
  const wb_load_dtype:U2 = (wb_dmem_resp.typ#[3] << 1) | U1(wb_dmem_resp.typ#[0] != 0 and wb_dmem_resp.typ#[3] == 0)
  const reduce_load = ml.reduce_load_ctrl.wen != 0

  mut f3_regfile_wmask_l:U16 = 0
  mut f3_regfile_wdata_l:U256 = 0
  if wb_resp_valid {
    if wb_resp_is_gather {
      // A gather response lands in one lane (all its bypass sources).
      f3_regfile_wmask_l#[(2*wb_dmem_resp.gdst)..<(2*wb_dmem_resp.gdst + 2)] = 3
      f3_regfile_wdata_l#[(32*wb_dmem_resp.gdst)..<(32*wb_dmem_resp.gdst + 32)] = wb_dmem_resp.data#[0..<32]
    } else {
      for i in 0..<LANES {
        // Reduce loads do not bypass to sources 2/3; PS loads follow the response mask.
        f3_regfile_wmask_l#[(2*i)..<(2*i + 2)] = if reduce_load { 1 } elif wb_load_dtype == vpu_defs_pkg.VPU_LOAD_DTYPE_PS { if wb_dmem_resp.ps_mask#[i] != 0 { 3 } else { 0 } } else { 3 }
      }
      const word:U32 = wb_dmem_resp.data#[0..<32]
      const broadcast:U256 = (word, word, word, word, word, word, word, word)#[..]
      f3_regfile_wdata_l = if wb_dmem_resp.typ == minion_pkg.DcTypePsBr { broadcast } else { wb_dmem_resp.data }
    }
    // S/D loads zero-extend above 64 bits (the data cache clears the rest).
    if wb_load_dtype == vpu_defs_pkg.VPU_LOAD_DTYPE_S or wb_load_dtype == vpu_defs_pkg.VPU_LOAD_DTYPE_D {
      f3_regfile_wdata_l#[64..<256] = 0
    }
  }
  const f3_regfile_wen_l_w:U1 = U1(f3_regfile_wmask_l != 0)
  // Reduce loads override the thread and address of the response.
  const f3_regfile_thrid_l:U1 = if reduce_load { ml.reduce_load_ctrl.thread_id } else { wb_dmem_resp.thread_id }
  const f3_regfile_waddr_l:U5 = if reduce_load { ml.reduce_load_ctrl.waddr } else { wb_dmem_resp.addr }

  // Tensor register files: TensorFMA loads write tensor A (broadcast from one scratchpad word) or tensor B
  // (a whole line), tensor-tmp takes the upper word of a 64-bit chunk.
  const tfma_load = ml.tensorfma_load_ctrl
  const f3_tena_regfile_wen_l_w = tfma_load.wen != 0 and tfma_load.waddr#[3] == 0
  const f3_tenb_regfile_wen_l_w = tfma_load.wen != 0 and tfma_load.waddr#[3] != 0
  const f3_tena_regfile_waddr_l:U1 = if f3_tena_regfile_wen_l_w { tfma_load.waddr#[0] } else { 0 }
  const f3_tenb_regfile_waddr_l_w:U3 = if f3_tenb_regfile_wen_l_w { tfma_load.waddr#[0..<3] } else { 0 }
  const f3_tena_regfile_wdata_l:U32 = (dcache_scp_data >> (LANE_BITS*tfma_load.broadcast_sel))#[0..<32]
  const f3_tentmp_regfile_wdata_l:U64 = (dcache_scp_data >> (2*LANE_BITS*(tfma_load.broadcast_sel >> 1)))#[0..<64]
  const f3_tentmp_msb_regfile_wdata_l:U32 = f3_tentmp_regfile_wdata_l#[32..<64]
  const f3_tenb_regfile_wdata_l_w:U256 = if dcache_scp_resp.fill_is_tenb != 0 { dcache_tenb_data } else { dcache_scp_data }

  // All-zero detection per written row.
  const f3_zero_data_a:U8 = if f3_tena_regfile_wdata_l == 0 { 0xff } else { 0 }
  const f3_zero_data_tmp:U8 = if f3_tentmp_msb_regfile_wdata_l == 0 { 0xff } else { 0 }
  mut f3_zero_data_b:U8 = 0
  for i in 0..<LANES {
    f3_zero_data_b#[i] = U1(f3_tenb_regfile_wdata_l_w#[(32*i)..<(32*i + 32)] == 0)
  }
  const f3_tenb_zero_sel:U3 = if dcache_scp_resp.fill_is_tenb != 0 { (dcache_scp_resp.tenb_line#[0..<2] << 1) | f3_tenb_pass }
    else { f3_tenb_regfile_waddr_l_w }
  // Each zero-mask table is updated as a whole (one row replaced) when its row is written.
  mut ex_tensora_zero_mask_next:[2]U8 = ex_tensora_zero_mask
  ex_tensora_zero_mask_next[f3_tena_regfile_waddr_l] = f3_zero_data_a
  mut ex_tensortmp_zero_mask_next:[8]U8 = ex_tensortmp_zero_mask
  ex_tensortmp_zero_mask_next[ml.f3_tentmp_waddr] = f3_zero_data_tmp
  mut ex_tensorb_zero_mask_next:[8]U8 = ex_tensorb_zero_mask
  ex_tensorb_zero_mask_next[f3_tenb_zero_sel] = f3_zero_data_b
  if f3_tena_regfile_wen_l_w {
    ex_tensora_zero_mask = ex_tensora_zero_mask_next
  }
  if ml.f3_tentmp_wen != 0 {
    ex_tensortmp_zero_mask = ex_tensortmp_zero_mask_next
  }
  if f3_tenb_regfile_wen_l_w or dcache_scp_resp.fill_is_tenb != 0 {
    ex_tensorb_zero_mask = ex_tensorb_zero_mask_next
  }

  const tena_rf = vpu_tensora_rf::[name=tena_rf](clk_i=clock_sec, rd_addr_i=ex_tena_sel, wr_en_i=U1(f3_tena_regfile_wen_l_w), wr_en_early_i=ml.load_ctrl_pre_tena_wen, wr_addr_i=f3_tena_regfile_waddr_l, wr_data_i=f3_tena_regfile_wdata_l)
  // Tensor-tmp always writes the upper word of the 64-bit chunk.
  const tentmp_rf = vpu_tensortmp_rf::[name=tentmp_rf](clk_i=clock_sec, rd_addr_i=ml.ex_tentmp_raddr, wr_en_i=ml.f3_tentmp_wen, wr_en_early_i=ml.f2_tentmp_wen_early, wr_addr_i=ml.f3_tentmp_waddr, wr_data_i=f3_tentmp_msb_regfile_wdata_l)

  // Tensor A operand read: tensor-tmp or tensor A (TIMA), then the tensor-quant data per lane; the TIMA copy
  // is zeroed when the conv-skip mask says so.
  const ex_tena_rf_tima_rdata_w:U32 = if ml.ex_tentmp_ren != 0 { tentmp_rf#[0..<32] } else { tena_rf#[0..<32] }
  mut ex_tena_rf_rdata_w:U256 = 0
  for i in 0..<LANES {
    ex_tena_rf_rdata_w#[(32*i)..<(32*i + 32)] = if ml.ex_tquant_ren != 0 { ml.ex_tquant_rdata#[(32*i)..<(32*i + 32)] }
      else { ex_tena_rf_tima_rdata_w }
  }
