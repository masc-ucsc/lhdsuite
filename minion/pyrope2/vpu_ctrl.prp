  const dbg_data0:U128 = (id_typ, id_rm, id_imm, id_sigs_bits, zero1, id_core_inst_bits, id_core_thread_id, ex_ra1, ex_ra2, ex_ra3, ex_mask_rf0, zero1)#[..]
