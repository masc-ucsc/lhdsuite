  const io_wait_tenb:U1 = ml.io_events_wait_tenb
  const io_ev:IoEvents = (e0=io_wait_tenb, e1=U1(ex_tima_valid_w != 0), e10=f0_core_ctrl.tensorquant_start, e2=U1(f8_ctrl_valid_qual and f8_sigs.s.dtype == vpu_defs_pkg.VPU_DTYPE_F16_F32 and f8_sigs.s.txfma != 0), e3=U1(f8_ctrl_valid_qual and f8_sigs.s.txfma != 0 and f8_sigs.s.trans == 0), e4=U1(f8_ctrl_valid_qual and f8_sigs.s.dtype == vpu_defs_pkg.VPU_DTYPE_INT and f8_sigs.s.txfma != 0), e5=U1(f8_ctrl_valid_qual and f8_trans_wen_ctrl_en and f8_sigs.s.trans == 0), e6=U1(f8_ctrl_valid_qual and f8_sigs.s.shsw != 0), e7=U1(f8_ctrl_valid_qual and f8_sigs.s.maskop != 0), e8=f0_core_ctrl.tensorfma_start, e9=f0_core_ctrl.reduce_start)

