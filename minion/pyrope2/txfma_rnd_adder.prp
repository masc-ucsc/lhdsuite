// Rounding adder of the txfma fraction (verilog: txfma_rnd_adder, left_bit=32, right_bit=0, rnd_ps=1).
// Adds a round vector built from rnd_ctl and the carry-in to `in`; the result drops the lsb.
// rnd_ctl = {ph(2), ps(2), int(1)} lands at bits 22:21 (ph), 9:8 (ps) and 1 (int) of the round vector.
const txfma_adder = import("txfma_adder.txfma_adder")

pub comb txfma_rnd_adder(cin:U1, `in`:U33, rnd_ctl:U5) -> (out:U32) {
  const round_vector:U33 = (rnd_ctl#[3..<5] << 21) | (rnd_ctl#[1..<3] << 8) | (rnd_ctl#[0] << 1)
  const sum = txfma_adder<Width=33>(a_i=`in`, b_i=round_vector, cin_i=cin)
  out = sum#[1..<33]
}
