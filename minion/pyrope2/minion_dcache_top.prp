    s4_block_addr#[k] = lane_addr#[5]
  }
  const s4_sel_msg = not s4_valid and l2_resp_int.opcode == minion_pkg.EtLinkRspMsgRcvData and l2_resp_is_port_data and l2_resp_valid_int
  const s4_sel_fill = not s4_valid and not s4_sel_msg and l2_resp_valid_int and l2_da_write
  const s4_sel_tl0 = not s4_valid and not s4_sel_msg and not s4_sel_fill and s4_tl0_load_valid != 0
  const s4_sel_cfg_clear = not s4_valid and not s4_sel_msg and not s4_sel_fill and s4_tl0_load_valid == 0 and s4_cfg_da_clear_val
  const s4_sel_co_clear = not s4_valid and not s4_sel_msg and not s4_sel_fill and s4_tl0_load_valid == 0 and not s4_cfg_da_clear_val and s4_co_da_clear_val
  const s4_cfg_da_clear_rdy = s4_sel_cfg_clear
  const s4_co_da_clear_rdy = s4_sel_co_clear
  const s4_way_enc:U2 = way_encode(s4_way)
  const msg_size = l2_resp_int.size
  const msg_full_line = msg_size == minion_dcache_pkg.EtLinkLine or msg_size == minion_dcache_pkg.EtLinkHLine
  mut s4_wr_data:U312 = 0
  for k in 0..<4 {
    mut lane_valid:U1 = 0
    mut lane_valid_h:U1 = 0
    mut lane_way:U2 = 0
    mut lane_addr:U10 = 0
    mut lane_data:U64 = 0
    if s4_valid {
      lane_valid = s4_rq.chunk_read#[k]
      lane_valid_h = lane_valid
      lane_way = s4_way_enc
      lane_addr = s4_req_da_write_addr#[k*10..<(k + 1)*10]
      lane_data = s4_rq.data#[k*64..<(k + 1)*64]
    } elif s4_sel_msg {
      // Message-port data: a line, a half line (to the banks the address names) or a double/quad word.
      lane_valid = U1(msg_full_line or (msg_size == minion_dcache_pkg.EtLinkQWord and core_ctrl_i.msg_port_wr_addr#[4] == k/2) or core_ctrl_i.msg_port_wr_addr#[3..<5] == k)
      lane_valid_h = lane_valid
      lane_way = core_ctrl_i.msg_port_wr_way
      lane_addr = core_ctrl_i.msg_port_wr_addr
      lane_data = if msg_size == minion_dcache_pkg.EtLinkDWord { l2_resp_int.data#[0..<64] } elif msg_size == minion_dcache_pkg.EtLinkQWord { l2_resp_int.data#[(k%2)*64..<(k%2 + 1)*64] } else { l2_resp_int.data#[k*64..<(k + 1)*64] }
    } elif s4_sel_fill {
