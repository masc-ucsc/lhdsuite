      lane_valid_h = lane_valid
      lane_way = s4_tl0_load_way
      lane_addr = s4_tl0_load_addr
      lane_data = s4_tl0_load_data#[k*64..<(k + 1)*64]
    } elif s4_sel_cfg_clear {
