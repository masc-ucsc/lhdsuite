    }
  }

  // Tensor-load 1 returns its data through the VPU scratchpad interface one cycle later.
  const s3_vpu_scp_resp_fill_early = l2_resp_valid_int and l2_resp_is_for_tensor_1 and s4_tl1_tenb_ready_reg and not l2_resp_ready_blocked
  s3_vpu_scp_resp_tmp___q#[5] = U1(s3_vpu_scp_resp_fill_early)
  if VpuEn != 0 and s3_vpu_scp_resp_fill_early {
    s3_vpu_tenb_data_o = l2_resp_int.data
    s3_vpu_scp_resp_tmp___q#[0..<4] = s4_tl1_load_addr#[0..<4]
    vpu_scp_return_cycle_1 = not vpu_scp_return_cycle_1
  }
  const tl1_tenb_written = s3_vpu_scp_resp_fill_early and vpu_scp_return_cycle_1

  // ---- s3/s4: data-array writes ---------------------------------------------------------------------------------
  const s4_tl0_load_ready = l2_fill_slot_avail and not l2_resp_valid_int
  s3_da_write_en = (s3_valid and s3_is_write) or l2_resp_fifo_count_d != 0 or l2_resp_valid_int or s3_co_da_clear_en or s3_cfg_da_clear_en or s3_tl0_load_valid_pre or (DebugApbEn != 0 and dbg_da_write_en_early)
  const s4_da_write_en_but_dbg = s4_valid or (l2_resp_valid_int and l2_da_write) or (s4_tl0_load_valid != 0 and s4_tl0_load_ready) or s4_co_da_clear_val or s4_cfg_da_clear_val
  s4_da_write_en = s4_da_write_en_but_dbg or (DebugApbEn != 0 and dbg_da_write_en and not dbg_da_write_valid)

