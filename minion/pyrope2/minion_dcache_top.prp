  if s4_valid and s1_valid {
    s5_req = s4_req
    s5_block_addr = s4_block_addr
  }

  // ---- s2: stores in flight that bypass the array ---------------------------------------------------------------
  // The line the s2 load wants may be written by a younger store still in s3, s4 or s5; those bytes are forwarded,
  // oldest first so the youngest wins.
  const s3_rq_to_s4 = rq_unpack(s3_req_to_s4)
  const s5_rq = rq_unpack(s5_req)
  const s5_cl_addr_match_s3_s2:Bool = s3_rq.addr#[6..<40] == s2_rq.addr#[6..<40]
  const s5_cl_addr_match_s4_s2:Bool = s4_rq.addr#[6..<40] == s2_rq.addr#[6..<40]
  const s5_cl_addr_match_s5_s2:Bool = s5_rq.addr#[6..<40] == s2_rq.addr#[6..<40]
