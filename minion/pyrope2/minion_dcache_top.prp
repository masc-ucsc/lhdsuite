const minion_dcache_tlb_array = import("minion_dcache_tlb_array.minion_dcache_tlb_array")
const minion_dcache_writeback_unit = import("minion_dcache_writeback_unit.minion_dcache_writeback_unit")
const prim_arb_lru = import("prim_arb_lru.prim_arb_lru")
const minion_pkg = import("minion_pkg")
const minion_dcache_pkg = import("minion_dcache_pkg")

// Data-cache top of the minion core: a 4-stage load/store pipe (s0 request select, s1 tag/TLB/PMA, s2 hit/miss,
// s3/s4 data array access and store merge) around the metadata, data, LRU, TLB and PMA arrays, plus the engines that
// also need L2 and pipe access (miss handler, writeback, replay queue, buffer array, L1/L2 cache ops, tensor loads,
// reduce/tensor store). Texture send is tied off. This file holds the pipeline registers and the L2 request/response
// plumbing; the arrays and the engines are sub-units.

// Build configuration: the Verilog parameters DebugApbEn/VpuEn (DebugMonEn is unused). They were module generics;
// LiveHD loses the fields of comb tuple results inside a generic mod (livehd_bugs L3u1_01) and no instance overrides
// them, so they are file constants.
comptime const DebugApbEn = 1
comptime const VpuEn = 1

// Pipeline request (406 bits, field order of the replay-queue request, addr in the top bits).
type Rq = (addr:U49, addr_msb_err:U1, set:U4, phys:U1, misaligned:U1, misaligned_2nd:U1, dest_fp:U1, dest_addr:U5, dest_thread:U1, cmd:U5, typ:U4, gsc_cnt:U3, ps_mask:U8, data:U256, replay:U1, replay_entry:U3, replay_age:U5, cache_op:U1, buf_alloc:U1, buf_id:U3, cacheable:U1, chunk_read:U4, uc_load_2nd:U1, uc_load_ok:U1, miss_fill_ok:U1, gsc32_idx:U40, vm_sel:U3, mem_global:U1)
// What the replay queue hands back (it does not store the fields s0 derives).
type ReplayReq = (addr:U49, dest_fp:U1, dest_addr:U5, dest_thread:U1, cmd:U5, typ:U4, gsc_cnt:U3, ps_mask:U8, phys:U1, buf_alloc:U1, buf_id:U3, cache_op:U1, misaligned:U1, misaligned_2nd:U1, cacheable:U1, uc_load_2nd:U1, gsc32_idx:U40, vm_sel:U3, mem_global:U1)
type L2Resp = (id:U8, dest:U1, wdata:U1, opcode:U2, data:U256, size:U3, qwen:U4)
type L2EvictReq = (id:U5, source:U1, wdata:U1, opcode:U5, address:U40, data:U256, size:U3, qwen:U4, subopcode:U7)
type L2MissReq = (id:U5, source:U1, wdata:U1, opcode:U5, address:U40, data:U20, size:U3, qwen:U4, subopcode:U7)
type VmStatus = (prv:U2, mprv:U1, mpp:U2, sum:U1, mxr:U1, debug:U1)
type WbReq = (tag:U33, set:U4, way_en:U4, is_tbox:U1, mem_idx:U1, addr_low:U7)
type MetaData = (coh_state:U2, tag:U33)
type MetaWr = (set_idx:U4, way_en:U4, coh_state:U2, tag:U33)
type BpConf = (thread_id:U1, address:U49, cmd:U3)
type WbDaReq = (valid_l:U1, valid_h:U1, way:U2, addr:U10)
type CoreCtrlResp = (cache_op_ready:U1, cache_op_busy_changed:U2, cache_op_complete_l1:U4, cache_op_complete_l2:U4, tl_ready_0:U1, tl_ready_1:U1, ts_ready:U1, tl_complete_0:U2, reduce_ready:U1, tex_send_ready:U1, gsc_progress_save:U2, gsc_progress:U3)

comb rq_unpack(w:U406) -> (r:Rq) {
  r.mem_global = w#[0]
  r.vm_sel = w#[1..<4]
  r.gsc32_idx = w#[4..<44]
  r.miss_fill_ok = w#[44]
  r.uc_load_ok = w#[45]
  r.uc_load_2nd = w#[46]
  r.chunk_read = w#[47..<51]
  r.cacheable = w#[51]
  r.buf_id = w#[52..<55]
  r.buf_alloc = w#[55]
  r.cache_op = w#[56]
  r.replay_age = w#[57..<62]
  r.replay_entry = w#[62..<65]
  r.replay = w#[65]
  r.data = w#[66..<322]
  r.ps_mask = w#[322..<330]
  r.gsc_cnt = w#[330..<333]
  r.typ = w#[333..<337]
  r.cmd = w#[337..<342]
  r.dest_thread = w#[342]
  r.dest_addr = w#[343..<348]
  r.dest_fp = w#[348]
  r.misaligned_2nd = w#[349]
  r.misaligned = w#[350]
  r.phys = w#[351]
  r.set = w#[352..<356]
  r.addr_msb_err = w#[356]
  r.addr = w#[357..<406]
}

// Packs a request tuple (typed fields) into the 406-bit word, first field of the list in the lowest bits.
comb rq_pack(r) -> (w:U406) {
  const mem_global:U1 = r.mem_global
  const vm_sel:U3 = r.vm_sel
  const gsc32_idx:U40 = r.gsc32_idx
  const miss_fill_ok:U1 = r.miss_fill_ok
  const uc_load_ok:U1 = r.uc_load_ok
  const uc_load_2nd:U1 = r.uc_load_2nd
  const chunk_read:U4 = r.chunk_read
  const cacheable:U1 = r.cacheable
  const buf_id:U3 = r.buf_id
  const buf_alloc:U1 = r.buf_alloc
  const cache_op:U1 = r.cache_op
  const replay_age:U5 = r.replay_age
  const replay_entry:U3 = r.replay_entry
  const replay:U1 = r.replay
  const data:U256 = r.data
  const ps_mask:U8 = r.ps_mask
  const gsc_cnt:U3 = r.gsc_cnt
  const typ:U4 = r.typ
  const cmd:U5 = r.cmd
  const thread_id:U1 = r.dest_thread
  const dest_addr:U5 = r.dest_addr
  const fp:U1 = r.dest_fp
  const misaligned_2nd:U1 = r.misaligned_2nd
  const misaligned:U1 = r.misaligned
  const phys:U1 = r.phys
  const set:U4 = r.set
  const addr_msb_err:U1 = r.addr_msb_err
  const addr:U49 = r.addr
  w = (mem_global, vm_sel, gsc32_idx, miss_fill_ok, uc_load_ok, uc_load_2nd, chunk_read, cacheable, buf_id, buf_alloc, cache_op, replay_age, replay_entry, replay, data, ps_mask, gsc_cnt, typ, cmd, thread_id, dest_addr, fp, misaligned_2nd, misaligned, phys, set, addr_msb_err, addr)#[..]
}

// Request fields shown on the debug bus (everything but the set and the data).
comb rq_dbg(r) -> (w:U95) {
  const mem_global:U1 = r.mem_global
  const chunk_read:U4 = r.chunk_read
  const vm_sel:U3 = r.vm_sel
  const uc_load_2nd:U1 = r.uc_load_2nd
  const cacheable:U1 = r.cacheable
  const buf_id:U3 = r.buf_id
  const buf_alloc:U1 = r.buf_alloc
  const misaligned_2nd:U1 = r.misaligned_2nd
  const misaligned:U1 = r.misaligned
  const cache_op:U1 = r.cache_op
  const replay_age:U5 = r.replay_age
  const replay_entry:U3 = r.replay_entry
  const replay:U1 = r.replay
  const ps_mask:U8 = r.ps_mask
  const gsc32_idx:U40 = r.gsc32_idx
  const gsc_cnt:U3 = r.gsc_cnt
  const typ:U4 = r.typ
  const cmd:U5 = r.cmd
  const thread_id:U1 = r.dest_thread
  const dest_addr:U5 = r.dest_addr
  const fp:U1 = r.dest_fp
  const phys:U1 = r.phys
  const addr_msb_err:U1 = r.addr_msb_err
  w = (mem_global, chunk_read, vm_sel, uc_load_2nd, cacheable, buf_id, buf_alloc, misaligned_2nd, misaligned, cache_op, replay_age, replay_entry, replay, ps_mask, gsc32_idx, gsc_cnt, typ, cmd, thread_id, dest_addr, fp, phys, addr_msb_err)#[..]
}

// Writeback request as one word (tag in the top bits).
comb wbreq_pack(r) -> (w:U50) {
  const tag:U33 = r.tag
  const set:U4 = r.set
  const way_en:U4 = r.way_en
  const is_tbox:U1 = r.is_tbox
  const mem_idx:U1 = r.mem_idx
  const addr_low:U7 = r.addr_low
  w = (addr_low, mem_idx, is_tbox, way_en, set, tag)#[..]
}

comb vm_unpack(w:U8) -> (v:VmStatus) {
  v.prv = w#[6..<8]
  v.mprv = w#[5]
  v.mpp = w#[3..<5]
  v.sum = w#[2]
  v.mxr = w#[1]
  v.debug = w#[0]
}

// L2 requests as one word for the arbiters and the pipe registers (id in the top bits).
comb evict_pack(r) -> (w:U322) {
  const id:U5 = r.id
  const source:U1 = r.source
  const wdata:U1 = r.wdata
  const opcode:U5 = r.opcode
  const address:U40 = r.address
  const data:U256 = r.data
  const size:U3 = r.size
  const qwen:U4 = r.qwen
  const subopcode:U7 = r.subopcode
  w = (subopcode, qwen, size, data, address, opcode, wdata, source, id)#[..]
}

comb evict_unpack(w:U322) -> (r:L2EvictReq) {
  r.subopcode = w#[0..<7]
  r.qwen = w#[7..<11]
  r.size = w#[11..<14]
  r.data = w#[14..<270]
  r.address = w#[270..<310]
  r.opcode = w#[310..<315]
  r.wdata = w#[315]
  r.source = w#[316]
  r.id = w#[317..<322]
}

comb miss_pack(r) -> (w:U86) {
  const id:U5 = r.id
  const source:U1 = r.source
  const wdata:U1 = r.wdata
  const opcode:U5 = r.opcode
  const address:U40 = r.address
  const data:U20 = r.data
  const size:U3 = r.size
  const qwen:U4 = r.qwen
  const subopcode:U7 = r.subopcode
  w = (subopcode, qwen, size, data, address, opcode, wdata, source, id)#[..]
}

comb miss_unpack(w:U86) -> (r:L2MissReq) {
  r.subopcode = w#[0..<7]
  r.qwen = w#[7..<11]
  r.size = w#[11..<14]
  r.data = w#[14..<34]
  r.address = w#[34..<74]
  r.opcode = w#[74..<79]
  r.wdata = w#[79]
  r.source = w#[80]
  r.id = w#[81..<86]
}

// Command and access-type classes.
comb cmd_is_amo(cmd:U5) -> (r:Bool) {
  r = cmd == minion_dcache_pkg.DcCmdXaSwap or cmd == minion_dcache_pkg.DcCmdXaAdd or cmd == minion_dcache_pkg.DcCmdXaXor or cmd == minion_dcache_pkg.DcCmdXaOr or cmd == minion_dcache_pkg.DcCmdXaAnd or cmd == minion_dcache_pkg.DcCmdXaMin or cmd == minion_dcache_pkg.DcCmdXaMax or cmd == minion_dcache_pkg.DcCmdXaMinu or cmd == minion_dcache_pkg.DcCmdXaMaxu or cmd == minion_dcache_pkg.DcCmdXaCmpswp or cmd == minion_dcache_pkg.DcCmdXaMinPs or cmd == minion_dcache_pkg.DcCmdXaMaxPs
}

comb cmd_is_read(cmd:U5) -> (r:Bool) {
  r = cmd == minion_dcache_pkg.DcCmdXrd or cmd == minion_dcache_pkg.DcCmdXlr or cmd == minion_dcache_pkg.DcCmdXsc or cmd_is_amo(cmd) or cmd == minion_dcache_pkg.DcCmdG32 or cmd == minion_dcache_pkg.DcCmdXrdb
}

comb cmd_is_store(cmd:U5) -> (r:Bool) {
  r = cmd == minion_dcache_pkg.DcCmdXwr or cmd == minion_dcache_pkg.DcCmdXsc or cmd_is_amo(cmd) or cmd == minion_dcache_pkg.DcCmdSc32 or cmd == minion_dcache_pkg.DcCmdXwrb
}

comb cmd_is_prefetch(cmd:U5) -> (r:Bool) {
  r = cmd == minion_dcache_pkg.DcCmdPfr or cmd == minion_dcache_pkg.DcCmdPfw
}

comb cmd_is_gsc32(cmd:U5) -> (r:Bool) {
  r = cmd == minion_dcache_pkg.DcCmdG32 or cmd == minion_dcache_pkg.DcCmdSc32
}

comb type_is_gsc(typ:U4) -> (r:Bool) {
  r = typ == minion_dcache_pkg.DcTypePsGs8 or typ == minion_dcache_pkg.DcTypePsGs16 or typ == minion_dcache_pkg.DcTypePsGs32
}

comb type_is_ps(typ:U4) -> (r:Bool) {
  r = typ == minion_dcache_pkg.DcTypePs or typ == minion_dcache_pkg.DcTypePsBr or type_is_gsc(typ)
}

comb type_is_byte(typ:U4) -> (r:Bool) {
  r = typ == minion_dcache_pkg.DcTypeB or typ == minion_dcache_pkg.DcTypeBu or typ == minion_dcache_pkg.DcTypePsGs8
}

comb type_is_hword(typ:U4) -> (r:Bool) {
  r = typ == minion_dcache_pkg.DcTypeH or typ == minion_dcache_pkg.DcTypeHu or typ == minion_dcache_pkg.DcTypePsGs16
}

comb type_is_word(typ:U4) -> (r:Bool) {
  r = typ == minion_dcache_pkg.DcTypeW or typ == minion_dcache_pkg.DcTypeWu or typ == minion_dcache_pkg.DcTypePsBr or typ == minion_dcache_pkg.DcTypePsGs32
}

comb type_is_dword(typ:U4) -> (r:Bool) {
  r = typ == minion_dcache_pkg.DcTypeD
}

// Way mask -> way index. Every set bit i contributes i, so a one-hot mask encodes to its index and a multi-hot
// mask ORs the indices (this is what the RTL's encoder does).
comb way_encode(ways:U4) -> (enc:U2) {
  mut e:U2 = 0
  for i in 1..<4 {
    if ways#[i] != 0 {
      e = e | i
    }
  }
  enc = e
}

// Set index actually used by the cache: a split cache gives each thread half of the sets, scratchpad mode
// reserves the upper half (thread 0 gets a quarter) for the scratchpad.
comb set_correct(mode:U2, set:U4, thread_id:U1) -> (r:U4) {
  const split_set:U4 = if thread_id == 0 { set#[0..<3] } else { (7 << 1) | (set & 1) }
  const scratch_set:U4 = if thread_id == 0 { (3 << 2) | (set & 1) } else { (7 << 1) | (set & 1) }
  r = if mode == minion_dcache_pkg.DcacheModeSplit { split_set }
    elif mode == minion_dcache_pkg.DcacheModeScratchpad { scratch_set }
    else { set }
}

// Pseudo-LRU state of a set: 4 ways, bits 4,8,12 (and 9,13,14) hold the tournament tree, one nibble each.
// Touching (or excluding) way i makes the tree point away from it.
comb lru_touch(lru:U16, ways:U4) -> (r:U16) {
  mut t:U16 = lru
  if ways#[0] != 0 {
    t#[4] = 1
    t#[8] = 1
    t#[12] = 1
  }
  if ways#[1] != 0 {
    t#[4] = 0
    t#[9] = 1
    t#[13] = 1
  }
  if ways#[2] != 0 {
    t#[8] = 0
    t#[9] = 0
    t#[14] = 1
  }
  if ways#[3] != 0 {
    t#[12] = 0
    t#[13] = 0
    t#[14] = 0
  }
  r = t
}

// One-hot victim: the way every tree node on its path points to.
comb lru_pick(t:U16) -> (v:U4) {
  v#[0] = (~t#[4]) & (~t#[8]) & (~t#[12])
  v#[1] = t#[4] & (~t#[9]) & (~t#[13])
  v#[2] = t#[8] & t#[9] & (~t#[14])
  v#[3] = t#[12] & t#[13] & t#[14]
}

