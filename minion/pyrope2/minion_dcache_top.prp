  const s1_crosses_block = s1_rq.addr#[5] != s1_access_last_byte#[5]
  mut s1_unaligned = false
  for k in 1..=5 {
    if s1_access_size == (1 << k) - 1 and s1_rq.addr#[0..<k] != 0 {
      s1_unaligned = true
    }
  }
  mut s1_misaligned_case_1 = false
  mut s1_misaligned_case_2 = false
  mut s1_misaligned_case_3 = false
  mut s1_misaligned_case_4 = false
  mut s1_misaligned_case_5 = false
  if s1_rq.misaligned_2nd == 0 and not s1_is_msg and not s1_is_gsc32 {
    if s1_access_last_byte#[6] != 0 {
      s1_misaligned_case_1 = true
    } elif s1_crosses_block and s1_rq.typ == minion_dcache_pkg.DcTypePs and s1_rq.addr#[0..<3] != 0 {
      s1_misaligned_case_2 = true
    } elif s1_crosses_block {
      s1_misaligned_case_3 = true
    } elif (s1_access_size#[0..<4] + s1_rq.addr#[0..<3])#[0..<4] > 7 and s1_rq.typ != minion_dcache_pkg.DcTypePs {
      s1_misaligned_case_4 = true
    } elif s1_unaligned {
      s1_misaligned_case_5 = true
    }
  }
  const s1_req_size_128b = s1_misaligned_case_4 or s1_rq.misaligned_2nd != 0
  const s1_req_size_256b = s1_rq.typ == minion_dcache_pkg.DcTypePs

  // ---- s1: data-array read request per bank ------------------------------------------------------------
  // Four 14-bit bank requests {valid_l, valid_h, way:2, addr:10}, bank 0 in the top bits. An access reads the
  // addressed bank, the next one for a bank-crossing access (the previous bank of lane k), or all of them for 256B.
  const s1_da_bank:U2 = (s1_da_read_req#[0..<10] >> minion_dcache_pkg.DcacheBankSelLsb)#[0..<2]
  mut s1_da_read_req_hit:U56 = 0
  for k in 0..<4 {
    mut lane:U14 = s1_da_read_req
    if cmd_is_gsc32(s1_rq.cmd) {
      lane#[13] = U1(s1_da_read_en and s1_gather32_en#[k] != 0)
    } else {
      lane#[13] = U1(s1_da_read_en and (s1_da_bank == k or (s1_da_bank == (k + 3)%4 and s1_req_size_128b) or s1_req_size_256b))
    }
    lane#[12] = lane#[13]
    // Second block of a block-crossing access: fetch the other 32B block of the banks above the first one.
    if k < s1_da_bank and s1_misaligned_case_3 and s1_valid {
      lane#[5] = ~lane#[5]
      lane#[13] = 1
      lane#[12] = 1
    }
    lane#[10..<12] = s1_read_way
    s1_da_read_req_hit#[(3 - k)*14..<(4 - k)*14] = lane
  }

  // ---- s1: exceptions ------------------------------------------------------------------------------------
  // A PMA fault on the second half of a misaligned replay is a bus error instead of an access fault.
  const s1_pma_access_fault = u_pma_unit.resp_data_o.access_fault != 0 and s1_rq.misaligned_2nd == 0 and s1_valid_to_tlb
  const s1_pma_bus_err = u_pma_unit.resp_data_o.access_fault != 0 and s1_rq.misaligned_2nd != 0 and s1_valid_to_tlb
  const s1_translation_fault = s1_pma_access_fault or u_tlb_array.resp_data_o.access_fault != 0

  // Misaligned access to uncached memory (aligned means: naturally aligned, or 32B aligned for packed single).
  const s1_aligned_ok = type_is_byte(s1_rq.typ) or (type_is_hword(s1_rq.typ) and s1_rq.addr#[0] == 0) or (type_is_word(s1_rq.typ) and s1_rq.addr#[0..<2] == 0) or (type_is_dword(s1_rq.typ) and s1_rq.addr#[0..<3] == 0) or (s1_rq.typ == minion_dcache_pkg.DcTypePs and s1_rq.addr#[0..<5] == 0)
  const s1_mf_xcpt = not (u_pma_unit.resp_data_o.cacheable != 0 and not s1_is_amo and not s1_is_msg and not s1_is_bypass and bypass_dcache_i == 0) and not s1_aligned_ok

  // An access that crosses the end of a page is a fault when translation is on.
  mut s1_access_is_page_split = false
  if s1_misaligned_case_1 {
    if vmspagesize_i == minion_pkg.tlb_entry_type_4K {
      s1_access_is_page_split = s1_rq.addr#[6..<12] == 63
    } elif vmspagesize_i == minion_pkg.tlb_entry_type_2M {
      s1_access_is_page_split = s1_rq.addr#[6..<21] == 0x7fff
    } elif vmspagesize_i == minion_pkg.tlb_entry_type_1G {
      s1_access_is_page_split = s1_rq.addr#[6..<30] == 0xffffff
    }
  }
  const s1_load_like = s1_is_read_no_amo or cmd_is_prefetch(s1_rq.cmd)
  const s1_not_cache_op = s1_rq.cache_op == 0
  const s1_xcpt_pf_ld = s1_load_like and u_tlb_array.resp_data_o.xcpt_ld != 0 and s1_not_cache_op
  const s1_xcpt_pf_st = s1_is_store and u_tlb_array.resp_data_o.xcpt_st != 0 and s1_not_cache_op
  const s1_xcpt_af_ld = (s1_load_like and s1_translation_fault and s1_not_cache_op) or (s1_is_read_no_amo and s1_mf_xcpt)
  const s1_xcpt_af_st = (s1_is_store and s1_translation_fault and s1_not_cache_op) or (s1_is_write and s1_mf_xcpt)
  const s1_xcpt_ps_ld = s1_is_read_no_amo and s1_access_is_page_split and u_tlb_array.vm_enabled_o != 0
  const s1_xcpt_ps_st = s1_is_write and s1_access_is_page_split and u_tlb_array.vm_enabled_o != 0 and not s1_mf_xcpt
  // Exception word, one bit per cause, lowest bit ps_st (the order of the s1_core_xcpt_o bundle, reversed).
  const xcpt_none:U1 = 0
  const s1_xcpt_raw:U8 = (U1(s1_xcpt_ps_st), U1(s1_xcpt_ps_ld), U1(s1_xcpt_af_st), U1(s1_xcpt_af_ld), xcpt_none, xcpt_none, U1(s1_xcpt_pf_st), U1(s1_xcpt_pf_ld))#[..]
  const s1_xcpt_walk:U8 = if s1_tlb_wait { 0 } else { s1_xcpt_raw }
  const s1_xcpt_no_kill:U8 = if s1_valid { s1_xcpt_walk } else { 0 }
  const s1_xcpt:U8 = if s1_valid and s1_core_kill_i == 0 { s1_xcpt_walk } else { 0 }
  const s1_has_xcpt_no_kill = s1_xcpt_no_kill != 0
  const s1_has_xcpt = s1_xcpt != 0

  const s1_valid_masked = s1_valid and (s1_core_kill_i == 0 or s1_rq.replay != 0 or s1_rq.cache_op != 0) and not s1_has_xcpt and not s1_pma_bus_err
  const s1_valid_to_s2 = s1_valid_masked and u_tlb_array.resp_data_o.miss == 0 and (s1_not_cache_op or not s1_tlb_fail)

  // A TLB miss flushes the thread's younger requests; gather/scatter progress is saved when it interrupts one.
  mut s1_tlb_flush_pipeline_m:U2 = 0
  if s1_valid_to_tlb and u_tlb_array.resp_data_o.miss != 0 and s1_rq.vm_sel == minion_dcache_pkg.DcacheVmSelIp {
    s1_tlb_flush_pipeline_m#[s1_rq.dest_thread] = 1
  }
  s1_tlb_flush_pipeline = s1_tlb_flush_pipeline_m
  const s1_gsc_lane = type_is_gsc(s1_rq.typ) and not cmd_is_gsc32(s1_rq.cmd) and s1_rq.vm_sel == minion_dcache_pkg.DcacheVmSelIp
  const s1_save_progress = ((s1_valid_to_tlb and u_tlb_array.resp_data_o.miss != 0) or s1_has_xcpt) and s1_gsc_lane
  const s0_clear_progress = s0_core_req_is_valid_gsc and s0_rq.gsc_cnt == 7

  // ---- s1: nacks and the request handed to s2 ------------------------------------------------------------------
  const s1_read_to_x0 = s1_is_read and s1_rq.dest_fp == 0 and s1_rq.dest_addr == 0
  const s1_nack_co_collide = s1_rq.set == s1_co_nack_set_value and s1_co_nack_set_valid
  const s1_nack_vpu_rf_write = VpuEn != 0 and s1_is_read and s1_rq.dest_fp != 0 and s1_vpu_ctrl_i.tfma_rf_write != 0
  const s1_reg_nack = (s1_valid_to_s2 and s1_rq.buf_alloc != 0 and (s1_mh_force_ba_rptr or s1_re_ba_read_en_spec)) or (VpuEn != 0 and s1_valid_to_s2 and s1_vpu_ctrl_i.scp_req.read_en != 0 and not s1_is_msg and not s1_is_amo and not s1_is_bypass) or (s1_valid_to_s2 and s1_nack_co_collide and not s1_is_msg and not s1_is_amo and not s1_is_bypass) or (s1_valid_to_s2 and s1_nack_vpu_rf_write)

  // Replay-queue bookkeeping of the request leaving s1.
  const s1_rq_push = s1_valid_to_s2 and s1_rq.replay == 0
  const s1_rq_rearm = s1_valid_to_s2 and s1_rq.replay != 0

  const s1_req_addr_to_s2:U48 = if s1_has_xcpt or s1_rq.phys != 0 { s1_rq.addr#[0..<48] } else { s1_phys_addr#[0..<40] }
  mut s1_req_to_s2_rq = rq_unpack(s1_req_pre_addr)
  s1_req_to_s2_rq.addr = 0
  s1_req_to_s2_rq.dest_thread = s1_req_thread_id
  s1_req_to_s2_rq.phys = U1(s1_rq.phys != 0 or u_tlb_array.resp_data_o.miss == 0)
  if not s1_req_force_set {
    s1_req_to_s2_rq.set = set_correct(mode=dcache_cfg_mode, set=s1_req_addr_to_s2#[6..<10], thread_id=s1_rq.dest_thread)
  }
  s1_req_to_s2_rq.data = if (s1_rq.replay == 0 or s1_reduce_send_inst) and not s1_reduce_op_inst { s1_core_store_data_i }
    else { s1_ba_data }
  s1_req_to_s2_rq.misaligned = U1((s1_misaligned_case_1 or s1_misaligned_case_2 or s1_misaligned_case_3) and s1_rq.misaligned_2nd == 0)
  s1_req_to_s2_rq.cacheable = U1(u_pma_unit.resp_data_o.cacheable != 0 and not s1_is_amo and not s1_is_msg and not s1_is_bypass and bypass_dcache_i == 0)
  // chunk_read: which banks the access reads (valid_l or valid_h of each bank request).
  mut s1_chunk_read:U4 = 0
  for k in 0..<4 {
    const bank_req:U14 = s1_da_read_req_hit#[(3 - k)*14..<(4 - k)*14]
    s1_chunk_read#[k] = U1(bank_req#[13] != 0 or bank_req#[12] != 0)
  }
  s1_req_to_s2_rq.chunk_read = s1_chunk_read
  const s1_req_to_s2:U406 = rq_pack(s1_req_to_s2_rq)
  // The tag array and the lock state are read with the set that goes to s2.
  const s1_hlocked_ways:U4 = (hlock_state >> (s1_req_to_s2_rq.set*4))#[0..<4]
  const s1_slocked_ways:U4 = (slock_state >> (s1_req_to_s2_rq.set*4))#[0..<4]

  // ---- s1: data-array read mux, load enables ----------------------------------------------------------------
  // Priority: VPU scratchpad read, tensor-store scratchpad read, writeback unit, normal access, debug read;
  // with no requester the previous selection is held (and the array read is disabled).
  const s1_vpu_scp_read = VpuEn != 0 and s1_vpu_ctrl_i.scp_req.read_en != 0
  mut s1_da_read_mux_sel:U3 = s1_da_read_mux_sel_prev
  mut s1_da_read_en_final = false
  if s1_vpu_scp_read {
    s1_da_read_mux_sel = 2
    s1_da_read_en_final = true
  } elif VpuEn != 0 and ts_scp_read and s1_reduce_send_inst {
    s1_da_read_mux_sel = 3
    s1_da_read_en_final = true
  } elif s1_wb_da_valid {
    s1_da_read_mux_sel = 1
    s1_da_read_en_final = true
  } elif s1_da_read_en {
    s1_da_read_mux_sel = 0
    s1_da_read_en_final = true
  } elif DebugApbEn != 0 and dbg_da_read_en {
    s1_da_read_mux_sel = 4
    s1_da_read_en_final = true
  }
  if s1_da_read_en_final {
    s1_da_read_mux_sel_prev = s1_da_read_mux_sel
  }

  const bank_valid_both:U2 = 3
  const dbg_da_read_lane_addr:U10 = dbg_da_read_addr#[0..<7] << 3
  mut s1_da_read_req_mux:U56 = s1_da_read_req_hit
  mut dbg_da_read_accept_next = false
  for k in 0..<4 {
    if s1_da_read_mux_sel == 1 {
      s1_da_read_req_mux#[k*14..<(k + 1)*14] = s1_wb_da_req
    } elif s1_da_read_mux_sel == 3 {
      s1_da_read_req_mux#[k*14..<(k + 1)*14] = (ts_scp_read_addr#[0..<10], ts_scp_read_way, bank_valid_both)#[..]
    } elif s1_da_read_mux_sel == 2 {
      // The scratchpad access covers 256B, 64B (the bank pair of the address) or the one 32B chunk the address names.
      const scp_bank = (s1_vpu_ctrl_i.scp_req.addr >> minion_dcache_pkg.DcacheBankSelLsb)#[0..<2]
      const scp_covers = s1_vpu_ctrl_i.scp_req.size256 != 0 or (s1_vpu_ctrl_i.scp_req.size64 != 0 and scp_bank == 3 - k)
      const scp_valid:U2 = (U1(scp_covers or s1_vpu_ctrl_i.scp_req.addr#[2..<5] == (3 - k)*2 + 1), U1(scp_covers or s1_vpu_ctrl_i.scp_req.addr#[2..<5] == (3 - k)*2))#[..]
      s1_da_read_req_mux#[k*14..<(k + 1)*14] = (s1_vpu_ctrl_i.scp_req.addr#[0..<10], s1_vpu_ctrl_i.scp_req.way, scp_valid)#[..]
    } elif s1_da_read_mux_sel == 4 {
      s1_da_read_req_mux#[k*14..<(k + 1)*14] = (dbg_da_read_lane_addr, dbg_da_read_addr#[7..<9], bank_valid_both)#[..]
    }
  }
  if s1_da_read_mux_sel == 4 {
    dbg_da_read_accept_next = true
  }
  mut s1_da_load_data_en:U4 = 0
  for k in 0..<4 {
    s1_da_load_data_en#[k] = U1(s1_da_read_req_mux#[(3 - k)*14 + 13] != 0 or s1_da_read_req_mux#[(3 - k)*14 + 12] != 0)
  }
  // 32-bit scratchpad read lanes of the VPU access.
  mut s1_vpu_scp_read_en:U8 = 0
  for j in 0..<8 {
    s1_vpu_scp_read_en#[j] = U1(s1_vpu_scp_read and (s1_vpu_ctrl_i.scp_req.size256 != 0 or (s1_vpu_ctrl_i.scp_req.size64 != 0 and s1_vpu_ctrl_i.scp_req.addr#[3] == (j/2)%2) or s1_vpu_ctrl_i.scp_req.addr#[2..<5] == j))
  }

  const u_data_array = minion_dcache_data_array::[name=u_data_array](clk_i=clk_i, s1_read_valid_i=U1(s1_da_read_en_final and mem_ctrl_override_i.e0 == 0), s1_read_req_i=s1_da_read_req_mux, s3_write_valid_i=U1(s3_da_write_en), s4_write_valid_i=U1(s4_da_write_en and mem_ctrl_override_i.e1 == 0), s4_write_req_i=s4_da_write_data, ram_cfg_i=(const deep_sleep=0, const ra=0, const rm=0, const rme=0, const shut_down=0, const test_en=0, const wa=0, const wpulse=0))
  // The LRU write set is the s2 request's set (the Verilog's `s2_req.set`); the machine-emitted tree read the not yet
  // assigned `s2_req` here, i.e. an unknown (livehd_bugs L3u1_04).
  const u_lru_array = minion_dcache_lru_array::[name=u_lru_array](clk_i=clk_i, rst_ni=rst_ni, read_set_i=s1_phys_addr_set, write_en_i=U1(s2_lru_update), write_set_i=s2_rq.set, write_data_i=s2_lru_data_up)
  const s1_lru_data_byp:U16 = if s2_lru_update and s2_rq.set == s1_phys_addr_set { s2_lru_data_up } else { u_lru_array }

  // Victim way: the pseudo-LRU victim among the ways that are neither locked off nor privileged;
  // if all of those are excluded, the one that ignores only the locked-off ways.
  const way_dis:U4 = s1_hlocked_ways
  const way_prio:U4 = s1_slocked_ways
  const lru_victim_strict:U4 = lru_pick(lru_touch(lru=s1_lru_data_byp, ways=way_dis | way_prio))
  const lru_victim_loose:U4 = lru_pick(lru_touch(lru=s1_lru_data_byp, ways=way_dis))
  const dcache_lru_victim:U4 = if ((lru_victim_strict & ~way_dis) & ~way_prio) != 0 { lru_victim_strict } else { lru_victim_loose }

  // ---- s1 -> s2 registers -----------------------------------------------------------------------------------------
  s2_valid = s1_valid_to_s2
  if s1_valid {
    s2_reg_nack = s1_reg_nack
    s2_has_xcpt_addr = s1_has_xcpt
  }
  // No reset on this one: hold it while rst_ni is low.
  if rst_ni != 0 and s1_valid {
    s2_nack_vpu_rf_write = s1_nack_vpu_rf_write
  }
  s1_clear_progress = s0_clear_progress and not s1_save_progress
  s2_clear_progress = s1_clear_progress and s1_core_kill_i == 0
  s2_save_progress = s1_save_progress and s1_core_kill_i == 0 and not s2_save_progress
  if s1_valid_to_tlb or s2_core_flush_pipeline_o != 0 {
    s2_core_flush_pipeline_o = U1(s1_tlb_flush_pipeline != 0)
  }
  if s1_clk_en {
    s2_tag_match = s1_tag_match
    s2_req_pre_addr = s1_req_to_s2
    s2_lru_data = s1_lru_data_byp
    s2_misaligned = s1_misaligned_case_1 or s1_misaligned_case_2
    s2_misaligned_case_3 = s1_misaligned_case_3
    s2_da_load_data_en = s1_da_load_data_en
    s2_replace_way_en = dcache_lru_victim
    s2_is_read = s1_is_read
    s2_is_write = s1_is_write
    s2_is_amo = s1_is_amo
    s2_gsc32_indices = s1_to_s2_gsc32_indices
  }
  if s1_clk_en or s1_translate_only_addr_load or s1_has_xcpt_no_kill {
    s2_req_addr = s1_req_addr_to_s2
    s2_is_msg = s1_is_msg
    s2_is_bypass = s1_is_bypass
  }
  if s1_vpu_scp_read {
    s2_vpu_scp_read_en = s1_vpu_scp_read_en
  }
  s2_wb_da_valid = s1_wb_da_valid
  if s1_clk_en {
    for w in 0..<4 {
      const way_meta:U35 = u_metadata_array.s1_read_resp_o#[(3 - w)*35..<(4 - w)*35]
      if u_metadata_array.s1_read_resp_valid_o#[w] != 0 {
        `s2_meta_read.coh_state`[w] = way_meta#[33..<35]
        `s2_meta_read.tag`[w] = way_meta#[0..<33]
      } else {
        `s2_meta_read.coh_state`[w] = minion_dcache_pkg.StateInvalid
        `s2_meta_read.tag`[w] = s1_invalid_way_tag
      }
    }
  }

  // ---- s2: tag hit, nacks, miss request -----------------------------------------------------------------------
  const s2_valid_qual = s2_valid and (s2_core_kill_i == 0 or s2_rq.replay != 0 or s2_rq.cache_op != 0)

  // A hit needs a tag match that is not masked by a message/amo/bypass access (or bypass_dcache_i).
  const s2_tag_match_qual:U4 = if s2_is_msg or s2_is_amo or s2_is_bypass or bypass_dcache_i != 0 { 0 } else { s2_tag_match }
  const s2_tag_match_any = s2_tag_match_qual != 0
  mut s2_way_hit_state:U2 = minion_dcache_pkg.StateInvalid
  for w in 0..<4 {
    if s2_tag_match_qual#[w] != 0 {
      s2_way_hit_state = `s2_meta_read.coh_state`[w]
    }
  }
  // Reads need Shared, writes/LR/prefetch-for-write need Exclusive, and writes need to be Modified already.
  const s2_write_class = cmd_is_store(s2_rq.cmd) or s2_rq.cmd == minion_dcache_pkg.DcCmdPfw or s2_rq.cmd == minion_dcache_pkg.DcCmdXlr
  const s2_state_ok = (s2_is_read and s2_way_hit_state >= minion_dcache_pkg.StateShared) or (s2_rq.cmd == minion_dcache_pkg.DcCmdPfr and s2_way_hit_state >= minion_dcache_pkg.StateShared) or (s2_write_class and s2_way_hit_state >= minion_dcache_pkg.StateExclusive)
  const s2_hit = s2_tag_match_any and s2_state_ok and (not s2_is_write or s2_way_hit_state == minion_dcache_pkg.StateModified)
  const s2_nack_inflight = s2_hit and s2_mh_match_miss_line
  const s2_nack_miss = not s2_hit and not s2_mh_req_ready and s2_rq.uc_load_2nd == 0
  const s2_nack_pre_misaligned_miss = s2_reg_nack or s2_nack_inflight or s2_nack_rq_conflict
  const s2_nack_pre_misaligned = s2_nack_pre_misaligned_miss or s2_nack_miss
  const s2_nack_misaligned = not s2_nack_pre_misaligned and s2_misaligned and s2_rq.misaligned_2nd == 0 and s2_hit
  const s2_nack = s2_nack_pre_misaligned or s2_nack_misaligned
  const s2_valid_masked = s2_valid_qual and not s2_nack_pre_misaligned

  // Metadata of the way chosen for replacement.
  mut s2_repl_coh:U2 = 0
  mut s2_repl_tag:U33 = 0
  for w in 0..<4 {
    if s2_replace_way_en#[w] != 0 {
      s2_repl_coh = `s2_meta_read.coh_state`[w]
      s2_repl_tag = `s2_meta_read.tag`[w]
    }
  }
  // Request to the miss handler: the matching way on a tag hit, else the victim way.
  const s2_mh_req_valid_reg = s2_valid_qual and not s2_nack_pre_misaligned_miss and not s2_hit and (cmd_is_prefetch(s2_rq.cmd) or s2_is_read or s2_is_write) and not s2_is_msg and s2_rq.uc_load_2nd == 0 and not (s2_rq.replay != 0 and s2_rq.miss_fill_ok == 0)
  const s2_mh_req_valid = s2_mh_req_valid_reg or (s2_valid_qual and s2_is_msg and not s2_nack_rq_conflict and s2_rq.uc_load_2nd == 0)
  const s2_mh_way_en:U4 = if s2_tag_match_any { s2_tag_match_qual } else { s2_replace_way_en }
  const s2_mh_old_coh:U2 = if s2_tag_match_any { s2_way_hit_state } else { s2_repl_coh }
  const s2_mh_buf_id:U3 = if s2_rq.replay == 0 { s2_ba_write_entry } else { s2_rq.buf_id }

  // LRU state after touching the way that is filled/hit.
  s2_lru_data_up = lru_touch(lru=s2_lru_data, ways=s2_mh_way_en)
  s2_lru_update = s2_valid_masked and (s2_hit or not s2_mh_match_miss_line) and s2_rq.cacheable != 0

  // ---- s1/s2: buffer-array and replay-queue bookkeeping --------------------------------------------------------
  const id_rq_replay_bid_qual = id_rq_replay_bid and wb_dcache_fp_toint_i == 0 and not (VpuEn != 0 and vpu_scp_bid_2)
  const s1_ba_rptr:U3 = if s1_mh_force_ba_rptr { s1_mh_ba_rptr } elif s1_re_ba_read_en_spec { s1_re_ba_read_addr } else { s1_rq.buf_id }
  const s1_reduce_dealloc_req = VpuEn != 0 and ((re_l2_evict_ready and re_l2_evict_valid and s1_re_ba_read_en) or (ts_l2_evict_ready and ts_l2_evict_valid and s1_re_ba_read_en) or (s1_reduce_op_inst and s1_re_ba_read_en))
  const s2_store_misaligned_rearm = s2_valid_to_s3 and s2_is_write and s2_nack_misaligned
  // The request leaves the replay queue (or is re-armed) when it was handled in s2 or by a bypass/uncached path.
  const s2_rq_push_cancel = (s2_valid_to_s3 and not s2_store_misaligned_rearm) or (s2_mh_can_accept_uc and s2_mh_req_valid and s2_is_write and not s2_is_amo) or (cmd_is_prefetch(s2_rq.cmd) and not s2_nack_pre_misaligned) or (s2_is_msg and s2_is_write and not s2_nack_miss and not s2_nack_rq_conflict) or (s2_valid_masked and s2_is_bypass and s2_is_write) or (s2_valid_masked and s2_rq.uc_load_2nd != 0 and s2_rq.uc_load_ok == 0) or (s2_valid_masked and s2_rq.replay != 0 and s2_rq.miss_fill_ok == 0)
  const s2_rq_push = s2_valid_qual and s2_rq.replay == 0 and not s2_rq_push_cancel
  const s2_rq_renack = s2_valid_qual and s2_rq.replay != 0 and not s2_rq_push_cancel
  const s2_rq_dealloc = s2_valid_qual and s2_rq.replay != 0 and s2_rq_push_cancel
  const s2_conf_miss_accepted:U2 = if s2_nack_vpu_rf_write { 0 } else { s2_mh_req_accepted }
  const s2_conf_miss_assigned:U2 = if s2_nack_vpu_rf_write { 0 } else { s2_mh_req_assigned }
  const s2_uc_load_1st = s2_mh_req_valid and s2_is_read and s2_mh_can_accept_uc and s2_rq.uc_load_2nd == 0
  const s2_uc_load_ok:U1 = if s2_rq.replay != 0 { s2_rq.uc_load_ok } else { 0 }
  const s2_miss_fill_ok:U1 = if s2_rq.replay != 0 { s2_rq.miss_fill_ok } else { 1 }
  const s2_ba_nack_needed = s2_is_write
  const s2_ba_write_needed_core = (s2_valid_qual and s2_rq.replay == 0 and s2_nack and s2_ba_nack_needed) or (s2_valid_qual and s2_rq.replay == 0 and s2_misaligned) or (s2_valid_qual and s2_rq.replay == 0 and s2_is_read and s2_rq.cacheable == 0) or (s2_mh_req_valid and s2_rq.replay == 0 and s2_is_write) or (s2_valid_qual and s2_rq.replay == 0 and s2_is_msg)
  const s2_ba_write_needed = s2_ba_write_needed_core or s2_re_ba_write_needed
  const s2_ba_write_en = (s2_valid_qual and s2_rq.replay == 0 and s2_nack and s2_ba_nack_needed) or (s2_valid_qual and s2_nack_misaligned) or (s2_mh_req_valid and s2_rq.replay == 0 and s2_is_write) or (s2_valid_qual and s2_rq.replay == 0 and s2_is_write and s2_is_msg) or s2_reduce_send_inst
  const s2_ba_dealloc = (s2_valid_to_s3 or (s2_valid_masked and s2_rq.uc_load_2nd != 0) or (s2_valid_masked and s2_rq.replay != 0 and s2_rq.miss_fill_ok == 0)) and not s2_store_misaligned_rearm and s2_rq.buf_alloc != 0
  const s2_ba_write_replay = s2_rq.replay != 0 and not s2_re_ba_write_needed
  // Buffer-array writes from the L2 response (uncached load data and reduce data).
  const s3_ba_write_en_uc = l2_resp_fifo_pop and l2_resp_is_for_mh_uc_ok
  const s3_ba_write_en_msg = l2_resp_fifo_pop and l2_resp_is_reduce_data
  const s3_ba_write_en_ext = s3_ba_write_en_uc or s3_ba_write_en_msg
  const s3_ba_write_entry_ext:U3 = if s3_ba_write_en_uc { s3_mh_ba_wptr } else { s3_re_ba_write_addr }
  const rq_uc_load_fill = l2_resp_fifo_pop and l2_resp_is_for_mh_uc

  // ---- s2 -> s3 ---------------------------------------------------------------------------------------------------
  s2_valid_to_s3 = s2_valid_masked and (s2_hit or (s2_rq.uc_load_2nd != 0 and s2_rq.uc_load_ok != 0)) and (s2_is_write or not s2_nack_misaligned)
  const s2_to_s3_en = (s2_valid_masked and (s2_hit or s2_rq.uc_load_2nd != 0)) or s2_ba_write_en
  const s2_store_data_en = (s2_valid_masked and s2_hit and s2_is_write) or (s2_valid_masked and s2_rq.uc_load_2nd != 0) or (s2_ba_write_en and s2_is_write) or (s2_valid_masked and s2_hit and s2_is_read and s2_rq.misaligned_2nd != 0) or s2_reduce_send_inst or s2_reduce_op_inst

  // Load data lanes the s3 data registers capture: a hit (or writeback read) of an enabled bank, or the debug read.
  const s2_data:U256 = u_data_array
  const s2_load_hit:Bool = (s2_valid_masked and s2_hit) or s2_wb_da_valid
  mut s2_to_s3_en_load_data:U4 = 0
  for k in 0..<4 {
    s2_to_s3_en_load_data#[k] = U1((s2_load_hit and s2_da_load_data_en#[k] != 0) or (dbg_da_read_addr#[0..<2] == k and dbg_da_read_accept))
  }

  // Store data: shifted onto the addressed bytes (or kept for amo/reduce), or the tensor-store column copy.
  const s2_store_dup128:U256 = (s2_rq.data#[0..<128], s2_rq.data#[0..<128])#[..]
  const s2_data_dup128:U256 = (s2_data#[0..<128], s2_data#[0..<128])#[..]
  mut s2_to_s3_store_data:U256 = s2_rq.data
  if not s2_reduce_send_inst {
    if s2_reduce_op_inst {
      s2_to_s3_store_data = s2_rq.data
    } elif s2_rq.uc_load_2nd != 0 {
      s2_to_s3_store_data = s2_rq.data >> (s2_rq.addr#[0..<5] << 3)
    } elif s2_rq.cacheable == 0 and s2_is_write and not s2_is_msg and not s2_is_amo {
      s2_to_s3_store_data = (s2_rq.data << (s2_rq.addr#[0..<5] << 3))#[0..<256]
    } elif s2_is_amo {
      if type_is_byte(s2_rq.typ) {
        s2_to_s3_store_data = s2_rq.data#[0..<8]
      } elif type_is_hword(s2_rq.typ) {
        s2_to_s3_store_data = s2_rq.data#[0..<16]
      } elif type_is_word(s2_rq.typ) {
        s2_to_s3_store_data = s2_rq.data#[0..<32]
      } elif type_is_dword(s2_rq.typ) {
        s2_to_s3_store_data = s2_rq.data#[0..<64]
      }
    }
  } elif ts_scp_read {
    s2_to_s3_store_data = if ts_col_size_is_128b { s2_data_dup128 } else { s2_data }
  } else {
    s2_to_s3_store_data = if ts_col_size_is_128b { s2_store_dup128 } else { s2_rq.data }
  }

  s3_valid = s2_valid_to_s3
  s3_has_data = s2_valid_to_s3 and s2_is_read and not (s2_rq.dest_fp == 0 and s2_rq.dest_addr == 0)
  if s2_to_s3_en or s2_has_xcpt_addr {
    s3_req = s2_req
  }
  if s2_to_s3_en {
    s3_way = s2_tag_match_qual
    s3_store_bypass = s5_store_bypass
    s3_misaligned_case_3 = s2_misaligned_case_3
    s3_is_write = s2_is_write
    for i in 0..<8 {
      s3_gsc32_indices[i] = s2_gsc32_indices#[i*5..<(i + 1)*5]
    }
  }
  if s2_store_data_en {
    s3_store_data = s2_to_s3_store_data
  }
  if s2_valid_masked and s2_hit and s5_store_bypass != 0 {
