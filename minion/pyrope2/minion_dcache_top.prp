      lane_valid_h = 1
      lane_way = if l2_resp_is_for_tensor_0 { s4_tl0_load_way } else { s4_mh_refill_way }
      lane_addr = if l2_resp_is_for_tensor_0 { s4_tl0_load_addr } else { s4_mh_refill_addr }
      lane_data = l2_resp_int.data#[k*64..<(k + 1)*64]
    } elif s4_sel_tl0 {
