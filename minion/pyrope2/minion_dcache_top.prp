  wire s2_reduce_send_inst:Bool = nil
  wire s2_reduce_op_inst:Bool = nil
  wire s2_re_ba_write_needed:Bool = nil
  wire s3_reduce_send_inst:Bool = nil
  wire s3_reduce_op_inst:Bool = nil
  wire re_pipe_used:Bool = nil
  wire re_ba_alloc:Bool = nil
  wire re_buffer_avail:Bool = nil
  wire re_wait_l2_to_ba_resp:Bool = nil
  wire re_ba_entries_required:Bool = nil
  wire s1_ba_data:U256 = nil
  wire ts_scp_read:Bool = nil
  wire ts_scp_read_way:U2 = nil
  wire ts_scp_read_addr:U10 = nil
  wire ts_col_size_is_128b:Bool = nil
  wire s0_ts_addr_load:Bool = nil
  wire s0_ts_addr:U48 = nil
  wire s0_ts_addr_msb_err:U1 = nil
  wire s0_ts_thread_id:U1 = nil
  wire s1_ts_addr_load:Bool = nil
  wire tensor_reduce_err_all_flags:U4 = nil
  wire l2_resp_ready_int:Bool = nil
  wire l2_resp_is_for_tensor_0:Bool = nil
  wire l2_resp_is_for_tensor_1:Bool = nil
  wire l2_resp_is_for_mh_fill:Bool = nil
  wire l2_resp_is_for_mh_uc:Bool = nil
  wire l2_resp_is_for_mh_uc_ok:Bool = nil
  wire l2_resp_is_reduce_data:Bool = nil
  wire l2_resp_is_reduce_ready:Bool = nil
  wire l2_resp_ready_blocked:Bool = nil
  wire mh_l2_resp_stall:U2 = nil
  wire l2_fill_slot_avail:Bool = nil
  wire s3_ba_write_en:Bool = nil
  wire s2_nack_rq_conflict:Bool = nil
  wire s2_valid_to_s3:Bool = nil
  wire s2_lru_data_up:U16 = nil
  wire s2_lru_update:Bool = nil
  wire s2_mh_req_ready:Bool = nil
  wire s1_tlb_flush_pipeline:U2 = nil
  wire dbg_md_write_en_early:Bool = nil
  wire dbg_md_write_en:Bool = nil
  wire l2_resp_is_port_data:Bool = nil
  wire l2_da_write:Bool = nil
  wire dbg_da_write_en_early:Bool = nil
  wire dbg_da_write_en:Bool = nil
  wire dbg_da_read_en:Bool = nil
  wire s5_store_bypass_data:U256 = nil
  wire s5_store_bypass:U4 = nil
  wire s4_da_write_data:U312 = nil
  wire wb_l2_evict_word:U322 = nil
  wire mh_l2_evict_word:U322 = nil
  wire re_l2_evict_word:U322 = nil
  wire ts_l2_evict_word:U322 = nil
  wire pf_l2_evict_word:U322 = nil
  wire mh_l2_miss_word:U86 = nil
  wire tl0_l2_miss_word:U86 = nil
  wire tl1_l2_miss_word:U86 = nil
  wire co_wb_word:U50 = nil
  wire mh_wb_word:U50 = nil
  // Typed views of the registered requests of s2 (its address is kept in its own register) and s3.
  mut s2_rq = rq_unpack(s2_req_pre_addr)
  s2_rq.addr = s2_req_addr
  const s2_req:U406 = rq_pack(s2_rq)
  const s3_rq = rq_unpack(s3_req)

  // ---- Core control, L2 response FIFO, s0/s1 request views ----------------------------------------
  // The core asks for a cache mode in {scpenable, d1split}.
  const core_cache_mode:U2 = (core_ctrl_i.cache_ctrl.d1split, core_ctrl_i.cache_ctrl.scpenable)#[..]
  // Every mode but Shared halves the set index.
  const sets_reduced = dcache_cfg_mode != minion_dcache_pkg.DcacheModeShared

  // Two-entry FIFO that decouples the L2 response channel; pointers and count reset to zero.
  const l2_resp_fifo_full = l2_resp_fifo_count_q == 2
  const l2_resp_fifo_push = l2_resp_valid_i != 0 and not l2_resp_fifo_full
  const l2_resp_valid_int = l2_resp_fifo_count_q != 0
  const l2_resp_fifo_pop = l2_resp_valid_int and l2_resp_ready_int
  const l2_resp_int:L2Resp = (data=`l2_resp_fifo_data.data`[l2_resp_fifo_rd_ptr_q], dest=`l2_resp_fifo_data.dest`[l2_resp_fifo_rd_ptr_q], id=`l2_resp_fifo_data.id`[l2_resp_fifo_rd_ptr_q], opcode=`l2_resp_fifo_data.opcode`[l2_resp_fifo_rd_ptr_q], qwen=`l2_resp_fifo_data.qwen`[l2_resp_fifo_rd_ptr_q], size=`l2_resp_fifo_data.size`[l2_resp_fifo_rd_ptr_q], wdata=`l2_resp_fifo_data.wdata`[l2_resp_fifo_rd_ptr_q])
  if l2_resp_fifo_push {
    `l2_resp_fifo_data.id`[l2_resp_fifo_wr_ptr_q] = l2_resp_i.id
    `l2_resp_fifo_data.dest`[l2_resp_fifo_wr_ptr_q] = l2_resp_i.dest
    `l2_resp_fifo_data.wdata`[l2_resp_fifo_wr_ptr_q] = l2_resp_i.wdata
    `l2_resp_fifo_data.opcode`[l2_resp_fifo_wr_ptr_q] = l2_resp_i.opcode
    `l2_resp_fifo_data.data`[l2_resp_fifo_wr_ptr_q] = l2_resp_i.data
    `l2_resp_fifo_data.size`[l2_resp_fifo_wr_ptr_q] = l2_resp_i.size
    `l2_resp_fifo_data.qwen`[l2_resp_fifo_wr_ptr_q] = l2_resp_i.qwen
    l2_resp_fifo_wr_ptr_q = ~l2_resp_fifo_wr_ptr_q
  }
  if l2_resp_fifo_pop {
    l2_resp_fifo_rd_ptr_q = ~l2_resp_fifo_rd_ptr_q
  }
  mut l2_resp_fifo_count_d:U2 = l2_resp_fifo_count_q
  if l2_resp_fifo_push and not l2_resp_fifo_pop {
    wrap l2_resp_fifo_count_d = l2_resp_fifo_count_q + 1
  } elif l2_resp_fifo_pop and not l2_resp_fifo_push {
    wrap l2_resp_fifo_count_d = l2_resp_fifo_count_q - 1
  }
  l2_resp_fifo_count_q = l2_resp_fifo_count_d

  // A gather/scatter lane request that is not itself the G32/SC32 command.
  const s0_core_req_is_valid_gsc = s0_core_req_valid_i != 0 and type_is_gsc(s0_core_req_i.typ) and not cmd_is_gsc32(s0_core_req_i.cmd)
  const s0_valid_to_s1_ordered = s0_core_req_valid_i != 0 or s0_rq_replay_valid
  const s0_md_read_en = s0_co_mr_valid or s0_rq_replay_valid or s0_core_req_valid_i != 0 or s0_co_pf_valid or (DebugApbEn != 0 and s0_dbg_valid)

  // s1 request: the stored word, the 48-bit address register and the thread bit.
  mut s1_rq = rq_unpack(s1_req_pre_addr)
  s1_rq.addr = s1_req_addr
  s1_rq.dest_thread = s1_req_thread_id

  // Thread-selected status, overridden by the owner of tensor/cache-op/L2 requests.
  const s1_vm_thread:U8 = if s1_rq.dest_thread == 1 { vm_status_i#[8..<16] } else { vm_status_i#[0..<8] }
  mut s1_vm_status:VmStatus = vm_unpack(s1_vm_thread)
  if s1_rq.vm_sel == minion_dcache_pkg.DcacheVmSelL2 {
    s1_vm_status = vm_status_l2
  } elif s1_rq.vm_sel == minion_dcache_pkg.DcacheVmSelTs {
    s1_vm_status = vm_status_ts
  } elif s1_rq.vm_sel == minion_dcache_pkg.DcacheVmSelTl1 {
    s1_vm_status = vm_status_tl1
  } elif s1_rq.vm_sel == minion_dcache_pkg.DcacheVmSelTl0 {
    s1_vm_status = vm_status_tl0
  } elif s1_rq.vm_sel == minion_dcache_pkg.DcacheVmSelCo {
    s1_vm_status = vm_status_co
  }

  // Breakpoint match request of the s1 access (the extra address bit is the sign-extension of bit VaSize-1).
  const s1_bp_conf_addr_msb:U1 = (s1_rq.addr_msb_err ^ ((s1_req_addr >> (minion_dcache_pkg.VaSize - 1)) & 1))#[0]
  const s1_bp_conf:BpConf = (address=(s1_req_addr, s1_bp_conf_addr_msb)#[..], cmd=s1_bp_conf_cmd#[0..<3], thread_id=s1_req_thread_id)

  const s1_valid_to_tlb = s1_valid and (s1_core_kill_i == 0 or s1_rq.replay != 0 or s1_rq.cache_op != 0)
  const s1_tlb_req_va:U36 = s1_rq.addr#[12..<48]

  // Gather/scatter element addresses: the byte offset inside the 32-byte block, per element size.
  mut s1_block_offset:U5 = 0
  if s1_rq.typ == minion_dcache_pkg.DcTypePsGs8 {
    s1_block_offset = s1_rq.addr#[0..<5]
  } elif s1_rq.typ == minion_dcache_pkg.DcTypePsGs16 {
    s1_block_offset = s1_rq.addr#[1..<5] << 1
  } elif s1_rq.typ == minion_dcache_pkg.DcTypePsGs32 {
    s1_block_offset = s1_rq.addr#[2..<5] << 2
  }

  // One 5-bit index per ps_mask lane (item index scaled to bytes, plus the block offset) and the
  // gather-enable of the data-array bank each lane touches.
  const s1_gather_valid = s1_valid and cmd_is_gsc32(s1_rq.cmd)
  mut s1_to_s2_gsc32_indices:U40 = 0
  mut s1_gather32_en:U4 = 0
  for i in 0..<8 {
    if s1_rq.ps_mask#[i] != 0 {
      mut idx:U5 = 0
      if s1_rq.typ == minion_dcache_pkg.DcTypePsGs8 {
        idx = s1_rq.gsc32_idx#[i*5..<(i + 1)*5]
      } elif s1_rq.typ == minion_dcache_pkg.DcTypePsGs16 {
        idx = s1_rq.gsc32_idx#[i*4..<(i + 1)*4] << 1
      } elif s1_rq.typ == minion_dcache_pkg.DcTypePsGs32 {
        idx = s1_rq.gsc32_idx#[i*3..<(i + 1)*3] << 2
      }
      wrap idx = idx + s1_block_offset
      s1_to_s2_gsc32_indices#[i*5..<(i + 1)*5] = idx
      s1_gather32_en#[(idx >> minion_dcache_pkg.DcacheBankSelLsb)#[0..<2]] = U1(s1_gather_valid)
    }
  }

  // Tag that a way without valid metadata presents (3 set bits that disappear when the sets are reduced).
  const s1_invalid_way_tag:U3 = if sets_reduced { 0 } else { s1_rq.set#[1..<4] }

  // s3 load path: bypass the freshly stored lane data over the array read data.
  mut s3_data_bypassed:U256 = 0
  for i in 0..<4 {
    s3_data_bypassed#[i*64..<(i + 1)*64] = if s3_store_bypass#[i] != 0 { s3_store_bypass_data#[i*64..<(i + 1)*64] } else { s3_data[i] }
  }
  // Rotate so the addressed byte comes first.
  const s3_data_twice:U512 = (s3_data_bypassed, s3_data_bypassed)#[..]
  const s3_data_aligned:U256 = (s3_data_twice >> (s3_rq.addr#[0..<5] << 3))#[0..<256]

  // Byte-merge select: whole word, or from the address onward for the second half of a misaligned access.
  mut s3_data_merge_sel:U32 = 0
  if s3_rq.uc_load_2nd != 0 or s3_reduce_op_inst {
    s3_data_merge_sel = 0xffffffff
  } elif s3_rq.misaligned_2nd != 0 {
    s3_data_merge_sel = 0xffffffff >> s3_rq.addr#[0..<5]
  }
  mut s3_data_merged:U256 = 0
  for i in 0..<32 {
    s3_data_merged#[i*8..<(i + 1)*8] = if s3_data_merge_sel#[i] != 0 { s3_store_data#[i*8..<(i + 1)*8] }
      else { s3_data_aligned#[i*8..<(i + 1)*8] }
  }

  // Load result extension to 64 bits.
  const s3_data_extended:U64 = if s3_reduce_op_inst {
    s3_data_merged#[0..<64]
  } elif s3_rq.typ == minion_dcache_pkg.DcTypeB or s3_rq.typ == minion_dcache_pkg.DcTypePsGs8 {
    s3_data_merged#[0..<8]#sext[0..=7]#[0..<64]
  } elif s3_rq.typ == minion_dcache_pkg.DcTypeH or s3_rq.typ == minion_dcache_pkg.DcTypePsGs16 {
    s3_data_merged#[0..<16]#sext[0..=15]#[0..<64]
  } elif s3_rq.typ == minion_dcache_pkg.DcTypeW or s3_rq.typ == minion_dcache_pkg.DcTypePsGs32 {
    s3_data_merged#[0..<32]#sext[0..=31]#[0..<64]
  } elif s3_rq.typ == minion_dcache_pkg.DcTypeBu {
    s3_data_merged#[0..<8]
  } elif s3_rq.typ == minion_dcache_pkg.DcTypeHu {
    s3_data_merged#[0..<16]
  } elif s3_rq.typ == minion_dcache_pkg.DcTypeWu {
    s3_data_merged#[0..<32]
  } else {
    s3_data_merged#[0..<64]
  }
  const s3_is_gather32 = s3_rq.cmd == minion_dcache_pkg.DcCmdG32 and s3_valid

  // Gather: element i of the load comes from the byte/half/word the lane index selects.
  mut s3_data_gather32:U256 = 0
  for i in 0..<8 {
    const idx:U5 = s3_gsc32_indices[i]
    const gs_word:U32 = (s3_data_bypassed >> (idx#[2..<5]*32))#[0..<32]
    const gs_half:U16 = (s3_data_bypassed >> (idx#[1..<5]*16))#[0..<16]
    const gs_byte:U8 = (s3_data_bypassed >> (idx*8))#[0..<8]
    if s3_rq.typ == minion_dcache_pkg.DcTypePsGs8 {
      s3_data_gather32#[i*32..<(i + 1)*32] = gs_byte#sext[0..=7]#[0..<32]
    } elif s3_rq.typ == minion_dcache_pkg.DcTypePsGs16 {
      s3_data_gather32#[i*32..<(i + 1)*32] = gs_half#sext[0..=15]#[0..<32]
    } elif s3_rq.typ == minion_dcache_pkg.DcTypePsGs32 {
      s3_data_gather32#[i*32..<(i + 1)*32] = gs_word
    } else {
      s3_data_gather32#[i*32..<(i + 1)*32] = 0
    }
  }
  const s3_load_data_mux1:U256 = (s3_data_extended, s3_data_merged#[64..<256])#[..]
  const s3_load_data:U256 = if s3_is_gather32 { s3_data_gather32 } else { s3_load_data_mux1 }

  // Compare-and-swap stores the x31 operand next to the store data.
  mut s3_store_amo_ext_data:U256 = s3_store_data
  if s3_rq.cmd == minion_dcache_pkg.DcCmdXaCmpswp {
    if type_is_word(s3_rq.typ) {
      s3_store_amo_ext_data#[64..<96] = s3_core_x31_i#[0..<32]
    } else {
      s3_store_amo_ext_data#[64..<128] = s3_core_x31_i#[0..<64]
    }
  }
  // Write data of the buffer array: reduce sends the raw store data, stores the amo-extended one.
  const s3_ba_write_data:U256 = if s3_reduce_send_inst { s3_store_data }
    elif s3_is_write { s3_store_amo_ext_data }
    else { s3_load_data_mux1 }

  // Scatter: stores land in the lane the element index addresses (default: the loaded data passes through).
  mut s3_scatter32_data:U256 = s3_data_bypassed
  for i in 0..<8 {
    if s3_rq.ps_mask#[i] != 0 {
      const idx:U5 = s3_gsc32_indices[i]
      const lane_base = (idx >> minion_dcache_pkg.DcacheBankSelLsb)#[0..<2]*0x40
      if s3_rq.typ == minion_dcache_pkg.DcTypePsGs8 {
        const at = lane_base + (idx#[0..<3]*8)
        s3_scatter32_data#[at..+8] = s3_store_data#[i*32..<(i*32 + 8)]
      } elif s3_rq.typ == minion_dcache_pkg.DcTypePsGs16 {
        const at = lane_base + (idx#[1..<3]*16)
        s3_scatter32_data#[at..+16] = s3_store_data#[i*32..<(i*32 + 16)]
      } elif s3_rq.typ == minion_dcache_pkg.DcTypePsGs32 {
        const at = lane_base + (idx#[2..<3]*32)
        s3_scatter32_data#[at..+32] = s3_store_data#[i*32..<(i*32 + 32)]
      }
    }
  }

  // ---- s3: load/store reservation, store merge, hand-off to s4 -----------------------------------
  const s3_lr = s3_rq.cmd == minion_dcache_pkg.DcCmdXlr
  const s3_sc:Bool = s3_rq.cmd == minion_dcache_pkg.DcCmdXsc
  const s3_lrsc_valid = s3_lrsc_count != 0
  const s3_lrsc_addr_match:Bool = s3_lrsc_valid and s3_lrsc_addr == s3_rq.addr#[6..<40]
  const s3_sc_fail:Bool = s3_sc and s3_valid and not s3_lrsc_addr_match
  // The reservation lasts 31 cycles after an LR, is consumed by any following access and is dropped by an invalidate.
  mut s3_lrsc_count_next:U5 = s3_lrsc_count
  if s3_lrsc_valid {
    wrap s3_lrsc_count_next = s3_lrsc_count - 1
  }
  if s3_valid {
    if s3_lr {
      s3_lrsc_count_next = 31
    } elif s3_lrsc_valid {
      s3_lrsc_count_next = 0
    }
  }
  if s3_invalidate_lr_i != 0 {
    s3_lrsc_count_next = 0
  }
  s3_lrsc_count = s3_lrsc_count_next
  // No reset on the address: hold it while rst_ni is low.
  if rst_ni != 0 and s3_valid and s3_lr {
    s3_lrsc_addr = s3_rq.addr#[6..<40]
  }

  s5_valid = s4_valid
  vpu_scp_bid_1 = VpuEn != 0 and s1_vpu_ctrl_i.scp_req.bid != 0
  vpu_scp_bid_2 = vpu_scp_bid_1

  // ---- L2 request output muxes ---------------------------------------------------------------------
  // Each output port takes the lowest-numbered pipe stage whose request it can accept this cycle
  // (the select ends on the last lane when nobody fires).
  const l2_evict_ready:U2 = (l2_evict_req_ready_i.e0, l2_evict_req_ready_i.e1)#[..]
  mut l2_evict_mux_ready:U2 = 0
  mut l2_evict_valid_out:U2 = 0
  mut l2_evict_handshake = false
  mut l2_evict_mux_select:U1 = 1
  for i in 0..<2 {
    if not l2_evict_handshake {
      const fire = l2_evict_mux_valid#[i] != 0 and l2_evict_ready#[i] != 0
      l2_evict_valid_out#[i] = U1(fire)
      l2_evict_mux_ready#[i] = U1(fire)
      l2_evict_handshake = fire
      l2_evict_mux_select = i
    }
  }
  const l2_evict_req_mux = evict_unpack(l2_evict_mux_data_in[l2_evict_mux_select])

  const l2_miss_ready:U3 = (l2_miss_req_ready_i.e0, l2_miss_req_ready_i.e1, l2_miss_req_ready_i.e2)#[..]
  mut l2_miss_mux_ready:U3 = 0
  mut l2_miss_valid_out:U3 = 0
  mut l2_miss_handshake = false
  mut l2_miss_mux_select:U2 = 3
  for i in 0..<3 {
    if not l2_miss_handshake {
      const fire = l2_miss_mux_valid#[i] != 0 and l2_miss_ready#[i] != 0
      l2_miss_valid_out#[i] = U1(fire)
      l2_miss_mux_ready#[i] = U1(fire)
      l2_miss_handshake = fire
      l2_miss_mux_select = i
    }
  }
  const l2_miss_mux_word:U86 = if l2_miss_mux_select#[0..<2] < 3 { l2_miss_mux_data_in[l2_miss_mux_select#[0..<2]] } else { 0 }
  const l2_miss_req_mux = miss_unpack(l2_miss_mux_word)

  // A pipe stage can accept a request when it is empty or being drained.
  const l2_evict_pipe_ready:U2 = l2_evict_mux_ready | ~l2_evict_mux_valid
  const l2_miss_pipe_ready:U3 = l2_miss_mux_ready | ~l2_miss_mux_valid
  const ts_l2_evict_ready = l2_evict_pipe_ready#[0] != 0
  const arb_l2_evict_ready = l2_evict_pipe_ready#[1] != 0
  const arb_l2_miss_ready = l2_miss_pipe_ready#[2] != 0

  const dbg_md_write_data:MetaData = (coh_state=apb_pwdata_i#[33..<35], tag=apb_pwdata_i#[0..<33])
  const dbg_da_write_data:U64 = apb_pwdata_i#[0..<64]
  const dbg_apb_paddr:U9 = apb_paddr_i#[0..<9]
  const dbg_md_read_addr:U6 = dbg_apb_paddr#[0..<6]
  const dbg_md_write_addr:U6 = dbg_apb_paddr#[0..<6]
  const dbg_da_read_addr:U9 = dbg_apb_paddr
  const dbg_da_write_addr:U9 = dbg_apb_paddr

  // ---- s3 store merge and the word handed to s4 -------------------------------------------------
  const s3_store_merged:U256 = minion_dcache_store_merge_unit(addr_i=s3_rq.addr#[0..<5], typ_i=s3_rq.typ, ps_mask_i=s3_rq.ps_mask, orig_data_i=s3_data_bypassed, store_data_i=s3_store_data, enable_lo_i=U1(s3_misaligned_case_3 or s3_rq.misaligned_2nd != 0), enable_hi_i=U1(s3_rq.misaligned_2nd == 0))
  // Gather/scatter stores write all four lanes with the scattered data instead.
  // rq_pack(rq_unpack(w)) == w, so only the data field (bits 66..<322) is replaced.
  const s3_req_to_s4_data:U256 = if s3_rq.cmd == minion_dcache_pkg.DcCmdSc32 { s3_scatter32_data } else { s3_store_merged }
  mut s3_req_to_s4:U406 = s3_req
  s3_req_to_s4#[66..<322] = s3_req_to_s4_data

  s4_valid = s3_valid and not s3_sc_fail and s3_is_write
  if s3_valid and s3_is_write {
    s4_req = s3_req_to_s4
    s4_way = s3_way
    s4_misaligned_case_3 = s3_misaligned_case_3
  }

  // ---- s0: request arbitration ------------------------------------------------------------------------
  // A gather/scatter lane that the mask masks out, an empty packed-single request, and a request of a thread
  // whose pipeline is being flushed by an s1 TLB miss never enter the pipe.
  const s0_core_req_valid_killed = (s0_core_req_is_valid_gsc and s0_core_req_i.ps_mask#[s0_core_req_i.gsc_cnt] == 0) or (s0_core_req_valid_i != 0 and type_is_ps(s0_core_req_i.typ) and s0_core_req_i.ps_mask == 0) or s1_tlb_flush_pipeline#[s0_core_req_i.dest.thread_id] != 0
  const s0_valid_to_s1 = (s0_core_req_valid_i != 0 and not s0_core_req_valid_killed) or s0_rq_replay_valid or s0_co_pf_valid
