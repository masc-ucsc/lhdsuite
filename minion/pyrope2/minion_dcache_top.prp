  s5_store_bypass = s5_store_bypass_m
  s5_store_bypass_data = s5_store_bypass_data_m

  // Texture send is not implemented in this core: the sender (verilog minion_dcache_texsend) is a tie-off that
  // is always idle and ready and never requests the L2 or the writeback unit.
  const tx_idle = true
  const tex_send_ready = true
  const tx_l2_miss_valid = false
  const tx_l2_miss_word:U86 = 0
  const tx_wb_valid = false
  const tx_wb_word:U50 = 0

  // ---- s3: response to the core, ordering, idle ------------------------------------------------------------------
  mut s3_resp_data:U256 = s3_load_data
  s3_resp_data#[0] = s3_load_data#[0] | U1(s3_sc_fail)
  const s3_resp_msb:U1 = s3_rq.addr_msb_err ^ s3_rq.addr#[47]
  const s3_resp_addr:U49 = (s3_rq.addr#[0..<48], s3_resp_msb)#[..]
  const s3_resp_typ:U4 = if s3_reduce_op_inst or s3_is_gather32 { minion_dcache_pkg.DcTypePs } else { s3_rq.typ }
  const s3_resp_ps_mask:U8 = s3_rq.ps_mask | (if s3_reduce_op_inst { 0xff } else { 0 })

  // Per thread: nothing of that thread in flight in s0..s4, its fence is ready and its replay queue empty.
  mut s3_ordered:U2 = 0
  for t in 0..<2 {
    s3_ordered#[t] = U1(not (s0_valid_to_s1_ordered and s0_req_thread_id_ordered == t) and not (s1_valid and s1_rq.dest_thread == t) and not (s2_valid and s2_rq.dest_thread == t) and not (s3_valid and s3_rq.dest_thread == t) and not (s4_valid and s4_rq.dest_thread == t) and s2_mh_fence_rdy#[t] != 0 and s2_rq_empty#[t] != 0 and not dcache_cfg_stall)
  }
  const dcache_idle_common = not s0_valid_to_s1_ordered and not s1_valid and not s2_valid and not s3_valid and not s4_valid and s2_rq_empty == 3 and not tl0_working and not cacheop_busy and not cacheop_l2_busy and mh_idle and wb_ready and reduce_ready and tx_idle
  dcache_idle = dcache_idle_common and not tl1_working
  dcache_idle_excl_mode_o = U1(dcache_idle_common)

  // ---- s0 pipe-slot arbitration -----------------------------------------------------------------------------------
  // Requesters in priority order; the core's own gather/scatter, the reduce engine and the cache-op meta read
  // take the s0 slot before any of them.
  const id_dbg_nvpu_bid = id_dbg_bid and not vpu_scp_bid_2
  const id_wb_da_nvpu_bid = id_wb_da_bid and not vpu_scp_bid_2
  const id_free_of_core = s0_core_gsc_i == 0 and not re_pipe_used and not id_co_mr_bid
  const id_dbg_grant = id_free_of_core and id_dbg_nvpu_bid
