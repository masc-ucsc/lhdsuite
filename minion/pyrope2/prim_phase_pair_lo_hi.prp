// Two-phase latch pair, low phase first, with an asynchronous reset
// (verilog: prim_phase_pair_lo_hi). q_lo follows d_i while the clock is low
// (if the enable captured while it was high allows it); q_hi copies q_lo while
// the clock is high (if the enable captured while it was low allows it).
pub mod prim_phase_pair_lo_hi<Width=1>::[timecheck=false](clk_i:Clock, d_i:Unsigned(bits=Width), hi_en_i:U1, lo_en_i:U1, reset_i:U1) -> (q_hi_o:Unsigned(bits=Width)@[], q_lo_o:Unsigned(bits=Width)@[]) {
  reg lo_en_2p:U1:[async=true, enable=clk_i, latch=true, reset_pin=reset_i] = 0
  reg hi_en_1p:U1:[async=true, enable=clk_i, enable_high=false, latch=true, reset_pin=reset_i] = 0
  reg q_lo_reg:Unsigned(bits=Width):[async=true, enable=clk_i, enable_high=false, latch=true, reset_pin=reset_i] = 0
  reg q_hi_reg:Unsigned(bits=Width):[async=true, enable=clk_i, latch=true, reset_pin=reset_i] = 0

  lo_en_2p = lo_en_i
  hi_en_1p = hi_en_i
  if lo_en_2p == 1 {
    q_lo_reg = d_i
  }
  if hi_en_1p == 1 {
    q_hi_reg = q_lo_reg
  }
  q_lo_o = q_lo_reg
  q_hi_o = q_hi_reg
}
