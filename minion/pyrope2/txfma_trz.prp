// Trailing-zero count of a (Max+1)-bit fraction; an all-zero fraction yields
// Max+1. The lowest set bit has the highest priority.
pub comb txfma_trz<Max=23>(frac_i:Unsigned(bits=Max + 1)) -> (trz_o:Unsigned(bits=std.clog2(Max + 2))) {
  trz_o = Max + 1
  for i in 0..=Max {
    const bit = Max - i
    if frac_i#[bit] != 0 {
      trz_o = bit
    }
  }
}
