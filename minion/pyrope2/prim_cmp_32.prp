// 3:2 carry-save compressor (verilog: prim_cmp_32): per-bit full adder, sum and carry vectors.
pub comb prim_cmp_32<Width=1>(a:Unsigned(bits=Width), b:Unsigned(bits=Width), c:Unsigned(bits=Width)) -> (cv:Unsigned(bits=Width), sv:Unsigned(bits=Width)) {
  sv = a ^ b ^ c
  cv = (a & b) | (a & c) | (b & c)
}
