// Thread `tid`'s W-bit field of a per-thread CSR bank (thread 0 occupies the low W bits).
comb thread_slice<W>(bank, tid) -> (field) {
  field = (bank >> (tid*W))#[0..<W]
}
// Canonical virtual-address extension of a CSR write: keep bits [47:0] and make bit 48 equal bit 47 when
// bits [63:47] are all copies of it (a canonical address); otherwise bit 48 is inverted so the result stays non-canonical.
comb extend_va(addr:U64) -> (va:U49) {
  const sign = addr#[47..<48]
  const upper = addr#[47..<64]
  va#[0..<48] = addr#[0..<48]
  va#[48..<49] = if upper == 0x1ffff or upper == 0 { sign } else { U1(sign == 0) }
}
// CSR register file of the minion integer pipe (verilog: intpipe_csr_file). Holds the per-thread machine,
// supervisor, debug, tensor and performance-monitor CSRs; decodes CSR reads/writes arriving from the MEM stage
// and commits them in WB. A CSR written in WB first records a per-thread write enable (the *_en registers, one
// bit per thread); that enable then opens the matching latch bank (prim_write_commit_*) on the gated clocks
// clock_wb / clock_dec. rst_ni resets the decode-side enables, rst_w_ni the WB-side architectural state.
// test_en, dft__reset_byp and dft__reset are unused (as in the Verilog); they stay so the instance keeps the
// Verilog port list, because lhd lec of the parent (intpipe_top) goes UNKNOWN when they are dropped (livehd_bugs/L2u0_01).
