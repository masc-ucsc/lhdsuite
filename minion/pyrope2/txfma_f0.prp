// Stage f0: register the bypassed FMA operands and their controls, then format them
// (exponent select, F16/F11/F10/graphics/transcendental fraction words, denormal flush)
// and extract the sign/exponent classification flags used by later stages.
const vpu_defs_pkg = import("vpu_defs_pkg")

// {hidden bit = nz, fraction (flushed to 0 when nz is 0)} placed at bit positions HID and POS.
comb mant<N=23, HID=31, POS=8>(frac:Unsigned(bits=N), nz:U1) -> (r:U32) {
  const f:Unsigned(bits=N) = if nz != 0 { frac } else { 0 }
  r = (nz << HID) | (f << POS)
}

// 1 when the 8-bit exponent, with its upper three bits forced to ones when force_hi is set, is all ones.
comb exp_all1(e:U8, force_hi:U1) -> (r:U1) {
  const upper:U3 = if force_hi != 0 { 7 } else { e#[5..<8] }
  r = U1(((upper << 5) | e#[0..<5]) == 0xff)
}

