  faph_hi_zero_f0a_l = txfma_frac.faph_hi_zero_f0a_l
  fbph_hi_zero_f0a_l = txfma_frac.fbph_hi_zero_f0a_l
  faph_lo_zero_f0a_l = txfma_frac.faph_lo_zero_f0a_l
  fbph_lo_zero_f0a_l = txfma_frac.fbph_lo_zero_f0a_l
  faph_lo_b0_f0a_h = txfma_frac.faph_lo_b0_f0a_h
  fbph_lo_b0_f0a_h = txfma_frac.fbph_lo_b0_f0a_h
  faps_b0_f0a_h = txfma_frac.faps_b0_f0a_h
  fbps_b0_f0a_h = txfma_frac.fbps_b0_f0a_h
  fc_31_f0a_h = txfma_frac.fc_31_f0a_h
  fcps_b0_f0a_h = txfma_frac.fcps_b0_f0a_h
  ediff1_f2a_h = txfma_exp.ediff1_f2a_h
  ediff1_abs_f2a_h = txfma_exp.ediff1_abs_f2a_h
  ediff2_abs_f2a_h = txfma_exp.ediff2_abs_f2a_h
  ediff1_sel_f2a_h = txfma_exp.ediff1_sel_f2a_h
  ediff2_sel_f2a_h = txfma_exp.ediff2_sel_f2a_h
  align1_mux_sel_f2a_h = txfma_exp.align1_mux_sel_f2a_h
  align2_mux_sel_f2a_h = txfma_exp.align2_mux_sel_f2a_h
  ec_f2a_h = txfma_exp.ec_f2a_h
  fc_b0_f2a_h = txfma_frac.fc_b0_f2a_h
  e_sticky1_f2a_h = txfma_exp.e_sticky1_f2a_h
  e_sticky2_f2a_h = txfma_exp.e_sticky2_f2a_h
  opd3_mux_sel_f2a_h = txfma_exp.opd3_mux_sel_f2a_h
  ediff2_f3a_h = txfma_exp.ediff2_f3a_h
  ec_f3a_h = txfma_exp.ec_f3a_h
  e_sticky1_f3a_h = txfma_exp.e_sticky1_f3a_h
  prodsum_a2_f3a_h = txfma_frac.prodsum_a2_f3a_h
  fround_rbit_f3a_h = txfma_frac.fround_rbit_f3a_h
  ph_comb_stiky_f4a_h = txfma_exp.ph_comb_stiky_f4a_h
  elxd_f4a_h = txfma_frac.elxd_f4a_h
  etrz50_f4a_h = txfma_frac.etrz50_f4a_h
  stky2g_f5a_h = txfma_exp.stky2g_f5a_h
  comb_add_a3_f5a_h = txfma_frac.comb_add_a3_f5a_h
  ediff1_zap_f5a_h = txfma_exp.ediff1_zap_f5a_h
  exp_res_zero_f6a_h = txfma_exp.exp_res_zero_f6a_h
  pot_ovf_ps_f6a_h = txfma_exp.pot_ovf_ps_f6a_h
  def_ovf_ps_f6a_h = txfma_exp.def_ovf_ps_f6a_h
  pot_unf_ps_f6a_h = txfma_exp.pot_unf_ps_f6a_h
  def_unf_ps_f6a_h = txfma_exp.def_unf_ps_f6a_h
  pot_ovf_ph_f6a_h = txfma_exp.pot_ovf_ph_f6a_h
  def_ovf_ph_f6a_h = txfma_exp.def_ovf_ph_f6a_h
  pot_unf_ph_f6a_h = txfma_exp.pot_unf_ph_f6a_h
  def_unf_ph_f6a_h = txfma_exp.def_unf_ph_f6a_h
  frac_zero_f6a_h = txfma_frac.frac_zero_f6a_h
  rnd_l_ph_f6a_h = txfma_frac.rnd_l_ph_f6a_h
  rnd_r_ph_f6a_h = txfma_frac.rnd_r_ph_f6a_h
  rnd_l_ps_f6a_h = txfma_frac.rnd_l_ps_f6a_h
  rnd_r_ps_f6a_h = txfma_frac.rnd_r_ps_f6a_h
  int_res_l_bit_f6a_h = txfma_frac.int_res_l_bit_f6a_h
  exp_res_2f3_f2a_h = txfma_exp.exp_res_2f3_f2a_h
  ediff_abs_diff_hi_f2a_h = txfma_exp.ediff_abs_diff_hi_f2a_h
  align2_rshamt_c3_f2a_h = txfma_exp.align2_rshamt_c3_f2a_h
  exp_res_f6a_h = txfma_exp.exp_res_f6a_h
  // ---- Pipeline registers ----
  if txfma_ctl.ctrl_valid_f0a_h == 1 {
    txfma0_ea_hi_f1a_h = txfma_frac.ea_hi_f0a_h
    txfma0_eb_hi_f1a_h = txfma_frac.eb_hi_f0a_h
    txfma0_ea_lo_f1a_h = txfma_frac.ea_lo_f0a_h
    txfma0_eb_lo_f1a_h = txfma_frac.eb_lo_f0a_h
    txfma0_ec_f1a_h = txfma_frac.ec_f0a_h
    txfma0_ec_all1_f1a_h = ec_all1_f0a_h
  }

  if txfma_ctl.ctrl_valid_f1a_h == 1 {
    txfma0_fa_en_f2a_h = txfma_ctl.fa_en_f1a_h
    txfma0_ea_hi_f2a_h = txfma0_ea_hi_f1a_h
    if txfma_ctl.fa_en_f1a_h == 1 {
      txfma0_eb_hi_lsb_f2a_h = txfma0_eb_hi_f1a_h#[0]
    }
  }

  if txfma_ctl.ctrl_valid_f2a_h == 1 {
    txfma0_ea_hi_f3a_h = txfma0_ea_hi_f2a_h
    txfma0_ediff1_f3a_h = ediff1_f2a_h
    if txfma0_fa_en_f2a_h == 1 {
      txfma0_eb_hi_lsb_f3a_h = txfma0_eb_hi_lsb_f2a_h
    }
  }

  if txfma_ctl.ctrl_valid_f3a_h == 1 {
    txfma0_ea_hi_f4a_h = txfma0_ea_hi_f3a_h
    txfma0_eb_hi_lsb_f4a_h = txfma0_eb_hi_lsb_f3a_h
    txfma0_s_res_f4a_h = txfma_ctl.s_res_f3a_h
  }

  if txfma_ctl.ctrl_valid_f4a_h == 1 {
    txfma0_ea_hi_f5a_h = txfma0_ea_hi_f4a_h
    txfma0_s_res_f5a_h = txfma0_s_res_f4a_h
  }

  // The reset is the registers' own sync reset; nothing else gates these writes.
  if txfma_ctl.ctrl_valid_f5a_h == 1 {
    txfma0_s_res_f6a_h = txfma_ctl.s_res_out_f5a_h
    txfma0_rmode_f6a_h = txfma_exp.rmode_f5a_h
    txfma0_ph_stky2l_f6a_h = txfma_frac.ph_stky2l_f5a_h
    txfma0_ps_stky2l_f6a_h = txfma_frac.ps_stky2l_f5a_h
    txfma0_int32_stky2l_f6a_h = txfma_frac.int32_stky2l_f5a_h
    txfma0_ph_allone2r_f6a_h = txfma_frac.ph_allone2r_f5a_h
    txfma0_ph_allone2l_f6a_h = txfma_frac.ph_allone2l_f5a_h
    txfma0_ps_allone2r_f6a_h = txfma_frac.ps_allone2r_f5a_h
    txfma0_ps_allone2l_f6a_h = txfma_frac.ps_allone2l_f5a_h
  }

  // ---- Outputs: results are only presented while the F6 stage holds an instruction ----
  const out_valid = txfma_ctl.ctrl_valid_f6a_h == 1
  out_data_res.data = if out_valid { txfma_frac.fma_res_f6a_h } else { 0 }
  out_data_res.exc = if out_valid { txfma_ctl.fma_flags_f6a_h } else { 0 }
  out_comp_res = txfma_ctl.comp_op_true_f6a_h & txfma_ctl.ctrl_valid_f6a_h
}
