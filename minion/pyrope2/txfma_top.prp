// Tensor FMA lane (one `txfma` pipeline): wires the control pipeline (txfmactl_top), the fraction
// datapath (txfmafrac_top) and the exponent datapath (txfmaexp_top) together and owns the small
// pipeline registers that carry exponents/sign between those units from F0 to F6.
// The three units depend on each other (control <-> fraction <-> exponent), so signals that a unit
// reads before its producer is instantiated come through forward `wire`s below.
// ctrl_valid_fN gates every payload register of stage N (they hold when no instruction is in
// flight); only the F6 registers reset, to 0, on `reset`; all other state is unreset.
// The registers keep their Verilog names (txfma0_*) so state pairs with the reference.
const txfmactl_top = import("txfmactl_top.txfmactl_top")
const txfmaexp_top = import("txfmaexp_top.txfmaexp_top")
const txfmafrac_top = import("txfmafrac_top.txfmafrac_top")
