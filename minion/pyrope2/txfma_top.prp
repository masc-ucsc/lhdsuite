  reg txfma0_eb_hi_lsb_f3a_h:U1 = nil
  // F4: ctrl_valid_f3
  reg txfma0_ea_hi_f4a_h:vpu_defs_pkg.TXFMA_EXP_PS_SZ_T = nil
  reg txfma0_eb_hi_lsb_f4a_h:U1 = nil
