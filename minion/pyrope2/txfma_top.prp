  reg txfma0_eb_hi_f1a_h:vpu_defs_pkg.TXFMA_EXP_PS_SZ_T = nil
  reg txfma0_ea_lo_f1a_h:vpu_defs_pkg.TXFMA_EXP_PH_SZ_T = nil
  reg txfma0_eb_lo_f1a_h:vpu_defs_pkg.TXFMA_EXP_PH_SZ_T = nil
