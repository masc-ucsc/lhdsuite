// Stage f5: normalize-shift the carry-propagate sum and compute the rounding controls
// (guard/round/sticky per format, int32 convert) and the merged fraction handed to f6.
const txfma_frac_zero_detect = import("txfma_frac_zero_detect.txfma_frac_zero_detect")
const txfma_norm_shf = import("txfma_norm_shf.txfma_norm_shf")
const vpu_defs_pkg = import("vpu_defs_pkg")

pub mod txfma_f5::[timecheck=false](comb_add_f5a_h:U52, ctrl_f4_clk:Clock, ctrl_f5_clk:Clock, en_logrrsel1b_f5a_l:U1, enc_nsamt_f4a_h:vpu_defs_pkg.TXFMA_NORM_SHF_AMNT_SZ_T, int32_stky2r_f5a_h:U1, int_minmax_res_f5a_h:vpu_defs_pkg.VPU_DATA_S_SZ_T, mmx_sel_immres_f5a_h:U1, neg_norm_f5a_h:U1, nshcen_sel1b_f5a_h:U1, rc_3rmxr_f5a_h:U1, rc_int32_f5a_h:U1, rc_ph_f5a_h:U1, rc_ps_f5a_h:U1, rc_rdn_f5a_h:U1, rc_res_sign_f5a_l:U1, rc_rl01_f5a_h:U1, rc_rmm_f5a_h:U1, rc_rne_f5a_h:U1, rc_rup_f5a_h:U1, rc_transrnd_f5a_h:U1, rc_transrnd_log_fma2_f5a_h:U1, stky2g_f5a_h:U1) -> (comb_add_a3_f5a_h:U1@[], frac_zero_f6a_h:U1@[], ftz_f6a_l:vpu_defs_pkg.TXFMA_FTZ_SZ_T@[], int32_stky2l_f5a_h:U1@[], mergd_frac_res_hi_f6a_h:U33@[], nshc_f5a_h:U1@[], ph_allone2l_f5a_h:U1@[], ph_allone2r_f5a_h:U1@[], ph_stky2l_f5a_h:U1@[], ps_allone2l_f5a_h:U1@[], ps_allone2r_f5a_h:U1@[], ps_stky2l_f5a_h:U1@[], rnd_l_int_f6a_h:U1@[], rnd_l_ph_f6a_h:U1@[], rnd_l_ps_f6a_h:U1@[], rnd_r_int_f6a_h:U1@[], rnd_r_ph_f6a_h:U1@[], rnd_r_ps_f6a_h:U1@[]) {
  reg frac_zero_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rnd_l_ph_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rnd_r_ph_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rnd_l_ps_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rnd_r_ps_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rnd_l_int_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rnd_r_int_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg ftz_f6a_l:U2:[clock_pin=ctrl_f5_clk]
  reg mergd_frac_res_hi_f6a_h:U33:[clock_pin=ctrl_f5_clk]
  reg enc_nsamt_f5a_h:U7:[clock_pin=ctrl_f4_clk]

  // Bit position of norm_shift_out[0] in the TXFMA_* (A0/B0/...) coordinate system.
  comptime const NSO_BASE = 27
  comptime const MERGD_BASE = 28

  enc_nsamt_f5a_h = enc_nsamt_f4a_h
  const norm_shf = txfma_norm_shf(op_i=comb_add_f5a_h, shfamnt_i=enc_nsamt_f5a_h#[0..<7])
  const nso = norm_shf
  // Negated (one's complement) view of the shifter output for negative results.
  const neg_mask:U34 = if neg_norm_f5a_h != 0 { 0x3ffffffff } else { 0 }
  const nso_neg = (nso ^ neg_mask)#[0..<34]

  // ---- sticky / guard / round bits ----
  const nsh_ls_a0bb0_h:U1 = nshcen_sel1b_f5a_h & nso_neg#[vpu_defs_pkg.TXFMA_B0 - NSO_BASE] & ~nso_neg#[vpu_defs_pkg.TXFMA_A0 - NSO_BASE]
  const nsh_ls_a0bb0_l:U1 = ~nsh_ls_a0bb0_h
  const ph_stky2r:U1 = stky2g_f5a_h
  const ps_stky2r:U1 = stky2g_f5a_h | (nso#[vpu_defs_pkg.TXFMA_B24 - NSO_BASE] & nsh_ls_a0bb0_l)
  const ph_stky2l:U1 = stky2g_f5a_h | int_minmax_res_f5a_h#[20]
  const ps_stky2l:U1 = (nsh_ls_a0bb0_l & nso#[vpu_defs_pkg.TXFMA_B23 - NSO_BASE]) | stky2g_f5a_h | nso#[vpu_defs_pkg.TXFMA_B24 - NSO_BASE]
  const ps_neg_inc:U1 = rc_ps_f5a_h & neg_norm_f5a_h & ~ps_stky2r
  const ph_lbit:U1 = int_minmax_res_f5a_h#[21]
  const ph_rbit:U1 = int_minmax_res_f5a_h#[20]
  const ps_lbit:U1 = (nsh_ls_a0bb0_l & nso_neg#[vpu_defs_pkg.TXFMA_B22 - NSO_BASE]) | (nsh_ls_a0bb0_h & nso_neg#[vpu_defs_pkg.TXFMA_B23 - NSO_BASE])
  const ps_rbit:U1 = (nsh_ls_a0bb0_l & nso_neg#[vpu_defs_pkg.TXFMA_B23 - NSO_BASE]) | (nsh_ls_a0bb0_h & nso_neg#[vpu_defs_pkg.TXFMA_B24 - NSO_BASE])
  const int32_lbit:U1 = nso_neg#[vpu_defs_pkg.TXFMA_B30 - NSO_BASE]
  const int32_rbit:U1 = nso_neg#[vpu_defs_pkg.TXFMA_B31 - NSO_BASE]

  // ---- single-precision round decision (right / left shift variants) ----
  const ps_irr1_l:U1 = ~((ps_rbit & ~ps_lbit & ~(ps_neg_inc | ~rc_rne_f5a_h)) | (~(ps_rbit | ps_lbit | ps_stky2r) & ps_neg_inc & rc_rne_f5a_h) | (rc_rne_f5a_h & ps_rbit & ps_lbit))
  const rnd_r_ps:U1 = ~(~(rc_3rmxr_f5a_h & ps_neg_inc) & ps_irr1_l & ~((~(ps_lbit | ~ps_rbit | ~ps_stky2r) & rc_rne_f5a_h) | (ps_rbit & ~(ps_neg_inc | ~rc_rmm_f5a_h))))
  const ps_t2_l:U1 = ~((ps_lbit ^ ps_rbit) & ~(ps_stky2r | ~(ps_neg_inc & rc_rne_f5a_h)))
  const rnd_l_ps:U1 = ~(~(rc_rl01_f5a_h & ps_stky2l) & ps_t2_l & ~(ps_neg_inc & rc_rmm_f5a_h))

  // ---- int32 convert round decision ----
  const int32_stky2l:U1 = int32_stky2r_f5a_h | nso#[vpu_defs_pkg.TXFMA_B31 - NSO_BASE]
  const int32_cr2:U1 = neg_norm_f5a_h ^ int32_rbit
  const int32_cvtrnel:U1 = ~(~(rc_rne_f5a_h & neg_norm_f5a_h & ~(int32_rbit | int32_lbit)) & ~(rc_rne_f5a_h & int32_cr2 & int32_stky2r_f5a_h) & (neg_norm_f5a_h | ~(rc_rne_f5a_h & int32_rbit & int32_lbit)))
  const int32_crmm:U1 = rc_rmm_f5a_h & int32_cr2
  const int32_b3:U1 = (rc_res_sign_f5a_l & (int32_cvtrnel | int32_crmm | (rc_rup_f5a_h & int32_stky2l))) | (rc_int32_f5a_h & neg_norm_f5a_h & ~((rc_rdn_f5a_h & int32_stky2l) | int32_crmm | int32_cvtrnel))
  const rnd_l_int:U1 = rc_transrnd_f5a_h | (rc_int32_f5a_h & int32_b3)

  // ---- flush-to-zero selects: (ph, ps) ----
  const ftz_ph:U1 = ~(ph_rbit & ~ph_stky2r & rc_rne_f5a_h & rc_ph_f5a_h)
  const ftz_ps:U1 = ~((ps_rbit ^ neg_norm_f5a_h) & ~ps_stky2r & rc_rne_f5a_h & rc_ps_f5a_h)

  // ---- merged fraction: normalized (>>0 / >>1) or the integer min/max result ----
  const mergd_sel_lo:U1 = ~(nsh_ls_a0bb0_h | ~en_logrrsel1b_f5a_l)
  const mergd_sel:U2 = (mergd_sel_lo, mmx_sel_immres_f5a_h)#[..]
  const mergd_frac_res_hi:U33 = if mergd_sel == 0 { nso_neg#[0..<33] }
    elif mergd_sel == 1 { nso_neg#[1..<34] }
    else { int_minmax_res_f5a_h << 1 }
  const frac_zero_detect_hi_1 = txfma_frac_zero_detect<Width=12>(in_data=mergd_frac_res_hi#[21..<33])
  const frac_zero_detect_hi_2 = txfma_frac_zero_detect<Width=21>(in_data=mergd_frac_res_hi#[0..<21])

  // ---- all-ones detect for the rounding-overflow check ----
  const ph_allone2l:U1 = U1(mergd_frac_res_hi#[22..<33] == 0x7ff)
  const ph_allone2r:U1 = ph_allone2l & mergd_frac_res_hi#[vpu_defs_pkg.TXFMA_B10 - MERGD_BASE]
  const ps_allone2l:U1 = ph_allone2r & U1(mergd_frac_res_hi#[9..<21] == 0xfff)

  mergd_frac_res_hi_f6a_h = mergd_frac_res_hi
  ftz_f6a_l = (ftz_ps, ftz_ph)#[..]
  frac_zero_f6a_h = frac_zero_detect_hi_1 & frac_zero_detect_hi_2
  rnd_l_ph_f6a_h = rc_rl01_f5a_h & ph_stky2l
  rnd_r_ph_f6a_h = ph_rbit & (rc_rne_f5a_h | rc_rmm_f5a_h)
  rnd_l_ps_f6a_h = rnd_l_ps
  rnd_r_ps_f6a_h = rnd_r_ps
  rnd_l_int_f6a_h = rnd_l_int
  rnd_r_int_f6a_h = rc_transrnd_log_fma2_f5a_h
  ph_allone2r_f5a_h = ph_allone2r
  ph_allone2l_f5a_h = ph_allone2l
  ps_allone2r_f5a_h = ps_allone2l & mergd_frac_res_hi#[vpu_defs_pkg.TXFMA_B23 - MERGD_BASE]
  ps_allone2l_f5a_h = ps_allone2l
  nshc_f5a_h = nsh_ls_a0bb0_h
  ph_stky2l_f5a_h = ph_stky2l
  ps_stky2l_f5a_h = ps_stky2l
  int32_stky2l_f5a_h = int32_stky2l
  comb_add_a3_f5a_h = comb_add_f5a_h#[vpu_defs_pkg.TXFMA_A3 - 12]
}
