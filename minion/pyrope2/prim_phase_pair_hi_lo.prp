// Two-phase latch pair, high phase first (verilog: prim_phase_pair_hi_lo).
// q_hi follows d_i while the clock is high (if the enable captured while it
// was low allows it); q_lo copies q_hi while the clock is low (if the enable
// captured while it was high allows it).
pub mod prim_phase_pair_hi_lo<Width=1>::[timecheck=false](clk_i:Clock, d_i:Unsigned(bits=Width), hi_en_i:U1, lo_en_i:U1) -> (q_hi_o:Unsigned(bits=Width)@[], q_lo_o:Unsigned(bits=Width)@[]) {
  reg hi_en_1p:U1:[enable=clk_i, enable_high=false, latch=true] = nil
  reg lo_en_2p:U1:[enable=clk_i, latch=true] = nil
  reg q_hi_reg:Unsigned(bits=Width):[enable=clk_i, latch=true] = nil
  reg q_lo_reg:Unsigned(bits=Width):[enable=clk_i, enable_high=false, latch=true] = nil

  hi_en_1p = hi_en_i
  lo_en_2p = lo_en_i
  if hi_en_1p == 1 {
    q_hi_reg = d_i
  }
  if lo_en_2p == 1 {
    q_lo_reg = q_hi_reg
  }
  q_hi_o = q_hi_reg
  q_lo_o = q_lo_reg
}
