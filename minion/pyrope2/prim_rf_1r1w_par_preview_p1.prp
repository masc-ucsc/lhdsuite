// prim_rf_1r1w_par_preview at the replay queue's rearm-record width (54 bits):
// a parallel read port, entry i in bits [i*54, (i+1)*54) of rd_data_o. Kept as
// its own concrete def (not a generic specialization) because a specialization
// gets a mangled def name and hierarchical LEC then cannot pair it with the
// Verilog reference's prim_rf_1r1w_par_preview_p1.
comptime const Width = 54
comptime const Depth = 8
pub mod prim_rf_1r1w_par_preview_p1::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, wr_addr_i:U3, wr_data_en_1p_next_i:U1, wr_data_i:U54, wr_en_i:U1) -> (rd_data_o:U432@[]) {
  reg rf_q:[Depth]Unsigned(bits=Width):[__store_clock_pin=rf_clk_i, __store_posclk=true, ordering="old"]
  reg wr_data_del_q:Unsigned(bits=Width):[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_en_1p_q = wr_data_en_1p_next_i
  if wr_data_en_1p_q != 0 {
    wr_data_del_q = wr_data_i
  }
  if wr_en_i != 0 {
    rf_q[wr_addr_i] = wr_data_del_q
  }
  for i in 0..<Depth {
    rd_data_o#[(i*Width)..<((i + 1)*Width)] = rf_q[i]
  }
}
