// Stage f6: rounding adder and result assembly. Builds the F32/F16/integer/graphics/
// special-value candidate results and selects among them with the stage-f6 controls.
const txfma_rnd_adder = import("txfma_rnd_adder.txfma_rnd_adder")
const vpu_defs_pkg = import("vpu_defs_pkg")

pub mod txfma_f6::[timecheck=false](classify_f6a_h:vpu_defs_pkg.FP_CLASS_BITS_T, ctrl_f5_clk:Clock, effsub1_set_sign1_f6a_h:U1, exp_res_f6a_h:vpu_defs_pkg.TXFMA_EXP_PS_SZ_T, f10f11mux_sel_f6a_h:U1, ftz_f6a_l:(e1:U1, e0:U1), mergd_frac_res_hi_f6a_h:U33, normmask1_f6a_h:U1, normmask2_f6a_h:U1, ph_rndovf_f6a_h:U1, ps_rndovf_f6a_h:U1, rc6_ph_f5a_h:U1, rc6_ps_f5a_h:U1, rc_int32_f5a_h:U1, rnd_l_int_f6a_h:U1, rnd_l_ph_f6a_h:U1, rnd_l_ps_f6a_h:U1, rnd_r_int_f6a_h:U1, rnd_r_ph_f6a_h:U1, rnd_r_ps_f6a_h:U1, rrmux16l_sel_f6a_l:U1, rrmux32_sel_f6a_h:U2, s_res_f6a_h:U1, sel_b30to0_ones_f6a_h:U1, sel_bit31_one_f6a_h:U1, sel_classify_out_f6a_h:U1, sel_excreshi_f6a_h:U2, sel_excreslo_f6a_h:U2, sel_f10cqnan_f6a_h:U1, sel_f10large_f6a_h:U1, sel_f10sp_f6a_h:U1, sel_f11inf_f6a_h:U1, sel_f11large_f6a_h:U1, sel_f11sp_f6a_h:U1, sel_fmares_hi_f6a_h:U2, sel_fmares_lo_f6a_h:U2, sel_gfxmax_f6a_h:U1, sel_gmaxs16_f6a_h:U1, sel_gmaxs8_f6a_h:U1, sel_gmaxu16_f6a_h:U1, sel_gmaxu24_f6a_h:U1, sel_gmaxu2_f6a_h:U1, sel_gmaxu8_f6a_h:U1, sel_gmins16_f6a_h:U1, sel_gmins8_f6a_h:U1, sel_nr1_frcpres_f6a_h:U1, sel_phhi_infres_f6a_h:U1, sel_phhi_large_f6a_h:U1, sel_phhi_sr_f6a_h:U1, sel_phhi_unf_f6a_h:U1, sel_phsp_f6a_h:U1, sel_ps_cqn_f6a_h:U1, sel_ps_inf_f6a_h:U1, sel_ps_large_f6a_h:U1, sel_ps_normone_f6a_h:U1, sel_ps_unf_f6a_h:U1, sel_psexc_sr_f6a_h:U1, sel_set_bit0_one_f6a_h:U1, sel_zerores_f6a_h:U1, trans2_ps_roundup_r_f5a_h:U1, trans_sinp2m_f6a_h:U1) -> (fma_res_f6a_h:vpu_defs_pkg.VPU_DATA_S_SZ_T@[], int_res_l_bit_f6a_h:U1@[]) {
  reg trans2_ps_roundup_r_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rc_ph_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rc_ps_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  reg rc_int32_f6a_h:U1:[clock_pin=ctrl_f5_clk]
  trans2_ps_roundup_r_f6a_h = trans2_ps_roundup_r_f5a_h
  rc_ph_f6a_h = rc6_ph_f5a_h
  rc_ps_f6a_h = rc6_ps_f5a_h
  rc_int32_f6a_h = rc_int32_f5a_h

  // ---- rounding: round-up controls per format feed the rounding adder ----
  const ps_rnd_r:U1 = trans2_ps_roundup_r_f6a_h | (rnd_r_ps_f6a_h & rc_ps_f6a_h)
  const ps_rnd_l:U1 = rnd_l_ps_f6a_h & rc_ps_f6a_h
  const ph_rnd_r:U1 = rnd_r_ph_f6a_h & rc_ph_f6a_h
  const ph_rnd_l:U1 = rnd_l_ph_f6a_h & rc_ph_f6a_h
  const int_rnd_l:U1 = rnd_l_int_f6a_h & rc_int32_f6a_h
  const rndadd32_ina:U32 = mergd_frac_res_hi_f6a_h#[1..<33]
  const rnd_ctl:U5 = (int_rnd_l, ps_rnd_r, ps_rnd_l, ph_rnd_r, ph_rnd_l)#[..]
  const rnd_cin:U1 = mergd_frac_res_hi_f6a_h#[vpu_defs_pkg.TXFMA_B31 - 28] & rnd_r_int_f6a_h
  const rnd_adder = txfma_rnd_adder(`in`=(rndadd32_ina << 1) | 1, rnd_ctl=rnd_ctl, cin=rnd_cin)
  const rndres_hi:U32 = rnd_adder

  // Rounded fraction with the flush-to-zero selects applied to bits 21 (ph) and 8 (ps).
  const rndres_b21:U1 = rndres_hi#[21] & ftz_f6a_l.e1
  const rndres_b8:U1 = rndres_hi#[8] & ftz_f6a_l.e0
  const rndres32:U32 = (rndres_hi#[0..<8], rndres_b8, rndres_hi#[9..<21], rndres_b21, rndres_hi#[22..<32])#[..]

  // ---- integer result: normalization masks clear the upper byte fields ----
  const nm1_hi:U10 = if normmask1_f6a_h != 0 { rndres32#[22..<32] } else { 0 }
  const nm1_b13:U1 = rndres_hi#[21] & normmask1_f6a_h
  const nm1_mid:U5 = if normmask1_f6a_h != 0 { rndres32#[16..<21] } else { 0 }
  const nm2_mid:U7 = if normmask2_f6a_h != 0 { rndres32#[9..<16] } else { 0 }
  const nm2_b0:U1 = rndres32#[8] & normmask2_f6a_h
  const intres32:U24 = (nm2_b0, nm2_mid, nm1_mid, nm1_b13, nm1_hi)#[..]

  const class_logfma2_nr1_frcp:U32 = if sel_classify_out_f6a_h == 0 and sel_nr1_frcpres_f6a_h == 0 { rndres_hi#[0..<25] }
    elif sel_classify_out_f6a_h == 0 { rndres32#[0..<31] << 1 }
    else { classify_f6a_h#[0..<10] }
  const sf_res:U1 = s_res_f6a_h | effsub1_set_sign1_f6a_h

  // ---- 16-bit (half) results of a single-precision unit: ps overflow / F16 repack ----
  const rr16_hi9:U9 = if ps_rndovf_f6a_h != 0 { (sf_res << 8) | exp_res_f6a_h#[0..<8] } else { 0 }
  const rr16_lo:U16 = if (ps_rndovf_f6a_h | rrmux16l_sel_f6a_l) == 0 {
    (s_res_f6a_h << 15) | (exp_res_f6a_h#[7] << 14) | (exp_res_f6a_h#[0..<4] << 10) | rndres32#[21..<31]
  } else {
    0
  }
  const rr16_hi:U16 = rr16_hi9 << 7

  // ---- full 32-bit result select ----
  const rr32:U32 = if rrmux32_sel_f6a_h == 0 { (sf_res << 31) | (exp_res_f6a_h#[0..<8] << 23) | rndres32#[8..<31] }
    elif rrmux32_sel_f6a_h == 1 { (intres32 << 8) | rndres32#[0..<8] }
    elif rrmux32_sel_f6a_h == 2 { class_logfma2_nr1_frcp }
    else { ((trans_sinp2m_f6a_h & rndres32#[31]) << 23) | rndres32#[8..<31] }

  // ---- F10/F11 convert results ----
  const f10f11mr:U6 = if s_res_f6a_h == 0 { rndadd32_ina#[25..<31] } else { 0 }
  const f10f11exp:U5 = if s_res_f6a_h == 0 { (exp_res_f6a_h#[7] << 4) | exp_res_f6a_h#[0..<4] } else { 0 }
  const f10f11_sel:U2 = (f10f11mux_sel_f6a_h, ph_rndovf_f6a_h)#[..]
  const f10f11r:U16 = if f10f11_sel == 0 { (f10f11exp << 5) | f10f11mr#[1..<6] }
    elif f10f11_sel == 1 { (f10f11exp << 6) | f10f11mr }
    elif f10f11_sel == 2 { (s_res_f6a_h << 15) | (exp_res_f6a_h#[7] << 14) | (exp_res_f6a_h#[0..<4] << 10) }
    else { 0 }

  // ---- graphics saturation results (max/min of the narrow integer formats) ----
  const gmax_u16_u24:U1 = sel_gmaxu16_f6a_h | sel_gmaxu24_f6a_h
  const gfx_max_b0:U1 = 1
  const gfx_max_b1:U1 = 1
  const gfx_max_b2:U1 = ~sel_gmaxu2_f6a_h
  const gfx_max_3_6:U4 = if sel_gmaxu2_f6a_h == 0 { 0xf } else { 0 }
  const gfx_max_b7:U1 = ~(sel_gmaxu2_f6a_h | sel_gmaxs8_f6a_h)
  const gfx_max_8_9:U2 = if (sel_gmaxu8_f6a_h | sel_gmaxu2_f6a_h | sel_gmaxs8_f6a_h) == 0 { 3 } else { 0 }
  const gfx_max_10_14:U5 = if (gmax_u16_u24 | sel_gmaxs16_f6a_h) != 0 { 0x1f } else { 0 }
  const gfx_max_16_23:U8 = if sel_gmaxu24_f6a_h != 0 { 0xff } else { 0 }
  const gfx_max_lo:U16 = (gfx_max_b0, gfx_max_b1, gfx_max_b2, gfx_max_3_6, gfx_max_b7, gfx_max_8_9, gfx_max_10_14, gmax_u16_u24)#[..]
  const gfx_min_lo:U16 = (sel_gmins16_f6a_h << 15) | (sel_gmins8_f6a_h << 7) | (sel_gmins8_f6a_h | sel_gmins16_f6a_h)
  const gfx_maxmin_lo:U16 = if sel_gfxmax_f6a_h == 0 { gfx_min_lo } else { gfx_max_lo }
  const gfx_maxmin_hi:U8 = if sel_gfxmax_f6a_h != 0 { gfx_max_16_23 } else { 0 }

  // ---- single-precision exception results: {sign, qnan/inf/large/zero/one patterns} ----
  const f10f11_large:U1 = sel_f11large_f6a_h | sel_f10large_f6a_h
  const ps_exc_b31:U1 = (s_res_f6a_h & sel_psexc_sr_f6a_h) | sel_bit31_one_f6a_h
  const ps_exc_b30:U1 = ~(sel_zerores_f6a_h | sel_ps_unf_f6a_h | sel_ps_normone_f6a_h)
  const ps_exc_24_29:U6 = if (sel_zerores_f6a_h | sel_ps_unf_f6a_h) == 0 { 0x3f } else { 0 }
  const ps_exc_b23:U1 = sel_b30to0_ones_f6a_h | sel_ps_cqn_f6a_h | sel_ps_inf_f6a_h
  const ps_exc_b22:U1 = sel_b30to0_ones_f6a_h | sel_ps_large_f6a_h | sel_ps_cqn_f6a_h
  const ps_exc_1_21:U21 = if (sel_b30to0_ones_f6a_h | sel_ps_large_f6a_h) != 0 { 0x1fffff } else { 0 }
  const ps_exc_b0:U1 = sel_b30to0_ones_f6a_h | sel_ps_large_f6a_h | sel_set_bit0_one_f6a_h
  const ps_exc_res:U32 = (ps_exc_b0, ps_exc_1_21, ps_exc_b22, ps_exc_b23, ps_exc_24_29, ps_exc_b30, ps_exc_b31)#[..]

  // ---- half-precision exception results ----
  const ph_exc_b15:U1 = s_res_f6a_h & sel_phhi_sr_f6a_h
  const ph_exc_11_14:U4 = if (sel_f11sp_f6a_h | sel_f10sp_f6a_h | sel_phhi_unf_f6a_h) == 0 { 0xf } else { 0 }
  const ph_exc_b10:U1 = ~(sel_phhi_large_f6a_h | sel_f10sp_f6a_h | sel_phhi_unf_f6a_h)
  const ph_exc_b9:U1 = ~(sel_phhi_infres_f6a_h | sel_phhi_unf_f6a_h)
  const ph_exc_7_8:U2 = if sel_phsp_f6a_h == 0 { 3 } else { 0 }
  const ph_exc_b6:U1 = ~(sel_phsp_f6a_h | sel_f11large_f6a_h)
  const ph_exc_b5:U1 = ~(sel_phsp_f6a_h | sel_f10large_f6a_h | sel_f11inf_f6a_h)
  const ph_exc_b4:U1 = sel_phhi_large_f6a_h | f10f11_large | sel_f10cqnan_f6a_h
  const ph_exc_0_3:U4 = if (sel_phhi_large_f6a_h | f10f11_large) != 0 { 0xf } else { 0 }
  const ph_exc_res:U16 = (ph_exc_0_3, ph_exc_b4, ph_exc_b5, ph_exc_b6, ph_exc_7_8, ph_exc_b9, ph_exc_b10, ph_exc_11_14, ph_exc_b15)#[..]

  // ---- exception result: high / low half selects ----
  const exc_hi:U16 = if sel_excreshi_f6a_h == 1 { ps_exc_res#[16..<32] } elif sel_excreshi_f6a_h == 2 { gfx_maxmin_hi } else { 0 }
  const exc_lo:U16 = if sel_excreslo_f6a_h == 0 { f10f11r }
    elif sel_excreslo_f6a_h == 1 { ps_exc_res#[0..<16] }
    elif sel_excreslo_f6a_h == 2 { gfx_maxmin_lo }
    else { ph_exc_res }

  // ---- final result: exception / 16-bit repack / full 32-bit, per half ----
  const res_hi:U16 = if sel_fmares_hi_f6a_h == 0 { exc_hi } elif sel_fmares_hi_f6a_h == 1 { rr16_hi } else { rr32#[16..<32] }
  const res_lo:U16 = if sel_fmares_lo_f6a_h == 0 { exc_lo } elif sel_fmares_lo_f6a_h == 1 { rr16_lo } else { rr32#[0..<16] }
  fma_res_f6a_h = (res_lo, res_hi)#[..]
  int_res_l_bit_f6a_h = rndres_hi#[0]
}
