// Exponent stage 2: operand-order decision (via txfma_ediff_opdorder_logic), the
// addend-vs-product exponent differences and their absolute values, the sticky
// exponents (distance constant - |ediff| + trailing zeros) and the result exponent.
const txfma_csa = import("txfma_csa.txfma_csa")
const txfma_adder = import("txfma_adder.txfma_adder")
const txfma_ediff_opdorder_logic = import("txfma_ediff_opdorder_logic.txfma_ediff_opdorder_logic")
const vpu_defs_pkg = import("vpu_defs_pkg")

// |v| of a 10-bit two's-complement exponent difference.
comb abs_ps(v:U10) -> (r:U10) {
  r = if v#[vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ - 1] == 1 { (0 - v)#[0..<10] } else { v }
}

// a + b + c through a carry-save stage and a carry-in-1 adder (a + b + c + 1 mod 2^10).
comb sticky_sum(a:U10, b:U10, c:U10) -> (r:U10) {
  const csa = txfma_csa<Bits=10>(a_i=a, b_i=b, cin_i=c)
  r = txfma_adder<Width=10>(a_i=csa.sum_o, b_i=csa.cout_o#[0..<9] << 1, cin_i=1)
}

pub mod txfma_e2::[timecheck=false](cmd_f2a_h:vpu_defs_pkg.VPU_FCMD_SZ_T, eb_hi_f2a_h:vpu_defs_pkg.TXFMA_EXP_PS_SZ_T, ec_f2a_h:vpu_defs_pkg.TXFMA_EXP_PS_SZ_T, ec_zero_f2a_h:U1, ediff_ec_eph_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T, ediff_ec_epl_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T, ediff_eph_epl_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T, eprod_hi_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T, eprod_hi_zero_f2a_h:U1, eprod_lo_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T, eprod_lo_zero_f2a_h:U1, etrz_fa_lo_ps_f2a_h:U5, etrz_fc_f2a_h:U5, etrz_prod_hi_ph_f2a_h:vpu_defs_pkg.TXFMA_ETRZ_PROD_PH_SZ_T, etrz_prod_lo_ps_f2a_h:vpu_defs_pkg.TXFMA_ETRZ_PROD_PS_SZ_T, exp_fma2_exc_f2a_h:U1, op_dtype_f2a_h:vpu_defs_pkg.VPU_DTYPE_SZ_T, sigs_f2a_h:(e18:U1, e17:U1, e16:U1, e15:U1, e14:U1, e13:U1, e12:U1, e11:U1, e10:U1, e9:U1, e8:U1, e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), sin_ediff2_f2a_h:U1) -> (align1_mux_sel_f2a_h:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T@[], align2_mux_sel_f2a_h:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T@[], align2_rshamt_c3_f2a_h:U5@[], e_sticky1_f2a_h:U1@[], e_sticky2_f2a_h:U1@[], ediff1_abs_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T@[], ediff1_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T@[], ediff1_sel_f2a_h:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T@[], ediff1_zap_f2a_h:U1@[], ediff2_abs_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T@[], ediff2_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T@[], ediff2_sel_f2a_h:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T@[], ediff_abs_diff_hi_f2a_h:U6@[], exp_res_2f3_f2a_h:U7@[], exp_res_f2a_h:vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ_T@[], opd3_mux_sel_f2a_h:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T@[]) {
  comptime const SIGN_BIT = vpu_defs_pkg.TXFMA_EXP_SEXT_PS_SZ - 1
  const frac_op = cmd_f2a_h == vpu_defs_pkg.VPU_TRANS_EXP_FRAC
  const is_f16_f32 = op_dtype_f2a_h == vpu_defs_pkg.VPU_DTYPE_F16_F32

  // The result exponent (low 7 bits) feeds back into the operand-order logic, which in turn
  // selects the result exponent: close the loop with a wire.
  wire exp_res_2f3_f2a_h:U7 = nil

  // Which operand goes to each alignment shifter, and the exponent-difference/result muxes.
  const order = txfma_ediff_opdorder_logic::[name=ediff_opdorder_logic](cmd=cmd_f2a_h, op_dtype=op_dtype_f2a_h, sigs=sigs_f2a_h, sign_c_ph=U1((ediff_ec_eph_f2a_h#[SIGN_BIT] == 1 and eprod_hi_zero_f2a_h == 0) or ec_zero_f2a_h == 1), sign_c_pl=U1((ediff_ec_epl_f2a_h#[SIGN_BIT] == 1 and eprod_lo_zero_f2a_h == 0) or (ec_zero_f2a_h == 1 and is_f16_f32)), sign_ph_pl=U1((ediff_eph_epl_f2a_h#[SIGN_BIT] == 1 and eprod_lo_zero_f2a_h == 0) or eprod_hi_zero_f2a_h == 1), exp_fma2_exc=exp_fma2_exc_f2a_h, exp_res_2f3_f2a_h=exp_res_2f3_f2a_h)

  // ---- Exponent differences (addend vs product halves) ----
  const ediff1_mux:U10 = unique if order.ediff1_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH or order.ediff1_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPH {
    ediff_ec_eph_f2a_h
  } elif order.ediff1_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL or order.ediff1_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPL {
    ediff_ec_epl_f2a_h
  } elif order.ediff1_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_LOG_MUL {
    7
  } else {
    0
  }
  const ediff2_mux:U10 = unique if order.ediff2_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_ECH_EPH or order.ediff2_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_N_ECH_EPH {
    ediff_ec_eph_f2a_h
  } elif order.ediff2_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL or order.ediff2_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPL {
    ediff_ec_epl_f2a_h
  } elif order.ediff2_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL or order.ediff2_sel == vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EPH_EPL {
    ediff_eph_epl_f2a_h
  } else {
    0
  }

  // FROUND zeroes a non-negative difference (the whole value is shifted out).
  const ediff1_zap = cmd_f2a_h == vpu_defs_pkg.VPU_FCMD_FROUND and ediff1_mux#[SIGN_BIT] == 0
  const ediff1:U10 = if ediff1_zap { 0 } else { ediff1_mux }
  const ediff1_abs_int:U10 = abs_ps(v=ediff1)
  const ediff2_abs_int:U10 = abs_ps(v=ediff2_mux)

  // ---- Sticky exponents: distance constant (by dtype/command) - |ediff| + trailing zeros ----
  // The first operand's distance depends on dtype; some commands override it.
  const e_1_tk:U10 = if cmd_f2a_h == vpu_defs_pkg.VPU_FCMD_FROUND {
    vpu_defs_pkg.TXFMA_INT_STICKY_DISTANCE
  } elif cmd_f2a_h == vpu_defs_pkg.VPU_FCMD_CVT_F10F32 {
    vpu_defs_pkg.TXFMA_F10_F32_MAN_DIFF#[0..<10]
  } elif cmd_f2a_h == vpu_defs_pkg.VPU_FCMD_CVT_F11F32 {
    vpu_defs_pkg.TXFMA_F11_F32_MAN_DIFF#[0..<10]
  } elif cmd_f2a_h == vpu_defs_pkg.VPU_FCMD_CVT_F16F32 {
    vpu_defs_pkg.TXFMA_F16_F32_MAN_DIFF#[0..<10]
  } elif op_dtype_f2a_h == vpu_defs_pkg.VPU_DTYPE_INT {
    vpu_defs_pkg.TXFMA_F32_A_C_STICKY_DISTANCE
  } elif op_dtype_f2a_h == vpu_defs_pkg.VPU_DTYPE_F32 {
    if order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_P and sigs_f2a_h.e15 == 0 { vpu_defs_pkg.TXFMA_F32_PROD_STICKY_DISTANCE } else { vpu_defs_pkg.TXFMA_F32_A_C_STICKY_DISTANCE }
  } elif is_f16_f32 {
    if order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_C { vpu_defs_pkg.TXFMA_F16_F32_C_STICKY_DISTANCE } else { vpu_defs_pkg.TXFMA_F16_F32_PROD_STICKY_DISTANCE }
  } else {
    0
  }
  const e_2_tk:U10 = if frac_op { vpu_defs_pkg.TXFMA_TRANS_EXP_STICKY_DISTANCE }
    else { vpu_defs_pkg.TXFMA_F16_F32_PROD_STICKY_DISTANCE }

  // Trailing-zero count of the operand each shifter takes.
  const etrz_1:U10 = unique if order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_PH {
    etrz_prod_hi_ph_f2a_h
  } elif order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_P or order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_PL {
    etrz_prod_lo_ps_f2a_h
  } elif order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_C {
    etrz_fc_f2a_h
  } elif order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_A {
    etrz_fa_lo_ps_f2a_h
  } else {
    0
  }
  // As in the reference, an A selection on shifter 2 reads the high-product trailing zeros (not fa).
  const etrz_2:U10 = unique if order.align2_mux_sel == vpu_defs_pkg.TXFMA_SEL_PH or order.align2_mux_sel == vpu_defs_pkg.TXFMA_SEL_A {
    etrz_prod_hi_ph_f2a_h
  } elif order.align2_mux_sel == vpu_defs_pkg.TXFMA_SEL_P or order.align2_mux_sel == vpu_defs_pkg.TXFMA_SEL_PL {
    etrz_prod_lo_ps_f2a_h
  } elif order.align2_mux_sel == vpu_defs_pkg.TXFMA_SEL_C {
    etrz_fc_f2a_h
  } else {
    0
  }

  const sticky1 = sticky_sum(a=e_1_tk, b=~ediff1_abs_int, c=etrz_1)
  const sticky2 = sticky_sum(a=e_2_tk, b=if frac_op { ~U10(ec_f2a_h) } else { ~ediff2_abs_int }, c=if frac_op { 0 } else { etrz_2 })

  // ---- Result exponent ----
  const exp_res:U10 = unique if order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_PH or order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_P or order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_A {
    eprod_hi_f2a_h
  } elif order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_PL {
    eprod_lo_f2a_h
  } elif order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_C {
    ec_f2a_h
  } elif order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_B {
    eb_hi_f2a_h
  } elif order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_CVT_F32INT {
    vpu_defs_pkg.FLOAT32_E_BIAS_HEX + vpu_defs_pkg.TXFMA_CVT_F32INT_OFFSET
  } elif order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_CVT_F32_FXP1615 {
    vpu_defs_pkg.FLOAT32_E_BIAS_HEX + vpu_defs_pkg.TXFMA_CVT_F32_FXP1615_OFFSET
  } elif order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_GCVT_F32_NORM {
    (vpu_defs_pkg.FLOAT32_E_BIAS_HEX - vpu_defs_pkg.TXFMA_GCVT_F32_NORM_OFFSET)#[0..<10]
  } elif order.res_exp_hi_sel == vpu_defs_pkg.TXFMA_SEL_EXP_FRAC {
    vpu_defs_pkg.FLOAT32_E_BIAS_HEX + vpu_defs_pkg.TXFMA_EXP_FRAC_OFFSET
  } else {
    0
  }
  exp_res_2f3_f2a_h = exp_res#[0..<7]
  exp_res_f2a_h = exp_res

  // ---- Sticky-clear: the sticky bit is only meaningful when the shifted-out operand is non-zero ----
  const sticky1_clear = if op_dtype_f2a_h == vpu_defs_pkg.VPU_DTYPE_F32 {
    eprod_hi_zero_f2a_h == 1 or (ec_zero_f2a_h == 1 and sigs_f2a_h.e15 == 0 and sigs_f2a_h.e13 == 0) or ediff1_zap
  } elif is_f16_f32 {
    (eprod_hi_zero_f2a_h == 1 and order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_PH) or (ec_zero_f2a_h == 1 and order.align1_mux_sel == vpu_defs_pkg.TXFMA_SEL_C)
  } else {
    true
  }
  const sticky2_clear = if is_f16_f32 {
    (eprod_lo_zero_f2a_h == 1 and order.align2_mux_sel == vpu_defs_pkg.TXFMA_SEL_PL) or (eprod_hi_zero_f2a_h == 1 and order.align2_mux_sel == vpu_defs_pkg.TXFMA_SEL_PH)
  } else {
    true
  }

  // EXP_FRAC reuses the second sticky sum as the first shift amount.
  const exp_frac_shift:U10 = if order.res_exp_lo_sel == vpu_defs_pkg.TXFMA_SEL_EXP_FRAC { sticky2 } else { 0 }
  const ediff1_abs:U10 = if frac_op { exp_frac_shift } else { ediff1_abs_int }
  const ediff2_abs:U10 = if cmd_f2a_h == vpu_defs_pkg.VPU_TRANS_SIN_TRANSFORM { sin_ediff2_f2a_h } else { ediff2_abs_int }

  e_sticky1_f2a_h = U1(sticky1#[SIGN_BIT] == 1 and not sticky1_clear)
  e_sticky2_f2a_h = U1(sticky2#[SIGN_BIT] == 1 and not sticky2_clear)
  ediff1_zap_f2a_h = U1(ediff1_zap)
  ediff_abs_diff_hi_f2a_h = ediff1_abs#[0..<6]
  align2_rshamt_c3_f2a_h = ediff2_abs#[0..<5]
  align1_mux_sel_f2a_h = order.align1_mux_sel
  align2_mux_sel_f2a_h = order.align2_mux_sel
  opd3_mux_sel_f2a_h = order.opd3_mux_sel
  ediff1_f2a_h = ediff1
  ediff2_f2a_h = ediff2_mux
  ediff1_sel_f2a_h = order.ediff1_sel
  ediff2_sel_f2a_h = order.ediff2_sel
  ediff1_abs_f2a_h = ediff1_abs
  ediff2_abs_f2a_h = ediff2_abs
}
