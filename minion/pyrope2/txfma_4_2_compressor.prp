// 4:2 compressor (verilog: txfma_4_2_compressor): two chained 3:2 carry-save adders.
// x0, x1, x2 compress to a carry (cout_o, weight of the next column) and a partial sum;
// that sum, x3 and the previous column's carry cin_i compress to the carry c_o and sum s_o.
const txfma_csa = import("txfma_csa.txfma_csa")

pub comb txfma_4_2_compressor(cin_i:U1, x0_i:U1, x1_i:U1, x2_i:U1, x3_i:U1) -> (c_o:U1, cout_o:U1, s_o:U1) {
  const csa0 = txfma_csa<Bits=1>(a_i=x0_i, b_i=x1_i, cin_i=x2_i)
  const csa1 = txfma_csa<Bits=1>(a_i=csa0.sum_o, b_i=x3_i, cin_i=cin_i)
  cout_o = csa0.cout_o
  c_o = csa1.cout_o
  s_o = csa1.sum_o
}
