// Lookup ROM of the log function for the transcendental unit (trans_top), coefficient set c0: one packed entry per index_i[5:0].
// Each 58-bit entry packs {exc:1, mask:7, taylor:1, c2:17, c0:32} from the MSB down.
comptime const TABLE:[64]U58 = [0x40000038aa3ac, 0x400000373cb3c, 0x40000035d69ba, 0x4000003477b1a, 0x400000331fb74, 0x40000031ce746, 0x4000003083b10, 0x4000002f3f352, 0x4000002e00d18, 0x4000002cc853c, 0x4000002b958d8, 0x4000002a68534, 0x400000294078e, 0x400000281dd78, 0x400000270046c, 0x40000025e79fe, 0x40000024d3c1c, 0x40000023c488c, 0x40000022b9d3c, 0x40000021b382e, 0x40000020b176e, 0x4000001fb392c, 0x4000001eb9ba0, 0x4000001dc3d16, 0x4000001cd1bf8, 0x4000001be3698, 0x4000001af8b7e, 0x4000001a1192c, 0x400000192de46, 0x400000184d966, 0x400000177092a, 0x4000001696c42, 0x400000547fcb8, 0x4000005373d84, 0x400000526b780, 0x400000516695c, 0x40000050651f2, 0x4000004f66ffe, 0x4000004e6c240, 0x4000004d747b6, 0x4000004c7ff4a, 0x4000004b8e7cc, 0x4000004aa0034, 0x40000049b47a4, 0x40000048cbd12, 0x40000047e5f82, 0x4000004702e0e, 0x40000046227e2, 0x4000004544c0a, 0x40000044699b8, 0x400000439101e, 0x40000042bae6c, 0x40000041e73d0, 0x4000004115fa8, 0x400000404712c, 0x4000003f7a796, 0x4000003eb0246, 0x4000003de8098, 0x4000003d221c0, 0x4000003c5e544, 0x4000003b9ca60, 0x4000003add098, 0x4000003a1f746, 0x4000003963dd0]

pub comb trans_log_rom_case_c0(index_i:U8) -> (data_o:(exc:U1, mask:U7, taylor:U1, c2:U17, c0:U32)) {
  const entry:U58 = TABLE[index_i#[0..<6]]
  data_o.exc = entry#[57]
  data_o.mask = entry#[50..<57]
  data_o.taylor = entry#[49]
  data_o.c2 = entry#[32..<49]
  data_o.c0 = entry#[0..<32]
}
