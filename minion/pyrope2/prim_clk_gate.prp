// Latch-based integrated clock gate (verilog: prim_clk_gate): clk_o runs while the
// enable, captured while clk_i is low, is set; scan mode forces the clock on. The
// remaining dft_t fields (scan_reset_n, sram_clk_override, ram_rei, ram_wei) are
// unused by this gate and are not part of the interface.
pub mod prim_clk_gate::[timecheck=false](clk_i:Clock, dft_i:(scanmode:U1), en_i:U1) -> (clk_o:Clock@[]) {
  clk_o = Clock(clock_pin=clk_i, enable=(en_i | dft_i.scanmode) != 0)
}
