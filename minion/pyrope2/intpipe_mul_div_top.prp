const prim_mul_div = import("prim_mul_div.prim_mul_div")
const minion_pkg = import("minion_pkg")

// Integer multiplier/divider contract wrapper: the intpipe-facing interface of the
// technology-selected prim_mul_div, which does all the work.
pub mod intpipe_mul_div_top::[timecheck=false](chicken_bit_mul_div:U1, clk_i:Clock, dft_i:(scanmode:U1, scan_reset_n:U1, sram_clk_override:U1, ram_rei:U1, ram_wei:U1), kill:U1, req_dest:(fp:U1, addr:U5, thread_id:U1), req_dw:U1, req_fn:U5, req_fn_early:U5, req_in1:minion_pkg.XregSize_T, req_in2:minion_pkg.XregSize_T, req_valid:U1, req_valid_early:U1, resp_ready:U1, rst_ni:U1) -> (req_ready:U1@[], resp_data:minion_pkg.XregSize_T@[], resp_dest:(fp:U1, addr:U5, thread_id:U1)@[], resp_valid:U1@[], resp_valid_early:U1@[]) {
  const u_prim_mul_div = prim_mul_div::[name=u_prim_mul_div](clk_i, rst_ni, dft_i, req_valid, req_valid_early, req_fn, req_fn_early, req_dw, req_in1, req_in2, req_dest, kill, chicken_bit_mul_div, resp_ready)
  req_ready = u_prim_mul_div.req_ready
  resp_valid = u_prim_mul_div.resp_valid
  resp_valid_early = u_prim_mul_div.resp_valid_early
  resp_data = u_prim_mul_div.resp_data
  resp_dest = u_prim_mul_div.resp_dest
}
