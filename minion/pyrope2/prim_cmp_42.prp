// 4:2 carry-save compressor (verilog: prim_cmp_42): two chained 3:2 stages.
// cout is the intermediate carry, shifted up one bit with cin entering at bit 0;
// cv is the final carry vector.
pub comb prim_cmp_42<Width=1>(a:Unsigned(bits=Width), b:Unsigned(bits=Width), c:Unsigned(bits=Width), cin:U1, d:Unsigned(bits=Width)) -> (cv:Unsigned(bits=Width), sv:Unsigned(bits=Width)) {
  const ab = a ^ b
  const cout = (ab & c) | (~ab & a)
  const cout_in = ((cout << 1) | cin)#[0..<Width]
  const t = ab ^ c ^ d
  sv = t ^ cout_in
  cv = (t & cout_in) | (~t & d)
}
