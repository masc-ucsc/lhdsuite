  const gsc_fs_sext:U64 = ex_vpu_ctrl.gsc_fs#sext[0..=31]#[0..<64]
  const id_op1:U64 = if ex_gsc_busy or to_ex_sel_alu1 == minion_pkg.A1Fs1 { gsc_fs_sext }
    elif to_ex_sel_alu1 == minion_pkg.A1Rs1 { id_reg_data#[0..<64] }
    elif to_ex_sel_alu1 == minion_pkg.A1Pc { id_pc#sext[0..=48]#[0..<64] }
    else { 0 }
  const id_op2:U64 = if to_ex_sel_alu2 == minion_pkg.A2Rs2 { id_reg_data#[64..<128] }
    elif to_ex_sel_alu2 == minion_pkg.A2Imm { imm_src2 }
    elif to_ex_sel_alu2 == minion_pkg.A2Size { if id_rvc { 2 } else { 4 } }
    else { 0 }
  if id_uses_alu or ex_gsc_busy {
    ex_op1 = id_op1
  }
  if id_uses_alu {
    ex_op2 = id_op2
  }

  // ---- Request to the dcache (EX, or the GSC stage for gather/scatter elements) ----
  // The address must be canonical: bits 63..47 all equal.
  const addr_hi = alu.adder_out#[47..<64]
  ex_dcache_req_en = (ex_reg_valid and ex_c.mem and not ex_c.gsc) or gsc_reg_valid
  ex_dcache_req_valid = U1(ex_dcache_req_en)
  ex_dcache_req = (addr=alu.adder_out#[0..<48], addr_msb_err=U1(not (addr_hi == 0 or addr_hi == 0x1ffff)), cmd=ex_c.mem_cmd, dest=(addr=ex_waddr, fp=U1(ex_c.fp), thread_id=ex_thread_id), gsc32_idx=ex_reg_data#[0..<GSC32_IDX_BITS], gsc_cnt=gsc_reg_gsc_cnt, mem_global=U1(ex_c.mem_g), phys=0, ps_mask=if gsc_reg_valid {
      gsc_reg_ps_mask
    } else {
      ex_vpu_ctrl.ps_mask
    }, typ=ex_c.mem_type)
  ex_dcache_gsc = U1(ex_valid_qual_to_gsc)

  // ================================ TAG stage ================================
  tag_reg_valid = ex_valid_qual or gsc_valid_qual
  tag_reg_xcpt_interrupt = id_fe_req_valid#[ex_thread_id] == 0 and ex_reg_xcpt_interrupt
  tag_reg_xcpt = ex_xcpt and ex_valid_qual
  tag_reg_replay = ex_replay and not id_take_pc
  tag_reg_gscing = gsc_reg_gscing
  tag_ctrl_fp_toint = ex_c.wxd and ex_c.fp
  tag_csr_vpu = ex_valid_qual and ex_csr_vpu
  tag_csr_excl_mode = ex_csr_excl_mode
  if ex_xcpt {
    tag_reg_cause = ex_xcpt_cause
  }
  if ex_pc_valid or gsc_pc_valid {
    tag_ctrl = ex_ctrl
    tag_reg_rvc = ex_reg_rvc
    tag_reg_flush_pipe = if gsc_pc_valid { gsc_reg_flush_pipe } else { ex_reg_flush_pipe }
    tag_reg_pc = ex_reg_pc
    tag_thread_id = ex_thread_id
    tag_csr_flush = ex_csr_flush
  }
  if (ex_pc_valid or gsc_pc_valid) and ex_uses_alu {
    tag_reg_wdata = alu.out
  }
  // Store data / atomic operand for integer memory operations.
  if ex_c.rxs2 and ex_c.mem and ex_c.mem_cmd != minion_pkg.DcCmdXrd and not ex_c.fp {
    tag_reg_rs2 = ex_reg_data#[64..<128]
  }
  const tag_reg_inst_ff = intpipe_inst_bits_stage<BrMask=0xffffff80>(enable_i=U1(ex_pc_valid or gsc_pc_valid), is_csr_i=U1(ex_csr_en), is_br_jal_i=U1(ex_c.br or ex_c.jal), te_enable_i=te_enable, xcpt_i=U1(ex_xcpt), in_i=ex_reg_inst)
  const tag_reg_inst = tag_reg_inst_ff.out_o
  tag_waddr = tag_reg_inst#[7..=11]

  // ---- Branch resolution: the branch outcome is the ALU result bit 0 ----
  const tag_br_taken = tag_reg_wdata#[0] == 1
  mut tbranch_up_v:U2 = 0
  tbranch_up_v#[tag_thread_id] = U1(tag_br_taken and tag_c.br)
  tbranch_up = tbranch_up_v
  const tag_sign:U1 = tag_reg_inst#[31]
  const tag_sign_jal:U29 = if tag_sign == 1 { 0x1fffffff } else { 0 }
  const tag_sign_br:U37 = if tag_sign == 1 { 0x1fffffffff } else { 0 }
  const tag_jal_imm:U49 = (tag_sign_jal << 20) | (tag_reg_inst#[12..=19] << 12) | (tag_reg_inst#[20] << 11) | (tag_reg_inst#[21..=30] << 1)
  const tag_br_imm:U49 = (tag_sign_br << 12) | (tag_reg_inst#[7] << 11) | (tag_reg_inst#[25..=30] << 5) | (tag_reg_inst#[8..=11] << 1)
  // Next sequential PC or the taken-branch / JAL target.
  const tag_pc_step:U49 = if tag_c.br and tag_br_taken { tag_br_imm } elif tag_c.jal { tag_jal_imm } elif tag_reg_rvc { 2 } else { 4 }
  const tag_br_target:U49 = (tag_reg_pc + tag_pc_step)#[0..<49]
  // JALR targets come from the ALU result, with bit 48 made the complement of bit 47 unless canonical.
  const jalr_hi = tag_reg_wdata#[47..<64]
  const jalr_bit48:U1 = if jalr_hi == 0x1ffff or jalr_hi == 0 { tag_reg_wdata#[47] } else { U1(tag_reg_wdata#[47] == 0) }
  const jalr_target:U49 = (tag_reg_wdata#[0..<48], jalr_bit48)#[..]
  mut tag_npc_v:U49 = if tag_c.jalr { jalr_target } else { tag_br_target }
  tag_npc_v#[0] = 0
  tag_npc = tag_npc_v
  // A taken branch or a jump that does not trail an exception redirects fetch (compressed ISA is always on, so no misaligned-fetch exception).
  const tag_misprediction = ((tag_c.br and tag_br_taken) or tag_c.jal or tag_c.jalr) and not (tag_reg_xcpt or tag_reg_xcpt_interrupt)
  tag_take_pc = tag_reg_valid and (tag_misprediction or tag_reg_flush_pipe)
  // A JALR writes the return address (the sequential PC) to rd, not its own target.
  const tag_int_wdata:U64 = if not tag_reg_xcpt and tag_c.jalr { tag_br_target#sext[0..=48]#[0..<64] } else { tag_reg_wdata }

  // ---- Data breakpoint and TAG exceptions ----
  const dcache_bp = debug_breakpoint<TriggerType=1>(control_ip=csr_file.bp_control, in_debug_ip=csr_file.io_debug, prv_ip=csr_file.io_prv, tdata2_ip=csr_file.bp_address, address_ip=tag_dcache_bp.address, cmd_ip=tag_dcache_bp.cmd, valid_ip=tag_dcache_bp_valid, thread_id_ip=tag_dcache_bp.thread_id)
  tag_dcache_bp_triggered = dcache_bp.update_op == 1
  const tag_breakpoint = dcache_bp.xcpt_op == 1
  const tag_debug_breakpoint = dcache_bp.enter_debug_op == 1
  // Access faults precede page faults on purpose: a misaligned AMO may raise both and must report the access fault.
  mut tag_new_xcpt = true
  mut tag_new_cause:U5 = minion_pkg.XcptMisalignedFetch
  if tag_debug_breakpoint {
    tag_new_cause = minion_pkg.XcptDebug
  } elif tag_breakpoint {
    tag_new_cause = minion_pkg.XcptBreakpoint
  } elif tag_c.mem and tag_dcache_xcpt.mf_ld == 1 {
    tag_new_cause = minion_pkg.XcptMisalignedLoad
  } elif tag_c.mem and tag_dcache_xcpt.mf_st == 1 {
    tag_new_cause = minion_pkg.XcptMisalignedStore
  } elif tag_c.mem and tag_dcache_xcpt.af_ld == 1 {
    tag_new_cause = minion_pkg.XcptLoadAccess
  } elif tag_c.mem and tag_dcache_xcpt.af_st == 1 {
    tag_new_cause = minion_pkg.XcptStoreAccess
  } elif tag_c.mem and tag_dcache_xcpt.ps_ld == 1 {
    tag_new_cause = 16
  } elif tag_c.mem and tag_dcache_xcpt.ps_st == 1 {
    tag_new_cause = 17
  } elif tag_c.mem and tag_dcache_xcpt.pf_ld == 1 {
    tag_new_cause = minion_pkg.XcptLoadPageFault
  } elif tag_c.mem and tag_dcache_xcpt.pf_st == 1 {
    tag_new_cause = minion_pkg.XcptStorePageFault
  } else {
    tag_new_xcpt = false
  }
  const tag_xcpt = tag_reg_xcpt_interrupt or tag_reg_xcpt or (tag_reg_valid and tag_new_xcpt)
  const tag_xcpt_cause:U5 = if tag_reg_xcpt_interrupt or tag_reg_xcpt { tag_reg_cause } else { tag_new_cause }

  // A fetch breakpoint (id) and a data breakpoint (tag) both update the debug timing; the dcache one wins.
  mut debug_timing_next:U2 = debug_timing
  if fetch_bp.update_op == 1 {
    debug_timing_next#[id_thread_id] = fetch_bp.timing_op
  }
  if tag_dcache_bp_triggered {
    debug_timing_next#[tag_thread_id] = dcache_bp.timing_op
  }
  debug_timing = debug_timing_next

  // ---- TAG kills ----
  const tag_killed_by_dcache = tag_reg_valid and tag_c.wxd and tag_dcache_replay_next == 1
  tag_replay = tag_reg_replay or tag_killed_by_dcache or (csr_excl_mode_transition and tag_reg_valid)
  const tag_wb_redirects = (wb_take_pc and wb_thread_id == tag_thread_id) or csr_file.io_resume#[tag_thread_id] == 1
  const tag_kill_common = tag_killed_by_dcache or tag_wb_redirects or tag_reg_xcpt or (mem_dcache_flush_pipeline == 1 and mem_thread_id == tag_thread_id) or csr_excl_mode_transition
  tag_ctrl_kill = tag_kill_common or tag_xcpt
  const tag_valid_qual = tag_reg_valid and not tag_ctrl_kill
  const tag_pc_valid = tag_reg_valid or tag_replay or tag_reg_xcpt_interrupt
  const tag_thread_disabled = (tag_thread_id != 0 and thread1_enable == 0) or (tag_thread_id == 0 and thread0_enable == 0)
  // A data breakpoint exception reports the breakpoint address as the trap value.
  mut tag_final_wdata:U64 = tag_int_wdata
  tag_final_wdata#[0..<49] = if tag_breakpoint { tag_dcache_bp.address } else { tag_int_wdata#[0..<49] }
  // The result is needed for integer-writing ALU ops (incl. jal and CSRs), CSR accesses, exceptions (fetch faults) and data breakpoints.
  const tag_uses_wdata = (tag_c.wxd and tag_c.alu_fn#[4] == 0) or tag_csr_en or tag_reg_xcpt or tag_breakpoint
  tag_vpu_kill = U1(not tag_reg_valid or tag_kill_common or tag_thread_disabled)
  tag_dcache_kill = U1(not tag_reg_valid or tag_kill_common or tag_dcache_bp_triggered or tag_thread_disabled)

  // ---- Store data to the dcache: VPU data by default, integer rs2 in the low 64 bits ----
  // Scatter data from the VPU is delayed one cycle to line up with the GSC stage.
  const ex_cmd_is_write = ex_c.mem_cmd in (minion_pkg.DcCmdXwr, minion_pkg.DcCmdXsc, minion_pkg.DcCmdXaSwap, minion_pkg.DcCmdXaAdd, minion_pkg.DcCmdXaXor, minion_pkg.DcCmdXaOr, minion_pkg.DcCmdXaAnd, minion_pkg.DcCmdXaMin, minion_pkg.DcCmdXaMax, minion_pkg.DcCmdXaMinu, minion_pkg.DcCmdXaMaxu, minion_pkg.DcCmdXaCmpswp, minion_pkg.DcCmdXaMinPs, minion_pkg.DcCmdXaMaxPs, minion_pkg.DcCmdSc32, minion_pkg.DcCmdXwrb)
  if gsc_reg_valid and ex_cmd_is_write {
    vpu_scatter_store_data = tag_vpu_ctrl.scatter_data
  }
  mut tag_dcache_store_data_v:U256 = if tag_c.gsc { vpu_scatter_store_data } else { tag_vpu_ctrl.store_data }
  if not (tag_c.fp or not (tag_reg_valid and tag_c.mem)) {
    tag_dcache_store_data_v#[0..<64] = tag_reg_rs2
  }
  tag_dcache_store_data = tag_dcache_store_data_v

  // ================================ MEM stage ================================
  mem_reg_valid = tag_valid_qual
  // Only the first of consecutive breakpoints of one thread updates the progress CSR.
  mem_dcache_bp_triggered = tag_dcache_bp_triggered and (not mem_dcache_bp_triggered or mem_thread_id != tag_thread_id)
  mem_ctrl_fp_toint = tag_c.wxd and tag_c.fp
  if tag_xcpt {
    mem_reg_cause = tag_xcpt_cause
    mem_reg_xcpt_interrupt = tag_reg_xcpt_interrupt
  }
  if tag_pc_valid {
    mem_ctrl = tag_ctrl
    mem_reg_rvc = tag_reg_rvc
    mem_reg_pc = tag_reg_pc
    mem_uses_wdata = tag_uses_wdata
    mem_csr_flush = tag_csr_flush
    mem_thread_id = tag_thread_id
  }
  if tag_pc_valid and tag_uses_wdata {
    mem_reg_wdata = tag_final_wdata
  }
  mem_reg_xcpt = tag_xcpt and not tag_wb_redirects
  mem_reg_replay = tag_replay and not tag_wb_redirects
  mem_reg_gscing = tag_reg_gscing
  mem_csr_vpu = tag_valid_qual and tag_csr_vpu
  mem_csr_excl_mode = tag_csr_excl_mode

  const mem_reg_inst_ff = intpipe_inst_bits_stage<BrMask=0>(enable_i=U1(tag_pc_valid), is_csr_i=U1(tag_csr_en), is_br_jal_i=0, te_enable_i=te_enable, xcpt_i=U1(tag_xcpt), in_i=tag_reg_inst)
  mem_reg_inst = mem_reg_inst_ff.out_o
  mem_waddr = mem_reg_inst#[7..=11]

  // A replay comes from earlier stages, a dcache pipeline flush or an exclusive-mode transition.
  const mem_replay = mem_reg_replay or mem_dcache_flush_pipeline == 1 or (csr_excl_mode_transition and mem_reg_valid)
  const mem_pc_valid = mem_reg_valid or mem_replay or mem_reg_xcpt
  // A WB redirect, a disabled thread or an exclusive-mode transition kills the MEM instruction; a dcache flush kills it too.
  const mem_ctrl_kill_no_tlb_miss = (wb_take_pc and wb_thread_id == mem_thread_id) or csr_file.io_resume#[mem_thread_id] == 1 or (mem_thread_id != 0 and thread1_enable == 0) or (mem_thread_id == 0 and thread0_enable == 0) or csr_excl_mode_transition
  mem_ctrl_kill = mem_ctrl_kill_no_tlb_miss or mem_dcache_flush_pipeline == 1
  const mem_valid_qual = mem_reg_valid and not mem_ctrl_kill
  mem_vpu_kill = U1(mem_ctrl_kill)
  mem_dcache_kill = U1(mem_ctrl_kill)
  // The integer RF is written next cycle by a regular integer instruction.
  const mem_rfen_early = mem_reg_valid and mem_c.wxd and not mem_c.fp
  mem_csr_rw_cmd = if mem_valid_qual { mem_c.csr } else { minion_pkg.CsrN }

  // ================================ WB stage ================================
  wb_reg_valid = mem_valid_qual
  wb_dcache_fp_toint = U1(mem_c.wxd and mem_c.fp and mem_valid_qual)
  if mem_reg_xcpt {
    wb_reg_cause = mem_reg_cause
    wb_reg_xcpt_interrupt = mem_reg_xcpt_interrupt
  }
  if mem_pc_valid {
    wb_ctrl = mem_ctrl
    wb_reg_pc = mem_reg_pc
    wb_csr_flush = mem_csr_flush
    wb_reg_rvc = mem_reg_rvc
    wb_thread_id = mem_thread_id
  }
  if mem_uses_wdata and mem_pc_valid {
    wb_reg_wdata = mem_reg_wdata
  }
  const mem_wb_redirects = (wb_take_pc and wb_thread_id == mem_thread_id) or csr_file.io_resume#[mem_thread_id] == 1
  wb_reg_xcpt = mem_reg_xcpt and not mem_wb_redirects
  wb_reg_replay = mem_replay and not mem_wb_redirects
  wb_reg_gscing = mem_reg_gscing
  wb_csr_vpu = mem_valid_qual and mem_csr_vpu

  const wb_reg_inst_ff = intpipe_inst_bits_stage<BrMask=0>(enable_i=U1(mem_pc_valid), is_csr_i=U1(mem_csr_en), is_br_jal_i=0, te_enable_i=te_enable, xcpt_i=U1(mem_reg_xcpt), in_i=mem_reg_inst)
  wb_reg_inst = wb_reg_inst_ff.out_o
  wb_waddr = wb_reg_inst#[7..=11]

  // Valid, replay and exception in WB; a replay, exception, eret or CSR replay redirects fetch.
  wb_xcpt = wb_reg_xcpt or csr_file.io_csr_xcpt == 1
  const wb_pre_valid = wb_reg_valid and not wb_reg_replay and not wb_xcpt and csr_file.io_replay == 0
  wb_retire = wb_pre_valid and not wb_reg_gscing
  wb_take_pc = wb_reg_replay or wb_xcpt or csr_file.io_eret == 1 or csr_file.io_replay == 1
  wb_csr_rw_cmd = if wb_reg_valid { wb_c.csr } else { minion_pkg.CsrN }

  // ---- Integer RF write port: dcache load > FP-to-int > div/mul > WB instruction > fast local barrier ----
  const toint_last = minion_pkg.VpuTointScoreboardSize - 1
  const wb_fp_toint_wen = id_vpu_ctrl.scoreboard.toint_valid#[toint_last] == 1
  const wb_fp_toint_dest = id_vpu_ctrl.scoreboard.toint_dest#[(7*toint_last)..<(7*toint_last + 7)]
  const wb_fp_toint_addr = wb_fp_toint_dest#[1..=5]
  const wb_fp_toint_thread = wb_fp_toint_dest#[0]
  wb_dcache_wen = wb_dcache_resp_valid == 1 and wb_dcache_resp.dest.fp == 0
  const wb_div_wen = wb_div_resp_valid and wb_div_resp_ready
  wb_wen = wb_retire and wb_c.wxd and not wb_c.fp and not wb_c.mem and not wb_c.div
  // The write port is free for the divider when neither the dcache, an instruction nor FP-to-int use it.
  wb_div_resp_ready = not (wb_dcache_wen or wb_wen or wb_fp_toint_wen)
  wb_flb_wen_ready = not (wb_dcache_wen or wb_div_wen or wb_wen or wb_fp_toint_wen)
  wb_rf_wen = wb_dcache_wen or wb_div_wen or wb_wen or wb_fp_toint_wen or csr_file.flb_rf_wen_valid == 1
  wb_rf_waddr = if wb_dcache_wen { wb_dcache_resp.dest.addr }
    elif wb_fp_toint_wen { wb_fp_toint_addr }
    elif wb_div_wen { wb_div_resp_dest.addr }
    elif wb_wen { wb_waddr }
    else { csr_file.flb_rf_wen_addr }
  wb_rf_wdata = if wb_dcache_wen { wb_dcache_resp.data#[0..<64] }
    elif wb_fp_toint_wen { wb_vpu_ctrl.toint_data }
    elif wb_div_wen { mul_div.resp_data }
    elif wb_wen and wb_csr_en { csr_file.io_rw_wb_rdata }
    elif wb_wen { wb_reg_wdata }
    else { csr_file.flb_rf_wen_data }
  wb_rf_thread_id = if wb_dcache_wen { wb_dcache_resp.dest.thread_id }
    elif wb_fp_toint_wen { wb_fp_toint_thread }
    elif wb_div_wen { wb_div_resp_dest.thread_id }
    elif wb_wen { wb_thread_id }
    else { csr_file.flb_rf_wen_thread_id }
  // The RF write enable is issued one cycle early to clock-gate the data write latch.
  wb_rf_wen_early = mem_rfen_early or mem_dcache_resp_int_valid == 1 or mul_div.resp_valid_early == 1 or id_vpu_ctrl.scoreboard.toint_valid#[toint_last - 1] == 1 or csr_file.flb_rf_wen_valid_early == 1

  // ---- Outputs ----
  id_fe_req = fe_req_bits
  id_fe_stall = (e0=id_fe_stall_v#[0], e1=id_fe_stall_v#[1])
  icache_invalidate = csr_file.icache_invalidate
  dcache_ctrl = csr_file.dcache_ctrl
  vpu_ctrl = csr_file.vpu_ctrl
  ex_dcache_gsc = U1(ex_valid_qual_to_gsc)
  wb_dcache_x31 = wb_x31
  wb_dcache_invalidate_lr = U1(wb_xcpt)
  satp_info = (mode=csr_file.io_satp.mode, ppn=csr_file.io_satp.ppn)
  matp_info = (mode=csr_file.io_matp.mode, ppn=csr_file.io_matp.ppn)
  satp_info_en = csr_file.io_satp_en
  matp_info_en = csr_file.io_matp_en
  // vm_status: thread 1 in the high byte, each from the thread's status, privilege and debug bits.
  const vm_status_t0:U8 = vm_status_byte(debug=csr_file.io_debug#[0], prv=csr_file.io_prv#[0..<2], status=csr_file.io_status#[0..<6])
  const vm_status_t1:U8 = vm_status_byte(debug=csr_file.io_debug#[1], prv=csr_file.io_prv#[2..<4], status=csr_file.io_status#[6..<12])
  vm_status = (vm_status_t0, vm_status_t1)#[..]
  tlb_invalidate = csr_file.tlb_invalidate
  wb_vpu_kill = 0
  wb_vpu_dcache_resp_valid = U1(wb_dcache_resp_valid == 1 and wb_dcache_resp.dest.fp == 1)
  wb_vpu_dcache_resp = (addr=wb_dcache_resp.dest.addr, data=wb_dcache_resp.data, gdst=wb_dcache_resp.gsc_cnt, ps_mask=wb_dcache_resp.ps_mask, thread_id=wb_dcache_resp.dest.thread_id, typ=wb_dcache_resp.typ)
  flb_neigh_req_valid = csr_file.flb_neigh_req_valid
  flb_neigh_req_data = csr_file.flb_neigh_req_data
  TE_wb_reg_inst = wb_reg_inst
  TE_wb_reg_cause_ie = csr_file.TE_wb_reg_cause_ie
  TE_wb_reg_context = 0
  TE_tval = csr_file.TE_tval
  TE_prv = csr_file.TE_prv
  TE_exception = csr_file.TE_exception
  update_ddata0 = csr_file.update_ddata0
  ddata0_wdata = csr_file.ddata0_wdata
  in_debug_mode = csr_file.io_debug
  debug_busy = csr_file.busy
  debug_exception = csr_file.debug_out_exception
  wb_valid = U1(wb_retire)
  pmu_count_up = csr_file.pmu_count_up
  pmu_read_sel = csr_file.pmu_read_sel
  pmu_write_en = csr_file.pmu_write_en
  pmu_write_data = csr_file.pmu_write_data
  pmu_neigh_event_sel = csr_file.pmu_neigh_event_sel

  // Probe signals for netlist debug.
  debug_monitor_out = (id_thread_id=id_thread_id, id_pc=id_pc, id_valid=U1(id_valid), id_valid_qual=U1(id_valid_qual), id_inst_replay=U1(id_inst_replay), id_take_pc=U1(id_take_pc), id_csr_interrupt=id_csr_interrupt#[id_thread_id], excl_mode_stall=U1(excl_mode_blocks or csr_excl_mode_stall), ex_valid_qual=U1(ex_valid_qual), tag_valid_qual=U1(tag_valid_qual), mem_valid_qual=U1(mem_valid_qual), wb_valid=U1(wb_retire), gsc_reg_gsc_cnt=gsc_reg_gsc_cnt, tag_take_pc=U1(tag_take_pc), ipi_with_pc=ipi_with_pc, wb_take_pc=U1(wb_take_pc), id_xcpt=U1(id_xcpt), wb_xcpt=U1(wb_xcpt), id_stall_fp2int=U1(id_stall_fp2int), ex_gsc_busy=U1(ex_gsc_busy), csr_fe_stall=csr_file.fe_ctrl_stall#[id_thread_id], id_ctrl_stall_csr=U1(id_ctrl_stall_csr), id_ctrl_stall_dcache=U1(id_ctrl_stall_dcache), id_do_fence=U1(id_do_fence), id_ctrl_stall_trans=U1(id_ctrl_stall_trans), id_ctrl_stall_div=U1(id_ctrl_stall_div), id_int_sboard_hazard=U1(id_int_sboard_hazard), id_ctrl_stall_hazard_vpu=U1(id_ctrl_stall_hazard_vpu), id_ctrl_stall_hazard=U1(id_ctrl_stall_hazard))
}
