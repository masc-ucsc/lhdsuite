// intpipe_top: the Minion integer pipeline for two hardware threads. One instruction
// per cycle flows through the ID, EX (+ a GSC stage for gather/scatter elements), TAG,
// MEM and WB stages. Besides the in-order core it owns the integer register file, the
// mul/div unit, the CSR file, the hazard / scoreboard stall logic and the requests to the
// front end, the data cache and the vector unit.
const debug_breakpoint = import("debug_breakpoint.debug_breakpoint")
const intpipe_alu = import("intpipe_alu.intpipe_alu")
const intpipe_csr_file = import("intpipe_csr_file.intpipe_csr_file")
const intpipe_fp_scoreboard = import("intpipe_fp_scoreboard.intpipe_fp_scoreboard")
const intpipe_imm = import("intpipe_imm.intpipe_imm")
const intpipe_inst_bits_stage = import("intpipe_inst_bits_stage.intpipe_inst_bits_stage")
const intpipe_int_scoreboard = import("intpipe_int_scoreboard.intpipe_int_scoreboard")
const intpipe_mask_scoreboard = import("intpipe_mask_scoreboard.intpipe_mask_scoreboard")
const intpipe_mul_div_top = import("intpipe_mul_div_top.intpipe_mul_div_top")
const intpipe_rf = import("intpipe_rf.intpipe_rf")
const minion_pkg = import("minion_pkg")
const intpipe_csr_pkg = import("intpipe_csr_pkg")

// Gather/scatter lane counter value of the last lane; geometry of the VPU scoreboards (dcache
// replay-queue entries, trans-unit slots, total FP slots); width of the VPU gather/scatter index.
comptime const LAST_LANE:U3 = minion_pkg.VpuLaneNum - 1
comptime const DCACHE_SB_SLOTS = 8
comptime const TRANS_SB_SLOTS = 12
comptime const VPU_FP_SB_SLOTS = 14
comptime const GSC32_IDX_BITS = 40

// Decoded instruction control as the front end delivers it (id_ctrl) and as it is
// kept per stage in the packed ex_ctrl / tag_ctrl / mem_ctrl / wb_ctrl registers.
type Ctrl = (legal:Bool, mcode:Bool, fp:Bool, br:Bool, jal:Bool, jalr:Bool, rxs2:Bool, rxs1:Bool, sel_alu2:U2, sel_alu1:U2, sel_imm:U3, alu_dw:U1, alu_fn:U5, mem:Bool, mem_cmd:U5, mem_type:U4, rma:Bool, wmd:Bool, wmad:Bool, wfd:Bool, div:Bool, wxd:Bool, csr:U3, fence:Bool, mem_g:Bool, gsc:Bool, gfx:Bool, x31:Bool)

// The front end's id_ctrl port: the same fields with integer flags.
type CtrlPort = (legal:U1, mcode:U1, fp:U1, br:U1, jal:U1, jalr:U1, rxs2:U1, rxs1:U1, sel_alu2:U2, sel_alu1:U2, sel_imm:U3, alu_dw:U1, alu_fn:U5, mem:U1, mem_cmd:U5, mem_type:U4, rma:U1, wmd:U1, wmad:U1, wfd:U1, div:U1, wxd:U1, csr:U3, fence:U1, mem_g:U1, gsc:U1, gfx:U1, x31:U1)

// Per-stage register word layout, bit 44 (legal) down to bit 0 (x31). Issuing from ID packs the
// decoded control, except for the fields ID overrides (CSR command, ALU config, operand selects, mem/gsc kill).
comb ctrl_pack(alu_dw:U1, alu_fn:U5, c:Ctrl, csr:U3, gsc:Bool, mem:Bool, sel_alu1:U2, sel_alu2:U2) -> (w:U45) {
  const bits:U45 = (U1(c.x31), U1(c.gfx), U1(gsc), U1(c.mem_g), U1(c.fence), csr, U1(c.wxd), U1(c.div), U1(c.wfd), U1(c.wmad), U1(c.wmd), U1(c.rma), c.mem_type, c.mem_cmd, U1(mem), alu_fn, alu_dw, c.sel_imm, sel_alu1, sel_alu2, U1(c.rxs1), U1(c.rxs2), U1(c.jalr), U1(c.jal), U1(c.br), U1(c.fp), U1(c.mcode), U1(c.legal))#[..]
  w = bits
}

comb ctrl_unpack(w:U45) -> (c:Ctrl) {
  c.legal = w#[44] == 1
  c.mcode = w#[43] == 1
  c.fp = w#[42] == 1
  c.br = w#[41] == 1
  c.jal = w#[40] == 1
  c.jalr = w#[39] == 1
  c.rxs2 = w#[38] == 1
  c.rxs1 = w#[37] == 1
  c.sel_alu2 = w#[35..=36]
  c.sel_alu1 = w#[33..=34]
  c.sel_imm = w#[30..=32]
  c.alu_dw = w#[29]
  c.alu_fn = w#[24..=28]
  c.mem = w#[23] == 1
  c.mem_cmd = w#[18..=22]
  c.mem_type = w#[14..=17]
  c.rma = w#[13] == 1
  c.wmd = w#[12] == 1
  c.wmad = w#[11] == 1
  c.wfd = w#[10] == 1
  c.div = w#[9] == 1
  c.wxd = w#[8] == 1
  c.csr = w#[5..=7]
  c.fence = w#[4] == 1
  c.mem_g = w#[3] == 1
  c.gsc = w#[2] == 1
  c.gfx = w#[1] == 1
  c.x31 = w#[0] == 1
}

// prp-style-allow whole-tuple-copy
comb ctrl_from_port(p:CtrlPort) -> (c:Ctrl) {
  c.legal = p.legal == 1
  c.mcode = p.mcode == 1
  c.fp = p.fp == 1
  c.br = p.br == 1
  c.jal = p.jal == 1
  c.jalr = p.jalr == 1
  c.rxs2 = p.rxs2 == 1
  c.rxs1 = p.rxs1 == 1
  c.sel_alu2 = p.sel_alu2
  c.sel_alu1 = p.sel_alu1
  c.sel_imm = p.sel_imm
  c.alu_dw = p.alu_dw
  c.alu_fn = p.alu_fn
  c.mem = p.mem == 1
  c.mem_cmd = p.mem_cmd
  c.mem_type = p.mem_type
  c.rma = p.rma == 1
  c.wmd = p.wmd == 1
  c.wmad = p.wmad == 1
  c.wfd = p.wfd == 1
  c.div = p.div == 1
  c.wxd = p.wxd == 1
  c.csr = p.csr
  c.fence = p.fence == 1
  c.mem_g = p.mem_g == 1
  c.gsc = p.gsc == 1
  c.gfx = p.gfx == 1
  c.x31 = p.x31 == 1
}

// What the ID instruction reads and writes, for the hazard checks against the older stages:
// 3 integer and 4 FP register candidates (enable + 5-bit address each, candidate 0 is the
// destination) and the mask-register read/write sets.
type IdHazard = (int_en:U3, int_addr:U15, fp_en:U4, fp_addr:U20, mask_raddr:U8, mask_waddr:U8, mem:Bool, fp:Bool, wmd:Bool, wmad:Bool)

// Does the instruction in one older stage (c, waddr, valid) conflict with the one in ID? An
// integer hazard only stalls when that stage cannot bypass its result; FP and mask hazards
// always stall. waw_other / raw_other are the stage-specific extra conditions on FP
// write-after-write (besides ID being a load) and read-after-write hazards.
comb stage_hazard(c:Ctrl, cannot_bypass:Bool, id:IdHazard, raw_other:Bool, same_thread:Bool, tointm:U1, valid:Bool, waddr:U5, waw_other:Bool) -> (hazard:Bool) {
  mut int_hit = false
  for i in 0..<3 {
    if id.int_en#[i] == 1 and id.int_addr#[(5*i)..<(5*i + 5)] == waddr {
      int_hit = true
    }
  }
  int_hit = int_hit and c.wxd

  // FP: WAW on the destination (candidate 0), RAW on the three sources.
  mut fp_hit = id.fp_en#[0] == 1 and id.fp_addr#[0..<5] == waddr and (id.mem or waw_other)
  for i in 1..<4 {
    if id.fp_en#[i] == 1 and id.fp_addr#[(5*i)..<(5*i + 5)] == waddr and raw_other {
      fp_hit = true
    }
  }
  fp_hit = fp_hit and c.wfd and id.fp

  // Mask: older writes vs ID reads, a read-all-mask-to-X vs an ID mask write, and a
  // mask-producing compare vs ID mask writes.
  const older_writes:U8 = (U1(c.wmd) << waddr#[0..<3]) | (if c.wmad { 0xff } else { 0 })
  const cmp_writes:U8 = U1(c.wmd and tointm == 1) << waddr#[0..<3]
  const mask_hit = (older_writes & id.mask_raddr) != 0 or (c.rma and (id.wmd or id.wmad)) or (cmp_writes & id.mask_waddr) != 0

  hazard = valid and ((int_hit and cannot_bypass) or fp_hit or mask_hit) and same_thread
}

// One thread's byte of vm_status: {prv[1:0], mprv, mpp[1:0], sum, mxr, debug}. status is
// the thread's 6-bit mstatus view (mprv, mpp, sum, mxr in bits 5..1).
comb vm_status_byte(debug:U1, prv:U2, status:U6) -> (r:U8) {
  r = (prv << 6) | (status#[1..=5] << 1) | debug
}

// Trans-unit instructions (FRCP/FRSQ/FLOG/FEXP/FSIN.ps and FRCP_FIX_RAST): opcode, funct3 and
// the funct12/funct7 selector, ignoring the register fields.
comb is_trans_inst(inst:U32) -> (r:Bool) {
  const sel12 = inst & 0xfff0707f
  const sel7 = inst & 0xfe00707f
  r = sel12 == 0x5870007b or sel12 == 0x5880007b or sel12 == 0x5830007b or sel12 == 0x5840007b or sel12 == 0x5860007b or sel7 == 0x3000007b
}

pub mod intpipe_top<VpuEn=1>::[timecheck=false](cache_ops_err_flags:U4, chicken_bit_intpipe:U1, clk_i:Clock, dcache_bus_error:minion_pkg.NrThreads_T, dcache_bus_error_addr:U80, dcache_ctrl_resp:(cache_op_ready:U1, cache_op_busy_changed:U2, cache_op_complete_l1:U4, cache_op_complete_l2:U4, tl_ready_0:U1, tl_ready_1:U1, ts_ready:U1, tl_complete_0:U2, reduce_ready:U1, tex_send_ready:U1, gsc_progress_save:U2, gsc_progress:U3), dcache_debug_signals:(csr_signals_tl0:U3, csr_signals_tl1:U3, csr_signals_ts:U4, csr_signals_cou:U4, csr_signals_coul2:U3, csr_signals_txsnd:U2, csr_signals_mh0:U4, csr_signals_mh1:U4), debug_ex_program_buffer:minion_pkg.NrThreads_T, dft__reset:U1, dft__reset_byp:U1, esr_features:(disable_lock_unlock:U1, disable_multithreading:U1, trap_on_u_scp:U1, trap_on_u_cacheops:U1, trap_on_ml:U1, trap_on_gfx:U1), esr_shire_coop_mode:U1, ex_vpu_ctrl:(tointm:U1, illegal_rm:U1, ps_mask:U8, gsc_fs:U32), flb_neigh_resp_data:U1, flb_neigh_resp_valid:U1, halt:minion_pkg.NrThreads_T, id_ctrl:(legal:U1, mcode:U1, fp:U1, br:U1, jal:U1, jalr:U1, rxs2:U1, rxs1:U1, sel_alu2:U2, sel_alu1:U2, sel_imm:U3, alu_dw:U1, alu_fn:U5, mem:U1, mem_cmd:U5, mem_type:U4, rma:U1, wmd:U1, wmad:U1, wfd:U1, div:U1, wxd:U1, csr:U3, fence:U1, mem_g:U1, gsc:U1, gfx:U1, x31:U1), id_dcache_idle:U1, id_dcache_ordered:minion_pkg.NrThreads_T, id_dcache_ready:U1, id_dcache_sb_fp_dealloc:minion_pkg.NrThreads_T, id_dcache_sb_int_dealloc:minion_pkg.NrThreads_T, id_dcache_scoreboard:(valid:U8, dest:U56), id_fe_resp:(pc:U49, inst_bits:U32, pf0:U1, pf1:U1, af0:U1, af1:U1, replay:U1, rvc:U1, bus_error:U1, ecc_error:U1), id_fe_resp_thread_id:U1, id_fe_resp_valid:U1, id_frontend_vpu_ctrl:(m0ren:U1, mallren:U1, mren1:U1, mren2:U1, wen:U1, ren1:U1, ren2:U1, ren3:U1, rend:U1, is_trans:U1, trans_busy:U1, id_trans_insert:U1, scoreboard:(fp_valid:U14, fp_dest:U98, toint_valid:U4, toint_dest:U28, mask_valid:U4, mask_dest:U16), tfma_enabled:U1, tfma_wrrf_enabled:U1, tquant_enabled:U1, reduce_enabled:U1, fflags_stall:U1, fromint:U1), id_vpu_ctrl:(m0ren:U1, mallren:U1, mren1:U1, mren2:U1, wen:U1, ren1:U1, ren2:U1, ren3:U1, rend:U1, is_trans:U1, trans_busy:U1, id_trans_insert:U1, scoreboard:(fp_valid:U14, fp_dest:U98, toint_valid:U4, toint_dest:U28, mask_valid:U4, mask_dest:U16), tfma_enabled:U1, tfma_wrrf_enabled:U1, tquant_enabled:U1, reduce_enabled:U1, fflags_stall:U1, fromint:U1), interrupts:(mieco:U2, mtip:U2, msip:U2, meip:U2, seip:U2, fcc:U4, ipi_with_pc:U2, ipi_pc:U47), io_events_dcache_vpu:U23, l2_resp:(id:U8, dest:U1, wdata:U1, opcode:U2, data:U256, size:U3, qwen:U4), l2_resp_ready:U1, l2_resp_valid:U1, mem_dcache_flush_pipeline:U1, mem_dcache_resp_int_valid:U1, mem_vpu_ctrl:(fma:U1, tointm:U1), pmu_read_data:U128, read_ddata0:U128, resume:minion_pkg.NrThreads_T, rst_d_ni:U1, rst_ni:U1, rst_w_ni:U1, shire_id:U8, shire_min_id:U5, tag_dcache_bp:(thread_id:U1, address:U49, cmd:U3), tag_dcache_bp_valid:U1, tag_dcache_replay_next:U1, tag_dcache_xcpt:(pf_ld:U1, pf_st:U1, mf_ld:U1, mf_st:U1, af_ld:U1, af_st:U1, ps_ld:U1, ps_st:U1), tag_vpu_ctrl:(fma:U1, store_data:U256, scatter_data:U32, tointm:U1), te_enable:U1, te_thread_sel:U1, tensor_load_err_flags:U3, tensor_reduce_err_flags:U1, thread0_enable:U1, thread1_enable:U1, vpu_tfma_tenb_working:U1, wb_dcache_resp:(dest:(fp:U1, addr:U5, thread_id:U1), typ:U4, gsc_cnt:U3, ps_mask:U8, data:U256, addr:U49), wb_dcache_resp_valid:U1, wb_vpu_ctrl:(fma:U1, toint_data:U64, mova_mx:U1, fcsr_flags_valid:U1, fcsr_flags:U6, thread_id:U1, tointm:U1)) -> (id_fe_req_valid:minion_pkg.NrThreads_T@[], id_fe_req:U104@[], id_fe_stall:(e1:U1, e0:U1)@[], id_fe_resp_ready:U1@[], icache_invalidate:U1@[], dcache_ctrl:(tensorload_ctrl:(use_tmask:U1, use_coop:U1, transform:U3, scp_dest:U6, tl_sel:U1, addr:U42, offset:U2, num_lines:U4), tensorcoop_ctrl:(neigh_mask:U4, minion_mask:U8, padding:U3, id:U5), tensorload_stride:U48, tensorload_start:U1, tensorload_restart_b:U1, tensorload_tmask_ready:U1, tensorload_tmask_bits:U16, cache_op_valid:U1, cache_op_req:(cmd:U4, start_level:U2, dest_level:U2, count:U4, addr:U48, way:U2, stride:U48, thread_id:U1, use_tmask:U1, tmask_ready:U1, tmask_bits:U16, l2_scp_dest:U17, l2_scp_fill:U1), cache_op_req_next:(cmd:U4, start_level:U2, dest_level:U2), msg_port_wr_way:U2, msg_port_wr_addr:U10, msg_port_wr_en:U1, reduce_start:U1, tensorstore_start:U1, reduce_tensorstore_ctrl:U64, tensorstore_stride:U48, tex_send_valid:U1, tex_send_ctrl:(port_id:U2, size:U3, way:U2, set:U4, port_en:U1, thread_id:U1), cache_ctrl:(cacheop_max:U5, padding:U1, cacheop_reprate:U3, scpenable:U1, d1split:U1), thread_id:U1)@[], vpu_ctrl:(tensorfma_start:U1, tensorfma_ctrl:(is_conv:U1, padding3:U6, cols_b:U2, rows_a:U4, cols_a:U4, start_a:U4, padding2:U19, to_vrf:U1, u_b:U1, u_a:U1, ten_b:U1, padding1:U2, scp_b:U6, padding0:U2, scp_a:U6, mode:U3, first_pass:U1), tensorfma_conv_bits_ready:U1, tensorfma_conv_bits:U16, reduce_start:U1, tensorstore_start:U1, reduce_ctrl:U64, tensorquant_start:U1, tensorquant_ctrl:(padding2:U2, start_reg:U5, cols:U2, rows:U4, scp_src:U6, padding:U5, trans:U40), pending_scoreboard_t0:U1)@[], id_dcache_alloc_rq_pre:U1@[], ex_dcache_alloc_rq_val:U1@[], id_dcache_gsc:U1@[], ex_dcache_req_valid:U1@[], ex_dcache_req:(addr:U48, addr_msb_err:U1, dest:(fp:U1, addr:U5, thread_id:U1), cmd:U5, typ:U4, gsc_cnt:U3, ps_mask:U8, phys:U1, gsc32_idx:U40, mem_global:U1)@[], ex_dcache_gsc:U1@[], tag_dcache_kill:U1@[], tag_dcache_store_data:U256@[], mem_dcache_kill:U1@[], wb_dcache_x31:minion_pkg.XregSize_T@[], wb_dcache_invalidate_lr:U1@[], wb_dcache_fp_toint:U1@[], satp_info:(mode:U4, ppn:U28)@[], matp_info:(mode:U4, ppn:U28)@[], satp_info_en:U1@[], matp_info_en:U1@[], vm_status:U16@[], tlb_invalidate:U1@[], id_vpu_req:(valid:U1, thread_id:U1, fcsr_rm:U3, inst_bits:U32)@[], ex_vpu_req:(gscing:U1, gsc_src:U3, kill:U1, fromint_data:U64, thread_id:U1)@[], tag_vpu_kill:U1@[], mem_vpu_kill:U1@[], wb_vpu_kill:U1@[], wb_vpu_dcache_resp_valid:U1@[], wb_vpu_dcache_resp:(thread_id:U1, gdst:U3, typ:U4, addr:U5, data:U256, ps_mask:U8)@[], flb_neigh_req_valid:U1@[], flb_neigh_req_data:minion_pkg.CsrFlBarrierSize_T@[], TE_wb_reg_inst:minion_pkg.InstSize_T@[], TE_wb_reg_cause_ie:(interrupt_x:U1, reserved1:U58, cause:U5)@[], TE_wb_reg_context:U1@[], TE_tval:minion_pkg.VaSizeExt_T@[], TE_prv:U2@[], TE_exception:U1@[], update_ddata0:minion_pkg.NrThreads_T@[], ddata0_wdata:U64@[], in_debug_mode:minion_pkg.NrThreads_T@[], debug_busy:minion_pkg.NrThreads_T@[], debug_exception:minion_pkg.NrThreads_T@[], debug_monitor_out:(id_thread_id:U1, id_pc:U49, id_valid:U1, id_valid_qual:U1, id_inst_replay:U1, id_take_pc:U1, id_csr_interrupt:U1, excl_mode_stall:U1, ex_valid_qual:U1, tag_valid_qual:U1, mem_valid_qual:U1, wb_valid:U1, gsc_reg_gsc_cnt:U3, tag_take_pc:U1, ipi_with_pc:U2, wb_take_pc:U1, id_xcpt:U1, wb_xcpt:U1, id_stall_fp2int:U1, ex_gsc_busy:U1, csr_fe_stall:U1, id_ctrl_stall_csr:U1, id_ctrl_stall_dcache:U1, id_do_fence:U1, id_ctrl_stall_trans:U1, id_ctrl_stall_div:U1, id_int_sboard_hazard:U1, id_ctrl_stall_hazard_vpu:U1, id_ctrl_stall_hazard:U1)@[], wb_valid:U1@[], wb_thread_id:U1@[], wb_reg_pc:minion_pkg.PcSizeExt_T@[], pmu_count_up:minion_pkg.PmuMinionCountersNum_T@[], pmu_read_sel:U8@[], pmu_write_en:minion_pkg.PmuTotalCountersNum_T@[], pmu_write_data:minion_pkg.XregSize_T@[], pmu_neigh_event_sel:minion_pkg.PmuNeighEventCntSelBits_T@[]) {
  // Pipeline state resets synchronously on rst_w_ni; rst_ni / rst_d_ni only reach the CSR file.
  const reset_w = rst_w_ni == 0

  // ---- State, grouped by stage; a register without a reset value holds unreset state ----
  // Interrupt inputs and IPI redirect, registered for timing.
  reg intpipe_int_mieco:U2
  reg intpipe_int_mtip:U2
  reg intpipe_int_msip:U2
  reg intpipe_int_meip:U2
  reg intpipe_int_seip:U2
  reg intpipe_int_fcc:U4
  reg ipi_with_pc:U2
  reg ipi_pc_reg:U47

  // ID: fences, exclusive-mode stall, trans-unit starvation counters and front-end stalls.
  reg id_reg_fence:U2:[reset_pin=reset_w] = 0
  reg csr_excl_mode_stall_dcache:Bool:[reset_pin=reset_w] = false
  reg intpipe_trans_busy:U4:[reset_pin=reset_w] = 0
  reg id_ctrl_stall_trans_cnt:[2]U3:[ordering="old"]
  reg fence_fe_stall:U2:[reset_pin=reset_w] = 0
  reg fp_sboard_fe_stall:U2:[reset_pin=reset_w] = 0
  reg int_sboard_fe_stall:U2:[reset_pin=reset_w] = 0
  reg muldiv_needed:U2:[reset_pin=reset_w] = 0
  reg next_muldiv_thread:U1:[reset_pin=reset_w] = 0
  reg ex_div_ready_prev:Bool
  reg debug_timing:U2:[reset_pin=reset_w] = 0

  // EX
  reg ex_reg_valid:Bool:[reset_pin=reset_w] = false
  reg ex_thread_id:U1
  reg ex_ctrl:U45
  reg ex_ctrl_fp_toint:Bool:[reset_pin=reset_w] = false
  reg ex_uses_alu:Bool
  reg ex_reg_data:U128
  reg vpu_ex_reg_data:U64
  reg ex_reg_pc:U49
  reg ex_reg_rvc:Bool
  reg ex_reg_flush_pipe:Bool
  reg ex_reg_cause:U5
  reg ex_reg_xcpt:Bool
  reg ex_reg_xcpt_interrupt:Bool
  reg ex_reg_replay:Bool
  reg ex_csr_flush:Bool
  reg ex_csr_vpu:Bool
  reg ex_csr_excl_mode:Bool
  reg ex_op1:U64
  reg ex_op2:U64
  reg ex_dcache_alloc_rq_val:U1
  // Gather/scatter element counter (reset to the last lane) and the delayed VPU index word.
  reg ex_reg_gsc_cnt:U3:[reset_pin=reset_w] = 7
  reg ex_gscing_one_lane:Bool:[reset_pin=reset_w] = false
  reg ex_gsc_fs_valid:U2
  reg tag_div_req:Bool:[reset_pin=reset_w] = false
  reg mem_div_req:Bool:[reset_pin=reset_w] = false

  // GSC (the extra stage gather/scatter elements go through)
  reg gsc_reg_valid:Bool:[reset_pin=reset_w] = false
  reg gsc_reg_gscing:Bool:[reset_pin=reset_w] = false
  reg gsc_reg_gsc_cnt:U3:[reset_pin=reset_w] = 0
  reg gsc_reg_ps_mask:U8
  reg gsc_pc_valid:Bool
  reg gsc_reg_flush_pipe:Bool

  // TAG
  reg tag_reg_valid:Bool:[reset_pin=reset_w] = false
  reg tag_thread_id:U1
  reg tag_ctrl:U45
  reg tag_ctrl_fp_toint:Bool:[reset_pin=reset_w] = false
  reg tag_reg_pc:U49
  reg tag_reg_wdata:U64
  reg tag_reg_rs2:U64
  reg tag_reg_rvc:Bool
  reg tag_reg_flush_pipe:Bool
  reg tag_reg_cause:U5
  reg tag_reg_xcpt:Bool
  reg tag_reg_xcpt_interrupt:Bool
  reg tag_reg_replay:Bool
  reg tag_reg_gscing:Bool
  reg tag_csr_flush:Bool
  reg tag_csr_vpu:Bool
  reg tag_csr_excl_mode:Bool
  reg vpu_scatter_store_data:U32

  // MEM
  reg mem_reg_valid:Bool:[reset_pin=reset_w] = false
  reg mem_thread_id:U1:[reset_pin=reset_w] = 0
  reg mem_ctrl:U45
  reg mem_ctrl_fp_toint:Bool:[reset_pin=reset_w] = false
  reg mem_dcache_bp_triggered:Bool:[reset_pin=reset_w] = false
  reg mem_reg_pc:U49
  reg mem_reg_wdata:U64
  reg mem_uses_wdata:Bool
  reg mem_reg_rvc:Bool
  reg mem_reg_cause:U5
  reg mem_reg_xcpt:Bool
  reg mem_reg_xcpt_interrupt:Bool
  reg mem_reg_replay:Bool
  reg mem_reg_gscing:Bool
  reg mem_csr_flush:Bool
  reg mem_csr_vpu:Bool
  reg mem_csr_excl_mode:Bool

  // WB (wb_thread_id, wb_reg_pc and wb_dcache_fp_toint are also output ports)
  reg wb_reg_valid:Bool:[reset_pin=reset_w] = false
  reg wb_thread_id:U1
  reg wb_ctrl:U45
  reg wb_dcache_fp_toint:U1:[reset_pin=reset_w] = 0
  reg wb_reg_pc:U49
  reg wb_reg_wdata:U64
  reg wb_reg_rvc:Bool
  reg wb_reg_cause:U5
  reg wb_reg_xcpt:Bool
  reg wb_reg_xcpt_interrupt:Bool
  reg wb_reg_replay:Bool
  reg wb_reg_gscing:Bool
  reg wb_csr_flush:Bool
  reg wb_csr_vpu:Bool

  // ---- Nets that are read before the stage producing them (the pipeline is a feedback loop) ----
  wire id_valid_qual:Bool = nil
  wire id_take_pc:Bool = nil
  wire id_fe_req_valid:U2 = nil
  wire id_fe_stall_v:U2 = nil
  wire id_bp_xcpt:Bool = nil
  wire id_take_redirect:U2 = nil
  wire id_bad_redirect:U2 = nil
  wire id_pending_scoreboard_t0:Bool = nil
  wire ex_waddr:U5 = nil
  wire tag_waddr:U5 = nil
  wire mem_waddr:U5 = nil
  wire wb_waddr:U5 = nil
  wire mem_reg_inst:U32 = nil
  wire wb_reg_inst:U32 = nil
  wire ex_gscing:Bool = nil
  wire ex_ctrl_kill:Bool = nil
  wire ex_dcache_req_en:Bool = nil
  wire tag_take_pc:Bool = nil
  wire tag_replay:Bool = nil
  wire tag_ctrl_kill:Bool = nil
  wire tag_dcache_bp_triggered:Bool = nil
  wire tag_npc:U49 = nil
  wire tbranch_up:U2 = nil
  wire mem_ctrl_kill:Bool = nil
  wire mem_csr_rw_cmd:U3 = nil
  wire wb_csr_rw_cmd:U3 = nil
  wire wb_take_pc:Bool = nil
  wire wb_xcpt:Bool = nil
  wire wb_retire:Bool = nil
  wire wb_dcache_wen:Bool = nil
  wire wb_wen:Bool = nil
  wire wb_div_resp_ready:Bool = nil
  wire wb_flb_wen_ready:Bool = nil
  wire wb_rf_wen:Bool = nil
  wire wb_rf_wen_early:Bool = nil
  wire wb_rf_waddr:U5 = nil
  wire wb_rf_wdata:U64 = nil
  wire wb_rf_thread_id:U1 = nil
  wire div_kill:Bool = nil
  wire csr_tensorfma_start:Bool = nil
  wire csr_tensorquant_start:Bool = nil

  // ================================ ID stage ================================
  // Front-end response.
  const id_valid = id_fe_resp_valid == 1
  const id_thread_id = id_fe_resp_thread_id
  const id_pc = id_fe_resp.pc
  const id_inst = id_fe_resp.inst_bits
  const id_waddr = id_inst#[7..=11]
  const id_raddr1 = id_inst#[15..=19]
  const id_raddr2 = id_inst#[20..=24]
  const id_xcpt_pf = id_fe_resp.pf0 == 1 or id_fe_resp.pf1 == 1
  const id_xcpt_af = id_fe_resp.af0 == 1 or id_fe_resp.af1 == 1
  const id_fetch_bus_error = id_fe_resp.bus_error == 1
  const id_fetch_ecc_error = id_fe_resp.ecc_error == 1
  const id_inst_replay = id_fe_resp.replay == 1
  // For gather/scatter the third source is encoded in the rd field.
  const id_raddr3:U5 = if id_frontend_vpu_ctrl.rend == 1 { id_inst#[7..=11] } else { id_inst#[27..=31] }
  const id_raddr:U10 = (id_raddr1, id_raddr2)#[..]
  const id_c = ctrl_from_port(p=id_ctrl)

  intpipe_int_mieco = interrupts.mieco
  intpipe_int_mtip = interrupts.mtip
  intpipe_int_msip = interrupts.msip
  intpipe_int_meip = interrupts.meip
  intpipe_int_seip = interrupts.seip
  intpipe_int_fcc = interrupts.fcc

  // Candidate registers for hazards: 3 integer (rs1, rs2, rd) and 4 FP (rs1, rs2, rs3, rd) ports.
  const id_int_hazard_en:U3 = (U1(id_c.wxd and id_waddr != 0), U1(id_c.rxs2 and id_raddr2 != 0), U1(id_c.rxs1 and id_raddr1 != 0))#[..]
  const id_int_hazard_addr:U15 = (id_waddr, id_raddr2, id_raddr1)#[..]
  const id_fp_hazard_en:U4 = (id_frontend_vpu_ctrl.wen, id_frontend_vpu_ctrl.ren3, id_frontend_vpu_ctrl.ren2, id_frontend_vpu_ctrl.ren1)#[..]
  const id_fp_hazard_addr:U20 = (id_waddr, id_raddr3, id_raddr2, id_raddr1)#[..]
  // Mask registers read / written by the ID instruction, one bit per mask register.
  const id_mask_all_read:U8 = if id_frontend_vpu_ctrl.mallren == 1 and id_c.fp { 0xff } else { 0 }
  const id_mask_raddr_hazard:U8 = id_mask_all_read | U1(id_frontend_vpu_ctrl.m0ren == 1 and id_c.fp) | (U1(id_frontend_vpu_ctrl.mren1 == 1 and id_c.fp) << id_raddr1#[0..<3]) | (U1(id_frontend_vpu_ctrl.mren2 == 1 and id_c.fp) << id_raddr2#[0..<3])
  const id_mask_all_written:U8 = if id_c.wmad { 0xff } else { 0 }
  const id_mask_waddr_hazard:U8 = id_mask_all_written | (U1(id_c.wmd) << id_waddr#[0..<3])
  const id_hazard:IdHazard = (fp=id_c.fp, fp_addr=id_fp_hazard_addr, fp_en=id_fp_hazard_en, int_addr=id_int_hazard_addr, int_en=id_int_hazard_en, mask_raddr=id_mask_raddr_hazard, mask_waddr=id_mask_waddr_hazard, mem=id_c.mem, wmad=id_c.wmad, wmd=id_c.wmd)

  // A trans-unit operation in flight keeps the following ~4 stages "busy" for CSR accesses.
  const intpipe_trans_busy_next:U4 = if id_vpu_ctrl.trans_busy == 1 { 15 } else { intpipe_trans_busy#[0..<3] << 1 }
  if id_vpu_ctrl.trans_busy == 1 or intpipe_trans_busy#[3] == 1 {
    intpipe_trans_busy = intpipe_trans_busy_next
  }
  const trans_draining = id_vpu_ctrl.trans_busy == 1 or intpipe_trans_busy#[3] == 1

  // ---- Scoreboards for long-latency results (dcache, div, VPU, fast local barrier) ----
  const scoreboard_fp = intpipe_fp_scoreboard(rd_thread_id=id_thread_id, rd_addr=id_fp_hazard_addr, dcache_scoreboard=id_dcache_scoreboard, vpu_scoreboard=(fp_dest=id_vpu_ctrl.scoreboard.fp_dest, fp_valid=id_vpu_ctrl.scoreboard.fp_valid))
  const scoreboard_mask = intpipe_mask_scoreboard(rd_thread_id=id_thread_id, rd_addr=id_mask_raddr_hazard, wd_addr=id_mask_waddr_hazard, vpu_scoreboard=(mask_dest=id_vpu_ctrl.scoreboard.mask_dest, mask_valid=id_vpu_ctrl.scoreboard.mask_valid))

  // Anything pending for thread 0: dcache FP loads, VPU operations (both threads below the trans
  // slots, because tensor instructions interfere with the trans sequencer) and a trans insertion.
  mut pending_t0 = false
  for i in 0..<DCACHE_SB_SLOTS {
    if id_dcache_scoreboard.valid#[i] == 1 and id_dcache_scoreboard.dest#[7*i + 6] == 1 and id_dcache_scoreboard.dest#[7*i] == 0 {
      pending_t0 = true
    }
  }
  for i in 0..<VPU_FP_SB_SLOTS {
    if id_vpu_ctrl.scoreboard.fp_valid#[i] == 1 and (i < TRANS_SB_SLOTS or id_vpu_ctrl.scoreboard.fp_dest#[7*i] == 0) {
      pending_t0 = true
    }
  }
  id_pending_scoreboard_t0 = pending_t0 or id_vpu_ctrl.id_trans_insert == 1

  // ---- IPI redirect: a registered inter-processor interrupt can force a PC ----
  ipi_with_pc = interrupts.ipi_with_pc
  if interrupts.ipi_with_pc != 0 {
    ipi_pc_reg = interrupts.ipi_pc
  }
  const ipi_pc:U48 = ipi_pc_reg << 1
  const imm_src2 = intpipe_imm(inst_bits=id_inst, sel_imm=id_ctrl.sel_imm)

  // ---- Integer ALU (operands are registered at the EX boundary) ----
  const alu = intpipe_alu(dw=ex_ctrl#[29], fn=ex_ctrl#[24..=28], in1=ex_op1, in2=ex_op2)

  // Unpacked per-stage control words.
  const ex_c = ctrl_unpack(w=ex_ctrl)
  const tag_c = ctrl_unpack(w=tag_ctrl)
  const mem_c = ctrl_unpack(w=mem_ctrl)
  const wb_c = ctrl_unpack(w=wb_ctrl)
  const ex_csr_en = ex_c.csr != minion_pkg.CsrN
  const tag_csr_en = tag_c.csr != minion_pkg.CsrN
  const mem_csr_en = mem_c.csr != minion_pkg.CsrN
  const wb_csr_en = wb_c.csr != minion_pkg.CsrN

  // ---- Integer register file (read in ID, written from WB) ----
  const rf = intpipe_rf(rd_en=(U1(id_c.rxs2) << 1) | U1(id_c.rxs1), rd_thread_id=id_thread_id, rd_addr=id_raddr, wr_en=U1(wb_rf_wen), wr_en_early=U1(wb_rf_wen_early), wr_thread_id=wb_rf_thread_id, wr_addr=wb_rf_waddr, wr_data=wb_rf_wdata)
  // X31 of the WB thread, for the dcache.
  const wb_x31 = rf.wb_x31_reg#[(64*wb_thread_id)..<(64*wb_thread_id + 64)]

  // Exception cause as the CSR file sees it, with the interrupt/exception flag.
  const wb_reg_cause_ie = (const cause:U5=wb_reg_cause, const interrupt_x:U1=U1(wb_reg_xcpt_interrupt), const reserved1:U58=0)

  // ---- CSR file: status registers, interrupts, exceptions, debug, and the tensor/cache-op CSR commands ----
  const csr_file = intpipe_csr_file(test_en=0, dft__reset_byp=dft__reset_byp, dft__reset=dft__reset, rst_ni=rst_ni, rst_w_ni=rst_w_ni, rst_d_ni=rst_d_ni, int_mieco=intpipe_int_mieco, int_mtip=intpipe_int_mtip, int_msip=intpipe_int_msip, int_meip=intpipe_int_meip, int_seip=intpipe_int_seip, int_fcc=intpipe_int_fcc, shire_id=shire_id, shire_min_id=shire_min_id, wb_thread_id=wb_thread_id, mem_thread_id=mem_thread_id, dcache_ctrl_resp=dcache_ctrl_resp, pending_scoreboard_t0=U1(id_pending_scoreboard_t0), vpu_tfma_enabled=U1(id_vpu_ctrl.tfma_enabled == 1 or csr_tensorfma_start), vpu_tfma_tenb_working=vpu_tfma_tenb_working, vpu_tquant_enabled=U1(id_vpu_ctrl.tquant_enabled == 1 or csr_tensorquant_start), vpu_treduce_enabled=id_vpu_ctrl.reduce_enabled, io_rw_mem_addr=mem_reg_inst#[20..=31], io_rw_wb_cmd=wb_csr_rw_cmd, io_rw_mem_cmd=mem_csr_rw_cmd, io_rw_wb_inst=wb_reg_inst#[20..=22], io_rw_mem_wdata=mem_reg_wdata, io_rw_wb_wdata=wb_reg_wdata, io_rw_wb_waddr=wb_waddr, wb_x31_reg=wb_x31, l2_resp_valid=l2_resp_valid, l2_resp_ready=l2_resp_ready, l2_resp=l2_resp, io_events_ext=(tbranch_up, io_events_dcache_vpu)#[..], io_exception=U1(wb_reg_xcpt), io_retire=U1(wb_retire), io_cause=wb_reg_cause_ie, io_pc=wb_reg_pc, io_badaddr=wb_dcache_resp.addr, io_inst_bits=wb_reg_inst, io_inst_rvc=U1(wb_reg_rvc), io_bad_redirect=id_bad_redirect, io_redirect=id_take_redirect, io_fcsr_flags_valid=wb_vpu_ctrl.fcsr_flags_valid, io_fcsr_flags_bits=wb_vpu_ctrl.fcsr_flags, io_fcsr_thread_id=wb_vpu_ctrl.thread_id, dcache_bus_error=(e0=dcache_bus_error#[0], e1=dcache_bus_error#[1]), dcache_bus_error_addr=dcache_bus_error_addr, debug_timing=debug_timing, bp_progress_save=U1(mem_dcache_bp_triggered and mem_c.gsc), read_ddata0=read_ddata0, halt=(e0=halt#[0], e1=halt#[1]), resume=resume, ex_progbuf=debug_ex_program_buffer, flb_neigh_resp_valid=flb_neigh_resp_valid, flb_neigh_resp_data=flb_neigh_resp_data, flb_rf_wen_ready=U1(wb_flb_wen_ready), te_thread_sel=te_thread_sel, esr_shire_coop_mode=esr_shire_coop_mode, esr_features=esr_features, tensor_load_err_flags=tensor_load_err_flags, cache_ops_err_flags=cache_ops_err_flags, tensor_reduce_err_flags=tensor_reduce_err_flags, pmu_read_data=pmu_read_data, dcache_debug_signals=dcache_debug_signals)
  csr_tensorfma_start = csr_file.vpu_ctrl.tensorfma_start == 1
  csr_tensorquant_start = csr_file.vpu_ctrl.tensorquant_start == 1

  const csr_excl_mode_transition = csr_file.io_excl_mode_transition == 1
  const id_csr_interrupt:U2 = (csr_file.io_interrupt.e1 << 1) | csr_file.io_interrupt.e0
  const id_single_step:U2 = (csr_file.io_singleStep.e1 << 1) | csr_file.io_singleStep.e0
  // Threads that are in exclusive mode with the other thread selected must not issue.
  const excl_mode_blocks = csr_file.io_excl_mode == 1 and csr_file.io_excl_mode_sel != id_thread_id

  // ---- Multiply / divide unit (one request per cycle, response through the WB write port) ----
  const ex_div_req = ex_reg_valid and ex_c.div
  const mul_div = intpipe_mul_div_top(rst_ni=rst_w_ni, dft_i=(ram_rei=0, ram_wei=0, scan_reset_n=0, scanmode=0, sram_clk_override=0), req_valid=U1(ex_div_req), req_valid_early=U1(id_valid_qual and id_c.div), req_fn=ex_c.alu_fn, req_fn_early=id_c.alu_fn, req_dw=ex_c.alu_dw, req_in1=ex_reg_data#[0..<64], req_in2=ex_reg_data#[64..<128], req_dest=(addr=ex_waddr, fp=0, thread_id=ex_thread_id), kill=U1(div_kill), chicken_bit_mul_div=chicken_bit_intpipe, resp_ready=U1(wb_div_resp_ready))
  const ex_div_ready = mul_div.req_ready == 1
  const wb_div_resp_valid = mul_div.resp_valid == 1
  const wb_div_resp_dest = mul_div.resp_dest

  // ---- Gather/scatter bookkeeping in ID ----
  const id_reg_gsc_cnt = csr_file.gsc_progress#[(3*id_thread_id)..<(3*id_thread_id + 3)]
  wire id_keepgsc:Bool = nil
  wire ex_gsc_busy:Bool = nil
  id_keepgsc = ex_gscing and not ex_ctrl_kill and id_dcache_ready == 1
  ex_gsc_busy = (ex_gscing or gsc_reg_gscing) and not ex_ctrl_kill

  // ---- Instruction pattern for the mcode trap, fences and exclusive mode ----
  // minstmask/minstmatch hold one 33-bit mask (+enable in bit 32) and one 32-bit match value per thread.
  const minst_mask = csr_file.io_minstmask#[(33*id_thread_id)..<(33*id_thread_id + 33)]
  const minst_match_bits = csr_file.io_minstmatch#[(32*id_thread_id)..<(32*id_thread_id + 32)]
  const minst_match = ((id_inst ^ minst_match_bits) & minst_mask#[0..=31]) == 0 and minst_mask#[32] == 1
  // Faults and mcode instructions have no meaningful opcode.
  const id_xcpt_ignore_opcode = id_xcpt_af or id_xcpt_pf or id_fetch_bus_error or id_fetch_ecc_error or id_c.mcode or minst_match
  // A fence (or acquire atomic) puts the thread in fence mode until its dcache traffic drains.
  const id_fence_new = id_c.fence and not id_xcpt_ignore_opcode

  const ex_same_thread = ex_reg_valid and ex_thread_id == id_thread_id
  const tag_same_thread = tag_reg_valid and tag_thread_id == id_thread_id
  const mem_same_thread = mem_reg_valid and mem_thread_id == id_thread_id
  const wb_same_thread = wb_reg_valid and wb_thread_id == id_thread_id

  // Per thread: is a CSR access in flight (it may start dcache work), and is the dcache busy.
  mut id_csr_inflight:U2 = 0
  mut id_dcache_busy:U2 = 0
  mut id_reg_fence_next:U2 = 0
  for i in 0..<2 {
    id_csr_inflight#[i] = U1((ex_reg_valid and ex_csr_en and ex_thread_id == i) or (tag_reg_valid and tag_csr_en and tag_thread_id == i) or (mem_reg_valid and mem_csr_en and mem_thread_id == i) or (wb_reg_valid and wb_csr_en and wb_thread_id == i))
    id_dcache_busy#[i] = U1(id_dcache_ordered#[i] == 0 or (ex_dcache_req_en and ex_thread_id == i) or id_csr_inflight#[i] == 1)
    id_reg_fence_next#[i] = U1((id_fence_new and id_valid_qual and id_thread_id == i) or (id_reg_fence#[i] == 1 and id_dcache_busy#[i] == 1))
  }
  id_reg_fence = id_reg_fence_next
  // The instruction may not move on while fenced and it is a memory instruction, CSR access or fence.
  const id_csr_en = id_c.csr != minion_pkg.CsrN
  const id_do_fence = id_dcache_busy#[id_thread_id] == 1 and id_reg_fence#[id_thread_id] == 1 and (id_c.mem or id_csr_en or id_c.fence) and not id_xcpt_ignore_opcode

  // Exclusive-mode stalls: waiting for the dcache to drain, about to start a gather/scatter while
  // an older instruction may enter exclusive mode (the other thread's, hence no thread check), or transitioning.
  csr_excl_mode_stall_dcache = if csr_excl_mode_transition { true }
    elif csr_excl_mode_stall_dcache { id_dcache_idle == 0 }
    else { csr_excl_mode_stall_dcache }
  const csr_excl_mode_stall = csr_excl_mode_stall_dcache or (id_c.gsc and ((ex_csr_excl_mode and ex_reg_valid) or (tag_csr_excl_mode and tag_reg_valid) or (mem_csr_excl_mode and mem_reg_valid))) or csr_excl_mode_transition

  // ---- Register bypass into ID: EX ALU, TAG, MEM, the dcache response, then WB, else the register file ----
  mut id_reg_data:U128 = 0
  for i in 0..<2 {
    const raddr = id_raddr#[(5*i)..<(5*i + 5)]
    const not_zero = raddr != 0
    id_reg_data#[(64*i)..<(64*i + 64)] = if not_zero and ex_same_thread and ex_c.wxd and ex_waddr == raddr {
      alu.out
    } elif not_zero and tag_same_thread and tag_c.wxd and tag_waddr == raddr {
      tag_reg_wdata
    } elif not_zero and mem_same_thread and mem_c.wxd and mem_waddr == raddr {
      mem_reg_wdata
    } elif not_zero and wb_dcache_resp.dest.thread_id == id_thread_id and wb_dcache_wen and wb_dcache_resp.dest.addr == raddr {
      wb_dcache_resp.data#[0..<64]
    } elif not_zero and wb_thread_id == id_thread_id and wb_wen and wb_waddr == raddr {
      wb_reg_wdata
    } else {
      rf.rd_data#[(64*i)..<(64*i + 64)]
    }
  }

  // ---- Fetch breakpoint and ID exceptions ----
  const fetch_bp = debug_breakpoint<TriggerType=0>(control_ip=csr_file.bp_control, in_debug_ip=csr_file.io_debug, prv_ip=csr_file.io_prv, tdata2_ip=csr_file.bp_address, address_ip=id_pc, valid_ip=U1(id_valid_qual), thread_id_ip=id_thread_id)
  id_bp_xcpt = fetch_bp.xcpt_op == 1
  // A fault in the second half of a split fetch; a breakpoint has priority over a page fault.
  const id_split_fetch_fault = if id_fe_resp.af1 == 1 { id_fe_resp.af0 == 0 }
    elif id_bp_xcpt { false }
    elif id_fe_resp.pf1 == 1 { id_fe_resp.pf0 == 0 }
    else { false }
  const id_illegal_insn = not id_c.legal or (id_c.fp and csr_file.io_status#[(6*id_thread_id)] == 0) or (id_c.gfx and esr_features.trap_on_gfx == 1)

  // Exception cause by priority; the lowest priority (mcode) is the default.
  mut id_xcpt = true
  mut id_xcpt_cause:U5 = minion_pkg.XcptMcodeInstruction
  if id_csr_interrupt#[id_thread_id] == 1 {
    id_xcpt_cause = csr_file.io_interrupt_cause#[(5*id_thread_id)..<(5*id_thread_id + 5)]
  } elif fetch_bp.enter_debug_op == 1 {
    id_xcpt_cause = minion_pkg.XcptDebug
  } elif id_bp_xcpt {
    id_xcpt_cause = minion_pkg.XcptBreakpoint
  } elif id_xcpt_af and id_valid {
    id_xcpt_cause = minion_pkg.XcptFetchAccess
  } elif id_xcpt_pf and id_valid {
    id_xcpt_cause = minion_pkg.XcptFetchPageFault
  } elif id_fetch_bus_error and id_valid {
    id_xcpt_cause = minion_pkg.XcptFetchBusError
  } elif id_fetch_ecc_error and id_valid {
    id_xcpt_cause = minion_pkg.XcptFetchEccError
  } elif id_illegal_insn and id_valid {
    id_xcpt_cause = minion_pkg.XcptIllegalInstruction
  } elif (id_c.mcode or minst_match) and id_valid {
    id_xcpt_cause = minion_pkg.XcptMcodeInstruction
  } else {
    id_xcpt = false
  }

  // ---- CSR instruction classification ----
  const id_csr_addr = id_inst#[20..=31]
  const id_system_insn = id_c.csr == minion_pkg.CsrI
  const id_csr_ren = (id_c.csr == minion_pkg.CsrS or id_c.csr == minion_pkg.CsrC) and id_raddr1 == 0
  // CSRs whose write does not require draining the pipe first.
  const id_csr_wr_safe = id_csr_addr in (intpipe_csr_pkg.csr_ad_CO_EVICT_VA, intpipe_csr_pkg.csr_ad_CO_FLUSH_VA, intpipe_csr_pkg.csr_ad_CO_LOCK_VA, intpipe_csr_pkg.csr_ad_CO_UNLOCK_VA, intpipe_csr_pkg.csr_ad_CO_PREFETCH_VA, intpipe_csr_pkg.csr_ad_TENSOR_LOAD, intpipe_csr_pkg.csr_ad_TENSOR_FMA, intpipe_csr_pkg.csr_ad_TENSOR_QUANT, intpipe_csr_pkg.csr_ad_TENSOR_REDUCE, intpipe_csr_pkg.csr_ad_TENSOR_STORE, intpipe_csr_pkg.csr_ad_TENSOR_CONV_CTRL, intpipe_csr_pkg.csr_ad_TENSOR_WAIT, intpipe_csr_pkg.csr_ad_TENSOR_COOPERATION, intpipe_csr_pkg.csr_ad_FLB, intpipe_csr_pkg.csr_ad_FCC)
