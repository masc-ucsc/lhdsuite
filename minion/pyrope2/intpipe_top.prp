  const id_stall_vpu = (scoreboard_fp.rd_data & id_fp_hazard_en) != 0 or scoreboard_mask.rd_data != 0 or scoreboard_mask.wd_data != 0 or id_vpu_ctrl.tfma_wrrf_enabled == 1 or csr_tensorfma_start or id_vpu_ctrl.tquant_enabled == 1 or csr_tensorquant_start or id_vpu_ctrl.reduce_enabled == 1 or vpu_csr_pending
