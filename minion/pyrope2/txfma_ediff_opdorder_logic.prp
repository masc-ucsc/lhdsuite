// Operand-order decision table for exponent stage e2: which operand (A/C/P/PH/PL/...)
// feeds each alignment shifter, the third operand and the exponent-difference
// and result-exponent muxes. Per-dtype cases are mutually exclusive; inside a case
// the first matching command wins.
const vpu_defs_pkg = import("vpu_defs_pkg")

pub comb txfma_ediff_opdorder_logic::[timecheck=false](cmd:vpu_defs_pkg.VPU_FCMD_SZ_T, exp_fma2_exc:U1, exp_res_2f3_f2a_h:U7, op_dtype:vpu_defs_pkg.VPU_DTYPE_SZ_T, sign_c_ph:U1, sign_c_pl:U1, sign_ph_pl:U1, sigs:(e18:U1, e17:U1, e16:U1, e15:U1, e14:U1, e13:U1, e12:U1, e11:U1, e10:U1, e9:U1, e8:U1, e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)) -> (align1_mux_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, align2_mux_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, ediff1_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, ediff2_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, opd3_mux_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, res_exp_hi_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T, res_exp_lo_sel:vpu_defs_pkg.TXFMA_EDIFF_OPD_SEL_SZ_T) {
  // Defaults: the F16 (ph) lane pairs with the addend; the dtype/command cases below override.
  // The per-dtype cases are mutually exclusive.
  // `mut`, not `const`: a const here trips the livehd rebind bug (livehd_bugs/03) when the caller binds this comb with `mut`.
  mut add_sub_sel:U5 = if cmd == vpu_defs_pkg.VPU_FCMD_ADD or cmd == vpu_defs_pkg.VPU_FCMD_SUB { vpu_defs_pkg.TXFMA_SEL_A }
    else { vpu_defs_pkg.TXFMA_SEL_P }
  mut ediff1:U5 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
  mut align1_mux:U5 = vpu_defs_pkg.TXFMA_SEL_PH
  mut opd3_mux:U5 = vpu_defs_pkg.TXFMA_SEL_P
  mut res_exp_hi:U5 = vpu_defs_pkg.TXFMA_SEL_C
  if sigs.e14 != 0 {
    align1_mux = vpu_defs_pkg.TXFMA_SEL_P
    opd3_mux = vpu_defs_pkg.TXFMA_SEL_A
    ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
    res_exp_hi = vpu_defs_pkg.TXFMA_SEL_GCVT_F32_NORM
  }
  mut align2_mux:U5 = vpu_defs_pkg.TXFMA_SEL_PL
  mut ediff2:U5 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
  mut res_exp_lo:U5 = vpu_defs_pkg.TXFMA_SEL_PH
  if op_dtype == vpu_defs_pkg.VPU_DTYPE_INT {
    if sigs.e8 != 0 {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_P
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_A
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      res_exp_hi = if cmd == vpu_defs_pkg.VPU_FCMD_CVT_F32RAST { vpu_defs_pkg.TXFMA_SEL_CVT_F32_FXP1615 } else { vpu_defs_pkg.TXFMA_SEL_CVT_F32INT }
    }
    if sigs.e16 != 0 or sigs.e17 != 0 or cmd == vpu_defs_pkg.VPU_FCMD_NR1_FRCPFXP {
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_P
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C_INT
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_P_INT
      if cmd == vpu_defs_pkg.VPU_TRANS_EXP_FMA2 and exp_fma2_exc != 0 {
        res_exp_hi = vpu_defs_pkg.TXFMA_SEL_B
        align1_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
        align2_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
        opd3_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
      }
    }
    if cmd == vpu_defs_pkg.VPU_FCMD_NR2_FRCPFXP {
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_NR2_FRCPFXP
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C_INT
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_P
    }
  } elif op_dtype == vpu_defs_pkg.VPU_DTYPE_F32 {
    if sigs.e8 != 0 {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PH
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_A
      if cmd == vpu_defs_pkg.VPU_FCMD_FROUND {
        opd3_mux = vpu_defs_pkg.TXFMA_SEL_ROUND
        res_exp_hi = vpu_defs_pkg.TXFMA_SEL_CVT_F32INT
      }
    } elif cmd == vpu_defs_pkg.VPU_TRANS_LOG_MUL {
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_P
      align1_mux = vpu_defs_pkg.TXFMA_SEL_P
      ediff1 = if exp_res_2f3_f2a_h == 0 { vpu_defs_pkg.TXFMA_SEL_EDIFF_LOG_MUL2 } else { vpu_defs_pkg.TXFMA_SEL_EDIFF_LOG_MUL }
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_EXP_RES
    } elif sigs.e7 != 0 {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_P
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PH
    } elif cmd == vpu_defs_pkg.VPU_TRANS_LOG_RR {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_C
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
    } elif cmd == vpu_defs_pkg.VPU_FCMD_FFRC or cmd == vpu_defs_pkg.VPU_FCMD_FFRC_SIN {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_A
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_C
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_C
    } elif cmd == vpu_defs_pkg.VPU_FCMD_FLE or cmd == vpu_defs_pkg.VPU_FCMD_FLT or cmd == vpu_defs_pkg.VPU_FCMD_FEQ {
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_P
    } elif cmd == vpu_defs_pkg.VPU_TRANS_EXP_FRAC {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C
      align2_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_EXP_FRAC
      res_exp_lo = vpu_defs_pkg.TXFMA_SEL_EXP_FRAC
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
    } elif cmd == vpu_defs_pkg.VPU_TRANS_SIN_TRANSFORM {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C
      align2_mux = vpu_defs_pkg.TXFMA_SEL_A
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      ediff2 = vpu_defs_pkg.TXFMA_SEL_ZERO
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PH
    } elif sigs.e15 != 0 {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_P
      align2_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_ZERO
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_ZERO
      res_exp_lo = vpu_defs_pkg.TXFMA_SEL_ZERO
    } elif sigs.e13 != 0 {
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PH
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      align1_mux = vpu_defs_pkg.TXFMA_SEL_A
    } elif sign_c_ph != 0 {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C
      opd3_mux = add_sub_sel
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      res_exp_hi = add_sub_sel
    } else {
      align1_mux = add_sub_sel
      opd3_mux = vpu_defs_pkg.TXFMA_SEL_C
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
      res_exp_hi = vpu_defs_pkg.TXFMA_SEL_C
    }
  } elif op_dtype == vpu_defs_pkg.VPU_DTYPE_F16_F32 {
    if sigs.e7 != 0 {
      align1_mux = vpu_defs_pkg.TXFMA_SEL_C
      ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_ZERO
      if sign_ph_pl != 0 {
        align2_mux = vpu_defs_pkg.TXFMA_SEL_PH
        opd3_mux = vpu_defs_pkg.TXFMA_SEL_PL
        ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL
        res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PL
      } else {
        align2_mux = vpu_defs_pkg.TXFMA_SEL_PL
        opd3_mux = vpu_defs_pkg.TXFMA_SEL_PH
        ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL
        res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PH
      }
    } else {
      // No arm for patterns 2 and 5: the defaults stand.
      const signs:U3 = (sign_ph_pl, sign_c_pl, sign_c_ph)#[..]
      match signs {
        in (0, 1) {
          align1_mux = vpu_defs_pkg.TXFMA_SEL_PH
          align2_mux = vpu_defs_pkg.TXFMA_SEL_PL
          opd3_mux = vpu_defs_pkg.TXFMA_SEL_C
          ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPH
          ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
          res_exp_hi = vpu_defs_pkg.TXFMA_SEL_C
        }
        == 3 {
          align1_mux = vpu_defs_pkg.TXFMA_SEL_C
          align2_mux = vpu_defs_pkg.TXFMA_SEL_PH
          opd3_mux = vpu_defs_pkg.TXFMA_SEL_PL
          ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EC_EPL
          ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EPH_EPL
          res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PL
        }
        in (4, 6) {
          align1_mux = vpu_defs_pkg.TXFMA_SEL_C
          align2_mux = vpu_defs_pkg.TXFMA_SEL_PL
          opd3_mux = vpu_defs_pkg.TXFMA_SEL_PH
          ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPH
          ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_EPH_EPL
          res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PH
        }
        == 7 {
          align1_mux = vpu_defs_pkg.TXFMA_SEL_C
          align2_mux = vpu_defs_pkg.TXFMA_SEL_PH
          opd3_mux = vpu_defs_pkg.TXFMA_SEL_PL
          ediff1 = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EC_EPL
          ediff2 = vpu_defs_pkg.TXFMA_SEL_EDIFF_N_EPH_EPL
          res_exp_hi = vpu_defs_pkg.TXFMA_SEL_PL
        }
        else {
        }
      }
    }
  } elif op_dtype == vpu_defs_pkg.VPU_DTYPE_F11 or op_dtype == vpu_defs_pkg.VPU_DTYPE_F10 or op_dtype == vpu_defs_pkg.VPU_DTYPE_F16 {
    res_exp_hi = vpu_defs_pkg.TXFMA_SEL_C
  }
  align1_mux_sel = align1_mux
  align2_mux_sel = align2_mux
  opd3_mux_sel = opd3_mux
  ediff1_sel = ediff1
  ediff2_sel = ediff2
  res_exp_hi_sel = res_exp_hi
  res_exp_lo_sel = res_exp_lo
}
