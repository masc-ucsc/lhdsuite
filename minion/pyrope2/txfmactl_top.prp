// FMA control pipeline (stages F0..F6): hosts the per-stage control decoders
// (txfma_c0..c6) and the pipeline registers that carry decoded control, special-result
// flags and the dtype/command/signal bundle from one stage to the next.
// ctrl_valid_f<N>a_h gates every payload register of stage N (they hold when no
// instruction is in flight); the valid/enable bits themselves reset to 0, and so do the
// F6 operand-descriptor registers. Everything else is unreset state.
const txfma_c0 = import("txfma_c0.txfma_c0")
const txfma_c1 = import("txfma_c1.txfma_c1")
const txfma_c2 = import("txfma_c2.txfma_c2")
const txfma_c3 = import("txfma_c3.txfma_c3")
const txfma_c4 = import("txfma_c4.txfma_c4")
const txfma_c5 = import("txfma_c5.txfma_c5")
const txfma_c6 = import("txfma_c6.txfma_c6")
const vpu_defs_pkg = import("vpu_defs_pkg")

// Split the packed 19-bit signal vector into the named bits the stage decoders take.
comb unpack_sigs(v:U19) -> (e0:U1, e1:U1, e10:U1, e11:U1, e12:U1, e13:U1, e14:U1, e15:U1, e16:U1, e17:U1, e18:U1, e2:U1, e3:U1, e4:U1, e5:U1, e6:U1, e7:U1, e8:U1, e9:U1) {
  e18 = v#[18]
  e17 = v#[17]
  e16 = v#[16]
  e15 = v#[15]
  e14 = v#[14]
  e13 = v#[13]
  e12 = v#[12]
  e11 = v#[11]
  e10 = v#[10]
  e9 = v#[9]
  e8 = v#[8]
  e7 = v#[7]
  e6 = v#[6]
  e5 = v#[5]
  e4 = v#[4]
  e3 = v#[3]
  e2 = v#[2]
  e1 = v#[1]
  e0 = v#[0]
}

