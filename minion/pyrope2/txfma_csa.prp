// Bits-wide carry-save adder (3:2 compressor): per-bit majority is the carry
// (not yet shifted into its weight) and the 3-input parity is the sum.
pub comb txfma_csa<Bits=1>(a_i:Unsigned(bits=Bits), b_i:Unsigned(bits=Bits), cin_i:Unsigned(bits=Bits)) -> (cout_o:Unsigned(bits=Bits), sum_o:Unsigned(bits=Bits)) {
  cout_o = (a_i & b_i) | (a_i & cin_i) | (b_i & cin_i)
  sum_o = a_i ^ b_i ^ cin_i
}
