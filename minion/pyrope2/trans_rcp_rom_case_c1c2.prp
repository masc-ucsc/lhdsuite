pub comb trans_rcp_rom_case_c1c2(index_i:U8) -> (data_o:(exc:U1, mask:U7, taylor:U1, c2:U17, c0:U32)) {
  const entry:U58 = TABLE[index_i#[0..<7]]
  data_o.exc = entry#[57]
  data_o.mask = entry#[50..<57]
  data_o.taylor = entry#[49]
  data_o.c2 = entry#[32..<49]
  data_o.c0 = entry#[0..<32]
}
