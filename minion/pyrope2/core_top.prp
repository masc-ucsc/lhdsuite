  reg te_instr_bus_reg_q:U32:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_instr_addr_reg_q:U49:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_instr_context_reg_q:U1:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_exception_reg_q:U1:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_exception_cause_reg_q:U5:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_interrupt_reg_q:U1:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_exception_trap_value_reg_q:U49:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_privilege_level_reg_q:U2:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  reg te_cpu_halted_reg_q:U1:[async=true, negreset=true, reset_pin=rst_w_ni] = 0
  if te_enable_i == 1 {
    const retire_thread_is_sel = u_intpipe.wb_thread_id == te_thread_sel_i
    te_instr_valid_reg_q = U1(u_intpipe.wb_valid == 1 and retire_thread_is_sel)
    te_instr_bus_reg_q = u_intpipe.TE_wb_reg_inst
    te_instr_addr_reg_q = u_intpipe.wb_reg_pc
    te_instr_context_reg_q = u_intpipe.TE_wb_reg_context
    te_exception_reg_q = U1(u_intpipe.TE_exception == 1 and retire_thread_is_sel)
    te_exception_cause_reg_q = u_intpipe.TE_wb_reg_cause_ie.cause
    te_interrupt_reg_q = u_intpipe.TE_wb_reg_cause_ie.interrupt_x
    te_exception_trap_value_reg_q = u_intpipe.TE_tval
    te_privilege_level_reg_q = u_intpipe.TE_prv
    te_cpu_halted_reg_q = halted#[te_thread_sel_i]
  }

  // ---- Outputs ---------------------------------------------------------------------------------------
  l2_dcache_evict_req_valid_o = u_dcache.l2_evict_req_valid_o
  l2_dcache_evict_req_o = u_dcache.l2_evict_req_o
  l2_dcache_miss_req_valid_o = u_dcache.l2_miss_req_valid_o
  l2_dcache_miss_req_o = u_dcache.l2_miss_req_o
  l2_dcache_resp_ready_o = u_dcache.l2_resp_ready_o

  icache_req_valid_o = u_frontend.f1_icache_req_valid_o
  icache_req_o = u_frontend.f1_icache_req_o
  icache_flush_data_o = u_intpipe.icache_invalidate
  satp_info_o = u_intpipe.satp_info
  matp_info_o = u_intpipe.matp_info
  tlb_invalidate_o = u_intpipe.tlb_invalidate

  dc_ptw_req_data_o = u_dcache.ptw_req_data_o
  dc_ptw_req_valid_o = u_dcache.ptw_req_valid_o

  id_vpu_req_o = u_intpipe.id_vpu_req
  id_vpu_decoder_sigs_o = u_frontend.id_vpu_decoder_sigs_o
  ex_vpu_req_o = u_intpipe.ex_vpu_req
  tag_vpu_kill_o = u_intpipe.tag_vpu_kill
  mem_vpu_kill_o = u_intpipe.mem_vpu_kill
  wb_vpu_kill_o = u_intpipe.wb_vpu_kill
  f0_vpu_ctrl_o = u_intpipe.vpu_ctrl
  wb_dcache_vpu_resp_valid_o = u_intpipe.wb_vpu_dcache_resp_valid
  wb_dcache_vpu_resp_o = u_intpipe.wb_vpu_dcache_resp
  dcache_vpu_scp_res_o = u_dcache.s3_vpu_scp_resp_o
  dcache_vpu_scp_data_o = u_dcache.s3_vpu_scp_data_o
  dcache_vpu_tenb_data_o = u_dcache.s3_vpu_tenb_data_o
  vpu_reduce_ctrl_o = u_dcache.vpu_reduce_ctrl_o

  intpipe_debug_monitor_o = u_intpipe.debug_monitor_out

  flb_neigh_req_valid_o = u_intpipe.flb_neigh_req_valid
  flb_neigh_req_data_o = u_intpipe.flb_neigh_req_data

  trace_encoder_o.instr_valid = te_instr_valid_reg_q
  trace_encoder_o.instr_bus = te_instr_bus_reg_q
  trace_encoder_o.instr_addr = te_instr_addr_reg_q
  trace_encoder_o.instr_context = te_instr_context_reg_q
  trace_encoder_o.exception = te_exception_reg_q
  trace_encoder_o.exception_cause = te_exception_cause_reg_q
  trace_encoder_o.interrupt = te_interrupt_reg_q
  trace_encoder_o.exception_trap_value = te_exception_trap_value_reg_q
  trace_encoder_o.privilege_level = te_privilege_level_reg_q
  trace_encoder_o.status_flags = 0
  trace_encoder_o.cpu_halted = te_cpu_halted_reg_q
  trace_encoder_o.min_reset = U1(any_reset)

  // Debug status: running = enabled, not in debug mode, not just out of reset, and not in reset.
  debug_out_o.halted = halted
  debug_out_o.running = ~in_debug_mode & ~have_reset & enabled & (if reset_w or reset_c { 0 } else { 3 })
  debug_out_o.have_reset = debug_out_have_reset_q
  debug_out_o.busy = debug_busy
  debug_out_o.exception = u_intpipe.debug_exception
  debug_out_o.error = debug_out_error_q

  // The shared APB response comes from whichever side the last request targeted.
  apb_pready_o = if apb_target_debug_reg_q { gen_debug_apb_transport_u_debug_apb_slv.apb_pready_o } else { u_dcache.apb_pready_o }
  apb_prdata_o = if apb_target_debug_reg_q { gen_debug_apb_transport_u_debug_apb_slv.apb_prdata_o } else { u_dcache.apb_prdata_o }
  apb_pslverr_o = if apb_target_debug_reg_q { gen_debug_apb_transport_u_debug_apb_slv.apb_pslverr_o } else { u_dcache.apb_pslverr_o }

  pmu_count_up_o = u_intpipe.pmu_count_up
  pmu_read_sel_o = u_intpipe.pmu_read_sel
  pmu_write_en_o = u_intpipe.pmu_write_en
  pmu_write_data_o = u_intpipe.pmu_write_data
  pmu_neigh_event_sel_o = u_intpipe.pmu_neigh_event_sel

  sm_match_debug_signals_tl0_o = u_dcache.sm_match_debug_signals_tl0_o
  sm_filter_debug_signals_tl0_o = u_dcache.sm_filter_debug_signals_tl0_o
  sm_data_debug_signals_tl0_o = u_dcache.sm_data_debug_signals_tl0_o
  sm_match_debug_signals_tl1_o = u_dcache.sm_match_debug_signals_tl1_o
  sm_filter_debug_signals_tl1_o = u_dcache.sm_filter_debug_signals_tl1_o
  sm_data_debug_signals_tl1_o = u_dcache.sm_data_debug_signals_tl1_o
  sm_match_debug_signals_ts_o = u_dcache.sm_match_debug_signals_ts_o
  sm_filter_debug_signals_ts_o = u_dcache.sm_filter_debug_signals_ts_o
  sm_data_debug_signals_ts_o = u_dcache.sm_data_debug_signals_ts_o
  sm_match_debug_signals_co_o = u_dcache.sm_match_debug_signals_co_o
  sm_filter_debug_signals_co_o = u_dcache.sm_filter_debug_signals_co_o
  sm_data_debug_signals_co_o = u_dcache.sm_data_debug_signals_co_o
  sm_match_debug_signals_col2_o = u_dcache.sm_match_debug_signals_col2_o
  sm_filter_debug_signals_col2_o = u_dcache.sm_filter_debug_signals_col2_o
  sm_data_debug_signals_col2_o = u_dcache.sm_data_debug_signals_col2_o
  sm_match_debug_signals_mh_o = u_dcache.sm_match_debug_signals_mh_o
  sm_filter_debug_signals_mh_o = u_dcache.sm_filter_debug_signals_mh_o
  sm_data_debug_signals_mh_o = u_dcache.sm_data_debug_signals_mh_o
  sm_match_debug_signals_dc_o = u_dcache.sm_match_debug_signals_dc_o
  sm_filter_debug_signals_dc_o = u_dcache.sm_filter_debug_signals_dc_o
  sm_data_debug_signals_dc_o = u_dcache.sm_data_debug_signals_dc_o
}
