// TensorReduce / TensorStore sequencer of the VPU.
// A reduce combines a run of VPU RF lines between two minions: the sender
// streams its lines through the dcache (a fake store is stuffed into the VPU
// pipeline per line), the receiver executes the reduce op (add/max/min,
// float/int, or conditional move) on each arriving line.  TensorStore reuses
// the same walker over a rows x cols block of registers.
// This module counts the pending registers, tracks the current one, and
// builds the instruction injected into the VPU pipeline.  It waits (sticky
// "pend" bits) for earlier VPU RF writers (scoreboard, TensorFMA, TensorQuant).
const vpu_defs_pkg = import("vpu_defs_pkg")

// Instruction templates (verilog vpu_defs_pkg); the register fields are filled in below.
comptime const FSW_PS = 0ub?????????????????110?????0001011
comptime const FADD_PS_DYN = 0ub0000000??????????111?????1111011 // dynamic rounding mode
comptime const FMIN_PS = 0ub0010100??????????000?????1111011
comptime const FMAX_PS = 0ub0010100??????????001?????1111011
comptime const FCMOVM_PS = 0ub0000000??????????000?????1110111
comptime const FADD_PI = 0ub0000011??????????000?????1111011
comptime const FMIN_PI = 0ub0010111??????????000?????1111011
comptime const FMAX_PI = 0ub0010111??????????001?????1111011

// reduce_ctrl.reduce.op encodings
comptime const OpFaddPs = 0
comptime const OpFmaxPs = 2
comptime const OpFminPs = 3
comptime const OpFaddPi = 4
comptime const OpFmaxPi = 6
comptime const OpFminPi = 7
comptime const OpCmov = 8

// A tensor-store exec op counts down this many cycles after the last exec so the
// VPU bypass can consume its result before a new instruction enters.
comptime const ExecCooldown = 4

// reset stays a U1 net: the caller (vpu_ml) hands it over as plain data.
// prp-style-allow reset-port-type
pub mod vpu_tensorreduce::[timecheck=false](clock:Clock, dcache_reduce_ctrl:(send_reg:U1, exec_op:U1, nothing:U1), reduce_ctrl:U64, reduce_start:U1, reset:U1, scoreboard_pend:U1, tensorfma_pend:U1, tensorfma_start:U1, tensorquant_pend:U1, tensorquant_start:U1, tensorstore_start:U1) -> (enabled:U1@[], load_ctrl:(wen:U1, thread_id:U1, broadcast_sel:U3, waddr:U5)@[], reduce_inst_en_next:U1@[], reduce_inst_next:vpu_defs_pkg.INST_SIZE_T@[], reduce_wait:U1@[], vpu_tensorreduce_debug:U25@[]) {
  // reduce_ctrl is a union: the reduce view and the tensorstore view of the same 64 bits.
  const reduce_op_field = reduce_ctrl#[24..<28]
  const reduce_num_regs = reduce_ctrl#[16..<23]
  const store_src_inc = reduce_ctrl#[62..<64]
  const store_cols = reduce_ctrl#[55..<57]
  const store_rows = reduce_ctrl#[51..<55]
  const start_reg_field = reduce_ctrl#[57..<62] // same position in both views

  // pending: reduce counts down lines; tensorstore packs rows:cols counters (bits 6:3 / 2:0)
  reg reg_pending:U7:[reset_pin=reset] = 0
  reg cur_reg:U5 = nil
  reg reduce_op:U4 = nil
  reg cols_per_row:U2 = nil
  reg is_reduce:Bool = nil
  reg exec_op_cd:U3:[reset_pin=reset] = 0
  reg send_reg:Bool = nil
  reg exec_op_s0:Bool = nil
  reg exec_op:Bool = nil
  reg scoreboard_pend_sticky:Bool:[reset_pin=reset] = false
  reg tfma_pend_sticky:Bool:[reset_pin=reset] = false
  reg tquant_pend_sticky:Bool:[reset_pin=reset] = false

  const enabled_int = reg_pending != 0
  // Hold "enabled" until the last exec result can be consumed by the bypass.
  const is_enabled = enabled_int or exec_op_cd != 0
  const new_req = reduce_start != 0 or tensorstore_start != 0
  const nothing = dcache_reduce_ctrl.nothing != 0

  // ---- next pending count and current register
  mut pending_next:U7 = reg_pending
  mut cur_reg_next:U5 = 0sb?
  if is_reduce {
    wrap pending_next = reg_pending - 1
    wrap cur_reg_next = cur_reg + 1
  } else {
    // tensorstore: step a column; when the row is done reload the columns and step the row
    // (saturating at zero)
    wrap pending_next#[0..<3] = reg_pending#[0..<3] - 1
    wrap cur_reg_next = cur_reg + reduce_op + 1
    if pending_next#[0..<3] == 0 {
      wrap pending_next#[0..<3] = cols_per_row#[1] + 1
      wrap pending_next#[3..<7] = reg_pending#[3..<7] - 1
      if reg_pending#[3..<7] == 0 {
        pending_next = 0
      }
    }
  }
  if new_req and reduce_start != 0 {
    pending_next = reduce_num_regs
    cur_reg_next = start_reg_field
  } elif new_req and tensorstore_start != 0 {
    wrap pending_next#[0..<3] = store_cols#[1] + 1
    pending_next#[3..<7] = store_rows
    cur_reg_next = start_reg_field
  }

  // The counter and current register move on a new request, on every send/exec
  // while active, and are cleared by the dcache "nothing" action.
  const reg_up = new_req or (send_reg and enabled_int) or (exec_op and enabled_int) or nothing
  if nothing {
    pending_next = 0
  }
  if reg_up {
    reg_pending = pending_next
    cur_reg = cur_reg_next
  }
  const cur_reg_now = if reg_up { cur_reg_next } else { cur_reg }

  if is_enabled {
    wrap exec_op_cd = if exec_op { ExecCooldown } elif exec_op_cd == 0 { 0 } else { exec_op_cd - 1 }
  }
  if new_req {
    reduce_op = if tensorstore_start != 0 { store_src_inc } else { reduce_op_field }
    is_reduce = reduce_start != 0
    cols_per_row = store_cols
  }
  send_reg = dcache_reduce_ctrl.send_reg != 0
  exec_op_s0 = dcache_reduce_ctrl.exec_op != 0
  exec_op = exec_op_s0

  // ---- sticky "pending writer" bits: wait for earlier VPU RF writers to finish
  if new_req or is_enabled {
    if new_req and pending_next != 0 {
      scoreboard_pend_sticky = scoreboard_pend != 0
      tfma_pend_sticky = tensorfma_pend != 0 or tensorfma_start != 0
      tquant_pend_sticky = tensorquant_pend != 0 or tensorquant_start != 0
    } else {
      if is_enabled and scoreboard_pend_sticky and scoreboard_pend == 0 {
        scoreboard_pend_sticky = false
      }
      if (is_enabled and tfma_pend_sticky and tensorfma_pend == 0) or tensorfma_start != 0 {
        tfma_pend_sticky = false
      }
      if (is_enabled and tquant_pend_sticky and tensorquant_pend == 0) or tensorquant_start != 0 {
        tquant_pend_sticky = false
      }
    }
  }

  // ---- instruction injected into the VPU pipeline
  // A send turns into a store of the current register (to ship it to the dcache);
  // an exec turns into the reduce op on the current register.
  mut opcode = FSW_PS
  if exec_op_s0 {
    if reduce_op == OpFaddPs {
      opcode = FADD_PS_DYN
    } elif reduce_op == OpFmaxPs {
      opcode = FMAX_PS
    } elif reduce_op == OpFminPs {
      opcode = FMIN_PS
    } elif reduce_op == OpFaddPi {
      opcode = FADD_PI
    } elif reduce_op == OpFmaxPi {
      opcode = FMAX_PI
    } elif reduce_op == OpFminPi {
      opcode = FMIN_PI
    } elif reduce_op == OpCmov {
      opcode = FCMOVM_PS
    }
  }
  mut inst:U32 = opcode
  inst#[7..<12] = cur_reg_now // rd (don't care for the store)
  inst#[15..<20] = cur_reg_now // rs1
  inst#[20..<25] = cur_reg_now // rs2 (the store data)

  enabled = U1(is_enabled)
  reduce_wait = U1(scoreboard_pend_sticky or tfma_pend_sticky or tquant_pend_sticky)
  reduce_inst_en_next = U1((dcache_reduce_ctrl.send_reg != 0 or (exec_op_s0 and reduce_op != OpCmov)) and enabled_int)
  reduce_inst_next = inst
  // A receiver exec op writes the current register without broadcast; reduce runs on thread 0 only.
  load_ctrl.wen = U1(exec_op)
  load_ctrl.thread_id = 0
  load_ctrl.broadcast_sel = 0
  load_ctrl.waddr = cur_reg
  vpu_tensorreduce_debug = (U1(tquant_pend_sticky), U1(tfma_pend_sticky), U1(scoreboard_pend_sticky), cols_per_row, U1(is_reduce), reduce_op, cur_reg, exec_op_cd, reg_pending)#[..]
}
