// Lookup ROM of the log function for the transcendental unit (trans_top), coefficient set c1c2: one packed entry per index_i[5:0].
// Each 58-bit entry packs {exc:1, mask:7, taylor:1, c2:17, c0:32} from the MSB down.
comptime const TABLE:[64]U58 = [0x5e400d1d64000, 0x5d300d2c84000, 0x5c400d3b1c000, 0x5b500d4938000, 0x5a700d56e0000, 0x59980d6414000, 0x58c80d70d8000, 0x57f80d7d3c000, 0x57380d8938000, 0x56800d94d4000, 0x55d00da018000, 0x55300dab00000, 0x54980db598000, 0x53f80dbfe0000, 0x53700dc9d8000, 0x52d80dd390000, 0x52500ddcfc000, 0x51c80de624000, 0x51580def08000, 0x50e00df7b0000, 0x50700e001c000, 0x4ff80e0850000, 0x4f900e104c000, 0x4f200e1814000, 0x4ec00e1fa4000, 0x4e680e2704000, 0x4e000e2e38000, 0x4db00e3538000, 0x4d580e3c0c000, 0x4d000e42b8000, 0x4cb00e4938000, 0x4c600e4f94000, 0x4e780de47c000, 0x4e300debb4000, 0x4dd00df2c8000, 0x4d780df9b4000, 0x4d300e0074000, 0x4cf80e070c000, 0x4cb00e0d84000, 0x4c680e13d8000, 0x4c200e1a08000, 0x4bd80e2018000, 0x4b980e2608000, 0x4b680e2bd4000, 0x4b280e3184000, 0x4ae80e3718000, 0x4aa80e3c90000, 0x4a800e41e4000, 0x4a480e4724000, 0x4a100e4c48000, 0x49e00e5150000, 0x49b80e5640000, 0x49800e5b1c000, 0x49500e5fdc000, 0x49280e6484000, 0x48f80e6918000, 0x48d80e6d94000, 0x48a80e71fc000, 0x48800e7650000, 0x48600e7a8c000, 0x48300e7ebc000, 0x48080e82d4000, 0x47e80e86d8000, 0x47c00e8acc000]

pub comb trans_log_rom_case_c1c2(index_i:U8) -> (data_o:(exc:U1, mask:U7, taylor:U1, c2:U17, c0:U32)) {
  const entry:U58 = TABLE[index_i#[0..<6]]
  data_o.exc = entry#[57]
  data_o.mask = entry#[50..<57]
  data_o.taylor = entry#[49]
  data_o.c2 = entry#[32..<49]
  data_o.c0 = entry#[0..<32]
}
