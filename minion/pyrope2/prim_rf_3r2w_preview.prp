// 3R2W register file with previewed writes (see prim_rf_1r1w_preview): each of
// the two write ports has its own latched enable and negative-edge data
// register. Port a is written after port b, so a wins when both hit one entry.
pub mod prim_rf_3r2w_preview<Width=32, Entries=64>::[timecheck=false](preview_clk_i:Clock, rf_clk_i:Clock, rd_addr_a_i:Unsigned(bits=std.clog2(Entries)), rd_addr_b_i:Unsigned(bits=std.clog2(Entries)), rd_addr_c_i:Unsigned(bits=std.clog2(Entries)), wr_en_a_i:U1, wr_addr_a_i:Unsigned(bits=std.clog2(Entries)), wr_data_a_en_1p_next_i:U1, wr_data_a_i:Unsigned(bits=Width), wr_en_b_i:U1, wr_addr_b_i:Unsigned(bits=std.clog2(Entries)), wr_data_b_en_1p_next_i:U1, wr_data_b_i:Unsigned(bits=Width)) -> (rd_data_a_o:Unsigned(bits=Width)@[], rd_data_b_o:Unsigned(bits=Width)@[], rd_data_c_o:Unsigned(bits=Width)@[]) {
  reg rf_q:[Entries]Unsigned(bits=Width):[__store_clock_pin=rf_clk_i, __store_posclk=true, ordering="old"]
  reg wr_data_a_del_q:Unsigned(bits=Width):[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_b_del_q:Unsigned(bits=Width):[clock_pin=rf_clk_i, posclk=false]
  reg wr_data_a_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  reg wr_data_b_en_1p_q:U1:[enable=preview_clk_i, enable_high=false, latch=true]
  wr_data_a_en_1p_q = wr_data_a_en_1p_next_i
  wr_data_b_en_1p_q = wr_data_b_en_1p_next_i
  if wr_data_a_en_1p_q != 0 {
    wr_data_a_del_q = wr_data_a_i
  }
  if wr_data_b_en_1p_q != 0 {
    wr_data_b_del_q = wr_data_b_i
  }
  if wr_en_b_i != 0 {
    rf_q[wr_addr_b_i] = wr_data_b_del_q
  }
  if wr_en_a_i != 0 {
    rf_q[wr_addr_a_i] = wr_data_a_del_q
  }
  rd_data_a_o = rf_q[rd_addr_a_i]
  rd_data_b_o = rf_q[rd_addr_b_i]
  rd_data_c_o = rf_q[rd_addr_c_i]
}
