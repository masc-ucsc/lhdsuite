const minion_pkg = import("minion_pkg")

// VPU instruction decoder: maps a 32-bit custom/FP instruction word to the VPU
// control signals (same table as the Verilog casex). Each row matches
// (inst & mask) == match and yields {legal, cmd, dtype, control flags}; the rows are
// mutually exclusive, anything unmatched is illegal (all signals 0, id_vpu_insn 0).
// FRSQ_PS and FSIN_PS are decoded only when EnableExtraTrans is set, which this
// decoder does not support (they stay illegal, like the default).
const pkg = minion_pkg

// entry layout: bit 45 legal, [44:38] cmd, then the control flags (bit 37 down to 0)
// in vpu_ctrl_sigs_t order, with the 4-bit dtype in [12:9]
comptime const LEGAL = 1 << 45
comptime const CMD_LSB = 38
comptime const DTYPE_LSB = 9
comptime const F_TXFMA = 1 << 37
comptime const F_SHSW = 1 << 36
comptime const F_ROM = 1 << 35
comptime const F_SCATTER = 1 << 34
comptime const F_CVT = 1 << 33
comptime const F_TRANS = 1 << 32
comptime const F_GCVT = 1 << 31
comptime const F_FROMINTF = 1 << 30
comptime const F_TOINTM = 1 << 29
comptime const F_TOINTF = 1 << 28
comptime const F_MASKOP = 1 << 27
comptime const F_LDST = 1 << 26
comptime const F_M0REN = 1 << 25
comptime const F_MALLREN = 1 << 24
comptime const F_MREN1 = 1 << 23
comptime const F_MREN2 = 1 << 22
comptime const F_WEN = 1 << 21
comptime const F_REN1 = 1 << 20
comptime const F_REN2 = 1 << 19
comptime const F_REN3 = 1 << 18
comptime const F_REND = 1 << 17
comptime const F_SWAP12 = 1 << 16
comptime const F_SWAP23 = 1 << 15
comptime const F_SWAP13 = 1 << 14
comptime const F_VECTOR = 1 << 13
comptime const F_FROMINT = 1 << 8
comptime const F_TOINT = 1 << 7
comptime const F_FMA = 1 << 6
comptime const F_FMS = 1 << 5
comptime const F_ADD = 1 << 4
comptime const F_SUB = 1 << 3
comptime const F_MUL = 1 << 2
comptime const F_ROUND = 1 << 1
comptime const F_WFLAGS = 1 << 0

comb vpu_row(cmd:U7, dtype:U4, flags:U46) -> (r:U46) {
  r = LEGAL | (cmd << CMD_LSB) | (dtype << DTYPE_LSB) | flags
}

pub comb vpu_decoder<EnableExtraTrans=0>::[timecheck=false](id_inst:U32) -> (id_sigs:(cmd:U7, txfma:U1, shsw:U1, rom:U1, scatter:U1, cvt:U1, trans:U1, gcvt:U1, fromintf:U1, tointm:U1, tointf:U1, maskop:U1, ldst:U1, m0ren:U1, mallren:U1, mren1:U1, mren2:U1, wen:U1, ren1:U1, ren2:U1, ren3:U1, rend:U1, swap12:U1, swap23:U1, swap13:U1, vector:U1, dtype:U4, fromint:U1, toint:U1, fma:U1, fms:U1, add:U1, sub:U1, mul:U1, round:U1, wflags:U1), id_vpu_insn:U1) {
  cassert(EnableExtraTrans == 0, "FRSQ_PS/FSIN_PS (EnableExtraTrans) are not supported")
  mut entry:U46 = 0

  // FP Single
  if (id_inst & 0x707f) == 0x2007 { // FLW
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_WEN)
  }
  if (id_inst & 0x707f) == 0x2027 { // FSW
    entry = vpu_row(cmd=pkg.VpuCmdMvsFx, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_LDST | F_REN1 | F_REN2 | F_SWAP12)
  }
  if (id_inst & 0xfff0707f) == 0xf0000053 { // FMV_S_X
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_WEN | F_FROMINT | F_ROUND)
  }
  if (id_inst & 0xfff0007f) == 0xd0000053 { // FCVT_S_W
    entry = vpu_row(cmd=pkg.VpuCmdCvtF32int, dtype=pkg.VpuDtypeInt, flags=F_TXFMA | F_CVT | F_WEN | F_SWAP13 | F_FROMINT | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfff0007f) == 0xd0100053 { // FCVT_S_WU
    entry = vpu_row(cmd=pkg.VpuCmdCvtF32uint, dtype=pkg.VpuDtypeInt, flags=F_TXFMA | F_CVT | F_WEN | F_SWAP13 | F_FROMINT | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfff0707f) == 0xe0000053 { // FMV_X_S
    entry = vpu_row(cmd=pkg.VpuCmdMvsFx, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_WEN | F_REN1 | F_TOINT | F_ROUND)
  }
  if (id_inst & 0xfff0707f) == 0xe0001053 { // FCLASS_S
    entry = vpu_row(cmd=pkg.VpuCmdClass, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_SWAP13 | F_TOINT)
  }
  if (id_inst & 0xfff0007f) == 0xc0000053 { // FCVT_W_S
    entry = vpu_row(cmd=pkg.VpuCmdCvtIntf32, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_CVT | F_WEN | F_REN1 | F_SWAP13 | F_TOINT | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfff0007f) == 0xc0100053 { // FCVT_WU_S
    entry = vpu_row(cmd=pkg.VpuCmdCvtUintf32, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_CVT | F_WEN | F_REN1 | F_SWAP13 | F_TOINT | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa0002053 { // FEQ_S
    entry = vpu_row(cmd=pkg.VpuCmdFeq, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_TOINT | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa0001053 { // FLT_S
    entry = vpu_row(cmd=pkg.VpuCmdFlt, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_TOINT | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa0000053 { // FLE_S
    entry = vpu_row(cmd=pkg.VpuCmdFle, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_TOINT | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0x20000053 { // FSGNJ_S
    entry = vpu_row(cmd=pkg.VpuCmdFsgnj, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_WEN | F_REN1 | F_REN2)
  }
  if (id_inst & 0xfe00707f) == 0x20001053 { // FSGNJN_S
    entry = vpu_row(cmd=pkg.VpuCmdFsgnjn, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_WEN | F_REN1 | F_REN2)
  }
  if (id_inst & 0xfe00707f) == 0x20002053 { // FSGNJX_S
    entry = vpu_row(cmd=pkg.VpuCmdFsgnjx, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_WEN | F_REN1 | F_REN2)
  }
  if (id_inst & 0xfe00707f) == 0x28000053 { // FMIN_S
    entry = vpu_row(cmd=pkg.VpuCmdMin, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0x28001053 { // FMAX_S
    entry = vpu_row(cmd=pkg.VpuCmdMax, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_WFLAGS)
  }
  if (id_inst & 0xfe00007f) == 0x53 { // FADD_S
    entry = vpu_row(cmd=pkg.VpuCmdAdd, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_ADD | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfe00007f) == 0x8000053 { // FSUB_S
    entry = vpu_row(cmd=pkg.VpuCmdSub, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_SUB | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfe00007f) == 0x10000053 { // FMUL_S
    entry = vpu_row(cmd=pkg.VpuCmdMul, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_MUL | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x43 { // FMADD_S
    entry = vpu_row(cmd=pkg.VpuCmdMadd, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_FMA | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x47 { // FMSUB_S
    entry = vpu_row(cmd=pkg.VpuCmdMsub, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_FMS | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x4f { // FNMADD_S
    entry = vpu_row(cmd=pkg.VpuCmdNmadd, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_FMA | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x4b { // FNMSUB_S
    entry = vpu_row(cmd=pkg.VpuCmdNmsub, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_FMS | F_ROUND | F_WFLAGS)
  }

  // Moscow
  if (id_inst & 0x707f) == 0x5007 { // FLQ2
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_WEN | F_VECTOR)
  }
  if (id_inst & 0x707f) == 0x5027 { // FSQ2
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_REN2 | F_SWAP12 | F_VECTOR)
  }

  // Packed-Single: Load & Store
  if (id_inst & 0x707f) == 0x200b { // FLW_PS
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_VECTOR)
  }
  if (id_inst & 0x707f) == 0x600b { // FSW_PS
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_REN2 | F_SWAP12 | F_VECTOR)
  }

  // Packed-Single: Broadcast
  if (id_inst & 0x707f) == 0xb { // FBC_PS
    entry = vpu_row(cmd=pkg.VpuCmdFbc, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0x707f) == 0x300b { // FBCX_PS
    entry = vpu_row(cmd=pkg.VpuCmdFbc, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_M0REN | F_WEN | F_VECTOR | F_FROMINT)
  }
  if (id_inst & 0x7f) == 0x1f { // FBCI_PS
    entry = vpu_row(cmd=pkg.VpuCmdFbci, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_M0REN | F_WEN | F_VECTOR | F_WFLAGS)
  }

  // Packed-Single: Gather and Scatter
  if (id_inst & 0xfe00707f) == 0x6000100b { // FGW_PS
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_REN1 | F_SWAP12 | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0x5000100b { // FGH_PS
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_REN1 | F_SWAP12 | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0x4800100b { // FGB_PS
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_REN1 | F_SWAP12 | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0xe000100b { // FSCW_PS
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_SCATTER | F_LDST | F_M0REN | F_REN1 | F_REND | F_SWAP12 | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0xd000100b { // FSCH_PS
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_SCATTER | F_LDST | F_M0REN | F_REN1 | F_REND | F_SWAP12 | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0xc800100b { // FSCB_PS
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_SCATTER | F_LDST | F_M0REN | F_REN1 | F_REND | F_SWAP12 | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0x2000100b { // FG32W_PS
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0x1000100b { // FG32H_PS
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0x800100b { // FG32B_PS
    entry = vpu_row(cmd=pkg.VpuCmdX, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_WEN | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0xa000100b { // FSC32W_PS
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_REND | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0x9000100b { // FSC32H_PS
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_REND | F_VECTOR)
  }
  if (id_inst & 0xfe00707f) == 0x8800100b { // FSC32B_PS
    entry = vpu_row(cmd=pkg.VpuCmdMvXf, dtype=pkg.VpuDtypeF32, flags=F_LDST | F_M0REN | F_REND | F_VECTOR)
  }

  // Packed-Single: Computational
  if (id_inst & 0xfe00007f) == 0x7b { // FADD_PS
    entry = vpu_row(cmd=pkg.VpuCmdAdd, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_ADD | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfe00007f) == 0x800007b { // FSUB_PS
    entry = vpu_row(cmd=pkg.VpuCmdSub, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_SUB | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfe00007f) == 0x1000007b { // FMUL_PS
    entry = vpu_row(cmd=pkg.VpuCmdMul, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_VECTOR | F_MUL | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0x2800007b { // FMIN_PS
    entry = vpu_row(cmd=pkg.VpuCmdMin, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0x2800107b { // FMAX_PS
    entry = vpu_row(cmd=pkg.VpuCmdMax, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x5b { // FMADD_PS
    entry = vpu_row(cmd=pkg.VpuCmdMadd, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_VECTOR | F_FMA | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x200005b { // FMSUB_PS
    entry = vpu_row(cmd=pkg.VpuCmdMsub, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_VECTOR | F_FMS | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x400005b { // FNMSUB_PS
    entry = vpu_row(cmd=pkg.VpuCmdNmsub, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_VECTOR | F_FMS | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0x600007f) == 0x600005b { // FNMADD_PS
    entry = vpu_row(cmd=pkg.VpuCmdNmadd, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_REN3 | F_VECTOR | F_FMA | F_ROUND | F_WFLAGS)
  }

  // Packed-Single: Compare
  if (id_inst & 0xfe00707f) == 0xa000207b { // FEQ_PS
    entry = vpu_row(cmd=pkg.VpuCmdFeq, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_TOINTF | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa000607b { // FEQM_PS
    entry = vpu_row(cmd=pkg.VpuCmdFeq, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_TOINTM | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa000107b { // FLT_PS
    entry = vpu_row(cmd=pkg.VpuCmdFlt, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_TOINTF | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa000507b { // FLTM_PS
    entry = vpu_row(cmd=pkg.VpuCmdFlt, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_TOINTM | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa000007b { // FLE_PS
    entry = vpu_row(cmd=pkg.VpuCmdFle, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_TOINTF | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0xfe00707f) == 0xa000407b { // FLEM_PS
    entry = vpu_row(cmd=pkg.VpuCmdFle, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_TOINTM | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP23 | F_VECTOR | F_WFLAGS)
  }
  if (id_inst & 0xfff0707f) == 0xe000107b { // FCLASS_PS
    entry = vpu_row(cmd=pkg.VpuCmdClass, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_TOINTF | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_SWAP13 | F_VECTOR)
  }

  // Packed-Single: Conversion
  if (id_inst & 0xfff0007f) == 0xc000007b { // FCVT_PW_PS
    entry = vpu_row(cmd=pkg.VpuCmdCvtIntf32, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_CVT | F_TOINTF | F_M0REN | F_WEN | F_REN1 | F_SWAP13 | F_VECTOR | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfff0007f) == 0xc010007b { // FCVT_PWU_PS
    entry = vpu_row(cmd=pkg.VpuCmdCvtUintf32, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_CVT | F_TOINTF | F_M0REN | F_WEN | F_REN1 | F_SWAP13 | F_VECTOR | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfff0007f) == 0xd000007b { // FCVT_PS_PW
    entry = vpu_row(cmd=pkg.VpuCmdCvtF32int, dtype=pkg.VpuDtypeInt, flags=F_TXFMA | F_CVT | F_FROMINTF | F_M0REN | F_WEN | F_REN1 | F_SWAP13 | F_VECTOR | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfff0007f) == 0xd010007b { // FCVT_PS_PWU
    entry = vpu_row(cmd=pkg.VpuCmdCvtF32uint, dtype=pkg.VpuDtypeInt, flags=F_TXFMA | F_CVT | F_FROMINTF | F_M0REN | F_WEN | F_REN1 | F_SWAP13 | F_VECTOR | F_ROUND | F_WFLAGS)
  }
  if (id_inst & 0xfff0007f) == 0xd020007b { // FCVT_PS_RAST
    entry = vpu_row(cmd=pkg.VpuCmdCvtF32rast, dtype=pkg.VpuDtypeInt, flags=F_TXFMA | F_CVT | F_M0REN | F_WEN | F_REN1 | F_SWAP13 | F_VECTOR)
  }
  if (id_inst & 0xfff0007f) == 0xc020007b { // FCVT_RAST_PS
    entry = vpu_row(cmd=pkg.VpuCmdCvtRastf32, dtype=pkg.VpuDtypeF32, flags=F_TXFMA | F_CVT | F_M0REN | F_WEN | F_REN1 | F_SWAP13 | F_VECTOR)
  }

  // Packed-Single: Sign / Move
  if (id_inst & 0xfe00707f) == 0x2000007b { // FSGNJ_PS
    entry = vpu_row(cmd=pkg.VpuCmdFsgnj, dtype=pkg.VpuDtypeF32, flags=F_SHSW | F_FROMINTF | F_M0REN | F_WEN | F_REN1 | F_REN2 | F_VECTOR)
