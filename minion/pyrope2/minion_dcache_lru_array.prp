// Pseudo-LRU state of the data cache (verilog: minion_dcache_lru_array): one DcacheLruSetSize-bit
// word per set, synchronously reset to 0. The read is asynchronous and returns the committed value
// (a same-cycle write to the read set is not forwarded).
const minion_dcache_pkg = import("minion_dcache_pkg")

pub mod minion_dcache_lru_array::[timecheck=false](clk_i:Clock, read_set_i:minion_dcache_pkg.DcacheSetIdxWidth_T, rst_ni:U1, write_data_i:minion_dcache_pkg.DcacheLruSetSize_T, write_en_i:U1, write_set_i:minion_dcache_pkg.DcacheSetIdxWidth_T) -> (read_data_o:minion_dcache_pkg.DcacheLruSetSize_T@[]) {
  reg lru_state_q:[minion_dcache_pkg.DcacheSets]minion_dcache_pkg.DcacheLruSetSize_T:[clock_pin=clk_i, negreset=true, ordering="old", reset_pin=rst_ni] = 0

  for set in 0..<minion_dcache_pkg.DcacheSets {
    if write_en_i == 1 and write_set_i == set {
      lru_state_q[set] = write_data_i
    }
  }
  read_data_o = lru_state_q[read_set_i]
}
