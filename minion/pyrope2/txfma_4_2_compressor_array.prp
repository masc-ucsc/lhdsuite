const txfma_4_2_compressor = import("txfma_4_2_compressor.txfma_4_2_compressor")

comptime const WIDTH = 64

// 64-bit array (the only width the core uses) of 4:2 compressors (verilog: txfma_4_2_compressor_array). Bit i of
// x0..x3 compresses into bit i of the partial sum s_o and bit i of the carry vector c_o
// (weight of the NEXT column, so callers shift it left by one). cout_o ripples from each
// bit to the next bit's cin_i; the first cin is 0 and the last cout is dropped, as in the
// original array.
pub mod txfma_4_2_compressor_array::[timecheck=false](x0_i:Unsigned(bits=WIDTH), x1_i:Unsigned(bits=WIDTH), x2_i:Unsigned(bits=WIDTH), x3_i:Unsigned(bits=WIDTH)) -> (c_o:Unsigned(bits=WIDTH)@[0], s_o:Unsigned(bits=WIDTH)@[0]) {
  mut carry:U1 = 0
  for i in 0..<WIDTH {
    const unit = txfma_4_2_compressor(x0_i=x0_i#[i], x1_i=x1_i#[i], x2_i=x2_i#[i], x3_i=x3_i#[i], cin_i=carry)
    carry = unit.cout_o
    c_o#[i] = unit.c_o
    s_o#[i] = unit.s_o
  }
}
