  rrmux32_sel_f6a_h.e0 = U1(frac_op or cmd in (vpu_defs_pkg.VPU_FCMD_CVT_INTF32, vpu_defs_pkg.VPU_FCMD_CVT_UINTF32, vpu_defs_pkg.VPU_FCMD_MULL, vpu_defs_pkg.VPU_FCMD_MULLU, vpu_defs_pkg.VPU_FCMD_MULH, vpu_defs_pkg.VPU_FCMD_MULHU, vpu_defs_pkg.VPU_TRANS_LOG_RR, vpu_defs_pkg.VPU_FCMD_CVT_RASTF32, vpu_defs_pkg.VPU_FCMD_NR2_FRCPFXP) or (cmd == vpu_defs_pkg.VPU_TRANS_SIN_P2 and is_int) or (sigs_f6a_h.e16 != 0 and cmd != vpu_defs_pkg.VPU_TRANS_LOG_FMA2)) | sigs_f6a_h.e15
