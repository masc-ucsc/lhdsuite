// Lookup ROM of the exp function for the transcendental unit (trans_top), coefficient set c1c2: one packed entry per index_i[5:0].
// Each 58-bit entry packs {exc:1, mask:7, taylor:1, c2:17, c0:32} from the MSB down.
comptime const TABLE:[64]U58 = [0xcf74058b8c000, 0xcfa0059b04000, 0xcfd005aaa0000, 0xcffc05ba6c000, 0xd02805ca64000, 0xd05005da8c000, 0xd08005eadc000, 0xd0ac05fb5c000, 0xd0dc060c08000, 0xd108061ce4000, 0xd13c062dec000, 0xd168063f28000, 0xd19c065090000, 0xd1cc06622c000, 0xd1fc0673f8000, 0xd2300685f4000, 0xd260069824000, 0xd29806aa84000, 0xd2c806bd1c000, 0xd2fc06cfe4000, 0xd33406e2e0000, 0xd36806f614000, 0xd39c07097c000, 0xd3d8071d18000, 0xd4100730ec000, 0xd4480744f8000, 0xd48007593c000, 0xd4b8076db8000, 0xd4ec078270000, 0xd528079760000, 0xd56407ac88000, 0xd5a007c1ec000, 0xd5dc07d78c000, 0xd61407ed6c000, 0xd65c080380000, 0xd6940819d8000, 0xd6d808306c000, 0xd718084740000, 0xd758085e54000, 0xd7980875a8000, 0xd7d4088d40000, 0xd81808a518000, 0xd86408bd2c000, 0xd8a008d58c000, 0xd8e408ee2c000, 0xd92c090710000, 0xd97009203c000, 0xd9b80939ac000, 0xda00095364000, 0xda44096d64000, 0xda880987b0000, 0xdae409a238000, 0xdb2409bd18000, 0xdb7409d83c000, 0xdbc409f3ac000, 0xdc0c0a0f6c000, 0xdc580a2b78000, 0xdcac0a47d0000, 0xdcf40a647c000, 0xdd4c0a8170000, 0xdd9c0a9ebc000, 0xddf00abc54000, 0xde400ada44000, 0xde980af884000]

pub comb trans_exp_rom_case_c1c2(index_i:U8) -> (data_o:(exc:U1, mask:U7, taylor:U1, c2:U17, c0:U32)) {
  const entry:U58 = TABLE[index_i#[0..<6]]
  data_o.exc = entry#[57]
  data_o.mask = entry#[50..<57]
  data_o.taylor = entry#[49]
  data_o.c2 = entry#[32..<49]
  data_o.c0 = entry#[0..<32]
}
