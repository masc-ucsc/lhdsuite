// Radix-4 Booth partial product for the extra msb digit of an unsigned multiplier
// (verilog: txfma_booth_ppg_32r4_msb): the multiplicand itself when the multiplier's
// msb is set and the multiply is unsigned, otherwise nothing.
const minion_pkg = import("minion_pkg")

pub comb txfma_booth_ppg_32r4_msb(msb_i:U1, mulcand_i:minion_pkg.VpuDataSSz_T, sign_i:U1) -> (pp_o:U33) {
  pp_o = if sign_i == 0 and msb_i == 1 { mulcand_i } else { 0 }
}
