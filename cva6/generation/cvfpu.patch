diff --git a/src/fpnew_opgroup_block.sv b/src/fpnew_opgroup_block.sv
index e0aee28..356b201 100644
--- a/src/fpnew_opgroup_block.sv
+++ b/src/fpnew_opgroup_block.sv
@@ -75,6 +75,15 @@ module fpnew_opgroup_block #(
 
   // Handshake signals for the slices
   logic [NUM_FORMATS-1:0] fmt_in_ready, fmt_out_valid, fmt_out_ready, fmt_busy;
+  // The merged slice's own ready, on its own net. It used to drive
+  // `fmt_in_ready[FMT]` directly, and the `merged_unused` formats then did
+  // `assign fmt_in_ready[fmt] = fmt_in_ready[int'(FMT)];` -- one of the net's
+  // OWN writers reading it, and reading an element produced further down the
+  // file. Concurrent assigns make that legal, but a front end that linearizes
+  // them has no order to pick (LiveHD's --reader slang refuses it with
+  // `unsupported-driver-order`). Routing both through this net means no writer
+  // of `fmt_in_ready` reads `fmt_in_ready`.
+  logic                   merged_in_ready;
   logic [NUM_FORMATS-1:0] early_valid;
   output_t [NUM_FORMATS-1:0] fmt_outputs;
 
@@ -143,7 +152,7 @@ module fpnew_opgroup_block #(
 
       localparam FMT = fpnew_pkg::get_first_enabled_multi(FmtUnitTypes, FpFmtMask);
       // Ready is split up into formats
-      assign fmt_in_ready[fmt]  = fmt_in_ready[int'(FMT)];
+      assign fmt_in_ready[fmt]  = merged_in_ready;  // not fmt_in_ready[FMT]: see merged_in_ready
 
       assign fmt_out_valid[fmt] = 1'b0; // don't emit values
       assign fmt_busy[fmt]      = 1'b0; // never busy
@@ -204,7 +213,7 @@ module fpnew_opgroup_block #(
       .tag_i,
       .simd_mask_i      ( simd_mask_i              ),
       .in_valid_i       ( in_valid                 ),
-      .in_ready_o       ( fmt_in_ready[FMT]        ),
+      .in_ready_o       ( merged_in_ready          ),
       .flush_i,
       .result_o         ( fmt_outputs[FMT].result  ),
       .status_o         ( fmt_outputs[FMT].status  ),
@@ -217,6 +226,8 @@ module fpnew_opgroup_block #(
       .early_out_valid_o( early_valid[FMT]         )
     );
 
+    assign fmt_in_ready[FMT] = merged_in_ready;
+
   end
 
   // ------------------
