const popcount_p5 = import("popcount_p5.popcount_p5")

pub mod popcount_p4<INPUT_WIDTH=8>::[timecheck=false](data_i:u8) -> (popcount_o:u4@[]) {
  const padded_input__w1 = data_i
  mut non_leaf_node_left_child = popcount_p5::[name=non_leaf_node_left_child](data_i = padded_input__w1#[4..=7])
  mut non_leaf_node_right_child = popcount_p5::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..=3])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
