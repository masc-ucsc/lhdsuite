const popcount_p5 = import("popcount_p5.popcount_p5")

pub mod popcount_p4<INPUT_WIDTH=8>::[timecheck=false](data_i:U8) -> (popcount_o:U4@[]) {
  const padded_input__w1 = data_i#[0..<8]
  mut non_leaf_node_left_child = popcount_p5::[name=non_leaf_node_left_child](data_i = padded_input__w1#[4..<8])
  mut non_leaf_node_right_child = popcount_p5::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..<4])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
