const popcount_p5 = import("popcount_p5.popcount_p5")

pub mod popcount_p4::[timecheck=false](data_i:u8) -> (popcount_o:u4@[]) {
  const padded_input__w1 = data_i
  mut left_child = popcount_p5::[name=left_child](data_i = padded_input__w1#[4..=7])
  mut right_child = popcount_p5::[name=right_child](data_i = padded_input__w1#[0..=3])
  popcount_o = left_child + right_child
}
