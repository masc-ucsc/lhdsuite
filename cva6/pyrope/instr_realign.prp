pub mod instr_realign<>::[timecheck=false](clk_i:Clock, rst_ni:U1, flush_i:U1, valid_i:U1, address_i:U64, data_i:U32) -> (serving_unaligned_o:U1@[], valid_o:(e1:U1, e0:U1)@[], addr_o:U128@[], instr_o:U64@[]) {
  reg unaligned_instr_q:U16:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg unaligned_q:U1:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg unaligned_address_q:U64:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  wire `instr_is_compressed[0]`:U1 = nil
  wire `instr_is_compressed[1]`:U1 = nil
  mut unaligned_instr_d:U16 = 0
  mut unaligned_d:U1 = 0
  mut unaligned_address_d:U64 = 0
  wire `valid_o__bpr.e1`:U1 = nil
  mut `valid_o__bpo.e1` = 0
  wire `valid_o__bpr.e0`:U1 = nil
  mut `valid_o__bpo.e0` = 0
  unaligned_instr_d = 0sb?
  unaligned_d = 0ub?
  unaligned_address_d = 0sb?
  addr_o = 0sb?
  instr_o = 0sb?
  `instr_is_compressed[0]` = U1(data_i#[0..<2] != 3) & 1
  `instr_is_compressed[1]` = U1(data_i#[16..<18] != 3) & 1
  const serving_unaligned_o__w1 = unaligned_q
  `valid_o__bpo.e0` = valid_i
  mut _mux_3:U32 = if unaligned_q != 0 { (data_i#[0..<16] << 16) | unaligned_instr_q#[0..<16] } else { data_i#[0..<32] }
  mut instr_o__w1 = instr_o
  instr_o__w1#[0..<32] = _mux_3#[0..<32]
  mut _mux_4:U64 = if unaligned_q != 0 { unaligned_address_q#[0..<0x40] } else { address_i#[0..<0x40] }
  mut addr_o__w1 = addr_o
  addr_o__w1#[0..<0x40] = _mux_4#[0..<0x40]
  `valid_o__bpo.e1` = 0
  mut instr_o__w2 = instr_o__w1
  instr_o__w2#[32..<0x40] = 0
  mut addr_o__w2 = addr_o__w1
  addr_o__w2#[0x40..<0x80] = (address_i#[2..<0x40] << 2) | 2
  unaligned_instr_d = data_i#[16..<32]
  unaligned_d = unaligned_q
  instr_o = instr_o__w2
  unaligned_address_d = (address_i#[2..<0x40] << 2) | 2
  if ((`instr_is_compressed[0]` & 1) != 0) or (unaligned_q != 0) {
    if ((`instr_is_compressed[1]` & 1) != 0) and (CVA6Cfg#[0x4122..<0x4123] != 0) {
      unaligned_d = 0
      `valid_o__bpo.e1` = valid_i
      instr_o#[32..<0x40] = data_i#[16..<32]
    } else {
      unaligned_d = 1
      unaligned_instr_d = data_i#[16..<32]
      unaligned_address_d = (address_i#[2..<0x40] << 2) | 2
    }
  }
  if (valid_i != 0) and (address_i#[1..<2] != 0) {
    if (`instr_is_compressed[0]` & 1) == 0 {
      `valid_o__bpo.e1` = 0
      `valid_o__bpo.e0` = 0
      unaligned_d = 1
      unaligned_address_d = (address_i#[2..<0x40] << 2) | 2
      unaligned_instr_d = data_i#[0..<16]
    } else {
      `valid_o__bpo.e1` = 0
      `valid_o__bpo.e0` = 1
    }
  }
  if rst_ni != 0 {
    if valid_i != 0 {
      unaligned_address_q = unaligned_address_d
      unaligned_instr_q = unaligned_instr_d
    }
    if flush_i != 0 {
      unaligned_q = 0
    } elif valid_i != 0 {
      unaligned_q = unaligned_d
    }
  }
  const t56 = `valid_o__bpo.e1`
  `valid_o__bpr.e1` = t56
  valid_o.e1 = t56
  const t57 = `valid_o__bpo.e0`
  `valid_o__bpr.e0` = t57
  valid_o.e0 = t57
  serving_unaligned_o = serving_unaligned_o__w1
  addr_o = addr_o__w2
}
