pub comb lzc_p8::[timecheck=false](in_i:(e2:u1, e1:u1, e0:u1)) -> (cnt_o:u2, empty_o:u1) {
  mut gen_lzc_in_tmp:u3 = 0
  mut _mux_1:u1 = 0
  mut _mux_2:u1 = 0
  mut _mux_3:u1 = 0
  gen_lzc_in_tmp = 0sb?
  cnt_o = 0sb?
  _mux_1 = in_i.e0 & 1
  mut gen_lzc_in_tmp__w1 = gen_lzc_in_tmp
  gen_lzc_in_tmp__w1#[0] = _mux_1 & 1
  _mux_2 = in_i.e1 & 1
  mut gen_lzc_in_tmp__w2 = gen_lzc_in_tmp__w1
  gen_lzc_in_tmp__w2#[1] = _mux_2 & 1
  _mux_3 = in_i.e2 & 1
  mut gen_lzc_in_tmp__w3 = gen_lzc_in_tmp__w2
  gen_lzc_in_tmp__w3#[2] = _mux_3 & 1
  cnt_o = if ((gen_lzc_in_tmp__w3 >> 2) & 1) != 0 { 2 } else { 2 }
  if ((gen_lzc_in_tmp__w3 >> 1) & 1) != 0 {
    cnt_o = 1
  }
  if (gen_lzc_in_tmp__w3 & 1) != 0 {
    cnt_o = 0
  }
  empty_o = (~unsigned(gen_lzc_in_tmp__w3 != 0)) & 1
}
