pub comb stream_mux<N_INP=3, LOG_N_INP=2>::[timecheck=false](inp_data_i:U411, inp_valid_i:U3, inp_sel_i:U2, oup_ready_i:U1) -> (inp_ready_o:U3, oup_data_o:(data:U64, strb:U8, last:U1, user:U64), oup_valid_o:U1) {
  wire `oup_data_o__bpr.data`:U64 = nil
  wire `oup_data_o__bpr.strb`:U8 = nil
  wire `oup_data_o__bpr.last`:U1 = nil
  wire `oup_data_o__bpr.user`:U64 = nil
  mut inp_ready_o__w2 = 0
  inp_ready_o__w2#[inp_sel_i..<(inp_sel_i + 1)] = oup_ready_i & 1
  mut `oup_data_o__bpo.data` = ((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..<0x89]#[0x49..<0x89]
  mut `oup_data_o__bpo.strb` = ((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..<0x89]#[0x41..<0x49]
  mut `oup_data_o__bpo.last` = ((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..<0x89]#[0x40..<0x41]
  mut `oup_data_o__bpo.user` = ((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..<0x89]#[0..<0x40]
  const t20 = `oup_data_o__bpo.data`
  `oup_data_o__bpr.data` = t20
  oup_data_o.data = t20
  const t21 = `oup_data_o__bpo.strb`
  `oup_data_o__bpr.strb` = t21
  oup_data_o.strb = t21
  const t22 = `oup_data_o__bpo.last`
  `oup_data_o__bpr.last` = t22
  oup_data_o.last = t22
  const t23 = `oup_data_o__bpo.user`
  `oup_data_o__bpr.user` = t23
  oup_data_o.user = t23
  inp_ready_o = inp_ready_o__w2
  oup_valid_o = ((inp_valid_i << 1) >> (inp_sel_i + 1)) & 1
}
