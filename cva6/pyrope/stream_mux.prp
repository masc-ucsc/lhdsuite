pub comb stream_mux<N_INP=3, LOG_N_INP=2>::[timecheck=false](inp_data_i:u411, inp_valid_i:u3, inp_sel_i:u2, oup_ready_i:u1) -> (inp_ready_o:u3, oup_data_o:(data:u64, strb:u8, last:u1, user:u64), oup_valid_o:u1) {
  wire `oup_data_o__bpr.data`:u64
  wire `oup_data_o__bpr.strb`:u8
  wire `oup_data_o__bpr.last`:u1
  wire `oup_data_o__bpr.user`:u64
  mut `oup_data_o__bpo.data` = ((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..=136]#[73..=136]
  mut `oup_data_o__bpo.strb` = ((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..=136]#[65..=72]
  mut `oup_data_o__bpo.last` = (((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..=136] >> 0x40) & 1
  mut `oup_data_o__bpo.user` = ((inp_data_i << 0x89) >> ((inp_sel_i * 0x89) + 0x89))#[0..=136]#[0..=63]
  const t26 = `oup_data_o__bpo.data`
  `oup_data_o__bpr.data` = t26
  oup_data_o.data = t26
  const t27 = `oup_data_o__bpo.strb`
  `oup_data_o__bpr.strb` = t27
  oup_data_o.strb = t27
  const t28 = `oup_data_o__bpo.last`
  `oup_data_o__bpr.last` = t28
  oup_data_o.last = t28
  const t29 = `oup_data_o__bpo.user`
  `oup_data_o__bpr.user` = t29
  oup_data_o.user = t29
  inp_ready_o = ((0 & (~(1 << inp_sel_i))) | ((oup_ready_i & 1) << inp_sel_i))#[0..=2]
  oup_valid_o = ((inp_valid_i << 1) >> (inp_sel_i + 1)) & 1
}
