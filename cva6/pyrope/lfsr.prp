pub mod lfsr<LfsrWidth=8, OutWidth=1, RstVal=255, CipherLayers=0, CipherReg=1>::[timecheck=false](clk_i:Clock, rst_ni:U1, en_i:U1) -> (out_o:U1@[]) {
  reg lfsr_q:U8:[initial=255, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  mut _rep_1:U8 = if (lfsr_q & 1) != 0 { 0xff } else { 0 }
  mut _mux_2:U8 = if en_i != 0 { ((lfsr_q >> 1) ^ (_rep_1 & 0xfa)#[0..<8])#[0..<8] } else { lfsr_q#[0..<8] }
  if rst_ni != 0 {
    lfsr_q = _mux_2
  }
  out_o = lfsr_q & 1
}
