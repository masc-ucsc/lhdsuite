pub mod lfsr::[timecheck=false](clk_i:u1, rst_ni:u1, en_i:u1) -> (out_o:u1@[]) {
  reg lfsr_q:u8:[init=255, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  mut _rep_1:u8 = if (lfsr_q & 1) != 0 { 0xff } else { 0 }
  mut _mux_2:u8 = if en_i != 0 { ((lfsr_q >> 1) ^ (_rep_1 & 0xfa))#[0..=7] } else { lfsr_q }
  if rst_ni != 0 {
    lfsr_q = _mux_2
  }
  out_o = lfsr_q & 1
}
