const riscv = import("riscv")

pub comb instr_scan<>::[timecheck=false](instr_i:U32) -> (rvi_return_o:U1, rvi_call_o:U1, rvi_branch_o:U1, rvi_jalr_o:U1, rvi_jump_o:U1, rvi_imm_o:U64, rvc_branch_o:U1, rvc_jump_o:U1, rvc_jr_o:U1, rvc_return_o:U1, rvc_jalr_o:U1, rvc_call_o:U1, rvc_imm_o:U64) {
  const rv32_rvc_jal__w1 = CVA6Cfg#[0x42f3..<0x42f4] & U1(instr_i#[13..<16] == riscv.OpcodeC1Jal) & U1(instr_i#[0..<2] == riscv.OpcodeC1) & 1 & 1
  const is_xret__w1 = U1(instr_i#[30..<32] == 0) & U1(instr_i#[0..<29] == 0x10200073) & 1
  const instruction_i__w1 = instr_i
  mut _rep_6:U44 = if instruction_i__w1#[31..<32] != 0 { 0xfffffffffff } else { 0 }
  const instruction_i_s1__w1 = instr_i
  mut _mux_8:U64 = if instr_i#[3..<4] != 0 { ((_rep_6#[0..<44] << 20) | (instruction_i__w1#[12..<20] << 12) | (instruction_i__w1#[20..<21] << 11) | (instruction_i__w1#[21..<31] << 1))#[0..<0x40] } else { ((instruction_i_s1__w1#[31..<32] << 12) | (instruction_i_s1__w1#[7..<8] << 11) | (instruction_i_s1__w1#[25..<31] << 5) | (instruction_i_s1__w1#[8..<12] << 1))#sext[0..=12]#[0..<0x40]#[0..<0x40] }
  mut _mux_9:U64 = if is_xret__w1 != 0 { 0 } else { _mux_8#[0..<0x40] }
  const rvi_jalr_o__w1 = U1(instr_i#[0..<7] == riscv.OpcodeJalr)
  const rvi_jump_o__w1 = (U1(instr_i#[0..<7] == riscv.OpcodeJal) | is_xret__w1) & 1
  const is_jal_r__w1 = U1(instr_i#[13..<16] == riscv.OpcodeC2JalrMvAdd) & U1(instr_i#[7..<12] != 0) & 1 & U1(instr_i#[2..<7] == 0) & 1 & U1(instr_i#[0..<2] == riscv.OpcodeC2) & 1
  const rvc_jr_o__w1 = is_jal_r__w1 & (~instr_i#[12..<13]) & 1
  const rvc_jalr_o__w1 = is_jal_r__w1 & instr_i#[12..<13] & 1
  mut _rep_24:U56 = if instr_i#[12..<13] != 0 { 0xffffffffffffff } else { 0 }
  mut _rep_25:U53 = if instr_i#[12..<13] != 0 { 0x1fffffffffffff } else { 0 }
  mut _mux_26:U64 = if instr_i#[14..<15] != 0 { (_rep_24#[0..<56] << 8) | (instr_i#[5..<7] << 6) | (instr_i#[2..<3] << 5) | (instr_i#[10..<12] << 3) | (instr_i#[3..<5] << 1) } else { (_rep_25#[0..<53] << 11) | (instr_i#[8..<9] << 10) | (instr_i#[9..<11] << 8) | (instr_i#[6..<7] << 7) | (instr_i#[7..<8] << 6) | (instr_i#[2..<3] << 5) | (instr_i#[11..<12] << 4) | (instr_i#[3..<6] << 1) }
  rvi_return_o = rvi_jalr_o__w1 & (U1(instr_i#[15..<20] == 1) | U1(instr_i#[15..<20] == 5)) & 1 & 1 & U1(instr_i#[15..<20] != instr_i#[7..<12]) & 1
  rvi_call_o = (rvi_jalr_o__w1 | rvi_jump_o__w1) & 1 & (U1(instr_i#[7..<12] == 1) | U1(instr_i#[7..<12] == 5)) & 1 & 1
  rvi_branch_o = U1(instr_i#[0..<7] == riscv.OpcodeBranch)
  rvi_jalr_o = rvi_jalr_o__w1
  rvi_jump_o = rvi_jump_o__w1
  rvi_imm_o = _mux_9
  rvc_branch_o = (U1(instr_i#[13..<16] == riscv.OpcodeC1Beqz) | U1(instr_i#[13..<16] == riscv.OpcodeC1Bnez)) & 1 & U1(instr_i#[0..<2] == riscv.OpcodeC1) & 1
  rvc_jump_o = ((U1(instr_i#[13..<16] == riscv.OpcodeC1J) & U1(instr_i#[0..<2] == riscv.OpcodeC1) & 1) | rv32_rvc_jal__w1) & 1
  rvc_jr_o = rvc_jr_o__w1
  rvc_return_o = (U1(instr_i#[7..<12] == 1) | U1(instr_i#[7..<12] == 5)) & 1 & rvc_jr_o__w1 & 1
  rvc_jalr_o = rvc_jalr_o__w1
  rvc_call_o = (rvc_jalr_o__w1 | rv32_rvc_jal__w1) & 1
  rvc_imm_o = _mux_26
}
