    `commit_queue_q.wait_rvalid`[2] = (commit_queue_n >> 0x118) & 1
    `commit_queue_q.address`[3] = commit_queue_n#[504..=559]
    `commit_queue_q.data`[3] = commit_queue_n#[440..=503]
    `commit_queue_q.be`[3] = commit_queue_n#[432..=439]
    `commit_queue_q.data_size`[3] = commit_queue_n#[430..=431]
    `commit_queue_q.cbo_op`[3] = commit_queue_n#[422..=429]
    `commit_queue_q.valid`[3] = (commit_queue_n >> 0x1a5) & 1
    `commit_queue_q.wait_rvalid`[3] = (commit_queue_n >> 0x1a4) & 1
    commit_read_pointer_q = commit_read_pointer_n
    commit_write_pointer_q = commit_write_pointer_n
    commit_status_cnt_q = commit_status_cnt
  }
  req_port_o.address_index = `req_port_o__bpo.address_index`
  req_port_o.address_tag = `req_port_o__bpo.address_tag`
  req_port_o.data_wdata = `req_port_o__bpo.data_wdata`
  req_port_o.data_wuser = 0
  req_port_o.data_req = `req_port_o__bpo.data_req`
  req_port_o.data_we = 1
  req_port_o.data_be = `req_port_o__bpo.data_be`
  req_port_o.data_size = `req_port_o__bpo.data_size`
  req_port_o.data_id = 0
  req_port_o.kill_req = 0
  req_port_o.tag_valid = 0
  req_port_o.cbo_op = `req_port_o__bpo.cbo_op`
  no_st_pending_o = no_st_pending_o__w1
  store_buffer_empty_o = unsigned(speculative_status_cnt_q == 0) & no_st_pending_o__w1 & 1
  commit_ready_o = unsigned(commit_status_cnt_q < ariane_pkg.DEPTH_COMMIT)
  ready_o = unsigned((speculative_status_cnt_n < ariane_pkg.DEPTH_SPEC) or (commit_i != 0))
  rvfi_mem_paddr_o = rvfi_mem_paddr_o__w1
}
