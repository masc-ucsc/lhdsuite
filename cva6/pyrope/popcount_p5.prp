const popcount = import("popcount.popcount")

pub mod popcount_p5<INPUT_WIDTH=4>::[timecheck=false](data_i:u4) -> (popcount_o:u3@[]) {
  const padded_input__w1 = data_i
  mut non_leaf_node_left_child = popcount::[name=non_leaf_node_left_child](data_i = padded_input__w1#[2..=3])
  mut non_leaf_node_right_child = popcount::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..=1])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
