const popcount = import("popcount.popcount")

pub mod popcount_p5<INPUT_WIDTH=4>::[timecheck=false](data_i:U4) -> (popcount_o:U3@[]) {
  const padded_input__w1 = data_i#[0..<4]
  mut non_leaf_node_left_child = popcount::[name=non_leaf_node_left_child](data_i = padded_input__w1#[2..<4])
  mut non_leaf_node_right_child = popcount::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..<2])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
