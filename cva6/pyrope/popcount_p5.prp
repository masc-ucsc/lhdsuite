const popcount = import("popcount.popcount")

pub mod popcount_p5::[timecheck=false](data_i:u4) -> (popcount_o:u3@[]) {
  const padded_input__w1 = data_i
  mut left_child = popcount::[name=left_child](data_i = padded_input__w1#[2..=3])
  mut right_child = popcount::[name=right_child](data_i = padded_input__w1#[0..=1])
  popcount_o = left_child + right_child
}
