pub mod ras<, DEPTH=2>::[timecheck=false](clk_i:Clock, rst_ni:U1, flush_bp_i:U1, push_i:U1, pop_i:U1, data_i:U64) -> (data_o:(valid:U1, ra:U64)@[]) {
  reg stack_q:[2]U65:[ordering="old", initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  mut stack_d:U130 = 0
  wire `data_o__bpr.valid`:U1 = nil
  wire `data_o__bpr.ra`:U64 = nil
  stack_d = 0sb?
  mut `data_o__bpo.valid` = stack_q[0]#[0x40..<0x41]
  mut `data_o__bpo.ra` = stack_q[0]#[0..<0x40]
  stack_d = stack_q#[0..<0x82]
  if push_i != 0 {
    stack_d#[0..<0x40] = data_i#[0..<0x40]
    stack_d#[0x40..<0x41] = 1
    stack_d#[0x41..<0x82] = stack_q#[0..<0x82]#[0..<0x41]
  }
  if pop_i != 0 {
    stack_d#[0..<0x41] = stack_q#[0..<0x82]#[0x41..<0x82]
    stack_d#[0x81..<0x82] = 0
    stack_d#[0x41..<0x81] = 0
  }
  if (pop_i != 0) and (push_i != 0) {
    stack_d = stack_q#[0..<0x82]
    stack_d#[0..<0x40] = data_i#[0..<0x40]
    stack_d#[0x40..<0x41] = 1
  }
  if flush_bp_i != 0 {
    stack_d = 0
  }
  if rst_ni != 0 {
    stack_q#[0..<0x82] = stack_d
  }
  const t21 = `data_o__bpo.valid`
  `data_o__bpr.valid` = t21
  data_o.valid = t21
  const t22 = `data_o__bpo.ra`
  `data_o__bpr.ra` = t22
  data_o.ra = t22
