  mut `x_exception_o__bpo.tinst` = 0
  mut `x_exception_o__bpo.gva` = 0
  mut `x_exception_o__bpo.timing` = 0
  mut _mux_2:u3 = if x_illegal_i != 0 { x_trans_id_i } else { result_i.id#[0..=2] }
  mut `x_exception_o__bpo.valid` = x_illegal_i
  mut _mux_3:u64 = if x_illegal_i != 0 { riscv.ILLEGAL_INSTR#[0..=63] } else { 0 }
  mut `x_exception_o__bpo.cause` = _mux_3
  {
    `x_exception_o__bpo.tval` = x_off_instr_i
  }
  x_exception_o.cause = `x_exception_o__bpo.cause`
  x_exception_o.tval = `x_exception_o__bpo.tval`
  x_exception_o.tval2 = 0
