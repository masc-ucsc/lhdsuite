const riscv = import("riscv")

pub comb cvxif_fu::[timecheck=false](clk_i:u1, rst_ni:u1, v_i:u1, x_valid_i:u1, x_trans_id_i:u3, x_illegal_i:u1, x_off_instr_i:u32, result_valid_i:u1, result_i:(hartid:u64, id:u3, data:u64, rd:u5, we:u1)) -> (x_ready_o:u1, x_trans_id_o:u3, x_exception_o:(cause:u64, tval:u64, tval2:u41, tinst:u32, gva:u1, valid:u1, timing:u1), x_result_o:u64, x_valid_o:u1, x_we_o:u1, x_rd_o:u5, result_ready_o:u1) {
  mut `x_exception_o__bpo.tval` = 0
