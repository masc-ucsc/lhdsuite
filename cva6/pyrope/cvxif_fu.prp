  x_exception_o.gva = 0
  x_exception_o.valid = `x_exception_o__bpo.valid`
  x_exception_o.timing = `x_exception_o__bpo.timing`
  x_ready_o = 1
  x_trans_id_o = _mux_2
  x_result_o = result_i.data
  x_valid_o = unsigned((x_illegal_i != 0) or (result_valid_i != 0))
  x_we_o = result_i.we
  x_rd_o = result_i.rd
  result_ready_o = 1
}
