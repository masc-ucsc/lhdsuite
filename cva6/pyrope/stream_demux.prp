pub comb stream_demux<N_OUP=3, LOG_N_OUP=2>::[timecheck=false](inp_valid_i:U1, oup_sel_i:U2, oup_ready_i:U3) -> (inp_ready_o:U1, oup_valid_o:U3) {
  mut oup_valid_o__w2 = 0
  oup_valid_o__w2#[oup_sel_i..<(oup_sel_i + 1)] = inp_valid_i & 1
  inp_ready_o = ((oup_ready_i << 1) >> (oup_sel_i + 1)) & 1
  oup_valid_o = oup_valid_o__w2
}
