pub mod tc_sram<NumWords=0x100, DataWidth=64, ByteWidth=8, NumPorts=1, Latency=1, SimInit=0x6e6f6e65, PrintSimCfg=0, ImplKey=0x6e6f6e65, AddrWidth=8, BeWidth=8>::[timecheck=false](clk_i:Clock, rst_ni:U1, req_i:U1, we_i:U1, addr_i:U8, wdata_i:U64, be_i:U8) -> (rdata_o:U64@[]) {
  reg sram:[256]U64:[ordering="old", __store_clock_pin=clk_i, __store_posclk=true, wensize=8]
  reg r_addr_q:U8:[clock_pin=clk_i]
  reg rdata_q:U64:[clock_pin=clk_i]
  mut rdata_d:U64 = 0
  rdata_d = 0sb?
  rdata_o = 0sb?
  mut rdata_o__w1 = rdata_o
  rdata_o__w1#[0..<0x40] = rdata_q#[0..<0x40]
  mut _mux_1:U64 = if ((req_i & 1) != 0) and ((we_i & 1) == 0) { sram[addr_i#[0..<8]] } else { sram[r_addr_q#[0..<8]] }
  mut rdata_d__w1 = rdata_d
  rdata_d__w1#[0..<0x40] = _mux_1#[0..<0x40]
  if rst_ni == 0 {
    r_addr_q#[0..<8] = 0
  } else {
    rdata_q#[0..<0x40] = rdata_d__w1#[0..<0x40]
    if (req_i & 1) != 0 {
      if (we_i & 1) != 0 {
        if (be_i#[0..<8] & 1) != 0 {
          sram[addr_i#[0..<8]]#[0..=7] = (wdata_i#[0..<0x40] >> (0 * ByteWidth)#[0..<32])#[0..<8]#[0..=7]
        }
        if be_i#[0..<8]#[1..<2] != 0 {
          sram[addr_i#[0..<8]]#[8..=15] = ((wdata_i#[0..<0x40] >> ByteWidth#[0..<32])#[0..<8] << 8)#[8..=15]
        }
        if be_i#[0..<8]#[2..<3] != 0 {
          sram[addr_i#[0..<8]]#[16..=23] = ((wdata_i#[0..<0x40] >> (2 * ByteWidth)#[0..<32])#[0..<8] << 16)#[16..=23]
        }
        if be_i#[0..<8]#[3..<4] != 0 {
          sram[addr_i#[0..<8]]#[24..=31] = ((wdata_i#[0..<0x40] >> (3 * ByteWidth)#[0..<32])#[0..<8] << 24)#[24..=31]
        }
        if be_i#[0..<8]#[4..<5] != 0 {
          sram[addr_i#[0..<8]]#[32..=39] = ((wdata_i#[0..<0x40] >> (4 * ByteWidth)#[0..<32])#[0..<8] << 32)#[32..=39]
        }
        if be_i#[0..<8]#[5..<6] != 0 {
          sram[addr_i#[0..<8]]#[40..=47] = ((wdata_i#[0..<0x40] >> (5 * ByteWidth)#[0..<32])#[0..<8] << 40)#[40..=47]
        }
        if be_i#[0..<8]#[6..<7] != 0 {
          sram[addr_i#[0..<8]]#[48..=55] = ((wdata_i#[0..<0x40] >> (6 * ByteWidth)#[0..<32])#[0..<8] << 48)#[48..=55]
        }
        if be_i#[0..<8]#[7..<8] != 0 {
          sram[addr_i#[0..<8]]#[56..=63] = ((wdata_i#[0..<0x40] >> (7 * ByteWidth)#[0..<32])#[0..<8] << 56)#[56..=63]
        }
      } else {
        r_addr_q#[0..<8] = addr_i#[0..<8]
      }
    }
  }
  rdata_o = rdata_o__w1
}
