pub mod tc_sram::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wdata_i:u64, be_i:u8) -> (rdata_o:u64@[]) {
  reg sram:[256]u64:[ordering="old", wensize=8, clock_pin=ref clk_i]
  reg r_addr_q:u8:[clock_pin=ref clk_i]
  reg rdata_q:[1]u64:[ordering="old", clock_pin=ref clk_i]
  mut rdata_d:u64 = 0
  rdata_d = 0sb?
  rdata_o = 0sb?
  mut rdata_o__w1 = rdata_o
  rdata_o__w1#[0..=63] = rdata_q[0]
  mut _mux_1:u64 = if ((req_i & 1) != 0) and ((we_i & 1) == 0) { sram[addr_i] } else { sram[r_addr_q] }
  mut rdata_d__w1 = rdata_d
  rdata_d__w1#[0..=63] = _mux_1
  if rst_ni == 0 {
    r_addr_q#[0..=7] = 0
  } else {
    {
      rdata_q[0][rdata_d__w1#[0..=63]] = 0
    }
    if (req_i & 1) != 0 {
      if (we_i & 1) != 0 {
        if (be_i & 1) != 0 {
          sram[addr_i][wdata_i#[0..=7]] = 0
        }
        if ((be_i >> 1) & 1) != 0 {
          sram[addr_i][wdata_i#[8..=15] << 8] = 1
        }
        if ((be_i >> 2) & 1) != 0 {
          sram[addr_i][wdata_i#[16..=23] << 16] = 2
        }
        if ((be_i >> 3) & 1) != 0 {
          sram[addr_i][wdata_i#[24..=31] << 24] = 3
        }
        if ((be_i >> 4) & 1) != 0 {
          sram[addr_i][wdata_i#[32..=39] << 32] = 4
        }
        if ((be_i >> 5) & 1) != 0 {
          sram[addr_i][wdata_i#[40..=47] << 40] = 5
        }
        if ((be_i >> 6) & 1) != 0 {
          sram[addr_i][wdata_i#[48..=55] << 48] = 6
        }
        if ((be_i >> 7) & 1) != 0 {
          sram[addr_i][wdata_i#[56..=63] << 56] = 7
        }
      } else {
        r_addr_q#[0..=7] = addr_i
      }
    }
  }
  rdata_o = rdata_o__w1
}
