pub mod tc_sram<NumWords=0x100, DataWidth=64, ByteWidth=8, NumPorts=1, Latency=1, SimInit=0x6e6f6e65, PrintSimCfg=0, ImplKey=0x6e6f6e65, AddrWidth=8, BeWidth=8>::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wdata_i:u64, be_i:u8) -> (rdata_o:u64@[]) {
  reg sram:[256]u64:[ordering="old", __store_clock_pin=ref clk_i, __store_posclk=true, wensize=8]
  reg r_addr_q:u8:[clock_pin=ref clk_i]
  reg rdata_q:u64:[clock_pin=ref clk_i]
  mut rdata_d:u64 = 0
  rdata_d = 0sb?
  rdata_o = 0sb?
  mut rdata_o__w1 = rdata_o
  rdata_o__w1#[0..=63] = rdata_q
  mut _mux_1:u64 = if ((req_i & 1) != 0) and ((we_i & 1) == 0) { sram[addr_i] } else { sram[r_addr_q] }
  mut rdata_d__w1 = rdata_d
  rdata_d__w1#[0..=63] = _mux_1
  if rst_ni == 0 {
    r_addr_q#[0..=7] = 0
  } else {
    rdata_q#[0..=63] = rdata_d__w1#[0..=63]
    if (req_i & 1) != 0 {
      if (we_i & 1) != 0 {
        if (be_i & 1) != 0 {
          sram[addr_i][(wdata_i >> (0 * ByteWidth)#[0..=31])#[0..=7]] = 0
        }
        if ((be_i >> 1) & 1) != 0 {
          sram[addr_i][(wdata_i >> ByteWidth)#[0..=7] << 8] = 1
        }
        if ((be_i >> 2) & 1) != 0 {
          sram[addr_i][(wdata_i >> (2 * ByteWidth)#[0..=31])#[0..=7] << 16] = 2
        }
        if ((be_i >> 3) & 1) != 0 {
          sram[addr_i][(wdata_i >> (3 * ByteWidth)#[0..=31])#[0..=7] << 24] = 3
        }
        if ((be_i >> 4) & 1) != 0 {
          sram[addr_i][(wdata_i >> (4 * ByteWidth)#[0..=31])#[0..=7] << 32] = 4
        }
        if ((be_i >> 5) & 1) != 0 {
          sram[addr_i][(wdata_i >> (5 * ByteWidth)#[0..=31])#[0..=7] << 40] = 5
        }
        if ((be_i >> 6) & 1) != 0 {
          sram[addr_i][(wdata_i >> (6 * ByteWidth)#[0..=31])#[0..=7] << 48] = 6
        }
        if ((be_i >> 7) & 1) != 0 {
          sram[addr_i][(wdata_i >> (7 * ByteWidth)#[0..=31])#[0..=7] << 56] = 7
        }
      } else {
        r_addr_q#[0..=7] = addr_i
      }
    }
  }
  rdata_o = rdata_o__w1
}
