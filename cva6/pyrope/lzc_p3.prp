pub comb lzc_p3<WIDTH=4, MODE=0, CNT_WIDTH=2>::[timecheck=false](in_i:(e3:U1, e2:U1, e1:U1, e0:U1)) -> (cnt_o:U2, empty_o:U1) {
  mut gen_lzc_in_tmp:U4 = 0
  gen_lzc_in_tmp = 0sb?
  cnt_o = 0sb?
  mut gen_lzc_in_tmp__w1 = gen_lzc_in_tmp
  gen_lzc_in_tmp__w1#[0..<1] = in_i.e0 & 1
  mut gen_lzc_in_tmp__w2 = gen_lzc_in_tmp__w1
  gen_lzc_in_tmp__w2#[1..<2] = in_i.e1 & 1
  mut gen_lzc_in_tmp__w3 = gen_lzc_in_tmp__w2
  gen_lzc_in_tmp__w3#[2..<3] = in_i.e2 & 1
  mut gen_lzc_in_tmp__w4 = gen_lzc_in_tmp__w3
  gen_lzc_in_tmp__w4#[3..<4] = in_i.e3 & 1
  cnt_o = if gen_lzc_in_tmp__w4#[3..<4] != 0 { 3 } else { 3 }
  if gen_lzc_in_tmp__w4#[2..<3] != 0 {
    cnt_o = 2
  }
  if gen_lzc_in_tmp__w4#[1..<2] != 0 {
    cnt_o = 1
  }
  if (gen_lzc_in_tmp__w4 & 1) != 0 {
    cnt_o = 0
  }
  empty_o = ~U1(gen_lzc_in_tmp__w4 != 0)#[0]
}
