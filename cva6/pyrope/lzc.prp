pub comb lzc<WIDTH=2, MODE=0, CNT_WIDTH=1>::[timecheck=false](in_i:(e1:U1, e0:U1)) -> (cnt_o:U1, empty_o:U1) {
  mut gen_lzc_in_tmp:U2 = 0
  gen_lzc_in_tmp = 0sb?
  cnt_o = 0ub?
  mut gen_lzc_in_tmp__w1 = gen_lzc_in_tmp
  gen_lzc_in_tmp__w1#[0..<1] = in_i.e0 & 1
  mut gen_lzc_in_tmp__w2 = gen_lzc_in_tmp__w1
  gen_lzc_in_tmp__w2#[1..<2] = in_i.e1 & 1
  cnt_o = if gen_lzc_in_tmp__w2#[1..<2] != 0 { 1 } else { 1 }
  if (gen_lzc_in_tmp__w2 & 1) != 0 {
    cnt_o = 0
  }
  empty_o = ~U1(gen_lzc_in_tmp__w2 != 0)#[0]
}
