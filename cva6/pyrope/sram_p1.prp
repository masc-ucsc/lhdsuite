const tc_sram_wrapper = import("tc_sram_wrapper.tc_sram_wrapper")

pub mod sram_p1::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wuser_i:u128, wdata_i:u128, be_i:u16) -> (ruser_o:u128@[], rdata_o:u128@[]) {
  mut ruser_aligned:u128 = 0
  mut rdata_aligned__wtmp:u128 = 0sb?
  wire rdata_aligned:u128
  ruser_aligned = 0sb?
  mut wdata_aligned__w2 = 0
  wdata_aligned__w2#[0..=127] = wdata_i
  mut be_aligned__w2 = 0
  be_aligned__w2#[0..=15] = be_i
  const rdata_o__w1 = rdata_aligned
  mut i_tc_sram_wrapper = tc_sram_wrapper::[name=i_tc_sram_wrapper](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, we_i = we_i, addr_i = addr_i, wdata_i = wdata_aligned__w2#[0..=63], be_i = be_aligned__w2#[0..=7])
  rdata_aligned__wtmp#[0..=63] = i_tc_sram_wrapper#[0..=63]
  i_tc_sram_wrapper = tc_sram_wrapper::[name=i_tc_sram_wrapper](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, we_i = we_i, addr_i = addr_i, wdata_i = wdata_aligned__w2#[64..=127], be_i = be_aligned__w2#[8..=15])
  mut rdata_aligned__wtmp__w1 = rdata_aligned__wtmp
  rdata_aligned__wtmp__w1#[64..=127] = i_tc_sram_wrapper#[0..=63]
  rdata_aligned = rdata_aligned__wtmp__w1
  ruser_o = 0
  rdata_o = rdata_o__w1
}
