const popcount_p2 = import("popcount_p2.popcount_p2")

pub mod popcount_p1::[timecheck=false](data_i:u64) -> (popcount_o:u7@[]) {
  const padded_input__w1 = data_i
  mut left_child = popcount_p2::[name=left_child](data_i = padded_input__w1#[32..=63])
  mut right_child = popcount_p2::[name=right_child](data_i = padded_input__w1#[0..=31])
  popcount_o = left_child + right_child
}
