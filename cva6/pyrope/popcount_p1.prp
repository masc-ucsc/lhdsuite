const popcount_p2 = import("popcount_p2.popcount_p2")

pub mod popcount_p1<INPUT_WIDTH=64>::[timecheck=false](data_i:u64) -> (popcount_o:u7@[]) {
  const padded_input__w1 = data_i
  mut non_leaf_node_left_child = popcount_p2::[name=non_leaf_node_left_child](data_i = padded_input__w1#[32..=63])
  mut non_leaf_node_right_child = popcount_p2::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..=31])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
