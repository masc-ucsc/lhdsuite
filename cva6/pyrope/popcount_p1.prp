const popcount_p2 = import("popcount_p2.popcount_p2")

pub mod popcount_p1<INPUT_WIDTH=64>::[timecheck=false](data_i:U64) -> (popcount_o:U7@[]) {
  const padded_input__w1 = data_i#[0..<0x40]
  mut non_leaf_node_left_child = popcount_p2::[name=non_leaf_node_left_child](data_i = padded_input__w1#[32..<0x40])
  mut non_leaf_node_right_child = popcount_p2::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..<32])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
