const stream_arbiter_flushable_p1 = import("stream_arbiter_flushable_p1.stream_arbiter_flushable_p1")

pub mod stream_arbiter_p1::[timecheck=false](clk_i:u1, rst_ni:u1, inp_data_i:u501, inp_valid_i:u3, oup_ready_i:u1) -> (inp_ready_o:u3@[], oup_data_o:(id:u4, addr:u64, len:u8, size:u3, burst:u2, lock:u1, cache:u4, prot:u3, qos:u4, region:u4, atop:u6, user:u64)@[], oup_valid_o:u1@[]) {
  mut i_arb = stream_arbiter_flushable_p1::[name=i_arb](clk_i = clk_i, rst_ni = rst_ni, flush_i = 0, inp_data_i = inp_data_i, inp_valid_i = inp_valid_i, oup_ready_i = oup_ready_i)
  oup_data_o.id = i_arb.oup_data_o.id
  oup_data_o.addr = i_arb.oup_data_o.addr
  oup_data_o.len = i_arb.oup_data_o.len
  oup_data_o.size = i_arb.oup_data_o.size
  oup_data_o.burst = i_arb.oup_data_o.burst
  oup_data_o.lock = i_arb.oup_data_o.lock
  oup_data_o.cache = i_arb.oup_data_o.cache
  oup_data_o.prot = i_arb.oup_data_o.prot
  oup_data_o.qos = i_arb.oup_data_o.qos
  oup_data_o.region = i_arb.oup_data_o.region
  oup_data_o.atop = i_arb.oup_data_o.atop
  oup_data_o.user = i_arb.oup_data_o.user
  inp_ready_o = i_arb.inp_ready_o
  oup_valid_o = i_arb.oup_valid_o
}
