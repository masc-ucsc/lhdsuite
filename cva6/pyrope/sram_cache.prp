const sram = import("sram.sram")

pub mod sram_cache<DATA_WIDTH=45, USER_WIDTH=1, USER_EN=0, NUM_WORDS=0x100, SIM_INIT=0x6e6f6e65, BYTE_ACCESS=0, TECHNO_CUT=0, OUT_REGS=0>::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wuser_i:u1, wdata_i:u45, be_i:u6) -> (ruser_o:u1@[], rdata_o:u45@[]) {
  mut _mux_1:u32 = 0
  _mux_1 = DATA_WIDTH
  mut genblk1_data_sram = sram::[name=genblk1_data_sram](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, we_i = we_i, addr_i = addr_i, wuser_i = wuser_i, wdata_i = wdata_i, be_i = be_i)
  ruser_o = genblk1_data_sram.ruser_o
  rdata_o = genblk1_data_sram.rdata_o
}
