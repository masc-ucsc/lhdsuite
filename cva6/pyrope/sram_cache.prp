const sram = import("sram.sram")

pub mod sram_cache<DATA_WIDTH=45, USER_WIDTH=1, USER_EN=0, NUM_WORDS=0x100, SIM_INIT=0x6e6f6e65, BYTE_ACCESS=0, TECHNO_CUT=0, OUT_REGS=0>::[timecheck=false](clk_i:Clock, rst_ni:U1, req_i:U1, we_i:U1, addr_i:U8, wuser_i:U1, wdata_i:U45, be_i:U6) -> (ruser_o:U1@[], rdata_o:U45@[]) {
  mut genblk1_data_sram = sram::[name=genblk1_data_sram](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, we_i = we_i, addr_i = addr_i, wuser_i = wuser_i, wdata_i = wdata_i, be_i = be_i)
  ruser_o = genblk1_data_sram.ruser_o
  rdata_o = genblk1_data_sram.rdata_o
}
