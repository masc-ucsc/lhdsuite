  load_trans_id_o = (i_pipe_reg_load >> 0x10c)#[0..<3]
  load_result_o = (i_pipe_reg_load >> 0xcc)#[0..<0x40]
  load_valid_o = (i_pipe_reg_load >> 0x10f) & 1
  store_trans_id_o = (i_pipe_reg_store >> 0x10c)#[0..<3]
  store_result_o = (i_pipe_reg_store >> 0xcc)#[0..<0x40]
  store_valid_o = (i_pipe_reg_store >> 0x10f) & 1
  commit_ready_o = i_store_unit.commit_ready_o
  acc_mmu_resp_o = 0
  csr_hs_ld_st_inst_o = gen_mmu_i_cva6_mmu.csr_hs_ld_st_inst_o
  itlb_miss_o = gen_mmu_i_cva6_mmu.itlb_miss_o
  dtlb_miss_o = gen_mmu_i_cva6_mmu.dtlb_miss_o
  rvfi_mem_paddr_o = i_store_unit.rvfi_mem_paddr_o
}
