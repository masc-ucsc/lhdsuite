          }
        }
        == riscv.OpcodeC2Swsp {
          instr_o = (instr_i#[7..=8] << 26) | (((instr_i >> 12) & 1) << 25) | (instr_i#[2..=6] << 20) | (2 << 15) | (2 << 12) | (instr_i#[9..=11] << 9) | riscv.OpcodeStore#[0..=6]
        }
