const riscv = import("riscv")

pub comb compressed_decoder<>::[timecheck=false](instr_i:U32) -> (instr_o:U32, illegal_instr_o:U1, is_macro_instr_o:U1, is_compressed_o:U1, is_zcmt_instr_o:U1) {
  mut _mux_5:U1 = 0
  mut _rep_1:U15 = 0
  mut _rep_2:U3 = 0
  mut _rep_3:U9 = 0
  mut _rep_4:U4 = 0
  instr_o = 0sb?
  illegal_instr_o = 0ub?
  is_compressed_o = 0ub?
  illegal_instr_o = 0
  is_compressed_o = 1
  instr_o = instr_i
  match instr_i#[0..<2] {
    == riscv.OpcodeC0 {
      match instr_i#[13..<16] {
        == riscv.OpcodeC0Addi4spn {
          instr_o = (instr_i#[7..<11] << 26) | (instr_i#[11..<13] << 24) | (instr_i#[5..<6] << 23) | (instr_i#[6..<7] << 22) | (2 << 15) | (1 << 10) | (instr_i#[2..<5] << 7) | riscv.OpcodeOpImm#[0..<7]
          if instr_i#[5..<13] == 0 {
            illegal_instr_o = 1
          }
        }
        == riscv.OpcodeC0Fld {
          instr_o = (instr_i#[5..<7] << 26) | (instr_i#[10..<13] << 23) | (1 << 18) | (instr_i#[7..<10] << 15) | (3 << 12) | (1 << 10) | (instr_i#[2..<5] << 7) | riscv.OpcodeLoadFp#[0..<7]
        }
        == riscv.OpcodeC0Lw {
          instr_o = (instr_i#[5..<6] << 26) | (instr_i#[10..<13] << 23) | (instr_i#[6..<7] << 22) | (1 << 18) | (instr_i#[7..<10] << 15) | (2 << 12) | (1 << 10) | (instr_i#[2..<5] << 7) | riscv.OpcodeLoad#[0..<7]
        }
        == riscv.OpcodeC0Ld {
          instr_o = (instr_i#[5..<7] << 26) | (instr_i#[10..<13] << 23) | (1 << 18) | (instr_i#[7..<10] << 15) | (3 << 12) | (1 << 10) | (instr_i#[2..<5] << 7) | riscv.OpcodeLoad#[0..<7]
        }
        == riscv.OpcodeC0Zcb {
          match instr_i#[10..<13] {
            == 0 {
              instr_o = (instr_i#[5..<6] << 21) | (instr_i#[6..<7] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (4 << 12) | (1 << 10) | (instr_i#[2..<5] << 7) | riscv.OpcodeLoad#[0..<7]
            }
            == 1 {
              instr_o = if instr_i#[6..<7] != 0 { (instr_i#[5..<6] << 21) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 12) | (1 << 10) | (instr_i#[2..<5] << 7) | riscv.OpcodeLoad#[0..<7] } else { (instr_i#[5..<6] << 21) | (1 << 18) | (instr_i#[7..<10] << 15) | (5 << 12) | (1 << 10) | (instr_i#[2..<5] << 7) | riscv.OpcodeLoad#[0..<7] }
            }
            == 2 {
              instr_o = (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (instr_i#[5..<6] << 8) | (instr_i#[6..<7] << 7) | riscv.OpcodeStore#[0..<7]
            }
            == 3 {
              instr_o = (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 12) | (instr_i#[5..<6] << 8) | riscv.OpcodeStore#[0..<7]
              if instr_i#[6..<7] == 1 {
                illegal_instr_o = 1
              }
            }
            else {
              illegal_instr_o = 1
            }
          }
        }
        == riscv.OpcodeC0Fsd {
          instr_o = (instr_i#[5..<7] << 26) | (instr_i#[12..<13] << 25) | (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (3 << 12) | (instr_i#[10..<12] << 10) | riscv.OpcodeStoreFp#[0..<7]
        }
        == riscv.OpcodeC0Sw {
          instr_o = (instr_i#[5..<6] << 26) | (instr_i#[12..<13] << 25) | (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (2 << 12) | (instr_i#[10..<12] << 10) | (instr_i#[6..<7] << 9) | riscv.OpcodeStore#[0..<7]
        }
        == riscv.OpcodeC0Sd {
          instr_o = (instr_i#[5..<7] << 26) | (instr_i#[12..<13] << 25) | (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (3 << 12) | (instr_i#[10..<12] << 10) | riscv.OpcodeStore#[0..<7]
        }
        else {
          illegal_instr_o = 1
        }
      }
    }
    == riscv.OpcodeC1 {
      match instr_i#[13..<16] {
        == riscv.OpcodeC1Addi {
          instr_o = ((instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (instr_i#[7..<12] << 15) | (instr_i#[7..<12] << 7) | riscv.OpcodeOpImm#[0..<7])#sext[0..=25]#[0..<32]
        }
        == riscv.OpcodeC1Addiw {
          if instr_i#[7..<12] != 0 {
            instr_o = ((instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (instr_i#[7..<12] << 15) | (instr_i#[7..<12] << 7) | riscv.OpcodeOpImm32#[0..<7])#sext[0..=25]#[0..<32]
          } else {
            illegal_instr_o = 1
          }
        }
        == riscv.OpcodeC1Li {
          instr_o = ((instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (instr_i#[7..<12] << 7) | riscv.OpcodeOpImm#[0..<7])#sext[0..=25]#[0..<32]
        }
        == riscv.OpcodeC1LuiAddi16sp {
          _rep_1 = if instr_i#[12..<13] != 0 { 0x7fff } else { 0 }
          instr_o = (_rep_1#[0..<15] << 17) | (instr_i#[2..<7] << 12) | (instr_i#[7..<12] << 7) | riscv.OpcodeLui#[0..<7]
          if instr_i#[7..<12] == 2 {
            _rep_2 = if instr_i#[12..<13] != 0 { 7 } else { 0 }
            instr_o = (_rep_2#[0..<3] << 29) | (instr_i#[3..<5] << 27) | (instr_i#[5..<6] << 26) | (instr_i#[2..<3] << 25) | (instr_i#[6..<7] << 24) | (2 << 15) | (2 << 7) | riscv.OpcodeOpImm#[0..<7]
          }
          if ((instr_i#[12..<13] << 5) | instr_i#[2..<7]) == 0 {
            illegal_instr_o = 1
          }
        }
        == riscv.OpcodeC1MiscAlu {
          match instr_i#[10..<12] {
            in (0, 1) {
              instr_o = (instr_i#[10..<11] << 30) | (instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (5 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOpImm#[0..<7]
            }
            == 2 {
              instr_o = ((instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (7 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOpImm#[0..<7])#sext[0..=25]#[0..<32]
            }
            == 3 {
              const t182 = (instr_i#[12..<13] << 2) | instr_i#[5..<7]
              match t182 {
                == 0 {
                  instr_o = (1 << 30) | (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp#[0..<7]
                }
                == 1 {
                  instr_o = (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (4 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp#[0..<7]
                }
                == 2 {
                  instr_o = (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (6 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp#[0..<7]
                }
                == 3 {
                  instr_o = (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (7 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp#[0..<7]
                }
                == 4 {
                  instr_o = (1 << 30) | (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp32#[0..<7]
                }
                == 5 {
                  instr_o = (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp32#[0..<7]
                }
                == 6 {
                  instr_o = (1 << 25) | (1 << 23) | (instr_i#[2..<5] << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp#[0..<7]
                }
                == 7 {
                  match instr_i#[2..<5] {
                    == 0 {
                      instr_o = (0xff << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (7 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOpImm#[0..<7]
                    }
                    == 1 {
                      instr_o = (48 << 25) | (4 << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOpImm#[0..<7]
                    }
                    == 2 {
                      instr_o = (4 << 25) | (1 << 18) | (instr_i#[7..<10] << 15) | (4 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp32#[0..<7]
                    }
                    == 3 {
                      instr_o = (48 << 25) | (5 << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOpImm#[0..<7]
                    }
                    == 4 {
                      instr_o = (4 << 25) | (1 << 18) | (instr_i#[7..<10] << 15) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOp32#[0..<7]
                    }
                    == 5 {
                      instr_o = (0xfff << 20) | (1 << 18) | (instr_i#[7..<10] << 15) | (4 << 12) | (1 << 10) | (instr_i#[7..<10] << 7) | riscv.OpcodeOpImm#[0..<7]
                    }
                    else {
                      instr_o = instr_i
                      illegal_instr_o = 1
                    }
                  }
                }
                else {
                  instr_o = 0sb?
                  illegal_instr_o = 0ub?
                }
              }
            }
            else {
              instr_o = 0sb?
              illegal_instr_o = 0ub?
            }
          }
        }
        == riscv.OpcodeC1J {
          _rep_3 = if instr_i#[12..<13] != 0 { 0x1ff } else { 0 }
          instr_o = (instr_i#[12..<13] << 31) | (instr_i#[8..<9] << 30) | (instr_i#[9..<11] << 28) | (instr_i#[6..<7] << 27) | (instr_i#[7..<8] << 26) | (instr_i#[2..<3] << 25) | (instr_i#[11..<12] << 24) | (instr_i#[3..<6] << 21) | (_rep_3#[0..<9] << 12) | ((~instr_i#[15..<16]) << 7) | riscv.OpcodeJal#[0..<7]
        }
        in (riscv.OpcodeC1Beqz, riscv.OpcodeC1Bnez) {
          _rep_4 = if instr_i#[12..<13] != 0 { 15 } else { 0 }
          instr_o = (_rep_4#[0..<4] << 28) | (instr_i#[5..<7] << 26) | (instr_i#[2..<3] << 25) | (1 << 18) | (instr_i#[7..<10] << 15) | (instr_i#[13..<14] << 12) | (instr_i#[10..<12] << 10) | (instr_i#[3..<5] << 8) | (instr_i#[12..<13] << 7) | riscv.OpcodeBranch#[0..<7]
        }
        else {
          instr_o = 0sb?
          illegal_instr_o = 0ub?
        }
      }
    }
    == riscv.OpcodeC2 {
      match instr_i#[13..<16] {
        == riscv.OpcodeC2Slli {
          instr_o = (instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (instr_i#[7..<12] << 15) | (1 << 12) | (instr_i#[7..<12] << 7) | riscv.OpcodeOpImm#[0..<7]
        }
        == riscv.OpcodeC2Fldsp {
          instr_o = (instr_i#[2..<5] << 26) | (instr_i#[12..<13] << 25) | (instr_i#[5..<7] << 23) | (2 << 15) | (3 << 12) | (instr_i#[7..<12] << 7) | riscv.OpcodeLoadFp#[0..<7]
        }
        == riscv.OpcodeC2Lwsp {
          instr_o = (instr_i#[2..<4] << 26) | (instr_i#[12..<13] << 25) | (instr_i#[4..<7] << 22) | (2 << 15) | (2 << 12) | (instr_i#[7..<12] << 7) | riscv.OpcodeLoad#[0..<7]
          if instr_i#[7..<12] == 0 {
            illegal_instr_o = 1
          }
        }
        == riscv.OpcodeC2Ldsp {
          instr_o = (instr_i#[2..<5] << 26) | (instr_i#[12..<13] << 25) | (instr_i#[5..<7] << 23) | (2 << 15) | (3 << 12) | (instr_i#[7..<12] << 7) | riscv.OpcodeLoad#[0..<7]
          if instr_i#[7..<12] == 0 {
            illegal_instr_o = 1
          }
        }
        == riscv.OpcodeC2JalrMvAdd {
          if instr_i#[12..<13] == 0 {
            instr_o = (instr_i#[2..<7] << 20) | (instr_i#[7..<12] << 7) | riscv.OpcodeOp#[0..<7]
            if instr_i#[2..<7] == 0 {
              instr_o = (instr_i#[7..<12] << 15) | riscv.OpcodeJalr#[0..<7]
              _mux_5 = if instr_i#[7..<12] != 0 { 0 } else { 1 }
              illegal_instr_o = _mux_5
            }
          } else {
            instr_o = (instr_i#[2..<7] << 20) | (instr_i#[7..<12] << 15) | (instr_i#[7..<12] << 7) | riscv.OpcodeOp#[0..<7]
            if instr_i#[2..<7] == 0 {
              instr_o = if instr_i#[7..<12] == 0 { 0x100073 } else { (instr_i#[7..<12] << 15) | (1 << 7) | riscv.OpcodeJalr#[0..<7] }
            }
          }
        }
        == riscv.OpcodeC2Fsdsp {
          instr_o = (instr_i#[7..<10] << 26) | (instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (2 << 15) | (3 << 12) | (instr_i#[10..<12] << 10) | riscv.OpcodeStoreFp#[0..<7]
        }
        == riscv.OpcodeC2Swsp {
          instr_o = (instr_i#[7..<9] << 26) | (instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (2 << 15) | (2 << 12) | (instr_i#[9..<12] << 9) | riscv.OpcodeStore#[0..<7]
        }
        == riscv.OpcodeC2Sdsp {
          instr_o = (instr_i#[7..<10] << 26) | (instr_i#[12..<13] << 25) | (instr_i#[2..<7] << 20) | (2 << 15) | (3 << 12) | (instr_i#[10..<12] << 10) | riscv.OpcodeStore#[0..<7]
        }
        else {
          illegal_instr_o = 1
        }
      }
    }
    else {
      is_compressed_o = 0
    }
  }
  if illegal_instr_o != 0 {
    instr_o = instr_i
  }
  is_macro_instr_o = 0
  is_zcmt_instr_o = 0
}
