const riscv = import("riscv")

pub comb compressed_decoder::[timecheck=false](instr_i:u32) -> (instr_o:u32, illegal_instr_o:u1, is_macro_instr_o:u1, is_compressed_o:u1, is_zcmt_instr_o:u1) {
  mut _mux_6:u1 = 0
  mut _rep_2:u15 = 0
  mut _rep_3:u3 = 0
  mut _rep_4:u9 = 0
  mut _rep_5:u4 = 0
  instr_o = 0sb?
  illegal_instr_o = 0ub?
  is_compressed_o = 0ub?
  is_zcmt_instr_o = 0
  instr_o = instr_i
  illegal_instr_o = 0
  is_macro_instr_o = 0
  is_compressed_o = 1
  match instr_i#[0..=1] {
    == riscv.OpcodeC0 {
      match instr_i#[13..=15] {
        == riscv.OpcodeC0Addi4spn {
          instr_o = (instr_i#[7..=10] << 26) | (instr_i#[11..=12] << 24) | (((instr_i >> 5) & 1) << 23) | (((instr_i >> 6) & 1) << 22) | (2 << 15) | (1 << 10) | (instr_i#[2..=4] << 7) | riscv.OpcodeOpImm#[0..=6]
          if instr_i#[5..=12] == 0 {
            illegal_instr_o = 1
          }
        }
        == riscv.OpcodeC0Fld {
          {
            instr_o = (instr_i#[5..=6] << 26) | (instr_i#[10..=12] << 23) | (1 << 18) | (instr_i#[7..=9] << 15) | (3 << 12) | (1 << 10) | (instr_i#[2..=4] << 7) | riscv.OpcodeLoadFp#[0..=6]
          }
        }
        == riscv.OpcodeC0Lw {
          instr_o = (((instr_i >> 5) & 1) << 26) | (instr_i#[10..=12] << 23) | (((instr_i >> 6) & 1) << 22) | (1 << 18) | (instr_i#[7..=9] << 15) | (2 << 12) | (1 << 10) | (instr_i#[2..=4] << 7) | riscv.OpcodeLoad#[0..=6]
        }
        == riscv.OpcodeC0Ld {
          {
            instr_o = (instr_i#[5..=6] << 26) | (instr_i#[10..=12] << 23) | (1 << 18) | (instr_i#[7..=9] << 15) | (3 << 12) | (1 << 10) | (instr_i#[2..=4] << 7) | riscv.OpcodeLoad#[0..=6]
          }
        }
        == riscv.OpcodeC0Zcb {
          {
            match instr_i#[10..=12] {
              == 0 {
                instr_o = (((instr_i >> 5) & 1) << 21) | (((instr_i >> 6) & 1) << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (4 << 12) | (1 << 10) | (instr_i#[2..=4] << 7) | riscv.OpcodeLoad#[0..=6]
              }
              == 1 {
                instr_o = if ((instr_i >> 6) & 1) != 0 { (((instr_i >> 5) & 1) << 21) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 12) | (1 << 10) | (instr_i#[2..=4] << 7) | riscv.OpcodeLoad#[0..=6] } else { (((instr_i >> 5) & 1) << 21) | (1 << 18) | (instr_i#[7..=9] << 15) | (5 << 12) | (1 << 10) | (instr_i#[2..=4] << 7) | riscv.OpcodeLoad#[0..=6] }
              }
              == 2 {
                instr_o = (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (((instr_i >> 5) & 1) << 8) | (((instr_i >> 6) & 1) << 7) | riscv.OpcodeStore#[0..=6]
              }
              == 3 {
                instr_o = (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 12) | (((instr_i >> 5) & 1) << 8) | riscv.OpcodeStore#[0..=6]
                if ((instr_i >> 6) & 1) == 1 {
                  illegal_instr_o = 1
                }
              }
              else {
                illegal_instr_o = 1
              }
            }
          }
        }
        == riscv.OpcodeC0Fsd {
          {
            instr_o = (instr_i#[5..=6] << 26) | (((instr_i >> 12) & 1) << 25) | (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (3 << 12) | (instr_i#[10..=11] << 10) | riscv.OpcodeStoreFp#[0..=6]
          }
        }
        == riscv.OpcodeC0Sw {
          instr_o = (((instr_i >> 5) & 1) << 26) | (((instr_i >> 12) & 1) << 25) | (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (2 << 12) | (instr_i#[10..=11] << 10) | (((instr_i >> 6) & 1) << 9) | riscv.OpcodeStore#[0..=6]
        }
        == riscv.OpcodeC0Sd {
          {
            instr_o = (instr_i#[5..=6] << 26) | (((instr_i >> 12) & 1) << 25) | (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (3 << 12) | (instr_i#[10..=11] << 10) | riscv.OpcodeStore#[0..=6]
          }
        }
        else {
          illegal_instr_o = 1
        }
      }
    }
    == riscv.OpcodeC1 {
      match instr_i#[13..=15] {
        == riscv.OpcodeC1Addi {
          instr_o = ((((instr_i >> 12) & 1) << 25) | (instr_i#[2..=6] << 20) | (instr_i#[7..=11] << 15) | (instr_i#[7..=11] << 7) | riscv.OpcodeOpImm#[0..=6])#sext[0..=25]#[0..=31]
        }
        == riscv.OpcodeC1Addiw {
          {
            if instr_i#[7..=11] != 0 {
              instr_o = ((((instr_i >> 12) & 1) << 25) | (instr_i#[2..=6] << 20) | (instr_i#[7..=11] << 15) | (instr_i#[7..=11] << 7) | riscv.OpcodeOpImm32#[0..=6])#sext[0..=25]#[0..=31]
            } else {
              illegal_instr_o = 1
            }
          }
        }
        == riscv.OpcodeC1Li {
          instr_o = ((((instr_i >> 12) & 1) << 25) | (instr_i#[2..=6] << 20) | (instr_i#[7..=11] << 7) | riscv.OpcodeOpImm#[0..=6])#sext[0..=25]#[0..=31]
        }
        == riscv.OpcodeC1LuiAddi16sp {
          _rep_2 = if ((instr_i >> 12) & 1) != 0 { 0x7fff } else { 0 }
          instr_o = (_rep_2 << 17) | (instr_i#[2..=6] << 12) | (instr_i#[7..=11] << 7) | riscv.OpcodeLui#[0..=6]
          if instr_i#[7..=11] == 2 {
            _rep_3 = if ((instr_i >> 12) & 1) != 0 { 7 } else { 0 }
            instr_o = (_rep_3 << 29) | (instr_i#[3..=4] << 27) | (((instr_i >> 5) & 1) << 26) | (((instr_i >> 2) & 1) << 25) | (((instr_i >> 6) & 1) << 24) | (2 << 15) | (2 << 7) | riscv.OpcodeOpImm#[0..=6]
          }
          if ((((instr_i >> 12) & 1) << 5) | instr_i#[2..=6]) == 0 {
            illegal_instr_o = 1
          }
        }
