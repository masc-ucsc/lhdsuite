          match instr_i#[10..=11] {
            in (0, 1) {
              instr_o = (((instr_i >> 10) & 1) << 30) | (((instr_i >> 12) & 1) << 25) | (instr_i#[2..=6] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (5 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOpImm#[0..=6]
            }
            == 2 {
              instr_o = ((((instr_i >> 12) & 1) << 25) | (instr_i#[2..=6] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (7 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOpImm#[0..=6])#sext[0..=25]#[0..=31]
            }
            == 3 {
              const t262 = (((instr_i >> 12) & 1) << 2) | instr_i#[5..=6]
              match t262 {
                == 0 {
                  instr_o = (1 << 30) | (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp#[0..=6]
                }
                == 1 {
                  instr_o = (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (4 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp#[0..=6]
                }
                == 2 {
                  instr_o = (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (6 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp#[0..=6]
                }
                == 3 {
                  instr_o = (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (7 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp#[0..=6]
                }
                == 4 {
                  {
                    instr_o = (1 << 30) | (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp32#[0..=6]
                  }
                }
                == 5 {
                  {
                    instr_o = (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp32#[0..=6]
                  }
                }
                == 6 {
                  {
                    instr_o = (1 << 25) | (1 << 23) | (instr_i#[2..=4] << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp#[0..=6]
                  }
                }
                == 7 {
                  {
                    match instr_i#[2..=4] {
                      == 0 {
                        instr_o = (0xff << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (7 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOpImm#[0..=6]
                      }
                      == 1 {
                        {
                          instr_o = (48 << 25) | (4 << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOpImm#[0..=6]
                        }
                      }
                      == 2 {
                        {
                          {
                            instr_o = (4 << 25) | (1 << 18) | (instr_i#[7..=9] << 15) | (4 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp32#[0..=6]
                          }
                        }
                      }
                      == 3 {
                        {
                          instr_o = (48 << 25) | (5 << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOpImm#[0..=6]
                        }
                      }
                      == 4 {
                        {
                          {
                            instr_o = (4 << 25) | (1 << 18) | (instr_i#[7..=9] << 15) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOp32#[0..=6]
                          }
                        }
                      }
                      == 5 {
                        instr_o = (0xfff << 20) | (1 << 18) | (instr_i#[7..=9] << 15) | (4 << 12) | (1 << 10) | (instr_i#[7..=9] << 7) | riscv.OpcodeOpImm#[0..=6]
                      }
                      else {
                        instr_o = instr_i
                        illegal_instr_o = 1
                      }
                    }
                  }
                }
                else {
                  instr_o = 0sb?
                  illegal_instr_o = 0ub?
                }
              }
            }
            else {
              instr_o = 0sb?
              illegal_instr_o = 0ub?
            }
          }
        }
        == riscv.OpcodeC1J {
          _rep_4 = if ((instr_i >> 12) & 1) != 0 { 0x1ff } else { 0 }
          instr_o = (((instr_i >> 12) & 1) << 31) | (((instr_i >> 8) & 1) << 30) | (instr_i#[9..=10] << 28) | (((instr_i >> 6) & 1) << 27) | (((instr_i >> 7) & 1) << 26) | (((instr_i >> 2) & 1) << 25) | (((instr_i >> 11) & 1) << 24) | (instr_i#[3..=5] << 21) | (_rep_4 << 12) | (((~((instr_i >> 15) & 1)) & 1) << 7) | riscv.OpcodeJal#[0..=6]
        }
        in (riscv.OpcodeC1Beqz, riscv.OpcodeC1Bnez) {
          _rep_5 = if ((instr_i >> 12) & 1) != 0 { 15 } else { 0 }
          instr_o = (_rep_5 << 28) | (instr_i#[5..=6] << 26) | (((instr_i >> 2) & 1) << 25) | (1 << 18) | (instr_i#[7..=9] << 15) | (((instr_i >> 13) & 1) << 12) | (instr_i#[10..=11] << 10) | (instr_i#[3..=4] << 8) | (((instr_i >> 12) & 1) << 7) | riscv.OpcodeBranch#[0..=6]
        }
        else {
          instr_o = 0sb?
          illegal_instr_o = 0ub?
        }
      }
    }
    == riscv.OpcodeC2 {
      match instr_i#[13..=15] {
        == riscv.OpcodeC2Slli {
          instr_o = (((instr_i >> 12) & 1) << 25) | (instr_i#[2..=6] << 20) | (instr_i#[7..=11] << 15) | (1 << 12) | (instr_i#[7..=11] << 7) | riscv.OpcodeOpImm#[0..=6]
        }
        == riscv.OpcodeC2Fldsp {
          {
            instr_o = (instr_i#[2..=4] << 26) | (((instr_i >> 12) & 1) << 25) | (instr_i#[5..=6] << 23) | (2 << 15) | (3 << 12) | (instr_i#[7..=11] << 7) | riscv.OpcodeLoadFp#[0..=6]
          }
        }
        == riscv.OpcodeC2Lwsp {
          instr_o = (instr_i#[2..=3] << 26) | (((instr_i >> 12) & 1) << 25) | (instr_i#[4..=6] << 22) | (2 << 15) | (2 << 12) | (instr_i#[7..=11] << 7) | riscv.OpcodeLoad#[0..=6]
          if instr_i#[7..=11] == 0 {
            illegal_instr_o = 1
          }
        }
        == riscv.OpcodeC2Ldsp {
          {
            instr_o = (instr_i#[2..=4] << 26) | (((instr_i >> 12) & 1) << 25) | (instr_i#[5..=6] << 23) | (2 << 15) | (3 << 12) | (instr_i#[7..=11] << 7) | riscv.OpcodeLoad#[0..=6]
            if instr_i#[7..=11] == 0 {
              illegal_instr_o = 1
            }
          }
        }
        == riscv.OpcodeC2JalrMvAdd {
          if ((instr_i >> 12) & 1) == 0 {
            instr_o = (instr_i#[2..=6] << 20) | (instr_i#[7..=11] << 7) | riscv.OpcodeOp#[0..=6]
            if instr_i#[2..=6] == 0 {
              instr_o = (instr_i#[7..=11] << 15) | riscv.OpcodeJalr#[0..=6]
              _mux_6 = if instr_i#[7..=11] != 0 { 0 } else { 1 }
              illegal_instr_o = _mux_6
            }
          } else {
            instr_o = (instr_i#[2..=6] << 20) | (instr_i#[7..=11] << 15) | (instr_i#[7..=11] << 7) | riscv.OpcodeOp#[0..=6]
            if instr_i#[2..=6] == 0 {
              instr_o = if instr_i#[7..=11] == 0 { 0x100073 } else { (instr_i#[7..=11] << 15) | (1 << 7) | riscv.OpcodeJalr#[0..=6] }
            }
          }
        }
