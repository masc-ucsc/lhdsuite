const sram_p1 = import("sram_p1.sram_p1")

pub mod sram_cache_p1::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wuser_i:u128, wdata_i:u128, be_i:u16) -> (ruser_o:u128@[], rdata_o:u128@[]) {
  mut data_sram = sram_p1::[name=data_sram](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, we_i = we_i, addr_i = addr_i, wuser_i = wuser_i, wdata_i = wdata_i, be_i = be_i)
  ruser_o = data_sram.ruser_o
  rdata_o = data_sram.rdata_o
}
