pub mod lfsr_8bit<SEED=0, WIDTH=8>::[timecheck=false](clk_i:Clock, rst_ni:U1, en_i:U1) -> (refill_way_oh:U8@[], refill_way_bin:U3@[]) {
  reg shift_q:U8:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  mut shift_d:U8 = 0sb?
  mut _b2i_1 = if ((((((shift_q#[7..<8] ^ shift_q#[3..<4]) & 1) ^ shift_q#[2..<3]) & 1) ^ shift_q#[1..<2]) & 1) == 0 { 1 } else { 0 }
  shift_d = if en_i != 0 { (shift_q#[0..<7] << 1) | (_b2i_1 & 1) } else { shift_q }
  mut refill_way_oh__w2 = 0
  refill_way_oh__w2#[shift_q#[0..<3]..<(shift_q#[0..<3] + 1)] = 1
  const refill_way_bin__w1 = shift_q#[0..<3]
  if rst_ni != 0 {
    shift_q = shift_d
  }
  refill_way_oh = refill_way_oh__w2
  refill_way_bin = refill_way_bin__w1
}
