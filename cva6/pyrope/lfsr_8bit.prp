pub mod lfsr_8bit::[timecheck=false](clk_i:u1, rst_ni:u1, en_i:u1) -> (refill_way_oh:u8@[], refill_way_bin:u3@[]) {
  reg shift_q:u8:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  mut shift_d:u8 = 0sb?
  shift_d = if en_i != 0 { (shift_q#[0..=6] << 1) | (unsigned(((((((((shift_q >> 7) & 1) ^ ((shift_q >> 3) & 1)) & 1) ^ ((shift_q >> 2) & 1)) & 1) ^ ((shift_q >> 1) & 1)) & 1) == 0) & 1) } else { shift_q }
  const refill_way_oh__w2 = ((0 & (~(1 << shift_q#[0..=2]))) | (1 << shift_q#[0..=2]))#[0..=7]
  const refill_way_bin__w1 = shift_q#[0..=2]
  if rst_ni != 0 {
    shift_q = shift_d
  }
  refill_way_oh = refill_way_oh__w2
  refill_way_bin = refill_way_bin__w1
}
