pub mod cva6_fifo_v3_p1<FALL_THROUGH=0, FPGA_ALTERA=0, DATA_WIDTH=64, DEPTH=2, FPGA_EN=0, ADDR_DEPTH=1>::[timecheck=false](clk_i:u1, rst_ni:u1, flush_i:u1, testmode_i:u1, data_i:u64, push_i:u1, pop_i:u1) -> (full_o:u1@[], empty_o:u1@[], usage_o:u1@[], data_o:u64@[]) {
  mut _mux_1:u32 = 0
  reg read_pointer_q:u1:[initial=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg write_pointer_q:u1:[initial=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg status_cnt_q:u2:[initial=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  reg mem_q:[2]u64:[ordering="old", initial=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  mut gate_clock:u1 = 0
  mut status_cnt_n:u2 = 0
  mut mem_n:u128 = 0
  mut data_ft_q__wtmp:u64 = 0sb?
  mut first_word_q__wtmp:u1 = 0sb?
  mut _mux_4:u64 = 0
  _mux_1 = 1
  {
    _mux_1 = DEPTH
  }
  const FifoDepth = _mux_1
  gate_clock = 0ub?
  mut read_pointer_n = 0ub?
  mut write_pointer_n = 0ub?
  status_cnt_n = 0sb?
  mem_n = 0sb?
  const usage_o__w1 = status_cnt_q & 1
  mut _b2i_2 = if status_cnt_q == FifoDepth#[0..=1] { 1 } else { 0 }
  const full_o__w1 = _b2i_2
  mut _b2i_3 = if status_cnt_q == 0 { 1 } else { 0 }
  const empty_o__w1 = _b2i_3 & (~(FALL_THROUGH & push_i & 1)) & 1 & 1
  _mux_4 = mem_q[read_pointer_q]
  gate_clock = 1
  mem_n = mem_q
  write_pointer_n = write_pointer_q
  status_cnt_n = status_cnt_q
  if (push_i != 0) and (((~full_o__w1) & 1) != 0) {
    const t21 = write_pointer_q * 0x40
    mem_n = ((mem_n & (~(0xffffffffffffffff << t21))) | (data_i << t21))#[0..=127]
    gate_clock = 0
    write_pointer_n = if write_pointer_q == ((FifoDepth & 1) - 1)#[0..=31] { 0 } else { (write_pointer_q + 1) & 1 }
    status_cnt_n = (status_cnt_q + 1)#[0..=1]
  }
  read_pointer_n = read_pointer_q
  if (pop_i != 0) and (((~empty_o__w1) & 1) != 0) {
    read_pointer_n = if read_pointer_n == ((FifoDepth & 1) - 1)#[0..=31] { 0 } else { (read_pointer_q + 1) & 1 }
    status_cnt_n = (status_cnt_q - 1)#[0..=31]#[0..=1]
  }
  if (push_i != 0) and (pop_i != 0) and (((~full_o__w1) & 1) != 0) and (((~empty_o__w1) & 1) != 0) {
    status_cnt_n = status_cnt_q
  }
  if rst_ni != 0 {
    if flush_i != 0 {
      read_pointer_q = 0
      write_pointer_q = 0
      status_cnt_q = 0
    } else {
      read_pointer_q = read_pointer_n
      write_pointer_q = write_pointer_n
      status_cnt_q = status_cnt_n
    }
  }
  if rst_ni != 0 {
    if gate_clock == 0 {
      mem_q = mem_n
    }
  }
  full_o = full_o__w1
  empty_o = empty_o__w1
  usage_o = usage_o__w1
  data_o = _mux_4
}
