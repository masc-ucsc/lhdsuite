const tag_cmp = import("tag_cmp.tag_cmp")

pub mod tag_cmp_wrap<, NR_PORTS=5>::[timecheck=false](clk_i:Clock, rst_ni:U1, req_i:U40, tag_i:U220, rdata_i:U1392) -> (gnt_o:U5@[], hit_way_o:U8@[]) {
  mut i_tag_cmp = tag_cmp::[name=i_tag_cmp](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, addr_i = 0, wdata_i = 0, we_i = 0, be_i = 0, tag_i = tag_i, rdata_i = rdata_i)
  gnt_o = i_tag_cmp.gnt_o
  hit_way_o = (i_tag_cmp.hit_way_o.e7 << 7) | (i_tag_cmp.hit_way_o.e6 << 6) | (i_tag_cmp.hit_way_o.e5 << 5) | (i_tag_cmp.hit_way_o.e4 << 4) | (i_tag_cmp.hit_way_o.e3 << 3) | (i_tag_cmp.hit_way_o.e2 << 2) | (i_tag_cmp.hit_way_o.e1 << 1) | i_tag_cmp.hit_way_o.e0
}
