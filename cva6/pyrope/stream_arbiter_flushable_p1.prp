const rr_arb_tree_p3 = import("rr_arb_tree_p3.rr_arb_tree_p3")

pub mod stream_arbiter_flushable_p1::[timecheck=false](clk_i:u1, rst_ni:u1, flush_i:u1, inp_data_i:u501, inp_valid_i:u3, oup_ready_i:u1) -> (inp_ready_o:u3@[], oup_data_o:(id:u4, addr:u64, len:u8, size:u3, burst:u2, lock:u1, cache:u4, prot:u3, qos:u4, region:u4, atop:u6, user:u64)@[], oup_valid_o:u1@[]) {
  mut i_arbiter = rr_arb_tree_p3::[name=i_arbiter](clk_i = clk_i, rst_ni = rst_ni, flush_i = flush_i, rr_i = 0, req_i = inp_valid_i, data_i = inp_data_i, gnt_i = oup_ready_i)
  oup_data_o.id = i_arbiter.data_o.id
  oup_data_o.addr = i_arbiter.data_o.addr
  oup_data_o.len = i_arbiter.data_o.len
  oup_data_o.size = i_arbiter.data_o.size
  oup_data_o.burst = i_arbiter.data_o.burst
  oup_data_o.lock = i_arbiter.data_o.lock
  oup_data_o.cache = i_arbiter.data_o.cache
  oup_data_o.prot = i_arbiter.data_o.prot
  oup_data_o.qos = i_arbiter.data_o.qos
  oup_data_o.region = i_arbiter.data_o.region
  oup_data_o.atop = i_arbiter.data_o.atop
  oup_data_o.user = i_arbiter.data_o.user
  inp_ready_o = i_arbiter.gnt_o
  oup_valid_o = i_arbiter.req_o
}
