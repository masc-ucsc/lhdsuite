pub mod csr_buffer<>::[timecheck=false](clk_i:Clock, rst_ni:U1, flush_i:U1, fu_data_i:(fu:U4, operation:U8, operand_a:U64, operand_b:U64, imm:U64, trans_id:U3), csr_valid_i:U1, csr_commit_i:U1) -> (csr_ready_o:U1@[], csr_result_o:U64@[], csr_addr_o:U12@[]) {
  reg csr_reg_q:U13:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  mut `csr_reg_n.csr_address` = 0
  mut `csr_reg_n.valid` = 0
  csr_ready_o = 0ub?
  const csr_addr_o__w1 = csr_reg_q#[1..<13]
  `csr_reg_n.csr_address` = csr_reg_q#[1..<13]
  `csr_reg_n.valid` = csr_reg_q & 1
  csr_ready_o = if (((csr_reg_q & 1) != 0) or (csr_valid_i != 0)) and ((~csr_commit_i) != 0) { 0 } else { 1 }
  if csr_valid_i != 0 {
    `csr_reg_n.csr_address` = fu_data_i.operand_b#[0..<12]
    `csr_reg_n.valid` = 1
  }
  if (csr_commit_i != 0) and ((~csr_valid_i) != 0) {
    `csr_reg_n.valid` = 0
  }
  if flush_i != 0 {
    `csr_reg_n.valid` = 0
  }
  if rst_ni != 0 {
    csr_reg_q = (`csr_reg_n.csr_address` << 1) | `csr_reg_n.valid`
  }
  csr_result_o = fu_data_i.operand_a
  csr_addr_o = csr_addr_o__w1
}
