const rr_arb_tree_p2 = import("rr_arb_tree_p2.rr_arb_tree_p2")

pub mod stream_arbiter_flushable<N_INP=3, ARBITER=0x7272>::[timecheck=false](clk_i:u1, rst_ni:u1, flush_i:u1, inp_data_i:u483, inp_valid_i:u3, oup_ready_i:u1) -> (inp_ready_o:u3@[], oup_data_o:(id:u4, addr:u64, len:u8, size:u3, burst:u2, lock:u1, cache:u4, prot:u3, qos:u4, region:u4, user:u64)@[], oup_valid_o:u1@[]) {
  wire `oup_data_o__bpr.id`:u4
  wire `oup_data_o__bpr.addr`:u64
  wire `oup_data_o__bpr.len`:u8
  wire `oup_data_o__bpr.size`:u3
  wire `oup_data_o__bpr.burst`:u2
  wire `oup_data_o__bpr.lock`:u1
  wire `oup_data_o__bpr.cache`:u4
  wire `oup_data_o__bpr.prot`:u3
  wire `oup_data_o__bpr.qos`:u4
  wire `oup_data_o__bpr.region`:u4
  wire `oup_data_o__bpr.user`:u64
  mut gen_rr_arb_i_arbiter = rr_arb_tree_p2::[name=gen_rr_arb_i_arbiter](clk_i = clk_i, rst_ni = rst_ni, flush_i = flush_i, rr_i = 0, req_i = inp_valid_i, data_i = inp_data_i, gnt_i = oup_ready_i)
  const t31 = gen_rr_arb_i_arbiter.data_o.id
  `oup_data_o__bpr.id` = t31
  oup_data_o.id = t31
  const t32 = gen_rr_arb_i_arbiter.data_o.addr
  `oup_data_o__bpr.addr` = t32
  oup_data_o.addr = t32
  const t33 = gen_rr_arb_i_arbiter.data_o.len
  `oup_data_o__bpr.len` = t33
  oup_data_o.len = t33
  const t34 = gen_rr_arb_i_arbiter.data_o.size
  `oup_data_o__bpr.size` = t34
  oup_data_o.size = t34
  const t35 = gen_rr_arb_i_arbiter.data_o.burst
  `oup_data_o__bpr.burst` = t35
  oup_data_o.burst = t35
  const t36 = gen_rr_arb_i_arbiter.data_o.lock
  `oup_data_o__bpr.lock` = t36
  oup_data_o.lock = t36
  const t37 = gen_rr_arb_i_arbiter.data_o.cache
  `oup_data_o__bpr.cache` = t37
  oup_data_o.cache = t37
  const t38 = gen_rr_arb_i_arbiter.data_o.prot
  `oup_data_o__bpr.prot` = t38
  oup_data_o.prot = t38
  const t39 = gen_rr_arb_i_arbiter.data_o.qos
  `oup_data_o__bpr.qos` = t39
  oup_data_o.qos = t39
  const t40 = gen_rr_arb_i_arbiter.data_o.region
  `oup_data_o__bpr.region` = t40
  oup_data_o.region = t40
  const t41 = gen_rr_arb_i_arbiter.data_o.user
  `oup_data_o__bpr.user` = t41
  oup_data_o.user = t41
  inp_ready_o = (gen_rr_arb_i_arbiter.gnt_o.e2 << 2) | (gen_rr_arb_i_arbiter.gnt_o.e1 << 1) | gen_rr_arb_i_arbiter.gnt_o.e0
  oup_valid_o = gen_rr_arb_i_arbiter.req_o
}
