pub mod cva6_fifo_v3_p2<FALL_THROUGH=0, FPGA_ALTERA=0, DATA_WIDTH=32, DEPTH=1, FPGA_EN=0, ADDR_DEPTH=1>::[timecheck=false](clk_i:Clock, rst_ni:U1, flush_i:U1, testmode_i:U1, data_i:(op:U4, paddr:U56, data:U64, size:U2), push_i:U1, pop_i:U1) -> (full_o:U1@[], empty_o:U1@[], usage_o:U1@[], data_o:(op:U4, paddr:U56, data:U64, size:U2)@[]) {
  reg read_pointer_q:U1:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg write_pointer_q:U1:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg status_cnt_q:U2:[initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  reg mem_q:[1]U126:[ordering="old", initial=0, reset_pin=rst_ni, async=true, negreset=true, clock_pin=clk_i]
  mut `data_ft_n.op` = 0
  mut `data_ft_n.paddr` = 0
  mut `data_ft_n.data` = 0
  mut `data_ft_n.size` = 0
  mut `data_ft_q.op` = 0
  mut `data_ft_q.paddr` = 0
  mut `data_ft_q.data` = 0
  mut `data_ft_q.size` = 0
  wire `data_ft_q__resolved.op`:U4 = nil
  wire `data_ft_q__resolved.paddr`:U56 = nil
  wire `data_ft_q__resolved.data`:U64 = nil
  wire `data_ft_q__resolved.size`:U2 = nil
  mut gate_clock:U1 = 0
  mut status_cnt_n:U2 = 0
  mut mem_n:U126 = 0
  wire `data_o__bpr.op`:U4 = nil
  wire `data_o__bpr.paddr`:U56 = nil
  wire `data_o__bpr.data`:U64 = nil
  wire `data_o__bpr.size`:U2 = nil
  mut first_word_q__wtmp:U1 = 0sb?
  const FifoDepth = DEPTH#[0..<32]
  gate_clock = 0ub?
  mut read_pointer_n = 0ub?
  mut write_pointer_n = 0ub?
  status_cnt_n = 0sb?
  mem_n = 0sb?
  const usage_o__w1 = status_cnt_q & 1
  mut _b2i_1 = if status_cnt_q == FifoDepth#[0..<2] { 1 } else { 0 }
  const full_o__w1 = _b2i_1
  mut _b2i_2 = if status_cnt_q == 0 { 1 } else { 0 }
  const empty_o__w1 = _b2i_2 & (~(FALL_THROUGH & push_i & 1)#[0]) & 1
  mut `data_o__bpo.op` = mem_q[0]#[0x7a..<0x7e]
  mut `data_o__bpo.paddr` = mem_q[0]#[0x42..<0x7a]
  mut `data_o__bpo.data` = mem_q[0]#[2..<0x42]
  mut `data_o__bpo.size` = mem_q[0]#[0..<2]
  status_cnt_n = status_cnt_q
  gate_clock = 1
  mem_n = mem_q#[0..<0x7e]
  write_pointer_n = write_pointer_q
  if (push_i != 0) and ((~full_o__w1#[0]) != 0) {
    const t44 = write_pointer_q * 0x7e
    mem_n#[t44..<(t44 + 0x7d + 1)] = ((data_i.op << 0x7a) | (data_i.paddr << 0x42) | (data_i.data << 2) | data_i.size)#[0..<0x7e]
    gate_clock = 0
    write_pointer_n = if write_pointer_q == ((FifoDepth & 1) - 1)#[0..<32] { 0 } else { (write_pointer_q + 1) & 1 }
    status_cnt_n = (status_cnt_q + 1)#[0..<2]
  }
  read_pointer_n = read_pointer_q
  if (pop_i != 0) and ((~empty_o__w1#[0]) != 0) {
    const t69 = (data_i.op << 0x7a) | (data_i.paddr << 0x42) | (data_i.data << 2) | data_i.size
    `data_ft_n.op` = t69#[0x7a..<0x7e]
    `data_ft_n.paddr` = t69#[0x42..<0x7a]
    `data_ft_n.data` = t69#[2..<0x42]
    `data_ft_n.size` = t69#[0..<2]
    read_pointer_n = if read_pointer_n == ((FifoDepth & 1) - 1)#[0..<32] { 0 } else { (read_pointer_q + 1) & 1 }
    status_cnt_n = (status_cnt_q - 1)#[0..<32]#[0..<2]
  }
  if (push_i != 0) and (pop_i != 0) and ((~full_o__w1#[0]) != 0) and ((~empty_o__w1#[0]) != 0) {
    status_cnt_n = status_cnt_q
  }
  if rst_ni != 0 {
    if flush_i != 0 {
      read_pointer_q = 0
      write_pointer_q = 0
      status_cnt_q = 0
    } else {
      read_pointer_q = read_pointer_n
      write_pointer_q = write_pointer_n
      status_cnt_q = status_cnt_n
    }
  }
  if rst_ni != 0 {
    if gate_clock == 0 {
      mem_q#[0..<0x7e] = mem_n
    }
  }
  `data_ft_q__resolved.op` = `data_ft_q.op`
  `data_ft_q__resolved.paddr` = `data_ft_q.paddr`
  `data_ft_q__resolved.data` = `data_ft_q.data`
  `data_ft_q__resolved.size` = `data_ft_q.size`
  const t100 = `data_o__bpo.op`
  `data_o__bpr.op` = t100
  data_o.op = t100
  const t101 = `data_o__bpo.paddr`
  `data_o__bpr.paddr` = t101
  data_o.paddr = t101
  const t102 = `data_o__bpo.data`
  `data_o__bpr.data` = t102
  data_o.data = t102
  const t103 = `data_o__bpo.size`
  `data_o__bpr.size` = t103
  data_o.size = t103
  full_o = full_o__w1
  empty_o = empty_o__w1
  usage_o = usage_o__w1
}
