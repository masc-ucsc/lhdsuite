pub mod cva6_fifo_v3_p2::[timecheck=false](clk_i:u1, rst_ni:u1, flush_i:u1, testmode_i:u1, data_i:(op:u4, paddr:u56, data:u64, size:u2), push_i:u1, pop_i:u1) -> (full_o:u1@[], empty_o:u1@[], usage_o:u1@[], data_o:(op:u4, paddr:u56, data:u64, size:u2)@[]) {
