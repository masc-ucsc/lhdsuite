    mem_n = mem_q
    gate_clock = 1
  }
  write_pointer_n = write_pointer_q
  status_cnt_n = status_cnt_q
  if (push_i != 0) and (((~full_o__w1) & 1) != 0) {
    {
      const t99 = write_pointer_q * 0x7e
      mem_n = ((mem_n & (~(0x3fffffffffffffffffffffffffffffff << t99))) | (((data_i.op << 0x7a) | (data_i.paddr << 0x42) | (data_i.data << 2) | data_i.size)#[0..=125] << t99))#[0..=125]
      gate_clock = 0
