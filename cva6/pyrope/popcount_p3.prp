const popcount_p4 = import("popcount_p4.popcount_p4")

pub mod popcount_p3<INPUT_WIDTH=16>::[timecheck=false](data_i:u16) -> (popcount_o:u5@[]) {
  const padded_input__w1 = data_i
  mut non_leaf_node_left_child = popcount_p4::[name=non_leaf_node_left_child](data_i = padded_input__w1#[8..=15])
  mut non_leaf_node_right_child = popcount_p4::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..=7])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
