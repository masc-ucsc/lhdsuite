const popcount_p4 = import("popcount_p4.popcount_p4")

pub mod popcount_p3<INPUT_WIDTH=16>::[timecheck=false](data_i:U16) -> (popcount_o:U5@[]) {
  const padded_input__w1 = data_i#[0..<16]
  mut non_leaf_node_left_child = popcount_p4::[name=non_leaf_node_left_child](data_i = padded_input__w1#[8..<16])
  mut non_leaf_node_right_child = popcount_p4::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..<8])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
