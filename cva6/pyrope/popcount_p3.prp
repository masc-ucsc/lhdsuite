const popcount_p4 = import("popcount_p4.popcount_p4")

pub mod popcount_p3::[timecheck=false](data_i:u16) -> (popcount_o:u5@[]) {
  const padded_input__w1 = data_i
  mut left_child = popcount_p4::[name=left_child](data_i = padded_input__w1#[8..=15])
  mut right_child = popcount_p4::[name=right_child](data_i = padded_input__w1#[0..=7])
  popcount_o = left_child + right_child
}
