pub mod sram_p2<DATA_WIDTH=0x80, USER_WIDTH=1, USER_EN=0, NUM_WORDS=0x100, SIM_INIT=0x6e6f6e65, OUT_REGS=0>::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wuser_i:u1, wdata_i:u128, be_i:u16) -> (ruser_o:u1@[], rdata_o:u128@[]) {
  mut ruser_aligned:u128 = 0
