const tc_sram_wrapper = import("tc_sram_wrapper.tc_sram_wrapper")

pub mod sram::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wuser_i:u1, wdata_i:u45, be_i:u6) -> (ruser_o:u1@[], rdata_o:u45@[]) {
  mut rdata_aligned__wtmp:u64 = 0sb?
  wire rdata_aligned:u64
  mut wdata_aligned__w2 = 0
  wdata_aligned__w2#[0..=44] = wdata_i
  mut be_aligned__w2 = 0
  be_aligned__w2#[0..=7] = be_i
  const rdata_o__w1 = rdata_aligned#[0..=44]
  mut i_tc_sram_wrapper = tc_sram_wrapper::[name=i_tc_sram_wrapper](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, we_i = we_i, addr_i = addr_i, wdata_i = wdata_aligned__w2#[0..=63], be_i = be_aligned__w2#[0..=7])
  rdata_aligned__wtmp#[0..=63] = i_tc_sram_wrapper#[0..=63]
  rdata_aligned = rdata_aligned__wtmp
  ruser_o = 0
  rdata_o = rdata_o__w1
}
