const tc_sram = import("tc_sram.tc_sram")

pub mod tc_sram_wrapper::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u1, we_i:u1, addr_i:u8, wdata_i:u64, be_i:u8) -> (rdata_o:u64@[]) {
  mut i_tc_sram = tc_sram::[name=i_tc_sram](clk_i = clk_i, rst_ni = rst_ni, req_i = req_i, we_i = we_i, addr_i = addr_i, wdata_i = wdata_i, be_i = be_i)
  rdata_o = i_tc_sram
}
