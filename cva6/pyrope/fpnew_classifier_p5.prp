pub comb fpnew_classifier_p5::[timecheck=false](operands_i:u64, is_boxed_i:u1) -> (info_o:u8) {
  wire gen_num_values_0_is_boxed:u1
  wire gen_num_values_0_is_normal:u1
  wire gen_num_values_0_is_zero:u1
  wire gen_num_values_0_is_subnormal:u1
  wire gen_num_values_0_is_inf:u1
  wire gen_num_values_0_is_nan:u1
  wire gen_num_values_0_is_signalling:u1
  wire gen_num_values_0_is_quiet:u1
  info_o = 0sb?
  mut `gen_num_values_0_value.sign` = (operands_i >> 63) & 1
  mut `gen_num_values_0_value.exponent` = operands_i#[52..=62]
  mut `gen_num_values_0_value.mantissa` = operands_i#[0..=51]
  gen_num_values_0_is_boxed = is_boxed_i & 1
  gen_num_values_0_is_normal = unsigned((gen_num_values_0_is_boxed != 0) and (`gen_num_values_0_value.exponent` != 0) and (`gen_num_values_0_value.exponent` != 0x7ff))
  gen_num_values_0_is_zero = unsigned((gen_num_values_0_is_boxed != 0) and (`gen_num_values_0_value.exponent` == 0) and (`gen_num_values_0_value.mantissa` == 0))
  gen_num_values_0_is_subnormal = unsigned((gen_num_values_0_is_boxed != 0) and (`gen_num_values_0_value.exponent` == 0) and (gen_num_values_0_is_zero == 0))
  gen_num_values_0_is_inf = unsigned((gen_num_values_0_is_boxed != 0) and (`gen_num_values_0_value.exponent` == 0x7ff) and (`gen_num_values_0_value.mantissa` == 0))
  gen_num_values_0_is_nan = unsigned((gen_num_values_0_is_boxed == 0) or ((`gen_num_values_0_value.exponent` == 0x7ff) and (`gen_num_values_0_value.mantissa` != 0)))
  gen_num_values_0_is_signalling = unsigned((gen_num_values_0_is_boxed != 0) and (gen_num_values_0_is_nan != 0) and (((`gen_num_values_0_value.mantissa` >> 51) & 1) == 0))
  gen_num_values_0_is_quiet = unsigned((gen_num_values_0_is_nan != 0) and (gen_num_values_0_is_signalling == 0))
  mut info_o__w1 = info_o
  info_o__w1#[7] = gen_num_values_0_is_normal & 1
  mut info_o__w2 = info_o__w1
  info_o__w2#[6] = gen_num_values_0_is_subnormal & 1
  mut info_o__w3 = info_o__w2
  info_o__w3#[5] = gen_num_values_0_is_zero & 1
  mut info_o__w4 = info_o__w3
  info_o__w4#[4] = gen_num_values_0_is_inf & 1
  mut info_o__w5 = info_o__w4
  info_o__w5#[3] = gen_num_values_0_is_nan & 1
  mut info_o__w6 = info_o__w5
  info_o__w6#[2] = gen_num_values_0_is_signalling & 1
  mut info_o__w7 = info_o__w6
  info_o__w7#[1] = gen_num_values_0_is_quiet & 1
  mut info_o__w8 = info_o__w7
  info_o__w8#[0] = gen_num_values_0_is_boxed & 1
  info_o = info_o__w8
}
