pub mod cvxif_compressed_if_driver<>::[timecheck=false](clk_i:Clock, rst_ni:U1, flush_i:U1, hart_id_i:U64, is_compressed_i:U1, is_illegal_i:U1, instruction_i:U32, stall_i:U1, compressed_ready_i:U1, compressed_resp_i:(instr:U32, accept:U1)) -> (is_compressed_o:U1@[], is_illegal_o:U1@[], instruction_o:U32@[], stall_o:U1@[], compressed_valid_o:U1@[], compressed_req_o:(instr:U16, hartid:U64)@[]) {
  mut _b2i_3 = 0
  mut _mux_1:U32 = 0
  mut _mux_2:U1 = 0
  wire `compressed_req_o__bpr.instr`:U16 = nil
  mut `compressed_req_o__bpo.instr` = 0
  wire `compressed_req_o__bpr.hartid`:U64 = nil
  mut `compressed_req_o__bpo.hartid` = 0
  is_compressed_o = 0ub?
  is_illegal_o = 0ub?
  instruction_o = 0sb?
  stall_o = 0ub?
  compressed_valid_o = 0ub?
  `compressed_req_o__bpo.instr` = 0
  `compressed_req_o__bpo.hartid` = hart_id_i
  is_illegal_o = is_illegal_i
  is_compressed_o = is_compressed_i
  instruction_o = instruction_i
  compressed_valid_o = 0
  stall_o = stall_i
  if is_illegal_i != 0 {
    compressed_valid_o = is_illegal_i
    `compressed_req_o__bpo.instr` = instruction_i#[0..<16]
    is_illegal_o = ~compressed_resp_i.accept#[0]
    _mux_1 = if compressed_resp_i.accept != 0 { compressed_resp_i.instr#[0..<32] } else { instruction_i#[0..<32] }
    instruction_o = _mux_1
    _mux_2 = if compressed_resp_i.accept != 0 { 0 } else { is_compressed_i & 1 }
    is_compressed_o = _mux_2
    if (~stall_i) != 0 {
      _b2i_3 = if (compressed_valid_o != 0) and ((~compressed_ready_i) != 0) { 1 } else { 0 }
      stall_o = _b2i_3
    }
  }
  if flush_i != 0 {
    compressed_valid_o = 0
    `compressed_req_o__bpo.instr` = 0
    `compressed_req_o__bpo.hartid` = hart_id_i
  }
  const t22 = `compressed_req_o__bpo.instr`
  `compressed_req_o__bpr.instr` = t22
  compressed_req_o.instr = t22
  const t23 = `compressed_req_o__bpo.hartid`
  `compressed_req_o__bpr.hartid` = t23
  compressed_req_o.hartid = t23
}
