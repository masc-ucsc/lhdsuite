const popcount_p3 = import("popcount_p3.popcount_p3")

pub mod popcount_p2<INPUT_WIDTH=32>::[timecheck=false](data_i:u32) -> (popcount_o:u6@[]) {
  const padded_input__w1 = data_i
  mut non_leaf_node_left_child = popcount_p3::[name=non_leaf_node_left_child](data_i = padded_input__w1#[16..=31])
  mut non_leaf_node_right_child = popcount_p3::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..=15])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
