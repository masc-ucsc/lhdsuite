const popcount_p3 = import("popcount_p3.popcount_p3")

pub mod popcount_p2::[timecheck=false](data_i:u32) -> (popcount_o:u6@[]) {
  const padded_input__w1 = data_i
  mut left_child = popcount_p3::[name=left_child](data_i = padded_input__w1#[16..=31])
  mut right_child = popcount_p3::[name=right_child](data_i = padded_input__w1#[0..=15])
  popcount_o = left_child + right_child
}
