const popcount_p3 = import("popcount_p3.popcount_p3")

pub mod popcount_p2<INPUT_WIDTH=32>::[timecheck=false](data_i:U32) -> (popcount_o:U6@[]) {
  const padded_input__w1 = data_i#[0..<32]
  mut non_leaf_node_left_child = popcount_p3::[name=non_leaf_node_left_child](data_i = padded_input__w1#[16..<32])
  mut non_leaf_node_right_child = popcount_p3::[name=non_leaf_node_right_child](data_i = padded_input__w1#[0..<16])
  popcount_o = non_leaf_node_left_child + non_leaf_node_right_child
}
