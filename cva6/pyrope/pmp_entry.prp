        }
        if (size > 3) and (8 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 8) & 1) == 1)
        }
        if (size > 3) and (9 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 9) & 1) == 1)
        }
        if (size > 3) and (10 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 10) & 1) == 1)
        }
        if (size > 3) and (11 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 11) & 1) == 1)
        }
        if (size > 3) and (12 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 12) & 1) == 1)
        }
        if (size > 3) and (13 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 13) & 1) == 1)
        }
        if (size > 3) and (14 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 14) & 1) == 1)
        }
        if (size > 3) and (15 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 15) & 1) == 1)
        }
        if (size > 3) and (16 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 16) & 1) == 1)
        }
        if (size > 3) and (17 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 17) & 1) == 1)
        }
        if (size > 3) and (18 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 18) & 1) == 1)
        }
        if (size > 3) and (19 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 19) & 1) == 1)
        }
        if (size > 3) and (20 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 20) & 1) == 1)
        }
        if (size > 3) and (21 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 21) & 1) == 1)
        }
        if (size > 3) and (22 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 22) & 1) == 1)
        }
        if (size > 3) and (23 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 23) & 1) == 1)
        }
        if (size > 3) and (24 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 24) & 1) == 1)
        }
        if (size > 3) and (25 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 25) & 1) == 1)
        }
        if (size > 3) and (26 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 26) & 1) == 1)
        }
        if (size > 3) and (27 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 27) & 1) == 1)
        }
        if (size > 3) and (28 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 28) & 1) == 1)
        }
        if (size > 3) and (29 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 29) & 1) == 1)
        }
        if (size > 3) and (30 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 30) & 1) == 1)
        }
        if (size > 3) and (31 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 31) & 1) == 1)
        }
        if (size > 3) and (32 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 32) & 1) == 1)
        }
        if (size > 3) and (33 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 33) & 1) == 1)
        }
        if (size > 3) and (34 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 34) & 1) == 1)
        }
        if (size > 3) and (35 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 35) & 1) == 1)
        }
        if (size > 3) and (36 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 36) & 1) == 1)
        }
        if (size > 3) and (37 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 37) & 1) == 1)
        }
        if (size > 3) and (38 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 38) & 1) == 1)
        }
        if (size > 3) and (39 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 39) & 1) == 1)
        }
        if (size > 3) and (40 <= (size - 4)#[0..=31]) {
