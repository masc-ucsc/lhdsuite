        }
        if (size > 3) and (53 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 53) & 1) == 1)
        }
      }
      if size < 55 {
        if (base + (1 << size)#[0..=55])#[0..=55] > base {
          if match_o == 0 {
            assert((addr_i >= (base + (1 << size)#[0..=55])#[0..=55]) or (addr_i < base))
          } else {
            assert((addr_i < (base + (1 << size)#[0..=55])#[0..=55]) and (addr_i >= base))
          }
        } elif match_o == 0 {
          assert(((addr_i - (1 << size)#[0..=55])#[0..=55] >= base) or (addr_i < base))
        } else {
          assert(((addr_i - (1 << size)#[0..=55])#[0..=55] < base) and (addr_i >= base))
        }
      }
