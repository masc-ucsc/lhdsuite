const lzc_p7 = import("lzc_p7.lzc_p7")
const riscv = import("riscv")

pub mod pmp_entry::[timecheck=false](addr_i:u56, conf_addr_i:u54, conf_addr_prev_i:u54, conf_addr_mode_i:u2) -> (match_o:u1@[]) {
  mut _mux_1:u1 = 0
  mut base:u56 = 0
  mut mask:u56 = 0
  mut size:u32 = 0
  base = 0sb?
  mask = 0sb?
  size = 0sb?
  match_o = 0ub?
  const conf_addr_n__w1 = (3 << 54) | (~conf_addr_i)#[0..=53]
  mut i_lzc = lzc_p7::[name=i_lzc](`in_i.e55` = (conf_addr_n__w1 >> 55) & 1, `in_i.e54` = (conf_addr_n__w1 >> 54) & 1, `in_i.e53` = (conf_addr_n__w1 >> 53) & 1, `in_i.e52` = (conf_addr_n__w1 >> 52) & 1, `in_i.e51` = (conf_addr_n__w1 >> 51) & 1, `in_i.e50` = (conf_addr_n__w1 >> 50) & 1, `in_i.e49` = (conf_addr_n__w1 >> 49) & 1, `in_i.e48` = (conf_addr_n__w1 >> 48) & 1, `in_i.e47` = (conf_addr_n__w1 >> 47) & 1, `in_i.e46` = (conf_addr_n__w1 >> 46) & 1, `in_i.e45` = (conf_addr_n__w1 >> 45) & 1, `in_i.e44` = (conf_addr_n__w1 >> 44) & 1, `in_i.e43` = (conf_addr_n__w1 >> 43) & 1, `in_i.e42` = (conf_addr_n__w1 >> 42) & 1, `in_i.e41` = (conf_addr_n__w1 >> 41) & 1, `in_i.e40` = (conf_addr_n__w1 >> 40) & 1, `in_i.e39` = (conf_addr_n__w1 >> 39) & 1, `in_i.e38` = (conf_addr_n__w1 >> 38) & 1, `in_i.e37` = (conf_addr_n__w1 >> 37) & 1, `in_i.e36` = (conf_addr_n__w1 >> 36) & 1, `in_i.e35` = (conf_addr_n__w1 >> 35) & 1, `in_i.e34` = (conf_addr_n__w1 >> 34) & 1, `in_i.e33` = (conf_addr_n__w1 >> 33) & 1, `in_i.e32` = (conf_addr_n__w1 >> 32) & 1, `in_i.e31` = (conf_addr_n__w1 >> 31) & 1, `in_i.e30` = (conf_addr_n__w1 >> 30) & 1, `in_i.e29` = (conf_addr_n__w1 >> 29) & 1, `in_i.e28` = (conf_addr_n__w1 >> 28) & 1, `in_i.e27` = (conf_addr_n__w1 >> 27) & 1, `in_i.e26` = (conf_addr_n__w1 >> 26) & 1, `in_i.e25` = (conf_addr_n__w1 >> 25) & 1, `in_i.e24` = (conf_addr_n__w1 >> 24) & 1, `in_i.e23` = (conf_addr_n__w1 >> 23) & 1, `in_i.e22` = (conf_addr_n__w1 >> 22) & 1, `in_i.e21` = (conf_addr_n__w1 >> 21) & 1, `in_i.e20` = (conf_addr_n__w1 >> 20) & 1, `in_i.e19` = (conf_addr_n__w1 >> 19) & 1, `in_i.e18` = (conf_addr_n__w1 >> 18) & 1, `in_i.e17` = (conf_addr_n__w1 >> 17) & 1, `in_i.e16` = (conf_addr_n__w1 >> 16) & 1, `in_i.e15` = (conf_addr_n__w1 >> 15) & 1, `in_i.e14` = (conf_addr_n__w1 >> 14) & 1, `in_i.e13` = (conf_addr_n__w1 >> 13) & 1, `in_i.e12` = (conf_addr_n__w1 >> 12) & 1, `in_i.e11` = (conf_addr_n__w1 >> 11) & 1, `in_i.e10` = (conf_addr_n__w1 >> 10) & 1, `in_i.e9` = (conf_addr_n__w1 >> 9) & 1, `in_i.e8` = (conf_addr_n__w1 >> 8) & 1, `in_i.e7` = (conf_addr_n__w1 >> 7) & 1, `in_i.e6` = (conf_addr_n__w1 >> 6) & 1, `in_i.e5` = (conf_addr_n__w1 >> 5) & 1, `in_i.e4` = (conf_addr_n__w1 >> 4) & 1, `in_i.e3` = (conf_addr_n__w1 >> 3) & 1, `in_i.e2` = (conf_addr_n__w1 >> 2) & 1, `in_i.e1` = (conf_addr_n__w1 >> 1) & 1, `in_i.e0` = conf_addr_n__w1 & 1)
  match conf_addr_mode_i {
    == riscv.TOR {
      base = 0
      mask = 0
      size = 0
      match_o = if (addr_i >= (conf_addr_prev_i << 2)#[0..=55]) and (addr_i < (conf_addr_i << 2)#[0..=55]) { 1 } else { 0 }
      if match_o == 0 {
        assert((addr_i >= (conf_addr_i << 2)#[0..=55]) or (addr_i < (conf_addr_prev_i << 2)#[0..=55]))
      } else {
        assert((addr_i < (conf_addr_i << 2)#[0..=55]) and (addr_i >= (conf_addr_prev_i << 2)#[0..=55]))
      }
    }
    == riscv.NAPOT {
      size = (i_lzc.cnt_o#[0..=5] + 3)#[0..=31]
      mask = (0xffffffffffffff << size)#[0..=55]
      base = (conf_addr_i << 2)#[0..=55] & mask
      _mux_1 = if (addr_i & mask) == base { 1 } else { 0 }
      match_o = _mux_1
      assert(size >= 2)
      if conf_addr_mode_i == riscv.NAPOT {
        assert(size > 2)
        if size < 54 {
          assert((((conf_addr_i << 1) >> ((size - 3)#[0..=31] + 1)) & 1) == 0)
        }
        if (size > 3) and (0 <= (size - 4)#[0..=31]) {
          assert((conf_addr_i & 1) == 1)
        }
        if (size > 3) and (1 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 1) & 1) == 1)
        }
        if (size > 3) and (2 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 2) & 1) == 1)
        }
        if (size > 3) and (3 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 3) & 1) == 1)
        }
        if (size > 3) and (4 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 4) & 1) == 1)
        }
        if (size > 3) and (5 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 5) & 1) == 1)
        }
        if (size > 3) and (6 <= (size - 4)#[0..=31]) {
          assert(((conf_addr_i >> 6) & 1) == 1)
        }
        if (size > 3) and (7 <= (size - 4)#[0..=31]) {
