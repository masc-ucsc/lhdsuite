  if _brk_9 == 0 {
    req_o = req_i#[24..=31]
    id_d = 8
    gnt_o#[3] = 1
    addr_o = addr_i#[36..=47]
    `be_o__bpo.tag` = be_i#[90..=119]#[24..=29]
    `be_o__bpo.data` = be_i#[90..=119]#[8..=23]
    `be_o__bpo.vldrty` = be_i#[90..=119]#[0..=7]
    we_o = (we_i >> 3) & 1
    `wdata_o__bpo.tag` = wdata_i#[522..=695]#[130..=173]
    `wdata_o__bpo.data` = wdata_i#[522..=695]#[2..=129]
    `wdata_o__bpo.valid` = (wdata_i#[522..=695] >> 1) & 1
    `wdata_o__bpo.dirty` = wdata_i#[522..=695] & 1
    if req_i#[24..=31] != 0 {
