  }
  if _brk_9 == 0 {
    req_o = req_i#[32..=39]
    id_d = 16
    gnt_o#[4] = 1
    addr_o = addr_i#[48..=59]
    `be_o__bpo.tag` = be_i#[120..=149]#[24..=29]
    `be_o__bpo.data` = be_i#[120..=149]#[8..=23]
    `be_o__bpo.vldrty` = be_i#[120..=149]#[0..=7]
    we_o = (we_i >> 4) & 1
    `wdata_o__bpo.tag` = wdata_i#[696..=869]#[130..=173]
    `wdata_o__bpo.data` = wdata_i#[696..=869]#[2..=129]
    `wdata_o__bpo.valid` = (wdata_i#[696..=869] >> 1) & 1
    `wdata_o__bpo.dirty` = wdata_i#[696..=869] & 1
    if req_i#[32..=39] != 0 {
