pub mod tag_cmp::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u40, addr_i:u60, wdata_i:u870, we_i:u5, be_i:u150, tag_i:u220, rdata_i:u1392) -> (gnt_o:u5@[], rdata_o:u1392@[], hit_way_o:(e7:u1, e6:u1, e5:u1, e4:u1, e3:u1, e2:u1, e1:u1, e0:u1)@[], req_o:u8@[], addr_o:u12@[], wdata_o:(tag:u44, data:u128, valid:u1, dirty:u1)@[], we_o:u1@[], be_o:(tag:u6, data:u16, vldrty:u8)@[]) {
  reg id_q:u5:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
