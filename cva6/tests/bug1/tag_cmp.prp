pub mod tag_cmp::[timecheck=false](clk_i:u1, rst_ni:u1, req_i:u24, addr_i:u36, wdata_i:u522, we_i:u3, be_i:u90, tag_i:u132, rdata_i:u1392) -> (gnt_o:u3@[], rdata_o:u1392@[], hit_way_o:u8@[], req_o:u8@[], addr_o:u12@[], wdata_o:(tag:u44, data:u128, valid:u1, dirty:u1)@[], we_o:u1@[], be_o:(tag:u6, data:u16, vldrty:u8)@[]) {
  reg id_q:u3:[init=0, reset_pin=ref rst_ni, async=true, negreset=true, clock_pin=ref clk_i]
  mut `wdata_o__bpo.tag` = 0
  mut `wdata_o__bpo.data` = 0
  mut `wdata_o__bpo.valid` = 0
  mut `wdata_o__bpo.dirty` = 0
  mut `be_o__bpo.tag` = 0
  mut `be_o__bpo.data` = 0
  mut `be_o__bpo.vldrty` = 0
  mut id_d = 0
  mut _brk_9 = 0
  addr_o = 0ub????????????
  gnt_o = 0ub???
  hit_way_o = 0ub????????
  rdata_o = 0ub????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
  req_o = 0ub????????
  we_o = 0ub?
  mut sel_tag = if (id_q & 1) != 0 { tag_i#[0..=43] } else { 0 }
  if ((id_q >> 1) & 1) != 0 {
    sel_tag = tag_i#[44..=87]
  }
  if ((id_q >> 2) & 1) != 0 {
    sel_tag = tag_i#[88..=131]
  }
  mut _mux_1:u1 = if sel_tag == rdata_i#[0..=173]#[130..=173] { 1 } else { 0 }  // BUG(bug1): should be the way's valid bit, so an INVALID way can hit
  mut hit_way_o__w1 = hit_way_o
  hit_way_o__w1#[0..=0] = _mux_1
  mut _mux_2:u1 = if sel_tag == rdata_i#[174..=347]#[130..=173] { (rdata_i#[174..=347] >> 1) & 1 & 1 } else { 0 }
  mut hit_way_o__w2 = hit_way_o__w1
  hit_way_o__w2#[1..=1] = _mux_2
  mut _mux_3:u1 = if sel_tag == rdata_i#[348..=521]#[130..=173] { (rdata_i#[348..=521] >> 1) & 1 & 1 } else { 0 }
  mut hit_way_o__w3 = hit_way_o__w2
  hit_way_o__w3#[2..=2] = _mux_3
  mut _mux_4:u1 = if sel_tag == rdata_i#[522..=695]#[130..=173] { (rdata_i#[522..=695] >> 1) & 1 & 1 } else { 0 }
  mut hit_way_o__w4 = hit_way_o__w3
  hit_way_o__w4#[3..=3] = _mux_4
  mut _mux_5:u1 = if sel_tag == rdata_i#[696..=869]#[130..=173] { (rdata_i#[696..=869] >> 1) & 1 & 1 } else { 0 }
  mut hit_way_o__w5 = hit_way_o__w4
  hit_way_o__w5#[4..=4] = _mux_5
  mut _mux_6:u1 = if sel_tag == rdata_i#[870..=1043]#[130..=173] { (rdata_i#[870..=1043] >> 1) & 1 & 1 } else { 0 }
  mut hit_way_o__w6 = hit_way_o__w5
  hit_way_o__w6#[5..=5] = _mux_6
  mut _mux_7:u1 = if sel_tag == rdata_i#[1044..=1217]#[130..=173] { (rdata_i#[1044..=1217] >> 1) & 1 & 1 } else { 0 }
  mut hit_way_o__w7 = hit_way_o__w6
  hit_way_o__w7#[6..=6] = _mux_7
  mut _mux_8:u1 = if sel_tag == rdata_i#[1218..=1391]#[130..=173] { (rdata_i#[1218..=1391] >> 1) & 1 & 1 } else { 0 }
  mut hit_way_o__w8 = hit_way_o__w7
  hit_way_o__w8#[7..=7] = _mux_8
  we_o = 0
  gnt_o = 0
  req_o = 0
  addr_o = 0
  _brk_9 = 0
  `be_o__bpo.data` = 0
  `be_o__bpo.tag` = 0
  `be_o__bpo.vldrty` = 0
  id_d = 0
  `wdata_o__bpo.data` = 0
  `wdata_o__bpo.dirty` = 0
  `wdata_o__bpo.tag` = 0
  `wdata_o__bpo.valid` = 0
  {
    gnt_o = 1
    gnt_o#[0..=0] = 1
    addr_o = addr_i#[0..=11]
    `be_o__bpo.data` = be_i#[0..=29]#[8..=23]
    `be_o__bpo.tag` = be_i#[0..=29]#[24..=29]
    `be_o__bpo.vldrty` = be_i#[0..=29]#[0..=7]
    id_d = 1
    req_o = req_i#[0..=7]
    `wdata_o__bpo.data` = wdata_i#[0..=173]#[2..=129]
    `wdata_o__bpo.dirty` = wdata_i#[0..=173] & 1
    `wdata_o__bpo.tag` = wdata_i#[0..=173]#[130..=173]
    `wdata_o__bpo.valid` = (wdata_i#[0..=173] >> 1) & 1
    we_o = we_i & 1
    if req_i#[0..=7] != 0 {
      _brk_9 = 1
    }
  }
  if _brk_9 == 0 {
    gnt_o = 3
    gnt_o#[1..=1] = 1
    addr_o = addr_i#[12..=23]
    `be_o__bpo.data` = be_i#[30..=59]#[8..=23]
    `be_o__bpo.tag` = be_i#[30..=59]#[24..=29]
    `be_o__bpo.vldrty` = be_i#[30..=59]#[0..=7]
    id_d = 2
    req_o = req_i#[8..=15]
    `wdata_o__bpo.data` = wdata_i#[174..=347]#[2..=129]
    `wdata_o__bpo.dirty` = wdata_i#[174..=347] & 1
    `wdata_o__bpo.tag` = wdata_i#[174..=347]#[130..=173]
    `wdata_o__bpo.valid` = (wdata_i#[174..=347] >> 1) & 1
    we_o = (we_i >> 1) & 1
    if req_i#[8..=15] != 0 {
      _brk_9 = 1
    }
  }
  if _brk_9 == 0 {
    addr_o = addr_i#[24..=35]
    `be_o__bpo.data` = be_i#[60..=89]#[8..=23]
    `be_o__bpo.tag` = be_i#[60..=89]#[24..=29]
    `be_o__bpo.vldrty` = be_i#[60..=89]#[0..=7]
    gnt_o#[2..=2] = 1
    id_d = 4
    req_o = req_i#[16..=23]
    `wdata_o__bpo.data` = wdata_i#[348..=521]#[2..=129]
    `wdata_o__bpo.dirty` = wdata_i#[348..=521] & 1
    `wdata_o__bpo.tag` = wdata_i#[348..=521]#[130..=173]
    `wdata_o__bpo.valid` = (wdata_i#[348..=521] >> 1) & 1
    we_o = (we_i >> 2) & 1
    if req_i#[16..=23] != 0 {
      _brk_9 = 1
    }
  }
  id_q = id_d
  be_o.data = `be_o__bpo.data`
  be_o.tag = `be_o__bpo.tag`
  be_o.vldrty = `be_o__bpo.vldrty`
  hit_way_o = hit_way_o__w8
  rdata_o = rdata_i
  wdata_o.data = `wdata_o__bpo.data`
  wdata_o.dirty = `wdata_o__bpo.dirty`
  wdata_o.tag = `wdata_o__bpo.tag`
  wdata_o.valid = `wdata_o__bpo.valid`
}
