  sel_tag = if (id_q & 1) != 0 { tag_i#[0..=43] } else { 0 }
  if ((id_q >> 1) & 1) != 0 {
    sel_tag = tag_i#[44..=87]
  }
  if ((id_q >> 2) & 1) != 0 {
    sel_tag = tag_i#[88..=131]
  }
  if ((id_q >> 3) & 1) != 0 {
    sel_tag = tag_i#[132..=175]
  }
  if ((id_q >> 4) & 1) != 0 {
    sel_tag = tag_i#[176..=219]
  }
  mut _mux_1:u1 = if sel_tag == rdata_i#[0..=173]#[130..=173] { 1 } else { 0 }  // BUG(bug1): should be the way's valid bit, so an INVALID way can hit
  mut `hit_way_o__bpo.e0` = _mux_1
  mut _mux_2:u1 = if sel_tag == rdata_i#[174..=347]#[130..=173] { (rdata_i#[174..=347] >> 1) & 1 } else { 0 }
  mut `hit_way_o__bpo.e1` = _mux_2
  mut _mux_3:u1 = if sel_tag == rdata_i#[348..=521]#[130..=173] { (rdata_i#[348..=521] >> 1) & 1 } else { 0 }
  mut `hit_way_o__bpo.e2` = _mux_3
  mut _mux_4:u1 = if sel_tag == rdata_i#[522..=695]#[130..=173] { (rdata_i#[522..=695] >> 1) & 1 } else { 0 }
  mut `hit_way_o__bpo.e3` = _mux_4
  mut _mux_5:u1 = if sel_tag == rdata_i#[696..=869]#[130..=173] { (rdata_i#[696..=869] >> 1) & 1 } else { 0 }
  mut `hit_way_o__bpo.e4` = _mux_5
  mut _mux_6:u1 = if sel_tag == rdata_i#[870..=1043]#[130..=173] { (rdata_i#[870..=1043] >> 1) & 1 } else { 0 }
  mut `hit_way_o__bpo.e5` = _mux_6
  mut _mux_7:u1 = if sel_tag == rdata_i#[1044..=1217]#[130..=173] { (rdata_i#[1044..=1217] >> 1) & 1 } else { 0 }
  mut `hit_way_o__bpo.e6` = _mux_7
  mut _mux_8:u1 = if sel_tag == rdata_i#[1218..=1391]#[130..=173] { (rdata_i#[1218..=1391] >> 1) & 1 } else { 0 }
  mut `hit_way_o__bpo.e7` = _mux_8
  _brk_9 = 0
  gnt_o = 0
  addr_o = 0
  req_o = 0
  id_d = 0
  we_o = 0
  {
    req_o = req_i#[0..=7]
    id_d = 1
    gnt_o = 1
    gnt_o#[0] = 1
    addr_o = addr_i#[0..=11]
    `be_o__bpo.tag` = be_i#[0..=29]#[24..=29]
    `be_o__bpo.data` = be_i#[0..=29]#[8..=23]
    `be_o__bpo.vldrty` = be_i#[0..=29]#[0..=7]
    we_o = we_i & 1
    `wdata_o__bpo.tag` = wdata_i#[0..=173]#[130..=173]
    `wdata_o__bpo.data` = wdata_i#[0..=173]#[2..=129]
    `wdata_o__bpo.valid` = (wdata_i#[0..=173] >> 1) & 1
    `wdata_o__bpo.dirty` = wdata_i#[0..=173] & 1
    if req_i#[0..=7] != 0 {
      _brk_9 = 1
    }
  }
  if _brk_9 == 0 {
    req_o = req_i#[8..=15]
    id_d = 2
    gnt_o = 3
    gnt_o#[1] = 1
    addr_o = addr_i#[12..=23]
    `be_o__bpo.tag` = be_i#[30..=59]#[24..=29]
    `be_o__bpo.data` = be_i#[30..=59]#[8..=23]
    `be_o__bpo.vldrty` = be_i#[30..=59]#[0..=7]
    we_o = (we_i >> 1) & 1
    `wdata_o__bpo.tag` = wdata_i#[174..=347]#[130..=173]
    `wdata_o__bpo.data` = wdata_i#[174..=347]#[2..=129]
    `wdata_o__bpo.valid` = (wdata_i#[174..=347] >> 1) & 1
    `wdata_o__bpo.dirty` = wdata_i#[174..=347] & 1
    if req_i#[8..=15] != 0 {
      _brk_9 = 1
    }
  }
  if _brk_9 == 0 {
    req_o = req_i#[16..=23]
    id_d = 4
    gnt_o#[2] = 1
    addr_o = addr_i#[24..=35]
    `be_o__bpo.tag` = be_i#[60..=89]#[24..=29]
    `be_o__bpo.data` = be_i#[60..=89]#[8..=23]
    `be_o__bpo.vldrty` = be_i#[60..=89]#[0..=7]
    we_o = (we_i >> 2) & 1
    `wdata_o__bpo.tag` = wdata_i#[348..=521]#[130..=173]
    `wdata_o__bpo.data` = wdata_i#[348..=521]#[2..=129]
    `wdata_o__bpo.valid` = (wdata_i#[348..=521] >> 1) & 1
    `wdata_o__bpo.dirty` = wdata_i#[348..=521] & 1
    if req_i#[16..=23] != 0 {
