// Assert/assume collateral for CVA6's integer ALU. The bench uses this real
// architectural unit instead of the old tag_cmp all-miss smoke: it is in the
// whole cva6 top's cone, and ADD/SUB exercise the main 64-bit datapath.
//
// Operation values 0 and 1 are ariane_pkg.ADD and ariane_pkg.SUB. Keeping the
// numeric pins here avoids importing a package solely to name two constants;
// the design itself still uses the generated package constants.
const dut = import("alu.alu")

formal alu.add {
  mut acc = dut
  assume_nocheck(acc.fu_data_i.operation == 0)
  assert(acc.result_o == (acc.fu_data_i.operand_a + acc.fu_data_i.operand_b)#[0..=63],
         "ADD returns the 64-bit sum")
}

formal alu.sub {
  mut acc = dut
  assume_nocheck(acc.fu_data_i.operation == 1)
  assert(acc.result_o == (acc.fu_data_i.operand_a - acc.fu_data_i.operand_b)#[0..=63],
         "SUB returns the 64-bit difference")
}
