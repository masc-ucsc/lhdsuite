const controller = import("lg:GatedTracker")

test gated_tracker.commands(cycles:U32=32000) {
  mut dut = controller
  tick cycles {
    const phase = clock % 32
    dut.reset = phase == 0 or phase == 16
    dut.io_gate_write = U1(phase == 1 or phase == 5 or phase == 12 or phase == 17 or phase == 29)
    dut.io_gate_value = U1(phase == 29)
    dut.io_alloc = U1(phase == 1 or phase == 2)
    dut.io_bytes = if phase == 1 { 8 } else { 4 }
    dut.io_tag = if phase == 1 { 3 } else { 13 }
    dut.io_returned = U1(phase == 3 or phase == 4 or phase == 9)
    dut.io_returned_id = U1(phase == 4)
    dut.io_returned_bytes = if phase == 3 { 3 } elif phase == 4 { 4 } else { 5 }
    dut.io_accept = U1(phase == 8 or phase == 11)
    step
    const busy = phase >= 1 and phase <= 10
    const ready = !((phase >= 2 and phase <= 7) or (phase >= 12 and phase <= 15) or (phase >= 17 and phase <= 28))
    const second = phase >= 4 and phase <= 7
    const first = phase == 9 or phase == 10
    assert(dut.io_busy == U1(busy), "in-flight commands survive a gate write")
    assert(dut.io_ready == U1(ready), "allocation follows capacity, reset and wake")
    assert(dut.io_valid == U1(second or first), "completion waits for accept")
    assert(dut.io_out_id == U1(second), "completed command ID")
    if second { assert(dut.io_out_tag == 13, "second tag held during backpressure") }
    elif first { assert(dut.io_out_tag == 3, "first tag after split return") }
    else { assert(dut.io_out_tag == 0, "invalid payload masked") }
  }
}
