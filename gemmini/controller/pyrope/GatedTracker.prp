const tracker = import("DMACommandTracker.DMACommandTracker")

pub mod GatedTracker::[timecheck=false](`clock`:Clock, `reset`:Reset, io_gate_write:U1, io_gate_value:U1,
    io_alloc:U1, io_bytes:U8, io_tag:U4, io_returned:U1, io_returned_id:U1, io_returned_bytes:U8,
    io_accept:U1) -> (io_ready:U1@[], io_id:U1@[], io_valid:U1@[], io_out_id:U1@[], io_out_tag:U4@[], io_busy:U1@[]) {
  reg running:U1:[clock_pin=`clock`, reset_pin=`reset`] = 1
  io_ready = 0
  io_id = 0
  io_valid = 0
  io_out_id = 0
  io_out_tag = 0
  io_busy = io_alloc
  if running != 0 {
    const cmd = tracker(`clock`=`clock`, `reset`=`reset`, io_alloc_valid=io_alloc, io_alloc_bits_tag=io_tag,
        io_alloc_bits_bytes_to_read=io_bytes, io_request_returned_valid=io_returned,
        io_request_returned_bits_bytes_read=io_returned_bytes, io_request_returned_bits_cmd_id=io_returned_id,
        io_cmd_completed_ready=io_accept)
    io_ready = cmd.io_alloc_ready
    if cmd.io_alloc_ready != 0 { io_id = cmd.io_alloc_bits_cmd_id }
    io_valid = cmd.io_cmd_completed_valid
    if cmd.io_cmd_completed_valid != 0 {
      io_out_id = cmd.io_cmd_completed_bits_cmd_id
      io_out_tag = cmd.io_cmd_completed_bits_tag
    }
    io_busy = io_alloc | cmd.io_busy
  }
  if io_gate_write != 0 and io_busy == 0 { running = io_gate_value }
}
