const mem_64x128 = import("mem_64x128.mem_64x128")

// 64 x 128-bit memory with a 16-bit byte mask; masked-off bytes are written as 0.
pub mod TwoPortSyncMem::[timecheck=false](`clock`:Clock, `reset`:Reset, io_waddr:U6, io_raddr:U6, io_wdata:U128, io_wen:U1, io_ren:U1, io_mask:U16) -> (io_rdata:U128@[]) {
  const wmask:U16 = if io_wen != 0 { io_mask } else { 0 }
  mut wdata:U128 = 0
  for k in 0..<16 {
    if wmask#[k] != 0 { wdata = wdata | (io_wdata#[(k*8)..<((k*8)+8)] << (k*8)) }
  }
  mut mem_ext = mem_64x128::[name=mem_ext](R0_addr = io_raddr, R0_en = io_ren, R0_clk = `clock`, W0_addr = io_waddr, W0_en = io_wen, W0_clk = `clock`, W0_data = wdata,
    `W0_mask.e15` = wmask#[15], `W0_mask.e14` = wmask#[14], `W0_mask.e13` = wmask#[13], `W0_mask.e12` = wmask#[12],
    `W0_mask.e11` = wmask#[11], `W0_mask.e10` = wmask#[10], `W0_mask.e9` = wmask#[9], `W0_mask.e8` = wmask#[8],
    `W0_mask.e7` = wmask#[7], `W0_mask.e6` = wmask#[6], `W0_mask.e5` = wmask#[5], `W0_mask.e4` = wmask#[4],
    `W0_mask.e3` = wmask#[3], `W0_mask.e2` = wmask#[2], `W0_mask.e1` = wmask#[1], `W0_mask.e0` = wmask#[0])
  io_rdata = mem_ext
}
