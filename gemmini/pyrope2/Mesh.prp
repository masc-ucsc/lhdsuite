        io_in_id = idCur[i], io_in_last = lastCur[i], io_in_valid = validCur[i])
      outA[i] = mesh.io_out_a
      outB[i] = mesh.io_out_b
      outC[i] = mesh.io_out_c
      outControl[i] = mesh.io_out_control
      outValid[i] = mesh.io_out_valid
      outId[i] = mesh.io_out_id
      outLast[i] = mesh.io_out_last
      if row == 3 {
        ob[col] = mesh.io_out_b
        oc[col] = mesh.io_out_c
        ov[col] = mesh.io_out_valid
        octl[col] = mesh.io_out_control
        oid[col] = mesh.io_out_id
        olast[col] = mesh.io_out_last
      }
