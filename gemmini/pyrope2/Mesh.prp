  const aCur:[16]U8 = [r, r_1, r_2, r_3, r_4, r_5, r_6, r_7, r_8, r_9, r_10, r_11, r_12, r_13, r_14, r_15]
  const bCur:[16]U32 = [pipe_b[0], pipe_b_4[0], pipe_b_8[0], pipe_b_12[0], pipe_b_1[0], pipe_b_5[0], pipe_b_9[0], pipe_b_13[0], pipe_b_2[0], pipe_b_6[0], pipe_b_10[0], pipe_b_14[0], pipe_b_3[0], pipe_b_7[0], pipe_b_11[0], pipe_b_15[0]]
  const dCur:[16]U32 = [pipe_b_16[0], pipe_b_20[0], pipe_b_24[0], pipe_b_28[0], pipe_b_17[0], pipe_b_21[0], pipe_b_25[0], pipe_b_29[0], pipe_b_18[0], pipe_b_22[0], pipe_b_26[0], pipe_b_30[0], pipe_b_19[0], pipe_b_23[0], pipe_b_27[0], pipe_b_31[0]]
  const shiftCur:[16]U5 = [mesh_0_0_io_in_control_0_shift_pipe_b, mesh_0_1_io_in_control_0_shift_pipe_b, mesh_0_2_io_in_control_0_shift_pipe_b, mesh_0_3_io_in_control_0_shift_pipe_b, mesh_1_0_io_in_control_0_shift_pipe_b, mesh_1_1_io_in_control_0_shift_pipe_b, mesh_1_2_io_in_control_0_shift_pipe_b, mesh_1_3_io_in_control_0_shift_pipe_b, mesh_2_0_io_in_control_0_shift_pipe_b, mesh_2_1_io_in_control_0_shift_pipe_b, mesh_2_2_io_in_control_0_shift_pipe_b, mesh_2_3_io_in_control_0_shift_pipe_b, mesh_3_0_io_in_control_0_shift_pipe_b, mesh_3_1_io_in_control_0_shift_pipe_b, mesh_3_2_io_in_control_0_shift_pipe_b, mesh_3_3_io_in_control_0_shift_pipe_b]
  const dataflowCur:[16]U1 = [mesh_0_0_io_in_control_0_dataflow_pipe_b, mesh_0_1_io_in_control_0_dataflow_pipe_b, mesh_0_2_io_in_control_0_dataflow_pipe_b, mesh_0_3_io_in_control_0_dataflow_pipe_b, mesh_1_0_io_in_control_0_dataflow_pipe_b, mesh_1_1_io_in_control_0_dataflow_pipe_b, mesh_1_2_io_in_control_0_dataflow_pipe_b, mesh_1_3_io_in_control_0_dataflow_pipe_b, mesh_2_0_io_in_control_0_dataflow_pipe_b, mesh_2_1_io_in_control_0_dataflow_pipe_b, mesh_2_2_io_in_control_0_dataflow_pipe_b, mesh_2_3_io_in_control_0_dataflow_pipe_b, mesh_3_0_io_in_control_0_dataflow_pipe_b, mesh_3_1_io_in_control_0_dataflow_pipe_b, mesh_3_2_io_in_control_0_dataflow_pipe_b, mesh_3_3_io_in_control_0_dataflow_pipe_b]
  const propagateCur:[16]U1 = [mesh_0_0_io_in_control_0_propagate_pipe_b, mesh_0_1_io_in_control_0_propagate_pipe_b, mesh_0_2_io_in_control_0_propagate_pipe_b, mesh_0_3_io_in_control_0_propagate_pipe_b, mesh_1_0_io_in_control_0_propagate_pipe_b, mesh_1_1_io_in_control_0_propagate_pipe_b, mesh_1_2_io_in_control_0_propagate_pipe_b, mesh_1_3_io_in_control_0_propagate_pipe_b, mesh_2_0_io_in_control_0_propagate_pipe_b, mesh_2_1_io_in_control_0_propagate_pipe_b, mesh_2_2_io_in_control_0_propagate_pipe_b, mesh_2_3_io_in_control_0_propagate_pipe_b, mesh_3_0_io_in_control_0_propagate_pipe_b, mesh_3_1_io_in_control_0_propagate_pipe_b, mesh_3_2_io_in_control_0_propagate_pipe_b, mesh_3_3_io_in_control_0_propagate_pipe_b]
