  mut outA:[16]U8 = 0
  mut outB:[16]U32 = 0
  mut outC:[16]U32 = 0
  mut outControl:[16]U7 = 0
  mut outValid:[16]U1 = 0
  mut outId:[16]U3 = 0
  mut outLast:[16]U1 = 0

  mut ob:[4]U32 = 0
  mut oc:[4]U32 = 0
  mut ov:[4]U1 = 0
  mut octl:[4]U7 = 0
  mut oid:[4]U3 = 0
  mut olast:[4]U1 = 0

  for row in 0..<4 {
    for col in 0..<4 {
      const i = (row*4) + col
      const up = (i + 12) % 16
      const left = (i + 15) % 16
      const srcA = if col == 0 { io_in_a[row] } else { outA[left] }
      const srcValid = if row == 0 { io_in_valid[col] } else { outValid[up] }
      const srcB = if row == 0 { io_in_b[col] } else { outB[up] }
      const srcD = if row == 0 { io_in_d[col] } else { outC[up] }
      const srcCtl = if row == 0 { io_in_control[col] } else { outControl[up] }
      const srcId = if row == 0 { io_in_id[col] } else { outId[up] }
      const srcLast = if row == 0 { io_in_last[col] } else { outLast[up] }

