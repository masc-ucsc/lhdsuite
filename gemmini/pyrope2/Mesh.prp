const Tile = import("Tile.Tile")

// Gemmini Mesh, 4x4 Tiles (tile_latency 0, output_delay 0): tile (r, c), i = r*4 + c, gets
//   in_a from a register fed by io_in_a[r] (c = 0) or the left tile's out_a;
//   in_b / in_d / in_control from Pipe registers that load, when the upstream valid is set, io_in_b/d/control[c]
//     (r = 0) or the upper tile's out_b / out_c / out_control (the Pipe valid flops are never read and are dropped);
//   in_valid / in_id / in_last from registers fed by io_in_valid/id/last[c] (r = 0) or the upper tile's outputs.
// The bottom row drives the outputs. Tiles are visited row-major, so a neighbour is always instantiated first.
// The registers stay scalar under their emitted names (register arrays do not pair with the Verilog flops in LEC):
// each family is read through one packed vector and written from its next-state array after the loop.
pub mod Mesh::[timecheck=false](`clock`:Clock, `reset`:Reset, io_in_a:U32, io_in_b:U32, io_in_d:U32, io_in_control:U28, io_in_id:U12, io_in_last:U4, io_in_valid:U4) -> (io_out_b:U128@[], io_out_c:U128@[], io_out_valid:U4@[], io_out_control:U28@[], io_out_id:U12@[], io_out_last:U4@[]) {
  reg r:U8
  reg r_1:U8
  reg r_2:U8
  reg r_3:U8
  reg r_4:U8
  reg r_5:U8
  reg r_6:U8
  reg r_7:U8
  reg r_8:U8
  reg r_9:U8
  reg r_10:U8
  reg r_11:U8
  reg r_12:U8
  reg r_13:U8
  reg r_14:U8
  reg r_15:U8
  reg pipe_b:[1]U8:[ordering="old"]
  reg pipe_b_1:[1]U32:[ordering="old"]
  reg pipe_b_2:[1]U32:[ordering="old"]
  reg pipe_b_3:[1]U32:[ordering="old"]
  reg pipe_b_4:[1]U8:[ordering="old"]
  reg pipe_b_5:[1]U32:[ordering="old"]
  reg pipe_b_6:[1]U32:[ordering="old"]
  reg pipe_b_7:[1]U32:[ordering="old"]
  reg pipe_b_8:[1]U8:[ordering="old"]
  reg pipe_b_9:[1]U32:[ordering="old"]
  reg pipe_b_10:[1]U32:[ordering="old"]
  reg pipe_b_11:[1]U32:[ordering="old"]
  reg pipe_b_12:[1]U8:[ordering="old"]
  reg pipe_b_13:[1]U32:[ordering="old"]
  reg pipe_b_14:[1]U32:[ordering="old"]
  reg pipe_b_15:[1]U32:[ordering="old"]
  reg pipe_b_16:[1]U8:[ordering="old"]
  reg pipe_b_17:[1]U32:[ordering="old"]
  reg pipe_b_18:[1]U32:[ordering="old"]
  reg pipe_b_19:[1]U32:[ordering="old"]
  reg pipe_b_20:[1]U8:[ordering="old"]
  reg pipe_b_21:[1]U32:[ordering="old"]
  reg pipe_b_22:[1]U32:[ordering="old"]
  reg pipe_b_23:[1]U32:[ordering="old"]
  reg pipe_b_24:[1]U8:[ordering="old"]
  reg pipe_b_25:[1]U32:[ordering="old"]
  reg pipe_b_26:[1]U32:[ordering="old"]
  reg pipe_b_27:[1]U32:[ordering="old"]
  reg pipe_b_28:[1]U8:[ordering="old"]
  reg pipe_b_29:[1]U32:[ordering="old"]
  reg pipe_b_30:[1]U32:[ordering="old"]
  reg pipe_b_31:[1]U32:[ordering="old"]
  reg mesh_0_0_io_in_control_0_shift_pipe_b:U5
  reg mesh_0_0_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_0_0_io_in_control_0_propagate_pipe_b:U1
  reg mesh_1_0_io_in_control_0_shift_pipe_b:U5
  reg mesh_1_0_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_1_0_io_in_control_0_propagate_pipe_b:U1
  reg mesh_2_0_io_in_control_0_shift_pipe_b:U5
  reg mesh_2_0_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_2_0_io_in_control_0_propagate_pipe_b:U1
  reg mesh_3_0_io_in_control_0_shift_pipe_b:U5
  reg mesh_3_0_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_3_0_io_in_control_0_propagate_pipe_b:U1
  reg mesh_0_1_io_in_control_0_shift_pipe_b:U5
  reg mesh_0_1_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_0_1_io_in_control_0_propagate_pipe_b:U1
  reg mesh_1_1_io_in_control_0_shift_pipe_b:U5
  reg mesh_1_1_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_1_1_io_in_control_0_propagate_pipe_b:U1
  reg mesh_2_1_io_in_control_0_shift_pipe_b:U5
  reg mesh_2_1_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_2_1_io_in_control_0_propagate_pipe_b:U1
  reg mesh_3_1_io_in_control_0_shift_pipe_b:U5
  reg mesh_3_1_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_3_1_io_in_control_0_propagate_pipe_b:U1
  reg mesh_0_2_io_in_control_0_shift_pipe_b:U5
  reg mesh_0_2_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_0_2_io_in_control_0_propagate_pipe_b:U1
  reg mesh_1_2_io_in_control_0_shift_pipe_b:U5
  reg mesh_1_2_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_1_2_io_in_control_0_propagate_pipe_b:U1
  reg mesh_2_2_io_in_control_0_shift_pipe_b:U5
  reg mesh_2_2_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_2_2_io_in_control_0_propagate_pipe_b:U1
  reg mesh_3_2_io_in_control_0_shift_pipe_b:U5
  reg mesh_3_2_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_3_2_io_in_control_0_propagate_pipe_b:U1
  reg mesh_0_3_io_in_control_0_shift_pipe_b:U5
  reg mesh_0_3_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_0_3_io_in_control_0_propagate_pipe_b:U1
  reg mesh_1_3_io_in_control_0_shift_pipe_b:U5
  reg mesh_1_3_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_1_3_io_in_control_0_propagate_pipe_b:U1
  reg mesh_2_3_io_in_control_0_shift_pipe_b:U5
  reg mesh_2_3_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_2_3_io_in_control_0_propagate_pipe_b:U1
  reg mesh_3_3_io_in_control_0_shift_pipe_b:U5
  reg mesh_3_3_io_in_control_0_dataflow_pipe_b:U1
  reg mesh_3_3_io_in_control_0_propagate_pipe_b:U1
  reg r_16:U1
  reg r_17:U1
  reg r_18:U1
  reg r_19:U1
  reg r_20:U1
  reg r_21:U1
  reg r_22:U1
  reg r_23:U1
  reg r_24:U1
  reg r_25:U1
  reg r_26:U1
  reg r_27:U1
  reg r_28:U1
  reg r_29:U1
  reg r_30:U1
  reg r_31:U1
  reg r_32:U3
  reg r_33:U3
  reg r_34:U3
  reg r_35:U3
  reg r_36:U3
  reg r_37:U3
  reg r_38:U3
  reg r_39:U3
  reg r_40:U3
  reg r_41:U3
  reg r_42:U3
  reg r_43:U3
  reg r_44:U3
  reg r_45:U3
  reg r_46:U3
  reg r_47:U3
  reg r_48:U1
  reg r_49:U1
  reg r_50:U1
  reg r_51:U1
  reg r_52:U1
  reg r_53:U1
  reg r_54:U1
  reg r_55:U1
  reg r_56:U1
  reg r_57:U1
  reg r_58:U1
  reg r_59:U1
  reg r_60:U1
  reg r_61:U1
  reg r_62:U1
  reg r_63:U1
  const aCur:U128 = (r_15 << 120) | (r_14 << 112) | (r_13 << 104) | (r_12 << 96) | (r_11 << 88) | (r_10 << 80) | (r_9 << 72) | (r_8 << 64) | (r_7 << 56) | (r_6 << 48) | (r_5 << 40) | (r_4 << 32) | (r_3 << 24) | (r_2 << 16) | (r_1 << 8) | r
  const bCur:U512 = (pipe_b_15[0] << 480) | (pipe_b_11[0] << 448) | (pipe_b_7[0] << 416) | (pipe_b_3[0] << 384) | (pipe_b_14[0] << 352) | (pipe_b_10[0] << 320) | (pipe_b_6[0] << 288) | (pipe_b_2[0] << 256) | (pipe_b_13[0] << 224) | (pipe_b_9[0] << 192) | (pipe_b_5[0] << 160) | (pipe_b_1[0] << 128) | (pipe_b_12[0] << 96) | (pipe_b_8[0] << 64) | (pipe_b_4[0] << 32) | pipe_b[0]
  const dCur:U512 = (pipe_b_31[0] << 480) | (pipe_b_27[0] << 448) | (pipe_b_23[0] << 416) | (pipe_b_19[0] << 384) | (pipe_b_30[0] << 352) | (pipe_b_26[0] << 320) | (pipe_b_22[0] << 288) | (pipe_b_18[0] << 256) | (pipe_b_29[0] << 224) | (pipe_b_25[0] << 192) | (pipe_b_21[0] << 160) | (pipe_b_17[0] << 128) | (pipe_b_28[0] << 96) | (pipe_b_24[0] << 64) | (pipe_b_20[0] << 32) | pipe_b_16[0]
  const shiftCur:U80 = (mesh_3_3_io_in_control_0_shift_pipe_b << 75) | (mesh_3_2_io_in_control_0_shift_pipe_b << 70) | (mesh_3_1_io_in_control_0_shift_pipe_b << 65) | (mesh_3_0_io_in_control_0_shift_pipe_b << 60) | (mesh_2_3_io_in_control_0_shift_pipe_b << 55) | (mesh_2_2_io_in_control_0_shift_pipe_b << 50) | (mesh_2_1_io_in_control_0_shift_pipe_b << 45) | (mesh_2_0_io_in_control_0_shift_pipe_b << 40) | (mesh_1_3_io_in_control_0_shift_pipe_b << 35) | (mesh_1_2_io_in_control_0_shift_pipe_b << 30) | (mesh_1_1_io_in_control_0_shift_pipe_b << 25) | (mesh_1_0_io_in_control_0_shift_pipe_b << 20) | (mesh_0_3_io_in_control_0_shift_pipe_b << 15) | (mesh_0_2_io_in_control_0_shift_pipe_b << 10) | (mesh_0_1_io_in_control_0_shift_pipe_b << 5) | mesh_0_0_io_in_control_0_shift_pipe_b
  const dataflowCur:U16 = (mesh_3_3_io_in_control_0_dataflow_pipe_b << 15) | (mesh_3_2_io_in_control_0_dataflow_pipe_b << 14) | (mesh_3_1_io_in_control_0_dataflow_pipe_b << 13) | (mesh_3_0_io_in_control_0_dataflow_pipe_b << 12) | (mesh_2_3_io_in_control_0_dataflow_pipe_b << 11) | (mesh_2_2_io_in_control_0_dataflow_pipe_b << 10) | (mesh_2_1_io_in_control_0_dataflow_pipe_b << 9) | (mesh_2_0_io_in_control_0_dataflow_pipe_b << 8) | (mesh_1_3_io_in_control_0_dataflow_pipe_b << 7) | (mesh_1_2_io_in_control_0_dataflow_pipe_b << 6) | (mesh_1_1_io_in_control_0_dataflow_pipe_b << 5) | (mesh_1_0_io_in_control_0_dataflow_pipe_b << 4) | (mesh_0_3_io_in_control_0_dataflow_pipe_b << 3) | (mesh_0_2_io_in_control_0_dataflow_pipe_b << 2) | (mesh_0_1_io_in_control_0_dataflow_pipe_b << 1) | mesh_0_0_io_in_control_0_dataflow_pipe_b
  const propagateCur:U16 = (mesh_3_3_io_in_control_0_propagate_pipe_b << 15) | (mesh_3_2_io_in_control_0_propagate_pipe_b << 14) | (mesh_3_1_io_in_control_0_propagate_pipe_b << 13) | (mesh_3_0_io_in_control_0_propagate_pipe_b << 12) | (mesh_2_3_io_in_control_0_propagate_pipe_b << 11) | (mesh_2_2_io_in_control_0_propagate_pipe_b << 10) | (mesh_2_1_io_in_control_0_propagate_pipe_b << 9) | (mesh_2_0_io_in_control_0_propagate_pipe_b << 8) | (mesh_1_3_io_in_control_0_propagate_pipe_b << 7) | (mesh_1_2_io_in_control_0_propagate_pipe_b << 6) | (mesh_1_1_io_in_control_0_propagate_pipe_b << 5) | (mesh_1_0_io_in_control_0_propagate_pipe_b << 4) | (mesh_0_3_io_in_control_0_propagate_pipe_b << 3) | (mesh_0_2_io_in_control_0_propagate_pipe_b << 2) | (mesh_0_1_io_in_control_0_propagate_pipe_b << 1) | mesh_0_0_io_in_control_0_propagate_pipe_b
  const validCur:U16 = (r_31 << 15) | (r_27 << 14) | (r_23 << 13) | (r_19 << 12) | (r_30 << 11) | (r_26 << 10) | (r_22 << 9) | (r_18 << 8) | (r_29 << 7) | (r_25 << 6) | (r_21 << 5) | (r_17 << 4) | (r_28 << 3) | (r_24 << 2) | (r_20 << 1) | r_16
  const idCur:U48 = (r_47 << 45) | (r_43 << 42) | (r_39 << 39) | (r_35 << 36) | (r_46 << 33) | (r_42 << 30) | (r_38 << 27) | (r_34 << 24) | (r_45 << 21) | (r_41 << 18) | (r_37 << 15) | (r_33 << 12) | (r_44 << 9) | (r_40 << 6) | (r_36 << 3) | r_32
  const lastCur:U16 = (r_63 << 15) | (r_59 << 14) | (r_55 << 13) | (r_51 << 12) | (r_62 << 11) | (r_58 << 10) | (r_54 << 9) | (r_50 << 8) | (r_61 << 7) | (r_57 << 6) | (r_53 << 5) | (r_49 << 4) | (r_60 << 3) | (r_56 << 2) | (r_52 << 1) | r_48

  mut aNext:[16]U8 = 0
  mut bNext:[16]U32 = 0
  mut dNext:[16]U32 = 0
  mut shiftNext:[16]U5 = 0
  mut dataflowNext:[16]U1 = 0
  mut propagateNext:[16]U1 = 0
  mut validNext:[16]U1 = 0
  mut idNext:[16]U3 = 0
  mut lastNext:[16]U1 = 0

  mut outA:[16]U8 = 0
  mut outB:[16]U32 = 0
  mut outC:[16]U32 = 0
  mut outControl:[16]U7 = 0
  mut outValid:[16]U1 = 0
  mut outId:[16]U3 = 0
  mut outLast:[16]U1 = 0

  mut ob:U128 = 0
  mut oc:U128 = 0
  mut ov:U4 = 0
  mut octl:U28 = 0
  mut oid:U12 = 0
  mut olast:U4 = 0

  for row in 0..<4 {
    for col in 0..<4 {
      const i = (row*4) + col
      const up = (i + 12) % 16
      const left = (i + 15) % 16
      const srcA = if col == 0 { io_in_a#[(row*8)..<((row*8)+8)] } else { outA[left] }
      const srcValid = if row == 0 { io_in_valid#[col] } else { outValid[up] }
      const srcB = if row == 0 { io_in_b#[(col*8)..<((col*8)+8)] } else { outB[up] }
      const srcD = if row == 0 { io_in_d#[(col*8)..<((col*8)+8)] } else { outC[up] }
      const srcCtl = if row == 0 { io_in_control#[(col*7)..<((col*7)+7)] } else { outControl[up] }
      const srcId = if row == 0 { io_in_id#[(col*3)..<((col*3)+3)] } else { outId[up] }
      const srcLast = if row == 0 { io_in_last#[col] } else { outLast[up] }

      const b = bCur#[(i*32)..<((i*32)+32)]
      const d = dCur#[(i*32)..<((i*32)+32)]
      const sh = shiftCur#[(i*5)..<((i*5)+5)]
      const df = dataflowCur#[i]
      const pr = propagateCur#[i]
      aNext[i] = srcA
      bNext[i] = if srcValid != 0 { srcB } else { b }
      dNext[i] = if srcValid != 0 { srcD } else { d }
      shiftNext[i] = if srcValid != 0 { srcCtl#[0..<5] } else { sh }
      propagateNext[i] = if srcValid != 0 { srcCtl#[5] } else { pr }
      dataflowNext[i] = if srcValid != 0 { srcCtl#[6] } else { df }
      validNext[i] = srcValid
      idNext[i] = srcId
      lastNext[i] = srcLast

      // row 0 holds the 8-bit io_in_b/d values, sign-extended into the tile
      const inB = if row == 0 { b#[0..<8]#sext[0..=7]#[0..<32] } else { b }
      const inD = if row == 0 { d#[0..<8]#sext[0..=7]#[0..<32] } else { d }
      mut mesh = Tile(`clock` = `clock`, io_in_a = aCur#[(i*8)..<((i*8)+8)], io_in_b = inB, io_in_d = inD,
        io_in_control = ((df << 6) | (pr << 5) | sh)#[0..<7],
        io_in_id = idCur#[(i*3)..<((i*3)+3)], io_in_last = lastCur#[i], io_in_valid = validCur#[i])
      outA[i] = mesh.io_out_a
      outB[i] = mesh.io_out_b
      outC[i] = mesh.io_out_c
      outControl[i] = mesh.io_out_control
      outValid[i] = mesh.io_out_valid
      outId[i] = mesh.io_out_id
      outLast[i] = mesh.io_out_last
      if row == 3 {
        ob = ob | (mesh.io_out_b << (col*32))
        oc = oc | (mesh.io_out_c << (col*32))
        ov = ov | (mesh.io_out_valid << col)
        octl = octl | (mesh.io_out_control << (col*7))
        oid = oid | (mesh.io_out_id << (col*3))
        olast = olast | (mesh.io_out_last << col)
      }
    }
  }

  r = aNext[0]
  pipe_b[0] = bNext[0]#[0..<8]
  pipe_b_16[0] = dNext[0]#[0..<8]
  mesh_0_0_io_in_control_0_shift_pipe_b = shiftNext[0]
  mesh_0_0_io_in_control_0_dataflow_pipe_b = dataflowNext[0]
  mesh_0_0_io_in_control_0_propagate_pipe_b = propagateNext[0]
  r_16 = validNext[0]
  r_32 = idNext[0]
  r_48 = lastNext[0]
  r_1 = aNext[1]
  pipe_b_4[0] = bNext[1]#[0..<8]
  pipe_b_20[0] = dNext[1]#[0..<8]
  mesh_0_1_io_in_control_0_shift_pipe_b = shiftNext[1]
  mesh_0_1_io_in_control_0_dataflow_pipe_b = dataflowNext[1]
  mesh_0_1_io_in_control_0_propagate_pipe_b = propagateNext[1]
  r_20 = validNext[1]
  r_36 = idNext[1]
  r_52 = lastNext[1]
  r_2 = aNext[2]
  pipe_b_8[0] = bNext[2]#[0..<8]
  pipe_b_24[0] = dNext[2]#[0..<8]
  mesh_0_2_io_in_control_0_shift_pipe_b = shiftNext[2]
  mesh_0_2_io_in_control_0_dataflow_pipe_b = dataflowNext[2]
  mesh_0_2_io_in_control_0_propagate_pipe_b = propagateNext[2]
  r_24 = validNext[2]
  r_40 = idNext[2]
  r_56 = lastNext[2]
  r_3 = aNext[3]
  pipe_b_12[0] = bNext[3]#[0..<8]
  pipe_b_28[0] = dNext[3]#[0..<8]
  mesh_0_3_io_in_control_0_shift_pipe_b = shiftNext[3]
  mesh_0_3_io_in_control_0_dataflow_pipe_b = dataflowNext[3]
  mesh_0_3_io_in_control_0_propagate_pipe_b = propagateNext[3]
  r_28 = validNext[3]
