const Tile = import("Tile.Tile")

// Gemmini Mesh, 4x4 Tiles (tile_latency 0, output_delay 0): tile (r, c), i = r*4 + c, gets
//   in_a from a register fed by io_in_a[r] (c = 0) or the left tile's out_a;
//   in_b / in_d / in_control from Pipe registers that load, when the upstream valid is set, io_in_b/d/control[c]
//     (r = 0) or the upper tile's out_b / out_c / out_control (the Pipe valid flops are never read and are dropped);
//   in_valid / in_id / in_last from registers fed by io_in_valid/id/last[c] (r = 0) or the upper tile's outputs.
// The bottom row drives the outputs. Tiles are visited row-major, so a neighbour is always instantiated first.
// The registers stay scalar under their emitted names (register arrays do not pair with the Verilog flops in LEC):
// each family is read through one array (lane i = tile i) and written from its next-state array after the loop.
// Every port is an array with one entry per row (inputs a) or per column (the rest), so the loop indexes array
// positions everywhere instead of selecting bit windows of a packed vector.
pub mod Mesh::[timecheck=false](`clock`:Clock, `reset`:Reset, io_in_a:[4]U8, io_in_b:[4]U8, io_in_d:[4]U8, io_in_control:[4]U7, io_in_id:[4]U3, io_in_last:[4]U1, io_in_valid:[4]U1) -> (io_out_b:[4]U32@[], io_out_c:[4]U32@[], io_out_valid:[4]U1@[], io_out_control:[4]U7@[], io_out_id:[4]U3@[], io_out_last:[4]U1@[]) {
