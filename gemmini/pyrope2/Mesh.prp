  const lastCur:[16]U1 = [r_48, r_52, r_56, r_60, r_49, r_53, r_57, r_61, r_50, r_54, r_58, r_62, r_51, r_55, r_59, r_63]

  mut aNext:[16]U8 = 0
  mut bNext:[16]U32 = 0
  mut dNext:[16]U32 = 0
  mut shiftNext:[16]U5 = 0
  mut dataflowNext:[16]U1 = 0
  mut propagateNext:[16]U1 = 0
