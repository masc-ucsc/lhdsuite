const AlwaysOutTransposer = import("AlwaysOutTransposer.AlwaysOutTransposer")
const Mesh = import("Mesh.Mesh")
const Queue6_TagWithIdAndTotalRows = import("Queue6_TagWithIdAndTotalRows.Queue6_TagWithIdAndTotalRows")
const TagQueue = import("TagQueue.TagQueue")

// Gemmini MeshWithDelays, 4x4: buffers one row of A, B and D, optionally routes one of them through the transposer,
// skews column c of every Mesh input by c cycles (registers named *_r*, RegShifted_*), and de-skews the Mesh output
// column c by 3-c cycles. req holds the current request: flush[0..<2], total_rows[2..<5], bd_transpose[5],
// a_transpose[6], pe_control (shift[7..<12], propagate[12], dataflow[13]), tag[14], valid[15].
// matmul_id counts 0..4. tagq / total_rows_q match responses to requests by matmul id.
pub mod MeshWithDelays::[timecheck=false](`clock`:Clock, `reset`:U1, io_a_valid:U1, io_a_bits:U32, io_b_valid:U1, io_b_bits:U32, io_d_valid:U1, io_d_bits:U32, io_req_valid:U1, io_req_bits:(tag:(id:U1), pe_control:(dataflow:U1, propagate:U1, shift:U5), a_transpose:U1, bd_transpose:U1, total_rows:U3, flush:U2)) -> (io_a_ready:U1@[], io_b_ready:U1@[], io_d_ready:U1@[], io_req_ready:U1@[], io_resp:(valid:U1, bits:(tag:(id:U1), data:U128, total_rows:U3, last:U1))@[], io_tags_in_progress:U6@[]) {
  reg req:U16
  reg matmul_id:U3:[initial=0, reset_pin=`reset`, async=false]
  reg fire_counter:U2:[initial=0, reset_pin=`reset`, async=false]
  reg a_buf:[4]U8:[ordering="old"]
  reg b_buf:[4]U8:[ordering="old"]
  reg d_buf:[4]U8:[ordering="old"]
  reg a_written:U1:[initial=0, reset_pin=`reset`, async=false]
  reg b_written:U1:[initial=0, reset_pin=`reset`, async=false]
  reg d_written:U1:[initial=0, reset_pin=`reset`, async=false]
  reg in_prop:U1:[initial=0, reset_pin=`reset`, async=false]
  reg result_shift:U5
  // input skew, column 1 / 2 / 3: A, B, D bytes
  reg RegShifted_1:U8
  reg RegShifted_r:U8
  reg RegShifted_2:U8
  reg RegShifted_r_1:U8
  reg RegShifted_r_2:U8
  reg RegShifted_3:U8
  reg RegShifted_1_1:U8
  reg RegShifted_r_3:U8
  reg RegShifted_2_1:U8
  reg RegShifted_r_4:U8
  reg RegShifted_r_5:U8
  reg RegShifted_3_1:U8
  reg RegShifted_1_2:U8
  reg RegShifted_r_6:U8
  reg RegShifted_2_2:U8
  reg RegShifted_r_7:U8
  reg RegShifted_r_8:U8
  reg RegShifted_3_2:U8
  // input skew: control
  reg mesh_io_in_control_1_0_dataflow_r:U1
  reg mesh_io_in_control_1_0_propagate_r:U1
  reg mesh_io_in_control_1_0_shift_r:U5
  reg mesh_io_in_control_2_0_dataflow_r:U1
  reg mesh_io_in_control_2_0_dataflow_r_1:U1
  reg mesh_io_in_control_2_0_propagate_r:U1
  reg mesh_io_in_control_2_0_propagate_r_1:U1
  reg mesh_io_in_control_2_0_shift_r:U5
  reg mesh_io_in_control_2_0_shift_r_1:U5
  reg mesh_io_in_control_3_0_dataflow_r:U1
  reg mesh_io_in_control_3_0_dataflow_r_1:U1
  reg mesh_io_in_control_3_0_dataflow_r_2:U1
  reg mesh_io_in_control_3_0_propagate_r:U1
  reg mesh_io_in_control_3_0_propagate_r_1:U1
  reg mesh_io_in_control_3_0_propagate_r_2:U1
  reg mesh_io_in_control_3_0_shift_r:U5
  reg mesh_io_in_control_3_0_shift_r_1:U5
  reg mesh_io_in_control_3_0_shift_r_2:U5
  // input skew: valid, id, last
  reg RegShifted_1_3:U1
  reg RegShifted_r_9:U1
  reg RegShifted_2_3:U1
  reg RegShifted_r_10:U1
  reg RegShifted_r_11:U1
  reg RegShifted_3_3:U1
  reg RegShifted_1_4:U3
  reg RegShifted_r_12:U3
  reg RegShifted_2_4:U3
  reg RegShifted_r_13:U3
  reg RegShifted_r_14:U3
  reg RegShifted_3_4:U3
  reg RegShifted_1_5:U1
  reg RegShifted_r_15:U1
  reg RegShifted_2_5:U1
  reg RegShifted_r_16:U1
  reg RegShifted_r_17:U1
  reg RegShifted_3_5:U1
  // output de-skew: data columns 0 / 1 / 2, and column 0 valid, last, id
  reg RegShifted_r_18:U32
  reg RegShifted_r_19:U32
  reg RegShifted_0:U32
  reg RegShifted_r_20:U32
  reg RegShifted_1_6:U32
  reg RegShifted_2_6:U32
  reg io_resp_valid_RegShifted_r:U1
  reg io_resp_valid_RegShifted_r_1:U1
  reg io_resp_valid_RegShifted_0:U1
  reg out_last_RegShifted_r:U1
  reg out_last_RegShifted_r_1:U1
  reg out_last_RegShifted_0:U1
  reg out_matmul_id_RegShifted_r:U3
  reg out_matmul_id_RegShifted_r_1:U3
  reg out_matmul_id_RegShifted_0:[1]U3:[ordering="old"]
  // the queues' outputs feed back into their own inputs (through io_req_ready and the response match)
  wire tagq_enq_ready:U1 = nil
  wire tagq_deq_valid:U1 = nil
  wire tagq_deq_tag:U1 = nil
  wire tagq_deq_id:U3 = nil
  wire rows_q_enq_ready:U1 = nil
  wire rows_q_deq_valid:U1 = nil
  wire rows_q_deq_id:U3 = nil
  wire rows_q_deq_rows:U3 = nil

  const req_flush = req#[0..<2]
  const req_rows = req#[2..<5]
  const req_bd_transpose = req#[5..<6]
  const req_a_transpose = req#[6..<7]
  const req_shift = req#[7..<12]
  const req_dataflow = req#[13..<14]
  const req_valid = req#[15..<16]
  const in_bits = ((io_req_bits.tag.id << 14) | (io_req_bits.pe_control.dataflow << 13) | (io_req_bits.pe_control.propagate << 12) | (io_req_bits.pe_control.shift << 7) | (io_req_bits.a_transpose << 6) | (io_req_bits.bd_transpose << 5) | (io_req_bits.total_rows << 2) | io_req_bits.flush)#[0..<15]

  // a row goes into the array once A, B and D are all buffered (or every cycle while flushing)
  mut flushing = if req_flush != 0 { 1 } else { 0 }
  const in_next = req_valid & ((a_written & b_written & d_written) | flushing) & 1
  const fire_counter_max = (req_rows - 1)#[0..<3]
  mut at_max = if fire_counter#[0..<2] == fire_counter_max { 1 } else { 0 }
  const last_fire = at_max & in_next
  const a_is_from_transposer = (req_dataflow ^ (~req_a_transpose)) & 1
  const b_is_from_transposer = (~req_dataflow) & req_bd_transpose & 1
  const d_is_from_transposer = req_dataflow & req_bd_transpose & 1

  // request port
  const req_ready = ((~req_valid) | last_fire) & tagq_enq_ready & rows_q_enq_ready & 1
  const req_fire = req_ready & io_req_valid & 1
  mut no_flush = if io_req_bits.flush == 0 { 1 } else { 0 }
  const id_step = (1 << 1) | (~in_bits#[13..<14])
  const cur_from_end = (4 - matmul_id)#[0..<3]
  mut tag_id:U3 = if matmul_id >= ((4 - id_step)#[0..<3] + 1)#[0..<3] { ((id_step - cur_from_end)#[0..<3] - 1)#[0..<3] } else { (matmul_id + id_step)#[0..<3] }
  mut next_id:U3 = if matmul_id#[2..<3] != 0 { ((1 - cur_from_end)#[0..<3] - 1)#[0..<3] } else { (matmul_id + 1)#[0..<3] }

  // A / B / D row buffers
  const a_ready = ((((~a_written) | in_next) & 1) | req_ready) & 1
  const b_ready = ((((~b_written) | in_next) & 1) | req_ready) & 1
  const d_ready = ((((~d_written) | in_next) & 1) | req_ready) & 1
  const a_fire = a_ready & io_a_valid & 1
  const b_fire = b_ready & io_b_valid & 1
  const d_fire = d_ready & io_d_valid & 1

  // transposer: B, else D (byte-reversed), else A
  mut trans_in:U32 = if d_is_from_transposer != 0 { (d_buf[0] << 24) | (d_buf[1] << 16) | (d_buf[2] << 8) | d_buf[3] } else { (a_buf[3] << 24) | (a_buf[2] << 16) | (a_buf[1] << 8) | a_buf[0] }
  if b_is_from_transposer != 0 { trans_in = (b_buf[3] << 24) | (b_buf[2] << 16) | (b_buf[1] << 8) | b_buf[0] }
  mut transposer = AlwaysOutTransposer::[name=transposer](`clock` = `clock`, `reset` = `reset`, io_inRow_valid = in_next & (a_is_from_transposer | b_is_from_transposer | d_is_from_transposer) & 1, io_inRow_bits = trans_in)
  const tout = transposer#[0..<32]
  mut a_in:U32 = if a_is_from_transposer != 0 { tout } else { a_buf#[0..<32] }
  mut b_in:U32 = if b_is_from_transposer != 0 { tout } else { b_buf#[0..<32] }
  mut d_in:U32 = if d_is_from_transposer != 0 { (tout#[0..<8] << 24) | (tout#[8..<16] << 16) | (tout#[16..<24] << 8) | tout#[24..<32] } else { d_buf#[0..<32] }

  // column c enters c cycles late
  const ctl0 = ((req_dataflow << 6) | ((in_prop & 1) << 5) | result_shift)#[0..<7]
  const ctl1 = ((mesh_io_in_control_1_0_dataflow_r << 6) | (mesh_io_in_control_1_0_propagate_r << 5) | mesh_io_in_control_1_0_shift_r)#[0..<7]
  const ctl2 = ((mesh_io_in_control_2_0_dataflow_r_1 << 6) | (mesh_io_in_control_2_0_propagate_r_1 << 5) | mesh_io_in_control_2_0_shift_r_1)#[0..<7]
  const ctl3 = ((mesh_io_in_control_3_0_dataflow_r_2 << 6) | (mesh_io_in_control_3_0_propagate_r_2 << 5) | mesh_io_in_control_3_0_shift_r_2)#[0..<7]
  mut mesh = Mesh::[name=mesh](`clock` = `clock`, `reset` = `reset`,
    io_in_a = (RegShifted_3 << 24) | (RegShifted_2 << 16) | (RegShifted_1 << 8) | a_in#[0..<8],
    io_in_b = (RegShifted_3_1 << 24) | (RegShifted_2_1 << 16) | (RegShifted_1_1 << 8) | b_in#[0..<8],
    io_in_d = (RegShifted_3_2 << 24) | (RegShifted_2_2 << 16) | (RegShifted_1_2 << 8) | d_in#[0..<8],
    io_in_control = (ctl3 << 21) | (ctl2 << 14) | (ctl1 << 7) | ctl0,
    io_in_id = (RegShifted_3_4 << 9) | (RegShifted_2_4 << 6) | (RegShifted_1_4 << 3) | matmul_id,
    io_in_last = (RegShifted_3_5 << 3) | (RegShifted_2_5 << 2) | (RegShifted_1_5 << 1) | last_fire,
    io_in_valid = (RegShifted_3_3 << 3) | (RegShifted_2_3 << 2) | (RegShifted_1_3 << 1) | in_next)
  mut mesh_out:U128 = if mesh.io_out_control#[6..<7] != 0 { mesh.io_out_b#[0..<0x80] } else { mesh.io_out_c#[0..<0x80] }

  // responses: column 0's matmul id picks the matching tag and total_rows
  const out_matmul_id = out_matmul_id_RegShifted_0[0]
  const resp_valid = io_resp_valid_RegShifted_0 & 1
  const resp_last = out_last_RegShifted_0 & 1
  const resp_done = resp_valid & resp_last
  mut tagq_match = if out_matmul_id == tagq_deq_id { 1 } else { 0 }
  mut rows_q_match = if out_matmul_id == rows_q_deq_id { 1 } else { 0 }
  mut resp_tag:U1 = if (tagq_deq_valid & tagq_match & 1) != 0 { tagq_deq_tag & 1 } else { 0 }
  mut resp_rows:U3 = if (rows_q_deq_valid & rows_q_match & 1) != 0 { rows_q_deq_rows } else { 4 }

  mut tagq = TagQueue::[name=tagq](`clock` = `clock`, `reset` = `reset`, io_enq_valid = req_fire & no_flush & 1, `io_enq_bits.tag.id` = in_bits#[14..<15], `io_enq_bits.id` = tag_id, `io_enq_bits.total_rows` = 0, io_deq_ready = resp_done & tagq_match & 1)
  tagq_enq_ready = tagq.io_enq_ready
  tagq_deq_valid = tagq.io_deq_valid
  tagq_deq_tag = tagq.io_deq_bits.tag.id
  tagq_deq_id = tagq.io_deq_bits.id
  mut total_rows_q = Queue6_TagWithIdAndTotalRows::[name=total_rows_q](`clock` = `clock`, `reset` = `reset`, io_enq_valid = req_fire & no_flush & 1, `io_enq_bits.tag.id` = 0, `io_enq_bits.id` = next_id, `io_enq_bits.total_rows` = in_bits#[2..<5], io_deq_ready = resp_done & rows_q_match & 1)
  rows_q_enq_ready = total_rows_q.io_enq_ready
  rows_q_deq_valid = total_rows_q.io_deq_valid
  rows_q_deq_id = total_rows_q.io_deq_bits.id
  rows_q_deq_rows = total_rows_q.io_deq_bits.total_rows
  const tq = tagq.io_all

  // state updates
  mut flush_left:U2 = if last_fire != 0 { (req_flush - 1)#[0..<2] } else { req_flush }
  mut still_valid:U1 = if last_fire != 0 { req_flush#[1..<2] } else { req_valid }
  mut req_bits:U15 = if req_fire != 0 { in_bits } else { (req#[2..<15] << 2) | flush_left }
  req = req_bits | (((~`reset`) & (req_fire | still_valid) & 1) << 15)
  if not (`reset` != 0) {
    if in_next != 0 {
      fire_counter = if fire_counter_max == 0 { 0 } elif fire_counter#[0..<2] >= fire_counter_max { ((1 - (fire_counter_max#[0..<2] - fire_counter)#[0..<2])#[0..<2] - 1)#[0..<2] } else { (fire_counter + 1)#[0..<2] }
    }
    if req_fire != 0 { matmul_id = next_id }
    a_written = (a_fire | ((~in_next#[0]) & a_written)) & 1
    b_written = (b_fire | ((~in_next#[0]) & b_written)) & 1
    d_written = (d_fire | ((~in_next#[0]) & d_written)) & 1
    in_prop = ((req_fire & in_bits#[12..<13]) ^ in_prop) & 1
  }
  if a_fire != 0 {
    a_buf[0] = io_a_bits#[0..<8]
    a_buf[1] = io_a_bits#[8..<16]
    a_buf[2] = io_a_bits#[16..<24]
    a_buf[3] = io_a_bits#[24..<32]
  }
  if b_fire != 0 {
    b_buf[0] = io_b_bits#[0..<8]
    b_buf[1] = io_b_bits#[8..<16]
    b_buf[2] = io_b_bits#[16..<24]
    b_buf[3] = io_b_bits#[24..<32]
  }
  if d_fire != 0 {
    d_buf[0] = io_d_bits#[0..<8]
    d_buf[1] = io_d_bits#[8..<16]
    d_buf[2] = io_d_bits#[16..<24]
    d_buf[3] = io_d_bits#[24..<32]
  }
  result_shift = req_shift

  // skew chains, written last stage first
  RegShifted_3 = RegShifted_r_2
  RegShifted_r_2 = RegShifted_r_1
  RegShifted_r_1 = a_in#[24..<32]
  RegShifted_2 = RegShifted_r
  RegShifted_r = a_in#[16..<24]
  RegShifted_1 = a_in#[8..<16]
  RegShifted_3_1 = RegShifted_r_5
  RegShifted_r_5 = RegShifted_r_4
  RegShifted_r_4 = b_in#[24..<32]
  RegShifted_2_1 = RegShifted_r_3
  RegShifted_r_3 = b_in#[16..<24]
  RegShifted_1_1 = b_in#[8..<16]
  RegShifted_3_2 = RegShifted_r_8
  RegShifted_r_8 = RegShifted_r_7
  RegShifted_r_7 = d_in#[24..<32]
  RegShifted_2_2 = RegShifted_r_6
  RegShifted_r_6 = d_in#[16..<24]
  RegShifted_1_2 = d_in#[8..<16]
  mesh_io_in_control_3_0_dataflow_r_2 = mesh_io_in_control_3_0_dataflow_r_1
  mesh_io_in_control_3_0_dataflow_r_1 = mesh_io_in_control_3_0_dataflow_r
  mesh_io_in_control_3_0_dataflow_r = req_dataflow
  mesh_io_in_control_2_0_dataflow_r_1 = mesh_io_in_control_2_0_dataflow_r
  mesh_io_in_control_2_0_dataflow_r = req_dataflow
  mesh_io_in_control_1_0_dataflow_r = req_dataflow
  mesh_io_in_control_3_0_propagate_r_2 = mesh_io_in_control_3_0_propagate_r_1
  mesh_io_in_control_3_0_propagate_r_1 = mesh_io_in_control_3_0_propagate_r
  mesh_io_in_control_3_0_propagate_r = in_prop
  mesh_io_in_control_2_0_propagate_r_1 = mesh_io_in_control_2_0_propagate_r
  mesh_io_in_control_2_0_propagate_r = in_prop
  mesh_io_in_control_1_0_propagate_r = in_prop
  mesh_io_in_control_3_0_shift_r_2 = mesh_io_in_control_3_0_shift_r_1
  mesh_io_in_control_3_0_shift_r_1 = mesh_io_in_control_3_0_shift_r
  mesh_io_in_control_3_0_shift_r = result_shift
  mesh_io_in_control_2_0_shift_r_1 = mesh_io_in_control_2_0_shift_r
  mesh_io_in_control_2_0_shift_r = result_shift
  mesh_io_in_control_1_0_shift_r = result_shift
  RegShifted_3_3 = RegShifted_r_11
  RegShifted_r_11 = RegShifted_r_10
  RegShifted_r_10 = in_next
  RegShifted_2_3 = RegShifted_r_9
  RegShifted_r_9 = in_next
  RegShifted_1_3 = in_next
  RegShifted_3_4 = RegShifted_r_14
  RegShifted_r_14 = RegShifted_r_13
  RegShifted_r_13 = matmul_id
  RegShifted_2_4 = RegShifted_r_12
  RegShifted_r_12 = matmul_id
  RegShifted_1_4 = matmul_id
  RegShifted_3_5 = RegShifted_r_17
  RegShifted_r_17 = RegShifted_r_16
  RegShifted_r_16 = last_fire
  RegShifted_2_5 = RegShifted_r_15
  RegShifted_r_15 = last_fire
  RegShifted_1_5 = last_fire
  // de-skew: column c leaves 3-c cycles late
  RegShifted_0 = RegShifted_r_19
  RegShifted_r_19 = RegShifted_r_18
  RegShifted_r_18 = mesh_out#[0..<32]
  RegShifted_1_6 = RegShifted_r_20
  RegShifted_r_20 = mesh_out#[32..<0x40]
  RegShifted_2_6 = mesh_out#[0x40..<0x60]
  io_resp_valid_RegShifted_0 = io_resp_valid_RegShifted_r_1
  io_resp_valid_RegShifted_r_1 = io_resp_valid_RegShifted_r
  io_resp_valid_RegShifted_r = mesh.io_out_valid & 1
  out_last_RegShifted_0 = out_last_RegShifted_r_1
  out_last_RegShifted_r_1 = out_last_RegShifted_r
  out_last_RegShifted_r = mesh.io_out_last & 1
  out_matmul_id_RegShifted_0#[0..<3] = out_matmul_id_RegShifted_r_1
  out_matmul_id_RegShifted_r_1 = out_matmul_id_RegShifted_r
  out_matmul_id_RegShifted_r = mesh.io_out_id#[0..<3]

  io_a_ready = a_ready
  io_b_ready = b_ready
  io_d_ready = d_ready
  io_req_ready = req_ready
  io_resp.valid = resp_valid
  io_resp.bits.tag.id = resp_tag
  io_resp.bits.data = (mesh_out#[0x60..<0x80] << 96) | (RegShifted_2_6 << 64) | (RegShifted_1_6 << 32) | RegShifted_0
  io_resp.bits.total_rows = resp_rows
  io_resp.bits.last = resp_last
  io_tags_in_progress = (tq#[41] << 5) | (tq#[34] << 4) | (tq#[27] << 3) | (tq#[20] << 2) | (tq#[13] << 1) | tq#[6]
}
