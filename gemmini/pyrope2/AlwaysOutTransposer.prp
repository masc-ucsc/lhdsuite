const PE = import("PE.PE")

// Always-output 4x4 transposer: a grid of 8-bit PE shift cells. Rows of io_inRow_bits shift in
// leftward (dir=0) or upward (dir=1); io_outCol_bits reads column 0 (dir=0) or row 0 (dir=1).
// dir flips every 4 valid rows, so one block is shifted in while the previous one is shifted out.
pub mod AlwaysOutTransposer::[timecheck=false](`clock`:Clock, `reset`:U1, io_inRow_valid:U1, io_inRow_bits:U32) -> (io_outCol_bits:U32@[]) {
  reg counter:U2:[initial=0, reset_pin=`reset`, async=false]
  reg dir:U1:[initial=0, reset_pin=`reset`, async=false]

  if io_inRow_valid != 0 {
    if counter == 3 { dir = dir ^ 1 }
    counter = (counter + 1)#[0..<2]
  }

  // instantiated bottom-right first so every PE reads neighbours already declared
  mut pes_3_3 = PE::[name=pes_3_3](`clock` = `clock`, io_inR = io_inRow_bits#[24..<32], io_inD = io_inRow_bits#[24..<32], io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_2 = PE::[name=pes_3_2](`clock` = `clock`, io_inR = pes_3_3.io_outL, io_inD = io_inRow_bits#[16..<24], io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_1 = PE::[name=pes_3_1](`clock` = `clock`, io_inR = pes_3_2.io_outL, io_inD = io_inRow_bits#[8..<16], io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_0 = PE::[name=pes_3_0](`clock` = `clock`, io_inR = pes_3_1.io_outL, io_inD = io_inRow_bits#[0..<8], io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_3 = PE::[name=pes_2_3](`clock` = `clock`, io_inR = io_inRow_bits#[16..<24], io_inD = pes_3_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_2 = PE::[name=pes_2_2](`clock` = `clock`, io_inR = pes_2_3.io_outL, io_inD = pes_3_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_1 = PE::[name=pes_2_1](`clock` = `clock`, io_inR = pes_2_2.io_outL, io_inD = pes_3_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_0 = PE::[name=pes_2_0](`clock` = `clock`, io_inR = pes_2_1.io_outL, io_inD = pes_3_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_3 = PE::[name=pes_1_3](`clock` = `clock`, io_inR = io_inRow_bits#[8..<16], io_inD = pes_2_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_2 = PE::[name=pes_1_2](`clock` = `clock`, io_inR = pes_1_3.io_outL, io_inD = pes_2_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_1 = PE::[name=pes_1_1](`clock` = `clock`, io_inR = pes_1_2.io_outL, io_inD = pes_2_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_0 = PE::[name=pes_1_0](`clock` = `clock`, io_inR = pes_1_1.io_outL, io_inD = pes_2_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_3 = PE::[name=pes_0_3](`clock` = `clock`, io_inR = io_inRow_bits#[0..<8], io_inD = pes_1_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_2 = PE::[name=pes_0_2](`clock` = `clock`, io_inR = pes_0_3.io_outL, io_inD = pes_1_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_1 = PE::[name=pes_0_1](`clock` = `clock`, io_inR = pes_0_2.io_outL, io_inD = pes_1_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_0 = PE::[name=pes_0_0](`clock` = `clock`, io_inR = pes_0_1.io_outL, io_inD = pes_1_0.io_outU, io_dir = dir, io_en = io_inRow_valid)

  io_outCol_bits = if dir != 0 {
    (pes_0_3.io_outU << 24) | (pes_0_2.io_outU << 16) | (pes_0_1.io_outU << 8) | pes_0_0.io_outU
  } else {
    (pes_3_0.io_outL << 24) | (pes_2_0.io_outL << 16) | (pes_1_0.io_outL << 8) | pes_0_0.io_outL
  }
}
