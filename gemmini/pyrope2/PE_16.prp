const MacUnit = import("MacUnit.MacUnit")

// Systolic PE: dataflow=1 is weight-stationary (c1/c2 hold weights), dataflow=0 output-stationary
// (c1/c2 accumulate); propagate picks which of the two double-buffered registers is in use.
pub mod PE_16::[timecheck=false](`clock`:Clock, io_in_a:U8, io_in_b:U32, io_in_d:U32, io_in_control:(dataflow:U1, propagate:U1, shift:U5), io_in_id:U3, io_in_last:U1, io_in_valid:U1) -> (io_out_a:U8@[], io_out_b:U32@[], io_out_c:U32@[], io_out_control:(dataflow:U1, propagate:U1, shift:U5)@[], io_out_id:U3@[], io_out_last:U1@[], io_out_valid:U1@[], io_bad_dataflow:U1@[]) {
  reg c1:U32
  reg c2:U32
  reg last_s:U1

  const ws = io_in_control.dataflow
  const prop = io_in_control.propagate
  const shift_offset:U5 = if last_s != prop { io_in_control.shift } else { 0 }

  mut mac_unit = MacUnit::[name=mac_unit](io_in_a = io_in_a,
    io_in_b = if ws != 0 { (if prop != 0 { c2#[0..<8] } else { c1#[0..<8] }) } else { io_in_b#[0..<8] },
    io_in_c = if ws != 0 { io_in_b } else { (if prop != 0 { c2 } else { c1 }) })
  const mac:U32 = mac_unit

  // output-stationary: the result leaves as c >> shift_offset (arithmetic), rounded to nearest, ties to even
  const c = if prop != 0 { c1 } else { c2 }
  const sh = shift_offset
  const t = (c#sext[0..=31] >> sh)#[0..<32]
  const half:U1 = if sh != 0 { (c#sext[0..=31] >> (sh - 1)#[0..<5])#[0] } else { 0 }
  const below:U1 = if sh >= 2 and (c & ((1 << (sh - 1)#[0..<5])#[0..<32] - 1)#[0..<32]) != 0 { 1 } else { 0 }
  io_out_c = if ws != 0 { c } else { (t + (half & (below | t#[0])))#[0..<32] }
  io_out_b = if ws != 0 { mac } else { io_in_b }

  if io_in_valid != 0 {
    if ws != 0 {
      if prop != 0 { c1 = io_in_d } else { c2 = io_in_d }
    } else {
      c1 = if prop != 0 { io_in_d } else { mac }
      c2 = if prop != 0 { mac } else { io_in_d }
    }
    last_s = prop
  }

  io_out_a = io_in_a
  io_out_control = io_in_control
  io_out_id = io_in_id
  io_out_last = io_in_last
  io_out_valid = io_in_valid
  io_bad_dataflow = 0
}
