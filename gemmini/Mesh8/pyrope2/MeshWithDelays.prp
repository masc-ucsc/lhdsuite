  reg RegShifted_r_20:U8
  reg RegShifted_7:U8
  reg RegShifted_1_1:U8
  reg RegShifted_r_21:U8
  reg RegShifted_2_1:U8
  reg RegShifted_r_22:U8
  reg RegShifted_r_23:U8
  reg RegShifted_3_1:U8
  reg RegShifted_r_24:U8
  reg RegShifted_r_25:U8
  reg RegShifted_r_26:U8
  reg RegShifted_4_1:U8
  reg RegShifted_r_27:U8
  reg RegShifted_r_28:U8
  reg RegShifted_r_29:U8
  reg RegShifted_r_30:U8
  reg RegShifted_5_1:U8
  reg RegShifted_r_31:U8
