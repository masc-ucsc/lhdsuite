  reg RegShifted_r_58:U8
  reg RegShifted_r_59:U8
  reg RegShifted_r_60:U8
  reg RegShifted_r_61:U8
  reg RegShifted_r_62:U8
  reg RegShifted_7_2:U8
  // input skew: control
  reg mesh_io_in_control_1_0_dataflow_r:U1
  reg mesh_io_in_control_1_0_propagate_r:U1
  reg mesh_io_in_control_1_0_shift_r:U5
  reg mesh_io_in_control_2_0_dataflow_r:U1
  reg mesh_io_in_control_2_0_dataflow_r_1:U1
  reg mesh_io_in_control_2_0_propagate_r:U1
  reg mesh_io_in_control_2_0_propagate_r_1:U1
  reg mesh_io_in_control_2_0_shift_r:U5
  reg mesh_io_in_control_2_0_shift_r_1:U5
  reg mesh_io_in_control_3_0_dataflow_r:U1
  reg mesh_io_in_control_3_0_dataflow_r_1:U1
  reg mesh_io_in_control_3_0_dataflow_r_2:U1
  reg mesh_io_in_control_3_0_propagate_r:U1
  reg mesh_io_in_control_3_0_propagate_r_1:U1
  reg mesh_io_in_control_3_0_propagate_r_2:U1
  reg mesh_io_in_control_3_0_shift_r:U5
  reg mesh_io_in_control_3_0_shift_r_1:U5
  reg mesh_io_in_control_3_0_shift_r_2:U5
  reg mesh_io_in_control_4_0_dataflow_r:U1
  reg mesh_io_in_control_4_0_dataflow_r_1:U1
  reg mesh_io_in_control_4_0_dataflow_r_2:U1
  reg mesh_io_in_control_4_0_dataflow_r_3:U1
  reg mesh_io_in_control_4_0_propagate_r:U1
  reg mesh_io_in_control_4_0_propagate_r_1:U1
  reg mesh_io_in_control_4_0_propagate_r_2:U1
  reg mesh_io_in_control_4_0_propagate_r_3:U1
  reg mesh_io_in_control_4_0_shift_r:U5
  reg mesh_io_in_control_4_0_shift_r_1:U5
  reg mesh_io_in_control_4_0_shift_r_2:U5
  reg mesh_io_in_control_4_0_shift_r_3:U5
  reg mesh_io_in_control_5_0_dataflow_r:U1
  reg mesh_io_in_control_5_0_dataflow_r_1:U1
  reg mesh_io_in_control_5_0_dataflow_r_2:U1
  reg mesh_io_in_control_5_0_dataflow_r_3:U1
  reg mesh_io_in_control_5_0_dataflow_r_4:U1
  reg mesh_io_in_control_5_0_propagate_r:U1
  reg mesh_io_in_control_5_0_propagate_r_1:U1
  reg mesh_io_in_control_5_0_propagate_r_2:U1
  reg mesh_io_in_control_5_0_propagate_r_3:U1
  reg mesh_io_in_control_5_0_propagate_r_4:U1
  reg mesh_io_in_control_5_0_shift_r:U5
  reg mesh_io_in_control_5_0_shift_r_1:U5
  reg mesh_io_in_control_5_0_shift_r_2:U5
  reg mesh_io_in_control_5_0_shift_r_3:U5
  reg mesh_io_in_control_5_0_shift_r_4:U5
  reg mesh_io_in_control_6_0_dataflow_r:U1
  reg mesh_io_in_control_6_0_dataflow_r_1:U1
  reg mesh_io_in_control_6_0_dataflow_r_2:U1
  reg mesh_io_in_control_6_0_dataflow_r_3:U1
  reg mesh_io_in_control_6_0_dataflow_r_4:U1
  reg mesh_io_in_control_6_0_dataflow_r_5:U1
  reg mesh_io_in_control_6_0_propagate_r:U1
  reg mesh_io_in_control_6_0_propagate_r_1:U1
  reg mesh_io_in_control_6_0_propagate_r_2:U1
  reg mesh_io_in_control_6_0_propagate_r_3:U1
  reg mesh_io_in_control_6_0_propagate_r_4:U1
  reg mesh_io_in_control_6_0_propagate_r_5:U1
  reg mesh_io_in_control_6_0_shift_r:U5
  reg mesh_io_in_control_6_0_shift_r_1:U5
  reg mesh_io_in_control_6_0_shift_r_2:U5
  reg mesh_io_in_control_6_0_shift_r_3:U5
  reg mesh_io_in_control_6_0_shift_r_4:U5
  reg mesh_io_in_control_6_0_shift_r_5:U5
  reg mesh_io_in_control_7_0_dataflow_r:U1
  reg mesh_io_in_control_7_0_dataflow_r_1:U1
  reg mesh_io_in_control_7_0_dataflow_r_2:U1
  reg mesh_io_in_control_7_0_dataflow_r_3:U1
  reg mesh_io_in_control_7_0_dataflow_r_4:U1
  reg mesh_io_in_control_7_0_dataflow_r_5:U1
  reg mesh_io_in_control_7_0_dataflow_r_6:U1
  reg mesh_io_in_control_7_0_propagate_r:U1
  reg mesh_io_in_control_7_0_propagate_r_1:U1
  reg mesh_io_in_control_7_0_propagate_r_2:U1
  reg mesh_io_in_control_7_0_propagate_r_3:U1
  reg mesh_io_in_control_7_0_propagate_r_4:U1
  reg mesh_io_in_control_7_0_propagate_r_5:U1
  reg mesh_io_in_control_7_0_propagate_r_6:U1
  reg mesh_io_in_control_7_0_shift_r:U5
  reg mesh_io_in_control_7_0_shift_r_1:U5
  reg mesh_io_in_control_7_0_shift_r_2:U5
  reg mesh_io_in_control_7_0_shift_r_3:U5
  reg mesh_io_in_control_7_0_shift_r_4:U5
  reg mesh_io_in_control_7_0_shift_r_5:U5
  reg mesh_io_in_control_7_0_shift_r_6:U5
  // input skew: valid, id, last
  reg RegShifted_1_3:U1
  reg RegShifted_r_63:U1
  reg RegShifted_2_3:U1
  reg RegShifted_r_64:U1
  reg RegShifted_r_65:U1
  reg RegShifted_3_3:U1
  reg RegShifted_r_66:U1
  reg RegShifted_r_67:U1
  reg RegShifted_r_68:U1
  reg RegShifted_4_3:U1
  reg RegShifted_r_69:U1
  reg RegShifted_r_70:U1
  reg RegShifted_r_71:U1
  reg RegShifted_r_72:U1
  reg RegShifted_5_3:U1
  reg RegShifted_r_73:U1
  reg RegShifted_r_74:U1
  reg RegShifted_r_75:U1
  reg RegShifted_r_76:U1
  reg RegShifted_r_77:U1
  reg RegShifted_6_3:U1
  reg RegShifted_r_78:U1
  reg RegShifted_r_79:U1
  reg RegShifted_r_80:U1
  reg RegShifted_r_81:U1
  reg RegShifted_r_82:U1
  reg RegShifted_r_83:U1
  reg RegShifted_7_3:U1
  reg RegShifted_1_4:U3
  reg RegShifted_r_84:U3
  reg RegShifted_2_4:U3
  reg RegShifted_r_85:U3
  reg RegShifted_r_86:U3
  reg RegShifted_3_4:U3
  reg RegShifted_r_87:U3
  reg RegShifted_r_88:U3
  reg RegShifted_r_89:U3
  reg RegShifted_4_4:U3
  reg RegShifted_r_90:U3
  reg RegShifted_r_91:U3
  reg RegShifted_r_92:U3
  reg RegShifted_r_93:U3
  reg RegShifted_5_4:U3
  reg RegShifted_r_94:U3
  reg RegShifted_r_95:U3
  reg RegShifted_r_96:U3
  reg RegShifted_r_97:U3
  reg RegShifted_r_98:U3
  reg RegShifted_6_4:U3
  reg RegShifted_r_99:U3
  reg RegShifted_r_100:U3
  reg RegShifted_r_101:U3
  reg RegShifted_r_102:U3
  reg RegShifted_r_103:U3
  reg RegShifted_r_104:U3
  reg RegShifted_7_4:U3
  reg RegShifted_1_5:U1
  reg RegShifted_r_105:U1
  reg RegShifted_2_5:U1
  reg RegShifted_r_106:U1
  reg RegShifted_r_107:U1
  reg RegShifted_3_5:U1
  reg RegShifted_r_108:U1
  reg RegShifted_r_109:U1
  reg RegShifted_r_110:U1
  reg RegShifted_4_5:U1
  reg RegShifted_r_111:U1
  reg RegShifted_r_112:U1
  reg RegShifted_r_113:U1
  reg RegShifted_r_114:U1
  reg RegShifted_5_5:U1
  reg RegShifted_r_115:U1
  reg RegShifted_r_116:U1
  reg RegShifted_r_117:U1
  reg RegShifted_r_118:U1
  reg RegShifted_r_119:U1
  reg RegShifted_6_5:U1
  reg RegShifted_r_120:U1
  reg RegShifted_r_121:U1
  reg RegShifted_r_122:U1
  reg RegShifted_r_123:U1
  reg RegShifted_r_124:U1
  reg RegShifted_r_125:U1
  reg RegShifted_7_5:U1
  // output de-skew: data columns 0 / 1 / 2 / 3 / 4 / 5 / 6, and column 0 valid, last, id
  reg RegShifted_r_126:U32
  reg RegShifted_r_127:U32
  reg RegShifted_r_128:U32
  reg RegShifted_r_129:U32
  reg RegShifted_r_130:U32
  reg RegShifted_r_131:U32
  reg RegShifted_0:U32
  reg RegShifted_r_132:U32
  reg RegShifted_r_133:U32
  reg RegShifted_r_134:U32
  reg RegShifted_r_135:U32
  reg RegShifted_r_136:U32
  reg RegShifted_1_6:U32
  reg RegShifted_r_137:U32
  reg RegShifted_r_138:U32
  reg RegShifted_r_139:U32
  reg RegShifted_r_140:U32
  reg RegShifted_2_6:U32
  reg RegShifted_r_141:U32
  reg RegShifted_r_142:U32
  reg RegShifted_r_143:U32
  reg RegShifted_3_6:U32
  reg RegShifted_r_144:U32
  reg RegShifted_r_145:U32
  reg RegShifted_4_6:U32
  reg RegShifted_r_146:U32
  reg RegShifted_5_6:U32
  reg RegShifted_6_6:U32
  reg io_resp_valid_RegShifted_r:U1
  reg io_resp_valid_RegShifted_r_1:U1
  reg io_resp_valid_RegShifted_r_2:U1
  reg io_resp_valid_RegShifted_r_3:U1
  reg io_resp_valid_RegShifted_r_4:U1
  reg io_resp_valid_RegShifted_r_5:U1
  reg io_resp_valid_RegShifted_0:U1
  reg out_last_RegShifted_r:U1
  reg out_last_RegShifted_r_1:U1
  reg out_last_RegShifted_r_2:U1
  reg out_last_RegShifted_r_3:U1
  reg out_last_RegShifted_r_4:U1
  reg out_last_RegShifted_r_5:U1
  reg out_last_RegShifted_0:U1
  reg out_matmul_id_RegShifted_r:U3
  reg out_matmul_id_RegShifted_r_1:U3
  reg out_matmul_id_RegShifted_r_2:U3
  reg out_matmul_id_RegShifted_r_3:U3
  reg out_matmul_id_RegShifted_r_4:U3
  reg out_matmul_id_RegShifted_r_5:U3
  reg out_matmul_id_RegShifted_0:[1]U3:[ordering="old"]
  // the queues' outputs feed back into their own inputs (through io_req_ready and the response match)
  wire tagq_enq_ready:U1 = nil
  wire tagq_deq_valid:U1 = nil
  wire tagq_deq_tag:U1 = nil
  wire tagq_deq_id:U3 = nil
  wire rows_q_enq_ready:U1 = nil
  wire rows_q_deq_valid:U1 = nil
  wire rows_q_deq_id:U3 = nil
  wire rows_q_deq_rows:U4 = nil

  const req_flush = req#[0..<2]
  const req_rows = req#[2..<6]
  const req_bd_transpose = req#[6..<7]
  const req_a_transpose = req#[7..<8]
  const req_shift = req#[8..<13]
  const req_dataflow = req#[14..<15]
  const req_valid = req#[16..<17]
  const in_bits = ((io_req_bits.tag.id << 15) | (io_req_bits.pe_control.dataflow << 14) | (io_req_bits.pe_control.propagate << 13) | (io_req_bits.pe_control.shift << 8) | (io_req_bits.a_transpose << 7) | (io_req_bits.bd_transpose << 6) | (io_req_bits.total_rows << 2) | io_req_bits.flush)#[0..<16]

  // a row goes into the array once A, B and D are all buffered (or every cycle while flushing)
  mut flushing = if req_flush != 0 { 1 } else { 0 }
  const in_next = req_valid & ((a_written & b_written & d_written) | flushing) & 1
  const fire_counter_max = (req_rows - 1)#[0..<4]
  mut at_max = if fire_counter#[0..<3] == fire_counter_max { 1 } else { 0 }
  const last_fire = at_max & in_next
  const a_is_from_transposer = (req_dataflow ^ (~req_a_transpose)) & 1
  const b_is_from_transposer = (~req_dataflow) & req_bd_transpose & 1
  const d_is_from_transposer = req_dataflow & req_bd_transpose & 1

  // request port
  const req_ready = ((~req_valid) | last_fire) & tagq_enq_ready & rows_q_enq_ready & 1
  const req_fire = req_ready & io_req_valid & 1
  mut no_flush = if io_req_bits.flush == 0 { 1 } else { 0 }
  const id_step = (1 << 1) | (~in_bits#[14..<15])
  const cur_from_end = (4 - matmul_id)#[0..<3]
  mut tag_id:U3 = if matmul_id >= ((4 - id_step)#[0..<3] + 1)#[0..<3] { ((id_step - cur_from_end)#[0..<3] - 1)#[0..<3] } else { (matmul_id + id_step)#[0..<3] }
  mut next_id:U3 = if matmul_id#[2..<3] != 0 { ((1 - cur_from_end)#[0..<3] - 1)#[0..<3] } else { (matmul_id + 1)#[0..<3] }

  // A / B / D row buffers
  const a_ready = ((((~a_written) | in_next) & 1) | req_ready) & 1
  const b_ready = ((((~b_written) | in_next) & 1) | req_ready) & 1
  const d_ready = ((((~d_written) | in_next) & 1) | req_ready) & 1
  const a_fire = a_ready & io_a_valid & 1
  const b_fire = b_ready & io_b_valid & 1
  const d_fire = d_ready & io_d_valid & 1

  // transposer: B, else D (byte-reversed), else A
  mut trans_in:U64 = if d_is_from_transposer != 0 { (d_buf[0] << 56) | (d_buf[1] << 48) | (d_buf[2] << 40) | (d_buf[3] << 32) | (d_buf[4] << 24) | (d_buf[5] << 16) | (d_buf[6] << 8) | d_buf[7] } else { (a_buf[7] << 56) | (a_buf[6] << 48) | (a_buf[5] << 40) | (a_buf[4] << 32) | (a_buf[3] << 24) | (a_buf[2] << 16) | (a_buf[1] << 8) | a_buf[0] }
  if b_is_from_transposer != 0 { trans_in = (b_buf[7] << 56) | (b_buf[6] << 48) | (b_buf[5] << 40) | (b_buf[4] << 32) | (b_buf[3] << 24) | (b_buf[2] << 16) | (b_buf[1] << 8) | b_buf[0] }
  mut transposer = AlwaysOutTransposer::[name=transposer](`clock` = `clock`, `reset` = `reset`, io_inRow_valid = in_next & (a_is_from_transposer | b_is_from_transposer | d_is_from_transposer) & 1, io_inRow_bits = trans_in)
  const tout = transposer#[0..<0x40]
  mut a_in:U64 = if a_is_from_transposer != 0 { tout } else { a_buf#[0..<0x40] }
  mut b_in:U64 = if b_is_from_transposer != 0 { tout } else { b_buf#[0..<0x40] }
  mut d_in:U64 = if d_is_from_transposer != 0 { (tout#[0..<8] << 56) | (tout#[8..<16] << 48) | (tout#[16..<24] << 40) | (tout#[24..<32] << 32) | (tout#[32..<40] << 24) | (tout#[40..<48] << 16) | (tout#[48..<56] << 8) | tout#[56..<0x40] } else { d_buf#[0..<0x40] }

  // column c enters c cycles late
  const ctl0 = ((req_dataflow << 6) | ((in_prop & 1) << 5) | result_shift)#[0..<7]
  const ctl1 = ((mesh_io_in_control_1_0_dataflow_r << 6) | (mesh_io_in_control_1_0_propagate_r << 5) | mesh_io_in_control_1_0_shift_r)#[0..<7]
  const ctl2 = ((mesh_io_in_control_2_0_dataflow_r_1 << 6) | (mesh_io_in_control_2_0_propagate_r_1 << 5) | mesh_io_in_control_2_0_shift_r_1)#[0..<7]
  const ctl3 = ((mesh_io_in_control_3_0_dataflow_r_2 << 6) | (mesh_io_in_control_3_0_propagate_r_2 << 5) | mesh_io_in_control_3_0_shift_r_2)#[0..<7]
  const ctl4 = ((mesh_io_in_control_4_0_dataflow_r_3 << 6) | (mesh_io_in_control_4_0_propagate_r_3 << 5) | mesh_io_in_control_4_0_shift_r_3)#[0..<7]
  const ctl5 = ((mesh_io_in_control_5_0_dataflow_r_4 << 6) | (mesh_io_in_control_5_0_propagate_r_4 << 5) | mesh_io_in_control_5_0_shift_r_4)#[0..<7]
