// Gemmini MeshWithDelays, 8x8: buffers one row of A, B and D, optionally routes one of them through the transposer,
// skews column c of every Mesh input by c cycles (registers named *_r*, RegShifted_*), and de-skews the Mesh output
// column c by 7-c cycles. req holds the current request: flush[0..<2], total_rows[2..<6], bd_transpose[6],
// a_transpose[7], pe_control (shift[8..<13], propagate[13], dataflow[14]), tag[15], valid[16].
// matmul_id counts 0..4. tagq / total_rows_q match responses to requests by matmul id.
pub mod MeshWithDelays::[timecheck=false](`clock`:Clock, `reset`:U1, io_a_valid:U1, io_a_bits:U64, io_b_valid:U1, io_b_bits:U64, io_d_valid:U1, io_d_bits:U64, io_req_valid:U1, io_req_bits:(tag:(id:U1), pe_control:(dataflow:U1, propagate:U1, shift:U5), a_transpose:U1, bd_transpose:U1, total_rows:U4, flush:U2)) -> (io_a_ready:U1@[], io_b_ready:U1@[], io_d_ready:U1@[], io_req_ready:U1@[], io_resp:(valid:U1, bits:(tag:(id:U1), data:U256, total_rows:U4, last:U1))@[], io_tags_in_progress:U6@[]) {
  reg req:U17
  reg matmul_id:U3:[initial=0, reset_pin=`reset`, async=false]
  reg fire_counter:U3:[initial=0, reset_pin=`reset`, async=false]
  reg a_buf:[8]U8:[ordering="old"]
  reg b_buf:[8]U8:[ordering="old"]
  reg d_buf:[8]U8:[ordering="old"]
  reg a_written:U1:[initial=0, reset_pin=`reset`, async=false]
  reg b_written:U1:[initial=0, reset_pin=`reset`, async=false]
  reg d_written:U1:[initial=0, reset_pin=`reset`, async=false]
  reg in_prop:U1:[initial=0, reset_pin=`reset`, async=false]
  reg result_shift:U5
  // input skew, column 1 / 2 / 3 / 4 / 5 / 6 / 7: A, B, D bytes
  reg RegShifted_1:U8
  reg RegShifted_r:U8
  reg RegShifted_2:U8
  reg RegShifted_r_1:U8
  reg RegShifted_r_2:U8
  reg RegShifted_3:U8
