const mem_64x256 = import("mem_64x256.mem_64x256")

// 64 x 256-bit memory with a 32-bit byte mask; masked-off bytes are written as 0.
pub mod TwoPortSyncMem::[timecheck=false](`clock`:Clock, `reset`:Reset, io_waddr:U6, io_raddr:U6, io_wdata:U256, io_wen:U1, io_ren:U1, io_mask:U32) -> (io_rdata:U256@[]) {
  const wmask:U32 = if io_wen != 0 { io_mask } else { 0 }
  mut wdata:U256 = 0
  for k in 0..<32 {
    if wmask#[k] != 0 { wdata = wdata | (io_wdata#[(k*8)..<((k*8)+8)] << (k*8)) }
  }
  mut mem_ext = mem_64x256::[name=mem_ext](R0_addr = io_raddr, R0_en = io_ren, R0_clk = `clock`, W0_addr = io_waddr, W0_en = io_wen, W0_clk = `clock`, W0_data = wdata,
    `W0_mask.e31` = wmask#[31], `W0_mask.e30` = wmask#[30], `W0_mask.e29` = wmask#[29], `W0_mask.e28` = wmask#[28], `W0_mask.e27` = wmask#[27], `W0_mask.e26` = wmask#[26], `W0_mask.e25` = wmask#[25], `W0_mask.e24` = wmask#[24],
    `W0_mask.e23` = wmask#[23], `W0_mask.e22` = wmask#[22], `W0_mask.e21` = wmask#[21], `W0_mask.e20` = wmask#[20], `W0_mask.e19` = wmask#[19], `W0_mask.e18` = wmask#[18], `W0_mask.e17` = wmask#[17], `W0_mask.e16` = wmask#[16],
    `W0_mask.e15` = wmask#[15], `W0_mask.e14` = wmask#[14], `W0_mask.e13` = wmask#[13], `W0_mask.e12` = wmask#[12], `W0_mask.e11` = wmask#[11], `W0_mask.e10` = wmask#[10], `W0_mask.e9` = wmask#[9], `W0_mask.e8` = wmask#[8],
    `W0_mask.e7` = wmask#[7], `W0_mask.e6` = wmask#[6], `W0_mask.e5` = wmask#[5], `W0_mask.e4` = wmask#[4], `W0_mask.e3` = wmask#[3], `W0_mask.e2` = wmask#[2], `W0_mask.e1` = wmask#[1], `W0_mask.e0` = wmask#[0])
  io_rdata = mem_ext
}
