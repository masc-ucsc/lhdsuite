pub mod ram_6x8::[timecheck=false](R0_addr:U3, R0_en:U1, R0_clk:Clock, W0_addr:U3, W0_en:U1, W0_clk:Clock, W0_data:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1), W0_mask:(e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)) -> (R0_data:U8@[]) {
  reg Memory:[6]U8:[ordering="old", __store_clock_pin=W0_clk, __store_posclk=true, wensize=8]
  if (W0_en & W0_mask.e0 & 1) != 0 {
    const t6 = W0_addr < 6
    if t6 {
      Memory[W0_addr#[0..<3]]#[0] = W0_data.e0#[0]
    }
  }
  if (W0_en & W0_mask.e1 & 1) != 0 {
    const t14 = W0_addr < 6
    if t14 {
      Memory[W0_addr#[0..<3]]#[1] = (W0_data.e1 << 1)#[1]
    }
  }
  if (W0_en & W0_mask.e2 & 1) != 0 {
    const t22 = W0_addr < 6
    if t22 {
      Memory[W0_addr#[0..<3]]#[2] = (W0_data.e2 << 2)#[2]
    }
  }
  if (W0_en & W0_mask.e3 & 1) != 0 {
    const t30 = W0_addr < 6
    if t30 {
      Memory[W0_addr#[0..<3]]#[3] = (W0_data.e3 << 3)#[3]
    }
  }
  if (W0_en & W0_mask.e4 & 1) != 0 {
    const t38 = W0_addr < 6
    if t38 {
      Memory[W0_addr#[0..<3]]#[4] = (W0_data.e4 << 4)#[4]
    }
  }
  if (W0_en & W0_mask.e5 & 1) != 0 {
    const t46 = W0_addr < 6
    if t46 {
      Memory[W0_addr#[0..<3]]#[5] = (W0_data.e5 << 5)#[5]
    }
  }
  if (W0_en & W0_mask.e6 & 1) != 0 {
    const t54 = W0_addr < 6
    if t54 {
      Memory[W0_addr#[0..<3]]#[6] = (W0_data.e6 << 6)#[6]
    }
  }
  if (W0_en & W0_mask.e7 & 1) != 0 {
    const t62 = W0_addr < 6
    if t62 {
      Memory[W0_addr#[0..<3]]#[7] = (W0_data.e7 << 7)#[7]
    }
  }
  mut _oob_read_1:U8 = if R0_addr#[0..<3] < 6 { Memory[R0_addr#[0..<3]] } else { 0 }
  mut _mux_2:U8 = if R0_en != 0 { _oob_read_1#[0..<8] } else { 0ub????????#[0..<8] }
  R0_data = _mux_2
}
