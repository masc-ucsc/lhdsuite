const PE = import("PE.PE")

// Always-output 8x8 transposer: a grid of 8-bit PE shift cells. Rows of io_inRow_bits shift in
// leftward (dir=0) or upward (dir=1); io_outCol_bits reads column 0 (dir=0) or row 0 (dir=1).
// dir flips every 8 valid rows, so one block is shifted in while the previous one is shifted out.
pub mod AlwaysOutTransposer::[timecheck=false](`clock`:Clock, `reset`:U1, io_inRow_valid:U1, io_inRow_bits:U64) -> (io_outCol_bits:U64@[]) {
  reg counter:U3:[initial=0, reset_pin=`reset`, async=false]
  reg dir:U1:[initial=0, reset_pin=`reset`, async=false]

  if io_inRow_valid != 0 {
    if counter == 7 { dir = dir ^ 1 }
    counter = (counter + 1)#[0..<3]
  }

  // instantiated bottom-right first so every PE reads neighbours already declared
  mut pes_7_7 = PE::[name=pes_7_7](`clock` = `clock`, io_inR = io_inRow_bits#[56..<64], io_inD = io_inRow_bits#[56..<64], io_dir = dir, io_en = io_inRow_valid)
  mut pes_7_6 = PE::[name=pes_7_6](`clock` = `clock`, io_inR = pes_7_7.io_outL, io_inD = io_inRow_bits#[48..<56], io_dir = dir, io_en = io_inRow_valid)
  mut pes_7_5 = PE::[name=pes_7_5](`clock` = `clock`, io_inR = pes_7_6.io_outL, io_inD = io_inRow_bits#[40..<48], io_dir = dir, io_en = io_inRow_valid)
  mut pes_7_4 = PE::[name=pes_7_4](`clock` = `clock`, io_inR = pes_7_5.io_outL, io_inD = io_inRow_bits#[32..<40], io_dir = dir, io_en = io_inRow_valid)
  mut pes_7_3 = PE::[name=pes_7_3](`clock` = `clock`, io_inR = pes_7_4.io_outL, io_inD = io_inRow_bits#[24..<32], io_dir = dir, io_en = io_inRow_valid)
  mut pes_7_2 = PE::[name=pes_7_2](`clock` = `clock`, io_inR = pes_7_3.io_outL, io_inD = io_inRow_bits#[16..<24], io_dir = dir, io_en = io_inRow_valid)
  mut pes_7_1 = PE::[name=pes_7_1](`clock` = `clock`, io_inR = pes_7_2.io_outL, io_inD = io_inRow_bits#[8..<16], io_dir = dir, io_en = io_inRow_valid)
  mut pes_7_0 = PE::[name=pes_7_0](`clock` = `clock`, io_inR = pes_7_1.io_outL, io_inD = io_inRow_bits#[0..<8], io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_7 = PE::[name=pes_6_7](`clock` = `clock`, io_inR = io_inRow_bits#[48..<56], io_inD = pes_7_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_6 = PE::[name=pes_6_6](`clock` = `clock`, io_inR = pes_6_7.io_outL, io_inD = pes_7_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_5 = PE::[name=pes_6_5](`clock` = `clock`, io_inR = pes_6_6.io_outL, io_inD = pes_7_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_4 = PE::[name=pes_6_4](`clock` = `clock`, io_inR = pes_6_5.io_outL, io_inD = pes_7_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_3 = PE::[name=pes_6_3](`clock` = `clock`, io_inR = pes_6_4.io_outL, io_inD = pes_7_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_2 = PE::[name=pes_6_2](`clock` = `clock`, io_inR = pes_6_3.io_outL, io_inD = pes_7_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_1 = PE::[name=pes_6_1](`clock` = `clock`, io_inR = pes_6_2.io_outL, io_inD = pes_7_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_6_0 = PE::[name=pes_6_0](`clock` = `clock`, io_inR = pes_6_1.io_outL, io_inD = pes_7_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_7 = PE::[name=pes_5_7](`clock` = `clock`, io_inR = io_inRow_bits#[40..<48], io_inD = pes_6_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_6 = PE::[name=pes_5_6](`clock` = `clock`, io_inR = pes_5_7.io_outL, io_inD = pes_6_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_5 = PE::[name=pes_5_5](`clock` = `clock`, io_inR = pes_5_6.io_outL, io_inD = pes_6_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_4 = PE::[name=pes_5_4](`clock` = `clock`, io_inR = pes_5_5.io_outL, io_inD = pes_6_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_3 = PE::[name=pes_5_3](`clock` = `clock`, io_inR = pes_5_4.io_outL, io_inD = pes_6_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_2 = PE::[name=pes_5_2](`clock` = `clock`, io_inR = pes_5_3.io_outL, io_inD = pes_6_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_1 = PE::[name=pes_5_1](`clock` = `clock`, io_inR = pes_5_2.io_outL, io_inD = pes_6_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_5_0 = PE::[name=pes_5_0](`clock` = `clock`, io_inR = pes_5_1.io_outL, io_inD = pes_6_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_7 = PE::[name=pes_4_7](`clock` = `clock`, io_inR = io_inRow_bits#[32..<40], io_inD = pes_5_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_6 = PE::[name=pes_4_6](`clock` = `clock`, io_inR = pes_4_7.io_outL, io_inD = pes_5_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_5 = PE::[name=pes_4_5](`clock` = `clock`, io_inR = pes_4_6.io_outL, io_inD = pes_5_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_4 = PE::[name=pes_4_4](`clock` = `clock`, io_inR = pes_4_5.io_outL, io_inD = pes_5_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_3 = PE::[name=pes_4_3](`clock` = `clock`, io_inR = pes_4_4.io_outL, io_inD = pes_5_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_2 = PE::[name=pes_4_2](`clock` = `clock`, io_inR = pes_4_3.io_outL, io_inD = pes_5_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_1 = PE::[name=pes_4_1](`clock` = `clock`, io_inR = pes_4_2.io_outL, io_inD = pes_5_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_4_0 = PE::[name=pes_4_0](`clock` = `clock`, io_inR = pes_4_1.io_outL, io_inD = pes_5_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_7 = PE::[name=pes_3_7](`clock` = `clock`, io_inR = io_inRow_bits#[24..<32], io_inD = pes_4_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_6 = PE::[name=pes_3_6](`clock` = `clock`, io_inR = pes_3_7.io_outL, io_inD = pes_4_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_5 = PE::[name=pes_3_5](`clock` = `clock`, io_inR = pes_3_6.io_outL, io_inD = pes_4_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_4 = PE::[name=pes_3_4](`clock` = `clock`, io_inR = pes_3_5.io_outL, io_inD = pes_4_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_3 = PE::[name=pes_3_3](`clock` = `clock`, io_inR = pes_3_4.io_outL, io_inD = pes_4_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_2 = PE::[name=pes_3_2](`clock` = `clock`, io_inR = pes_3_3.io_outL, io_inD = pes_4_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_1 = PE::[name=pes_3_1](`clock` = `clock`, io_inR = pes_3_2.io_outL, io_inD = pes_4_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_3_0 = PE::[name=pes_3_0](`clock` = `clock`, io_inR = pes_3_1.io_outL, io_inD = pes_4_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_7 = PE::[name=pes_2_7](`clock` = `clock`, io_inR = io_inRow_bits#[16..<24], io_inD = pes_3_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_6 = PE::[name=pes_2_6](`clock` = `clock`, io_inR = pes_2_7.io_outL, io_inD = pes_3_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_5 = PE::[name=pes_2_5](`clock` = `clock`, io_inR = pes_2_6.io_outL, io_inD = pes_3_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_4 = PE::[name=pes_2_4](`clock` = `clock`, io_inR = pes_2_5.io_outL, io_inD = pes_3_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_3 = PE::[name=pes_2_3](`clock` = `clock`, io_inR = pes_2_4.io_outL, io_inD = pes_3_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_2 = PE::[name=pes_2_2](`clock` = `clock`, io_inR = pes_2_3.io_outL, io_inD = pes_3_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_1 = PE::[name=pes_2_1](`clock` = `clock`, io_inR = pes_2_2.io_outL, io_inD = pes_3_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_2_0 = PE::[name=pes_2_0](`clock` = `clock`, io_inR = pes_2_1.io_outL, io_inD = pes_3_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_7 = PE::[name=pes_1_7](`clock` = `clock`, io_inR = io_inRow_bits#[8..<16], io_inD = pes_2_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_6 = PE::[name=pes_1_6](`clock` = `clock`, io_inR = pes_1_7.io_outL, io_inD = pes_2_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_5 = PE::[name=pes_1_5](`clock` = `clock`, io_inR = pes_1_6.io_outL, io_inD = pes_2_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_4 = PE::[name=pes_1_4](`clock` = `clock`, io_inR = pes_1_5.io_outL, io_inD = pes_2_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_3 = PE::[name=pes_1_3](`clock` = `clock`, io_inR = pes_1_4.io_outL, io_inD = pes_2_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_2 = PE::[name=pes_1_2](`clock` = `clock`, io_inR = pes_1_3.io_outL, io_inD = pes_2_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_1 = PE::[name=pes_1_1](`clock` = `clock`, io_inR = pes_1_2.io_outL, io_inD = pes_2_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_1_0 = PE::[name=pes_1_0](`clock` = `clock`, io_inR = pes_1_1.io_outL, io_inD = pes_2_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_7 = PE::[name=pes_0_7](`clock` = `clock`, io_inR = io_inRow_bits#[0..<8], io_inD = pes_1_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_6 = PE::[name=pes_0_6](`clock` = `clock`, io_inR = pes_0_7.io_outL, io_inD = pes_1_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_5 = PE::[name=pes_0_5](`clock` = `clock`, io_inR = pes_0_6.io_outL, io_inD = pes_1_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_4 = PE::[name=pes_0_4](`clock` = `clock`, io_inR = pes_0_5.io_outL, io_inD = pes_1_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_3 = PE::[name=pes_0_3](`clock` = `clock`, io_inR = pes_0_4.io_outL, io_inD = pes_1_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_2 = PE::[name=pes_0_2](`clock` = `clock`, io_inR = pes_0_3.io_outL, io_inD = pes_1_2.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_1 = PE::[name=pes_0_1](`clock` = `clock`, io_inR = pes_0_2.io_outL, io_inD = pes_1_1.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_0_0 = PE::[name=pes_0_0](`clock` = `clock`, io_inR = pes_0_1.io_outL, io_inD = pes_1_0.io_outU, io_dir = dir, io_en = io_inRow_valid)

  io_outCol_bits = if dir != 0 {
    (pes_0_7.io_outU << 56) | (pes_0_6.io_outU << 48) | (pes_0_5.io_outU << 40) | (pes_0_4.io_outU << 32) | (pes_0_3.io_outU << 24) | (pes_0_2.io_outU << 16) | (pes_0_1.io_outU << 8) | pes_0_0.io_outU
  } else {
    (pes_7_0.io_outL << 56) | (pes_6_0.io_outL << 48) | (pes_5_0.io_outL << 40) | (pes_4_0.io_outL << 32) | (pes_3_0.io_outL << 24) | (pes_2_0.io_outL << 16) | (pes_1_0.io_outL << 8) | pes_0_0.io_outL
  }
}
