pub comb MacUnit::[timecheck=false](io_in_a:U8, io_in_b:U8, io_in_c:U32) -> (io_out_d:U32) {
  wire io:(in_a:U8, in_b:U8, in_c:U32, out_d:U32) = nil
  wire _io_out_d_T:U16 = nil
  _io_out_d_T = (io.in_a#[0..<8]#sext[0..=7]#[0..<16] * io.in_b#[0..<8]#sext[0..=7]#[0..<16])#[0..<16]
  io.in_a = io_in_a#[0..<8]
  io.in_b = io_in_b#[0..<8]
  io.in_c = io_in_c#[0..<32]
  io.out_d = (_io_out_d_T#[0..<16]#sext[0..=15]#[0..<32] + io.in_c)#[0..<32]
  io_out_d = io.out_d
}
