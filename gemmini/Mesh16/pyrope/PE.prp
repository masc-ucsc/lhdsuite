pub mod PE::[timecheck=false](`clock`:Clock, io_inR:U8, io_inD:U8, io_dir:U1, io_en:U1) -> (io_outL:U8@[], io_outU:U8@[]) {
  reg reg_0:U8
  mut `io.inR` = io_inR#[0..<8]
  mut `io.inD` = io_inD#[0..<8]
  mut `io.outL` = reg_0#[0..<8]
  mut `io.outU` = reg_0#[0..<8]
  mut `io.dir` = io_dir & 1
  mut `io.en` = io_en & 1
  if `io.en` != 0 {
    reg_0 = if `io.dir` != 0 { `io.inD` } else { `io.inR` }
  }
  io_outL = `io.outL`
  io_outU = `io.outU`
}
