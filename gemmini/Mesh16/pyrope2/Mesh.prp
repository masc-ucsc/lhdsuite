  mut aNext:[256]U8 = 0
  mut bNext:[256]U32 = 0
  mut dNext:[256]U32 = 0
  mut shiftNext:[256]U5 = 0
  mut dataflowNext:[256]U1 = 0
  mut propagateNext:[256]U1 = 0
  mut validNext:[256]U1 = 0
  mut idNext:[256]U3 = 0
  mut lastNext:[256]U1 = 0

  mut outA:[256]U8 = 0
  mut outB:[256]U32 = 0
  mut outC:[256]U32 = 0
  mut outControl:[256]U7 = 0
  mut outValid:[256]U1 = 0
  mut outId:[256]U3 = 0
  mut outLast:[256]U1 = 0

  mut ob:U512 = 0
  mut oc:U512 = 0
  mut ov:U16 = 0
  mut octl:U112 = 0
  mut oid:U48 = 0
  mut olast:U16 = 0

  for row in 0..<16 {
    for col in 0..<16 {
      const i = (row*16) + col
      const up = (i + 240) % 256
      const left = (i + 255) % 256
      const srcA = if col == 0 { io_in_a#[(row*8)..<((row*8)+8)] } else { outA[left] }
      const srcValid = if row == 0 { io_in_valid#[col] } else { outValid[up] }
      const srcB = if row == 0 { io_in_b#[(col*8)..<((col*8)+8)] } else { outB[up] }
      const srcD = if row == 0 { io_in_d#[(col*8)..<((col*8)+8)] } else { outC[up] }
      const srcCtl = if row == 0 { io_in_control#[(col*7)..<((col*7)+7)] } else { outControl[up] }
      const srcId = if row == 0 { io_in_id#[(col*3)..<((col*3)+3)] } else { outId[up] }
      const srcLast = if row == 0 { io_in_last#[col] } else { outLast[up] }

      const b = bCur#[(i*32)..<((i*32)+32)]
      const d = dCur#[(i*32)..<((i*32)+32)]
      const sh = shiftCur#[(i*5)..<((i*5)+5)]
      const df = dataflowCur#[i]
      const pr = propagateCur#[i]
      aNext[i] = srcA
      bNext[i] = if srcValid != 0 { srcB } else { b }
      dNext[i] = if srcValid != 0 { srcD } else { d }
      shiftNext[i] = if srcValid != 0 { srcCtl#[0..<5] } else { sh }
      propagateNext[i] = if srcValid != 0 { srcCtl#[5] } else { pr }
      dataflowNext[i] = if srcValid != 0 { srcCtl#[6] } else { df }
      validNext[i] = srcValid
      idNext[i] = srcId
      lastNext[i] = srcLast

      // row 0 holds the 8-bit io_in_b/d values, sign-extended into the tile
      const inB = if row == 0 { b#[0..<8]#sext[0..=7]#[0..<32] } else { b }
      const inD = if row == 0 { d#[0..<8]#sext[0..=7]#[0..<32] } else { d }
      mut mesh = Tile(`clock` = `clock`, io_in_a = aCur#[(i*8)..<((i*8)+8)], io_in_b = inB, io_in_d = inD,
        io_in_control = ((df << 6) | (pr << 5) | sh)#[0..<7],
        io_in_id = idCur#[(i*3)..<((i*3)+3)], io_in_last = lastCur#[i], io_in_valid = validCur#[i])
      outA[i] = mesh.io_out_a
      outB[i] = mesh.io_out_b
      outC[i] = mesh.io_out_c
      outControl[i] = mesh.io_out_control
      outValid[i] = mesh.io_out_valid
      outId[i] = mesh.io_out_id
      outLast[i] = mesh.io_out_last
      if row == 15 {
        ob = ob | (mesh.io_out_b << (col*32))
        oc = oc | (mesh.io_out_c << (col*32))
        ov = ov | (mesh.io_out_valid << col)
        octl = octl | (mesh.io_out_control << (col*7))
        oid = oid | (mesh.io_out_id << (col*3))
        olast = olast | (mesh.io_out_last << col)
      }
    }
  }

