  // the queues' outputs feed back into their own inputs (through io_req_ready and the response match)
  wire tagq_enq_ready:U1 = nil
  wire tagq_deq_valid:U1 = nil
  wire tagq_deq_tag:U1 = nil
  wire tagq_deq_id:U3 = nil
  wire rows_q_enq_ready:U1 = nil
  wire rows_q_deq_valid:U1 = nil
  wire rows_q_deq_id:U3 = nil
  wire rows_q_deq_rows:U5 = nil

  const req_flush = req#[0..<2]
  const req_rows = req#[2..<7]
  const req_bd_transpose = req#[7..<8]
  const req_a_transpose = req#[8..<9]
  const req_shift = req#[9..<14]
  const req_dataflow = req#[15..<16]
  const req_valid = req#[17..<18]
  const in_bits = ((io_req_bits.tag.id << 16) | (io_req_bits.pe_control.dataflow << 15) | (io_req_bits.pe_control.propagate << 14) | (io_req_bits.pe_control.shift << 9) | (io_req_bits.a_transpose << 8) | (io_req_bits.bd_transpose << 7) | (io_req_bits.total_rows << 2) | io_req_bits.flush)#[0..<17]

  // a row goes into the array once A, B and D are all buffered (or every cycle while flushing)
  mut flushing = if req_flush != 0 { 1 } else { 0 }
  const in_next = req_valid & ((a_written & b_written & d_written) | flushing) & 1
  const fire_counter_max = (req_rows - 1)#[0..<5]
  mut at_max = if fire_counter#[0..<4] == fire_counter_max { 1 } else { 0 }
  const last_fire = at_max & in_next
  const a_is_from_transposer = (req_dataflow ^ (~req_a_transpose)) & 1
  const b_is_from_transposer = (~req_dataflow) & req_bd_transpose & 1
  const d_is_from_transposer = req_dataflow & req_bd_transpose & 1

