  const a_ready = ((((~a_written) | in_next) & 1) | req_ready) & 1
  const b_ready = ((((~b_written) | in_next) & 1) | req_ready) & 1
  const d_ready = ((((~d_written) | in_next) & 1) | req_ready) & 1
