  mut trans_in:U128 = if d_is_from_transposer != 0 { (d_buf[0] << 120) | (d_buf[1] << 112) | (d_buf[2] << 104) | (d_buf[3] << 96) | (d_buf[4] << 88) | (d_buf[5] << 80) | (d_buf[6] << 72) | (d_buf[7] << 64) | (d_buf[8] << 56) | (d_buf[9] << 48) | (d_buf[10] << 40) | (d_buf[11] << 32) | (d_buf[12] << 24) | (d_buf[13] << 16) | (d_buf[14] << 8) | d_buf[15] } else { (a_buf[15] << 120) | (a_buf[14] << 112) | (a_buf[13] << 104) | (a_buf[12] << 96) | (a_buf[11] << 88) | (a_buf[10] << 80) | (a_buf[9] << 72) | (a_buf[8] << 64) | (a_buf[7] << 56) | (a_buf[6] << 48) | (a_buf[5] << 40) | (a_buf[4] << 32) | (a_buf[3] << 24) | (a_buf[2] << 16) | (a_buf[1] << 8) | a_buf[0] }
  if b_is_from_transposer != 0 { trans_in = (b_buf[15] << 120) | (b_buf[14] << 112) | (b_buf[13] << 104) | (b_buf[12] << 96) | (b_buf[11] << 88) | (b_buf[10] << 80) | (b_buf[9] << 72) | (b_buf[8] << 64) | (b_buf[7] << 56) | (b_buf[6] << 48) | (b_buf[5] << 40) | (b_buf[4] << 32) | (b_buf[3] << 24) | (b_buf[2] << 16) | (b_buf[1] << 8) | b_buf[0] }
  mut transposer = AlwaysOutTransposer::[name=transposer](`clock` = `clock`, `reset` = `reset`, io_inRow_valid = in_next & (a_is_from_transposer | b_is_from_transposer | d_is_from_transposer) & 1, io_inRow_bits = trans_in)
  const tout = transposer#[0..<0x80]
