const PE_256 = import("PE_256.PE_256")

// A 1x1 tile: one PE_256, control passed as a packed U7 (dataflow 6, propagate 5, shift 4..0).
pub mod Tile::[timecheck=false](`clock`:Clock, io_in_a:U8, io_in_b:U32, io_in_d:U32, io_in_control:U7, io_in_id:U3, io_in_last:U1, io_in_valid:U1) -> (io_out_a:U8@[], io_out_c:U32@[], io_out_b:U32@[], io_out_control:U7@[], io_out_id:U3@[], io_out_last:U1@[], io_out_valid:U1@[], io_bad_dataflow:U1@[]) {
  mut tile_0_0 = PE_256::[name=tile_0_0](`clock` = `clock`, io_in_a = io_in_a, io_in_b = io_in_b, io_in_d = io_in_d,
    `io_in_control.dataflow` = io_in_control#[6], `io_in_control.propagate` = io_in_control#[5], `io_in_control.shift` = io_in_control#[0..<5],
    io_in_id = io_in_id, io_in_last = io_in_last, io_in_valid = io_in_valid)
  io_out_a = tile_0_0.io_out_a
  io_out_b = tile_0_0.io_out_b
  io_out_c = tile_0_0.io_out_c
  io_out_control = (tile_0_0.io_out_control.dataflow << 6) | (tile_0_0.io_out_control.propagate << 5) | tile_0_0.io_out_control.shift
  io_out_id = tile_0_0.io_out_id
  io_out_last = tile_0_0.io_out_last
  io_out_valid = tile_0_0.io_out_valid
  io_bad_dataflow = tile_0_0.io_bad_dataflow
}
