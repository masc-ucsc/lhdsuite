  mut pes_13_0 = PE::[name=pes_13_0](`clock` = `clock`, io_inR = pes_13_1.io_outL, io_inD = pes_14_0.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_12_15 = PE::[name=pes_12_15](`clock` = `clock`, io_inR = io_inRow_bits#[96..<104], io_inD = pes_13_15.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_12_14 = PE::[name=pes_12_14](`clock` = `clock`, io_inR = pes_12_15.io_outL, io_inD = pes_13_14.io_outU, io_dir = dir, io_en = io_inRow_valid)
