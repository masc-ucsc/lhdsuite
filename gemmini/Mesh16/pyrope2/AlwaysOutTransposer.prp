const PE = import("PE.PE")

// Always-output 16x16 transposer: a grid of 8-bit PE shift cells. Rows of io_inRow_bits shift in
// leftward (dir=0) or upward (dir=1); io_outCol_bits reads column 0 (dir=0) or row 0 (dir=1).
// dir flips every 16 valid rows, so one block is shifted in while the previous one is shifted out.
pub mod AlwaysOutTransposer::[timecheck=false](`clock`:Clock, `reset`:U1, io_inRow_valid:U1, io_inRow_bits:U128) -> (io_outCol_bits:U128@[]) {
  reg counter:U4:[initial=0, reset_pin=`reset`, async=false]
  reg dir:U1:[initial=0, reset_pin=`reset`, async=false]

  if io_inRow_valid != 0 {
    if counter == 15 { dir = dir ^ 1 }
    counter = (counter + 1)#[0..<4]
  }

  // instantiated bottom-right first so every PE reads neighbours already declared
  mut pes_15_15 = PE::[name=pes_15_15](`clock` = `clock`, io_inR = io_inRow_bits#[120..<128], io_inD = io_inRow_bits#[120..<128], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_14 = PE::[name=pes_15_14](`clock` = `clock`, io_inR = pes_15_15.io_outL, io_inD = io_inRow_bits#[112..<120], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_13 = PE::[name=pes_15_13](`clock` = `clock`, io_inR = pes_15_14.io_outL, io_inD = io_inRow_bits#[104..<112], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_12 = PE::[name=pes_15_12](`clock` = `clock`, io_inR = pes_15_13.io_outL, io_inD = io_inRow_bits#[96..<104], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_11 = PE::[name=pes_15_11](`clock` = `clock`, io_inR = pes_15_12.io_outL, io_inD = io_inRow_bits#[88..<96], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_10 = PE::[name=pes_15_10](`clock` = `clock`, io_inR = pes_15_11.io_outL, io_inD = io_inRow_bits#[80..<88], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_9 = PE::[name=pes_15_9](`clock` = `clock`, io_inR = pes_15_10.io_outL, io_inD = io_inRow_bits#[72..<80], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_8 = PE::[name=pes_15_8](`clock` = `clock`, io_inR = pes_15_9.io_outL, io_inD = io_inRow_bits#[64..<72], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_7 = PE::[name=pes_15_7](`clock` = `clock`, io_inR = pes_15_8.io_outL, io_inD = io_inRow_bits#[56..<64], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_6 = PE::[name=pes_15_6](`clock` = `clock`, io_inR = pes_15_7.io_outL, io_inD = io_inRow_bits#[48..<56], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_5 = PE::[name=pes_15_5](`clock` = `clock`, io_inR = pes_15_6.io_outL, io_inD = io_inRow_bits#[40..<48], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_4 = PE::[name=pes_15_4](`clock` = `clock`, io_inR = pes_15_5.io_outL, io_inD = io_inRow_bits#[32..<40], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_3 = PE::[name=pes_15_3](`clock` = `clock`, io_inR = pes_15_4.io_outL, io_inD = io_inRow_bits#[24..<32], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_2 = PE::[name=pes_15_2](`clock` = `clock`, io_inR = pes_15_3.io_outL, io_inD = io_inRow_bits#[16..<24], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_1 = PE::[name=pes_15_1](`clock` = `clock`, io_inR = pes_15_2.io_outL, io_inD = io_inRow_bits#[8..<16], io_dir = dir, io_en = io_inRow_valid)
  mut pes_15_0 = PE::[name=pes_15_0](`clock` = `clock`, io_inR = pes_15_1.io_outL, io_inD = io_inRow_bits#[0..<8], io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_15 = PE::[name=pes_14_15](`clock` = `clock`, io_inR = io_inRow_bits#[112..<120], io_inD = pes_15_15.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_14 = PE::[name=pes_14_14](`clock` = `clock`, io_inR = pes_14_15.io_outL, io_inD = pes_15_14.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_13 = PE::[name=pes_14_13](`clock` = `clock`, io_inR = pes_14_14.io_outL, io_inD = pes_15_13.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_12 = PE::[name=pes_14_12](`clock` = `clock`, io_inR = pes_14_13.io_outL, io_inD = pes_15_12.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_11 = PE::[name=pes_14_11](`clock` = `clock`, io_inR = pes_14_12.io_outL, io_inD = pes_15_11.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_10 = PE::[name=pes_14_10](`clock` = `clock`, io_inR = pes_14_11.io_outL, io_inD = pes_15_10.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_9 = PE::[name=pes_14_9](`clock` = `clock`, io_inR = pes_14_10.io_outL, io_inD = pes_15_9.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_8 = PE::[name=pes_14_8](`clock` = `clock`, io_inR = pes_14_9.io_outL, io_inD = pes_15_8.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_7 = PE::[name=pes_14_7](`clock` = `clock`, io_inR = pes_14_8.io_outL, io_inD = pes_15_7.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_6 = PE::[name=pes_14_6](`clock` = `clock`, io_inR = pes_14_7.io_outL, io_inD = pes_15_6.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_5 = PE::[name=pes_14_5](`clock` = `clock`, io_inR = pes_14_6.io_outL, io_inD = pes_15_5.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_4 = PE::[name=pes_14_4](`clock` = `clock`, io_inR = pes_14_5.io_outL, io_inD = pes_15_4.io_outU, io_dir = dir, io_en = io_inRow_valid)
  mut pes_14_3 = PE::[name=pes_14_3](`clock` = `clock`, io_inR = pes_14_4.io_outL, io_inD = pes_15_3.io_outU, io_dir = dir, io_en = io_inRow_valid)
